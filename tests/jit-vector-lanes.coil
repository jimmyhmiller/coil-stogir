(defn fixture-id [(ty i32) (op i32) (st i32) (ity i32) (lane i32) (mode i32)]
  (-> i32)
  (block :found
    (for key FIXTURE-KEYS
      (when (and (= (.ty key) ty)
                 (= (.op key) op)
                 (= (.st key) st)
                 (= (.ity key) ity)
                 (= (.lane key) lane)
                 (= (.mode key) mode))
        (return-from :found (.id key))))
    -1))

