(defn main [] (-> i64)
  (let [(mut failures) (forced-aliases)]
    (for row GENERATE-CASES
      (set! failures
            (+ failures
               (generate (.ty row)
                         (.op row)
                         (.st row)
                         (.ity row)
                         (.lane row)
                         (.mode row)))))
    (for row PRESSURE-CASES
      (set! failures
            (+ failures
               (pressure (.ty row)
                         (.op row)
                         (.st row)
                         (.alignment row)
                         (.id row)))))
    (println "vector lanes: 4006 matrix graphs, 60 pressure graphs, 328 forced aliases; failures {}"
             failures)
    failures))
