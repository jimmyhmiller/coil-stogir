(defstruct PressureCase [(ty i32) (op i32) (st i32) (alignment i32) (id i32)])

(def PRESSURE-CASES
  (table PressureCase
         [81 61 1 16 1430]
         [81 61 1 4096 1431]
         [81 62 1 16 1432]
