(defn forced-aliases [] (-> i64)
  (let [(mut failures) 0]
    (for row ALIAS-CHECK-CASES
      (set! failures
            (+ failures
               (alias-check (.ty row)
                            (.op row)
                            (.st row)
                            (.rd row)
                            (.rn row)
                            (.lane row)))))
    failures))

(import "stogir.calls" :as calls)

(defn pressure [(ty i32) (op i32) (st i32) (alignment i32) (id i32)] (-> i64)
  (let [alc (malloc-allocator)
        (mut graph) (g/create alc)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        guard (require (b/variable! (mut graph) 5 start "guard" alignment))
        sentinel (require (b/scalar-constant! (mut graph) 5 321 8))
        moving (require (b/scalar-constant! (mut graph) 5 317 8))
        size (require (b/scalar-constant! (mut graph) 5 73 8))
        guarded (require (b/emit! (mut graph) 88 0 [start guard sentinel]))
        dynamic (require (b/stack-allocate! (mut graph) guarded size alignment))
        (mut control)
          (require (b/emit! (mut graph) 94 0 [dynamic dynamic moving]))
        width (types/size ty 8)
        result-type (if (= op 61) st ty)
        (mut results) (ArrayList::new [i32] alc)
        (mut originals) (ArrayList::new [i32] alc)
        (mut replacements) (ArrayList::new [i32] alc)
        (mut indices) (ArrayList::new [i32] alc)
        (mut i) (: 0 i32)
        (mut failures) 0
        (mut called) (: 0 i32)]
    (while (< i 40)
      (let [(mut original) (: 0 i32)
            (mut index) (: 0 i32)
            (mut replacement) (: 0 i32)]
        (when (!= op 63)
          (set! control
                (require (b/vector-load! (mut graph)
                                         ty
                                         8
                                         control
                                         (address! (mut graph)
                                                   input
                                                   (* i width))
                                         true)))
          (set! original control)
          (set! control
                (require (b/emit! (mut graph)
                                  92
                                  5
                                  [control
                                   (address! (mut graph) input (+ 1024 (* i 8)))])))
          (set! index control))
        (when (!= op 61)
          (set! control
                (require (b/emit! (mut graph)
                                  92
                                  st
                                  [control
                                   (address! (mut graph) input (+ 1536 (* i 8)))])))
          (set! replacement control))
        (let [result
                (require (if (= op 61)
                             (b/vector-extract! (mut graph) st 8 original index)
                             (if (= op 62)
                                 (b/vector-replace! (mut graph)
                                                    ty
                                                    8
                                                    original
                                                    index
                                                    replacement)
                                 (b/vector-splat! (mut graph) ty 8 replacement))))
              storage
                (require (b/variable! (mut graph)
                                      result-type
                                      start
                                      "computed"
                                      0))]
          (push! (mut results) result)
          (push! (mut originals) original)
          (push! (mut replacements) replacement)
          (push! (mut indices) index)
          (set! control
                (require (b/emit! (mut graph) 88 0 [control storage result])))))
      (set! i (+ i 1)))
    (match (calls/create 9 5 [(: 6 u8)] alc)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (match (calls/emit! (mut graph)
                                prototype
                                control
                                target
                                [input]
                                alc)
              (Err [message]
                   (println "{}" message)
                   (set! failures (+ failures 1)))
              (Ok [value] (set! called value) (set! control value)))
            (calls/release! (mut prototype)))))
    (set! i 0)
    (while (< i 40)
      (let [value (get results (cast i64 i))
            dest (address! (mut graph) output (* i 16))]
        (set! control
              (require (if (= op 61)
                           (b/emit! (mut graph) 94 0 [control dest value])
                           (b/vector-store! (mut graph)
                                            8
                                            control
                                            dest
                                            value
                                            true))))
        (when (!= op 63)
          (set! control
                (require (b/vector-store! (mut graph)
                                          8
                                          control
                                          (address! (mut graph)
                                                    output
                                                    (+ 640 (* i 16)))
                                          (get originals (cast i64 i))
                                          true)))
          (set! control
                (require (b/emit! (mut graph)
                                  94
                                  0
                                  [control
                                   (address! (mut graph)
                                             output
                                             (+ 1600 (* i 8)))
                                   (get indices (cast i64 i))]))))
        (when (!= op 61)
          (set! control
                (require (b/emit! (mut graph)
                                  94
                                  0
                                  [control
                                   (address! (mut graph)
                                             output
                                             (+ 1280 (* i 8)))
                                   (get replacements (cast i64 i))])))))
      (set! i (+ i 1)))
    (let [fixed (require (b/emit! (mut graph) 86 5 [control guard]))
          live-dynamic (require (b/emit! (mut graph) 92 5 [fixed dynamic]))
          sum (require (b/emit! (mut graph) 26 5 [fixed live-dynamic]))
          answer (require (b/emit! (mut graph) 26 5 [sum called]))
          ret
            (require (b/emit! (mut graph) 120 5 [live-dynamic answer (: 0 i32)]))]
      (match (compile/object graph start [ret] (fixture-name id) alc)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [object]
            (let [(mut object) object]
              (match (fs/write-file alc (fixture-path id) (slice object))
                (Err [_] (set! failures (+ failures 1)))
                (Ok [_] 0))
              (free! (mut object)))))
      (match (compile/image graph start [ret] "_lane_pressure_jit" alc)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [source]
            (let [(mut source) source]
              (match (jit/map-image source alc)
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [loaded]
                    (let [(mut loaded) loaded]
                      (set! failures
                            (+ failures
                               (pressure-exercise ty
                                                  op
                                                  st
                                                  (.base (.memory loaded)))))
                      (jit/release-image! (mut loaded)))))
              (image/release! (mut source))))))
    (free! (mut results))
    (free! (mut originals))
    (free! (mut replacements))
    (free! (mut indices))
    (g/release! (mut graph))
    failures))

