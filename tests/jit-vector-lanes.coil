(defn fixture-name [(id i32)] (-> (slice u8))
  (block :found
    (for fixture FIXTURES
      (when (= (.id fixture) id) (return-from :found (.name fixture))))
    "invalid"))

(defn fixture-path [(id i32)] (-> (slice u8))
  (block :found
    (for fixture FIXTURES
      (when (= (.id fixture) id) (return-from :found (.path fixture))))
    "invalid"))

(defn generate [(ty i32) (op i32) (st i32) (ity i32) (lane i32) (mode i32)]
  (-> i64)
  (let [alc (malloc-allocator)
        (mut graph) (g/create alc)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        index-address (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        value-address (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 3]))
        (mut control) start
        (mut data-value) (: 0 i32)
        (mut index-value) (: 0 i32)
        (mut replacement) (: 0 i32)
        (mut payload) (ArrayList::new [u8] alc)
        (mut failures) 0
        (mut i) (: 0 i32)]
    (when (!= op 63)
      (set! control
            (require (b/vector-load! (mut graph) ty 8 control input true)))
      (set! data-value control)
      (when (or (= mode 1) (= mode 3))
        (while (< i (types/size ty 8))
          (push! (mut payload)
                 (vector-byte (types/base-type ty) (cast i64 i) 0 mode))
          (set! i (+ i 1)))
        (set! data-value
              (require (b/vector-constant! (mut graph) ty 8 (slice payload)))))
      (if (>= lane 0)
          (set! index-value
                (require (b/scalar-constant! (mut graph) ity (cast u64 lane) 8)))
          (do
            (set! control
                  (require (b/emit! (mut graph) 92 ity [control index-address])))
            (set! index-value control))))
    (when (!= op 61)
      (if (or (= mode 2) (= mode 3))
          (set! replacement
                (require (b/scalar-constant! (mut graph)
                                             st
                                             (replacement-bits st 0 mode)
                                             8)))
          (do
            (set! control
                  (require (b/emit! (mut graph) 92 st [control value-address])))
            (set! replacement control))))
    (let [result
            (require (if (= op 61)
                         (b/vector-extract! (mut graph)
                                            st
                                            8
                                            data-value
                                            index-value)
                         (if (= op 62)
                             (b/vector-replace! (mut graph)
                                                ty
                                                8
                                                data-value
                                                index-value
                                                replacement)
                             (b/vector-splat! (mut graph) ty 8 replacement))))]
      (set! control
            (require (if (= op 61)
                         (b/emit! (mut graph) 94 0 [control output result])
                         (b/vector-store! (mut graph)
                                          8
                                          control
                                          output
                                          result
                                          true))))
      (when (and (= op 61) (types/integer? st))
        (let [wide
                (if (= (types/scalar-size st 8) 8)
                    result
                    (require (b/conversion! (mut graph)
                                            (if (types/signed? st) 33 34)
                                            (if (types/signed? st) 11 5)
                                            8
                                            result)))]
          (set! control
                (require (b/emit! (mut graph)
                                  94
                                  0
                                  [control
                                   (address! (mut graph) output 16)
                                   wide])))))
      (when (< mode 4)
        (when (!= op 63)
          (set! control
                (require (b/vector-store! (mut graph)
                                          8
                                          control
                                          (address! (mut graph) output 32)
                                          data-value
                                          true)))
          (set! control
                (require (b/emit! (mut graph)
                                  94
                                  0
                                  [control
                                   (address! (mut graph) output 80)
                                   index-value]))))
        (when (!= op 61)
          (set! control
                (require (b/emit! (mut graph)
                                  94
                                  0
                                  [control
                                   (address! (mut graph) output 64)
                                   replacement])))))
      (let [ret (require (b/emit! (mut graph) 120 0 [control (: 0 i32) 0]))
            id (fixture-id ty op st ity lane mode)]
        (when (>= id 0)
          (match (compile/object graph start [ret] (fixture-name id) alc)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [object]
                (let [(mut object) object]
                  (match (fs/write-file alc (fixture-path id) (slice object))
                    (Err [_] (set! failures (+ failures 1)))
                    (Ok [_] 0))
                  (free! (mut object))))))
        (match (compile/image graph start [ret] "_vector_lanes_jit" alc)
          (Err [message]
               (println "lane graph ty{} op{} st{} ity{} lane{} mode{}: {}"
                        ty
                        op
                        st
                        ity
                        lane
                        mode
                        message)
               (set! failures (+ failures 1)))
          (Ok [source]
              (let [(mut source) source]
                (match (jit/map-image source alc)
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [loaded]
                      (let [(mut loaded) loaded]
                        (set! failures
                              (+ failures
                                 (exercise ty
                                           op
                                           st
                                           ity
                                           lane
                                           mode
                                           (.base (.memory loaded)))))
                        (jit/release-image! (mut loaded)))))
                (image/release! (mut source)))))))
    (free! (mut payload))
    (g/release! (mut graph))
    failures))

(import "stogir.a64.encode" :as encode)
(import "stogir.a64.vector-lanes" :as native)
(import "stogir.bytes" :as bytes)

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

(defn alias-check [(ty i32) (op i32) (st i32) (rd i32) (rn i32) (lane i32)]
  (-> i64)
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))
        (mut error) ""
        (mut failures) 0
        width (types/size ty 8)
        element (types/scalar-size st 8)]
    (word! (mut text) (mut error) (encode/logical-register true 1 9 31 0))
    (when (!= op 63)
      (word! (mut text)
             (mut error)
             (encode/floating-load-store true width (- rn 32) 1 0))
      (when (< lane 0)
        (word! (mut text) (mut error) (encode/load-store true 8 16 2 0))))
    (when (!= op 61)
      (word! (mut text) (mut error) (encode/load-store true element 17 3 0)))
    (match (native/emit-prepared! (mut text) op ty st rd rn lane)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (if (= op 61)
        (if (types/floating? st)
            (word! (mut text)
                   (mut error)
                   (encode/floating-load-store false element (- rd 32) 9 0))
            (do
              (word! (mut text)
                     (mut error)
                     (encode/load-store false element rd 9 0))
              (when (< element 8)
                (word! (mut text)
                       (mut error)
                       (encode/extend true
                                      (types/signed? st)
                                      (* element 8)
                                      rd
                                      rd)))
              (word! (mut text) (mut error) (encode/load-store false 8 rd 9 16))))
        (word! (mut text)
               (mut error)
               (encode/floating-load-store false width (- rd 32) 9 0)))
    (bytes/append32! (mut text) 0xD65F03C0)
    (if (!= error "")
        (do (println "{}" error) (set! failures (+ failures 1)))
        (match (jit/map-text (slice text))
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [loaded]
              (let [(mut loaded) loaded]
                (set! failures
                      (+ failures (exercise ty op st 5 lane 5 (.base loaded))))
                (jit/release! (mut loaded))))))
    (free! (mut text))
    failures))

