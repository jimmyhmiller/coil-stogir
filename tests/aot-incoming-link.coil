(module stogir.tests.aot-incoming-link)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern stogir.incoming-test
        :as
        "stogir_incoming_test"
        :cc
        (cc/C)
        [u64 i64 i64 i64 i64 i64 i64 i64 i32 i32 i64 i32 i64]
        (-> i64))

(defn combine :cc (cc/C) [(a i64) (b i64)] (-> i64)
  (+ (* a 3) (* b 5)))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of combine)))
        (mut failures) 0]
    (for a [(: -2147483648 i32) -100 -1 0 1 100 2147483647]
      (for x [(: -100 i64) -1 0 1 100]
        (let [c (- (* x 7) 9)
              e (+ (* x 3) 100)
              expected (+ (* (cast i64 a) 3) (* c 5) x e)]
          (when (!= (stogir.incoming-test target
                                          x
                                          77
                                          88
                                          99
                                          111
                                          222
                                          333
                                          a
                                          -123
                                          c
                                          314
                                          e)
                    expected)
            (set! failures (+ failures 1))))))
    (println "linked AOT incoming parameter checks: {} failures" failures)
    (if (= failures 0) 0 1)))
