(module stogir.tests.aot-iter-fold-link)
(import "coil.cc" :as cc)

(extern calculate :as "iter_fold" :cc (cc/C) [i64 i64] (-> i64))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for x [-100 -7 0 3 29]
      (for y [-99 -1 0 17 53]
        (when (!= (calculate x y) (+ (* 4 (+ x y)) 14))
          (set! failures (+ failures 1)))))
    (println "incremental fold linked AOT checks: {} failures" failures)
    (if (= failures 0) 0 1)))
