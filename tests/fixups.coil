(module stogir.tests.fixups)
(import "stogir.a64.fixups" :as f)
(import "stogir.a64.code" :as code)
(import "stogir.text-data" :as data)
(import "stogir.bytes" :as b)
(import "stogir.relocate" :as read)
(import "stogir.a64.encode" :as e)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn relative-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut labels) (ArrayList::new [i64] allocator)
        (mut records) (ArrayList::new [f/Relative] allocator)
        (mut failures) 0]
    (for word [(: 0xA5A5A5A5 u32) 0xA5A5A5A5 0xA5A5A5A5 0xA5A5A5A5]
      (b/append32! (mut output) word))
    (push! (mut labels) 0)
    (push! (mut labels) 16)
    (push! (mut records)
           (f/Relative
             :offset 4
             :base 8
             :label 0))
    (push! (mut records)
           (f/Relative
             :offset 8
             :base 8
             :label 1))
    (match (f/apply-relative! (mut output) labels records)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [count] (when (!= count 2) (set! failures (+ failures 1)))))
    (when (or (!= (read/read32 output 0) 0xA5A5A5A5)
              (!= (read/read32 output 4) 0xFFFFFFF8)
              (!= (read/read32 output 8) 8)
              (!= (read/read32 output 12) 0xA5A5A5A5))
      (set! failures (+ failures 1)))
    (set! (mut labels) 0 4)
    (set! (mut labels) 1 -1)
    (match (f/apply-relative! (mut output) labels records)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (when (!= (read/read32 output 4) 0xFFFFFFF8) (set! failures (+ failures 1)))
    (clear! (mut records))
    (for invalid [(f/Relative
                    :offset 1
                    :base 8
                    :label 0)
                  (f/Relative
                    :offset 16
                    :base 8
                    :label 0)
                  (f/Relative
                    :offset 4
                    :base -4
                    :label 0)
                  (f/Relative
                    :offset 4
                    :base 16
                    :label 0)
                  (f/Relative
                    :offset 4
                    :base 8
                    :label 2)]
      (push! (mut records) invalid)
      (match (f/apply-relative! (mut output) labels records)
        (Err [_] 0)
        (Ok [_] (set! failures (+ failures 1))))
      (clear! (mut records)))
    (free! (mut output))
    (free! (mut labels))
    (free! (mut records))
    failures))

;;; Expanding the second branch pushes the first past its exact positive limit.
;;; All address-bearing metadata must follow the resulting fixed-point layout.
(defn relaxed-metadata [(invalid bool) (aligned bool)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut output) (code/create allocator)
        (mut labels) (ArrayList::new [i64] allocator)
        (mut branches) (ArrayList::new [f/Branch] allocator)
        (mut relatives) (ArrayList::new [f/Relative] allocator)
        (mut alignment) (ArrayList::new [i32] allocator)
        size (: 1048600 i64)
        (mut failures) 0]
    (while (< (len (.text output)) size) (b/append32! (mut (.text output)) 0))
    (push! (mut labels) 1048572)
    (push! (mut labels) 1048580)
    (push! (mut labels) -1)
    (push! (mut branches)
           (f/Branch
             :offset 0
             :label 0
             :condition 0
             :link false))
    (push! (mut branches)
           (f/Branch
             :offset 4
             :label 1
             :condition 1
             :link false))
    (push! (mut (.references output))
           (code/Reference
             :offset 16
             :kind 2
             :target -1))
    (push! (mut (.text-data output))
           (data/Range
             :offset 32
             :length 8
             :kind 4))
    (push! (mut relatives)
           (f/Relative
             :offset 32
             :base 32
             :label (if invalid 99 1)))
    (for [i 0 (len labels)]
      (push! (mut alignment) (if (and aligned (= i 0)) 8 4)))
    (match (f/relax-aligned! (mut output)
                             (mut labels)
                             (mut branches)
                             (mut relatives)
                             alignment)
      (Err [_] (when (not invalid) (set! failures (+ failures 1))))
      (Ok [count]
          (when (or invalid (!= count 2)) (set! failures (+ failures 1)))))
    (if invalid
        (when (or (!= (.alignment output) 4)
                  (!= (len (.text output)) size)
                  (!= (read/read32 (.text output) 0) 0)
                  (!= (get labels 0) 1048572)
                  (!= (.offset (get branches 1)) 4)
                  (!= (.offset (get (.references output) 0)) 16)
                  (!= (.offset (get (.text-data output) 0)) 32)
                  (!= (.base (get relatives 0)) 32))
          (set! failures (+ failures 1)))
        (do
          (when (or (!= (.alignment output) (if aligned 8 4))
                    (!= (len (.text output)) (+ size (if aligned 12 8)))
                    (!= (read/read32 (.text output) 0) 0x54000041)
                    (!= (read/read32 (.text output) 8) 0x54000040)
                    (!= (get labels 0) (if aligned 1048584 1048580))
                    (!= (get labels 1) (if aligned 1048592 1048588))
                    (!= (get labels 2) -1)
                    (!= (.offset (get branches 0)) 4)
                    (!= (.offset (get branches 1)) 12)
                    (!= (.offset (get (.references output) 0)) 24)
                    (!= (.offset (get (.text-data output) 0)) 40)
                    (!= (.length (get (.text-data output) 0)) 8)
                    (!= (.offset (get relatives 0)) 40)
                    (!= (.base (get relatives 0)) 40)
                    (!= (read/read32 (.text output) 40)
                        (if aligned 1048552 1048548)))
            (set! failures (+ failures 1)))))
    (free! (mut alignment))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut branches))
    (free! (mut relatives))
    failures))

(defn relaxed-boundary [(offset i64) (target i64) (expected i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut output) (code/create allocator)
        (mut labels) (ArrayList::new [i64] allocator)
        (mut branches) (ArrayList::new [f/Branch] allocator)
        (mut relatives) (ArrayList::new [f/Relative] allocator)
        size (+ (if (> offset target) offset target) 4)
        (mut failures) 0]
    (while (< (len (.text output)) size) (b/append32! (mut (.text output)) 0))
    (push! (mut labels) target)
    (push! (mut branches)
           (f/Branch
             :offset offset
             :label 0
             :condition 0
             :link false))
    (match (f/relax! (mut output) (mut labels) (mut branches) (mut relatives))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [count] (when (!= count expected) (set! failures (+ failures 1)))))
    (when (!= (len (.text output)) (+ size (* (cast i64 expected) 4)))
      (set! failures (+ failures 1)))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut branches))
    (free! (mut relatives))
    failures))

;;; CBZ/CBNZ conditions: exact near encodings for both widths, XOR-1 inversion
;;; under far relaxation, and rejection of codes outside both families.
(defn register-branches [] (-> i64)
  (let [a (malloc-allocator)
        (mut failures) 0]
    (let [(mut output) (ArrayList::new [u8] a)
          (mut labels) (ArrayList::new [i64] a)
          (mut branches) (ArrayList::new [f/Branch] a)]
      (for [i 0 4] (b/append32! (mut output) 0xD503201F))
      (push! (mut labels) 8)
      (push! (mut labels) 0)
      (push! (mut branches)
             (f/Branch :offset 0 :label 0 :condition (e/register-condition 5 true false)
                       :link false))
      (push! (mut branches)
             (f/Branch :offset 12 :label 1 :condition (e/register-condition 3 false true)
                       :link false))
      (match (f/apply! (mut output) labels branches)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [count] (when (!= count 2) (set! failures (+ failures 1)))))
      ; CBZ x5, +8 and CBNZ w3, -12.
      (when (or (!= (read/read32 output 0) 0xB4000045)
                (!= (read/read32 output 12) 0x35FFFFA3))
        (set! failures (+ failures 1)))
      (when (or (!= (^ (e/register-condition 7 true false) 1)
                    (e/register-condition 7 true true))
                (e/branch-condition? 16)
                (e/branch-condition? 63)
                (e/branch-condition? 192)
                (not (e/branch-condition? 191)))
        (set! failures (+ failures 1)))
      (clear! (mut branches))
      (push! (mut branches)
             (f/Branch :offset 0 :label 0 :condition 200 :link false))
      (match (f/apply! (mut output) labels branches)
        (Err [_] 0)
        (Ok [_] (set! failures (+ failures 1))))
      (free! (mut output))
      (free! (mut labels))
      (free! (mut branches)))
    ; One word past CBZ's positive reach: inverse CBNZ over an unconditional B.
    (let [(mut output) (code/create a)
          (mut labels) (ArrayList::new [i64] a)
          (mut branches) (ArrayList::new [f/Branch] a)
          (mut relatives) (ArrayList::new [f/Relative] a)
          target (: 1048576 i64)]
      (while (< (len (.text output)) (+ target 4)) (b/append32! (mut (.text output)) 0))
      (push! (mut labels) target)
      (push! (mut branches)
             (f/Branch :offset 0 :label 0 :condition (e/register-condition 5 true false)
                       :link false))
      (match (f/relax! (mut output) (mut labels) (mut branches) (mut relatives))
        (Err [_] (set! failures (+ failures 1)))
        (Ok [count] (when (!= count 1) (set! failures (+ failures 1)))))
      (match (f/apply! (mut (.text output)) labels branches)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [_] 0))
      (when (or (!= (read/read32 (.text output) 0) 0xB5000045)
                (!= (get labels 0) (+ target 4))
                (!= (read/read32 (.text output) 4)
                    (| (: 0x14000000 u32) (cast u32 (/ target 4)))))
        (set! failures (+ failures 1)))
      (code/release! (mut output))
      (free! (mut labels))
      (free! (mut branches))
      (free! (mut relatives)))
    failures))

(defn alignment-only [(invalid bool)] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut relatives) (ArrayList::new [f/Relative] a)
        (mut alignment) (ArrayList::new [i32] a)
        (mut failures) 0]
    (b/append32! (mut (.text output)) 0xD503201F)
    (b/append32! (mut (.text output)) 0xD65F03C0)
    (push! (mut labels) 4)
    (push! (mut alignment) (if invalid 6 8))
    (match (f/relax-aligned! (mut output)
                             (mut labels)
                             (mut branches)
                             (mut relatives)
                             alignment)
      (Err [_] (when (not invalid) (set! failures (+ failures 1))))
      (Ok [count]
          (when (or invalid (!= count 0)) (set! failures (+ failures 1)))))
    (when (or (!= (len (.text output)) (if invalid 8 12))
              (!= (get labels 0) (if invalid 4 8))
              (!= (.alignment output) (if invalid 4 8))
              (!= (read/read32 (.text output) (if invalid 4 8)) 0xD65F03C0))
      (set! failures (+ failures 1)))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut branches))
    (free! (mut relatives))
    (free! (mut alignment))
    failures))

;;; A branch and a relocation cannot describe the same instruction word.
(defn relocation-overlap [] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut relatives) (ArrayList::new [f/Relative] a)
        (mut failures) 0]
    (while (< (len (.text output)) 1048612)
      (b/append32! (mut (.text output)) 0))
    (push! (mut labels) 1048608)
    (push! (mut branches)
           (f/Branch
             :offset 8
             :label 0
             :condition 0
             :link false))
    (push! (mut (.references output))
           (code/Reference
             :offset 8
             :kind 4
             :target -1))
    (match (f/relax! (mut output) (mut labels) (mut branches) (mut relatives))
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (when (or (!= (len (.text output)) 1048612)
              (!= (get labels 0) 1048608)
              (!= (.offset (get branches 0)) 8)
              (!= (.condition (get branches 0)) 0)
              (!= (read/read32 (.text output) 8) 0))
      (set! failures (+ failures 1)))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut branches))
    (free! (mut relatives))
    failures))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (ArrayList::new [u8] a)
        (mut labels) (ArrayList::new [i64] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut failures)
          (+ (relative-check)
             (register-branches)
             (relocation-overlap)
             (alignment-only false)
             (alignment-only true)
             (relaxed-metadata false false)
             (relaxed-metadata true false)
             (relaxed-metadata false true)
             (relaxed-metadata true true)
             (relaxed-boundary 0 1048572 0)
             (relaxed-boundary 0 1048576 1)
             (relaxed-boundary 1048576 0 0)
             (relaxed-boundary 1048580 0 1))]
    (b/append32! (mut output) 0)
    (b/append32! (mut output) 0)
    (push! (mut labels) 0)
    (push! (mut labels) 4)
    (push! (mut branches)
           (f/Branch
             :offset 0
             :label 1
             :condition -1
             :link false))
    (push! (mut branches)
           (f/Branch
             :offset 4
             :label 0
             :condition 0
             :link false))
    (match (f/apply! (mut output) labels branches)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [count] (when (!= count 2) (set! failures (+ failures 1)))))
    (when (!= (get output 0) 1) (set! failures (+ failures 1)))
    (when (!= (get output 3) 0x14) (set! failures (+ failures 1)))
    (when (!= (get output 4) 0xE0) (set! failures (+ failures 1)))
    (when (!= (get output 7) 0x54) (set! failures (+ failures 1)))
    (set! (mut labels) 1 0)
    (set! (mut labels) 0 -1)
    (match (f/apply! (mut output) labels branches)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    ; First fixup would change byte zero if patching were not transactional.
    (when (!= (get output 0) 1) (set! failures (+ failures 1)))
    (free! (mut output))
    (free! (mut labels))
    (free! (mut branches))
    (println "branch fixup checks: {} failures" failures)
    (if (= failures 0) 0 1)))
