(module stogir.tests.jit-vector-arithmetic)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.var" :use [var-static])
(import "stogir.types" :as types)
(import "stogir.target" :as target)
(import "stogir.test-data" :use [table])

(defn raw-pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [i (% (+ lane seed (if right? (: 3 i64) 0)) 11)
        fp? (types/floating? base)
        wide? (= base 12)]
    (if fp?
        (if wide?
            (match i
              (0 (: 0 u64))
              (1 0x8000000000000000)
              (2 0x3FF0000000000000)
              (3 0xBFF0000000000000)
              (4 1)
              (5 0x000FFFFFFFFFFFFF)
              (6 0x7FEFFFFFFFFFFFFF)
              (7 0x7FF0000000000000)
              (8 0xFFF0000000000000)
              (9 0x7FF8123456789ABC)
              (_ 0x7FF0123456789ABC))
            (match i
              (0 (: 0 u64))
              (1 0x80000000)
              (2 0x3F800000)
              (3 0xBF800000)
              (4 1)
              (5 0x007FFFFF)
              (6 0x7F7FFFFF)
              (7 0x7F800000)
              (8 0xFF800000)
              (9 0x7FC12345)
              (_ 0x7F812345)))
        (match i
          (0 (: 0 u64))
          (1 1)
          (2 0xFFFFFFFFFFFFFFFF)
          (3 0x8000000000000000)
          (4 0x7FFFFFFFFFFFFFFF)
          (5 0x8080808080808080)
          (6 0x7F7F7F7F7F7F7F7F)
          (7 0xFFFF0000FFFF0000)
          (8 0x123456789ABCDEF0)
          (9 0xFFFFFFFFFFFFFFFE)
          (_ 0x0102030405060708)))))

;;; An integer DIV or MOD traps on x86-64 where AArch64 defines a result: a
;;; zero divisor, and MIN / -1 on 4- and 8-byte signed lanes. While such an
;;; operation is exercised on x86-64, `division` is 1 (the right operand is
;;; the divisor) or 2 (one value is both operands) and the operand patterns
;;; avoid those inputs: a zero becomes 1, and so does a -1 on a wide signed
;;; lane. It stays 0 on AArch64, whose results for those inputs are checked.
(def division (var-static i32 0))

(defn divides? [(opcode i32) (base i32)] (-> bool)
  (and (types/integer? base) (or (= opcode 29) (= opcode 30))))

(defn division! [(opcode i32) (base i32) (shared? bool)] (-> void)
  (set division
       (target/arch-pick (: 0 i32)
                         (if (divides? opcode base) (if shared? (: 2 i32) 1) 0))))

;;; Whether the fixed operands of `mode` are defined inputs on this target:
;;; mode 6 divides by zero and mode 5 is MIN / -1.
(defn defined? [(opcode i32) (base i32) (mode i32)] (-> bool)
  (target/arch-pick
    true
    (not (and (divides? opcode base)
              (or (= mode 6)
                  (and (= mode 5)
                       (types/signed? base)
                       (>= (types/scalar-size base 8) 4)))))))

(defn pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [raw (raw-pattern base lane seed right?)
        policy (get division)
        bits (* 8 (types/scalar-size base 8))
        mask (cast u64 (- (<< (: 1 u128) (cast u128 bits)) 1))]
    (if (or (= policy 0) (and (= policy 1) (not right?)))
        raw
        (if (or (= (& raw mask) 0)
                (and (types/signed? base) (>= bits 32) (= (& raw mask) mask)))
            1
            raw))))

(defn input-byte [(base i32) (index i64) (seed i64) (right? bool)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (pattern base (/ index width) seed right?)
              (cast u64 (* (% index width) 8))))))

(defn literal-word [(base i32) (lane i64) (right? bool) (mode i32)] (-> u64)
  (let [bits (* 8 (types/scalar-size base 8))
        mask (cast u64 (- (<< (: 1 u128) (cast u128 bits)) 1))]
    (if (= mode 5)
        (if right? mask (cast u64 (<< (: 1 u128) (cast u128 (- bits 1)))))
        (if (and (= mode 6) right?) (: 0 u64) (pattern base lane 0 right?)))))

(defn literal-byte [(base i32) (index i64) (right? bool) (mode i32)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (literal-word base (/ index width) right? mode)
              (cast u64 (* (% index width) 8))))))

(defn nan? [(base i32) (bits u64)] (-> bool)
  (let [exponent (if (= base 12) (: 0x7FF0000000000000 u64) 0x7F800000)
        fraction (if (= base 12) (: 0x000FFFFFFFFFFFFF u64) 0x007FFFFF)]
    (and (= (& bits exponent) exponent) (!= (& bits fraction) 0))))

(defn expected [(opcode i32) (base i32) (a u64) (b u64)] (-> u64)
  (if (types/floating? base)
      (if (= base 12)
          (let [(mut x) (: 0.0 f64)
                (mut y) (: 0.0 f64)]
            (p/store! (p/cast (ptr u64) (mut x)) a)
            (p/store! (p/cast (ptr u64) (mut y)) b)
            (let [(mut result)
                    (match opcode
                      (26 (+ x y))
                      (27 (- x y))
                      (28 (* x y))
                      (_ (/ x y)))]
              (p/load (p/cast (ptr u64) (mut result)))))
          (let [(mut x) (: 0.0 f32)
                (mut y) (: 0.0 f32)]
            (p/store! (p/cast (ptr u32) (mut x)) (cast u32 a))
            (p/store! (p/cast (ptr u32) (mut y)) (cast u32 b))
            (let [(mut result)
                    (match opcode
                      (26 (+ x y))
                      (27 (- x y))
                      (28 (* x y))
                      (_ (/ x y)))]
              (cast u64 (p/load (p/cast (ptr u32) (mut result)))))))
      (let [width (* 8 (types/scalar-size base 8))
            mask (- (<< (: 1 u128) (cast u128 width)) 1)
            x (& (cast u128 a) mask)
            y (& (cast u128 b) mask)]
        (cast u64
              (& mask
                 (match opcode
                   (26 (+ x y))
                   (27 (- (+ x (+ mask 1)) y))
                   (28 (* x y))
                   (29 (if (= y 0)
                           (: 0 u128)
                           (if (types/signed? base)
                               (let [range (+ mask 1)
                                     sign (>> range 1)
                                     sx
                                       (if (>= x sign)
                                           (- (cast i128 x) (cast i128 range))
                                           (cast i128 x))
                                     sy
                                       (if (>= y sign)
                                           (- (cast i128 y) (cast i128 range))
                                           (cast i128 y))]
                                 (cast u128 (/ sx sy)))
                               (/ x y))))
                   (30 (if (= y 0)
                           x
                           (if (types/signed? base)
                               (let [range (+ mask 1)
                                     sign (>> range 1)
                                     sx
                                       (if (>= x sign)
                                           (- (cast i128 x) (cast i128 range))
                                           (cast i128 x))
                                     sy
                                       (if (>= y sign)
                                           (- (cast i128 y) (cast i128 range))
                                           (cast i128 y))]
                                 (cast u128 (- sx (* (/ sx sy) sy))))
                               (- x (* (/ x y) y)))))
                   (46 (| x y))
                   (47 (& x y))
                   (_ (^ x y))))))))

(defn exercise [(ty i32) (opcode i32) (mode i32) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        base (types/base-type ty)
        width (types/size ty 8)
        lane-width (types/scalar-size base 8)
        lanes (/ width lane-width)
        f (p/cast (fnptr (cc/C) [u64 u64 u64] void) address)
        (mut a) (ArrayList::new [u8] allocator)
        (mut b) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (clear! (mut a))
      (clear! (mut b))
      (clear! (mut output))
      (let [(mut i) (: 0 i64)]
        (while (< i 32)
          (push! (mut a) (input-byte base i seed false))
          (push! (mut b) (input-byte base i seed true))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 80) (push! (mut output) 165) (set! i (+ i 1))))
      (call-ptr f
                (p/cast u64 (.data output))
                (p/cast u64 (.data a))
                (p/cast u64 (.data b)))
      (let [(mut lane) (: 0 i32)]
        (while (< lane lanes)
          (let [x
                  (if (or (= mode 1) (= mode 3) (>= mode 5))
                      (literal-word base (cast i64 lane) false mode)
                      (pattern base (cast i64 lane) seed false))
                y
                  (if (= mode 4)
                      x
                      (if (or (= mode 2) (= mode 3) (>= mode 5))
                          (literal-word base (cast i64 lane) true mode)
                          (pattern base (cast i64 lane) seed true)))
                result (expected opcode base x y)
                (mut got) (: 0 u64)
                (mut byte) (: 0 i32)]
            (while (< byte lane-width)
              (set! got
                    (| got
                       (<< (cast u64
                                 (get output
                                      (cast i64 (+ (* lane lane-width) byte))))
                           (cast u64 (* byte 8)))))
              (set! byte (+ byte 1)))
            (when (if (and (types/floating? base) (nan? base result))
                      (not (nan? base got))
                      (!= got result))
              (println "vector binary ty{} op{} mode{} seed{} lane{} got{} expected{}"
                       ty
                       opcode
                       mode
                       seed
                       lane
                       got
                       result)
              (set! failures (+ failures 1))))
          (set! lane (+ lane 1))))
      (let [(mut i) (: 0 i64)]
        (while (< i 80)
          (when (>= i (cast i64 width))
            (let [left?
                    (and (!= mode 4) (>= i 24) (< i (+ 24 (cast i64 width))))
                  right?
                    (and (!= mode 4) (>= i 48) (< i (+ 48 (cast i64 width))))
                  wanted
                    (if left?
                        (if (or (= mode 1) (= mode 3) (>= mode 5))
                            (literal-byte base (- i 24) false mode)
                            (input-byte base (- i 24) seed false))
                        (if right?
                            (if (or (= mode 2) (= mode 3) (>= mode 5))
                                (literal-byte base (- i 48) true mode)
                                (input-byte base (- i 48) seed true))
                            (: 165 u8)))]
              (when (!= (get output i) wanted) (set! failures (+ failures 1)))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 32)
          (when (or (!= (get a i) (input-byte base i seed false))
                    (!= (get b i) (input-byte base i seed true)))
            (set! failures (+ failures 1)))
          (set! i (+ i 1))))
      (set! seed (+ seed 1)))
    (free! (mut a))
    (free! (mut b))
    (free! (mut output))
    failures))

;;; A callee that overwrites every register a call may change. AArch64: v0-v7
;;; and v16-v31 loaded from `input`, x0-x15 set, x0 = 173. x86-64 (bytes from
;;; tools/x86/asm-bytes.sh): movups xmm0..xmm15, [rdi]; mov eax, 173;
;;; mov ecx, 174; mov edx, 175; mov esi, 176; mov edi, 177; mov r8d, 178;
;;; mov r9d, 179; mov r10d, 180; mov r11d, 181.
(target/arch-pick
  (defn probe :cc (cc/C) [(input (ptr u8))] (-> u64)
    (p/machine-code (Aarch64)
                    0xf1
                    0x03
                    0x00
                    0xaa
                    0x20
                    0x02
                    0xc0
                    0x3d
                    0x21
                    0x02
                    0xc0
                    0x3d
                    0x22
                    0x02
                    0xc0
                    0x3d
                    0x23
                    0x02
                    0xc0
                    0x3d
                    0x24
                    0x02
                    0xc0
                    0x3d
                    0x25
                    0x02
                    0xc0
                    0x3d
                    0x26
                    0x02
                    0xc0
                    0x3d
                    0x27
                    0x02
                    0xc0
                    0x3d
                    0x30
                    0x02
                    0xc0
                    0x3d
                    0x31
                    0x02
                    0xc0
                    0x3d
                    0x32
                    0x02
                    0xc0
                    0x3d
                    0x33
                    0x02
                    0xc0
                    0x3d
                    0x34
                    0x02
                    0xc0
                    0x3d
                    0x35
                    0x02
                    0xc0
                    0x3d
                    0x36
                    0x02
                    0xc0
                    0x3d
                    0x37
                    0x02
                    0xc0
                    0x3d
                    0x38
                    0x02
                    0xc0
                    0x3d
                    0x39
                    0x02
                    0xc0
                    0x3d
                    0x3a
                    0x02
                    0xc0
                    0x3d
                    0x3b
                    0x02
                    0xc0
                    0x3d
                    0x3c
                    0x02
                    0xc0
                    0x3d
                    0x3d
                    0x02
                    0xc0
                    0x3d
                    0x3e
                    0x02
                    0xc0
                    0x3d
                    0x3f
                    0x02
                    0xc0
                    0x3d
                    0xa0
                    0x15
                    0x80
                    0xd2
                    0xc1
                    0x15
                    0x80
                    0xd2
                    0xe2
                    0x15
                    0x80
                    0xd2
                    0x03
                    0x16
                    0x80
                    0xd2
                    0x24
                    0x16
                    0x80
                    0xd2
                    0x45
                    0x16
                    0x80
                    0xd2
                    0x66
                    0x16
                    0x80
                    0xd2
                    0x87
                    0x16
                    0x80
                    0xd2
                    0xa8
                    0x16
                    0x80
                    0xd2
                    0xc9
                    0x16
                    0x80
                    0xd2
                    0xea
                    0x16
                    0x80
                    0xd2
                    0x0b
                    0x17
                    0x80
                    0xd2
                    0x2c
                    0x17
                    0x80
                    0xd2
                    0x4d
                    0x17
                    0x80
                    0xd2
                    0x6e
                    0x17
                    0x80
                    0xd2
                    0x8f
                    0x17
                    0x80
                    0xd2
                    0xc0
                    0x03
                    0x5f
                    0xd6))
  (defn probe :cc (cc/C) [(input (ptr u8))] (-> u64)
    (p/machine-code (X86_64)
                             0x0f 0x10 0x07 0x0f 0x10 0x0f 0x0f 0x10 0x17 0x0f 0x10 0x1f
                             0x0f 0x10 0x27 0x0f 0x10 0x2f 0x0f 0x10 0x37 0x0f 0x10 0x3f
                             0x44 0x0f 0x10 0x07 0x44 0x0f 0x10 0x0f 0x44 0x0f 0x10 0x17
                             0x44 0x0f 0x10 0x1f 0x44 0x0f 0x10 0x27 0x44 0x0f 0x10 0x2f
                             0x44 0x0f 0x10 0x37 0x44 0x0f 0x10 0x3f 0xb8 0xad 0x00 0x00
                             0x00 0xb9 0xae 0x00 0x00 0x00 0xba 0xaf 0x00 0x00 0x00 0xbe
                             0xb0 0x00 0x00 0x00 0xbf 0xb1 0x00 0x00 0x00 0x41 0xb8 0xb2
                             0x00 0x00 0x00 0x41 0xb9 0xb3 0x00 0x00 0x00 0x41 0xba 0xb4
                             0x00 0x00 0x00 0x41 0xbb 0xb5 0x00 0x00 0x00)))

(defn read-word [(buffer (slice u8)) (offset i64) (width i32)] (-> u64)
  (let [(mut result) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (< i width)
      (set! result
            (| result
               (<< (cast u64 (get buffer (+ offset (cast i64 i))))
                   (cast u64 (* i 8)))))
      (set! i (+ i 1)))
    result))

(defn pressure-exercise [(ty i32) (opcode i32) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        base (types/base-type ty)
        width (types/size ty 8)
        element (types/scalar-size base 8)
        lanes (/ width element)
        f (p/cast (fnptr (cc/C) [u64 u64 u64] u64) address)
        target
          (p/cast u64
                  (p/cast (ptr u8)
                          (: (fnptr-of probe) (fnptr (cc/C) [(ptr u8)] u64))))
        (mut input) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (clear! (mut input))
      (clear! (mut output))
      (let [(mut i) (: 0 i64)]
        (while (< i 2048)
          (push! (mut input) (input-byte base i seed false))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 2064) (push! (mut output) 165) (set! i (+ i 1))))
      (when (!= (call-ptr f
                          (p/cast u64 (p/index (.data output) 3))
                          (p/cast u64 (.data input))
                          target)
                811)
        (println "vector pressure guard/result ty{} op{} seed{}" ty opcode seed)
        (set! failures (+ failures 1)))
      (let [(mut lane) (: 0 i32)]
        (while (< lane (* 40 lanes))
          (let [a (pattern base (cast i64 lane) seed false)
                b (pattern base (cast i64 lane) 0 true)
                wanted (expected opcode base a b)
                got
                  (read-word (slice output)
                             (+ 3 (* (cast i64 lane) (cast i64 element)))
                             element)]
            (when (if (and (types/floating? base) (nan? base wanted))
                      (not (nan? base got))
                      (!= wanted got))
              (println "vector pressure ty{} op{} seed{} lane{} got{} expected{}"
                       ty
                       opcode
                       seed
                       lane
                       got
                       wanted)
              (set! failures (+ failures 1))))
          (set! lane (+ lane 1))))
      (let [(mut i) (: 0 i64)]
        (while (< i 2064)
          (let [pos (- i 3)]
            (when (not (and (>= pos 0) (< pos (* 40 (cast i64 width)))))
              (let [wanted
                      (if (and (>= pos 1024)
                               (< pos (+ 1024 (* 40 (cast i64 width)))))
                          (input-byte base (- pos 1024) seed false)
                          (: 165 u8))]
                (when (!= (get output i) wanted) (set! failures (+ failures 1))))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 2048)
          (when (!= (get input i) (input-byte base i seed false))
            (set! failures (+ failures 1)))
          (set! i (+ i 1))))
      (set! seed (+ seed 1)))
    (free! (mut input))
    (free! (mut output))
    failures))

(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.vector-arithmetic" :as va)
(import "stogir.native.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn address! [(graph (mut g/Graph)) (base i32) (offset i32)] (-> i32)
  (require (b/emit! (mut graph)
                    26
                    6
                    [base
                     (require (b/scalar-constant! (mut graph)
                                                  5
                                                  (cast u64 offset)
                                                  8))])))

