(module stogir.tests.sccp-values)
(import "stogir.sccp-values" :as v)
(import "stogir.bitqueue" :as q)
(import "stogir.uses" :as u)
(import "stogir.node" :as n)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.args" :as args)

(defn edges [(size i64)] (-> u/Uses)
  (let [(mut result)
          (u/Uses
            :ranges (ArrayList::new [u/Range] (malloc-allocator))
            :edges (ArrayList::new [u/Use] (malloc-allocator)))]
    (for [i 0 size]
      (push! (mut (.ranges result)) (u/Range :offset (* i 2) :count 2))
      (for [j 0 2]
        (push! (mut (.edges result))
               (u/Use
                 :user (cast i32 (+ 1 (% (+ i (* j 3)) (- size 1))))
                 :operand (cast i32 (+ j 1))))))
    result))

;;; Check both circular-list directions and every member's resolved identity.
;;; Roots without a partition have no list yet, as in pinned upstream.
(defn invariants [(domain v/Domain)] (-> i64)
  (let [(mut failures) 0
        size (len (.values domain))]
    (for [i 1 size]
      (let [value (v/at domain (cast i32 i))]
        (when (or (= (v/state-kind value) 68)
                  (and (= (v/state-kind value) 131)
                       (= (v/copy-source value) (cast i32 i))))
          (let [next (v/next-member value)
                previous (v/previous-member value)]
            (if (or (<= next 0)
                    (>= (cast i64 next) size)
                    (<= previous 0)
                    (>= (cast i64 previous) size))
                (set! failures (+ failures 1))
                (when (or (!= (v/previous-member (v/at domain next))
                              (cast i32 i))
                          (!= (v/next-member (v/at domain previous))
                              (cast i32 i))
                          (!= (v/identity domain next)
                              (v/identity domain (cast i32 i))))
                  (set! failures (+ failures 1))))))))
    failures))

(defn snapshot [(domain v/Domain) (step i64)] (-> void)
  (for [i 1 (len (.values domain))]
    (let [value (v/at domain (cast i32 i))
          kind (v/state-kind value)
          partition
            (or (= kind 68)
                (and (= kind 131) (= (v/copy-source value) (cast i32 i))))
          constant
            (or (and (>= kind 1) (<= kind 13))
                (and (>= kind 73) (<= kind 77)))]
      (println "VALUE {} {} {} {} {} {} {} {} {}"
               step
               i
               kind
               (if partition
                   (v/copy-source value)
                   (if (= kind 78) (.op2 value) 0))
               (if partition (v/next-member value) 0)
               (if partition (v/previous-member value) 0)
               (if (or constant (= kind 78))
                   (& (.header value) 65535)
                   0)
               (if constant (n/constant-bits value) (: 0 u64))
               (q/contains? (.pending domain) i)))))

(defn queue-checks [] (-> i64)
  (let [(mut queue) (q/create 257 (malloc-allocator))
        (mut failures) 0]
    (for i [256 255 128 127 64 63 1 0]
      (when (not (q/add! (mut queue) i)) (set! failures (+ failures 1)))
      (when (q/add! (mut queue) i) (set! failures (+ failures 1))))
    (for i [0 1 63 64 127 128 255 256]
      (when (!= (q/pop! (mut queue)) i) (set! failures (+ failures 1))))
    (when (!= (q/pop! (mut queue)) -1) (set! failures (+ failures 1)))
    (q/add! (mut queue) 256)
    (q/add! (mut queue) 1)
    (when (!= (q/pop! (mut queue)) 1) (set! failures (+ failures 1)))
    (q/add! (mut queue) 0)
    (when (!= (q/pop! (mut queue)) 0) (set! failures (+ failures 1)))
    (q/remove! (mut queue) 256)
    (when (!= (q/pop! (mut queue)) -1) (set! failures (+ failures 1)))
    (for i [-1 257 500]
      (when (q/add! (mut queue) i) (set! failures (+ failures 1))))
    (q/add! (mut queue) 64)
    (q/clear! (mut queue))
    (when (!= (q/pop! (mut queue)) -1) (set! failures (+ failures 1)))
    (q/release! (mut queue))
    failures))

(defn partitions [(size i64) (reverse bool) (oracle bool)] (-> i64)
  (let [(mut graph-uses) (edges size)
        (mut domain) (v/create size (malloc-allocator))
        (mut failures) 0
        (mut step) 0]
    (when oracle (println "CASE {}" size))
    (for [i 1 4]
      (v/make-bottom! (mut domain) graph-uses (cast i32 i))
      (when oracle (println "BOTTOM {}" i)))
    ; Interleaved dependent/independent copies form several partitions.
    (for [i 4 size]
      (let [source (cast i32 (if (= (% i 4) 0) (+ 1 (% i 3)) (- i 1)))]
        (v/meet-copy! (mut domain) graph-uses (cast i32 i) source)
        (when oracle (println "COPY {} {}" i source)))
      (set! failures (+ failures (invariants domain))))
    (when oracle (snapshot domain step))
    ; Split copies at several depths, then force differing constant/copy meets.
    (for [offset 4 size]
      (let [i (if reverse (- size (- offset 3)) offset)
            reference (cast i32 i)]
        (when (= (v/state-kind (v/at domain reference)) 68)
          (if (= (% i 3) 0)
              (let [source (cast i32 (+ 1 (% (+ i 1) 3)))
                    changed
                      (v/meet-copy! (mut domain) graph-uses reference source)]
                (when oracle (println "COPY {} {}" i source))
                (when (and changed
                           (= (v/state-kind (v/at domain reference)) 68))
                  (set! failures (+ failures 1))))
              (do
                (v/make-bottom! (mut domain) graph-uses reference)
                (when oracle (println "BOTTOM {}" i)))))
        (set! failures (+ failures (invariants domain)))
        (set! step (+ step 1))
        (when oracle (snapshot domain step))))
    (let [(mut last) -1
          (mut popped) (q/pop! (mut (.pending domain)))]
      (while (>= popped 0)
        (when (<= popped last) (set! failures (+ failures 1)))
        (when oracle (println "POP {}" popped))
        (set! last popped)
        (set! popped (q/pop! (mut (.pending domain)))))
      (when oracle (println "POP -1")))
    (v/release! (mut domain))
    (u/release! (mut graph-uses))
    failures))

(defn constants [(oracle bool)] (-> i64)
  (let [(mut graph-uses) (edges 12)
        (mut domain) (v/create 12 (malloc-allocator))
        (mut failures) 0
        (mut step) 0]
    (when oracle (println "CASE 12"))
    (for [i 1 4]
      (v/make-bottom! (mut domain) graph-uses (cast i32 i))
      (when oracle (println "BOTTOM {}" i)))
    ; NaNs compare by payload, not host floating equality; +/-0 differ.
    (for item [[(: 12 u64) (: 0x7ff8000000000042 u64)]
               [12 0x8000000000000000]
               [11 0xffffffffffffffff]
               [74 12345]]
      (let [opcode (cast u8 (get item 0))
            bits (cast u64 (get item 1))
            constant (n/constant opcode (if (= opcode 74) 6 opcode) 0 bits)
            reference (cast i32 (+ 4 step))]
        (when (not (v/meet-constant! (mut domain) graph-uses reference constant))
          (set! failures (+ failures 1)))
        (when oracle
          (println "CONST {} {} {} {}"
                   reference
                   opcode
                   (n/type-id constant)
                   bits))
        (when (v/meet-constant! (mut domain) graph-uses reference constant)
          (set! failures (+ failures 1)))
        (when oracle
          (println "CONST {} {} {} {}"
                   reference
                   opcode
                   (n/type-id constant)
                   bits))
        (set! step (+ step 1))
        (when oracle (snapshot domain step))))
    (v/meet-copy! (mut domain) graph-uses 4 1)
    (when oracle (println "COPY 4 1"))
    (v/meet-copy! (mut domain) graph-uses 8 4)
    (when oracle (println "COPY 8 4"))
    (v/meet-constant! (mut domain) graph-uses 4 (n/constant 12 12 0 0))
    (when oracle (println "CONST 4 12 12 0"))
    (v/meet-constant! (mut domain) graph-uses 5 (n/constant 12 12 0 0))
    (when oracle (println "CONST 5 12 12 0"))
    (for [i 0 2]
      (when (!= (v/meet-long! (mut domain)
                              graph-uses
                              9
                              -21
                              (n/make 78 37 16 0 0 0))
                (= i 0))
        (set! failures (+ failures 1)))
      (when oracle (println "LONG 9 -21 37")))
    (when (!= (v/identity domain 9) -21) (set! failures (+ failures 1)))
    (v/meet-long! (mut domain) graph-uses 9 -22 (n/make 78 37 16 0 0 0))
    (when oracle (println "LONG 9 -22 37"))
    (when (not (v/bottom? domain 9)) (set! failures (+ failures 1)))
    (v/add-input! (mut domain) 10)
    (when oracle (println "INPUT 10"))
    (q/remove! (mut (.pending domain)) 10)
    (when oracle (println "REMOVE 10"))
    (v/add-input! (mut domain) 10)
    (when oracle (println "INPUT 10"))
    (when (q/contains? (.pending domain) 10) (set! failures (+ failures 1)))
    (v/add-uses! (mut domain) graph-uses 8)
    (when oracle (println "USES 8"))
    (set! failures (+ failures (invariants domain)))
    (when oracle (snapshot domain 5))
    (v/release! (mut domain))
    (u/release! (mut graph-uses))
    failures))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [oracle (args/has? "--oracle")
        (mut failures)
          (+ (queue-checks) (constants oracle) (if (= (sizeof n/Node) 16) 0 1))]
    (for size [9 17 64 65 129 257]
      (for reverse [false true]
        (set! failures (+ failures (partitions size reverse oracle)))))
    (println "SCCP value checks: {} failures" failures)
    (if (= failures 0) 0 1)))
