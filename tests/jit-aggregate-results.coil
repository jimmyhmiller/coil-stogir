(defn score [(id i32) (seed u64)] (-> u64)
  (let [(mut i) (: 0 i32)
        (mut sum) (: 0 u64)]
    (while (< i (field-count id))
      (let [bits (+ seed (: 506 u64) (* (cast u64 i) (: 257 u64)))
            ty (memory-type id i)
            value
              (if (= ty 2) (& bits 255) (if (= ty 4) (& bits 0xFFFFFFFF) bits))]
        (set! sum (+ sum (* value (cast u64 (+ i 1))))))
      (set! i (+ i 1)))
    sum))

