                              (: 11 u64)))]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64))
             (* (cast u64 (.c value)) (: 3 u64)))))
    (15 (let [value
                (if (= mode 1)
                    (call-ptr (primitive/cast (fnptr (cc/C)
                                                     [u64 u64 u64 u64 u64 u64
                                                      u64 u64 u64 u64 u64 u64]
                                                     R15)
                                              address)
                              seed
                              (: 1 u64)
                              (: 2 u64)
                              (: 3 u64)
                              (: 4 u64)
                              (: 5 u64)
                              (: 6 u64)
                              (: 7 u64)
                              (: 8 u64)
                              (: 9 u64)
                              (: 10 u64)
                              (: 11 u64))
                    (call-ptr (primitive/cast (fnptr (cc/C)
                                                     [u64 u64 u64 u64 u64 u64
                                                      u64 u64 u64 u64 u64 u64
                                                      u64 u64]
                                                     R15)
                                              address)
                              (target id)
                              data
                              seed
                              (: 1 u64)
                              (: 2 u64)
                              (: 3 u64)
                              (: 4 u64)
                              (: 5 u64)
                              (: 6 u64)
                              (: 7 u64)
                              (: 8 u64)
                              (: 9 u64)
                              (: 10 u64)
                              (: 11 u64)))]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64)))))
    (_ 0)))

(defn exercise [(id i32) (mode i32) (dynamic? bool) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        ty (data-type id)
        payload (payload-size id)
        offset (if (= (.kind (result-spec id)) 2) (: 16 i64) (: 3 i64))
        f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64] u64) address)
        (mut bytes) (ArrayList::new [u8] allocator)
        (mut integers) (ArrayList::new [u64] allocator)
        (mut singles) (ArrayList::new [f32] allocator)
        (mut doubles) (ArrayList::new [f64] allocator)
        (mut i) (: 0 i64)
        (mut failures) 0]
    (while (< i (+ offset (cast i64 payload) 16))
      (push! (mut bytes) 165)
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i 40)
      (push! (mut integers) (cast u64 (+ i 11)))
      (push! (mut singles) (cast f32 (+ i 11)))
      (push! (mut doubles) (cast f64 (+ i 11)))
      (set! i (+ i 1)))
    (for pattern [(: 0 u64)
                  1
                  0x80000000
                  0x7F800000
                  0x7FC12345
                  0xFF800000
                  0x8000000000000000
                  0x7FF0000000000000
                  0x7FF8123456789ABC
                  0xFFF0000000000000
                  0xFFFFFFFFFFFFFFFF]
      (let [seed (- pattern (: 506 u64))
            data
              (if (= ty 5)
                  (primitive/cast u64 (.data integers))
                  (if (= ty 13)
                      (primitive/cast u64 (.data singles))
                      (primitive/cast u64 (.data doubles))))]
        (set! i 0)
        (while (< i (len bytes))
          (primitive/store! (primitive/index (.data bytes) i) (: 165 u8))
          (set! i (+ i 1)))
        (let [got
                (if (or (= mode 0) (= mode 3))
                    (call-ptr f
                              (target id)
                              (primitive/cast u64
                                              (primitive/index (.data bytes)
                                                               offset))
                              seed
                              data)
                    (incoming id mode address seed data))
              expected
                (+ (score id seed)
                   (if (or (= mode 0) (= mode 3))
                       (cast u64 (+ 321 (if dynamic? 321 0) 1220))
                       (: 0 u64)))]
          (when (!= got expected)
            (println "result id{} mode{} dynamic{} pattern{} got{} expected{}"
                     id
                     mode
                     dynamic?
                     pattern
                     got
                     expected)
            (set! failures (+ failures 1))))
        (when (or (= mode 0) (= mode 3))
          (set! i 0)
          (while (< i (len bytes))
            (when (and (or (< i offset) (>= i (+ offset (cast i64 payload))))
                       (!= (get bytes i) 165))
              (set! failures (+ failures 1)))
            (set! i (+ i 1))))))
    (free! (mut bytes))
    (free! (mut integers))
    (free! (mut singles))
    (free! (mut doubles))
    failures))

(defn fixture? [(id i32) (dynamic? bool) (alignment i32)] (-> bool)
  (and dynamic?
       (= alignment 4096)
       (or (= id 1) (= id 6) (= id 11) (= id 13) (= id 14) (= id 15))))

(defn callback-symbol [(id i32)] (-> (slice u8))
  (match id
    (1 "_stogir_result_callback_1")
    (6 "_stogir_result_callback_6")
    (11 "_stogir_result_callback_11")
    (13 "_stogir_result_callback_13")
    (14 "_stogir_result_callback_14")
    (15 "_stogir_result_callback_15")
    (_ "invalid")))

