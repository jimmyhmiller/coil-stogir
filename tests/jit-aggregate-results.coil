(defn field-count [(id i32)] (-> i32)
  (match id
    (0 1)
    (1 2)
    (2 1)
    (3 2)
    (4 1)
    (5 2)
    (6 3)
    (7 4)
    (8 1)
    (9 2)
    (10 3)
    (11 4)
    (12 3)
    (13 5)
    (14 3)
    (15 2)
    (_ 0)))

(defn data-type [(id i32)] (-> i32)
  (match id
    (0 5)
    (1 5)
    (2 5)
    (3 5)
    (4 13)
    (5 13)
    (6 13)
    (7 13)
    (8 12)
    (9 12)
    (10 12)
    (11 12)
    (12 5)
    (13 5)
    (14 5)
    (15 5)
    (_ 0)))

(defn payload-size [(id i32)] (-> i32)
  (match id
    (0 8)
    (1 16)
