(defstruct R14 [(a u8) (b u8) (c u8)])

(defstruct R15 [(a u64) (b u32)])

(defn callback0 :cc (cc/C) [(seed u64)
                            (p1 u64)
                            (p2 u64)
                            (p3 u64)
                            (p4 u64)
                            (p5 u64)
                            (p6 u64)
                            (p7 u64)
                            (p8 u64)
                            (p9 u64)
                            (p10 u64)
                            (p11 u64)] (-> R0)
  (let [bits
          (+ seed
             (* p1 (: 1 u64))
             (* p2 (: 2 u64))
             (* p3 (: 3 u64))
             (* p4 (: 4 u64))
             (* p5 (: 5 u64))
             (* p6 (: 6 u64))
             (* p7 (: 7 u64))
             (* p8 (: 8 u64))
             (* p9 (: 9 u64))
             (* p10 (: 10 u64))
             (* p11 (: 11 u64)))]
    (R0 :a (cast u64 (+ bits (: 0 u64))))))

(export-c [callback0 :as "stogir_result_callback_0"])

