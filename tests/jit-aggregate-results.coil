    (6 (match mode
         (0 "/tmp/coil-stogir-results-6-0.o")
         (1 "/tmp/coil-stogir-results-6-1.o")
         (2 "/tmp/coil-stogir-results-6-2.o")
         (3 "/tmp/coil-stogir-results-6-3.o")
         (4 "/tmp/coil-stogir-results-6-4.o")
         (_ "invalid")))
    (11 (match mode
          (0 "/tmp/coil-stogir-results-11-0.o")
          (1 "/tmp/coil-stogir-results-11-1.o")
          (2 "/tmp/coil-stogir-results-11-2.o")
          (3 "/tmp/coil-stogir-results-11-3.o")
