  (match id
    (1 (match mode
         (0 "_stogir_results_1_0")
         (1 "_stogir_results_1_1")
         (2 "_stogir_results_1_2")
         (3 "_stogir_results_1_3")
         (4 "_stogir_results_1_4")
         (_ "invalid")))
    (6 (match mode
         (0 "_stogir_results_6_0")
         (1 "_stogir_results_6_1")
         (2 "_stogir_results_6_2")
         (3 "_stogir_results_6_3")
         (4 "_stogir_results_6_4")
         (_ "invalid")))
    (11 (match mode
          (0 "_stogir_results_11_0")
          (1 "_stogir_results_11_1")
          (2 "_stogir_results_11_2")
          (3 "_stogir_results_11_3")
          (4 "_stogir_results_11_4")
          (_ "invalid")))
    (13 (match mode
          (0 "_stogir_results_13_0")
          (1 "_stogir_results_13_1")
          (2 "_stogir_results_13_2")
          (3 "_stogir_results_13_3")
          (4 "_stogir_results_13_4")
          (_ "invalid")))
    (14 (match mode
          (0 "_stogir_results_14_0")
          (1 "_stogir_results_14_1")
          (2 "_stogir_results_14_2")
          (3 "_stogir_results_14_3")
          (4 "_stogir_results_14_4")
          (_ "invalid")))
    (15 (match mode
          (0 "_stogir_results_15_0")
          (1 "_stogir_results_15_1")
          (2 "_stogir_results_15_2")
          (3 "_stogir_results_15_3")
          (4 "_stogir_results_15_4")
          (_ "invalid")))
    (_ "invalid")))

(defn fixture-path [(id i32) (mode i32)] (-> (slice u8))
  (match id
    (1 (match mode
         (0 "/tmp/coil-stogir-results-1-0.o")
         (1 "/tmp/coil-stogir-results-1-1.o")
         (2 "/tmp/coil-stogir-results-1-2.o")
         (3 "/tmp/coil-stogir-results-1-3.o")
