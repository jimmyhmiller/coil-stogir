(defn bits-f32 [(bits u32)] (-> f32)
  (let [p (primitive/alloc-stack u32)]
    (primitive/store! p bits)
    (primitive/load (primitive/cast (ptr f32) p))))

(defn f32-bits [(value f32)] (-> u32)
  (let [p (primitive/alloc-stack f32)]
    (primitive/store! p value)
    (primitive/load (primitive/cast (ptr u32) p))))

(defn bits-f64 [(bits u64)] (-> f64)
  (let [p (primitive/alloc-stack u64)]
    (primitive/store! p bits)
    (primitive/load (primitive/cast (ptr f64) p))))

(defn f64-bits [(value f64)] (-> u64)
  (let [p (primitive/alloc-stack f64)]
    (primitive/store! p value)
    (primitive/load (primitive/cast (ptr u64) p))))

(defstruct R0 [(a u64)])

(defstruct R1 [(a u64) (b u64)])

(defstruct R2 [(a i64)])

(defstruct R3 [(a i64) (b i64)])

(defstruct R4 [(a f32)])

