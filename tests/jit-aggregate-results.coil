          (1 "/tmp/coil-stogir-results-13-1.o")
          (2 "/tmp/coil-stogir-results-13-2.o")
          (3 "/tmp/coil-stogir-results-13-3.o")
          (4 "/tmp/coil-stogir-results-13-4.o")
          (_ "invalid")))
    (14 (match mode
          (0 "/tmp/coil-stogir-results-14-0.o")
          (1 "/tmp/coil-stogir-results-14-1.o")
          (2 "/tmp/coil-stogir-results-14-2.o")
          (3 "/tmp/coil-stogir-results-14-3.o")
          (4 "/tmp/coil-stogir-results-14-4.o")
          (_ "invalid")))
    (15 (match mode
          (0 "/tmp/coil-stogir-results-15-0.o")
