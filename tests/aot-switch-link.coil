(module stogir.tests.aot-switch-link)
(import "coil.cc" :as cc)

(extern unsigned-switch :as "stogir_switch_u64" :cc (cc/C) [u64 u64] (-> u64))

(extern signed-switch :as "stogir_switch_i64" :cc (cc/C) [u64 u64] (-> u64))

(extern loop-i64 :as "stogir_switch_loop_i64" :cc (cc/C) [i64] (-> i64))

(extern loop-f64 :as "stogir_switch_loop_f64" :cc (cc/C) [i64] (-> f64))

(defn loop-expected [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut sum) 0]
    (while (< i n)
      (set! sum (+ sum (match (% i 5) (0 i) (1 (* i 2)) (4 1) (_ (- 0 i)))))
      (set! i (+ i 1)))
    sum))

(defn expected [(key u64)] (-> u64)
  (if (= key 0)
      100
      (if (and (>= key 2) (<= key 4))
          200
          (if (= key 9)
              300
              (if (and (>= key 0x7FFFFFFFFFFFFFFF) (<= key 0x8000000000000000))
                  400
                  (if (= key 0xFFFFFFFFFFFFFFFC)
                      500
                      (if (= key 0xFFFFFFFFFFFFFFFF) 600 700)))))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for key [(: 0 u64)
              1
              2
              3
              4
              5
              8
              9
              10
              0x7FFFFFFFFFFFFFFE
              0x7FFFFFFFFFFFFFFF
              0x8000000000000000
              0x8000000000000001
              0xFFFFFFFFFFFFFFFB
              0xFFFFFFFFFFFFFFFC
              0xFFFFFFFFFFFFFFFD
              0xFFFFFFFFFFFFFFFE
              0xFFFFFFFFFFFFFFFF]
      (let [want (+ 17 (expected key))]
        (when (!= (unsigned-switch key 17) want) (set! failures (+ failures 1)))
        (when (!= (signed-switch (^ key 0x8000000000000000) 17) want)
          (set! failures (+ failures 1)))))
    (for n [(: -1 i64) 0 1 2 4 5 31 100]
      (when (!= (loop-i64 n) (loop-expected n)) (set! failures (+ failures 1)))
      (when (!= (loop-f64 n) (cast f64 (loop-expected n)))
        (set! failures (+ failures 1))))
    (println "linked signed/unsigned switch dispatch: {} failures" failures)
    (if (= failures 0) 0 1)))
