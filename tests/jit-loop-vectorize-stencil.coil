               :header (cast u32 (get row 2))
               :op1 (cast i32 (get row 3))
               :op2 (cast i32 (get row 4))
               :op3 (cast i32 (get row 5))))
      (push! (mut (.constant-spans graph)) (cast i32 (get row 1))))
    (for row [[(: 0 i64) 0 5 0]]
      (push! (mut (.entries (.strings graph)))
             (strings/Entry
               :offset (get row 1)
               :length (get row 2)
               :next (cast i32 (get row 3)))))
    (for row [[(: 0 i64) 9]
              [(: 1 i64) 5]
              [(: 2 i64) 2]
              [(: 3 i64) 5]
              [(: 4 i64) 4]]
      (push! (mut (.bytes (.strings graph))) (cast u8 (get row 1))))
    (set! (.function-prototype graph) 1)
    graph))

(import "stogir.loop-vectorize" :as vectorize)
(import "stogir.native.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "stogir.options" :as options)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

;;; Captured semantic graph from the frozen Coil stencil. Interner caches are
;;; rebuilt as needed. This fixture is not used by the vectorizer's recognition.
(defn transformed [(source g/Graph) (roots (slice i32)) (header i32)]
  (-> g/Graph)
  (match (vectorize/vectorize source 1 roots header 2 (malloc-allocator))
    (Err [message] (panic "{}" message))
    (Ok [option]
        (match option (None [] (panic "captured loop rejected")) (Some [r] r)))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut source) (read-graph)
        roots
          [(: 176 i32)
           2
           5
           7
           8
           9
           10
           11
           14
           16
           17
           20
           22
           23
           24
           25
           26
           27
           28
           29
           32
           34
           35
           36
           37
           3
           12
           18
           30]
        (mut failures) 0]
    (for mode [(: 0 i32) 1 2 3 4]
      (let [(mut first) (transformed source roots (if (= mode 0) 38 45))
            (mut graph)
              (if (>= mode 3)
                  (match (vectorize/optimize source 1 roots 2 a)
                    (Err [message] (panic "{}" message))
                    (Ok [candidate]
                        (match candidate
                          (None [] (panic "automatic vectorization rejected"))
                          (Some [r] r))))
                  (if (= mode 2)
                      (transformed first roots 38)
                      (g/duplicate first a)))
            (mut code)
              (match (if (= mode 4)
                         (compile/image-with-options source
                                                     1
                                                     roots
                                                     "_captured_vector_stencil"
                                                     (options/Options :level 3)
                                                     a)
                         (compile/image graph
                                        1
                                        roots
                                        "_captured_vector_stencil"
                                        a))
                (Err [message] (panic "{}" message))
                (Ok [r] r))]
        (g/release! (mut graph))
        (g/release! (mut first))
        (match (jit/map-image code a)
          (Err [message] (panic "{}" message))
          (Ok [loaded]
              (let [(mut loaded) loaded
                    function
                      (p/cast (fnptr (cc/C) [u64 u32] u64)
                              (.base (.memory loaded)))]
                ; Expected weighted checksums independently checked with LLVM O3.
                (for row [[(: 1 u64) 0 288158667297079296]
                          [(: 1 u64) 12345 288158666221502464]
                          [(: 1 u64) 4294967295 288337268841529344]
                          [(: 2 u64) 0 288177476221665280]
                          [(: 2 u64) 12345 288177471516180480]
                          [(: 2 u64) 4294967295 288318458306232320]
                          [(: 17 u64) 0 432011969822720]
                          [(: 17 u64) 12345 289068118255337472]
                          [(: 17 u64) 4294967295 764329695641600]
                          [(: 257 u64) 0 8464532821245952]
                          [(: 257 u64) 12345 287419099913388032]
                          [(: 257 u64) 4294967295 9621338239008768]]
                  (when (!= (function (get row 0) (cast u32 (get row 1)))
                            (get row 2))
                    (set! failures (+ failures 1))))
                (jit/release-image! (mut loaded)))))
        (image/release! (mut code))))
    (g/release! (mut source))
    (println "captured stencil vectorization checks: {} failures" failures)
    (if (= failures 0) 0 1)))
