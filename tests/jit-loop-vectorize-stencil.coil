                :header (cast u32 (get row 2))
                :op1 (cast i32 (get row 3))
                :op2 (cast i32 (get row 4))
                :op3 (cast i32 (get row 5)))]
        (if (= (get row 0) 0)
            (do
              (set! (mut (.instructions graph)) 0 cell)
              (set! (mut (.arities graph)) 0 (cast i32 (get row 1))))
            (do
              (push! (mut (.instructions graph)) cell)
              (push! (mut (.arities graph)) (cast i32 (get row 1)))))))
    (for row [[(: 0 i64) 1 257 0 0 0]
              [(: 1 i64) 1 1285 0 0 0]
              [(: 2 i64) 1 1285 0 65536 0]
              [(: 3 i64) 1 1285 0 16384 0]
              [(: 4 i64) 1 1285 0 -1640531535 0]
