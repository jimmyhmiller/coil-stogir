(module stogir.tests.aot-optimization-modes-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)

(extern payload :as "mode_payload" :cc (cc/C) [(ptr u8)] (-> void))

(extern calculate :as "mode" :cc (cc/C) [i64 i64] (-> i64))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for x [-100 -7 0 3 29]
      (for y [-99 -1 0 17 53]
        (when (!= (calculate x y) (* 2 (+ x y)))
          (set! failures (+ failures 1)))))
    (let [(mut buffer)
            [(: 0xA5 u8)
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5]]
      (payload (p/index (p/cast (ptr u8) (mut buffer)) 8))
      (for [i 0 32]
        (let [expected (if (and (>= i 8) (< i 24)) (cast u8 (- i 7)) 0xA5)]
          (when (!= (get buffer i) expected) (set! failures (+ failures 1))))))
    (println "public optimization-mode AOT checks: {} failures" failures)
    (if (= failures 0) 0 1)))
