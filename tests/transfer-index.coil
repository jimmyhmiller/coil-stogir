(module stogir.tests.transfer-index)
(import "stogir.transfer-index" :as index)
(import "stogir.locations" :as loc)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Ok Err])

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut copies) (ArrayList::new [loc/Transfer] allocator)
        (mut parent) (: 1 i32)
        (mut failures) 0]
    (for position [(: 3 i64) 0 3 2 0]
      (push! (mut copies)
             (loc/Transfer
               :position position
               :parent parent
               :source (loc/Location :kind 0 :value (cast i64 parent))
               :destination
                 (loc/Location :kind 1 :value (* (cast i64 parent) 8))))
      (set! parent (+ parent 1)))
    (match (index/build (slice copies) 4 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [built]
          (let [(mut owned) built]
            ;; Stable source-list indices for positions 0,1,2,3.
            (when (or (!= (get (.heads owned) 0) 1)
                      (!= (get (.heads owned) 1) -1)
                      (!= (get (.heads owned) 2) 3)
                      (!= (get (.heads owned) 3) 0)
                      (!= (get (.next owned) 0) 2)
                      (!= (get (.next owned) 1) 4)
                      (!= (get (.next owned) 2) -1)
                      (!= (get (.next owned) 3) -1)
                      (!= (get (.next owned) 4) -1))
              (set! failures (+ failures 1)))
            (index/release! (mut owned)))))
    (match (index/build (slice copies) 3 allocator)
      (Ok [built]
          (let [(mut owned) built]
            (index/release! (mut owned))
            (set! failures (+ failures 1))))
      (Err [_] 0))
    (match (index/build [] 0 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [built]
          (let [(mut owned) built]
            (when (or (!= (len (.heads owned)) 0) (!= (len (.next owned)) 0))
              (set! failures (+ failures 1)))
            (index/release! (mut owned)))))
    (match (index/build [] -1 allocator)
      (Ok [built]
          (let [(mut owned) built]
            (index/release! (mut owned))
            (set! failures (+ failures 1))))
      (Err [_] 0))
    (let [copy (elem (mut copies) 0)] (set! (.position copy) -1))
    (match (index/build (slice copies) 4 allocator)
      (Ok [built]
          (let [(mut owned) built]
            (index/release! (mut owned))
            (set! failures (+ failures 1))))
      (Err [_] 0))
    (free! (mut copies))
    (println "transfer index checks: {} failures" failures)
    (if (= failures 0) 0 1)))
