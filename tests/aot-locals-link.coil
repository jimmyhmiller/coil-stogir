(module stogir.tests.aot-locals-link)
(import "coil.cc" :as cc)

(extern local-bool :as "stogir_local_bool" :cc (cc/C) [u64] (-> u64))

(extern local-i64 :as "stogir_local_i64" :cc (cc/C) [u64] (-> u64))

(extern local-f64 :as "stogir_local_f64" :cc (cc/C) [u64] (-> u64))

(extern local-f32 :as "stogir_local_f32" :cc (cc/C) [u64] (-> u64))

(extern large :as "stogir_local_large" :cc (cc/C) [] (-> u64))

(extern loop-i64 :as "stogir_local_loop_i64" :cc (cc/C) [i64] (-> i64))

(extern loop-f64 :as "stogir_local_loop_f64" :cc (cc/C) [i64] (-> f64))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for bits [(: 0 u64)
               1
               0xFFE123456789ABCD
               0x8000000000000000
               0xFFFFFFFFFFFFFFFF]
      (when (!= (local-bool bits) (if (= (& bits 255) 0) (: 0 u64) 1))
        (set! failures (+ failures 1)))
      (when (!= (local-i64 bits) bits) (set! failures (+ failures 1)))
      (when (!= (local-f64 bits) bits) (set! failures (+ failures 1)))
      (when (!= (local-f32 bits) (& bits 0xFFFFFFFF))
        (set! failures (+ failures 1))))
    (when (!= (large) 1101) (set! failures (+ failures 1)))
    (for n [(: -1 i64) 0 1 2 31 100]
      (let [expected (if (< n 0) 0 (/ (* n (- n 1)) 2))]
        (when (!= (loop-i64 n) expected) (set! failures (+ failures 1)))
        (when (!= (loop-f64 n) (cast f64 expected))
          (set! failures (+ failures 1)))))
    (println "linked scalar locals: {} failures" failures)
    (if (= failures 0) 0 1)))
