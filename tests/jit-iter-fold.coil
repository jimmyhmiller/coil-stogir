(module stogir.tests.jit-iter-fold)
(import "stogir.graph" :as g)
(import "stogir.symbols" :as symbols)
(import "stogir.iter-constant-cse" :as literal-cse)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.conversion" :as conversion)
(import "stogir.fold" :as scalar)
(import "stogir.sccp" :as sccp)
(import "stogir.sccp-analysis" :as analysis)
(import "stogir.sccp-values" :as values)
(import "stogir.sccp-fold" :as fold-bridge)
(import "coil.arraylist" :use [ArrayList])
(import "stogir.iter-fold" :as iter)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "stogir.a64.compile" :as compile)
(import "stogir.aot.macho" :as macho)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.fs" :as fs)

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

;;; Rebuilt exact-position edge multisets must match the maintained lists.
(defn check-uses [(graph g/Graph) (actual uses/Uses)] (-> i64)
  (let [(mut expected) (uses/build graph (malloc-allocator))
        (mut failures) 0]
    (for [r 1 (len (.instructions graph))]
      (let [want (get (.ranges expected) r)
            got (get (.ranges actual) r)]
        (when (!= (.count want) (.count got)) (set! failures (+ failures 1)))
        (for [i (.offset want) (+ (.offset want) (.count want))]
          (let [edge (get (.edges expected) i)
                (mut count) 0]
            (for [j (.offset got) (+ (.offset got) (.count got))]
              (let [other (get (.edges actual) j)]
                (when (and (= (.user edge) (.user other))
                           (= (.operand edge) (.operand other)))
                  (set! count (+ count 1)))))
            (when (!= count 1) (set! failures (+ failures 1)))))))
    (uses/release! (mut expected))
    failures))

(defn constant-cse-execute [(graph g/Graph) (roots (slice i32))] (-> void)
  (let [a (malloc-allocator)]
    (match (compile/image graph 1 roots "_constant_cse" a)
      (Err [message] (panic "{}" message))
      (Ok [code]
          (let [(mut code) code]
            (match (jit/map-image code a)
              (Err [message] (panic "{}" message))
              (Ok [loaded]
                  (let [(mut loaded) loaded
                        f
                          (p/cast (fnptr (cc/C) [u64] i64)
                                  (.base (.memory loaded)))]
                    (for [i 0 8] (assert (= (f (cast u64 i)) (+ 130 (* i 2)))))
                    (jit/release-image! (mut loaded)))))
            (image/release! (mut code)))))))

;;; Raw cloning can duplicate constant-only casts after construction CSE.
;;; The same symbol, type and full node words must converge without collapsing
;;; different symbols or seeding unrelated keys.
(defn constant-cse-case [(observed i32) (seed i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        text (require (symbols/string! (mut graph) "ABCDEFGH"))
        other (require (symbols/string! (mut graph) "IJKLMNOP"))
        first (require (b/emit! (mut graph) 36 5 [text]))
        second (require (b/emit! (mut graph) 36 5 [text]))
        distinct (require (b/emit! (mut graph) 36 5 [other]))
        address1 (require (b/emit! (mut graph) 26 5 [first input]))
        address2 (require (b/emit! (mut graph) 26 5 [second input]))
        pointer1 (require (b/emit! (mut graph) 36 6 [address1]))
        pointer2 (require (b/emit! (mut graph) 36 6 [address2]))
        load1 (require (b/emit! (mut graph) 91 2 [start pointer1]))
        load2 (require (b/emit! (mut graph) 91 2 [load1 pointer2]))
        wide1 (require (b/emit! (mut graph) 34 11 [load1]))
        wide2 (require (b/emit! (mut graph) 34 11 [load2]))
        sum (require (b/emit! (mut graph) 26 11 [wide1 wide2]))
        ret (require (b/emit! (mut graph) 120 11 [load2 sum (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)
        (mut lists) (uses/build graph a)
        (mut queue) (q/create (len (.instructions graph)) a)
        (mut protected) (bits/create (len (.instructions graph)) a)]
    (push! (mut roots) ret)
    (push! (mut roots) distinct)
    (when (or (= observed 1) (= observed 3)) (push! (mut roots) first))
    (when (or (= observed 2) (= observed 3)) (push! (mut roots) second))
    (for root roots (bits/add! (mut protected) (cast i64 root)))
    (constant-cse-execute graph (slice roots))
    (q/add! (mut queue)
            (cast i64 (if (= seed 0) first (if (= seed 1) second distinct))))
    (require (iter/run! (mut graph) (mut lists) (mut queue) protected 8 a))
    (when (= seed 2)
      (assert (= (n/opcode (get (.instructions graph) (cast i64 second))) 36))
      (q/add! (mut queue) (cast i64 second))
      (require (iter/run! (mut graph) (mut lists) (mut queue) protected 8 a)))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 second)))
               (if (or (= observed 2) (= observed 3)) 68 0)))
    (if (= (n/opcode (get (.instructions graph) (cast i64 load2))) 91)
        (assert (= (.op2 (get (.instructions graph) (cast i64 load1)))
                   (.op2 (get (.instructions graph) (cast i64 load2)))))
        (assert (= (n/opcode (get (.instructions graph) (cast i64 load2))) 0)))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 distinct))) 36))
    (assert (= (check-uses graph lists) 0))
    (require (rewrite/validate graph 8 a))
    (constant-cse-execute graph (slice roots))
    (q/add! (mut queue) (cast i64 first))
    (assert (= (require (iter/run! (mut graph)
                                   (mut lists)
                                   (mut queue)
                                   protected
                                   8
                                   a))
               0))
    (bits/release! (mut protected))
    (q/release! (mut queue))
    (uses/release! (mut lists))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; Canonical entries must be revalidated after rewrites; a newly constant
;;; earlier node replaces a later cached canonical and wakes that later node.
(defn constant-cse-invalidation [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        x (require (symbols/string! (mut graph) "X"))
        y (require (symbols/string! (mut graph) "Y"))
        first (require (b/emit! (mut graph) 36 5 [x]))
        middle (require (b/emit! (mut graph) 36 5 [y]))
        last (require (b/emit! (mut graph) 36 5 [x]))
        frame (require (b/emit! (mut graph) 66 6 []))
        (mut index) (literal-cse/create a)
        (mut queue) (q/create (len (.instructions graph)) a)]
    (assert (= (literal-cse/find! (mut index) graph (mut queue) frame) 0))
    (assert (not (.ready index)))
    (assert (= (literal-cse/find! (mut index) graph (mut queue) last) first))
    (assert (g/rewrite-inputs-with-aux! (mut graph) first 36 5 0 [y]))
    (assert (= (literal-cse/find! (mut index) graph (mut queue) last) 0))
    (while (>= (q/pop! (mut queue)) 0) 0)
    (assert (g/rewrite-inputs-with-aux! (mut graph) middle 36 5 0 [x]))
    (assert (= (literal-cse/find! (mut index) graph (mut queue) middle) 0))
    (assert (q/contains? queue (cast i64 last)))
    (assert (= (literal-cse/find! (mut index) graph (mut queue) last) middle))
    (assert (g/make-nop! (mut graph) middle))
    (assert (= (literal-cse/find! (mut index) graph (mut queue) last) 0))
    (literal-cse/release! (mut index))
    (q/release! (mut queue))
    (g/release! (mut graph))))

(defn boolean-compare-execute [(graph g/Graph)
                               (roots (slice i32))
                               (opcode i32)
                               (constant u64)] (-> void)
  (match (compile/text graph 1 roots (malloc-allocator))
    (Err [message] (panic "{}" message))
    (Ok [text]
        (let [(mut text) text]
          (match (jit/map-text (slice text))
            (Err [message] (panic "{}" message))
            (Ok [loaded]
                (let [(mut loaded) loaded
                      f (p/cast (fnptr (cc/C) [i64] i64) (.base loaded))]
                  (for input [0 1 2 128 255 256 -1]
                    (let [truth (if (!= (& input 255) 0) (: 1 u64) 0)
                          expected
                            (if (= opcode 14)
                                (= truth constant)
                                (!= truth constant))]
                      (assert (= (f input) (if expected 1 0)))))
                  (jit/release! (mut loaded)))))
          (free! (mut text))))))

(defn boolean-compare-case [(opcode i32)
                            (constant u64)
                            (mode i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        boolean (require (b/conversion! (mut graph) 35 1 8 input))
        extended
          (if (= mode 0)
              boolean
              (require (b/emit! (mut graph)
                                (if (= mode 1) 33 34)
                                11
                                [boolean])))
        literal
          (require (b/scalar-constant! (mut graph)
                                       (if (= mode 0) 1 11)
                                       constant
                                       8))
        comparison (require (b/emit! (mut graph) opcode 1 [extended literal]))
        result (require (b/emit! (mut graph) 34 11 [comparison]))
        ret (require (b/emit! (mut graph) 120 11 [start result (: 0 i32)]))
        shared
          (if (= mode 3)
              (require (b/emit! (mut graph) 68 11 [extended (: 0 i32)]))
              0)
        (mut roots) (ArrayList::new [i32] a)
        (mut lists) (uses/build graph a)
        (mut queue) (q/create (len (.instructions graph)) a)
        (mut protected) (bits/create (len (.instructions graph)) a)]
    (push! (mut roots) ret)
    (when (= mode 3) (push! (mut roots) shared))
    (when (= mode 4) (push! (mut roots) extended))
    (when (= mode 5) (push! (mut roots) comparison))
    (for root roots (bits/add! (mut protected) (cast i64 root)))
    (boolean-compare-execute graph (slice roots) opcode constant)
    (q/add! (mut queue) (cast i64 comparison))
    (require (iter/run! (mut graph) (mut lists) (mut queue) protected 8 a))
    (assert (= (check-uses graph lists) 0))
    (require (rewrite/validate graph 8 a))
    (if (and (<= constant 1) (!= mode 3) (!= mode 4))
        (assert (!= (n/opcode (get (.instructions graph)
                                   (cast i64 comparison)))
                    (cast u8 opcode)))
        (assert (= (n/opcode (get (.instructions graph)
                                  (cast i64 comparison)))
                   (cast u8 opcode))))
    (boolean-compare-execute graph (slice roots) opcode constant)
    (q/add! (mut queue) (cast i64 comparison))
    (assert (= (require (iter/run! (mut graph)
                                   (mut lists)
                                   (mut queue)
                                   protected
                                   8
                                   a))
               0))
    (assert (= (check-uses graph lists) 0))
    (bits/release! (mut protected))
    (q/release! (mut queue))
    (uses/release! (mut lists))
    (free! (mut roots))
    (g/release! (mut graph))))

(defn masked-execute [(before g/Graph)
                      (after g/Graph)
                      (before-roots (slice i32))
                      (after-roots (slice i32))] (-> void)
  (let [(mut first-text)
          (match (compile/text before 1 before-roots (malloc-allocator))
            (Err [message] (panic "{}" message))
            (Ok [text] text))
        (mut second-text)
          (match (compile/text after 1 after-roots (malloc-allocator))
            (Err [message] (panic "{}" message))
            (Ok [text] text))]
    (match (jit/map-text (slice first-text))
      (Err [message] (panic "{}" message))
      (Ok [first]
          (let [(mut first) first]
            (match (jit/map-text (slice second-text))
              (Err [message] (panic "{}" message))
              (Ok [second]
                  (let [(mut second) second
                        f (p/cast (fnptr (cc/C) [u64] i64) (.base first))
                        g (p/cast (fnptr (cc/C) [u64] i64) (.base second))]
                    (for [input 0 256]
                      (assert (= (f (cast u64 input)) (g (cast u64 input)))))
                    (for input [(: 0x10000 u64)
                                0x7FFFFFFF
                                0x80000000
                                0xFFFFFFFF
                                0x100000000
                                0x7FFFFFFFFFFFFFFF
                                0x7FF8000000000000
                                0x7FF0000000000001
                                0x8000000000000000
                                0xFFFFFFFFFFFFFFFF
                                0x5555555555555555
                                0xAAAAAAAAAAAAAAAA]
                      (assert (= (f input) (g input))))
                    (jit/release! (mut second)))))
            (jit/release! (mut first)))))
    (free! (mut first-text))
    (free! (mut second-text))))

;;; Integer comparison inversion and Boolean choice restarts must preserve
;;; native answers, exact use edges, shared values and explicit observations.
(defn boolean-restart-case [(ty i32) (opcode i32) (shape i32) (observed i32)]
  (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        operand
          (if (= ty 5)
              input
              (require (b/emit! (mut graph)
                                (if (= (types/scalar-size ty 8) 8) 36 35)
                                ty
                                [input])))
        literal (require (b/scalar-constant! (mut graph) ty 0 8))
        comparison (require (b/emit! (mut graph) opcode 1 [operand literal]))
        choice-type (if (>= shape 3) ty (: 1 i32))
        result-type (if (>= shape 4) (: 1 i32) choice-type)
        zero (require (b/scalar-constant! (mut graph) choice-type 0 8))
        one (require (b/scalar-constant! (mut graph) choice-type 1 8))
        selection
          (if (= shape 0)
              (require (b/emit! (mut graph) 45 1 [comparison]))
              (require (b/emit! (mut graph)
                                60
                                choice-type
                                [comparison
                                 (if (or (= shape 2) (= shape 5)) zero one)
                                 (if (or (= shape 2) (= shape 5)) one zero)])))
        target
          (if (>= shape 4)
              (require (b/emit! (mut graph) 15 1 [selection zero]))
              selection)
        result
          (if (= result-type 11)
              target
              (require (b/emit! (mut graph)
                                (if (= (types/scalar-size result-type 8) 8)
                                    36
                                    34)
                                11
                                [target])))
        ret (require (b/emit! (mut graph) 120 11 [start result (: 0 i32)]))
        shared
          (if (= observed 3)
              (require (b/emit! (mut graph) 68 1 [comparison (: 0 i32)]))
              0)
        (mut roots) (ArrayList::new [i32] a)
        (mut lists) (uses/build graph a)
        (mut queue) (q/create (len (.instructions graph)) a)
        (mut protected) (bits/create (len (.instructions graph)) a)
        (mut original) (g/duplicate graph a)]
    (push! (mut roots) ret)
    (when (= observed 1) (push! (mut roots) comparison))
    (when (= observed 2) (push! (mut roots) target))
    (when (= observed 3) (push! (mut roots) shared))
    (when (= observed 4) (push! (mut roots) selection))
    (for root roots (bits/add! (mut protected) (cast i64 root)))
    (q/add! (mut queue) (cast i64 target))
    (require (iter/run! (mut graph) (mut lists) (mut queue) protected 8 a))
    (assert (= (check-uses graph lists) 0))
    (require (rewrite/validate graph 8 a))
    (when (and (>= shape 4) (!= observed 4))
      (assert (= (n/opcode (get (.instructions graph) (cast i64 selection))) 0)))
    (let [after (get (.instructions graph) (cast i64 target))]
      (if (and (= shape 0) (types/floating? ty))
          (assert (= (n/opcode after) 45))
          (if (= shape 0)
              (assert (= (n/opcode after) (cast u8 (^ opcode 1))))
              (assert (!= (n/opcode after) 60)))))
    (masked-execute original graph (slice roots) (slice roots))
    (q/add! (mut queue) (cast i64 target))
    (assert (= (require (iter/run! (mut graph)
                                   (mut lists)
                                   (mut queue)
                                   protected
                                   8
                                   a))
               0))
    (bits/release! (mut protected))
    (q/release! (mut queue))
    (uses/release! (mut lists))
    (free! (mut roots))
    (g/release! (mut original))
    (g/release! (mut graph))))

(defn bit-choice-case [(ty i32)
                       (result-type i32)
                       (mask u64)
                       (opcode i32)
                       (compare-bit bool)
                       (shape i32)
                       (observed i32)
                       (converted bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        narrowed
          (if (= ty 5)
              input
              (require (b/emit! (mut graph)
                                (if (= (types/scalar-size ty 8) 8) 36 35)
                                ty
                                [input])))
        literal (require (b/scalar-constant! (mut graph) ty mask 8))
        masked
          (require (b/emit! (mut graph)
                            47
                            ty
                            (if (= (& observed 1) 1)
                                [literal narrowed]
                                [narrowed literal])))
        value
          (if converted (require (b/emit! (mut graph) 34 5 [masked])) masked)
        comparison-type (if converted (: 5 i32) ty)
        limit
          (require (b/scalar-constant! (mut graph)
                                       comparison-type
                                       (if compare-bit mask 0)
                                       8))
        condition (require (b/emit! (mut graph) opcode 1 [value limit]))
        yes
          (require (b/scalar-constant! (mut graph)
                                       result-type
                                       (masked-bits result-type mask)
                                       8))
        zero (require (b/scalar-constant! (mut graph) result-type 0 8))
        target
          (if (>= shape 2)
              (require (b/emit! (mut graph)
                                (if (= (types/scalar-size result-type 8) 1)
                                    36
                                    (if (= shape 3) 33 34))
                                result-type
                                [condition]))
              (require (b/emit! (mut graph)
                                60
                                result-type
                                [condition
                                 (if (= shape 1) zero yes)
                                 (if (= shape 1) yes zero)])))
        result
          (if (= result-type 11)
              target
              (require (b/emit! (mut graph)
                                (if (= (types/scalar-size result-type 8) 8)
                                    36
                                    34)
                                11
                                [target])))
        ret (require (b/emit! (mut graph) 120 11 [start result (: 0 i32)]))
        (mut original) (g/duplicate graph a)
        (mut roots) (ArrayList::new [i32] a)
        (mut lists) (uses/build graph a)
        (mut queue) (q/create (len (.instructions graph)) a)
        (mut protected) (bits/create (len (.instructions graph)) a)
        positive (= (= opcode 15) (not compare-bit))
        expected
          (and (!= mask 0)
               (= (& mask (- mask 1)) 0)
               (= (masked-bits result-type mask) mask)
               (if (>= shape 2)
                   (and positive (= mask 1))
                   (= positive (= shape 0))))]
    (push! (mut roots) ret)
    (when (= observed 1) (push! (mut roots) value))
    (when (= observed 2) (push! (mut roots) condition))
    (when (= observed 3) (push! (mut roots) target))
    (for root roots (bits/add! (mut protected) (cast i64 root)))
    (assert (= (iter/bit-choice! (mut graph)
                                 (mut lists)
                                 (mut queue)
                                 protected
                                 target
                                 8)
               expected))
    (assert (= (check-uses graph lists) 0))
    (require (rewrite/validate graph 8 a))
    (masked-execute original graph (slice roots) (slice roots))
    (require (iter/run! (mut graph) (mut lists) (mut queue) protected 8 a))
    (assert (= (check-uses graph lists) 0))
    (require (rewrite/validate graph 8 a))
    (masked-execute original graph (slice roots) (slice roots))
    (bits/release! (mut protected))
    (q/release! (mut queue))
    (uses/release! (mut lists))
    (free! (mut roots))
    (g/release! (mut original))
    (g/release! (mut graph))))

(defn check-current-view [(graph g/Graph)] (-> void)
  (let [a (malloc-allocator)
        (mut domain) (values/create (len (.instructions graph)) a)]
    (for [i 1 (len (.instructions graph))]
      (values/kind! (mut domain) (cast i32 i) 131))
    (for [i 1 (len (.instructions graph))]
      (let [opcode (n/opcode (get (.instructions graph) i))]
        (when (iter/foldable? (cast i32 opcode))
          (for pointer-bytes [(: 4 i32) 8]
            (match (fold-bridge/evaluate graph
                                         domain
                                         (cast i32 i)
                                         pointer-bytes)
              (Err [message]
                   (match (fold-bridge/evaluate-current graph
                                                        (cast i32 i)
                                                        pointer-bytes)
                     (Err [current] (assert (= current message)))
                     (Ok [_] (panic "current view accepted lattice error"))))
              (Ok [decision]
                  (match (fold-bridge/evaluate-current graph
                                                       (cast i32 i)
                                                       pointer-bytes)
                    (Err [message] (panic "current view: {}" message))
                    (Ok [current]
                        (assert (= (.kind current) (.kind decision)))
                        (assert (= (.source current) (.source decision)))
                        (assert (= (.header (.constant current))
                                   (.header (.constant decision))))
                        (assert (= (.op1 (.constant current))
                                   (.op1 (.constant decision))))
                        (assert (= (.op2 (.constant current))
                                   (.op2 (.constant decision))))
                        (assert (= (.op3 (.constant current))
                                   (.op3 (.constant decision))))))))))))
    (values/release! (mut domain))))

;;; Compare raw native AND/conversion/CMP instructions against the optimized
;;; graph. Byte inputs are exhaustive, with wider sign/truncation boundaries.
(defn masked-bits [(ty i32) (bits u64)] (-> u64)
  (& bits
     (cast u64
           (- (<< (: 1 u128)
                  (cast u128 (* 8 (types/scalar-size ty 8))))
              1))))

(defn masked-case [(ty i32)
                   (opcode i32)
                   (mask u64)
                   (limit u64)
                   (mode i32)
                   (commuted bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        width (types/scalar-size ty 8)
        narrowed
          (if (< width 8)
              (require (b/emit! (mut graph) 35 ty [input]))
              (if (= ty 5)
                  input
                  (require (b/emit! (mut graph) 36 ty [input]))))
        and-type (if (or (= mode 2) (= mode 3)) (: 5 i32) ty)
        operand (if (or (= mode 2) (= mode 3)) input narrowed)
        literal
          (require (b/scalar-constant! (mut graph)
                                       and-type
                                       (masked-bits and-type mask)
                                       8))
        masked
          (if (>= mode 4)
              narrowed
              (require (b/emit! (mut graph)
                                47
                                and-type
                                (if commuted
                                    [literal operand]
                                    [operand literal]))))
        truncated
          (if (or (= mode 2) (= mode 3))
              (require (b/emit! (mut graph) 35 ty [masked]))
              masked)
        value
          (if (or (= mode 1) (= mode 3) (>= mode 4))
              (require (b/emit! (mut graph)
                                (if (or (= mode 3) (= mode 5)) 33 34)
                                11
                                [truncated]))
              truncated)
        compared-type (if (or (= mode 1) (= mode 3) (>= mode 4)) (: 11 i32) ty)
        threshold
          (require (b/scalar-constant! (mut graph)
                                       compared-type
                                       (masked-bits compared-type limit)
                                       8))
        comparison (require (b/emit! (mut graph) opcode 1 [value threshold]))
        result (require (b/emit! (mut graph) 34 11 [comparison]))
        ret (require (b/emit! (mut graph) 120 11 [start result (: 0 i32)]))]
    (when (and (= mode 3) (= mask 127) (= limit 131) (= opcode 16))
      (for pointer-bytes [(: 4 i32) 8]
        (match (analysis/analyze graph pointer-bytes a)
          (Err [message] (panic "mask analysis: {}" message))
          (Ok [facts]
              (let [(mut facts) facts
                    result (values/at (.domain facts) comparison)]
                (unless (and (= (values/state-kind result) 1)
                             (= (n/constant-bits result) 1))
                  (panic "mask proof absent: type {}, commuted {}, kind {}, bits {}"
                         ty
                         commuted
                         (values/state-kind result)
                         (n/constant-bits result)))
                (analysis/release! (mut facts)))))))
    (check-current-view graph)
    (match (sccp/optimize graph 8 [ret] a)
      (Err [message] (panic "mask comparison: {}" message))
      (Ok [optimized]
          (let [(mut optimized) optimized]
            (masked-execute graph
                            (.graph optimized)
                            [ret]
                            (slice (.roots optimized)))
            (rewrite/release! (mut optimized)))))
    (g/release! (mut graph))))

;;; Signed extraction of an upper field, with shared/rooted counterexamples.
(defn high-view [(type i32) (mode i32) (shift-extra i64)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        distance (+ (- 64 (* (cast i64 (types/size type 8)) 8)) shift-extra)
        amount
          (require (b/scalar-constant! (mut graph) 5 (cast u64 distance) 8))
        shift (require (b/emit! (mut graph) 50 5 [x amount]))
        field (require (b/emit! (mut graph) 35 type [shift]))
        extended (require (b/emit! (mut graph) 33 11 [field]))
        result
          (if (= mode 2)
              (let [unsigned (require (b/emit! (mut graph) 34 11 [field]))]
                (require (b/emit! (mut graph) 26 11 [extended unsigned])))
              extended)
        ret (require (b/emit! (mut graph) 120 11 [start result (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)]
    (push! (mut roots) ret)
    (when (= mode 1) (push! (mut roots) field))
    (let [(mut working) (g/duplicate graph a)
          (mut lists) (uses/build working a)
          (mut queue) (q/create (len (.instructions working)) a)
          (mut protected) (bits/create (len (.instructions working)) a)]
      (for root roots (bits/add! (mut protected) (cast i64 root)))
      (q/add! (mut queue) (cast i64 extended))
      (require (iter/run! (mut working) (mut lists) (mut queue) protected 8 a))
      (assert (= (check-uses working lists) 0))
      (require (rewrite/validate working 8 a))
      (uses/release! (mut lists))
      (q/release! (mut queue))
      (bits/release! (mut protected))
      (g/release! (mut working)))
    (match (sccp/optimize graph 8 (slice roots) a)
      (Err [e] (panic "{}" e))
      (Ok [result]
          (let [(mut result) result]
            (assert (= (n/opcode (get (.instructions (.graph result))
                                      (cast i64 field)))
                       (if (and (= mode 0) (= shift-extra 0)) 51 35)))
            (require (rewrite/validate (.graph result) 8 a))
            (match (compile/image graph start [ret] "_high_before" a)
              (Err [e] (panic "{}" e))
              (Ok [before]
                  (let [(mut before) before]
                    (match (compile/image (.graph result)
                                          start
                                          (slice (.roots result))
                                          "_high_after"
                                          a)
                      (Err [e] (panic "{}" e))
                      (Ok [after]
                          (let [(mut after) after]
                            (match (jit/map-image before a)
                              (Err [e] (panic "{}" e))
                              (Ok [first]
                                  (let [(mut first) first]
                                    (match (jit/map-image after a)
                                      (Err [e] (panic "{}" e))
                                      (Ok [second]
                                          (let [(mut second) second
                                                f
                                                  (p/cast (fnptr (cc/C)
                                                                 [u64]
                                                                 i64)
                                                          (.base (.memory first)))
                                                g
                                                  (p/cast (fnptr (cc/C)
                                                                 [u64]
                                                                 i64)
                                                          (.base (.memory second)))]
                                            (for bits [(: 0 u64)
                                                       1
                                                       9223372036854775808
                                                       18446744073709551615
                                                       18364758544493064720
                                                       81985529216486895]
                                              (assert (= (f bits) (g bits))))
                                            (jit/release-image! (mut second)))))
                                    (jit/release-image! (mut first)))))
                            (image/release! (mut after)))))
                    (image/release! (mut before)))))
            (rewrite/release! (mut result)))))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; Keep valid conversion pairs unfolded: inlining and SSA rewrites can expose
;;; these patterns after the construction folder has already run.
(defn conversion-case [(source-type i32)
                       (first-op i32)
                       (middle-type i32)
                       (second-op i32)
                       (target-type i32)
                       (rooted bool)
                       (pointer-bytes i32)
                       (literal u64)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        width (types/scalar-size source-type pointer-bytes)
        unsigned-type (case width 1 (: 2 i32) 2 3 4 4 5)
        narrowed
          (if (< width 8)
              (require (b/conversion! (mut graph)
                                      35
                                      unsigned-type
                                      pointer-bytes
                                      x))
              x)
        base
          (if (= source-type unsigned-type)
              narrowed
              (require (b/conversion! (mut graph)
                                      36
                                      source-type
                                      pointer-bytes
                                      narrowed)))
        middle
          (if (or (= first-op 47) (= first-op 50))
              (let [amount
                      (require (b/scalar-constant! (mut graph)
                                                   source-type
                                                   literal
                                                   pointer-bytes))]
                (require (b/emit! (mut graph)
                                  first-op
                                  middle-type
                                  [base amount])))
              (require (b/emit! (mut graph) first-op middle-type [base])))
        outer (require (b/emit! (mut graph) second-op target-type [middle]))
        target-width (types/scalar-size target-type pointer-bytes)
        target-unsigned (case target-width 1 (: 2 i32) 2 3 4 4 5)
        raw
          (if (= target-type target-unsigned)
              outer
              (require (b/conversion! (mut graph)
                                      36
                                      target-unsigned
                                      pointer-bytes
                                      outer)))
        output
          (if (< target-width 8)
              (require (b/conversion! (mut graph) 34 5 pointer-bytes raw))
              raw)
        ret (require (b/emit! (mut graph) 120 5 [start output (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)]
    (push! (mut roots) ret)
    (when rooted (push! (mut roots) middle) (push! (mut roots) outer))
    (let [(mut working) (g/duplicate graph a)
          (mut lists) (uses/build working a)
          (mut queue) (q/create (len (.instructions working)) a)
          (mut protected) (bits/create (len (.instructions working)) a)]
      (for root roots (bits/add! (mut protected) (cast i64 root)))
      (q/add! (mut queue) (cast i64 outer))
      (let [changes
              (require (iter/run! (mut working)
                                  (mut lists)
                                  (mut queue)
                                  protected
                                  pointer-bytes
                                  a))
            expected
              (and (!= source-type 1)
                   (!= middle-type 1)
                   (!= target-type 1)
                   (not (and (= first-op 36)
                             (!= second-op 36)
                             (types/floating? source-type)))
                   (if (= first-op 47)
                       (= (& literal
                             (<< (: 1 u64) (cast u64 (- (* width 8) 1))))
                          0)
                       (if (= first-op 50)
                           (!= (& literal (cast u64 (- (* width 8) 1))) 0)
                           true)))]
        (when (not (if expected (> changes 0) (= changes 0)))
          (panic "conversion restart count: src={} first={} middle={} second={} target={} rooted={} pointer={} literal={} changes={} expected={}"
                 source-type
                 first-op
                 middle-type
                 second-op
                 target-type
                 rooted
                 pointer-bytes
                 literal
                 changes
                 expected)))
      (assert (= (check-uses working lists) 0))
      (require (rewrite/validate working pointer-bytes a))
      (when rooted
        (assert (!= (n/opcode (get (.instructions working) (cast i64 middle)))
                    0))
        (assert (= (n/type-id (get (.instructions working) (cast i64 middle)))
                   (cast u8 middle-type))))
      (uses/release! (mut lists))
      (q/release! (mut queue))
      (bits/release! (mut protected))
      (g/release! (mut working)))
    (match (sccp/optimize graph pointer-bytes (slice roots) a)
      (Err [message] (panic "{}" message))
      (Ok [optimized]
          (let [(mut optimized) optimized]
            (require (rewrite/validate (.graph optimized) pointer-bytes a))
            (when (= pointer-bytes 8)
              (for after [false true]
                (match (compile/image (if after (.graph optimized) graph)
                                      start
                                      (if after
                                          (slice (.roots optimized))
                                          (slice roots))
                                      "_conversion_case"
                                      a)
                  (Err [message] (panic "{}" message))
                  (Ok [code]
                      (let [(mut code) code]
                        (match (jit/map-image code a)
                          (Err [message] (panic "{}" message))
                          (Ok [mapped]
                              (let [(mut mapped) mapped
                                    function
                                      (p/cast (fnptr (cc/C) [u64] u64)
                                              (.base (.memory mapped)))]
                                (for input [(: 0 u64)
                                            1
                                            2
                                            127
                                            128
                                            255
                                            256
                                            32767
                                            32768
                                            2147483648
                                            4294967295
                                            9223372036854775808
                                            18446744073709551615
                                            0x7ff0000000000001
                                            0x8000000000000000
                                            0x123456789abcdef0]
                                  (let [mask
                                          (cast u64
                                                (- (<< (: 1 u128)
                                                       (cast u128 (* width 8)))
                                                   1))
                                        masked (& input mask)
                                        bits
                                          (if (= source-type 1)
                                              (if (= masked 0) (: 0 u64) 1)
                                              masked)
                                        first
                                          (match (if (or (= first-op 47)
                                                         (= first-op 50))
                                                     (scalar/integer-binary first-op
                                                                            source-type
                                                                            pointer-bytes
                                                                            bits
                                                                            literal)
                                                     (conversion/evaluate first-op
                                                                          source-type
                                                                          middle-type
                                                                          pointer-bytes
                                                                          bits))
                                            (Some [answer] answer)
                                            (None []
                                                  (panic "invalid first conversion")))
                                        expected
                                          (match (conversion/evaluate second-op
                                                                      middle-type
                                                                      target-type
                                                                      pointer-bytes
                                                                      first)
                                            (Some [answer] answer)
                                            (None []
                                                  (panic "invalid second conversion")))]
                                    (assert (= (function input) expected))))
                                (jit/release-image! (mut mapped)))))
                        (image/release! (mut code)))))))
            (rewrite/release! (mut optimized)))))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; Independent widened arithmetic oracle for the original shift expression.
(defn rotate-piece [(value u64) (count u64) (width i32) (left bool)] (-> u64)
  (let [mask (- (<< (: 1 u128) (cast u128 width)) 1)
        x (& (cast u128 value) mask)
        shift (cast u128 (& count (cast u64 (- width 1))))]
    (cast u64 (& (if left (<< x shift) (>> x shift)) mask))))

(defn rotate-restart [(ty u8) (mode i32) (add bool) (swap bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 1]))
        width (* 8 (types/scalar-size (cast i32 ty) 8))
        mask (cast u64 (- (<< (: 1 u128) (cast u128 width)) 1))
        amount (case mode 0 (: 0 u64) 1 1 2 (cast u64 (- width 1)) 3 (cast u64 width) 7 1 8 (cast u64 (+ width 1)) 5)
        literal (require (b/scalar-constant! (mut graph) (cast i32 ty) amount 8))
        full (require (b/scalar-constant! (mut graph) (cast i32 ty) (cast u64 width) 8))
        lc (if (= mode 4) y literal)
        rc (if (= mode 4)
               (require (b/emit! (mut graph) 27 (cast i32 ty) [full y]))
               (require (b/scalar-constant! (mut graph) (cast i32 ty)
                          (& (if (= mode 6) (cast u64 (- width 4)) (- (cast u64 width) amount)) mask) 8)))
        first (if (= mode 7)
                  (require (b/emit! (mut graph) 28 (cast i32 ty)
                            [x (require (b/scalar-constant! (mut graph) (cast i32 ty) 2 8))]))
                  (require (b/emit! (mut graph) 49 (cast i32 ty) [x lc])))
        second (require (b/emit! (mut graph) 50 (cast i32 ty) [(if (= mode 5) y x) rc]))
        result (require (b/emit! (mut graph) (if add 26 46) (cast i32 ty)
                         (if swap [second first] [first second])))
        ret (require (b/emit! (mut graph) 120 (cast i32 ty) [start result (: 0 i32)]))
        expected-fold (and (!= mode 5) (!= mode 6) (!= mode 8)
                           (or (not add) (and (!= mode 0) (!= mode 3) (!= mode 4))))]
    ; The incremental restart must preserve exact-position use multisets,
    ; including the explicitly shared/rooted original producer.
    (let [(mut copy) (g/duplicate graph a)
          (mut lists) (uses/build copy a)
          (mut queue) (q/create (len (.instructions copy)) a)
          (mut protected) (bits/create (len (.instructions copy)) a)]
      (for root [ret result first] (bits/add! (mut protected) (cast i64 root)))
      (q/add! (mut queue) (cast i64 result))
      (require (iter/run! (mut copy) (mut lists) (mut queue) protected 8 a))
      (assert (= (check-uses copy lists) 0))
      (bits/release! (mut protected))
      (q/release! (mut queue))
      (uses/release! (mut lists))
      (g/release! (mut copy)))
    (match (sccp/optimize graph 8 [ret result first] a)
      (Err [message] (panic "rotate ty={} mode={}: {}" ty mode message))
      (Ok [optimized]
          (let [(mut optimized) optimized
                op (n/opcode (get (.instructions (.graph optimized)) (cast i64 result)))]
            (assert (= (or (= op 52) (= op 53)) expected-fold))
            (for original [true false]
              (match (compile/image (if original graph (.graph optimized))
                                    start (if original [ret result first] (slice (.roots optimized))) "_rotate_restart" a)
                (Err [message] (panic "{}" message))
                (Ok [code]
                    (let [(mut code) code]
                      (match (jit/map-image code a)
                        (Err [message] (panic "{}" message))
                        (Ok [loaded]
                            (let [(mut loaded) loaded
                                  f (p/cast (fnptr (cc/C) [u64 u64] u64) (.base (.memory loaded)))]
                              (for value [(: 0 u64) 1 3 0x80 0x8000 0x80000000 0x8000000000000000 0xFFFFFFFFFFFFFFFF 0xFEDCBA9876543210]
                                (for count [(: 0 u64) 1 5 7 8 15 16 31 32 63 64 65 127 255 0xFFFFFFFFFFFFFFFF]
                                  (let [c (if (= mode 4) (& count mask) amount)
                                        d (if (= mode 4) (& (- (+ (cast u128 width) (+ 1 (cast u128 mask))) (cast u128 c)) (cast u128 mask)) (cast u128 (if (= mode 6) (cast u64 (- width 4)) (- (cast u64 width) amount))))
                                        l (rotate-piece value c width true)
                                        r (rotate-piece (if (= mode 5) count value) (cast u64 d) width false)
                                        wanted (& (if add (+ l r) (| l r)) mask)]
                                    (assert (= (& (f value count) mask) wanted)))))
                              (jit/release-image! (mut loaded)))))
                      (image/release! (mut code))))))
            (rewrite/release! (mut optimized)))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (for ty [(: 2 u8) 3 4 5 8 9 10 11]
    (for mode [(: 0 i32) 1 2 3 4 5 6 7 8]
      (for add [false true]
        (for swap [false true] (rotate-restart ty mode add swap)))))
  (constant-cse-invalidation)
  (for observed [(: 0 i32) 1 2 3]
    (for seed [(: 0 i32) 1 2] (constant-cse-case observed seed)))
  (for ty [(: 2 i32) 8 3 9 4 10 5 11]
    (let [width (* 8 (types/scalar-size ty 8))]
      (for bit [(: 0 i32) 1 2 3 7 15 31 63]
        (when (< bit width)
          (for result-type [(: 2 i32) 5 11]
            (for opcode [(: 14 i32) 15]
              (for compare-bit [false true]
                (for shape [(: 0 i32) 1 2 3]
                  (for observed [(: 0 i32) 1 2 3]
                    (bit-choice-case ty
                                     result-type
                                     (<< (: 1 u64) (cast u64 bit))
                                     opcode
                                     compare-bit
                                     shape
                                     observed
                                     (and (< width 64) (= (& observed 1) 1))))))))))))
  (for ty [(: 2 i32) 8 3 9 4 10]
    (for mask [(: 1 u64) 2 4 8]
      (bit-choice-case ty 11 mask 15 false 0 0 true)))
  (for mask [(: 0 u64) 3 127 255]
    (for shape [(: 0 i32) 1 2 3]
      (bit-choice-case 5 11 mask 15 false shape 0 false)))
  (for ty [(: 2 i32) 8 3 9 4 10 5 11]
    (for opcode [(: 14 i32) 15 16 17 18 19 20 21 22 23]
      (for shape [(: 0 i32) 1 2 3 4 5]
        (for observed [(: 0 i32) 1 2 3 4]
          (boolean-restart-case ty opcode shape observed)))))
  (for opcode [(: 14 i32) 15 16 17 18 19]
    (for observed [(: 0 i32) 1 2 3 4]
      (boolean-restart-case 12 opcode 0 observed)))
  (masked-case 2 16 127 131 3 false)
  (for ty [(: 2 i32) 8 3 9 4 10 5 11]
    (for opcode [(: 14 i32) 15 16 17 18 19 20 21 22 23]
      (for mask [(: 0 u64) 5 127 128 0xFFFFFFFFFFFFFFFF]
        (for limit [(: 0 u64) 1 2 131 0xFFFFFFFFFFFFFFFF]
          (for commuted [false true]
            (masked-case ty opcode mask limit 0 commuted)
            (when (or (= ty 2) (= ty 8) (= ty 4) (= ty 10))
              (for mode [(: 1 i32) 2 3]
                (masked-case ty opcode mask limit mode commuted))))))))
  (for ty [(: 2 i32) 8 4 10]
    (for opcode [(: 14 i32) 15 16 17 18 19 20 21 22 23]
      (for limit [(: 0 u64) 1 2 131 0xFFFFFFFFFFFFFFFF]
        (for mode [(: 4 i32) 5]
          (masked-case ty opcode 0 limit mode false)))))
  (for opcode [(: 14 i32) 15]
    (for mode [(: 0 i32) 1 2 3 4 5]
      (for constant [(: 0 u64) 1 2]
        (unless (and (= mode 0) (= constant 2))
          (boolean-compare-case opcode constant mode)))))
  (for pointer [(: 4 i32) 8]
    (for rooted [false true]
      (for spec [[(: 8 i32) 33 11 35 8]
                 [2 34 5 35 8]
                 [10 33 11 35 8]
                 [8 33 11 35 10]
                 [2 34 5 35 10]
                 [4 36 10 33 11]
                 [10 36 4 34 5]
                 [11 36 5 35 4]
                 [5 36 11 36 5]
                 [12 36 5 36 12]
                 [13 36 4 36 10]
                 [5 35 4 35 2]
                 [2 34 4 34 5]
                 [8 33 10 33 11]
                 [2 34 4 33 11]
                 [2 34 5 35 1]
                 [1 34 5 35 2]
                 [4 36 13 36 4]
                 [13 36 10 33 11]
                 [12 36 11 35 10]]
        (conversion-case (get spec 0)
                         (get spec 1)
                         (get spec 2)
                         (get spec 3)
                         (get spec 4)
                         rooted
                         pointer
                         0))
      (conversion-case 6 36 (if (= pointer 4) 4 5) 36 6 rooted pointer 0)
      (for mask [(: 127 u64) 0x80000000]
        (conversion-case 10 47 10 33 11 rooted pointer mask))
      (for shift [(: 0 u64) 1 31 32 33 64 0xffffffff]
        (conversion-case 10 50 10 33 11 rooted pointer shift))))
  (for type [(: 8 i32) 9 10]
    (high-view type 0 0)
    (high-view type 1 0)
    (high-view type 2 0)
    (high-view type 0 -1)
    (high-view type 0 1))
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        seven (require (b/scalar-constant! (mut graph) 11 7 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        first (require (b/emit! (mut graph) 26 11 [x y]))
        second (require (b/emit! (mut graph) 26 11 [x y]))
        hard1 (require (b/emit! (mut graph) 68 11 [first (: 1 i32)]))
        hard2 (require (b/emit! (mut graph) 68 11 [first (: 1 i32)]))
        pair (require (b/emit! (mut graph) 26 11 [first second]))
        identity (require (b/emit! (mut graph) 47 11 [pair pair]))
        negative (require (b/emit! (mut graph) 31 11 [identity]))
        double-negative (require (b/emit! (mut graph) 31 11 [negative]))
        hard-pair (require (b/emit! (mut graph) 26 11 [hard1 hard2]))
        forward (require (b/emit! (mut graph) 26 11 [x seven]))
        equal (require (b/emit! (mut graph) 14 1 [x x]))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        selected (require (b/emit! (mut graph) 60 11 [equal seven zero]))
        copied (require (b/emit! (mut graph) 68 11 [selected (: 0 i32)]))
        multiplied (require (b/emit! (mut graph) 28 11 [hard-pair one]))
        cancelled (require (b/emit! (mut graph) 27 11 [x x]))
        exclusive (require (b/emit! (mut graph) 48 11 [y y]))
        sum (require (b/emit! (mut graph) 26 11 [double-negative multiplied]))
        answer (require (b/emit! (mut graph) 26 11 [sum forward]))
        dead-input (require (b/emit! (mut graph) 26 11 [x seven]))
        dead (require (b/emit! (mut graph) 31 11 [dead-input]))
        observed (require (b/emit! (mut graph) 68 11 [seven (: 0 i32)]))
        with-cancelled (require (b/emit! (mut graph) 26 11 [answer cancelled]))
        with-exclusive
          (require (b/emit! (mut graph) 26 11 [with-cancelled exclusive]))
        done
          (require (b/emit! (mut graph) 120 11 [start with-exclusive (: 0 i32)]))
        roots [done second observed]
        seeds
          [forward copied second hard1 hard2 dead observed identity
           double-negative multiplied cancelled exclusive equal]
        (mut failures) 0]
    ; Stress repeated edges and bucket relocation during replacement.
    (for [i 0 128]
      (require (b/emit! (mut graph) 26 11 [second second])))
    ; A lower-reference user is visited before the later COPY is replaced.
    (g/set-operand! (mut graph) forward 1 copied)
    (let [scalar-value (require (b/scalar-constant! (mut graph) 5 7 8))
          vector (require (b/emit! (mut graph) 63 37 [scalar-value]))]
      ; This deliberately unported fold must fail after processing an earlier
      ; COPY, discarding all partial edits rather than changing the source.
      (match (iter/optimize graph 8 [done vector] [copied vector] a)
        (Err [message]
             (when (!= message "SCCP vector fold family is not implemented")
               (panic "unexpected rejection: {}" message)))
        (Ok [unexpected]
            (let [(mut unexpected) unexpected]
              (set! failures (+ failures 1))
              (rewrite/release! (mut unexpected))))))
    (when (or (!= (n/opcode (get (.instructions graph) (cast i64 copied))) 68)
              (!= (.op1 (get (.instructions graph) (cast i64 forward))) copied))
      (set! failures (+ failures 1)))
    (match (iter/optimize graph 3 roots seeds a)
      (Err [message]
           (when (!= message "iterative pointer width must be four or eight")
             (set! failures (+ failures 1))))
      (Ok [unexpected]
          (let [(mut unexpected) unexpected]
            (set! failures (+ failures 1))
            (rewrite/release! (mut unexpected)))))
    (let [(mut snapshot) (g/duplicate graph a)]
      (match (iter/optimize graph 8 roots seeds a)
        (Err [message] (panic "{}" message))
        (Ok [result]
            (let [(mut result) result]
              (for [i 0 (len (.instructions graph))]
                (let [before (get (.instructions snapshot) i)
                      after (get (.instructions graph) i)]
                  (when (or (!= (.header before) (.header after))
                            (!= (.op1 before) (.op1 after))
                            (!= (.op2 before) (.op2 after))
                            (!= (.op3 before) (.op3 after))
                            (!= (get (.arities snapshot) i)
                                (get (.arities graph) i)))
                    (set! failures (+ failures 1)))))
              (when (!= (len (.constants snapshot)) (len (.constants graph)))
                (set! failures (+ failures 1)))
              (rewrite/release! (mut result)))))
      (g/release! (mut snapshot)))
    (let [(mut working) (g/duplicate graph a)
          (mut lists) (uses/build working a)
          (mut queue) (q/create (len (.instructions working)) a)
          (mut protected) (bits/create (len (.instructions working)) a)]
      (for root roots (bits/add! (mut protected) (cast i64 root)))
      (for seed seeds (q/add! (mut queue) (cast i64 seed)))
      (let [changes
              (require (iter/run! (mut working)
                                  (mut lists)
                                  (mut queue)
                                  protected
                                  8
                                  a))]
        (when (< changes 5) (set! failures (+ failures 1))))
      (set! failures (+ failures (check-uses working lists)))
      (for r [dead dead-input copied forward identity negative double-negative
              multiplied cancelled exclusive equal selected]
        (when (!= (n/opcode (get (.instructions working) (cast i64 r))) 0)
          (set! failures (+ failures 1))))
      (for r [hard1 hard2]
        (let [node (get (.instructions working) (cast i64 r))]
          (when (or (!= (n/opcode node) 68) (!= (.op2 node) 1))
            (set! failures (+ failures 1)))))
      (when (or (!= (.op1 (get (.instructions working) (cast i64 second)))
                    first)
                (!= (n/opcode (get (.instructions working) (cast i64 second)))
                    68))
        (set! failures (+ failures 1)))
      (require (rewrite/validate working 8 a))
      (for seed seeds (q/add! (mut queue) (cast i64 seed)))
      (when (!= (require (iter/run! (mut working)
                                    (mut lists)
                                    (mut queue)
                                    protected
                                    8
                                    a))
                0)
        (set! failures (+ failures 1)))
      (uses/release! (mut lists))
      (q/release! (mut queue))
      (bits/release! (mut protected))
      (g/release! (mut working)))
    (match (iter/optimize graph 8 roots seeds a)
      (Err [message] (panic "{}" message))
      (Ok [result]
          (let [(mut result) result]
            (match (compile/image (.graph result) start roots "_iter_fold" a)
              (Err [message] (panic "{}" message))
              (Ok [output]
                  (let [(mut output) output]
                    (rewrite/release! (mut result))
                    (match (macho/image-object output a)
                      (Err [message] (panic "{}" message))
                      (Ok [object]
                          (let [(mut object) object]
                            (match (fs/write-file a
                                                  "/tmp/coil-stogir-iter-fold.o"
                                                  (slice object))
                              (Err [_] (panic "object write failed"))
                              (Ok [_] 0))
                            (free! (mut object)))))
                    (match (jit/map-image output a)
                      (Err [message] (panic "{}" message))
                      (Ok [loaded]
                          (let [(mut loaded) loaded
                                function
                                  (p/cast (fnptr (cc/C) [i64 i64] i64)
                                          (.base (.memory loaded)))]
                            (for x [-100 -7 0 3 29]
                              (for y [-99 -1 0 17 53]
                                (when (!= (function x y) (+ (* 4 (+ x y)) 14))
                                  (set! failures (+ failures 1)))))
                            (jit/release-image! (mut loaded)))))
                    (image/release! (mut output))))))))
    (when (!= (n/opcode (get (.instructions graph) (cast i64 second))) 26)
      (set! failures (+ failures 1)))
    (g/release! (mut graph))
    (println "incremental fold/CSE/JIT checks: {} failures" failures)
    (if (= failures 0) 0 1)))
