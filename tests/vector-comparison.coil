         [61 24 0 31 31 | 0x4E3FE7E0 0x4E3FE7FE 0x4E3E1C00]
         [61 25 0 1 2 | 0x4E21E420 0x4E22E45E 0x4E3E1C00 0x6E205800]
         [61 25 1 1 2 | 0x4EA11C3E 0x4E3EE7C1 0x4E22E45E 0x4E3E1C21 0x6E205821]
         [61 25 2 1 2 | 0x4EA21C5E 0x4E21E422 0x4E3EE7DE 0x4E3E1C42 0x6E205842]
         [61 25 1 1 1 | 0x4EA11C3E 0x4E3EE7C1 0x4E3EE7DE 0x4E3E1C21 0x6E205821]
         [61 25 0 1 1 | 0x4E21E420 0x4E21E43E 0x4E3E1C00 0x6E205800]
         [61 25 0 30 31 | 0x4E3EE7C0 0x4E3FE7FE 0x4E3E1C00 0x6E205800]
         [61 25 0 31 30 | 0x4E3FE7E0 0x4E3EE7DE 0x4E3E1C00 0x6E205800]
         [61 25 1 1 30 | 0x4EA11C3F 0x4E3FE7E1 0x4E3EE7DE 0x4E3E1C21 0x6E205821]
         [61 25 1 30 1 | 0x4EA11C3F 0x4E3EE7C1 0x4E3FE7FE 0x4E3E1C21 0x6E205821]
         [61 25 1 1 31 | 0x4EA11C3E 0x4E3EE7C1 0x4E3FE7FE 0x4E3E1C21 0x6E205821]
         [61 25 1 31 1 | 0x4EA11C3E 0x4E3FE7E1 0x4E3EE7DE 0x4E3E1C21 0x6E205821]
         [61 25 0 30 30 | 0x4E3EE7C0 0x4E3EE7DE 0x4E3E1C00 0x6E205800]
         [61 25 0 31 31 | 0x4E3FE7E0 0x4E3FE7FE 0x4E3E1C00 0x6E205800]))

(defstruct InvalidCase [(ty i32) (op i32) (rd i32) (rn i32) (rm i32)])

(def INVALID-CASES
  (table InvalidCase
         [37 26 0 1 2]
         [37 24 0 1 2]
         [37 14 30 1 2]
         [37 15 31 1 2]
         [37 14 -1 1 2]
         [37 14 0 32 2]
         [37 14 0 1 -1]
         [37 14 0 1 32]
         [5 14 0 1 2]
         [53 14 0 1 2]))

(defn main [] (-> i64)
  (let [(mut failures) (+ (contracts) (target-widths))]
    (for row CHECK-CASES
      (set! failures
            (+ failures
               (check (.ty row)
                      (.op row)
                      (.rd row)
                      (.rn row)
                      (.rm row)
                      (.words row)))))
    (for row INVALID-CASES
      (set! failures
            (+ failures
               (invalid (.ty row) (.op row) (.rd row) (.rn row) (.rm row)))))
    (println "vector comparisons: 3484 MC cases, 4346 words; failures {}"
             failures)
    failures))
