(module stogir.tests.x64-integer-checked)
(import "stogir.graph" :as g)
(import "stogir.x64.testing" :as t)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.result" :use [Some None])

;;; Overflow-checked arithmetic of the x86-64 backend (stogir.x64.checked):
;;; ADD_OV, SUB_OV and MUL_OV with their OVERFLOW projection, signed and
;;; unsigned at 8, 16, 32 and 64 bits, compiled end to end and compared with
;;; the reference evaluator of stogir.x64.testing.
;;;
;;; Shapes of the function, with v = OP_OV(a, b) and o = OVERFLOW(v):
;;;   0  return v                      (no projection)
;;;   1  return o
;;;   2  if o return 0x5A.. else return v XOR b     (a branch on the flag)
;;;   3  return COND(o, a, v)                        (a selection on it)
;;;   4  return ZEXT(o) + (v XOR a), as I64: value and flag both live on
;;; Operand forms: two parameters, a parameter and a constant on either
;;; side, one parameter twice. Arguments carry garbage above their width.

(defn values [(ty i32) (a (dyn Allocator))] (-> (ArrayList u64))
  (let [(mut result) (ArrayList::new [u64] a)
        width (cast u64 (t/bits ty))
        m (t/mask ty)
        top (<< (: 1 u64) (- width 1))
        half (<< (: 1 u64) (/ width 2))
        (mut state) (+ (: 0x7766554433221100 u64) (cast u64 ty))]
    (for raw [(: 0 u64) 1 2 3 7 100 m (- m 1) (- m 2) top (- top 1) (+ top 1) (>> top 1)
              half (- half 1) (+ half 1) (- 0 half) (- top half)
              0x7FFFFFFF 0x80000000 0xFFFFFFFF 0x100000000 0xB504F334 0xB504 0xB5 0x0B
              0x5555555555555555 0xAAAAAAAAAAAAAAAA]
      (let [value (& raw m)
            (mut seen) false]
        (for existing result (when (= existing value) (set! seen true)))
        (unless seen (push! (mut result) value))))
    (for [i 0 10] (push! (mut result) (& (t/random! (mut state)) m)))
    ; Small magnitudes of either sign, whose products often just fit.
    (for [i 0 10]
      (let [raw (t/random! (mut state))
            small (& raw (- (<< (: 1 u64) (+ (/ width 2) (& (>> raw 60) 3))) 1))]
        (push! (mut result) (& (if (= (& raw 1) 0) small (- 0 small)) m))))
    result))

(defn expected [(opcode i32) (ty i32) (shape i32) (a u64) (b u64)] (-> u64)
  (let [v (t/binary opcode ty a b)
        o (t/overflow opcode ty a b)]
    (cond (= shape 0) v
          (= shape 1) o
          (= shape 2) (if (= o 1) (& (: 0x5A5A5A5A5A5A5A5A u64) (t/mask ty)) (^ v (& b (t/mask ty))))
          (= shape 3) (if (= o 1) (& a (t/mask ty)) v)
          :else (+ o (^ v (& a (t/mask ty)))))))

;;; `form`: 0 = (p0, p1); 1 = (p0, constant); 2 = (constant, p0); 3 = (p0, p0).
(defn check! [(tally (mut t/Tally)) (opcode i32) (ty i32) (shape i32) (form i32) (fixed u64)
              (inputs (ArrayList u64)) (allocator (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create allocator)
        start (t/start! (mut graph))
        p0 (t/param! (mut graph) start ty 0)
        p1 (t/param! (mut graph) start ty 1)
        constant (t/constant! (mut graph) ty fixed)
        left (if (= form 2) constant p0)
        right (cond (= form 1) constant (or (= form 2) (= form 3)) p0 :else p1)
        v (t/binary! (mut graph) opcode ty left right)
        o (if (= shape 0) 0 (t/unary! (mut graph) 44 1 v))
        result-type (cond (= shape 1) (: 1 i32) (= shape 4) 11 :else ty)
        (mut roots) (ArrayList::new [i32] allocator)]
    (cond (= shape 0) (push! (mut roots) (t/return! (mut graph) start ty v))
          (= shape 1) (push! (mut roots) (t/return! (mut graph) start 1 o))
          (= shape 2)
            (let [branch (t/if! (mut graph) start o)
                  yes (t/if-true! (mut graph) branch)
                  no (t/if-false! (mut graph) branch)]
              (push! (mut roots)
                     (t/return! (mut graph) yes ty
                                (t/constant! (mut graph) ty 0x5A5A5A5A5A5A5A5A)))
              (push! (mut roots)
                     (t/return! (mut graph) no ty (t/binary! (mut graph) 48 ty v right))))
          (= shape 3)
            (push! (mut roots)
                   (t/return! (mut graph) start ty (t/select! (mut graph) ty o left v)))
          :else
            (let [mixed (t/binary! (mut graph) 48 ty v left)
                  wide (if (= ty 11) mixed (t/unary! (mut graph) (if (= (t/bits ty) 64) 36 34) 11 mixed))
                  flag (t/unary! (mut graph) 34 11 o)]
              (push! (mut roots)
                     (t/return! (mut graph) start 11 (t/binary! (mut graph) 26 11 flag wide)))))
    (match (t/compiled (mut tally) "checked" graph start (slice roots) allocator)
      (None []
            (println "  opcode {} type {} shape {} form {} constant {:x}" opcode ty shape form
                     fixed))
      (Some [mapped]
            (let [(mut code) mapped]
              (for x inputs
                (for [j 0 (if (= form 0) (len inputs) 1)]
                  (let [y (get inputs j)
                        a (if (= form 2) fixed x)
                        b (cond (= form 1) fixed (or (= form 2) (= form 3)) x :else y)
                        before (.failures tally)]
                    (t/expect! (mut tally) "checked" code result-type
                               [(t/dirty ty x) (t/dirty ty y)]
                               (expected opcode ty shape a b))
                    (when (and (!= (.failures tally) before) (< before 25))
                      (println "  opcode {} type {} shape {} form {} a {:x} b {:x}"
                               opcode ty shape form a b)))))
              (t/unmap! (mut code)))))
    (free! (mut roots))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (if (not (t/host?))
      (do (println "x64 integer checked: skipped, not an x86-64 host") 0)
      (let [allocator (malloc-allocator)
            (mut tally) (t/tally)]
        (for ty [(: 2 i32) 3 4 5 6 7 8 9 10 11]
          (let [(mut inputs) (values ty allocator)]
            (for opcode [(: 41 i32) 42 43]
              (for shape [(: 0 i32) 1 2 3 4]
                (check! (mut tally) opcode ty shape 0 0 inputs allocator)
                (check! (mut tally) opcode ty shape 3 0 inputs allocator)
                (for fixed inputs
                  (check! (mut tally) opcode ty shape 1 fixed inputs allocator)
                  (check! (mut tally) opcode ty shape 2 fixed inputs allocator))))
            (free! (mut inputs))))
        (println "x64 integer checked: {} functions, {} checks, {} failures"
                 (.functions tally) (.checks tally) (.failures tally))
        (if (= (.failures tally) 0) 0 1))))
