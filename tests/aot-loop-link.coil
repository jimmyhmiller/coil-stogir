(module stogir.tests.aot-loop-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern stogir.loop-test :as "stogir_loop_test" :cc (cc/C) [i64] (-> i64))

(defn main [] (-> i64)
  (let [(mut n) -5
        (mut failures) 0]
    (when (!= (& (primitive/cast u64
                                 (primitive/cast (ptr u8)
                                                 (fnptr-of stogir.loop-test)))
                 7)
              0)
      (set! failures (+ failures 1)))
    (while (<= n 100)
      (let [expected (if (< n 0) 0 (/ (* n (- n 1)) 2))]
        (when (!= (stogir.loop-test n) expected) (set! failures (+ failures 1))))
      (set! n (+ n 1)))
    (println "AOT loop checks: {} failures" failures)
    (if (= failures 0) 0 1)))
