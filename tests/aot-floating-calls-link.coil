(module stogir.tests.aot-floating-calls-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defn probe :cc (cc/C) [(g0 i64)
                        (f0 f64)
                        (g1 i64)
                        (f1 f32)
                        (g2 i64)
                        (f2 f64)
                        (g3 i64)
                        (f3 f32)
                        (g4 i64)
                        (f4 f64)
                        (g5 i64)
                        (f5 f32)
                        (g6 i64)
                        (f6 f64)
                        (g7 i64)
                        (f7 f32)
                        (g8 i64)
                        (f8 f64)
                        (g9 i64)
                        (f9 f32)] (-> f64)
  (+ (* (cast f64 g0) 1.0)
     (* (cast f64 f0) 2.0)
     (* (cast f64 g1) 3.0)
     (* (cast f64 f1) 4.0)
     (* (cast f64 g2) 5.0)
     (* (cast f64 f2) 6.0)
     (* (cast f64 g3) 7.0)
     (* (cast f64 f3) 8.0)
     (* (cast f64 g4) 9.0)
     (* (cast f64 f4) 10.0)
     (* (cast f64 g5) 11.0)
     (* (cast f64 f5) 12.0)
     (* (cast f64 g6) 13.0)
     (* (cast f64 f6) 14.0)
     (* (cast f64 g7) 15.0)
     (* (cast f64 f7) 16.0)
     (* (cast f64 g8) 17.0)
     (* (cast f64 f8) 18.0)
     (* (cast f64 g9) 19.0)
     (* (cast f64 f9) 20.0)))

(defn probe32 :cc (cc/C) [(g0 i64)
                          (f0 f64)
                          (g1 i64)
                          (f1 f32)
                          (g2 i64)
                          (f2 f64)
                          (g3 i64)
                          (f3 f32)
                          (g4 i64)
                          (f4 f64)
                          (g5 i64)
                          (f5 f32)
                          (g6 i64)
                          (f6 f64)
                          (g7 i64)
                          (f7 f32)
                          (g8 i64)
                          (f8 f64)
                          (g9 i64)
                          (f9 f32)] (-> f32)
  (cast f32 (probe g0 f0 g1 f1 g2 f2 g3 f3 g4 f4 g5 f5 g6 f6 g7 f7 g8 f8 g9 f9)))

(extern entry0 :as "stogir_fp_call_0" :cc (cc/C) [u64 f64 f32 i64] (-> f64))

(extern entry1 :as "stogir_fp_call_1" :cc (cc/C) [u64 f64 f32 i64] (-> f64))

(extern entry2 :as "stogir_fp_call_2" :cc (cc/C) [u64 f64 f32 i64] (-> f32))

(extern entry3 :as "stogir_fp_call_3" :cc (cc/C) [u64 f64 f32 i64] (-> i64))

(extern entry4 :as "stogir_fp_call_4" :cc (cc/C) [u64 f64 f32 i64] (-> f32))

(defn main [] (-> i64)
  (let [(mut failures) 0
        target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of probe)))
        target32
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of probe32)))]
    (for input [(: -7 i64) -1 0 1 7 100]
      (let [d (* (cast f64 input) 0.25)
            f (* (cast f32 input) (: 0.125 f32))
            (mut wanted) (: 0.0 f64)
            (mut i) (: 0 i32)]
        (while (< i 10)
          (let [constant? (= (% i 3) 0)
                gp (if constant? (cast f64 (+ i 10)) (cast f64 input))
                fp
                  (if constant?
                      (if (= (% i 2) 0)
                          (+ (cast f64 i) 0.5)
                          (+ (cast f64 i) 0.25))
                      (if (= (% i 2) 0) d (cast f64 f)))]
            (set! wanted
                  (+ wanted
                     (* gp (cast f64 (+ (* i 2) 1)))
                     (* fp (cast f64 (+ (* i 2) 2))))))
          (set! i (+ i 1)))
        (when (or (!= (entry0 target d f input) wanted)
                  (!= (entry1 target d f input) d)
                  (!= (entry2 target d f input) f)
                  (!= (entry3 target d f input) input)
                  (!= (entry4 target32 d f input) (cast f32 wanted)))
          (set! failures (+ failures 1)))))
    (println "linked mixed floating calls and live-through values: {} failures"
             failures)
    (if (= failures 0) 0 1)))
