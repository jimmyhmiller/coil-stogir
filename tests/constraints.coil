(module stogir.tests.constraints)
(import "stogir.constraints" :as c)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn main [] (-> i64)
  (let [(mut uses) (ArrayList::new [c/Use] (malloc-allocator))
        (mut failures) 0]
    (c/add! (mut uses) 20 1 -1)
    (c/add! (mut uses) 4 0 -1)
    (c/add! (mut uses) 12 2 3)
    (when (!= (c/next-use uses 0 0) 4) (set! failures (+ failures 1)))
    (when (!= (c/next-use uses 0 1) 12) (set! failures (+ failures 1)))
    (when (!= (c/next-use uses 13 1) 20) (set! failures (+ failures 1)))
    (when (!= (c/next-use uses 21 0) -1) (set! failures (+ failures 1)))
    (when (c/add! (mut uses) 12 2 4) (set! failures (+ failures 1)))
    (when (!= (.register (get uses 1)) 3) (set! failures (+ failures 1)))
    (when (not (c/add! (mut uses) 4 1 -1)) (set! failures (+ failures 1)))
    (when (!= (len uses) 3) (set! failures (+ failures 1)))
    (when (!= (c/next-use uses 0 1) 4) (set! failures (+ failures 1)))
    (when (c/add! (mut uses) -1 1 -1) (set! failures (+ failures 1)))
    (free! (mut uses))
    (println "allocation constraint checks: {} failures" failures)
    (if (= failures 0) 0 1)))
