(module stogir.tests.node)
(import "stogir.node" :as n)

(defn main [] (-> i64)
  (let [node (n/make 255 127 65535 -1 2147483647 -2147483648)
        bits (: 0xFEDCBA9876543210 u64)
        con (n/constant 11 11 -7 bits)
        (mut failures) 0]
    (when (!= (sizeof n/Node) 16) (set! failures (+ failures 1)))
    (when (!= (n/opcode node) 255) (set! failures (+ failures 1)))
    (when (!= (n/type-id node) 127) (set! failures (+ failures 1)))
    (when (!= (n/auxiliary node) 65535) (set! failures (+ failures 1)))
    (when (!= (.op1 node) -1) (set! failures (+ failures 1)))
    (when (!= (n/constant-bits con) bits) (set! failures (+ failures 1)))
    (when (!= (.op1 con) -7) (set! failures (+ failures 1)))
    (when (!= (n/input-cells 0) 1) (set! failures (+ failures 1)))
    (when (!= (n/input-cells 3) 1) (set! failures (+ failures 1)))
    (when (!= (n/input-cells 4) 2) (set! failures (+ failures 1)))
    (when (!= (n/input-cells 65535) 16384) (set! failures (+ failures 1)))
    (println "node checks: {} failures" failures)
    (if (= failures 0) 0 1)))
