(defstruct InvalidCase
  [(op i32) (ty i32) (st i32) (rd i32) (rn i32) (lane i32)])

(def INVALID-CASES
  (table InvalidCase
         [64 37 5 32 33 0]
         [61 37 5 16 32 0]
         [61 37 12 32 33 0]
         [61 37 5 0 63 0]
         [61 37 5 0 32 2]
         [61 37 5 0 32 -2]
         [62 37 5 62 32 0]
         [62 37 5 32 63 -1]
         [63 37 5 32 32 0]
         [63 37 5 32 -1 -1]
         [61 53 5 0 32 0]
         [61 5 5 0 32 0]))

(defn main [] (-> i64)
  (let [(mut failures) (contracts)]
    (for row CHECK-CASES
      (set! failures
            (+ failures
               (check (.op row)
                      (.ty row)
                      (.st row)
                      (.rd row)
                      (.rn row)
                      (.lane row)
                      (.words row)))))
    (for row INVALID-CASES
      (set! failures
            (+ failures
               (invalid (.op row)
                        (.ty row)
                        (.st row)
                        (.rd row)
                        (.rn row)
                        (.lane row)))))
    (println "vector lanes: 2976 MC cases, 9309 words; failures {}" failures)
    failures))
