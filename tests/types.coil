(module stogir.tests.types)
(import "stogir.types" :as t)

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut ty) (: 0 i32)]
    (while (< ty 14)
      (when (not (t/valid-scalar? ty)) (set! failures (+ failures 1)))
      (when (!= (t/integer? ty) (or (t/signed? ty) (t/unsigned? ty)))
        (set! failures (+ failures 1)))
      (when (= (t/floating? ty) (t/integer? ty))
        (when (!= ty 0) (set! failures (+ failures 1))))
      (set! ty (+ ty 1)))
    (when (!= (t/scalar-size 6 4) 4) (set! failures (+ failures 1)))
    (when (!= (t/scalar-size 6 8) 8) (set! failures (+ failures 1)))
    (when (!= (t/scalar-size 0 8) 0) (set! failures (+ failures 1)))
    (when (!= (t/scalar-size 14 8) -1) (set! failures (+ failures 1)))
    (when (!= (t/scalar-size 1 3) -1) (set! failures (+ failures 1)))
    (println "type checks: {} failures" failures)
    (if (= failures 0) 0 1)))
