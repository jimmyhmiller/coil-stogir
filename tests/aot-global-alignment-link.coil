(module stogir.tests.aot-global-alignment-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern address4096 :as "stogir_aligned_address_4096" :cc (cc/C) [] (-> u64))

(extern address16384 :as "stogir_aligned_address_16384" :cc (cc/C) [] (-> u64))

(defn main [] (-> i64)
  (let [a (address4096)
        b (address16384)
        fa (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of address4096)))
        fb
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of address16384)))
        pa (primitive/cast (ptr u64) a)
        pb (primitive/cast (ptr u64) b)
        (mut failures) 0]
    (when (or (!= (& a 4095) 0)
              (!= (& b 16383) 0)
              (!= (& fa 31) 0)
              (!= (& fb 16383) 0)
              (!= (primitive/load pa) 42)
              (!= (primitive/load pb) 42))
      (set! failures (+ failures 1)))
    (primitive/store! pa 99)
    (primitive/store! pb 123)
    (when (or (!= (primitive/load (primitive/cast (ptr u64) (address4096))) 99)
              (!= (primitive/load (primitive/cast (ptr u64) (address16384)))
                  123))
      (set! failures (+ failures 1)))
    (println "linked aligned functions and mutable globals: {} failures"
             failures)
    (if (= failures 0) 0 1)))
