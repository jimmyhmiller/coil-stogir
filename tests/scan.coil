(module stogir.tests.scan)
(import "stogir.scan" :as s)
(import "stogir.interval" :as r)
(import "stogir.live-ranges" :as l)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut values) (ArrayList::new [l/Value] a)
        (mut bindings) (ArrayList::new [s/Binding] a)
        (mut current) (ArrayList::new [r/Range] a)
        (mut failures) 0]
    (push! (mut values) (l/Value :ranges (ArrayList::new [r/Range] a)))
    (push! (mut values) (l/Value :ranges (ArrayList::new [r/Range] a)))
    (let [first (elem (mut values) 0)
          second (elem (mut values) 1)]
      (r/add! (mut (.ranges first)) 0 2)
      (r/add! (mut (.ranges first)) 6 8)
      (r/add! (mut (.ranges second)) 2 4))
    (push! (mut bindings)
           (s/Binding
             :interval 0
             :register 0
             :active true))
    (push! (mut bindings)
           (s/Binding
             :interval 1
             :register 1
             :active true))
    (s/advance! (mut bindings) values 3)
    (when (.active (get bindings 0)) (set! failures (+ failures 1)))
    (when (not (.active (get bindings 1))) (set! failures (+ failures 1)))
    (r/add! (mut current) 3 7)
    (let [(mut free) (s/free-until current values bindings 3 3 a)]
      (when (!= (get free 0) 6) (set! failures (+ failures 1)))
      (when (!= (get free 1) 3) (set! failures (+ failures 1)))
      (when (!= (get free 2) 0x7FFFFFFFFFFFFFFF) (set! failures (+ failures 1)))
      (let [choice (s/choose-free free 3 7 -1)
            constrained (s/choose-free free 3 7 0)
            blocked (s/choose-free free 3 7 1)]
        (when (!= (.register choice) 2) (set! failures (+ failures 1)))
        (when (!= (.register constrained) 0) (set! failures (+ failures 1)))
        (when (!= (.until constrained) 6) (set! failures (+ failures 1)))
        (when (!= (.register blocked) -1) (set! failures (+ failures 1))))
      (free! (mut free)))
    (s/advance! (mut bindings) values 6)
    (when (!= (len bindings) 1) (set! failures (+ failures 1)))
    (when (not (.active (get bindings 0))) (set! failures (+ failures 1)))
    (s/advance! (mut bindings) values 8)
    (when (!= (len bindings) 0) (set! failures (+ failures 1)))
    (free! (mut current))
    (free! (mut bindings))
    (l/release! (mut values))
    (println "linear scan state checks: {} failures" failures)
    (if (= failures 0) 0 1)))
