(module stogir.tests.jit-parameter-capture)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.native.compile" :as compile)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn forty-two :cc (cc/C) [] (-> i64)
  42)

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        address
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of forty-two)))
        callee (require (b/scalar-constant! (mut graph) 6 address 8))
        ; Raw unannotated default CALL is ready immediately after START, and
        ; precedes PARAM in construction order. Entry scheduling must capture x0
        ; before the call replaces it with its result.
        call (require (b/emit! (mut graph) 79 11 [start callee]))
        parameter (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        sum (require (b/emit! (mut graph) 26 11 [call parameter]))
        ret (require (b/emit! (mut graph) 120 11 [call sum (: 0 i32)]))
        (mut failures) 0]
    (match (compile/text graph start [ret] allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [compiled]
          (let [(mut code) compiled]
            (match (jit/map-text (slice code))
              (Err [_] (set! failures (+ failures 1)))
              (Ok [image]
                  (let [(mut owned) image
                        f
                          (primitive/cast (fnptr (cc/C) [i64] i64)
                                          (.base owned))
                        (mut x) -100]
                    (while (<= x 100)
                      (when (!= (call-ptr f x) (+ x 42))
                        (set! failures (+ failures 1)))
                      (set! x (+ x 1)))
                    (jit/release! (mut owned)))))
            (free! (mut code)))))
    (g/release! (mut graph))
    (println "entry parameter capture checks: {} failures" failures)
    (if (= failures 0) 0 1)))
