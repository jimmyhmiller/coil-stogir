(module stogir.tests.aot-vector-doubling-link)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)

(extern double
        :as
        "vector_double_u64"
        :cc
        (cc/C)
        [(ptr u64) (ptr u64)]
        (-> u64))

(defn main [] (-> i64)
  (let [(mut input) (ArrayList::new [u64] (malloc-allocator))
        (mut output) (ArrayList::new [u64] (malloc-allocator))
        (mut failures) 0]
    (push! (mut input) 0)
    (push! (mut input) 0)
    (for [i 0 4] (push! (mut output) 0xA5A5A5A5A5A5A5A5))
    (for value [(: 0 u64)
                1
                0xFFFFFFFFFFFFFFFF
                0x8000000000000000
                0x7FFFFFFFFFFFFFFF
                0x123456789ABCDEF0]
      (set! (mut input) 0 value)
      (set! (mut input) 1 (p/iadd value (: 1 u64)))
      (when (!= (double (.data input) (p/index (.data output) 1)) 0)
        (set! failures (+ failures 1)))
      (when (or (!= (get output 0) 0xA5A5A5A5A5A5A5A5)
                (!= (get output 3) 0xA5A5A5A5A5A5A5A5)
                (!= (get output 1) (p/imul value (: 2 u64)))
                (!= (get output 2) (p/imul (p/iadd value (: 1 u64)) (: 2 u64))))
        (set! failures (+ failures 1))))
    (free! (mut input))
    (free! (mut output))
    (println "linked vector doubling: {} failures" failures)
    (if (= failures 0) 0 1)))
