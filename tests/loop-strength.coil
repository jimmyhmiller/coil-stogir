(module stogir.tests.loop-strength)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.loop-strength" :as strength)
(import "stogir.a64.strength-cost" :as cost)
(import "stogir.loop-rotate" :as rotate)
(import "stogir.pipeline" :as pipeline)
(import "stogir.calls" :as calls)
(import "stogir.options" :as options)
(import "stogir.image" :as image)
(import "stogir.link" :as link)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(v (Result i32 (slice u8)))] (-> i32)
  (match v (Ok [r] r) (Err [message] (panic "{}" message))))
(defstruct Fixture [(graph g/Graph) (roots (ArrayList i32))])
(defn parameter! [(graph (mut g/Graph)) (start i32) (index i32) (ty i32)] (-> i32)
  (let [r (require (b/emit! (mut graph) 71 11 [start (: 0 i32) index]))]
    (if (= ty 11) r (require (b/emit! (mut graph) (if (or (= ty 4) (= ty 10)) 35 36) ty [r])))))

;;; Independent counted loop, with a separate modular recurrence. Two body
;;; paths join before the back edge; both header opcodes and PHI orders occur.
;;; Modes: affine ADD, affine SUB, two products, shifted product, nonlinear,
;;; narrowing/extension barrier, hard COPY barrier, shared product, variant step.
(defn build [(ty i32) (mode i32) (swapped bool) (merge bool) (subtract bool) (a (dyn Allocator))]
  (-> Fixture)
  (let [(mut graph) (g/create a) (mut roots) (ArrayList::new [i32] a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        limit (parameter! (mut graph) start 0 11)
        initial (parameter! (mut graph) start 1 ty)
        step (parameter! (mut graph) start 2 ty)
        base (parameter! (mut graph) start 3 ty)
        scale (parameter! (mut graph) start 4 ty)
        zero (require (b/scalar-constant! (mut graph) ty 0 8))
        z64 (require (b/scalar-constant! (mut graph) 11 0 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        two (require (b/scalar-constant! (mut graph) ty 2 8))
        seven (require (b/scalar-constant! (mut graph) ty 7 8))
        entry (require (b/emit! (mut graph) 114 0 [start]))
        header (require (b/loop-begin! (mut graph) entry))
        counter (require (b/loop-phi! (mut graph) header z64))
        value (require (b/loop-phi! (mut graph) header initial))
        sum (require (b/loop-phi! (mut graph) header zero))
        less (require (b/emit! (mut graph) 20 1 [counter limit]))
        branch (require (b/emit! (mut graph) 116 0 [header less]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        input (cond (= mode 5)
                      (let [narrow (require (b/emit! (mut graph) 35 9 [value]))]
                        (require (b/emit! (mut graph) 34 ty [narrow])))
                    (= mode 6) (require (b/emit! (mut graph) 68 ty [value (: 1 i32)]))
                    :else value)
        product (require (b/emit! (mut graph) 28 ty [input (if (= mode 4) value scale)]))
        term (cond (= mode 2)
                     (let [other (require (b/emit! (mut graph) 28 ty [value base]))]
                       (require (b/emit! (mut graph) 26 ty [product other])))
                   (= mode 3)
                     (let [shifted (require (b/emit! (mut graph) 49 ty [product two]))]
                       (require (b/emit! (mut graph) 26 ty [base shifted])))
                   :else (require (b/emit! (mut graph) (if (= mode 1) 27 26) ty [base product])))
        term (if (= mode 7) (require (b/emit! (mut graph) 26 ty [term product])) term)
        parity (require (b/emit! (mut graph) 47 11 [counter one]))
        even (require (b/emit! (mut graph) 14 1 [parity z64]))
        split (require (b/emit! (mut graph) 116 0 [yes even]))
        left (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        right (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        lhs (require (b/emit! (mut graph) 26 ty [sum term]))
        rhs (require (b/emit! (mut graph) 26 ty [lhs seven]))
        le (require (b/emit! (mut graph) 114 0 [left]))
        re (require (b/emit! (mut graph) 114 0 [right]))
        join (require (b/emit! (mut graph) 112 0 [le re]))
        added (require (b/emit! (mut graph) 67 ty [join lhs rhs]))
        actual-step (if (= mode 8)
                       (if (= ty 11) counter
                           (require (b/emit! (mut graph) (if (or (= ty 4) (= ty 10)) 35 36) ty [counter]))) step)
        next (require (b/emit! (mut graph) (if subtract 27 26) ty [value actual-step]))
        count-next (require (b/emit! (mut graph) 26 11 [counter one]))
        back (require (b/emit! (mut graph) 115 0 [join]))
        answer (if (= ty 11) sum
                   (require (b/emit! (mut graph) (if (or (= ty 4) (= ty 10)) 34 36) 11 [sum])))]
    (when merge
      (unless (g/rewrite-inputs! (mut graph) header 112 0 [entry entry]) (panic "merge patch")))
    (require (b/patch! (mut graph) header 1 (if swapped back entry)))
    (require (b/patch! (mut graph) header 2 (if swapped entry back)))
    (for pair [(: [counter z64 count-next] (array i32 3)) [value initial next] [sum zero added]]
      (require (b/patch! (mut graph) (get pair 0) 2 (get pair (if swapped 2 1))))
      (require (b/patch! (mut graph) (get pair 0) 3 (get pair (if swapped 1 2)))))
    (push! (mut roots) (require (b/emit! (mut graph) 120 11 [no answer (: 0 i32)])))
    (let [(mut sig) (match (calls/create 0 11 [(: 11 u8) 11 11 11 11] a)
                     (Ok [s] s) (Err [message] (panic "{}" message)))]
      (require (calls/function! (mut graph) sig a)) (calls/release! (mut sig)))
    (Fixture :graph graph :roots roots)))

(defn expected [(count u64) (initial u64) (step u64) (base u64) (scale u64)
                (bits i32) (mode i32) (subtract bool)] (-> u64)
  (let [modulus (<< (: 1 u128) (cast u128 bits)) mask (- modulus 1)
        (mut value) (& (cast u128 initial) mask) (mut sum) (: 0 u128)]
    (for [i (: 0 u64) count]
      (let [input (if (= mode 5) (& value 0xFFFF) value)
            product (* input (if (= mode 4) value (& (cast u128 scale) mask)))
            term (cond (= mode 1) (- (+ modulus (cast u128 base)) (& product mask))
                       (= mode 2) (+ product (* value (& (cast u128 base) mask)))
                       (= mode 3) (+ (cast u128 base) (<< product 2))
                       (= mode 7) (+ (cast u128 base) (* product 2))
                       :else (+ (cast u128 base) product))]
        (set! sum (& (+ sum term (if (= (& i 1) 0) (: 0 u128) 7)) mask))
        (let [delta (cast u128 (if (= mode 8) i step))]
          (set! value (& (if subtract (- (+ modulus value) (& delta mask))
                                (+ value delta)) mask)))))
    (cast u64 sum)))

(defn native [(graph g/Graph) (roots (slice i32)) (ty i32) (mode i32) (subtract bool)
              (a (dyn Allocator))] (-> void)
  (native-scale graph roots ty mode subtract a false 0))

(defn native-scale [(graph g/Graph) (roots (slice i32)) (ty i32) (mode i32) (subtract bool)
                    (a (dyn Allocator)) (fixed bool) (constant u64)] (-> void)
  (match (compile/image-with-options graph 1 roots "_strength_test" (options/Options :level 1) a)
    (Err [message] (panic "native: {}" message))
    (Ok [code]
      (let [(mut code) code]
        (match (link/compose [code] a)
          (Err [message] (panic "compose: {}" message))
          (Ok [module]
            (let [(mut module) module]
              (match (jit/map-image (.image module) a)
                (Err [message] (panic "map: {}" message))
                (Ok [loaded]
                  (let [(mut loaded) loaded
                        id (match (image/find-symbol (.image module) "_strength_test")
                             (Some [id] id) (None [] (panic "symbol")))
                        f (p/cast (fnptr (cc/C) [u64 u64 u64 u64 u64] u64)
                            (p/cast (ptr u8) (get (.addresses loaded) (cast i64 id))))]
                    (for count [(: 0 u64) 1 2 7 31]
                      (for seed [(: 0 u64) 17 0x7FFFFFFF 0xFFFFFFFF 0x7FFFFFFFFFFFFFFF 0xFFFFFFFFFFFFFFFD]
                        (for step [(: 0 u64) 1 3 0xFFFFFFFFFFFFFFFD]
                          (for scale [(: 0 u64) 1 40 0xFFFFFFFFFFFFFFFD]
                           (for base [(: 0 u64) 0xFFFFFFFFFFFFFFF3]
                            (let [
                                want (expected count seed step base (if fixed constant scale)
                                       (if (or (= ty 4) (= ty 10)) 32 64) mode subtract)
                                got (f count seed step base scale)]
                            (unless (= got want)
                              (panic "ty {} mode {} count {} seed {} step {} base {} scale {} got {} expected {}"
                                ty mode count seed step base scale got want))))))))
                    (jit/release-image! (mut loaded)))))
              (link/release! (mut module)))))
        (image/release! (mut code))))))

(defn hot-products [(graph g/Graph) (roots (slice i32)) (a (dyn Allocator))] (-> i64)
  (match (pipeline/prepare graph 1 roots a)
    (Err [message] (panic "prepare: {}" message))
    (Ok [prepared]
      (let [(mut prepared) prepared (mut owners) (rotate/block-map graph prepared a) (mut count) (: 0 i64)]
        (for r (.nodes (.schedule prepared))
          (when (and (= (n/opcode (get (.instructions graph) (cast i64 r))) 28)
                     (> (get (.depths prepared) (cast i64 (get owners (cast i64 r)))) 0))
            (set! count (+ count 1))))
        (free! (mut owners)) (pipeline/release! (mut prepared)) count))))

(defn check [(ty i32) (mode i32) (swapped bool) (merge bool) (subtract bool)] (-> void)
  (let [a (malloc-allocator) (mut fixture) (build ty mode swapped merge subtract a)
        (mut original) (g/duplicate (.graph fixture) a) accepted (or (< mode 4) (= mode 7))]
    (assert (> (hot-products (.graph fixture) (slice (.roots fixture)) a) 0))
    (native (.graph fixture) (slice (.roots fixture)) ty mode subtract a)
    (match (if swapped (cost/run (.graph fixture) 1 (slice (.roots fixture)) a)
                      (strength/run (.graph fixture) 1 (slice (.roots fixture)) a))
      (Err [message] (panic "run ty {} mode {}: {}" ty mode message))
      (Ok [result]
        (assert (= (> (.recurrences result) 0) accepted))
        (match (.graph result)
          (None [] (assert (not accepted)))
          (Some [owned]
            (let [(mut owned) owned]
              (assert (= (hot-products owned (slice (.roots fixture)) a) 0))
              (match (strength/run owned 1 (slice (.roots fixture)) a)
                (Err [message] (panic "repeat: {}" message))
                (Ok [again] (assert (= (.recurrences again) 0))
                  (match (.graph again) (None [] 0) (Some [_] (panic "non-idempotent")))))
              (native owned (slice (.roots fixture)) ty mode subtract a)
              (g/release! (mut owned)))))))
    (assert (= (len (.instructions original)) (len (.instructions (.graph fixture)))))
    (for [i 0 (len (.instructions original))]
      (let [before (get (.instructions original) i) after (get (.instructions (.graph fixture)) i)]
        (assert (and (= (.header before) (.header after)) (= (.op1 before) (.op1 after))
                     (= (.op2 before) (.op2 after)) (= (.op3 before) (.op3 after))))))
    (g/release! (mut original)) (g/release! (mut (.graph fixture))) (free! (mut (.roots fixture)))))

(defn multiple-latches [] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        limit (parameter! (mut graph) start 0 11)
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        forty (require (b/scalar-constant! (mut graph) 11 40 8))
        entry (require (b/emit! (mut graph) 114 0 [start]))
        header (match (g/append-inputs! (mut graph) 113 0 [entry (: 0 i32) 0])
                 (Some [r] r) (None [] (panic "header")))
        phi (match (g/append-inputs! (mut graph) 67 11 [header zero (: 0 i32) 0])
              (Some [r] r) (None [] (panic "phi")))
        test (require (b/emit! (mut graph) 20 1 [phi limit]))
        branch (require (b/emit! (mut graph) 116 0 [header test]))
        body (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        done (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        parity (require (b/emit! (mut graph) 47 11 [phi one]))
        even (require (b/emit! (mut graph) 14 1 [parity zero]))
        split (require (b/emit! (mut graph) 116 0 [body even]))
        left (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        right (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        lb (require (b/emit! (mut graph) 115 0 [left]))
        rb (require (b/emit! (mut graph) 115 0 [right]))
        next (require (b/emit! (mut graph) 26 11 [phi one]))
        product (require (b/emit! (mut graph) 28 11 [phi forty]))
        ret (require (b/emit! (mut graph) 120 11 [done product (: 0 i32)]))]
    (require (b/patch! (mut graph) header 2 lb)) (require (b/patch! (mut graph) header 3 rb))
    (require (b/patch! (mut graph) phi 3 next)) (require (b/patch! (mut graph) phi 4 next))
    (match (strength/run graph start [ret] a)
      (Err [message] (panic "multiple-latch input invalid: {}" message))
      (Ok [result] (assert (= (.recurrences result) 0))
        (match (.graph result) (None [] 0) (Some [_] (panic "unsupported latch set changed")))))
    (g/release! (mut graph))))

(defn cost-check [(ty i32) (constant u64) (commuted bool)] (-> void)
  (let [a (malloc-allocator) (mut fixture) (build ty 0 false false false a)
        literal (require (b/scalar-constant! (mut (.graph fixture)) ty constant 8))
        expensive (or (= constant 40) (= constant 127))]
    (for [i 1 (len (.instructions (.graph fixture)))]
      (let [node (get (.instructions (.graph fixture)) i)]
        (when (= (n/opcode node) 28)
          (require (b/patch! (mut (.graph fixture)) (cast i32 i) 1
                            (if commuted literal (.op1 node))))
          (require (b/patch! (mut (.graph fixture)) (cast i32 i) 2
                            (if commuted (.op1 node) literal)))
          (assert (= (cost/machine-multiply? (.graph fixture) (cast i32 i)) expensive)))))
    (native-scale (.graph fixture) (slice (.roots fixture)) ty 0 false a true constant)
    ; The arithmetic proof admits these loops even when the target declines.
    (match (strength/run (.graph fixture) 1 (slice (.roots fixture)) a)
      (Err [message] (panic "unrestricted cost fixture: {}" message))
      (Ok [result]
        (assert (> (.recurrences result) 0))
        (match (.graph result)
          (None [] (panic "unrestricted graph missing"))
          (Some [owned] (let [(mut owned) owned] (g/release! (mut owned)))))))
    (match (cost/run (.graph fixture) 1 (slice (.roots fixture)) a)
      (Err [message] (panic "target cost fixture: {}" message))
      (Ok [result]
        (assert (= (> (.recurrences result) 0) expensive))
        (match (.graph result)
          (None [] (assert (not expensive)))
          (Some [owned]
            (let [(mut owned) owned]
              (native-scale owned (slice (.roots fixture)) ty 0 false a true constant)
              (match (cost/run owned 1 (slice (.roots fixture)) a)
                (Err [message] (panic "target repeat: {}" message))
                (Ok [again] (assert (= (.recurrences again) 0))
                  (match (.graph again) (None [] 0) (Some [_] (panic "target not idempotent")))))
              (g/release! (mut owned)))))))
    (g/release! (mut (.graph fixture))) (free! (mut (.roots fixture)))))

(defn main [] (-> i32)
  (multiple-latches)
  (for ty [(: 4 i32) 5 10 11]
    (for constant [(: 1 u64) 2 3 4 5 8 9 16 17 40 127]
      (cost-check ty constant false)
      (cost-check ty constant true))
    (for [mode (: 0 i32) 9]
      (check ty mode false false false)
      (check ty mode true true true)))
  0)
