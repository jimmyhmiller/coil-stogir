(defn input-byte [(index i64) (seed u64)] (-> u8)
  (let [word
          (match (% (/ index 8) 7)
            (0 (: 0 u64))
            (1 0x8000000000000000)
            (2 0x7FF0000000000000)
            (3 0x7FF8123456789ABC)
            (4 0xFFFFFFFFFFFFFFFF)
            (5 0x7FC123457F800000)
            (_ 0x0123456789ABCDEF))]
    (cast u8 (>> (^ word seed) (cast u64 (* (% index 8) 8))))))

(defn exercise [(width i32) (pressure? bool) (literal? bool) (address (ptr u8))]
  (-> i64)
  (let [allocator (malloc-allocator)
        f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] u64) address)
        target
          (p/cast u64
                  (p/cast (ptr u8)
                          (: (fnptr-of probe) (fnptr (cc/C) [(ptr u8)] u64))))
        (mut input) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) (: 0 i64)]
    (for seed [(: 0 u64) 17 255]
      (clear! (mut input))
      (set! i 0)
      (while (< i 2048)
        (push! (mut input) (input-byte i seed))
        (set! i (+ i 1)))
      (for count [(: 0 u64) 1 2 3 7]
        (when (or pressure? (= count 0))
          (clear! (mut output))
          (set! i 0)
          (while (< i 2064) (push! (mut output) 165) (set! i (+ i 1)))
          (let [got
                  (call-ptr f
                            (p/cast u64 (p/index (.data output) 3))
                            (p/cast u64 (.data input))
                            count
                            target)
                expected (if pressure? (: 638 u64) (: 0 u64))]
            (when (!= got expected)
              (println "vector local width{} pressure{} literal{} seed{} count{} return{} expected{}"
                       width
                       pressure?
                       literal?
                       seed
                       count
                       got
                       expected)
              (set! failures (+ failures 1))))
          (set! i 0)
          (while (< i 2048)
            (when (!= (get input i) (input-byte i seed))
              (set! failures (+ failures 1)))
            (set! i (+ i 1)))
          (set! i 0)
          (while (< i 2064)
            (let [pos (- i 3)
                  expected
                    (if pressure?
                        (if (and (>= pos 0) (< pos (* 40 (cast i64 width))))
                            (input-byte (+ (* (if (= (% count 2) 0)
                                                  (/ pos (cast i64 width))
                                                  (^ (/ pos (cast i64 width)) 1))
                                              (cast i64 width))
                                           (% pos (cast i64 width)))
                                        seed)
                            (if (and (>= pos 1024) (< pos 1344))
                                (input-byte pos seed)
                                (: 165 u8)))
                        (if (and (>= pos 0) (< pos (cast i64 width)))
                            (input-byte pos (if literal? (: 0 u64) seed))
                            (: 165 u8)))]
              (when (!= (get output i) expected)
                (println "vector local width{} pressure{} literal{} seed{} count{} byte{} got{} expected{}"
                         width
                         pressure?
                         literal?
                         seed
                         count
                         i
                         (get output i)
                         expected)
                (set! failures (+ failures 1))))
            (set! i (+ i 1))))))
    (free! (mut input))
    (free! (mut output))
    failures))

(meta (link-entries `entry "stogir_vector_local_" 0 27 `[u64 u64 u64 u64] `u64))

(defstruct ExerciseCase
  [(width i32)
   (pressure? bool)
   (literal? bool)
   (address (fnptr (cc/C) [u64 u64 u64 u64] u64))])

(def EXERCISE-CASES
  (table ExerciseCase
         [8 false false (fnptr-of entry0)]
         [8 false false (fnptr-of entry1)]
         [8 false true (fnptr-of entry2)]
         [16 false false (fnptr-of entry3)]
         [16 false false (fnptr-of entry4)]
         [16 false true (fnptr-of entry5)]
         [8 false false (fnptr-of entry6)]
         [8 false false (fnptr-of entry7)]
         [8 false true (fnptr-of entry8)]
         [16 false false (fnptr-of entry9)]
         [16 false false (fnptr-of entry10)]
         [16 false true (fnptr-of entry11)]
         [16 false false (fnptr-of entry12)]
         [16 false false (fnptr-of entry13)]
         [16 false false (fnptr-of entry14)]
         [16 false false (fnptr-of entry15)]
         [16 false false (fnptr-of entry16)]
         [8 true false (fnptr-of entry17)]
         [8 true false (fnptr-of entry18)]
         [16 true false (fnptr-of entry19)]
         [16 true false (fnptr-of entry20)]
         [8 true false (fnptr-of entry21)]
         [8 true false (fnptr-of entry22)]
         [16 true false (fnptr-of entry23)]
         [16 true false (fnptr-of entry24)]
         [8 false false (fnptr-of entry25)]
         [16 false false (fnptr-of entry26)]))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row EXERCISE-CASES
      (set! failures
            (+ failures
               (exercise (.width row)
                         (.pressure? row)
                         (.literal? row)
                         (p/cast (ptr u8) (.address row))))))
    (println "linked vector locals, aliased views, wide storage and call/spill pressure: {} failures"
             failures)
    (if (= failures 0) 0 1)))
