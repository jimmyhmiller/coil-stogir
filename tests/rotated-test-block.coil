(module stogir.tests.rotated-test-block)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.options" :as options)
(import "stogir.a64.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))

(defn word [(text (slice u8)) (i i64)] (-> u32)
  (| (cast u32 (get text i))
     (<< (cast u32 (get text (+ i 1))) 8)
     (<< (cast u32 (get text (+ i 2))) 16)
     (<< (cast u32 (get text (+ i 3))) 24)))

;;; sum = 0; for (i = 0; i < n; i++) sum += i * 3. The header holds only PHIs
;;; and the loop test, so the edge that does not fall into it runs the test in
;;; place: the function contains no unconditional branch.
(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        n (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        three (require (b/scalar-constant! (mut graph) 11 3 8))
        entry (require (b/emit! (mut graph) 114 0 [start]))
        header (require (b/loop-begin! (mut graph) entry))
        i (require (b/loop-phi! (mut graph) header zero))
        sum (require (b/loop-phi! (mut graph) header zero))
        test (require (b/emit! (mut graph) 16 1 [i n]))
        split (require (b/emit! (mut graph) 116 0 [header test]))
        body (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        exit (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        scaled (require (b/emit! (mut graph) 28 11 [i three]))
        next-sum (require (b/emit! (mut graph) 26 11 [sum scaled]))
        next-i (require (b/emit! (mut graph) 26 11 [i one]))
        back (require (b/emit! (mut graph) 115 0 [body]))
        ret (require (b/emit! (mut graph) 120 11 [exit sum (: 0 i32)]))]
    (require (b/patch! (mut graph) header 2 back))
    (require (b/patch! (mut graph) i 3 next-i))
    (require (b/patch! (mut graph) sum 3 next-sum))
    (for level [(: 1 i32) 3]
      (match (compile/image-with-options graph start [ret] "_rotated"
                                         (options/Options :level level) a)
        (Err [e] (panic "{}" e))
        (Ok [code]
            (let [(mut code) code
                  text (slice (.text code))]
              (for [k 0 (/ (len text) 4)]
                (let [w (word text (* k 4))]
                  (assert (!= (& w (: 0xFC000000 u32)) (: 0x14000000 u32)))))
              (match (jit/map-image code a)
                (Err [e] (panic "{}" e))
                (Ok [mapped]
                    (let [(mut mapped) mapped
                          f (p/cast (fnptr (cc/C) [i64] i64) (.base (.memory mapped)))]
                      (assert (= (f 0) 0))
                      (assert (= (f 1) 0))
                      (assert (= (f 5) 30))
                      (assert (= (f 100) 14850))
                      (jit/release-image! (mut mapped)))))
              (image/release! (mut code))))))
    (g/release! (mut graph))
    (println "edges into a loop test run it in place")
    0))
