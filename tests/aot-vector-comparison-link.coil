(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row LINKED-EXERCISE-CASES
      (set! failures
            (+ failures
               (linked-exercise (.ty row) (.opcode row) (.mode row) (.name row)))))
    (for row LINKED-PRESSURE-CASES
      (set! failures
            (+ failures (linked-pressure (.ty row) (.opcode row) (.name row)))))
    (println "linked vector comparisons: 860 objects; failures {}" failures)
    failures))
