(module stogir.tests.aot-vector-comparison-link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "stogir.types" :as types)
(import "stogir.test-data" :use [table])

(defn pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [i (% (+ lane (if right? (/ seed 11) (% seed 11))) 11)
        fp? (types/floating? base)
        wide? (= base 12)]
    (if fp?
        (if wide?
            (match i
              (0 (: 0 u64))
              (1 0x8000000000000000)
              (2 0x3FF0000000000000)
              (3 0xBFF0000000000000)
              (4 1)
              (5 0x000FFFFFFFFFFFFF)
              (6 0x7FEFFFFFFFFFFFFF)
              (7 0x7FF0000000000000)
              (8 0xFFF0000000000000)
              (9 0x7FF8123456789ABC)
              (_ 0x7FF0123456789ABC))
            (match i
              (0 (: 0 u64))
              (1 0x80000000)
              (2 0x3F800000)
              (3 0xBF800000)
              (4 1)
              (5 0x007FFFFF)
              (6 0x7F7FFFFF)
              (7 0x7F800000)
              (8 0xFF800000)
              (9 0x7FC12345)
              (_ 0x7F812345)))
        (match i
          (0 (: 0 u64))
          (1 1)
          (2 0xFFFFFFFFFFFFFFFF)
          (3 (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1))))
          (4 (- (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1)))
                1))
          (5 0x8080808080808080)
          (6 0x7F7F7F7F7F7F7F7F)
          (7 0xFFFF0000FFFF0000)
          (8 0x123456789ABCDEF0)
          (9 0xFFFFFFFFFFFFFFFE)
          (_ 0x0102030405060708)))))

(defn input-byte [(base i32) (index i64) (seed i64) (right? bool)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (pattern base (/ index width) seed right?)
              (cast u64 (* (% index width) 8))))))

(defn literal-word [(base i32) (lane i64) (right? bool) (mode i32)] (-> u64)
  (let [bits (* 8 (types/scalar-size base 8))
        mask (cast u64 (- (<< (: 1 u128) (cast u128 bits)) 1))]
    (if (= mode 5)
        (if right? mask (cast u64 (<< (: 1 u128) (cast u128 (- bits 1)))))
        (if (and (= mode 6) right?)
            (: 0 u64)
            (pattern base lane (if right? 99 10) right?)))))

(defn literal-byte [(base i32) (index i64) (right? bool) (mode i32)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (literal-word base (/ index width) right? mode)
              (cast u64 (* (% index width) 8))))))

(defn nan? [(base i32) (bits u64)] (-> bool)
  (let [exponent (if (= base 12) (: 0x7FF0000000000000 u64) 0x7F800000)
        fraction (if (= base 12) (: 0x000FFFFFFFFFFFFF u64) 0x007FFFFF)]
    (and (= (& bits exponent) exponent) (!= (& bits fraction) 0))))

(defn predicate32 [(op i32) (a f32) (b f32)] (-> bool)
  (match op
    (14 (= a b))
    (15 (!= a b))
    (16 (< a b))
    (17 (>= a b))
    (18 (<= a b))
    (19 (> a b))
    (20 (not (>= a b)))
    (21 (not (< a b)))
    (22 (not (> a b)))
    (23 (not (<= a b)))
    (24 true)
    (_ false)))

(defn predicate64 [(op i32) (a f64) (b f64)] (-> bool)
  (match op
    (14 (= a b))
    (15 (!= a b))
    (16 (< a b))
    (17 (>= a b))
    (18 (<= a b))
    (19 (> a b))
    (20 (not (>= a b)))
    (21 (not (< a b)))
    (22 (not (> a b)))
    (23 (not (<= a b)))
    (24 true)
    (_ false)))

(defn expected [(opcode i32) (base i32) (a u64) (b u64)] (-> u64)
  (let [bits (* 8 (types/scalar-size base 8))
        range (<< (: 1 u128) (cast u128 bits))
        mask (- range 1)
        x (& (cast u128 a) mask)
        y (& (cast u128 b) mask)
        yes?
          (if (types/floating? base)
              (if (or (nan? base a) (nan? base b))
                  (or (= opcode 15)
                      (and (>= opcode 20) (<= opcode 23))
                      (= opcode 25))
                  (if (= base 12)
                      (let [(mut l) (: 0.0 f64)
                            (mut r) (: 0.0 f64)]
                        (p/store! (p/cast (ptr u64) (mut l)) a)
                        (p/store! (p/cast (ptr u64) (mut r)) b)
                        (predicate64 opcode l r))
                      (let [(mut l) (: 0.0 f32)
                            (mut r) (: 0.0 f32)]
                        (p/store! (p/cast (ptr u32) (mut l)) (cast u32 a))
                        (p/store! (p/cast (ptr u32) (mut r)) (cast u32 b))
                        (predicate32 opcode l r))))
              (let [sign (>> range 1)
                    l
                      (if (>= x sign)
                          (- (cast i128 x) (cast i128 range))
                          (cast i128 x))
                    r
                      (if (>= y sign)
                          (- (cast i128 y) (cast i128 range))
                          (cast i128 y))]
                (match opcode
                  (14 (= x y))
                  (15 (!= x y))
                  (16 (< l r))
                  (17 (>= l r))
                  (18 (<= l r))
                  (19 (> l r))
                  (20 (< x y))
                  (21 (>= x y))
                  (22 (<= x y))
                  (_ (> x y)))))]
    (if yes? (cast u64 mask) (: 0 u64))))

(defn exercise [(ty i32) (opcode i32) (mode i32) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        base (types/base-type ty)
        width (types/size ty 8)
        lane-width (types/scalar-size base 8)
        lanes (/ width lane-width)
        f (p/cast (fnptr (cc/C) [u64 u64 u64] void) address)
        (mut a) (ArrayList::new [u8] allocator)
        (mut b) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 121)
      (clear! (mut a))
      (clear! (mut b))
      (clear! (mut output))
      (let [(mut i) (: 0 i64)]
        (while (< i 32)
          (push! (mut a) (input-byte base i seed false))
          (push! (mut b) (input-byte base i seed true))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 80) (push! (mut output) 165) (set! i (+ i 1))))
      (call-ptr f
                (p/cast u64 (.data output))
                (p/cast u64 (.data a))
                (p/cast u64 (.data b)))
      (let [(mut lane) (: 0 i32)]
        (while (< lane lanes)
          (let [x
                  (if (or (= mode 1) (= mode 3) (>= mode 5))
                      (literal-word base (cast i64 lane) false mode)
                      (pattern base (cast i64 lane) seed false))
                y
                  (if (= mode 4)
                      x
                      (if (or (= mode 2) (= mode 3) (>= mode 5))
                          (literal-word base (cast i64 lane) true mode)
                          (pattern base (cast i64 lane) seed true)))
                result (expected opcode base x y)
                (mut got) (: 0 u64)
                (mut byte) (: 0 i32)]
            (while (< byte lane-width)
              (set! got
                    (| got
                       (<< (cast u64
                                 (get output
                                      (cast i64 (+ (* lane lane-width) byte))))
                           (cast u64 (* byte 8)))))
              (set! byte (+ byte 1)))
            (when (!= got result)
              (println "vector binary ty{} op{} mode{} seed{} lane{} got{} expected{}"
                       ty
                       opcode
                       mode
                       seed
                       lane
                       got
                       result)
              (set! failures (+ failures 1))))
          (set! lane (+ lane 1))))
      (let [(mut i) (: 0 i64)]
        (while (< i 80)
          (when (>= i (cast i64 width))
            (let [left?
                    (and (>= mode 0)
                         (!= mode 4)
                         (>= i 24)
                         (< i (+ 24 (cast i64 width))))
                  right?
                    (and (>= mode 0)
                         (!= mode 4)
                         (>= i 48)
                         (< i (+ 48 (cast i64 width))))
                  wanted
                    (if left?
                        (if (or (= mode 1) (= mode 3) (>= mode 5))
                            (literal-byte base (- i 24) false mode)
                            (input-byte base (- i 24) seed false))
                        (if right?
                            (if (or (= mode 2) (= mode 3) (>= mode 5))
                                (literal-byte base (- i 48) true mode)
                                (input-byte base (- i 48) seed true))
                            (: 165 u8)))]
              (when (!= (get output i) wanted) (set! failures (+ failures 1)))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 32)
          (when (or (!= (get a i) (input-byte base i seed false))
                    (!= (get b i) (input-byte base i seed true)))
            (set! failures (+ failures 1)))
          (set! i (+ i 1))))
      (set! seed (+ seed 1)))
    (free! (mut a))
    (free! (mut b))
    (free! (mut output))
    failures))

