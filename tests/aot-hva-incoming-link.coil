                             :m0 (lane8 20)
                             :m1 (lane8 21)
                             :m2 (lane8 22))
                           (H8_1 :m0 (lane8 99)))]
           (when (!= (v/vextract (.m0 result) 0) (word 21))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m1 result) 0) (word 22))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m2 result) 0) (word 20))
             (set! failures (+ failures 1)))))
      (6 (let [f (p/cast (fnptr (cc/C) [(ptr u8) u64 H8_4 H8_1] H8_4) address)
               result
                 (call-ptr f
                           (p/cast (ptr u8) (data output))
                           0xFE123456789ABCDE
                           (H8_4
                             :m0 (lane8 20)
                             :m1 (lane8 21)
                             :m2 (lane8 22)
                             :m3 (lane8 23))
                           (H8_1 :m0 (lane8 99)))]
           (when (!= (v/vextract (.m0 result) 0) (word 21))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m1 result) 0) (word 22))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m2 result) 0) (word 23))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m3 result) 0) (word 20))
             (set! failures (+ failures 1)))))
      (7 (let [f
                 (p/cast (fnptr (cc/C)
                                [(ptr u8)
                                 u64
                                 H8_1
                                 H8_1
                                 H8_1
                                 H8_1
                                 H8_1
                                 H8_1
                                 H8_1
                                 H8_4
                                 H8_1]
                                H8_4)
                         address)
               result
                 (call-ptr f
                           (p/cast (ptr u8) (data output))
                           0xFE123456789ABCDE
                           (H8_1 :m0 (lane8 0))
                           (H8_1 :m0 (lane8 1))
                           (H8_1 :m0 (lane8 2))
                           (H8_1 :m0 (lane8 3))
                           (H8_1 :m0 (lane8 4))
                           (H8_1 :m0 (lane8 5))
                           (H8_1 :m0 (lane8 6))
                           (H8_4
