      (8 (let [f
                 (p/cast (fnptr (cc/C) [(ptr u8) u64 H16_1 H16_1] H16_1)
                         address)
               result
                 (call-ptr f
                           (p/cast (ptr u8) (data output))
                           0xFE123456789ABCDE
                           (H16_1 :m0 (lane16 20))
                           (H16_1 :m0 (lane16 99)))]
           (when (!= (v/vextract (.m0 result) 0) (word 20))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m0 result) 1) (word 91))
             (set! failures (+ failures 1)))))
      (9 (let [f
                 (p/cast (fnptr (cc/C)
                                [(ptr u8)
                                 u64
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1]
                                H16_1)
                         address)
               result
                 (call-ptr f
                           (p/cast (ptr u8) (data output))
                           0xFE123456789ABCDE
                           (H16_1 :m0 (lane16 0))
                           (H16_1 :m0 (lane16 1))
                           (H16_1 :m0 (lane16 2))
                           (H16_1 :m0 (lane16 3))
                           (H16_1 :m0 (lane16 4))
                           (H16_1 :m0 (lane16 5))
                           (H16_1 :m0 (lane16 6))
                           (H16_1 :m0 (lane16 20))
                           (H16_1 :m0 (lane16 99)))]
           (when (!= (v/vextract (.m0 result) 0) (word 20))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m0 result) 1) (word 91))
             (set! failures (+ failures 1)))))
      (10 (let [f
                  (p/cast (fnptr (cc/C) [(ptr u8) u64 H16_2 H16_1] H16_2)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_2 :m0 (lane16 20) :m1 (lane16 21))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (11 (let [f
                  (p/cast (fnptr (cc/C)
                                 [(ptr u8)
                                  u64
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_2
                                  H16_1]
                                 H16_2)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_1 :m0 (lane16 0))
                            (H16_1 :m0 (lane16 1))
                            (H16_1 :m0 (lane16 2))
                            (H16_1 :m0 (lane16 3))
                            (H16_1 :m0 (lane16 4))
                            (H16_1 :m0 (lane16 5))
                            (H16_1 :m0 (lane16 6))
                            (H16_2 :m0 (lane16 20) :m1 (lane16 21))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (12 (let [f
                  (p/cast (fnptr (cc/C) [(ptr u8) u64 H16_3 H16_1] H16_3)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_3
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (13 (let [f
                  (p/cast (fnptr (cc/C)
                                 [(ptr u8)
                                  u64
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_3
                                  H16_1]
                                 H16_3)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_1 :m0 (lane16 0))
                            (H16_1 :m0 (lane16 1))
                            (H16_1 :m0 (lane16 2))
                            (H16_1 :m0 (lane16 3))
                            (H16_1 :m0 (lane16 4))
                            (H16_1 :m0 (lane16 5))
                            (H16_1 :m0 (lane16 6))
                            (H16_3
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (14 (let [f
                  (p/cast (fnptr (cc/C) [(ptr u8) u64 H16_4 H16_1] H16_4)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_4
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22)
                              :m3 (lane16 23))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 23))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 94))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (15 (let [f
                  (p/cast (fnptr (cc/C)
                                 [(ptr u8)
                                  u64
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_4
                                  H16_1]
                                 H16_4)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_1 :m0 (lane16 0))
                            (H16_1 :m0 (lane16 1))
                            (H16_1 :m0 (lane16 2))
                            (H16_1 :m0 (lane16 3))
                            (H16_1 :m0 (lane16 4))
                            (H16_1 :m0 (lane16 5))
                            (H16_1 :m0 (lane16 6))
                            (H16_4
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22)
                              :m3 (lane16 23))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 23))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 94))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (_ (set! failures (+ failures 1))))
    (let [wide? (>= id 8)
          prefix (if (= (% id 2) 1) 7 0)
          lanes (if wide? 2 1)
          (mut i) (: 0 i64)]
      (while (< i 17)
        (let [element (/ i lanes)
              lane (% i lanes)
              wanted
                (if (< element prefix)
                    (word (cast u64 (+ element (* lane 71))))
                    (if (= element prefix)
                        (word (cast u64 (+ 99 (* lane 71))))
                        (if (= i (* (+ prefix 1) lanes))
                            (: 0xFE123456789ABCDE u64)
                            (: 0 u64))))]
          (when (!= (get output i) wanted)
            (println "HVA incoming case{} word{} got{} expected{}"
                     id
                     i
                     (get output i)
                     wanted)
            (set! failures (+ failures 1))))
        (set! i (+ i 1))))
    failures))

(import "coil.os" :as os)

; Resolve linked C symbols through the platform loader. The function pointer
; types in exercise retain their complete C record signatures.
(defn linked [(id i32) (name (ptr i8))] (-> i64)
  (let [address (os/dlsym (p/cast (ptr i8) (: -2 i64)) name)]
    (if (= (p/cast u64 address) 0)
        (do (println "missing linked HVA symbol{}" id) 1)
        (exercise id (p/cast (ptr u8) address)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (set! failures (+ failures (linked 0 c"stogir_hva_incoming_0")))
    (set! failures (+ failures (linked 1 c"stogir_hva_incoming_1")))
    (set! failures (+ failures (linked 2 c"stogir_hva_incoming_2")))
    (set! failures (+ failures (linked 3 c"stogir_hva_incoming_3")))
    (set! failures (+ failures (linked 4 c"stogir_hva_incoming_4")))
    (set! failures (+ failures (linked 5 c"stogir_hva_incoming_5")))
    (set! failures (+ failures (linked 6 c"stogir_hva_incoming_6")))
    (set! failures (+ failures (linked 7 c"stogir_hva_incoming_7")))
    (set! failures (+ failures (linked 8 c"stogir_hva_incoming_8")))
    (set! failures (+ failures (linked 9 c"stogir_hva_incoming_9")))
    (set! failures (+ failures (linked 10 c"stogir_hva_incoming_10")))
    (set! failures (+ failures (linked 11 c"stogir_hva_incoming_11")))
    (set! failures (+ failures (linked 12 c"stogir_hva_incoming_12")))
    (set! failures (+ failures (linked 13 c"stogir_hva_incoming_13")))
    (set! failures (+ failures (linked 14 c"stogir_hva_incoming_14")))
    (set! failures (+ failures (linked 15 c"stogir_hva_incoming_15")))
    (println "linked HVA callees, SIMD/stack arguments and complete returns: {} failures"
             failures)
    (if (= failures 0) 0 1)))
