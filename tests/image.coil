(module stogir.tests.image)
(import "stogir.image" :as i)
(import "stogir.relocate" :as r)
(import "stogir.bytes" :as b)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn main [] (-> i64)
  (let [(mut image) (i/create (malloc-allocator))
        (mut failures) 0]
    (match (i/symbol! (mut image) "callee" 0 0)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [symbol]
          (do
            (match (i/symbol! (mut image) "callee" 1 0)
              (Err [_] (set! failures (+ failures 1)))
              (Ok [same] (when (!= symbol same) (set! failures (+ failures 1)))))
            (for byte [(: 0 u8) 0 0 0] (push! (mut (.text image)) byte))
            (when (not (i/relocate! (mut image)
                                    (i/Relocation
                                      :section 1
                                      :offset 0
                                      :kind 2
                                      :symbol symbol
                                      :addend 0)))
              (set! failures (+ failures 1)))
            (when (i/relocate! (mut image)
                               (i/Relocation
                                 :section 1
                                 :offset 1
                                 :kind 2
                                 :symbol symbol
                                 :addend 0))
              (set! failures (+ failures 1)))
            (match (i/symbol! (mut image) "callee" 1 4)
              (Ok [_] (set! failures (+ failures 1)))
              (Err [_] 0)))))
    (when (!= (len (.symbols image)) 1) (set! failures (+ failures 1)))
    (b/patch32! (mut (.text image)) 0 0x14000000)
    (let [(mut addresses) (ArrayList::new [u64] (malloc-allocator))]
      (push! (mut addresses) 0x1010)
      (match (r/apply! (mut image) addresses 0x1000 0 (malloc-allocator))
        (Err [_] (set! failures (+ failures 1)))
        (Ok [_] 0))
      (when (!= (r/read32 (.text image) 0) 0x14000004)
        (set! failures (+ failures 1)))
      (free! (mut addresses)))
    (i/release! (mut image))
    (println "code image checks: {} failures" failures)
    (if (= failures 0) 0 1)))
