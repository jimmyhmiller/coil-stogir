(module stogir.tests.grouped-prototypes)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.target" :as target)
(import "stogir.native.compile" :as compile)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [message] (println "{}" message) 0)))

(defn rejected [(r (Result i32 (slice u8)))] (-> i64)
  (match r (Err [_] 0) (Ok [_] 1)))

(defn invalid-prototype [(r (Result calls/Prototype (slice u8)))] (-> i64)
  (match r (Err [_] 0) (Ok [p] (let [(mut p) p] (calls/release! (mut p)) 1))))

;;; The platform convention number (9 AArch64 Darwin, 8 System V x86-64),
;;; plain and variadic, and a type that cannot follow a U64 in one group.
(const PLATFORM (target/arch-pick 9 8))

(const VARIADIC (target/arch-pick 25 24))

(const STRANGER-TYPE (target/arch-pick 13 6))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        integer (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 1]))
        single (require (b/emit! (mut graph) 71 13 [start (: 0 i32) 2]))
        descriptor
          (groups/Group
            :first 1
            :count 2
            :alignment 8)
        ; A value whose type cannot join a U64 in one group: a FLOAT on
        ; AArch64 (members are homogeneous), an ADDR on x86-64 (System V
        ; pairs U64 with FLOAT, but an ADDR is no group member).
        stranger (target/arch-pick single target)
        (mut failures) 0]
    (set! failures
          (+ failures
             (invalid-prototype (calls/create-grouped PLATFORM
                                                      5
                                                      [(: 5 u8)]
                                                      [descriptor]
                                                      allocator))
             (invalid-prototype (calls/create-grouped VARIADIC
                                                      5
                                                      [(: 5 u8)]
                                                      [(groups/Group
                                                         :first 2147483647
                                                         :count 4
                                                         :alignment 8)]
                                                      allocator))
             (invalid-prototype (calls/create-grouped PLATFORM
                                                      5
                                                      [(: 5 u8) STRANGER-TYPE]
                                                      [(groups/Group
                                                         :first 0
                                                         :count 2
                                                         :alignment 8)]
                                                      allocator))))
    (match (calls/create-grouped VARIADIC 5 [(: 5 u8)] [descriptor] allocator)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype
                before (len (.instructions graph))]
            (set! failures
                  (+ failures
                     (rejected (calls/emit! (mut graph)
                                            prototype
                                            start
                                            target
                                            [integer integer]
                                            allocator))
                     (rejected (calls/emit! (mut graph)
                                            prototype
                                            start
                                            target
                                            [integer integer stranger]
                                            allocator))
                     (rejected (calls/function! (mut graph) prototype allocator))))
            (when (or (!= (.function-prototype graph) 0)
                      (!= before (len (.instructions graph))))
              (set! failures (+ failures 1)))
            (let [called
                    (require (calls/emit! (mut graph)
                                          prototype
                                          start
                                          target
                                          [integer integer integer]
                                          allocator))
                  ret
                    (require (b/emit! (mut graph)
                                      120
                                      5
                                      [called called (: 0 i32)]))]
              (match (calls/validate-call graph called)
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [_] 0))
              (b/patch! (mut graph) called 4 stranger)
              (match (calls/validate-call graph called)
                (Err [_] 0)
                (Ok [_] (set! failures (+ failures 1))))
              (b/patch! (mut graph) called 4 integer)
              (match (compile/text graph start [ret] allocator)
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [text] (let [(mut text) text] (free! (mut text))))))
            ; Recheck a mutated in-memory descriptor before serializing/interning.
            (set! (.first (elem (mut (.groups prototype)) 0)) 70000)
            (let [before (len (.instructions graph))]
              (set! failures
                    (+ failures
                       (rejected (calls/emit! (mut graph)
                                              prototype
                                              start
                                              target
                                              [integer integer integer]
                                              allocator))))
              (when (!= before (len (.instructions graph)))
                (set! failures (+ failures 1))))
            (calls/release! (mut prototype)))))
    ; A corrupted 256-byte parameter vector can masquerade as a valid SGAG
    ; trailer when its one-byte scalar count wraps. Validate the owned model,
    ; not just the serialized interpretation, before touching graph metadata.
    (match (calls/create VARIADIC 5 [] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype
                (mut descriptors) (ArrayList::new [groups/Group] allocator)
                (mut i) (: 0 i32)]
            (while (< i 31)
              (push! (mut descriptors)
                     (groups/Group
                       :first i
                       :count 1
                       :alignment 4))
              (set! i (+ i 1)))
            (groups/append! (mut (.parameters prototype)) (slice descriptors))
            (let [(mut encoded) (calls/encode prototype allocator)
                  before (len (.instructions graph))]
              (when (or (!= (len (.parameters prototype)) 256)
                        (not (calls/valid-bytes? (slice encoded))))
                (set! failures (+ failures 1)))
              (set! failures
                    (+ failures
                       (rejected (calls/attach! (mut graph)
                                                prototype
                                                target
                                                allocator))
                       (rejected (calls/function! (mut graph)
                                                  prototype
                                                  allocator))))
              (when (or (!= before (len (.instructions graph)))
                        (!= (.function-prototype graph) 0))
                (set! failures (+ failures 1)))
              (free! (mut encoded)))
            (free! (mut descriptors))
            (calls/release! (mut prototype)))))
    (g/release! (mut graph))
    (println "grouped prototype retention, rejected construction and raw mutation checks: {} failures"
             failures)
    (if (= failures 0) 0 1)))
