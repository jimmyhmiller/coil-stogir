(module stogir.tests.jit-void-return)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn receive :cc (cc/C) [(cell (ptr i64)) (x i64)] (-> void)
  (set! (index cell 0) (+ x 17)))

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        cell (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 2]))
        (mut failures) 0]
    (match (calls/create 0 0 [(: 6 u8) 6 11] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype]
            (require (calls/function! (mut graph) owned allocator))
            (calls/release! (mut owned)))))
    (match (calls/create 0 0 [(: 6 u8) 11] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned-prototype) prototype
                call
                  (require (calls/emit! (mut graph)
                                        owned-prototype
                                        start
                                        target
                                        [cell x]
                                        allocator))
                ret (require (b/emit! (mut graph) 120 0 [call (: 0 i32) 0]))]
            (match (compile/object graph
                                   start
                                   [ret]
                                   "_stogir_void_return_test"
                                   allocator)
              (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
              (Ok [object]
                  (let [(mut owned) object]
                    (match (fs/write-file allocator
                                          "/tmp/coil-stogir-void-return.o"
                                          (slice owned))
                      (Err [_] (set! failures (+ failures 1)))
                      (Ok [_] 0))
                    (free! (mut owned)))))
            (match (compile/text graph start [ret] allocator)
              (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
              (Ok [compiled]
                  (let [(mut code) compiled]
                    (match (jit/map-text (slice code))
                      (Err [_] (set! failures (+ failures 1)))
                      (Ok [image]
                          (let [(mut owned) image
                                f
                                  (primitive/cast (fnptr (cc/C)
                                                         [u64 (ptr i64) i64]
                                                         void)
                                                  (.base owned))
                                target
                                  (primitive/cast u64
                                                  (primitive/cast (ptr u8)
                                                                  (fnptr-of receive)))
                                (mut cell) (: 0 i64)
                                (mut x) (: -100 i64)]
                            (while (<= x 100)
                              (call-ptr f target (mut cell) x)
                              (when (!= cell (+ x 17))
                                (set! failures (+ failures 1)))
                              (set! x (+ x 1)))
                            (jit/release! (mut owned)))))
                    (free! (mut code)))))
            (calls/release! (mut owned-prototype)))))
    (g/release! (mut graph))
    (println "native void return checks: {} failures" failures)
    (if (= failures 0) 0 1)))
