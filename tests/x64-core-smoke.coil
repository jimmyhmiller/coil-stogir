(module stogir.tests.x64-core-smoke)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.target" :as target)
(import "stogir.x64.compile" :as compile)
(import "stogir.jit.native" :as jit)
(import "coil.fs" :as fs)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

;;; The smallest end-to-end x86-64 checks: f(a, b) = (a + b) * 3 - a and a
;;; counted loop summing 0..n-1. The generated bytes are also written to
;;; build/ so they can be disassembled on any host.

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn run2 [(text (slice u8)) (a i64) (b i64)] (-> i64)
  (target/arch-pick
    0
    (match (jit/map-text text)
      (Err [msg] (do (println "{}" msg) -1))
      (Ok [image]
          (let [(mut owned) image
                f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (.base owned))
                value (call-ptr f a b)]
            (jit/release! (mut owned))
            value)))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0]
    (let [(mut graph) (g/create allocator)
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          a (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          bb (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
          three (require (b/scalar-constant! (mut graph) 11 3 8))
          sum (require (b/emit! (mut graph) 26 11 [a bb]))
          product (require (b/emit! (mut graph) 28 11 [sum three]))
          difference (require (b/emit! (mut graph) 27 11 [product a]))
          ret (require (b/emit! (mut graph) 120 11 [start difference (: 0 i32)]))]
      (match (compile/text graph start [ret] allocator)
        (Err [msg] (do (println "arith: {}" msg) (set! failures (+ failures 1))))
        (Ok [text]
            (let [(mut bytes) text]
              (match (fs/write-file allocator "build/x64-core-smoke-arith.bin" (slice bytes))
                (Err [_] 0) (Ok [_] 0))
              (target/arch-pick
                0
                (for [x -3 4]
                  (for [y -3 4]
                    (when (!= (run2 (slice bytes) x y) (- (* (+ x y) 3) x))
                      (set! failures (+ failures 1))))))
              (free! (mut bytes)))))
      (g/release! (mut graph)))
    (let [(mut graph) (g/create allocator)
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          limit (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          entry (require (b/emit! (mut graph) 114 0 [start]))
          loop (require (b/loop-begin! (mut graph) entry))
          zero (require (b/scalar-constant! (mut graph) 11 0 8))
          one (require (b/scalar-constant! (mut graph) 11 1 8))
          index (require (b/loop-phi! (mut graph) loop zero))
          sum (require (b/loop-phi! (mut graph) loop zero))
          condition (require (b/emit! (mut graph) 16 1 [index limit]))
          split (require (b/emit! (mut graph) 116 0 [loop condition]))
          body (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
          exit (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
          next-index (require (b/emit! (mut graph) 26 11 [index one]))
          next-sum (require (b/emit! (mut graph) 26 11 [sum index]))
          back (require (b/emit! (mut graph) 115 0 [body]))
          ret (require (b/emit! (mut graph) 120 11 [exit sum (: 0 i32)]))]
      (b/patch! (mut graph) loop 2 back)
      (b/patch! (mut graph) index 3 next-index)
      (b/patch! (mut graph) sum 3 next-sum)
      (match (compile/text graph start [ret] allocator)
        (Err [msg] (do (println "loop: {}" msg) (set! failures (+ failures 1))))
        (Ok [text]
            (let [(mut bytes) text]
              (match (fs/write-file allocator "build/x64-core-smoke-loop.bin" (slice bytes))
                (Err [_] 0) (Ok [_] 0))
              (target/arch-pick
                0
                (for [n -5 101]
                  (when (!= (run2 (slice bytes) n 0) (if (< n 0) 0 (/ (* n (- n 1)) 2)))
                    (set! failures (+ failures 1)))))
              (free! (mut bytes)))))
      (g/release! (mut graph)))
    (println "x64 core smoke checks: {} failures" failures)
    (if (= failures 0) 0 1)))
