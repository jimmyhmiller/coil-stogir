(module stogir.tests.jit-parameter-specialize)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.call-inline" :as inlining)
(import "stogir.parameter-specialize" :as specialize)
(import "stogir.native.compile" :as compile)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Option Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [x] x) (Err [message] (panic "{}" message))))

(defn reject [(result (Result specialize/Specialized (slice u8)))] (-> void)
  (match result
    (Err [_] 0)
    (Ok [owned]
      (let [(mut owned) owned]
        (specialize/release! (mut owned))
        (panic "invalid specialization accepted")))))

(defn execute [(graph g/Graph) (roots (slice i32)) (bound u64)] (-> void)
  (let [a (malloc-allocator)]
    (match (compile/image graph 1 roots "_specialize_test" a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
        (let [(mut code) owned]
          (match (jit/map-image code a)
            (Err [message] (panic "{}" message))
            (Ok [loaded]
              (let [(mut loaded) loaded
                    f (p/cast (fnptr (cc/C) [u64 u64 (ptr u64)] bool) (.base (.memory loaded)))]
                (for x [(: 0 u64) 1 2 7 127 256 65536 0xFFFFFFFFFFFFFFFF]
                  (let [(mut out) [(: 42 u64) 123456]]
                    (assert (= (f x bound (p/cast (ptr u64) (mut out))) (and (= x bound) (= x 0))))
                    (assert (= (get out 0) (if (and (= x bound) (!= x 0)) (: 99 u64) 42)))
                    (assert (= (get out 1) 123456))))
                (assert (jit/release-image! (mut loaded))))))
          (image/release! (mut code)))))))

(defn execute-caller [(graph g/Graph) (roots (slice i32)) (bound u64) (zero-result bool)] (-> void)
  (let [a (malloc-allocator)]
    (match (compile/image graph 1 roots "_specialized_caller" a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
        (let [(mut code) owned]
          (match (jit/map-image code a)
            (Err [message] (panic "{}" message))
            (Ok [loaded]
              (let [(mut loaded) loaded
                    f (p/cast (fnptr (cc/C) [u64 (ptr u64)] bool) (.base (.memory loaded)))]
                (for [i 0 33]
                  (let [x (if (= i 32) bound (cast u64 i)) (mut out) (: 42 u64)]
                    (assert (= (f x (p/cast (ptr u64) (mut out)))
                               (and zero-result (= x 0) (= bound 0))))
                    (assert (= out (if (and (= x bound) (!= x 0)) (: 99 u64) 42)))))
                (assert (jit/release-image! (mut loaded))))))
          (image/release! (mut code)))))))

(defn reject-inline [(result (Result (Option rewrite/Rewritten) (slice u8)))] (-> void)
  (match result
    (Err [_] 0)
    (Ok [outcome]
      (match outcome
        (None [] (panic "invalid inline request accepted"))
        (Some [owned]
          (let [(mut owned) owned]
            (rewrite/release! (mut owned)) (panic "invalid inline request expanded")))))))

;;; Content digest of an expansion's graph; zero when nothing expanded.
(defn outcome-hash [(result (Result (Option rewrite/Rewritten) (slice u8)))] (-> u128)
  (match result
    (Err [message] (panic "{}" message))
    (Ok [outcome]
      (match outcome
        (None [] 0)
        (Some [owned]
          (let [(mut owned) owned
                hash (rewrite/content-hash (.graph owned) 8)]
            (assert (!= hash 0))
            (rewrite/release! (mut owned))
            hash))))))

(defn snapshot-of [(result (Result inlining/Snapshot (slice u8)))] (-> inlining/Snapshot)
  (match result (Err [message] (panic "{}" message)) (Ok [x] x)))

(defn handle-of [(result (Result i64 (slice u8)))] (-> i64)
  (match result (Err [message] (panic "{}" message)) (Ok [x] x)))

(defn refuse-handle [(result (Result i64 (slice u8)))] (-> void)
  (match result (Err [_] 0) (Ok [_] (panic "invalid adoption accepted"))))

;;; The read-only entry over a closed registry: REGISTRY has spent its creation
;;; attempts, HANDLE has contexts (one for ZERO, none for FRESH).
(defn closed-registry-checks [(registry (mut inlining/Registry)) (caller (mut g/Graph))
                              (start i32) (returned i32) (called i32) (handle i64)
                              (zero i32) (fresh i32) (target inlining/Callee)
                              (a (dyn Allocator))] (-> void)
  (let [policy (inlining/default-policy 128)
        none (inlining/Snapshot :state (p/cast (ptr u8) 0))
        registered (inlining/RegisteredSite :reference called :callee handle)
        frozen (inlining/FrozenSite :reference called :callee handle :snapshot none)]
    (assert (inlining/registry-closed? registry))
    ; Same graph as the registered entry, with a cached context and without.
    (for literal [zero fresh]
      (assert (g/set-operand! (mut caller) called 4 literal))
      (let [expected (outcome-hash (inlining/optimize-registered-specialized-policy
                                     registry caller start [returned] [registered] policy 0 a))]
        (assert (!= expected 0))
        (assert (= expected (outcome-hash (inlining/optimize-frozen-specialized-policy
                                            registry caller start [returned] [frozen] policy 0 a))))))
    (assert (= (inlining/specialization-count registry) 128))
    ; Invalid sites and budgets are refused as the registered entry refuses them.
    (reject-inline (inlining/optimize-frozen-specialized-policy registry caller start [returned]
                     [frozen frozen] policy 0 a))
    (reject-inline (inlining/optimize-frozen-specialized-policy registry caller start [999999]
                     [frozen] policy 0 a))
    (reject-inline (inlining/optimize-frozen-specialized-policy registry caller start [returned]
                     [(inlining/FrozenSite :reference called :callee 999999 :snapshot none)] policy 0 a))
    (reject-inline (inlining/optimize-frozen-specialized-policy registry caller start [returned]
                     [(inlining/FrozenSite :reference called :callee 0 :snapshot none)] policy 0 a))
    (reject-inline (inlining/optimize-frozen-specialized-policy registry caller start [returned]
                     [frozen] (inlining/default-policy -1) 0 a))
    (reject-inline (inlining/optimize-frozen-specialized-policy registry caller 0 [returned]
                     [frozen] policy 0 a))
    (assert (= (outcome-hash (inlining/optimize-frozen-specialized-policy
                               registry caller start [returned] [frozen]
                               (inlining/default-policy 0) 0 a)) 0))
    ; Settling answers what was not asked; a second pass finds nothing.
    (handle-of (inlining/registry-settle! (mut registry) a))
    (assert (= (handle-of (inlining/registry-settle! (mut registry) a)) 0))
    ; The read-only entry leaves the memo alone, the registered one fills it.
    (let [read (handle-of (inlining/register! (mut registry) target))
          written (handle-of (inlining/register! (mut registry) target))]
      (assert (g/set-operand! (mut caller) called 4 zero))
      (let [expected (outcome-hash (inlining/optimize-frozen-specialized-policy
                                     registry caller start [returned]
                                     [(inlining/FrozenSite :reference called :callee read :snapshot none)]
                                     policy 0 a))]
        (assert (!= expected 0))
        (assert (= expected (outcome-hash (inlining/optimize-registered-specialized-policy
                                            registry caller start [returned]
                                            [(inlining/RegisteredSite :reference called :callee written)]
                                            policy 0 a))))
        (assert (= (handle-of (inlining/registry-settle! (mut registry) a)) 1))
        ; A snapshot outside the registry is a callee registered after it closed.
        (let [owned (snapshot-of (inlining/snapshot-create target 0 8 a a))
              borrowed (snapshot-of (inlining/snapshot-borrow target 0 8 a a))
              narrow (snapshot-of (inlining/snapshot-create target 0 4 a a))]
          (for snapshot [owned borrowed]
            (assert (= expected (outcome-hash (inlining/optimize-frozen-specialized-policy
                                                registry caller start [returned]
                                                [(inlining/FrozenSite :reference called :callee 0
                                                                      :snapshot snapshot)]
                                                policy 0 a)))))
          (reject-inline (inlining/optimize-frozen-specialized-policy registry caller start [returned]
                           [(inlining/FrozenSite :reference called :callee 0 :snapshot narrow)]
                           policy 0 a))
          (refuse-handle (inlining/registry-adopt! (mut registry) borrowed))
          (refuse-handle (inlining/registry-adopt! (mut registry) narrow))
          (refuse-handle (inlining/registry-adopt! (mut registry) none))
          (let [adopted (handle-of (inlining/registry-adopt! (mut registry) owned))]
            (assert (= adopted (+ written 1)))
            (refuse-handle (inlining/registry-adopt! (mut registry) owned))
            ; Adopted with its answer: nothing is left to settle.
            (assert (= (handle-of (inlining/registry-settle! (mut registry) a)) 0))
            (assert (= expected (outcome-hash (inlining/optimize-registered-specialized-policy
                                                registry caller start [returned]
                                                [(inlining/RegisteredSite :reference called
                                                                          :callee adopted)]
                                                policy 0 a))))))))
    ; A bad callee is refused as a snapshot too.
    (match (inlining/snapshot-create
             (inlining/Callee :name (.name target) :graph (.graph target) :entry (.entry target)
                              :roots [999999] :observed [999999] :never false :always false
                              :sparse false)
             0 8 a a)
      (Err [_] 0)
      (Ok [_] (panic "invalid snapshot accepted")))))

(defn applied [(result (Result (Option rewrite/Rewritten) (slice u8)))
               (bound u64) (zero-result bool)] (-> void)
  (match result
    (Err [message] (panic "{}" message))
    (Ok [outcome]
      (match outcome
        (None [] (panic "expected expansion"))
        (Some [owned]
          (let [(mut owned) owned]
            (assert (= (.changes owned) 1))
            (execute-caller (.graph owned) (slice (.roots owned)) bound zero-result)
            (rewrite/release! (mut owned))))))))

(defn check-caller [(original g/Graph) (ret i32) (specialized specialize/Specialized)] (-> void)
  (let [a (malloc-allocator) (mut caller) (g/create a)
        start (require (b/emit! (mut caller) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut caller) 71 5 [start (: 0 i32) 0]))
        out (require (b/emit! (mut caller) 71 6 [start (: 0 i32) 1]))
        zero (require (b/scalar-constant! (mut caller) 5 0 8))
        one (require (b/scalar-constant! (mut caller) 5 1 8))
        function (require (symbols/function! (mut caller) "_parameter_case" 0))]
    (match (calls/create 0 1 [(: 5 u8) 5 6] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
        (let [(mut proto) owned
              called (require (calls/emit! (mut caller) proto start function [x zero out] a))
              returned (require (b/emit! (mut caller) 120 1 [called called (: 0 i32)]))
              original-target (inlining/Callee :name "_parameter_case" :graph original :entry 1
                                              :roots [ret] :observed [ret] :never false :always false :sparse false)
              body (.graph (.body specialized))
              roots (slice (.roots (.body specialized)))
              specialized-target (inlining/Callee :name "_parameter_case" :graph body :entry 1
                                                 :roots [(get roots 0)] :observed roots :never false :always false :sparse false)
              (mut old-min) (: -1 i32) (mut new-min) (: -1 i32)]
          (assert (specialize/bindings-match? specialized caller called 8))
          (assert (not (specialize/bindings-match? specialized caller start 8)))
          (assert (not (specialize/bindings-match? specialized caller called 4)))
          (for replacement [one x]
            (assert (g/set-operand! (mut caller) called 4 replacement))
            (assert (not (specialize/bindings-match? specialized caller called 8))))
          (assert (g/set-operand! (mut caller) called 4 zero))
          (for [budget 0 128]
            (when (and (< old-min 0)
                       (.common (inlining/inspect-verified-site caller [returned] called original-target 8 (cast i32 budget) a)))
              (set! old-min (cast i32 budget)))
            (when (and (< new-min 0)
                       (.common (inlining/inspect-verified-site caller [returned] called specialized-target 8 (cast i32 budget) a)))
              (set! new-min (cast i32 budget))))
          (println "exact preflight minimum: original {}, specialized {}" old-min new-min)
          (assert (and (> old-min 0) (> new-min 0) (< new-min old-min)))
          (match (inlining/optimize-sites-if-changed caller [returned]
                   [(inlining/Site :reference called :target original-target)] 8 new-min a)
            (Err [message] (panic "{}" message))
            (Ok [result]
              (match result (None [] 0)
                (Some [owned]
                  (let [(mut owned) owned]
                    (rewrite/release! (mut owned))
                    (panic "unspecialized target unexpectedly fit"))))))
          (match (inlining/optimize-sites-if-changed caller [returned]
                   [(inlining/Site :reference called :target specialized-target)] 8 new-min a)
            (Err [message] (panic "{}" message))
            (Ok [result]
              (match result
                (None [] (panic "specialized call did not fit its exact budget"))
                (Some [owned]
                  (let [(mut rewritten) owned]
                    (assert (= (.changes rewritten) 1))
                    (execute-caller (.graph rewritten) (slice (.roots rewritten)) 0 true)
                    (rewrite/release! (mut rewritten)))))))
          (let [(mut registry) (inlining/registry-create 8 a)
                handle (match (inlining/register! (mut registry) original-target)
                         (Err [message] (panic "{}" message) (: 0 i64)) (Ok [x] x))
                site (inlining/RegisteredSite :reference called :callee handle)]
            (match (inlining/optimize-registered-specialized-if-changed registry caller start [returned] [site] 0 a)
              (Err [message] (panic "{}" message))
              (Ok [outcome] (match outcome (None [] 0)
                (Some [owned] (let [(mut owned) owned] (rewrite/release! (mut owned))
                                    (panic "zero-budget request expanded"))))))
            (reject-inline (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                            [site site] new-min a))
            (reject-inline (inlining/optimize-registered-specialized-if-changed registry caller start [999999]
                            [site] new-min a))
            (reject-inline (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                            [(inlining/RegisteredSite :reference called :callee 999999)] new-min a))
            (reject-inline (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                            [site] -1 a))
            (assert (= (inlining/specialization-count registry) 0))
            ; An open registry has no read-only entry: its cache can still change.
            (assert (not (inlining/registry-closed? registry)))
            (reject-inline (inlining/optimize-frozen-specialized-policy registry caller start [returned]
                            [(inlining/FrozenSite :reference called :callee handle
                                                  :snapshot (inlining/Snapshot :state (p/cast (ptr u8) 0)))]
                            (inlining/default-policy 128) 0 a))
            ; All actuals dynamic: use ordinary expansion, create no context.
            (assert (g/set-operand! (mut caller) called 4 x))
            (match (inlining/optimize-registered-specialized-if-changed registry caller start [returned] [site] 128 a)
              (Err [message] (panic "{}" message))
              (Ok [outcome]
                (match outcome
                  (None [] (panic "dynamic call lost ordinary expansion"))
                  (Some [owned]
                    (let [(mut owned) owned]
                      (assert (= (.changes owned) 1))
                      (rewrite/release! (mut owned)))))))
            (assert (= (inlining/specialization-count registry) 0))
            (assert (g/set-operand! (mut caller) called 4 zero))
            (for [turn 0 3]
              (match (inlining/optimize-registered-specialized-if-changed registry caller start [returned] [site] new-min a)
                (Err [message] (panic "{}" message))
                (Ok [result]
                  (match result
                    (None [] (panic "cached specialization missed expansion"))
                    (Some [owned]
                      (let [(mut owned) owned]
                        (execute-caller (.graph owned) (slice (.roots owned)) 0 true)
                        (rewrite/release! (mut owned)))))))
              (assert (= (inlining/specialization-count registry) 1)))
            (assert (g/set-operand! (mut caller) called 4 one))
            (match (inlining/optimize-registered-specialized-if-changed registry caller start [returned] [site] 128 a)
              (Err [message] (panic "{}" message))
              (Ok [result]
                (match result (None [] (panic "changed argument did not expand"))
                  (Some [owned]
                    (let [(mut owned) owned]
                      (execute-caller (.graph owned) (slice (.roots owned)) 1 true)
                      (rewrite/release! (mut owned)))))))
            (assert (= (inlining/specialization-count registry) 2))
            (assert (g/set-operand! (mut caller) called 4 zero))
            (let [(mut variant) (g/duplicate original a)
                  no (require (b/scalar-constant! (mut variant) 1 0 8))]
              (assert (g/set-operand! (mut variant) ret 2 no))
              (let [handle2
                      (match (inlining/register! (mut registry)
                        (inlining/Callee :name "_parameter_case" :graph variant :entry 1
                                         :roots [ret] :observed [ret] :never false :always false :sparse false))
                        (Err [message] (panic "{}" message) (: 0 i64)) (Ok [x] x))]
                (g/release! (mut variant))
                ; This is a different body and need not have the first body's
                ; exact clone cost. Find its own minimum while checking that
                ; the registry selects the changed result, not the old cache.
                (let [(mut variant-min) (: -1 i32)]
                  (for [budget 0 128]
                    (when (< variant-min 0)
                      (match (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                               [(inlining/RegisteredSite :reference called :callee handle2)] (cast i32 budget) a)
                        (Err [message] (panic "{}" message))
                        (Ok [outcome]
                          (match outcome
                            (None [] 0)
                            (Some [owned]
                              (let [(mut owned) owned]
                                (set! variant-min (cast i32 budget))
                                (assert (= (.changes owned) 1))
                                (execute-caller (.graph owned) (slice (.roots owned)) 0 false)
                                (rewrite/release! (mut owned)))))))))
                  (assert (> variant-min 0))
                  (println "changed-body exact minimum: {}" variant-min))
                (assert (= (inlining/specialization-count registry) 3))))
            (applied (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                       [site] new-min a) 0 true)
            (for [bits 2 132]
              (let [literal (require (b/scalar-constant! (mut caller) 5 (cast u64 bits) 8))]
                (assert (g/set-operand! (mut caller) called 4 literal))
                (match (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                         [site] 128 a)
                  (Err [message] (panic "{}" message))
                  (Ok [outcome]
                    (match outcome (None [] (panic "resource fallback missed ordinary inline"))
                      (Some [owned] (let [(mut owned) owned] (rewrite/release! (mut owned)))))))))
            (assert (= (inlining/specialization-count registry) 128))
            (applied (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                       [site] 128 a) 131 true)
            (assert (g/set-operand! (mut caller) called 4 zero))
            (applied (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                       [site] new-min a) 0 true)
            (assert (= (inlining/specialization-count registry) 128))
            (let [fresh (require (b/scalar-constant! (mut caller) 5 131 8))]
              (closed-registry-checks (mut registry) (mut caller) start returned called handle
                                      zero fresh original-target a))
            (inlining/registry-release! (mut registry))
            (assert (= (inlining/specialization-count registry) 0)))
          (let [(mut registry) (inlining/registry-create 8 a)
                handle (match (inlining/register! (mut registry) original-target)
                         (Err [message] (panic "{}" message) (: 0 i64)) (Ok [x] x))
                (mut batch) (g/duplicate caller a)
                (mut sites) (ArrayList::new [inlining/RegisteredSite] a)
                (mut control) called]
            (push! (mut sites) (inlining/RegisteredSite :reference called :callee handle))
            (for [i 1 9]
              (let [literal (require (b/scalar-constant! (mut batch) 5 (cast u64 i) 8))
                    next (require (calls/emit! (mut batch) proto control function [x literal out] a))]
                (push! (mut sites) (inlining/RegisteredSite :reference next :callee handle))
                (set! control next)))
            (assert (g/set-operand! (mut batch) returned 1 control))
            (assert (g/set-operand! (mut batch) returned 2 control))
            (let [before (len (.instructions batch))]
              (match (inlining/optimize-registered-specialized-if-changed registry batch start [returned]
                       (slice sites) new-min a)
                (Err [message] (panic "{}" message))
                (Ok [outcome]
                  (match outcome (None [] (panic "batch specialization missed expansion"))
                    (Some [owned]
                      (let [(mut owned) owned (mut count) 0 (mut r) (: 1 i64)
                            body (.graph owned)]
                        (assert (= (.changes owned) 1))
                        (assert (= (- (len (.instructions body)) before) (cast i64 new-min)))
                        (while (< r (len (.instructions body)))
                          (when (= (n/opcode (get (.instructions body) r)) 79) (set! count (+ count 1)))
                          (set! r (+ r (/ (+ (cast i64 (get (.arities body) r)) 4) 4))))
                        (assert (= count 8))
                        (rewrite/release! (mut owned))))))))
            (assert (= (inlining/specialization-count registry) 9))
            (inlining/registry-release! (mut registry))
            (free! (mut sites)) (g/release! (mut batch)))
          (let [(mut registry) (inlining/registry-create 8 a)
                never-target (inlining/Callee :name "_parameter_case" :graph original :entry 1
                                             :roots [ret] :observed [ret] :never true :always false :sparse false)
                handle (match (inlining/register! (mut registry) never-target)
                         (Err [message] (panic "{}" message) (: 0 i64)) (Ok [x] x))]
            (match (inlining/optimize-registered-specialized-if-changed registry caller start [returned]
                     [(inlining/RegisteredSite :reference called :callee handle)] 128 a)
              (Err [message] (panic "{}" message))
              (Ok [outcome] (match outcome (None [] 0)
                (Some [owned] (let [(mut owned) owned] (rewrite/release! (mut owned)) (panic "Never expanded"))))))
            (assert (= (inlining/specialization-count registry) 0))
            (inlining/registry-release! (mut registry)))
          (calls/release! (mut proto)))))
    (g/release! (mut caller))))

(defn main [] (-> i64)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 1]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        zero (require (b/scalar-constant! (mut graph) 5 0 8))
        yes (require (b/scalar-constant! (mut graph) 1 1 8))
        no (require (b/scalar-constant! (mut graph) 1 0 8))
        literal (require (b/scalar-constant! (mut graph) 5 99 8))
        unequal (require (b/emit! (mut graph) 15 1 [x y]))
        first (require (b/emit! (mut graph) 116 0 [start unequal]))
        different (require (b/emit! (mut graph) 107 0 [first (: 0 i32)]))
        equal (require (b/emit! (mut graph) 108 0 [first (: 0 i32)]))
        first-end (require (b/emit! (mut graph) 114 0 [different]))
        empty (require (b/emit! (mut graph) 14 1 [x zero]))
        second (require (b/emit! (mut graph) 116 0 [equal empty]))
        empty-path (require (b/emit! (mut graph) 107 0 [second (: 0 i32)]))
        full-path (require (b/emit! (mut graph) 108 0 [second (: 0 i32)]))
        stored (require (b/emit! (mut graph) 93 0 [full-path output literal]))
        empty-end (require (b/emit! (mut graph) 114 0 [empty-path]))
        full-end (require (b/emit! (mut graph) 114 0 [stored]))
        inner (require (b/emit! (mut graph) 112 0 [empty-end full-end]))
        inner-value (require (b/emit! (mut graph) 67 1 [inner yes no]))
        inner-end (require (b/emit! (mut graph) 114 0 [inner]))
        outer (require (b/emit! (mut graph) 112 0 [first-end inner-end]))
        value (require (b/emit! (mut graph) 67 1 [outer no inner-value]))
        ret (require (b/emit! (mut graph) 120 1 [outer value (: 0 i32)]))]
    (match (calls/create 0 1 [(: 5 u8) 5 6] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
        (let [(mut proto) owned]
          (require (calls/function! (mut graph) proto a))
          (calls/release! (mut proto)))))
    (reject (specialize/specialize graph [ret] [] 8 a))
    (for parameter [(: -1 i32) 0 ret 999999]
      (reject (specialize/specialize graph [ret] [(specialize/Binding :parameter parameter :bits 0)] 8 a)))
    (reject (specialize/specialize graph [ret]
              [(specialize/Binding :parameter y :bits 0) (specialize/Binding :parameter y :bits 1)] 8 a))
    (reject (specialize/specialize graph [999999] [(specialize/Binding :parameter y :bits 0)] 8 a))
    (reject (specialize/specialize graph [ret] [(specialize/Binding :parameter y :bits 0)] 3 a))
    (set! (mut (.arities graph)) (cast i64 y) 2)
    (reject (specialize/specialize graph [ret] [(specialize/Binding :parameter y :bits 0)] 8 a))
    (set! (mut (.arities graph)) (cast i64 y) 3)
    (reject (specialize/specialize graph [ret] [(specialize/Binding :parameter output :bits 0x100000000)] 4 a))
    (execute graph [ret] 0)
    (execute graph [ret] 1)
    (execute graph [ret] 7)
    (match (specialize/specialize graph [ret first-end empty-end full-end inner-end]
             [(specialize/Binding :parameter y :bits 0)] 8 a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
        (let [(mut specialized) owned body (.graph (.body specialized))
              (mut stores) 0 (mut active) 0 (mut r) (: 1 i64)]
          (assert (= (len (.conditions specialized)) 1))
          (assert (= (.ordinal (get (.conditions specialized) 0)) 1))
          (assert (= (n/opcode (get (.instructions graph) (cast i64 y))) 71))
          (while (< r (len (.instructions body)))
            (let [opcode (n/opcode (get (.instructions body) r))]
              (when (= opcode 93) (set! stores (+ stores 1)))
              (when (!= opcode 0) (set! active (+ active 1))))
            (set! r (+ r (/ (+ (cast i64 (get (.arities body) r)) 4) 4))))
          (println "specialized graph: {} active nodes, {} stores" active stores)
          (assert (= stores 0))
          (execute body (slice (.roots (.body specialized))) 0)
          (check-caller graph ret specialized)
          (specialize/release! (mut specialized)))))
    (g/release! (mut graph))
    (println "parameter specialization native checks: passed")
    0))
