(module stogir.tests.division-guards)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as verify)
(import "stogir.pipeline" :as pipeline)
(import "stogir.schedule" :as schedule)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        a (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        divisor (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        condition (require (b/emit! (mut graph) 15 1 [divisor zero]))
        split (require (b/emit! (mut graph) 116 0 [start condition]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        quotient
          (require (b/integer-division! (mut graph) 29 11 8 a divisor yes))
        same (require (b/integer-division! (mut graph) 29 11 8 a divisor yes))
        other (require (b/integer-division! (mut graph) 29 11 8 a divisor no))
        unguarded (require (b/integer-binary! (mut graph) 29 11 8 a divisor))
        ret (require (b/emit! (mut graph) 120 11 [yes quotient (: 0 i32)]))
        fallback (require (b/emit! (mut graph) 120 11 [no zero (: 0 i32)]))
        (mut failures) 0]
    (when (or (= quotient 0)
              (!= quotient same)
              (= quotient other)
              (= quotient unguarded))
      (set! failures (+ failures 1)))
    (match (b/integer-division! (mut graph) 29 11 8 a divisor divisor)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (b/integer-division! (mut graph) 29 11 8 a divisor zero)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (verify/integer-operations graph)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [_] 0))
    (match (pipeline/prepare graph start [ret fallback] allocator)
      (Err [msg]
           (do (println "prepare: {}" msg) (set! failures (+ failures 1))))
      (Ok [prepared]
          (let [(mut owned) prepared
                (mut found?) false
                range (get (.ranges (.schedule owned)) (cast i64 yes))
                (mut i) 0]
            (while (< i (.count range))
              (when (= (get (.nodes (.schedule owned)) (+ (.offset range) i))
                       quotient)
                (set! found? true))
              (set! i (+ i 1)))
            (when (not found?) (set! failures (+ failures 1)))
            (pipeline/release! (mut owned)))))
    ;; Raw graph construction cannot bypass the semantic guard check.
    (require (b/emit! (mut graph) 30 11 [a divisor divisor]))
    (match (verify/integer-operations graph)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    (println "division guard/CSE/placement checks: {} failures" failures)
    (if (= failures 0) 0 1)))
