(module stogir.tests.jit-subsumed-guard)
;;; A range guard before a literal bit-set membership test,
;;;     n = x & R ;  if (n OP C) and ((M & (1 << n)) != 0) then 11 else 20
;;; folds away when the bit test alone decides the same for every n in
;;; [0, R]: R below the type's width and M clear wherever the guard fails.
;;; Every case runs natively for all x in 0..255 and boundary values against
;;; the two tests evaluated separately. A folded function keeps at most one
;;; conditional branch; one that must keep its guard has two tests (branches
;;; or conditional comparisons). In the `split` form the guard's failing exit
;;; carries a different PHI input (30) than the bit test's, so the guard stays
;;; whenever it can fail.
(import "stogir.graph" :as g)
(import "stogir.target" :as target)
(import "stogir.builder" :as b)
(import "stogir.native.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(defn need [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

(defn word [(text (ArrayList u8)) (at i64)] (-> u32)
  (| (cast u32 (get text at))
     (<< (cast u32 (get text (+ at 1))) 8)
     (<< (cast u32 (get text (+ at 2))) 16)
     (<< (cast u32 (get text (+ at 3))) 24)))

;;; B.cond, CBZ/CBNZ, TBZ/TBNZ and CCMP/CCMN words.
(defn tests [(text (ArrayList u8))] (-> i64)
  (let [(mut found) (: 0 i64) (mut at) (: 0 i64)]
    (while (< (+ at 3) (len text))
      (let [w (word text at)]
        (when (or (= (& w (: 0xFF000010 u32)) (: 0x54000000 u32))
                  (= (& w (: 0x7E000000 u32)) (: 0x34000000 u32))
                  (= (& w (: 0x7E000000 u32)) (: 0x36000000 u32))
                  (= (& w (: 0x3FE00410 u32)) (: 0x3A400000 u32)))
          (set! found (+ found 1))))
      (set! at (+ at 4)))
    found))

(defn wide? [(ty i32)] (-> bool) (= ty 5))

;;; (k OP c) for small non-negative k and c.
(defn holds? [(opcode i32) (k u64) (c u64)] (-> bool)
  (cond (= opcode 14) (= k c) (= opcode 15) (!= k c)
        (or (= opcode 16) (= opcode 20)) (< k c)
        (or (= opcode 17) (= opcode 21)) (>= k c)
        (or (= opcode 18) (= opcode 22)) (<= k c)
        :else (> k c)))

;;; Bit n of M as SHL in the type computes it: the count is reduced to the width.
(defn member? [(ty i32) (mask u64) (n u64)] (-> bool)
  (let [width (if (wide? ty) (: 64 u64) 32)
        m (if (wide? ty) mask (& mask 0xFFFFFFFF))]
    (!= (& (>> m (% n width)) 1) 0)))

(defstruct Tally [(folded i64) (answers i64) (failures i64)])

(defn check [(ty i32) (range u64) (opcode i32) (bound u64) (mask u64) (split bool)
             (tally (mut Tally))] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (need (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (need (b/emit! (mut graph) 71 ty [start (: 0 i32) 0]))
        limit (need (b/scalar-constant! (mut graph) ty range 8))
        n (need (b/emit! (mut graph) 47 ty [x limit]))
        c (need (b/scalar-constant! (mut graph) ty bound 8))
        one (need (b/scalar-constant! (mut graph) ty 1 8))
        zero (need (b/scalar-constant! (mut graph) ty 0 8))
        m (need (b/scalar-constant! (mut graph) ty (if (wide? ty) mask (& mask 0xFFFFFFFF)) 8))
        k11 (need (b/scalar-constant! (mut graph) 5 11 8))
        k20 (need (b/scalar-constant! (mut graph) 5 20 8))
        k30 (need (b/scalar-constant! (mut graph) 5 30 8))
        c1 (need (b/emit! (mut graph) opcode 1 [n c]))
        if1 (need (b/emit! (mut graph) 116 0 [start c1]))
        t1 (need (b/emit! (mut graph) 107 0 [if1 (: 0 i32)]))
        f1 (need (b/emit! (mut graph) 108 0 [if1 (: 0 i32)]))
        bit (need (b/emit! (mut graph) 49 ty [one n]))
        masked (need (b/emit! (mut graph) 47 ty [bit m]))
        c2 (need (b/emit! (mut graph) 15 1 [masked zero]))
        if2 (need (b/emit! (mut graph) 116 0 [t1 c2]))
        t2 (need (b/emit! (mut graph) 107 0 [if2 (: 0 i32)]))
        f2 (need (b/emit! (mut graph) 108 0 [if2 (: 0 i32)]))
        e1 (need (b/emit! (mut graph) 114 0 [f1]))
        e2 (need (b/emit! (mut graph) 114 0 [f2]))
        meet (need (b/emit! (mut graph) 112 0 [e1 e2]))
        missed (if split (need (b/emit! (mut graph) 67 5 [meet k30 k20])) k20)
        r1 (need (b/emit! (mut graph) 120 5 [meet missed (: 0 i32)]))
        r2 (need (b/emit! (mut graph) 120 5 [t2 k11 r1]))
        (mut roots) (ArrayList::new [i32] a)
        width (if (wide? ty) (: 64 u64) 32)
        ; The guard can fail somewhere in [0, range], and wherever it does the
        ; bit is clear.
        (mut fails) false
        (mut passes) false
        (mut covered) (< range width)]
    (for [k 0 (cast i64 (+ range 1))]
      (when (holds? opcode (cast u64 k) bound) (set! passes true))
      (unless (holds? opcode (cast u64 k) bound)
        (set! fails true)
        (when (member? ty mask (cast u64 k)) (set! covered false))))
    (push! (mut roots) r1) (push! (mut roots) r2)
    (match (compile/vector-image graph start (slice roots) "_subsumed_guard" a)
      (Err [e] (panic "subsumed-guard {} {} {} {} {:x}: {}" ty range opcode bound mask e))
      (Ok [value]
        (let [(mut code) value
              found (tests (.text code))
              folds (or (not fails) (and covered (not split)))]
          (when folds (set! (.folded tally) (+ (.folded tally) 1)))
          ; A guard that never passes within the range decides everything itself.
          (target/arch-pick (when (and passes (if folds (> found 1) (< found 2)))
            (println "ty {} range {} op {} bound {} mask {:x} split {}: {} tests, fold expected {}"
                     ty range opcode bound mask split found folds)
            (set! (.failures tally) (+ (.failures tally) 1))) (do))
          (match (jit/map-image code a)
            (Err [e] (panic "{}" e))
            (Ok [mapped]
              (let [(mut loaded) mapped
                    f (p/cast (fnptr (cc/C) [u64] u64) (.base (.memory loaded)))]
                (for [i 0 264]
                  (let [xv (cond (< i 256) (cast u64 i)
                                 (= i 256) 0x7FFFFFFF (= i 257) 0x80000000
                                 (= i 258) 0xFFFFFFFF (= i 259) 0x100000000
                                 (= i 260) 0x7FFFFFFFFFFFFFFF (= i 261) 0x8000000000000000
                                 (= i 262) 0xFFFFFFFFFFFFFF0F :else 0xFFFFFFFFFFFFFFFF)
                        nv (& xv range)
                        guard (holds? opcode nv bound)
                        want (if (and guard (member? ty mask nv)) (: 11 u64)
                                 (if (and split (not guard)) 30 20))
                        got (f xv)]
                    (set! (.answers tally) (+ (.answers tally) 1))
                    (when (!= got want)
                      (println "ty {} range {} op {} bound {} mask {:x} split {} x {:x}: got {} want {}"
                               ty range opcode bound mask split xv got want)
                      (set! (.failures tally) (+ (.failures tally) 1)))))
                (jit/release-image! (mut loaded)))))
          (image/release! (mut code)))))
    (free! (mut roots)) (g/release! (mut graph))))

(defn main [] (-> i32)
  (let [(mut tally) (Tally :folded 0 :answers 0 :failures 0)]
    (for ty [(: 4 i32) 5]
      (for range [(: 15 u64) 31 63 127]
        (for opcode [(: 20 i32) 16 22 18 15 21 19]
          (for bound [(: 15 u64) 16 8]
            (for mask [(: 24092 u64) 0x8000 0xFFFF 0x7FFF 0x80000000 0x10000000000 0x8000000000008100]
              (when (or (wide? ty) (!= (& mask 0xFFFFFFFF) 0))
                (check ty range opcode bound mask false (mut tally))
                (check ty range opcode bound mask true (mut tally))))))))
    (println "subsumed guards: {} folded, {} native answers, {} failures"
             (.folded tally) (.answers tally) (.failures tally))
    (if (and (= (.failures tally) 0) (> (.folded tally) 0)) 0 1)))
