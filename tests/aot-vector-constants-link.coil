(defn constant-byte [(index i32) (position i32)] (-> u8)
  (let [word
          (match (% (+ index (/ position 8)) 7)
            (0 (: 0 u64))
            (1 0x8000000000000000)
            (2 0x7FF0000000000000)
            (3 0x7FF8123456789ABC)
            (4 0xFFFFFFFFFFFFFFFF)
            (5 0x7FC123457F800000)
            (_ 0x0123456789ABCDEF))
        mix (if (< index 7) (: 0 u64) (cast u64 index))]
    (cast u8 (>> (^ word mix) (cast u64 (* (% position 8) 8))))))

(defn exercise [(width i32) (mode i32) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] u64) address)
        target
          (p/cast u64
                  (p/cast (ptr u8)
                          (: (fnptr-of probe) (fnptr (cc/C) [(ptr u8)] u64))))
        n (if (= mode 3) (: 320 i32) (if (= mode 2) 40 (if (= mode 1) 1 8)))
        repeat (if (= mode 3) (+ (* n width) 64) (if (= mode 2) 1024 256))
        total (cast i64 (+ repeat (* n width) 32))
        (mut output) (ArrayList::new [u8] allocator)
        (mut input) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i64)
        (mut failures) 0]
    (while (< i 64) (push! (mut input) 92) (set! i (+ i 1)))
    (for count [(: 0 u64) 1 2 3 7]
      (when (or (!= mode 3) (= count 0))
        (clear! (mut output))
        (set! i 0)
        (while (< i total) (push! (mut output) 165) (set! i (+ i 1)))
        (let [got
                (call-ptr f
                          (p/cast u64 (p/index (.data output) 3))
                          (p/cast u64 (p/index (.data input) 5))
                          count
                          target)
              wanted (if (= mode 2) (: 811 u64) 0)]
          (when (!= got wanted)
            (println "constant width{} mode{} count{} return{} expected{}"
                     width
                     mode
                     count
                     got
                     wanted)
            (set! failures (+ failures 1))))
        (set! i 0)
        (while (< i (len input))
          (when (!= (get input i) 92) (set! failures (+ failures 1)))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i total)
          (let [position (- i 3)
                first?
                  (and (>= position 0)
                       (< position (* (cast i64 n) (cast i64 width))))
                repeated?
                  (and (!= mode 1)
                       (>= position (cast i64 repeat))
                       (< position (cast i64 (+ repeat (* n width)))))
                offset (if first? position (- position (cast i64 repeat)))
                index (cast i32 (/ offset (cast i64 width)))
                chosen
                  (if first?
                      (if (= mode 1)
                          (if (= count 0) 0 7)
                          (if (and (= mode 2) (!= (% count 2) 0))
                              (^ index 1)
                              index))
                      index)
                byte
                  (if (or first? repeated?)
                      (constant-byte chosen
                                     (cast i32 (% offset (cast i64 width))))
                      (: 165 u8))]
            (when (!= (get output i) byte)
              (println "constant width{} mode{} count{} byte{} got{} expected{}"
                       width
                       mode
                       count
                       i
                       (get output i)
                       byte)
              (set! failures (+ failures 1))))
          (set! i (+ i 1)))))
    (free! (mut input))
    (free! (mut output))
    failures))

