(defn address [(ty i32) (mode i32)] (-> (ptr u8))
  (match ty
    (21 (match mode
          (0 (p/cast (ptr u8)
                     (: (fnptr-of constant21_0)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (1 (p/cast (ptr u8)
                     (: (fnptr-of constant21_1)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (2 (p/cast (ptr u8)
                     (: (fnptr-of constant21_2)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (_ (p/cast (ptr u8) (: 0 u64)))))
    (37 (match mode
          (0 (p/cast (ptr u8)
                     (: (fnptr-of constant37_0)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (1 (p/cast (ptr u8)
                     (: (fnptr-of constant37_1)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (2 (p/cast (ptr u8)
                     (: (fnptr-of constant37_2)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (3 (p/cast (ptr u8)
                     (: (fnptr-of constant37_3)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (_ (p/cast (ptr u8) (: 0 u64)))))
    (45 (match mode
          (0 (p/cast (ptr u8)
                     (: (fnptr-of constant45_0)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (1 (p/cast (ptr u8)
                     (: (fnptr-of constant45_1)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (2 (p/cast (ptr u8)
                     (: (fnptr-of constant45_2)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (_ (p/cast (ptr u8) (: 0 u64)))))
    (61 (match mode
          (0 (p/cast (ptr u8)
                     (: (fnptr-of constant61_0)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (1 (p/cast (ptr u8)
                     (: (fnptr-of constant61_1)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (2 (p/cast (ptr u8)
                     (: (fnptr-of constant61_2)
                        (fnptr (cc/C) [u64 u64 u64 u64] u64))))
          (_ (p/cast (ptr u8) (: 0 u64)))))
    (_ (p/cast (ptr u8) (: 0 u64)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for ty [(: 21 i32) 37 45 61]
      (let [width (if (or (= ty 21) (= ty 45)) (: 8 i32) 16)]
        (for mode [(: 0 i32) 1 2]
          (set! failures (+ failures (exercise width mode (address ty mode)))))))
    (set! failures (+ failures (exercise 16 3 (address 37 3))))
    (println "linked full vector constants, Phi/call/spill paths and cross-page data pools: {} failures"
             failures)
    (if (= failures 0) 0 1)))
