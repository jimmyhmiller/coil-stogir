(defn generate [(ty i32) (opcode i32) (mode i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        a (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        b (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        p (require (b/vector-load! (mut graph) ty 8 start a true))
        q (require (b/vector-load! (mut graph) ty 8 p b true))
        (mut left-bytes) (ArrayList::new [u8] allocator)
        (mut right-bytes) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i32)
        (mut failures) 0
        width (types/size ty 8)
        base (types/base-type ty)]
    (while (< i width)
      (push! (mut left-bytes) (literal-byte base (cast i64 i) false mode))
      (push! (mut right-bytes) (literal-byte base (cast i64 i) true mode))
      (set! i (+ i 1)))
    (let [left
            (if (or (= mode 1) (= mode 3) (>= mode 5))
                (require (b/vector-constant! (mut graph)
                                             ty
                                             8
                                             (slice left-bytes)))
                p)
          right
            (if (= mode 4)
                left
                (if (or (= mode 2) (= mode 3) (>= mode 5))
                    (require (b/vector-constant! (mut graph)
                                                 ty
                                                 8
                                                 (slice right-bytes)))
                    q))
          result
            (require (b/vector-binary! (mut graph)
                                       opcode
                                       ty
                                       left
                                       right
                                       (if (or (= opcode 29) (= opcode 30))
                                           start
                                           (: 0 i32))))
          (mut control)
            (require (b/vector-store! (mut graph) 8 q output result true))]
      (when (!= mode 4)
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph) output 24)
                                        left
                                        true)))
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph) output 48)
                                        right
                                        true))))
      (let [ret (require (b/emit! (mut graph) 120 0 [control (: 0 i32) 0]))
            id (fixture-id ty opcode mode)]
        (when (>= id 0)
          (match (compile/object graph start [ret] (fixture-name id) allocator)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [object]
                (let [(mut object) object]
                  (match (fs/write-file allocator
                                        (fixture-path id)
                                        (slice object))
                    (Err [_] (set! failures (+ failures 1)))
                    (Ok [_] 0))
                  (free! (mut object))))))
        (match (compile/image graph
                              start
                              [ret]
                              "_vector_arithmetic_jit"
                              allocator)
          (Err [message]
               (println "ty{} op{} mode{}: {}" ty opcode mode message)
               (set! failures (+ failures 1)))
          (Ok [source]
              (let [(mut source) source]
                (match (jit/map-image source allocator)
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [loaded]
                      (let [(mut loaded) loaded]
                        (set! failures
                              (+ failures
                                 (exercise ty
                                           opcode
                                           mode
                                           (.base (.memory loaded)))))
                        (jit/release-image! (mut loaded)))))
                (image/release! (mut source)))))))
    (free! (mut left-bytes))
    (free! (mut right-bytes))
    (g/release! (mut graph))
    failures))

(import "stogir.calls" :as calls)

(defn pressure [(ty i32) (opcode i32) (alignment i32) (id i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        guard (require (b/variable! (mut graph) 5 start "guard" alignment))
        sentinel (require (b/scalar-constant! (mut graph) 5 321 8))
        moving (require (b/scalar-constant! (mut graph) 5 317 8))
        size (require (b/scalar-constant! (mut graph) 5 73 8))
        guarded (require (b/emit! (mut graph) 87 0 [start guard sentinel]))
        dynamic (require (b/stack-allocate! (mut graph) guarded size alignment))
        (mut control)
          (require (b/emit! (mut graph) 93 0 [dynamic dynamic moving]))
        width (types/size ty 8)
        base (types/base-type ty)
        (mut inputs) (ArrayList::new [i32] allocator)
        (mut results) (ArrayList::new [i32] allocator)
        (mut payload) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i 40)
      (clear! (mut payload))
      (let [(mut j) (: 0 i32)]
        (while (< j width)
          (push! (mut payload)
                 (input-byte base (cast i64 (+ (* i width) j)) 0 true))
          (set! j (+ j 1))))
      (let [loaded
              (require (b/vector-load! (mut graph)
                                       ty
                                       8
                                       control
                                       (address! (mut graph) input (* i width))
                                       true))
            constant
              (require (b/vector-constant! (mut graph) ty 8 (slice payload)))
            result
              (require (b/vector-binary! (mut graph)
                                         opcode
                                         ty
                                         loaded
                                         constant
                                         (if (or (= opcode 29) (= opcode 30))
                                             start
                                             (: 0 i32))))
            storage (require (b/variable! (mut graph) ty start "computed" 0))]
        (push! (mut inputs) loaded)
        (push! (mut results) result)
        ; The volatile store keeps the arithmetic before the clobbering call.
        (set! control
              (require (b/emit! (mut graph) 88 0 [loaded storage result]))))
      (set! i (+ i 1)))
    (match (calls/create 9 5 [(: 6 u8)] allocator)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (set! control
                  (require (calls/emit! (mut graph)
                                        prototype
                                        control
                                        target
                                        [input]
                                        allocator)))
            (calls/release! (mut prototype)))))
    (let [called control]
      (set! i 0)
      (while (< i 40)
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph)
                                                  output
                                                  (* i width))
                                        (get results (cast i64 i))
                                        true)))
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph)
                                                  output
                                                  (+ 1024 (* i width)))
                                        (get inputs (cast i64 i))
                                        true)))
        (set! i (+ i 1)))
      (let [fixed (require (b/emit! (mut graph) 86 5 [control guard]))
            live-dynamic (require (b/emit! (mut graph) 91 5 [fixed dynamic]))
            sum (require (b/emit! (mut graph) 26 5 [fixed live-dynamic]))
            answer (require (b/emit! (mut graph) 26 5 [sum called]))
            freed (require (b/stack-free! (mut graph) live-dynamic size))
            ret (require (b/emit! (mut graph) 120 5 [freed answer (: 0 i32)]))]
        (match (compile/object graph start [ret] (fixture-name id) allocator)
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [object]
              (let [(mut object) object]
                (match (fs/write-file allocator
                                      (fixture-path id)
                                      (slice object))
                  (Err [_] (set! failures (+ failures 1)))
                  (Ok [_] 0))
                (free! (mut object)))))
        (match (compile/image graph
                              start
                              [ret]
                              "_vector_arithmetic_pressure"
                              allocator)
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [source]
              (let [(mut source) source]
                (match (jit/map-image source allocator)
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [loaded]
                      (let [(mut loaded) loaded]
                        (set! failures
                              (+ failures
                                 (pressure-exercise ty
                                                    opcode
                                                    (.base (.memory loaded)))))
                        (jit/release-image! (mut loaded)))))
                (image/release! (mut source)))))))
    (free! (mut inputs))
    (free! (mut results))
    (free! (mut payload))
    (g/release! (mut graph))
    failures))

(import "stogir.a64.encode" :as encode)
(import "stogir.a64.vector-extrema" :as native)
(import "stogir.bytes" :as bytes)

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

; A leaf C-ABI harness forces physical register aliases, independently of allocator choices.
(defn alias-check [(ty i32) (opcode i32) (rd i32) (rn i32) (rm i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut text) (ArrayList::new [u8] allocator)
        width (types/size ty 8)
        (mut error) ""
        (mut failures) 0]
    (word! (mut text)
           (mut error)
           (encode/floating-load-store true width rn 1 0))
    (when (!= rn rm)
      (word! (mut text)
             (mut error)
             (encode/floating-load-store true width rm 2 0)))
    (match (native/emit-registers! (mut text) opcode ty rd rn rm)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (word! (mut text)
           (mut error)
           (encode/floating-load-store false width rd 0 0))
    (bytes/append32! (mut text) 0xD65F03C0)
    (if (!= error "")
        (do (println "{}" error) (set! failures (+ failures 1)))
        (match (jit/map-text (slice text))
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [loaded]
              (let [(mut loaded) loaded]
                (set! failures
                      (+ failures
                         (exercise ty opcode (if (= rn rm) 4 -1) (.base loaded))))
                (jit/release! (mut loaded))))))
    (free! (mut text))
    failures))

(defn forced-aliases [] (-> i64)
