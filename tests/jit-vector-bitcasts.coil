(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn address! [(graph (mut g/Graph)) (base i32) (offset u64)] (-> i32)
  (require (b/emit! (mut graph)
                    26
                    6
                    [base (require (b/scalar-constant! (mut graph) 5 offset 8))])))

(defn generate [(src i32) (dst i32) (id i32)] (-> i64)
  (let [alc (malloc-allocator)
        (mut graph) (g/create alc)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        loaded (require (b/emit! (mut graph) 91 src [start input]))
        result (require (b/conversion! (mut graph) 36 dst 8 loaded))
        (mut payload) (ArrayList::new [u8] alc)
        (mut i) (: 0 i64)
        (mut failures) 0]
    (while (< i (cast i64 (types/size src 8)))
      (push! (mut payload) (byte-at src i))
      (set! i (+ i 1)))
    (let [literal
            (if (types/vector? src)
                (require (b/vector-constant! (mut graph) src 8 (slice payload)))
                (require (b/scalar-constant! (mut graph) src (sample src) 8)))
          folded (require (b/conversion! (mut graph) 36 dst 8 literal))
          first-store
            (require (b/emit! (mut graph)
                              93
                              0
                              [loaded (address! (mut graph) output 1) result]))
          second-store
            (require (b/emit! (mut graph)
                              93
                              0
                              [first-store
                               (address! (mut graph) output 17)
                               folded]))
          third-store
            (require (b/emit! (mut graph)
                              93
                              0
                              [second-store
                               (address! (mut graph) output 33)
                               loaded]))
          zero (require (b/scalar-constant! (mut graph) 5 0 8))
          ret (require (b/emit! (mut graph) 120 5 [third-store zero (: 0 i32)]))]
      (when (>= folded 0) (set! failures (+ failures 1)))
      (match (calls/create (target/arch-pick 9 8) 5 [(: 6 u8) 6] alc)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [signature]
            (let [(mut signature) signature]
              (require (calls/function! (mut graph) signature alc))
              (calls/release! (mut signature)))))
      (match (compile/object graph start [ret] (fixture-name id) alc)
        (Err [message]
             (println "{} -> {}: {}" src dst message)
             (set! failures (+ failures 1)))
        (Ok [object]
            (let [(mut object) object]
              (match (fs/write-file alc (fixture-path id) (slice object))
                (Err [_] (set! failures (+ failures 1)))
                (Ok [_] 0))
              (free! (mut object)))))
      (match (compile/image graph start [ret] (target/os-pick "_vector_bitcast_jit" "vector_bitcast_jit") alc)
        (Err [message]
             (println "{} -> {}: {}" src dst message)
             (set! failures (+ failures 1)))
        (Ok [source]
            (let [(mut source) source]
              (match (jit/map-image source alc)
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [loaded-image]
                    (let [(mut loaded-image) loaded-image]
                      (set! failures
                            (+ failures
                               (exercise src dst (.base (.memory loaded-image)))))
                      (jit/release-image! (mut loaded-image)))))
              (image/release! (mut source)))))
      (g/release! (mut graph)))
    (free! (mut payload))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut id) (: 0 i32)
        (mut src) (: 1 i32)]
    (while (< src 128)
      (let [(mut dst) (: 1 i32)]
        (while (< dst 128)
          (when (and (types/valid? src)
                     (types/valid? dst)
                     (or (types/vector? src) (types/vector? dst))
                     (= (types/size src 8) (types/size dst 8))
                     (or (= (types/size src 8) 8) (= (types/size src 8) 16)))
            (set! failures (+ failures (generate src dst id)))
            (set! id (+ id 1)))
          (set! dst (+ dst 1))))
      (set! src (+ src 1)))
    (println "native vector bitcasts: {} graphs, {} failures" id failures)
    (if (= failures 0) 0 1)))
