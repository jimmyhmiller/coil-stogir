(module stogir.tests.cse)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        a (require (b/integer-binary! (mut graph) 26 11 8 p q))
        same (require (b/integer-binary! (mut graph) 26 11 8 q p))
        sub (require (b/integer-binary! (mut graph) 27 11 8 p q))
        reverse (require (b/integer-binary! (mut graph) 27 11 8 q p))
        (mut failures) 0]
    (when (!= a same) (set! failures (+ failures 1)))
    (when (= sub reverse) (set! failures (+ failures 1)))
    (let [later (require (b/integer-binary! (mut graph) 26 11 8 p q))]
      (when (!= later a) (set! failures (+ failures 1))))
    (b/patch! (mut graph) a 1 p)
    (let [fresh (require (b/integer-binary! (mut graph) 26 11 8 p q))]
      (when (= a fresh) (set! failures (+ failures 1))))
    (let [retained (require (b/integer-binary! (mut graph) 27 11 8 p q))]
      (when (g/rewrite-inputs! (mut graph) retained 27 11 [p q p q])
        (set! failures (+ failures 1)))
      (when (!= retained (require (b/integer-binary! (mut graph) 27 11 8 p q)))
        (set! failures (+ failures 1))))
    (when (not (g/rewrite-inputs! (mut graph) sub 27 11 [q p]))
      (set! failures (+ failures 1)))
    (let [fresh (require (b/integer-binary! (mut graph) 27 11 8 p q))]
      (when (= fresh sub) (set! failures (+ failures 1))))
    (when (not (g/make-nop! (mut graph) reverse))
      (set! failures (+ failures 1)))
    (let [fresh (require (b/integer-binary! (mut graph) 27 11 8 q p))]
      (when (= fresh reverse) (set! failures (+ failures 1))))
    (g/release! (mut graph))
    (println "CSE checks: {} failures" failures)
    (if (= failures 0) 0 1)))
