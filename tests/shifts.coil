(module stogir.tests.shifts)
(import "stogir.fold" :as f)
(import "coil.result" :use [Some None])

(defn check [(opcode i32) (ty i32) (a u64) (b u64) (want u64)] (-> i64)
  (match (f/integer-binary opcode ty 8 a b)
    (Some [got] (if (= got want) 0 1))
    (None [] 1)))

(defn main [] (-> i64)
  (let [failures
          (+ (check 49 2 1 8 1)
             (check 49 2 128 1 0)
             (check 50 8 128 1 64)
             (check 51 8 128 1 192)
             (check 51 8 128 0 128)
             (check 51 8 128 7 255)
             (check 51 11 0x8000000000000000 63 0xFFFFFFFFFFFFFFFF)
             (check 50 5 0x8000000000000000 64 0x8000000000000000)
             (check 49 5 1 63 0x8000000000000000))]
    (println "shift checks: {} failures" failures)
    (if (= failures 0) 0 1)))
