(module stogir.tests.aot-stack-storage-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern call24 :as "stogir_stack_call24" :cc (cc/C) [u64] (-> u64))

(extern loop-i64 :as "stogir_stack_loop_i64" :cc (cc/C) [i64] (-> i64))

(extern loop-f64 :as "stogir_stack_loop_f64" :cc (cc/C) [i64] (-> f64))

(extern branch :as "stogir_stack_branch" :cc (cc/C) [u64 u64] (-> u64))

(defn update24 :cc (cc/C) [(a u64)
                           (b u64)
                           (c u64)
                           (d u64)
                           (e u64)
                           (f u64)
                           (g u64)
                           (h u64)
                           (i u64)
                           (j u64)
                           (k u64)
                           (l u64)
                           (m u64)
                           (n u64)
                           (o u64)
                           (p u64)
                           (q u64)
                           (r u64)
                           (s u64)
                           (t u64)
                           (u u64)
                           (v u64)
                           (w u64)
                           (x u64)] (-> u64)
  (let [(mut sum) (: 0 u64)]
    (for address [a b c d e f g h i j k l m n o p q r s t u v w x]
      (let [p (primitive/cast (ptr u64) address)
            value (primitive/load p)]
        (set! sum (+ sum value))
        (primitive/store! p (+ value 1000))))
    sum))

(defn main [] (-> i64)
  (let [(mut failures) 0
        target
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of update24)))]
    (when (!= (call24 target) 24600) (set! failures (+ failures 1)))
    (for size [(: 0 u64) 1 17 4097]
      (when (!= (branch 0 size) 9) (set! failures (+ failures 1)))
      (when (!= (branch 1 size) 7) (set! failures (+ failures 1))))
    (for n [(: -1 i64) 0 1 2 31 100]
      (let [expected (if (< n 0) 0 (/ (* n (- n 1)) 2))]
        (when (!= (loop-i64 n) expected) (set! failures (+ failures 1)))
        (when (!= (loop-f64 n) (cast f64 expected))
          (set! failures (+ failures 1)))))
    (println "linked dynamic objects, calls and loops: {} failures" failures)
    (if (= failures 0) 0 1)))
