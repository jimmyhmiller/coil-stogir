(module stogir.tests.jit-incoming-widths)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.native.compile" :as compile)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        pointer (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 17]))
        signed32 (require (b/emit! (mut graph) 71 10 [start (: 0 i32) 16]))
        unsigned32 (require (b/emit! (mut graph) 71 4 [start (: 0 i32) 15]))
        flag (require (b/emit! (mut graph) 71 1 [start (: 0 i32) 14]))
        wide (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 13]))
        char (require (b/emit! (mut graph) 71 7 [start (: 0 i32) 12]))
        unsigned16 (require (b/emit! (mut graph) 71 3 [start (: 0 i32) 11]))
        signed16 (require (b/emit! (mut graph) 71 9 [start (: 0 i32) 10]))
        unsigned8 (require (b/emit! (mut graph) 71 2 [start (: 0 i32) 9]))
        signed8 (require (b/emit! (mut graph) 71 8 [start (: 0 i32) 8]))
        a (require (b/emit! (mut graph) 33 11 [signed8]))
        b (require (b/emit! (mut graph) 34 11 [unsigned8]))
        c (require (b/emit! (mut graph) 33 11 [signed16]))
        d (require (b/emit! (mut graph) 34 11 [unsigned16]))
        e (require (b/emit! (mut graph) 33 11 [char]))
        f (require (b/emit! (mut graph) 34 11 [unsigned32]))
        h (require (b/emit! (mut graph) 33 11 [signed32]))
        loaded (require (b/emit! (mut graph) 91 11 [start pointer]))
        ab (require (b/emit! (mut graph) 26 11 [a b]))
        abc (require (b/emit! (mut graph) 26 11 [ab c]))
        abcd (require (b/emit! (mut graph) 26 11 [abc d]))
        abcde (require (b/emit! (mut graph) 26 11 [abcd e]))
        abcdef (require (b/emit! (mut graph) 26 11 [abcde f]))
        abcdefh (require (b/emit! (mut graph) 26 11 [abcdef h]))
        summed (require (b/emit! (mut graph) 26 11 [abcdefh wide]))
        result (require (b/emit! (mut graph) 26 11 [summed loaded]))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        negative (require (b/emit! (mut graph) 27 11 [zero result]))
        branch (require (b/emit! (mut graph) 116 0 [loaded flag]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        yes-ret (require (b/emit! (mut graph) 120 11 [yes result (: 0 i32)]))
        no-ret (require (b/emit! (mut graph) 120 11 [no negative (: 0 i32)]))
        (mut failures) 0]
    ; Stack layout: i8@0,u8@1,i16@2,u16@4,char@6,i64@8,bool@16,
    ; u32@20,i32@24,ptr@32. The bool is read from its byte slot to choose the return path.
    (match (calls/create 0
                         11
                         [(: 11 u8) 11 11 11 11 11 11 11 8 2 9 3 7 11 1 4 10 6]
                         allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype]
            (require (calls/function! (mut graph) owned allocator))
            (calls/release! (mut owned)))))
    (match (compile/text graph start [yes-ret no-ret] allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [compiled]
          (let [(mut code) compiled]
            (match (jit/map-text (slice code))
              (Err [_] (set! failures (+ failures 1)))
              (Ok [image]
                  (let [(mut owned) image
                        f
                          (primitive/cast (fnptr (cc/C)
                                                 [i64
                                                  i64
                                                  i64
                                                  i64
                                                  i64
                                                  i64
                                                  i64
                                                  i64
                                                  i8
                                                  u8
                                                  i16
                                                  u16
                                                  i8
                                                  i64
                                                  bool
                                                  u32
                                                  i32
                                                  (ptr i64)]
                                                 i64)
                                          (.base owned))
                        (mut cell) (: 7001 i64)]
                    (for x [(: -128 i64) -1 0 1 127]
                      (let [a (cast i8 x)
                            b (cast u8 (+ x 128))
                            c (cast i16 (* x 200))
                            d (cast u16 (* (+ x 128) 257))
                            e (cast i8 (- 0 x))
                            wide (* x 100000)
                            f32 (cast u32 (* x 1234567))
                            h32 (cast i32 (* x 1234))
                            total
                              (+ (cast i64 a)
                                 (cast i64 b)
                                 (cast i64 c)
                                 (cast i64 d)
                                 (cast i64 e)
                                 wide
                                 (cast i64 f32)
                                 (cast i64 h32)
                                 cell)
                            expected (if (!= x 0) total (- 0 total))
                            actual
                              (call-ptr f
                                        10
                                        20
                                        30
                                        40
                                        50
                                        60
                                        70
                                        80
                                        a
                                        b
                                        c
                                        d
                                        e
                                        wide
                                        (!= x 0)
                                        f32
                                        h32
                                        (mut cell))]
                        (when (!= actual expected)
                          (when (= failures 0)
                            (println "x={} expected={} actual={}"
                                     x
                                     expected
                                     actual))
                          (set! failures (+ failures 1)))))
                    (jit/release! (mut owned)))))
            (free! (mut code)))))
    (g/release! (mut graph))
    (println "incoming scalar width checks: {} failures" failures)
    (if (= failures 0) 0 1)))
