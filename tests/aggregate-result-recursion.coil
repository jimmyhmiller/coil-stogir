(module stogir.tests.aggregate-result-recursion)
(import "stogir.graph" :as g)
(import "stogir.target" :as target)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.image" :as image)
(import "stogir.aot.native" :as aot)
(import "stogir.call-results" :as results)
(import "stogir.native.compile" :as compile)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn bits-f32 [(bits u32)] (-> f32)
  (let [p (primitive/alloc-stack u32)]
    (primitive/store! p bits)
    (primitive/load (primitive/cast (ptr f32) p))))

(defn f32-bits [(value f32)] (-> u32)
  (let [p (primitive/alloc-stack f32)]
    (primitive/store! p value)
    (primitive/load (primitive/cast (ptr u32) p))))

(defn bits-f64 [(bits u64)] (-> f64)
  (let [p (primitive/alloc-stack u64)]
    (primitive/store! p bits)
    (primitive/load (primitive/cast (ptr f64) p))))

(defn f64-bits [(value f64)] (-> u64)
  (let [p (primitive/alloc-stack f64)]
    (primitive/store! p value)
    (primitive/load (primitive/cast (ptr u64) p))))

(defstruct R0 [(a u64)])

(defstruct R1 [(a u64) (b u64)])

(defstruct R2 [(a i64)])

(defstruct R3 [(a i64) (b i64)])

(defstruct R4 [(a f32)])

(defstruct R5 [(a f32) (b f32)])

(defstruct R6 [(a f32) (b f32) (c f32)])

(defstruct R7 [(a f32) (b f32) (c f32) (d f32)])

(defstruct R8 [(a f64)])

(defstruct R9 [(a f64) (b f64)])

(defstruct R10 [(a f64) (b f64) (c f64)])

(defstruct R11 [(a f64) (b f64) (c f64) (d f64)])

(defstruct R12 [(a u64) (b u64) (c u64)])

(defstruct R13 [(a u64) (b u64) (c u64) (d u64) (e u64)])

(defstruct R14 [(a u8) (b u8) (c u8)])

(defstruct R15 [(a u64) (b u32)])

(defn field-count [(id i32)] (-> i32)
  (match id
    (0 1)
    (1 2)
    (2 1)
    (3 2)
    (4 1)
    (5 2)
    (6 3)
    (7 4)
    (8 1)
    (9 2)
    (10 3)
    (11 4)
    (12 3)
    (13 5)
    (14 3)
    (15 2)
    (_ 0)))

(defn data-type [(id i32)] (-> i32)
  (match id
    (0 5)
    (1 5)
    (2 5)
    (3 5)
    (4 13)
    (5 13)
    (6 13)
    (7 13)
    (8 12)
    (9 12)
    (10 12)
    (11 12)
    (12 5)
    (13 5)
    (14 5)
    (15 5)
    (_ 0)))

(defn payload-size [(id i32)] (-> i32)
  (match id
    (0 8)
    (1 16)
    (2 8)
    (3 16)
    (4 4)
    (5 8)
    (6 12)
    (7 16)
    (8 8)
    (9 16)
    (10 24)
    (11 32)
    (12 24)
    (13 40)
    (14 8)
    (15 16)
    (_ 0)))

(defn result-spec [(id i32)] (-> results/Spec)
  (match id
    (0 (results/pieces 5 1))
    (1 (results/pieces 5 2))
    (2 (results/pieces 11 1))
    (3 (results/pieces 11 2))
    (4 (results/pieces 13 1))
    (5 (results/pieces 13 2))
    (6 (results/pieces 13 3))
    (7 (results/pieces 13 4))
    (8 (results/pieces 12 1))
    (9 (results/pieces 12 2))
    (10 (results/pieces 12 3))
    (11 (results/pieces 12 4))
    (12 (results/indirect))
    (13 (results/indirect))
    (14 (results/pieces 5 1))
    (15 (results/pieces 5 2))
    (_ (results/ordinary))))

(defn field-type [(id i32) (index i32)] (-> i32)
  (match id
    (0 (match index (0 5) (_ 0)))
    (1 (match index (0 5) (1 5) (_ 0)))
    (2 (match index (0 11) (_ 0)))
    (3 (match index (0 11) (1 11) (_ 0)))
    (4 (match index (0 13) (_ 0)))
    (5 (match index (0 13) (1 13) (_ 0)))
    (6 (match index (0 13) (1 13) (2 13) (_ 0)))
    (7 (match index (0 13) (1 13) (2 13) (3 13) (_ 0)))
    (8 (match index (0 12) (_ 0)))
    (9 (match index (0 12) (1 12) (_ 0)))
    (10 (match index (0 12) (1 12) (2 12) (_ 0)))
    (11 (match index (0 12) (1 12) (2 12) (3 12) (_ 0)))
    (12 (match index (0 5) (1 5) (2 5) (_ 0)))
    (13 (match index (0 5) (1 5) (2 5) (3 5) (4 5) (_ 0)))
    (14 (match index (0 2) (1 2) (2 2) (_ 0)))
    (15 (match index (0 5) (1 4) (_ 0)))
    (_ 0)))

(defn field-offset [(id i32) (index i32)] (-> i32)
  (match id
    (0 (match index (0 0) (_ 0)))
    (1 (match index (0 0) (1 8) (_ 0)))
    (2 (match index (0 0) (_ 0)))
    (3 (match index (0 0) (1 8) (_ 0)))
    (4 (match index (0 0) (_ 0)))
    (5 (match index (0 0) (1 4) (_ 0)))
    (6 (match index (0 0) (1 4) (2 8) (_ 0)))
    (7 (match index (0 0) (1 4) (2 8) (3 12) (_ 0)))
    (8 (match index (0 0) (_ 0)))
    (9 (match index (0 0) (1 8) (_ 0)))
    (10 (match index (0 0) (1 8) (2 16) (_ 0)))
    (11 (match index (0 0) (1 8) (2 16) (3 24) (_ 0)))
    (12 (match index (0 0) (1 8) (2 16) (_ 0)))
    (13 (match index (0 0) (1 8) (2 16) (3 24) (4 32) (_ 0)))
    (14 (match index (0 0) (1 1) (2 2) (_ 0)))
    (15 (match index (0 0) (1 8) (_ 0)))
    (_ 0)))

(defn memory-type [(id i32) (index i32)] (-> i32)
  (match id
    (0 (match index (0 5) (_ 0)))
    (1 (match index (0 5) (1 5) (_ 0)))
    (2 (match index (0 5) (_ 0)))
    (3 (match index (0 5) (1 5) (_ 0)))
    (4 (match index (0 4) (_ 0)))
    (5 (match index (0 4) (1 4) (_ 0)))
    (6 (match index (0 4) (1 4) (2 4) (_ 0)))
    (7 (match index (0 4) (1 4) (2 4) (3 4) (_ 0)))
    (8 (match index (0 5) (_ 0)))
    (9 (match index (0 5) (1 5) (_ 0)))
    (10 (match index (0 5) (1 5) (2 5) (_ 0)))
    (11 (match index (0 5) (1 5) (2 5) (3 5) (_ 0)))
    (12 (match index (0 5) (1 5) (2 5) (_ 0)))
    (13 (match index (0 5) (1 5) (2 5) (3 5) (4 5) (_ 0)))
    (14 (match index (0 2) (1 2) (2 2) (_ 0)))
    (15 (match index (0 5) (1 4) (_ 0)))
    (_ 0)))

(defn score [(id i32) (seed u64)] (-> u64)
  (let [(mut i) (: 0 i32)
        (mut sum) (: 0 u64)]
    (while (< i (field-count id))
      (let [bits (+ seed (: 506 u64) (* (cast u64 i) (: 257 u64)))
            ty (memory-type id i)
            value
              (if (= ty 2) (& bits 255) (if (= ty 4) (& bits 0xFFFFFFFF) bits))]
        (set! sum (+ sum (* value (cast u64 (+ i 1))))))
      (set! i (+ i 1)))
    sum))

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [message] (println "{}" message) 0)))

(defn value! [(graph (mut g/Graph)) (ty i32) (bits i32)] (-> i32)
  (if (= ty 5)
      bits
      (if (or (= ty 2) (= ty 4))
          (require (b/conversion! (mut graph) 35 ty 8 bits))
          (if (= ty 13)
              (require (b/conversion! (mut graph)
                                      36
                                      13
                                      8
                                      (require (b/conversion! (mut graph)
                                                              35
                                                              4
                                                              8
                                                              bits))))
              (require (b/conversion! (mut graph) 36 ty 8 bits))))))

(defn address! [(graph (mut g/Graph)) (base i32) (offset i32)] (-> i32)
  (require (b/emit! (mut graph)
                    26
                    6
                    [base
                     (require (b/scalar-constant! (mut graph)
                                                  5
                                                  (cast u64 offset)
                                                  8))])))

(defn expected [(id i32) (depth u64) (seed u64)] (-> u64)
  (let [(mut toggle) (: 0 u64)
        (mut n) depth
        (mut answer) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (> n 0) (set! toggle (^ toggle n)) (set! n (- n 1)))
    (while (< i (field-count id))
      (let [raw (+ seed (cast u64 (* i 257)))
            value (if (= i 0) (^ raw toggle) raw)
            narrow
              (if (= (field-type id i) 2)
                  (cast u64 (cast u8 value))
                  (if (or (= (field-type id i) 4) (= (field-type id i) 13))
                      (cast u64 (cast u32 value))
                      value))]
        (set! answer (+ answer (* narrow (cast u64 (+ i 1))))))
      (set! i (+ i 1)))
    answer))

(defn invoke [(id i32) (address (ptr u8)) (depth u64) (seed u64)] (-> u64)
  (match id
    (1 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R1) address)
             value (call-ptr f depth seed)]
         (+ (: 0 u64)
            (* (cast u64 (.a value)) (: 1 u64))
            (* (cast u64 (.b value)) (: 2 u64)))))
    (6 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R6) address)
             value (call-ptr f depth seed)]
         (+ (: 0 u64)
            (* (cast u64 (f32-bits (.a value))) (: 1 u64))
            (* (cast u64 (f32-bits (.b value))) (: 2 u64))
            (* (cast u64 (f32-bits (.c value))) (: 3 u64)))))
    (11 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R11) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (f64-bits (.a value)) (: 1 u64))
             (* (f64-bits (.b value)) (: 2 u64))
             (* (f64-bits (.c value)) (: 3 u64))
             (* (f64-bits (.d value)) (: 4 u64)))))
    (13 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R13) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64))
             (* (cast u64 (.c value)) (: 3 u64))
             (* (cast u64 (.d value)) (: 4 u64))
             (* (cast u64 (.e value)) (: 5 u64)))))
    (14 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R14) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64))
             (* (cast u64 (.c value)) (: 3 u64)))))
    (15 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R15) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64)))))
    (_ 0)))

(defn entry-name [(id i32) (alignment i32)] (-> (slice u8))
  (match id
    (1 (if (= alignment 16)
           (target/os-pick "_stogir_results_rec_1_16" "stogir_results_rec_1_16")
           (target/os-pick "_stogir_results_rec_1_4096" "stogir_results_rec_1_4096")))
    (6 (if (= alignment 16)
           (target/os-pick "_stogir_results_rec_6_16" "stogir_results_rec_6_16")
           (target/os-pick "_stogir_results_rec_6_4096" "stogir_results_rec_6_4096")))
    (11 (if (= alignment 16)
            (target/os-pick "_stogir_results_rec_11_16" "stogir_results_rec_11_16")
            (target/os-pick "_stogir_results_rec_11_4096" "stogir_results_rec_11_4096")))
    (13 (if (= alignment 16)
            (target/os-pick "_stogir_results_rec_13_16" "stogir_results_rec_13_16")
            (target/os-pick "_stogir_results_rec_13_4096" "stogir_results_rec_13_4096")))
    (14 (if (= alignment 16)
            (target/os-pick "_stogir_results_rec_14_16" "stogir_results_rec_14_16")
            (target/os-pick "_stogir_results_rec_14_4096" "stogir_results_rec_14_4096")))
    (15 (if (= alignment 16)
            (target/os-pick "_stogir_results_rec_15_16" "stogir_results_rec_15_16")
            (target/os-pick "_stogir_results_rec_15_4096" "stogir_results_rec_15_4096")))
    (_ "invalid")))

(defn object-path [(id i32) (alignment i32)] (-> (slice u8))
  (match id
    (1 (if (= alignment 16)
           "/tmp/coil-stogir-results-rec-1-16.o"
           "/tmp/coil-stogir-results-rec-1-4096.o"))
    (6 (if (= alignment 16)
           "/tmp/coil-stogir-results-rec-6-16.o"
           "/tmp/coil-stogir-results-rec-6-4096.o"))
    (11 (if (= alignment 16)
            "/tmp/coil-stogir-results-rec-11-16.o"
            "/tmp/coil-stogir-results-rec-11-4096.o"))
    (13 (if (= alignment 16)
            "/tmp/coil-stogir-results-rec-13-16.o"
            "/tmp/coil-stogir-results-rec-13-4096.o"))
    (14 (if (= alignment 16)
            "/tmp/coil-stogir-results-rec-14-16.o"
            "/tmp/coil-stogir-results-rec-14-4096.o"))
    (15 (if (= alignment 16)
            "/tmp/coil-stogir-results-rec-15-16.o"
            "/tmp/coil-stogir-results-rec-15-4096.o"))
    (_ "invalid")))

(defn exercise [(id i32) (address (ptr u8))] (-> i64)
  (let [(mut failures) 0]
    (for depth [(: 0 u64) 1 2 3 7 15 31]
      (for seed [(: 0 u64)
                 1
                 0x80000000
                 0x7FC12345
                 0x8000000000000000
                 0x7FF8123456789ABC
                 0xFFFFFFFFFFFFFFFF]
        (let [got (invoke id address depth seed)
              want (expected id depth seed)]
          (when (!= got want)
            (println "recursive result {} depth{} seed{}: {} expected{}"
                     id
                     depth
                     seed
                     got
                     want)
            (set! failures (+ failures 1))))))
    failures))

(defn test [(id i32) (alignment i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        place (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        depth (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 1]))
        seed (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 2]))
        one (require (b/scalar-constant! (mut graph) 5 1 8))
        zero (require (b/scalar-constant! (mut graph) 5 0 8))
        guard-value (require (b/emit! (mut graph) 48 5 [seed depth]))
        local
          (require (b/variable! (mut graph) 5 start "recursive-guard" alignment))
        stored (require (b/emit! (mut graph) 87 0 [start local guard-value]))
        size (require (b/scalar-constant! (mut graph) 5 97 8))
        dynamic (require (b/stack-allocate! (mut graph) stored size alignment))
        initialized
          (require (b/emit! (mut graph) 93 0 [dynamic dynamic guard-value]))
        condition (require (b/emit! (mut graph) 14 1 [depth zero]))
        split (require (b/emit! (mut graph) 116 0 [initialized condition]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        previous (require (b/emit! (mut graph) 27 5 [depth one]))
        target
          (require (symbols/function! (mut graph) (entry-name id alignment) 0))
        (mut control) yes
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i (field-count id))
      (let [delta
              (require (b/scalar-constant! (mut graph) 5 (cast u64 (* i 257)) 8))
            raw (require (b/emit! (mut graph) 26 5 [seed delta]))
            value (value! (mut graph) (field-type id i) raw)
            address (address! (mut graph) place (field-offset id i))]
        (set! control
              (require (b/emit! (mut graph) 93 0 [control address value]))))
      (set! i (+ i 1)))
    (let [base (require (b/emit! (mut graph) 120 0 [control (: 0 i32) 0]))]
      (match (calls/create-result (target/arch-pick 9 8)
                                  [(: 6 u8) 5 5]
                                  []
                                  (result-spec id)
                                  allocator)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [prototype]
            (let [(mut prototype) prototype
                  called
                    (require (calls/emit! (mut graph)
                                          prototype
                                          no
                                          target
                                          [place previous seed]
                                          allocator))
                  local-check
                    (require (b/emit! (mut graph) 86 5 [called local]))
                  dynamic-check
                    (require (b/emit! (mut graph) 91 5 [local-check dynamic]))
                  bad-local
                    (require (b/emit! (mut graph)
                                      15
                                      1
                                      [local-check guard-value]))
                  bad-dynamic
                    (require (b/emit! (mut graph)
                                      15
                                      1
                                      [dynamic-check guard-value]))
                  bad
                    (require (b/emit! (mut graph) 46 1 [bad-local bad-dynamic]))
                  flag (require (b/conversion! (mut graph) 34 5 8 bad))
                  toggle (require (b/emit! (mut graph) 48 5 [depth flag]))
                  first-type (field-type id 0)
                  integer-type
                    (if (= first-type 13)
                        (: 4 i32)
                        (if (= first-type 12) (: 5 i32) first-type))
                  first
                    (require (b/emit! (mut graph)
                                      91
                                      integer-type
                                      [dynamic-check place]))
                  narrowed
                    (if (= integer-type 5)
                        toggle
                        (require (b/conversion! (mut graph)
                                                35
                                                integer-type
                                                8
                                                toggle)))
                  toggled
                    (require (b/emit! (mut graph)
                                      48
                                      integer-type
                                      [first narrowed]))
                  updated
                    (require (b/emit! (mut graph) 93 0 [first place toggled]))
                  recursive
                    (require (b/emit! (mut graph) 120 0 [updated (: 0 i32) 0]))]
              (require (calls/function! (mut graph) prototype allocator))
              (match (compile/image graph
                                    start
                                    [base recursive]
                                    (entry-name id alignment)
                                    allocator)
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [source]
                    (let [(mut source) source]
                      (when (!= (len (.symbols source)) 1)
                        (set! failures (+ failures 1)))
                      (match (aot/image-object source allocator)
                        (Err [message]
                             (println "{}" message)
                             (set! failures (+ failures 1)))
                        (Ok [object]
                            (let [(mut object) object]
                              (match (fs/write-file allocator
                                                    (object-path id alignment)
                                                    (slice object))
                                (Err [message]
                                     (println "{}" message)
                                     (set! failures (+ failures 1)))
                                (Ok [_] 0))
                              (free! (mut object)))))
                      (match (jit/map-image source allocator)
                        (Err [message]
                             (println "{}" message)
                             (set! failures (+ failures 1)))
                        (Ok [loaded]
                            (let [(mut loaded) loaded]
                              (set! failures
                                    (+ failures
                                       (exercise id (.base (.memory loaded)))))
                              (jit/release-image! (mut loaded)))))
                      (image/release! (mut source)))))
              (calls/release! (mut prototype))))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    ; Cases 6 and 11 return three floats and four doubles in registers, the
    ; AArch64 HFA shape; System V returns at most two eightbytes that way.
    (for id (target/arch-pick [(: 1 i32) 6 11 13 14 15] [(: 1 i32) 13 14 15])
      (for alignment [(: 16 i32) 4096]
        (set! failures (+ failures (test id alignment)))))
    (println "recursive aggregate register/x8 results, private buffers and dynamic aligned frames: {} failures"
             failures)
    (if (= failures 0) 0 1)))
