(module stogir.tests.aot-switch-pressure-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(extern gp :as "stogir_switch_pressure_gp" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern fp :as "stogir_switch_pressure_fp" :cc (cc/C) [u64 u64 u64] (-> f64))

(extern phi-pressure :as "stogir_phi_pressure" :cc (cc/C) [i64] (-> i64))

(defn mix :cc (cc/C) [(a u64) (b u64)] (-> u64)
  (+ (* a 3) (* b 5)))

(defn mix-fp :cc (cc/C) [(a f64) (b f64)] (-> f64)
  (+ (* a 3.0) (* b 5.0)))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut integers) (ArrayList::new [u64] allocator)
        (mut floats) (ArrayList::new [f64] allocator)
        target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of mix)))
        target-fp
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of mix-fp)))
        (mut i) (: 0 u64)
        (mut failures) 0]
    (while (< i 40)
      (push! (mut integers) (+ i 11))
      (push! (mut floats) (cast f64 (+ i 11)))
      (set! i (+ i 1)))
    (set! i 0)
    (while (<= i 258)
      (let [tag (if (= i 258) (: 0xFFFFFFFFFFFFFFFF u64) i)
            pair (mix (+ (% tag 40) 11) (+ (% (+ (% tag 40) 13) 40) 11))
            expected-gp (+ 642 (if (< tag 257) pair 1220))
            expected-fp (cast f64 (+ 642 (if (< tag 40) pair 1220)))]
        (when (!= (gp target (primitive/cast u64 (.data integers)) tag)
                  expected-gp)
          (set! failures (+ failures 1)))
        (when (!= (fp target-fp (primitive/cast u64 (.data floats)) tag)
                  expected-fp)
          (set! failures (+ failures 1))))
      (set! i (+ i 1)))
    (for [x -100 101]
      (when (!= (phi-pressure x) (+ (* 24 x) (if (< x 0) 300 -300)))
        (set! failures (+ failures 1))))
    (free! (mut integers))
    (free! (mut floats))
    (println "linked large switches with mixed pressure and calls: {} failures"
             failures)
    (if (= failures 0) 0 1)))
