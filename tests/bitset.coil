(module stogir.tests.bitset)
(import "stogir.bitset" :as b)
(import "coil.alloc" :use [malloc-allocator])

(defn initial-storage-check [] (-> void)
  (let [a (malloc-allocator)]
    (for size [(: 0 i64) 1 63 64 65 130 4097]
      (for reuse [false true]
        (let [(mut bits) (b/create size a)
              count (+ (/ size 64) (if (= (% size 64) 0) 0 1))]
          (assert (= (.size bits) size))
          (assert (= (len (.words bits)) count))
          (for word (.words bits) (assert (= word 0)))
          (for [i 0 size] (assert (not (b/contains? bits i))))
          (assert (not (b/contains? bits -1)))
          (assert (not (b/contains? bits size)))
          (when (> size 0)
            (assert (b/add! (mut bits) (- size 1)))
            (assert (b/contains? bits (- size 1))))
          (b/release! (mut bits)))))))

(defn main [] (-> i64)
  (initial-storage-check)
  (let [a (malloc-allocator)
        (mut uses) (b/create 130 a)
        (mut defs) (b/create 130 a)
        (mut out) (b/create 130 a)
        (mut input) (b/create 130 a)
        (mut failures) 0]
    (for index [0 63 64 129]
      (when (not (b/add! (mut out) index)) (set! failures (+ failures 1)))
      (when (b/add! (mut out) index) (set! failures (+ failures 1)))
      (when (not (b/contains? out index)) (set! failures (+ failures 1))))
    (when (b/add! (mut out) 130) (set! failures (+ failures 1)))
    (when (b/add! (mut out) -1) (set! failures (+ failures 1)))
    (b/add! (mut defs) 64)
    (b/add! (mut uses) 5)
    (when (not (b/transfer! (mut input) uses out defs))
      (set! failures (+ failures 1)))
    (when (b/transfer! (mut input) uses out defs)
      (set! failures (+ failures 1)))
    (when (b/contains? input 64) (set! failures (+ failures 1)))
    (when (not (b/contains? input 5)) (set! failures (+ failures 1)))
    (when (not (b/contains? input 129)) (set! failures (+ failures 1)))
    (when (not (b/union! (mut input) out)) (set! failures (+ failures 1)))
    (when (not (b/remove! (mut input) 64)) (set! failures (+ failures 1)))
    (when (b/remove! (mut input) 64) (set! failures (+ failures 1)))
    (when (!= (b/next-set out -5) 0) (set! failures (+ failures 1)))
    (when (!= (b/next-set out 1) 63) (set! failures (+ failures 1)))
    (when (!= (b/next-set out 64) 64) (set! failures (+ failures 1)))
    (when (!= (b/next-set out 65) 129) (set! failures (+ failures 1)))
    (when (!= (b/next-set out 130) -1) (set! failures (+ failures 1)))
    (b/release! (mut uses))
    (b/release! (mut defs))
    (b/release! (mut out))
    (b/release! (mut input))
    (println "bitset checks: {} failures" failures)
    (if (= failures 0) 0 1)))
