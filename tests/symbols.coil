(module stogir.tests.symbols)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.calls" :as calls)
(import "stogir.fold" :as fold)
(import "stogir.a64.select" :as select)
(import "stogir.a64.compile" :as compile)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn reference [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (do (println "{}" message) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        function (reference (symbols/function! (mut graph) "_target" 0))
        symbol (reference (symbols/symbol! (mut graph) "_target"))
        string (reference (symbols/string! (mut graph) "_target"))
        other (reference (symbols/symbol! (mut graph) "_other"))
        numeric (reference (symbols/function-address! (mut graph) 1234 0))
        (mut failures) 0]
    (when (or (= function 0)
              (= symbol 0)
              (= string 0)
              (= other 0)
              (= numeric 0)
              (= function symbol)
              (= function string)
              (= symbol string))
      (set! failures (+ failures 1)))
    (when (!= function (reference (symbols/function! (mut graph) "_target" 0)))
      (set! failures (+ failures 1)))
    (match (g/lookup graph symbol)
      (None [] (set! failures (+ failures 1)))
      (Some [node]
            (when (not (symbols/validate graph node))
              (set! failures (+ failures 1)))
            ;; A numeric address with the identical payload must remain distinct.
            (match (g/intern-scalar! (mut graph) 6 (n/constant-bits node))
              (None [] (set! failures (+ failures 1)))
              (Some [address]
                    (when (= address symbol) (set! failures (+ failures 1)))))))
    (match (symbols/function! (mut graph) "" 0)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (symbols/symbol! (mut graph) "bad\0name")
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (symbols/function! (mut graph) "_bad_proto" 65535)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (symbols/string! (mut graph) "")
      (Err [_] (set! failures (+ failures 1)))
      (Ok [_] 0))
    ;; Neither equality nor arithmetic may operate on unresolved name IDs.
    (match (fold/compare! (mut graph) 14 6 8 function symbol)
      (Some [_] (set! failures (+ failures 1)))
      (None [] 0))
    (match (fold/binary! (mut graph) 26 6 8 symbol other)
      (Some [_] (set! failures (+ failures 1)))
      (None [] 0))
    (match (select/immediate graph symbol 6)
      (Some [_] (set! failures (+ failures 1)))
      (None [] 0))
    (match (calls/create 0 11 [(: 11 u8)] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype
                before (len (.instructions graph))
                annotated
                  (reference (calls/attach! (mut graph)
                                            owned
                                            function
                                            allocator))
                annotated-address
                  (reference (calls/attach! (mut graph) owned numeric allocator))]
            (when (or (= annotated 0)
                      (= annotated function)
                      (>= annotated 0)
                      (= annotated-address numeric)
                      (>= annotated-address 0)
                      (!= before (len (.instructions graph))))
              (set! failures (+ failures 1)))
            (when (!= annotated
                      (reference (calls/attach! (mut graph)
                                                owned
                                                function
                                                allocator)))
              (set! failures (+ failures 1)))
            (match (calls/signature graph annotated 0 0)
              (Err [_] (set! failures (+ failures 1)))
              (Ok [sig]
                  (when (or (!= (.result sig) 11)
                            (!= (.count sig) 1)
                            (<= (.id sig) 0))
                    (set! failures (+ failures 1)))))
            (match (g/lookup graph annotated)
              (None [] (set! failures (+ failures 1)))
              (Some [node]
                    (when (or (!= (n/opcode node) 74)
                              (= (n/auxiliary node) 0)
                              (not (symbols/validate graph node)))
                      (set! failures (+ failures 1)))))
            (calls/release! (mut owned)))))
    (match (compile/validate graph)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [_] 0))
    (g/release! (mut graph))
    (println "symbol constant checks: {} failures" failures)
    (if (= failures 0) 0 1)))
