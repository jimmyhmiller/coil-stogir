(module stogir.tests.unary-validation)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as verify)
(import "stogir.a64.unary" :as unary)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn invalid [(opcode i32) (ty i32)] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 ty [start (: 0 i32) 0]))
        (mut failures) 0]
    (match (b/integer-unary! (mut graph) opcode ty 8 p)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (let [raw (require (b/emit! (mut graph) opcode ty [p]))]
      (match (verify/integer-operations graph)
        (Ok [_] (set! failures (+ failures 1)))
        (Err [_] 0))
      (match (unary/width graph raw)
        (Ok [_] (set! failures (+ failures 1)))
        (Err [_] 0)))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures)
          (+ (invalid 31 1)
             (invalid 31 6)
             (invalid 32 4)
             (invalid 32 1)
             (invalid 54 2)
             (invalid 54 8)
             (invalid 55 1)
             (invalid 56 1)
             (invalid 57 12))
        (mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        first (require (b/integer-unary! (mut graph) 55 11 8 p))
        same (require (b/integer-unary! (mut graph) 55 11 8 p))
        other (require (b/integer-unary! (mut graph) 56 11 8 p))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        undefined-zero (require (b/integer-unary! (mut graph) 57 11 8 zero))]
    (when (or (= first 0) (!= first same) (= first other) (<= undefined-zero 0))
      (set! failures (+ failures 1)))
    ;; Mutation must clear the pure-expression cache.
    (require (b/patch! (mut graph) first 1 q))
    (when (= first (require (b/integer-unary! (mut graph) 55 11 8 p)))
      (set! failures (+ failures 1)))
    (g/release! (mut graph))
    (println "unary validation/CSE checks: {} failures" failures)
    (if (= failures 0) 0 1)))
