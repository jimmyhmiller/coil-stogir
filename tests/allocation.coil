(module stogir.tests.allocation)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as r)
(import "stogir.constraints" :as c)
(import "stogir.interval-queue" :as q)
(import "coil.result" :use [Some None Ok Err])
(import "stogir.frame" :as frame)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn preference-check [] (-> void)
  (let [allocator (malloc-allocator)
        (mut part) (a/create 1 allocator)
        (mut available) (ArrayList::new [i64] allocator)]
    (r/add! (mut (.ranges part)) 0 10)
    (for value [(: 100 i64) 100 100] (push! (mut available) value))
    (set! (.preferred part) 1)
    (assert (= (.register (a/free-decision part available 0 7 allocator)) 1))
    ; A hint with less than the full lifetime must not cause an extra split.
    (set! (mut available) 1 9)
    (assert (= (.register (a/free-decision part available 0 7 allocator)) 0))
    (assert (= (.register (a/free-decision-hinted part
                                                  available
                                                  0
                                                  7
                                                  2
                                                  allocator))
               2))
    ; Class restrictions and actual fixed requirements outrank preferences.
    (set! (mut available) 1 100)
    (assert (= (.register (a/free-decision part available 0 5 allocator)) 0))
    (assert (c/add! (mut (.uses part)) 0 2 2))
    (assert (= (.register (a/free-decision part available 0 7 allocator)) 2))
    (clear! (mut (.uses part)))
    (assert (c/add! (mut (.uses part)) 5 2 0))
    (assert (= (.register (a/free-decision part available 0 7 allocator)) 0))
    (set! (.hint part) 3)
    (set! (.hint-owner part) 4)
    (let [(mut child) (a/split! (mut part) 5 allocator)]
      (assert (= (.preferred child) 1))
      (assert (= (.hint child) 3))
      (assert (= (.hint-owner child) 4))
      (assert (= (.last-register child) -1))
      (a/release! (mut child)))
    (a/release! (mut part))
    (free! (mut available))))

(defn spill-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut heap) (ArrayList::new [q/Item] allocator)
        (mut layout) (frame/create allocator)
        (mut initial) (a/create 12 allocator)]
    (r/add! (mut (.ranges initial)) 0 30)
    (c/add! (mut (.uses initial)) 10 1 -1)
    (push! (mut parts) initial)
    (match (a/spill-prefix! (mut parts) (mut heap) 0 (mut layout) 8 8 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [slot] (when (!= slot 0) (set! failures (+ failures 1)))))
    (when (!= (len parts) 2) (set! failures (+ failures 1)))
    (let [prefix (at parts 0)
          suffix (at parts 1)]
      (when (!= (.end (get (.ranges prefix) 0)) 10)
        (set! failures (+ failures 1)))
      (when (!= (.spill-slot suffix) (.spill-slot prefix))
        (set! failures (+ failures 1))))
    (match (q/take! (mut heap))
      (None [] (set! failures (+ failures 1)))
      (Some [item]
            (when (!= (.position item) 10) (set! failures (+ failures 1)))))
    (match (a/spill-prefix! (mut parts) (mut heap) 1 (mut layout) 8 8 allocator)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (let [prefix (elem (mut parts) 0)
          suffix (elem (mut parts) 1)]
      (a/release! prefix)
      (a/release! suffix))
    (free! (mut parts))
    (free! (mut heap))
    (frame/release! (mut layout))
    failures))

(defn eviction-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut heap) (ArrayList::new [q/Item] allocator)
        (mut layout) (frame/create allocator)
        (mut initial) (a/create 15 allocator)]
    (r/add! (mut (.ranges initial)) 0 30)
    (c/add! (mut (.uses initial)) 10 1 -1)
    (set! (.register initial) 3)
    (push! (mut parts) initial)
    (match (a/evict! (mut parts) (mut heap) 0 5 (mut layout) 8 8 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [_] 0))
    (when (!= (len parts) 3) (set! failures (+ failures 1)))
    (when (= (len parts) 3)
      (let [prefix (at parts 0)
            spilled (at parts 1)
            resumed (at parts 2)]
        (when (!= (.register prefix) 3) (set! failures (+ failures 1)))
        (when (!= (.end (get (.ranges prefix) 0)) 5)
          (set! failures (+ failures 1)))
        (when (!= (.start (get (.ranges spilled) 0)) 5)
          (set! failures (+ failures 1)))
        (when (!= (.end (get (.ranges spilled) 0)) 10)
          (set! failures (+ failures 1)))
        (when (!= (.spill-slot spilled) (.spill-slot resumed))
          (set! failures (+ failures 1)))))
    (match (q/take! (mut heap))
      (None [] (set! failures (+ failures 1)))
      (Some [item]
            (when (!= (.position item) 10) (set! failures (+ failures 1)))))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    (free! (mut heap))
    (frame/release! (mut layout))
    failures))

(defn pressure-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut current) (a/create 1 allocator)
        (mut owner) (a/create 2 allocator)
        (mut fixed) (a/create 3 allocator)]
    (r/add! (mut (.ranges current)) 0 30)
    (r/add! (mut (.ranges owner)) 0 10)
    (c/add! (mut (.uses owner)) 4 1 -1)
    (set! (.register owner) 0)
    (r/add! (mut (.ranges fixed)) 15 16)
    (c/add! (mut (.uses fixed)) 15 2 1)
    (push! (mut parts) current)
    (push! (mut parts) owner)
    (push! (mut parts) fixed)
    (let [(mut pressure) (a/pressure parts 0 3 allocator)]
      (when (!= (get (.free pressure) 0) 0) (set! failures (+ failures 1)))
      (when (!= (get (.next-use pressure) 0) 4) (set! failures (+ failures 1)))
      (when (!= (get (.free pressure) 1) 15) (set! failures (+ failures 1)))
      (when (!= (get (.fixed-at pressure) 1) 15) (set! failures (+ failures 1)))
      (when (!= (get (.free pressure) 2) 0x7FFFFFFFFFFFFFFF)
        (set! failures (+ failures 1)))
      (a/release-pressure! (mut pressure)))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    failures))

(defn main [] (-> i64)
  (preference-check)
  (let [allocator (malloc-allocator)
        (mut parent) (a/create 7 allocator)
        (mut failures) (+ (spill-check) (eviction-check) (pressure-check))]
    (r/add! (mut (.ranges parent)) 0 10)
    (r/add! (mut (.ranges parent)) 20 30)
    (c/add! (mut (.uses parent)) 4 1 -1)
    (c/add! (mut (.uses parent)) 20 2 0)
    (set! (.register parent) 3)
    (set! (.spill-slot parent) 16)
    (let [(mut availability) (ArrayList::new [i64] allocator)]
      (push! (mut availability) 100)
      (push! (mut availability) 100)
      (let [initial (a/free-decision parent availability 0 3 allocator)
            fixed (a/free-decision parent availability 20 3 allocator)]
        (when (!= (.register initial) 0) (set! failures (+ failures 1)))
        (when (!= (.until initial) 100) (set! failures (+ failures 1)))
        (when (!= (.register fixed) 0) (set! failures (+ failures 1))))
      (set! (mut availability) 0 10)
      (let [choice (a/free-decision parent availability 0 3 allocator)]
        (when (!= (.register choice) 1) (set! failures (+ failures 1)))
        (when (!= (.until choice) 20) (set! failures (+ failures 1))))
      (free! (mut availability)))
    (let [(mut owner-next) (ArrayList::new [i64] allocator)
          (mut fixed-at) (ArrayList::new [i64] allocator)]
      (push! (mut owner-next) 30)
      (push! (mut owner-next) 40)
      (push! (mut fixed-at) 100)
      (push! (mut fixed-at) 100)
      (let [evict (a/blocked-decision parent owner-next fixed-at 0 3)]
        (when (!= (.action evict) 1) (set! failures (+ failures 1)))
        (when (!= (.register evict) 1) (set! failures (+ failures 1))))
      (set! (mut owner-next) 0 1)
      (set! (mut owner-next) 1 2)
      (let [spill (a/blocked-decision parent owner-next fixed-at 0 3)]
        (when (!= (.action spill) 0) (set! failures (+ failures 1)))
        (when (!= (.next-use spill) 4) (set! failures (+ failures 1))))
      (set! (mut fixed-at) 0 20)
      (let [impossible (a/blocked-decision parent owner-next fixed-at 20 3)]
        (when (!= (.action impossible) 2) (set! failures (+ failures 1))))
      (free! (mut owner-next))
      (free! (mut fixed-at)))
    (let [(mut child) (a/split! (mut parent) 15 allocator)]
      (when (!= (.parent child) 7) (set! failures (+ failures 1)))
      (when (!= (.register child) -1) (set! failures (+ failures 1)))
      (when (!= (.spill-slot child) 16) (set! failures (+ failures 1)))
      (when (!= (len (.ranges parent)) 1) (set! failures (+ failures 1)))
      (when (!= (len (.ranges child)) 1) (set! failures (+ failures 1)))
      (when (!= (len (.uses parent)) 1) (set! failures (+ failures 1)))
      (when (!= (.register (get (.uses child) 0)) 0)
        (set! failures (+ failures 1)))
      (when (a/covers? parent 20) (set! failures (+ failures 1)))
      (when (not (a/covers? child 20)) (set! failures (+ failures 1)))
      (let [(mut tail) (a/split! (mut child) 20 allocator)]
        (when (!= (len (.ranges child)) 0) (set! failures (+ failures 1)))
        (when (!= (len (.uses child)) 0) (set! failures (+ failures 1)))
        (when (!= (len (.uses tail)) 1) (set! failures (+ failures 1)))
        (a/release! (mut tail)))
      (a/release! (mut child)))
    (let [(mut parts) (ArrayList::new [a/Part] allocator)
          (mut heap) (ArrayList::new [q/Item] allocator)
          (mut available) (ArrayList::new [i64] allocator)
          (mut initial) (a/create 9 allocator)]
      (r/add! (mut (.ranges initial)) 0 30)
      (c/add! (mut (.uses initial)) 20 2 0)
      (push! (mut parts) initial)
      (push! (mut available) 10)
      (push! (mut available) 100)
      (when (not (a/grant-free! (mut parts) (mut heap) 0 available 3 allocator))
        (set! failures (+ failures 1)))
      (when (!= (len parts) 2) (set! failures (+ failures 1)))
      (let [prefix (at parts 0)
            suffix (at parts 1)]
        (when (!= (.register prefix) 1) (set! failures (+ failures 1)))
        (when (!= (.end (get (.ranges prefix) 0)) 20)
          (set! failures (+ failures 1)))
        (when (!= (.register suffix) -1) (set! failures (+ failures 1))))
      (match (q/take! (mut heap))
        (Some [item]
              (when (!= (.position item) 20) (set! failures (+ failures 1))))
        (None [] (set! failures (+ failures 1))))
      (let [prefix (elem (mut parts) 0)
            suffix (elem (mut parts) 1)]
        (a/release! prefix)
        (a/release! suffix))
      (free! (mut parts))
      (free! (mut heap))
      (free! (mut available)))
    (a/release! (mut parent))
    (println "split allocation checks: {} failures" failures)
    (if (= failures 0) 0 1)))
