(module stogir.tests.checked)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.checked" :as checked)
(import "stogir.checked-schedule" :as cs)
(import "stogir.a64.checked" :as native)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn rejected [(value (Result i32 (slice u8)))] (-> i64)
  (match value (Ok [_] 1) (Err [_] 0)))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 2 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 2 [start (: 0 i32) 1]))
        one (require (b/scalar-constant! (mut graph) 2 1 8))
        two (require (b/scalar-constant! (mut graph) 2 2 8))
        maximum (require (b/scalar-constant! (mut graph) 2 255 8))
        sum (require (checked/build! (mut graph) 41 2 8 p q))
        same (require (checked/build! (mut graph) 41 2 8 q p))
        product (require (checked/build! (mut graph) 43 2 8 p q))
        product-reversed (require (checked/build! (mut graph) 43 2 8 q p))
        difference (require (checked/build! (mut graph) 42 2 8 p q))
        reversed (require (checked/build! (mut graph) 42 2 8 q p))
        folded (require (checked/build! (mut graph) 41 2 8 one one))
        retained (require (checked/build! (mut graph) 41 2 8 maximum one))
        flag (require (checked/overflow! (mut graph) sum))
        same-flag (require (checked/overflow! (mut graph) sum))
        false-value (require (b/scalar-constant! (mut graph) 1 0 8))
        folded-flag (require (checked/overflow! (mut graph) folded))
        (mut failures)
          (+ (rejected (checked/build! (mut graph) 41 1 8 p q))
             (rejected (checked/build! (mut graph) 41 3 8 p q))
             (rejected (checked/build! (mut graph) 26 2 8 p q))
             (rejected (checked/overflow! (mut graph) start)))]
    (when (or (<= sum 0)
              (!= sum same)
              (!= product product-reversed)
              (= difference reversed)
              (!= folded two)
              (<= retained 0)
              (<= flag 0)
              (!= flag same-flag)
              (!= folded-flag false-value))
      (set! failures (+ failures 1)))
    ;; A delayed projection must be clustered ahead of another flag producer.
    (let [(mut nodes) (ArrayList::new [i32] (malloc-allocator))
          duplicate (require (b/emit! (mut graph) 44 1 [sum]))]
      (push! (mut nodes) sum)
      (push! (mut nodes) flag)
      (push! (mut nodes) duplicate)
      (match (cs/validate-nodes graph nodes)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [count] (when (!= count 2) (set! failures (+ failures 1)))))
      (set! (mut nodes) 1 product)
      (set! failures (+ failures (rejected (cs/validate-nodes graph nodes))))
      (free! (mut nodes)))
    (require (b/patch! (mut graph) sum 1 one))
    (when (= sum (require (checked/build! (mut graph) 41 2 8 p q)))
      (set! failures (+ failures 1)))
    ;; A value-only multiply needs no high-half work or flag instructions.
    (let [(mut code) (ArrayList::new [u8] (malloc-allocator))]
      (match (native/arithmetic! (mut code) 43 11 0 1 2 false)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [size]
            (when (or (!= size 4) (!= (len code) 4))
              (set! failures (+ failures 1)))))
      (set! failures
            (+ failures
               (rejected (native/arithmetic! (mut code) 43 11 16 1 2 true))))
      (when (!= (len code) 4) (set! failures (+ failures 1)))
      (free! (mut code)))
    (g/release! (mut graph))
    (println "checked builder/folding checks: {} failures" failures)
    (if (= failures 0) 0 1)))
