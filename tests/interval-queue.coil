(module stogir.tests.interval-queue)
(import "stogir.interval-queue" :as q)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Some None])

(defn main [] (-> i64)
  (let [(mut heap) (ArrayList::new [q/Item] (malloc-allocator))
        (mut failures) 0
        (mut i) (: 1023 i32)
        (mut previous) (: -1 i64)]
    (while (>= i 0)
      (q/insert! (mut heap) (q/Item :position (% (cast i64 i) 17) :interval i))
      (set! i (- i 1)))
    (set! i 0)
    (while (< i 1024)
      (match (q/take! (mut heap))
        (None [] (set! failures (+ failures 1)))
        (Some [item]
              (do
                (when (< (.position item) previous)
                  (set! failures (+ failures 1)))
                (set! previous (.position item)))))
      (set! i (+ i 1)))
    (match (q/take! (mut heap))
      (Some [_] (set! failures (+ failures 1)))
      (None [] 0))
    (free! (mut heap))
    (println "interval queue checks: {} failures" failures)
    (if (= failures 0) 0 1)))
