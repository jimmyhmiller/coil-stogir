(module stogir.tests.jit-checked)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.types" :as types)
(import "stogir.calls" :as calls)
(import "stogir.checked" :as checked)
(import "stogir.a64.compile" :as compile)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Some None])

(defstruct Expected [(value u64) (overflow? bool)])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn expected [(opcode i32) (ty i32) (a u64) (b u64)] (-> Expected)
  (let [width (* 8 (types/scalar-size ty 8))
        modulus (<< (: 1 u128) (cast u128 width))
        mask (cast u64 (- modulus 1))
        x (& a mask)
        y (& b mask)
        (mut bits) (: 0 u64)
        (mut overflow?) false]
    (if (types/signed? ty)
        (let [limit (cast i128 (/ modulus 2))
              sx
                (if (>= (cast u128 x) (/ modulus 2))
                    (- (cast i128 x) (cast i128 modulus))
                    (cast i128 x))
              sy
                (if (>= (cast u128 y) (/ modulus 2))
                    (- (cast i128 y) (cast i128 modulus))
                    (cast i128 y))
              value
                (if (= opcode 41)
                    (+ sx sy)
                    (if (= opcode 42) (- sx sy) (* sx sy)))]
          (set! bits (& (cast u64 value) mask))
          (set! overflow? (or (< value (- 0 limit)) (> value (- limit 1)))))
        (do
          (set! overflow?
                (if (= opcode 41)
                    (> y (- mask x))
                    (if (= opcode 42) (< x y) (and (!= x 0) (> y (/ mask x))))))
          (set! bits
                (& (cast u64
                         (if (= opcode 41)
                             (+ (cast u128 x) (cast u128 y))
                             (if (= opcode 42)
                                 (- (+ (cast u128 x) modulus) (cast u128 y))
                                 (* (cast u128 x) (cast u128 y)))))
                   mask))))
    (Expected
      :overflow? overflow?
      :value
        (if (and (types/signed? ty) (>= (cast u128 bits) (/ modulus 2)))
            (cast u64 (- (cast i128 bits) (cast i128 modulus)))
            bits))))

;;; Four register/literal combinations, plus a value-only checked result whose
;;; dead flags must not require overflow work. Return predicate and store value.
(defn check [(opcode i32) (ty u8) (mode i32) (clobber u64)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 1]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 3]))
        width (* 8 (types/scalar-size (cast i32 ty) 8))
        mask (cast u64 (- (<< (: 1 u128) (cast u128 width)) 1))
        literal-a (<< (: 1 u64) (cast u64 (- width 1)))
        literal-b mask
        left
          (if (or (= mode 1) (= mode 3))
              (require (b/scalar-constant! (mut graph)
                                           (cast i32 ty)
                                           literal-a
                                           8))
              p)
        right
          (if (or (= mode 2) (= mode 3))
              (require (b/scalar-constant! (mut graph)
                                           (cast i32 ty)
                                           literal-b
                                           8))
              q)
        arithmetic
          (require (b/emit! (mut graph) opcode (cast i32 ty) [left right]))
        primary-overflow
          (require (if (= mode 4)
                       (b/scalar-constant! (mut graph) 1 0 8)
                       (b/overflow! (mut graph) arithmetic)))
        ;; Keep a second producer/projection live, then query the first one.
        ;; Its multiply-by-one projection is false for every tested width.
        other
          (if (= mode 5)
              (let [one
                      (require (b/scalar-constant! (mut graph)
                                                   (cast i32 ty)
                                                   1
                                                   8))
                    producer
                      (require (b/emit! (mut graph) 43 (cast i32 ty) [p one]))]
                (require (b/overflow! (mut graph) producer)))
              (if (= mode 6)
                  (require (b/emit! (mut graph) 44 1 [arithmetic]))
                  primary-overflow))
        overflow
          (if (>= mode 5)
              (require (b/integer-binary! (mut graph)
                                          46
                                          1
                                          8
                                          primary-overflow
                                          other))
              primary-overflow)
        extend? (< width 64)
        result-type
          (if extend? (if (types/signed? (cast i32 ty)) 11 5) (cast i32 ty))
        value
          (if extend?
              (require (b/emit! (mut graph)
                                (if (types/signed? (cast i32 ty)) 33 34)
                                result-type
                                [arithmetic]))
              arithmetic)
        stored (require (b/emit! (mut graph) 93 0 [start output value]))
        ret
          (let [(mut control) stored]
            (when (= mode 7)
              (match (calls/create 0 0 [] allocator)
                (Err [_] 0)
                (Ok [prototype]
                    (let [(mut owned) prototype]
                      (set! control
                            (require (calls/emit! (mut graph)
                                                  owned
                                                  stored
                                                  target
                                                  []
                                                  allocator)))
                      (calls/release! (mut owned)))))
              ;; Keep the wrapped result live across the call as well as its flag.
              (set! control
                    (require (b/emit! (mut graph) 93 0 [control output value]))))
            (if (= mode 8)
                (let [split
                        (require (b/emit! (mut graph) 116 0 [control overflow]))
                      yes
                        (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
                      no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
                      yes-end (require (b/emit! (mut graph) 114 0 [yes]))
                      no-end (require (b/emit! (mut graph) 114 0 [no]))
                      merge
                        (require (b/emit! (mut graph) 112 0 [yes-end no-end]))
                      yes-value (require (b/scalar-constant! (mut graph) 1 1 8))
                      no-value (require (b/scalar-constant! (mut graph) 1 0 8))
                      phi
                        (require (b/emit! (mut graph)
                                          67
                                          1
                                          [merge yes-value no-value]))]
                  (require (b/emit! (mut graph) 120 1 [merge phi (: 0 i32)])))
                (require (b/emit! (mut graph)
                                  120
                                  1
                                  [control overflow (: 0 i32)]))))
        (mut failures) 0]
    (match (calls/create 0 1 [ty ty (: 6 u8) 6] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype]
            (require (calls/function! (mut graph) owned allocator))
            (calls/release! (mut owned)))))
    (match (compile/text graph start [ret] allocator)
      (Err [message]
           (do
             (println "compile op={} ty={} mode={}: {}" opcode ty mode message)
             (set! failures (+ failures 1))))
      (Ok [compiled]
          (let [(mut code) compiled]
            (match (jit/map-text (slice code))
              (Err [_] (set! failures (+ failures 1)))
              (Ok [loaded]
                  (let [(mut owned) loaded
                        f
                          (primitive/cast (fnptr (cc/C)
                                                 [u64 u64 (ptr u64) u64]
                                                 u64)
                                          (.base owned))
                        (mut actual-value) (: 0 u64)]
                    (for a [(: 0 u64)
                            1
                            2
                            3
                            7
                            127
                            128
                            255
                            32767
                            32768
                            65535
                            0x7FFFFFFF
                            0x80000000
                            0xFFFFFFFF
                            0x7FFFFFFFFFFFFFFF
                            0x8000000000000000
                            0xFFFFFFFFFFFFFFFF
                            0xFEDCBA9876543210]
                      (for b [(: 0 u64)
                              1
                              2
                              3
                              127
                              128
                              255
                              32767
                              32768
                              65535
                              0x7FFFFFFF
                              0x80000000
                              0xFFFFFFFF
                              0x7FFFFFFFFFFFFFFF
                              0x8000000000000000
                              0xFFFFFFFFFFFFFFFF]
                        (let [x (if (or (= mode 1) (= mode 3)) literal-a a)
                              y (if (or (= mode 2) (= mode 3)) literal-b b)
                              wanted (expected opcode (cast i32 ty) x y)
                              actual-overflow
                                (call-ptr f a b (mut actual-value) clobber)
                              wanted-overflow
                                (if (and (!= mode 4) (.overflow? wanted))
                                    (: 1 u64)
                                    (: 0 u64))]
                          (when (or (!= actual-value (.value wanted))
                                    (!= actual-overflow wanted-overflow))
                            (when (= failures 0)
                              (println "op={} ty={} mode={} a={} b={} value expected={} actual={} overflow expected={} actual={}"
                                       opcode
                                       ty
                                       mode
                                       x
                                       y
                                       (.value wanted)
                                       actual-value
                                       wanted-overflow
                                       actual-overflow))
                            (set! failures (+ failures 1)))
                          (match (checked/evaluate opcode (cast i32 ty) 8 x y)
                            (None [] (set! failures (+ failures 1)))
                            (Some [evaluated]
                                  (when (or (!= (.bits evaluated)
                                                (& (.value wanted) mask))
                                            (!= (.overflow? evaluated)
                                                (.overflow? wanted)))
                                    (set! failures (+ failures 1))))))))
                    (jit/release! (mut owned)))))
            (free! (mut code)))))
    (g/release! (mut graph))
    failures))

(defn word! [(out (mut (ArrayList u8))) (value (Result u32 (slice u8)))]
  (-> void)
  (match value
    (Ok [word] (bytes/append32! (mut out) word))
    (Err [msg] (println "{}" msg))))

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut probe) (ArrayList::new [u8] (malloc-allocator))]
    ;; Destroy every allocatable GPR and both scratch registers, and set NZCV.
    (let [(mut register) (: 0 i32)]
      (while (< register 18)
        (word! (mut probe) (encode/move-wide true 2 register 0xA55A 0))
        (set! register (+ register 1))))
    (word! (mut probe) (encode/add-sub true true true 31 0 0))
    (word! (mut probe) (encode/ret 30))
    (match (jit/map-text (slice probe))
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [loaded]
          (let [(mut owned) loaded
                address (primitive/cast u64 (.base owned))]
            (for ty [(: 2 u8) 3 4 5 6 7 8 9 10 11]
              (for opcode [(: 41 i32) 42 43]
                (let [(mut mode) (: 0 i32)]
                  (while (< mode 9)
                    (set! failures (+ failures (check opcode ty mode address)))
                    (set! mode (+ mode 1))))))
            (jit/release! (mut owned)))))
    (free! (mut probe))
    (println "native checked arithmetic/projection checks: {} failures"
             failures)
    (if (= failures 0) 0 1)))
