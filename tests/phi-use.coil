(module stogir.tests.phi-use)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.cfg" :as cfg)
(import "stogir.placement" :as p)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.loops" :as loops)
(import "stogir.liveness" :as liveness)
(import "stogir.schedule" :as schedule)
(import "stogir.phi" :as phi-copies)
(import "stogir.register-live" :as reg-live)
(import "stogir.bitset" :as bits)
(import "stogir.live-ranges" :as ranges)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        entry (require (b/emit! (mut graph) 114 0 [start]))
        loop (require (b/loop-begin! (mut graph) entry))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        phi (require (b/loop-phi! (mut graph) loop zero))
        back (require (b/emit! (mut graph) 115 0 [loop]))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        next (require (b/integer-binary! (mut graph) 26 11 8 phi one))
        (mut failures) 0]
    (b/patch! (mut graph) loop 2 back)
    (b/patch! (mut graph) phi 3 next)
    (match (cfg/build graph a)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [blocks]
          (let [(mut owned) blocks]
            (match (p/pinned graph owned a)
              (Err [_] (set! failures (+ failures 1)))
              (Ok [mapping]
                  (let [(mut placed) mapping]
                    (when (!= (require (p/use-block graph placed phi 2)) start)
                      (set! failures (+ failures 1)))
                    (when (!= (require (p/use-block graph placed phi 3)) loop)
                      (set! failures (+ failures 1)))
                    (when (!= (require (p/use-block graph placed back 1)) loop)
                      (set! failures (+ failures 1)))
                    (match (p/use-block graph placed phi 4)
                      (Ok [_] (set! failures (+ failures 1)))
                      (Err [_] 0))
                    (let [(mut pred) (adj/build owned true a)
                          (mut succ) (adj/build owned false a)
                          (mut order) (adj/reverse-postorder owned succ start a)
                          (mut idom) (dom/build owned pred order a)
                          (mut depth) (loops/depths owned pred idom a)
                          (mut live) (liveness/mark graph [back phi] a)]
                      (match (p/early! graph (mut placed) idom start a)
                        (Ok [_] 0)
                        (Err [_] (set! failures (+ failures 1))))
                      (match (p/late! graph (mut placed) idom depth live a)
                        (Ok [_] 0)
                        (Err [_] (set! failures (+ failures 1))))
                      (when (!= (get placed (cast i64 next)) loop)
                        (set! failures (+ failures 1)))
                      (match (schedule/order graph placed live a)
                        (Err [msg]
                             (do
                               (println "{}" msg)
                               (set! failures (+ failures 1))))
                        (Ok [ordered]
                            (let [(mut local) ordered
                                  (mut packed)
                                    (schedule/pack local placed order a)
                                  range (get (.ranges packed) (cast i64 loop))]
                              (when (!= (.count range) 4)
                                (set! failures (+ failures 1)))
                              (when (!= (get (.nodes packed) (.offset range))
                                        loop)
                                (set! failures (+ failures 1)))
                              (when (!= (get (.nodes packed)
                                             (+ (.offset range) 1))
                                        phi)
                                (set! failures (+ failures 1)))
                              (when (!= (get (.nodes packed)
                                             (+ (.offset range) 2))
                                        next)
                                (set! failures (+ failures 1)))
                              (when (!= (get (.nodes packed)
                                             (+ (.offset range) 3))
                                        back)
                                (set! failures (+ failures 1)))
                              (let [(mut edge-uses)
                                      (bits/create (len (.instructions graph))
                                                   a)
                                    (mut initial-uses)
                                      (bits/create (len (.instructions graph))
                                                   a)
                                    (mut phi-defs)
                                      (reg-live/phi-defs graph packed loop a)
                                    (mut input)
                                      (bits/create (len (.instructions graph))
                                                   a)
                                    (mut output)
                                      (bits/create (len (.instructions graph))
                                                   a)]
                                (reg-live/phi-edge-uses! (mut edge-uses)
                                                         graph
                                                         packed
                                                         loop
                                                         2)
                                (reg-live/phi-edge-uses! (mut initial-uses)
                                                         graph
                                                         packed
                                                         loop
                                                         1)
                                (when (not (bits/contains? edge-uses
                                                           (cast i64 next)))
                                  (set! failures (+ failures 1)))
                                (when (bits/contains? initial-uses
                                                      (cast i64 next))
                                  (set! failures (+ failures 1)))
                                (bits/add! (mut input) (cast i64 phi))
                                (reg-live/edge-transfer! (mut output)
                                                         input
                                                         phi-defs
                                                         edge-uses)
                                (when (bits/contains? output (cast i64 phi))
                                  (set! failures (+ failures 1)))
                                (when (not (bits/contains? output
                                                           (cast i64 next)))
                                  (set! failures (+ failures 1)))
                                (bits/release! (mut edge-uses))
                                (bits/release! (mut initial-uses))
                                (bits/release! (mut phi-defs))
                                (bits/release! (mut input))
                                (bits/release! (mut output)))
                              (let [(mut analysis)
                                      (reg-live/analyze graph
                                                        owned
                                                        packed
                                                        order
                                                        a)
                                    state
                                      (elem (mut (.states analysis))
                                            (get (.indices analysis)
                                                 (cast i64 loop)))]
                                (when (not (bits/contains? (.output state)
                                                           (cast i64 next)))
                                  (set! failures (+ failures 1)))
                                (when (bits/contains? (.input state)
                                                      (cast i64 phi))
                                  (set! failures (+ failures 1)))
                                (when (bits/contains? (.input state)
                                                      (cast i64 next))
                                  (set! failures (+ failures 1)))
                                (let [(mut intervals)
                                        (ranges/build graph
                                                      packed
                                                      analysis
                                                      order
                                                      a)
                                      update (at intervals (cast i64 next))
                                      incoming (at intervals (cast i64 phi))]
                                  (when (!= (len (.ranges update)) 1)
                                    (set! failures (+ failures 1)))
                                  (when (= (len (.ranges update)) 1)
                                    (let [span (get (.ranges update) 0)]
                                      (when (!= (.start span)
                                                (+ (* (+ (.offset range) 2) 2)
                                                   1))
                                        (set! failures (+ failures 1)))
                                      (when (!= (.end span)
                                                (* (+ (.offset range)
                                                      (.count range))
                                                   2))
                                        (set! failures (+ failures 1)))))
                                  (when (= (len (.ranges incoming)) 0)
                                    (set! failures (+ failures 1)))
                                  (ranges/release! (mut intervals)))
                                (reg-live/release-analysis! (mut analysis)))
                              (schedule/release! (mut packed))
                              (free! (mut local)))))
                      (free! (mut live))
                      (free! (mut depth))
                      (free! (mut idom))
                      (free! (mut order))
                      (adj/release! (mut pred))
                      (adj/release! (mut succ)))
                    (free! (mut placed)))))
            (let [(mut copies) (phi-copies/collect graph owned a)]
              (when (!= (len copies) 2) (set! failures (+ failures 1)))
              (when (= (len copies) 2)
                (let [initial (get copies 0)
                      update (get copies 1)]
                  (when (!= (.source initial) zero)
                    (set! failures (+ failures 1)))
                  (when (!= (.source update) next)
                    (set! failures (+ failures 1)))
                  (when (!= (.destination initial) phi)
                    (set! failures (+ failures 1)))
                  (when (!= (.destination update) phi)
                    (set! failures (+ failures 1)))
                  (when (= (.edge initial) (.edge update))
                    (set! failures (+ failures 1)))))
              (free! (mut copies)))
            (cfg/release! (mut owned)))))
    (g/release! (mut graph))
    (println "phi use checks: {} failures" failures)
    (if (= failures 0) 0 1)))
