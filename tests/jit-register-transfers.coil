(module stogir.tests.jit-register-transfers)
(import "stogir.a64.transfers" :as transfer)
(import "stogir.a64.encode" :as e)
(import "stogir.locations" :as loc)
(import "stogir.bytes" :as bytes)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn word! [(out (mut (ArrayList u8))) (result (Result u32 (slice u8)))]
  (-> i64)
  (match result
    (Err [msg] (do (println "{}" msg) 1))
    (Ok [word] (do (bytes/append32! (mut out) word) 0))))

(defn copy [(src-kind i32) (src i64) (dst-kind i32) (dst i64)] (-> loc/Transfer)
  (loc/Transfer
    :position 0
    :parent 0
    :source (loc/Location :kind src-kind :value src)
    :destination (loc/Location :kind dst-kind :value dst)))

;;; Raw payloads intentionally include NaNs and signed zeros. The operations are
;;; physical moves only; no floating arithmetic may canonicalize those bits.
(defn check [(size i32) (mode i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut code) (ArrayList::new [u8] allocator)
        (mut copies) (ArrayList::new [loc/Transfer] allocator)
        (mut cells) (ArrayList::new [u64] allocator)
        mixed? (= mode 1)
        (mut failures) 0]
    (set! failures
          (+ failures
             (word! (mut code) (e/add-sub-immediate true true false 31 31 32))))
    (set! failures
          (+ failures
             (word! (mut code) (e/scalar-transfer (= size 8) true 0 4))))
    (set! failures
          (+ failures
             (word! (mut code) (e/scalar-transfer (= size 8) true 1 3))))
    (set! failures
          (+ failures (word! (mut code) (e/load-store false size 3 31 0))))
    (set! failures
          (+ failures (word! (mut code) (e/load-store false size 4 31 8))))
    (if (>= mode 2)
        (if (= mode 2)
            (do
              (push! (mut copies) (copy 0 32 1 0))
              (push! (mut copies) (copy 1 0 0 32)))
            (do
              (push! (mut copies) (copy 1 0 0 32))
              (push! (mut copies) (copy 0 32 1 0))))
        (if mixed?
            (do
              (push! (mut copies) (copy 0 1 0 32))
              (push! (mut copies) (copy 0 32 0 2))
              (push! (mut copies) (copy 0 2 1 0))
              (push! (mut copies) (copy 1 0 0 1)))
            (do
              (push! (mut copies) (copy 0 1 0 2))
              (push! (mut copies) (copy 0 2 0 1))
              (push! (mut copies) (copy 0 32 0 33))
              (push! (mut copies) (copy 0 33 0 32))
              (push! (mut copies) (copy 1 0 1 8))
              (push! (mut copies) (copy 1 8 1 0)))))
    (match (transfer/parallel! (mut code) (slice copies) size 16 17 allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (set! failures
          (+ failures (word! (mut code) (e/load-store false size 1 0 0))))
    (set! failures
          (+ failures (word! (mut code) (e/load-store false size 2 0 8))))
    (set! failures
          (+ failures
             (word! (mut code) (e/floating-load-store false size 0 0 16))))
    (set! failures
          (+ failures
             (word! (mut code) (e/floating-load-store false size 1 0 24))))
    (set! failures
          (+ failures (word! (mut code) (e/load-store true size 10 31 0))))
    (set! failures
          (+ failures (word! (mut code) (e/load-store false size 10 0 32))))
    (set! failures
          (+ failures (word! (mut code) (e/load-store true size 10 31 8))))
    (set! failures
          (+ failures (word! (mut code) (e/load-store false size 10 0 40))))
    (set! failures
          (+ failures
             (word! (mut code) (e/add-sub-immediate true false false 31 31 32))))
    (set! failures (+ failures (word! (mut code) (e/ret 30))))
    (for initial [(: 0 u64) 0 0 0 0 0] (push! (mut cells) initial))
    (match (jit/map-text (slice code))
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [loaded]
          (let [(mut image) loaded
                f
                  (primitive/cast (fnptr (cc/C)
                                         [(ptr u64) u64 u64 u64 u64]
                                         void)
                                  (.base image))
                mask (if (= size 8) (: 0xFFFFFFFFFFFFFFFF u64) 0xFFFFFFFF)]
            (for a [(: 0 u64)
                    1
                    0x80000000
                    0x7FC12345
                    0x8000000000000000
                    0x7FF8123456789ABC
                    0xFFFFFFFFFFFFFFFF]
              (let [b (^ a (: 0x123456789ABCDEF0 u64))
                    c (^ a (: 0xFEDCBA9876543210 u64))
                    d (^ a (: 0xFFFFFFFFFFFFFFFF u64))
                    expected
                      (if (>= mode 2)
                          [a b c c d d]
                          (if mixed? [c d a c b d] [b a c d d c]))
                    (mut index) (: 0 i64)]
                (call-ptr f (.data cells) a b c d)
                (for wanted expected
                  (when (!= (get cells index) (& wanted mask))
                    (when (= failures 0)
                      (println "transfer size={} mixed={} index={} wanted={} actual={}"
                               size
                               mixed?
                               index
                               (& wanted mask)
                               (get cells index)))
                    (set! failures (+ failures 1)))
                  (set! index (+ index 1)))))
            (jit/release! (mut image)))))
    (free! (mut cells))
    (free! (mut copies))
    (free! (mut code))
    failures))

(defn invalid [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut out) (ArrayList::new [u8] allocator)
        source (loc/Location :kind 0 :value 32)
        bad-slot (loc/Location :kind 1 :value 3)
        bad-register (loc/Location :kind 0 :value 64)
        (mut failures) 0]
    (bytes/append32! (mut out) 0x12345678)
    (match (transfer/emit! (mut out) source bad-slot 8 17)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (transfer/emit! (mut out) bad-register source 8 17)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (transfer/parallel! (mut out) [(copy 0 32 1 3)] 8 16 17 allocator)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (when (!= (len out) 4) (set! failures (+ failures 1)))
    (free! (mut out))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (check 4 0)
             (check 8 0)
             (check 4 1)
             (check 8 1)
             (check 4 2)
             (check 8 2)
             (check 4 3)
             (check 8 3)
             (invalid))]
    (println "native GPR/SIMD/stack parallel transfers: {} failures" failures)
    (if (= failures 0) 0 1)))
