(module stogir.tests.loop-block-order)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.loops" :as loops)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.result" :use [Ok Err])

;;; Literal scanning reference for pinned ir_gcm.c:ir_fix_bb_order, without heap.
(defn reference [(blocks cfg/Blocks) (succ adj/Index) (depth (ArrayList i32))]
  (-> (ArrayList i32))
  (let [a (malloc-allocator)
        (mut seen) (ArrayList::new [bool] a)
        (mut stack) (ArrayList::new [i32] a)
        (mut post) (ArrayList::new [i32] a)
        (mut result) (ArrayList::new [i32] a)]
    (for [i 0 (len (.membership blocks))] (push! (mut seen) false))
    (push! (mut stack) 1)
    (set! (mut seen) 1 true)
    (while (> (len stack) 0)
      (let [block (get stack (- (len stack) 1))
            range (get (.ranges succ) (cast i64 block))
            (mut i) (.count range)
            (mut best) (: 0 i32)]
        (while (> i 0)
          (set! i (- i 1))
          (let [edge
                  (get (.edges blocks)
                       (get (.edges succ) (+ (.offset range) i)))
                target (.to edge)]
            (when (not (get seen (cast i64 target)))
              (when (or (= best 0)
                        (< (get depth (cast i64 target))
                           (get depth (cast i64 best))))
                (set! best target)))))
        (if (> best 0)
            (do (set! (mut seen) (cast i64 best) true) (push! (mut stack) best))
            (do (pop! (mut stack)) (push! (mut post) block)))))
    (for [i 0 (len post)]
      (push! (mut result) (get post (- (- (len post) 1) i))))
    (free! (mut seen))
    (free! (mut stack))
    (free! (mut post))
    result))

(defn mapped [(node i32) (count i32) (seed i32)] (-> i32)
  (if (= node 1)
      1
      (+ 2 (% (+ (- node 2) seed) (- count 1)))))

(defn back? [(kind i32) (from i32) (to i32)] (-> bool)
  (cond (= kind 0) (and (= from 4) (= to 2))
        (= kind 1) (or (and (= from 5) (= to 3)) (and (= from 7) (= to 2)))
        (= kind 2) (and (or (= from 6) (= from 7)) (= to 2))
        false))

;;; Multiple backedges to a header are unioned before increasing nesting depth.
;;; Irreducible cycles require separate analysis; this counts natural loops only.
(defn reference-depths [(blocks cfg/Blocks)
              (predecessors adj/Index)
              (idom (ArrayList i32))
              (allocator (dyn Allocator))]
  (-> (ArrayList i32))
  (let [(mut depth) (ArrayList::new [i32] allocator)
        (mut seen) (ArrayList::new [bool] allocator)
        (mut work) (ArrayList::new [i32] allocator)
        (mut i) 0]
    (while (< i (len (.membership blocks)))
      (push! (mut depth) 0)
      (push! (mut seen) false)
      (set! i (+ i 1)))
    (for header (.starts blocks)
      (clear! (mut work))
      (set! i 0)
      (while (< i (len seen)) (set! (mut seen) i false) (set! i (+ i 1)))
      (set! (mut seen) (cast i64 header) true)
      (let [incoming (get (.ranges predecessors) (cast i64 header))
            (mut backedge?) false
            (mut j) 0]
        (while (< j (.count incoming))
          (let [index (get (.edges predecessors) (+ (.offset incoming) j))
                edge (get (.edges blocks) index)
                source (.from edge)]
            (when (dom/dominates? idom header source)
              (set! backedge? true)
              (when (not (get seen (cast i64 source)))
                (set! (mut seen) (cast i64 source) true)
                (push! (mut work) source))))
          (set! j (+ j 1)))
        (when backedge?
          (let [(mut cursor) 0]
            (while (< cursor (len work))
              (let [block (get work cursor)
                    range (get (.ranges predecessors) (cast i64 block))
                    (mut k) 0]
                (while (< k (.count range))
                  (let [index (get (.edges predecessors) (+ (.offset range) k))
                        edge (get (.edges blocks) index)
                        source (.from edge)]
                    (when (and (!= (get idom (cast i64 source)) 0)
                               (not (get seen (cast i64 source))))
                      (set! (mut seen) (cast i64 source) true)
                      (push! (mut work) source)))
                  (set! k (+ k 1))))
              (set! cursor (+ cursor 1))))
          (for block (.starts blocks)
            (when (get seen (cast i64 block))
              (set! (mut depth)
                    (cast i64 block)
                    (+ (get depth (cast i64 block)) 1)))))))
    (free! (mut seen))
    (free! (mut work))
    depth))

(defn check [(kind i32) (seed i32) (fanout i32)] (-> i64)
  (let [a (malloc-allocator)
        count (match kind (0 6) (1 9) (2 8) (3 4) (5 5) (_ (+ fanout 2)))
        (mut blocks)
          (cfg/Blocks
            :starts (ArrayList::new [i32] a)
            :membership (ArrayList::new [i32] a)
            :edges (ArrayList::new [cfg/Edge] a))
        (mut pairs) (ArrayList::new [(array i32 2)] a)
        (mut needs-fix) false
        (mut failures) 0]
    (for [i 0 (+ (cast i64 count) 1)] (push! (mut (.membership blocks)) 0))
    (for [i 1 (+ (cast i64 count) 1)]
      (push! (mut (.starts blocks)) (cast i32 i)))
    (cond (= kind 0)
            (for pair [[(: 1 i32) 2]
                       [(: 2 i32) 3]
                       [(: 2 i32) 5]
                       [(: 3 i32) 4]
                       [(: 4 i32) 2]
                       [(: 5 i32) 6]]
              (push! (mut pairs) pair))
          (= kind 1)
            (for pair [[(: 1 i32) 2]
                       [(: 2 i32) 3]
                       [(: 2 i32) 8]
                       [(: 3 i32) 4]
                       [(: 3 i32) 6]
                       [(: 4 i32) 5]
                       [(: 5 i32) 3]
                       [(: 6 i32) 7]
                       [(: 7 i32) 2]
                       [(: 8 i32) 9]]
              (push! (mut pairs) pair))
          (= kind 2)
            (for pair [[(: 1 i32) 2]
                       [(: 2 i32) 3]
                       [(: 2 i32) 8]
                       [(: 3 i32) 4]
                       [(: 3 i32) 5]
                       [(: 4 i32) 6]
                       [(: 5 i32) 7]
                       [(: 6 i32) 2]
                       [(: 7 i32) 2]]
              (push! (mut pairs) pair))
          (= kind 3)
            (for pair [[(: 1 i32) 2]
                       [(: 1 i32) 3]
                       [(: 2 i32) 3]
                       [(: 3 i32) 2]
                       [(: 2 i32) 4]
                       [(: 3 i32) 4]]
              (push! (mut pairs) pair))
          (= kind 5)
            (for pair [[(: 1 i32) 2] [(: 2 i32) 3] [(: 4 i32) 5] [(: 5 i32) 4]]
              (push! (mut pairs) pair))
          :else
            (for [i 3 (+ (cast i64 count) 1)]
              (push! (mut pairs) [(: 1 i32) (cast i32 i)])
              (push! (mut pairs) [(cast i32 i) (: 2 i32)])))
    (for pair pairs
      (let [from (mapped (get pair 0) count seed)
            to (mapped (get pair 1) count seed)]
        (push! (mut (.edges blocks))
               (cfg/Edge
                 :from from
                 :to to
                 :source 0
                 :position 1))
        (when (and (or (!= kind 5) (< (get pair 0) 4))
                   (>= from to)
                   (not (back? kind (get pair 0) (get pair 1))))
          (set! needs-fix true))))
    (let [(mut pred) (adj/build blocks true a)
          (mut succ) (adj/build blocks false a)
          (mut order) (adj/reverse-postorder blocks succ 1 a)
          (mut idom) (dom/build blocks pred order a)
          (mut depth) (loops/depths blocks pred idom a)
          (mut expected-depth) (reference-depths blocks pred idom a)
          (mut expected) (ArrayList::new [i32] a)
          (mut changed) false]
      (assert (= (slice depth) (slice expected-depth)))
      (free! (mut expected-depth))
      (if (= kind 3)
          (for node order (push! (mut expected) node))
          (if needs-fix
              (do
                (free! (mut expected))
                (set! expected (reference blocks succ depth)))
              (for node (.starts blocks)
                (when (> (get idom (cast i64 node)) 0)
                  (push! (mut expected) node)))))
      (for [i 0 (len expected)]
        (when (!= (get order i) (get expected i)) (set! changed true)))
      (match (loops/reorder! blocks succ idom depth (mut order) a)
        (Err [message] (panic "{}" message))
        (Ok [actual] (when (!= actual changed) (set! failures (+ failures 1)))))
      (when (!= (len order) (len expected)) (set! failures (+ failures 1)))
      (for [i 0 (len expected)]
        (when (!= (get order i) (get expected i))
          (set! failures (+ failures 1))))
      (when (!= (get order 0) 1) (set! failures (+ failures 1)))
      (free! (mut expected))
      (free! (mut order))
      (free! (mut idom))
      (free! (mut depth))
      (adj/release! (mut pred))
      (adj/release! (mut succ)))
    (free! (mut pairs))
    (cfg/release! (mut blocks))
    (when (!= failures 0)
      (println "order kind={} seed={} fanout={} failures={}"
               kind
               seed
               fanout
               failures))
    failures))

;;; Dense Boolean full-clear reference versus stamped sparse membership. Cover
;;; every three-vertex directed graph and sampled four-vertex graphs, including
;;; detached/self/irreducible cycles, sparse references and duplicate backedges.
(defn epoch-graph [(bits u64) (vertices i32) (stride i32)] (-> void)
  (let [a (malloc-allocator)
        (mut blocks) (cfg/Blocks :starts (ArrayList::new [i32] a)
                                  :membership (ArrayList::new [i32] a)
                                  :edges (ArrayList::new [cfg/Edge] a))]
    (for [i 0 (+ 1 (* (cast i64 vertices) (cast i64 stride)))]
      (push! (mut (.membership blocks)) 0))
    (for [i 0 (cast i64 vertices)]
      (let [reference (cast i32 (+ 1 (* i (cast i64 stride))))]
        (push! (mut (.starts blocks)) reference)
        (set! (mut (.membership blocks)) (cast i64 reference) reference)))
    (for [from 0 (cast i64 vertices)]
      (for [to 0 (cast i64 vertices)]
        (when (!= (& bits (<< (: 1 u64) (cast u64 (+ (* from (cast i64 vertices)) to)))) 0)
          (let [source (cast i32 (+ 1 (* from (cast i64 stride))))
                target (cast i32 (+ 1 (* to (cast i64 stride))))
                edge (cfg/Edge :from source :to target :source source :position 1)]
            (push! (mut (.edges blocks)) edge)
            (when (and (!= (& bits 128) 0) (= from (- (cast i64 vertices) 1)) (= to 1))
              (push! (mut (.edges blocks)) edge))))))
    (let [(mut pred) (adj/build blocks true a)
          (mut succ) (adj/build blocks false a)
          (mut order) (adj/reverse-postorder blocks succ 1 a)
          (mut idom) (dom/build blocks pred order a)
          (mut dominance) (dom/build-index idom a)
          (mut actual) (loops/depths blocks pred idom a)
          (mut expected) (reference-depths blocks pred idom a)]
      (for ancestor (.starts blocks)
        (for block (.starts blocks)
          (assert (= (dom/dominates? idom ancestor block)
                     (dom/indexed-dominates? dominance ancestor block)))))
      (for invalid [(: 0 i32) -1 (cast i32 (+ (len idom) 1))]
        (assert (not (dom/indexed-dominates? dominance invalid 1)))
        (assert (not (dom/indexed-dominates? dominance 1 invalid))))
      (dom/release-index! (mut dominance))
      (assert (= (slice actual) (slice expected)))
      (free! (mut actual))
      (free! (mut expected))
      (free! (mut idom))
      (free! (mut order))
      (adj/release! (mut succ))
      (adj/release! (mut pred)))
    (cfg/release! (mut blocks))))

(defn main [] (-> i64)
  (for [bits 0 512]
    (epoch-graph (cast u64 bits) 3 1)
    (epoch-graph (cast u64 bits) 3 17))
  (for [seed 0 4096]
    (epoch-graph (& (+ (* (cast u64 seed) 1103515245) 12345) 65535) 4 7))
  (let [(mut failures) 0
        (mut cases) 0]
    (for kind [(: 0 i32) 1 2 3 5]
      (for [seed 0 64]
        (set! failures (+ failures (check kind (cast i32 seed) 0)))
        (set! cases (+ cases 1))))
    (for count [(: 1 i32) 2 7 64 2048]
      (set! failures (+ failures (check 4 0 count)))
      (set! cases (+ cases 1)))
    (println "loop-aware block ordering {} cases: {} failures" cases failures)
    (if (= failures 0) 0 1)))
