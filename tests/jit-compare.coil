(module stogir.tests.jit-compare)
(import "stogir.jit.darwin" :as jit)
(import "stogir.a64.encode" :as e)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.a64.select" :as select)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.compile" :as compile)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn expected [(opcode i32) (x i64) (y i64)] (-> i64)
  (let [ux (cast u64 x)
        uy (cast u64 y)
        value
          (match opcode
            (14 (= x y))
            (15 (!= x y))
            (16 (< x y))
            (17 (>= x y))
            (18 (<= x y))
            (19 (> x y))
            (20 (< ux uy))
            (21 (>= ux uy))
            (22 (<= ux uy))
            (23 (> ux uy))
            (_ false))]
    (if value 1 0)))

(defn check [(opcode i32)] (-> i64)
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0]
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
          constant (require (b/scalar-constant! (mut graph) 11 42 8))
          sum (require (b/emit! (mut graph) 47 11 [p constant]))
          product (require (b/emit! (mut graph) opcode 1 [p q]))
          ret (require (b/emit! (mut graph) 120 1 [start product (: 0 i32)]))]
      (match (compile/text graph start [ret] (malloc-allocator))
        (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
        (Ok [compiled]
            (let [(mut code) compiled]
              (for byte code (push! (mut text) byte))
              (free! (mut code)))))
      (g/release! (mut graph)))
    (match (jit/map-text (slice text))
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [image]
          (let [(mut owned) image
                f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (.base owned))]
            (when (!= (call-ptr f 100 2) (expected opcode 100 2))
              (set! failures (+ failures 1)))
            (when (!= (call-ptr f -42 5) (expected opcode -42 5))
              (set! failures (+ failures 1)))
            (let [(mut x) -100]
              (while (<= x 100)
                (let [(mut y) -4]
                  (while (<= y 4)
                    (when (!= (call-ptr f x y) (expected opcode x y))
                      (set! failures (+ failures 1)))
                    (set! y (+ y 1))))
                (set! x (+ x 1))))
            (for x [-9223372036854775808 -1 0 1 9223372036854775807]
              (for y [-9223372036854775808 -1 0 1 9223372036854775807]
                (when (!= (call-ptr f x y) (expected opcode x y))
                  (set! failures (+ failures 1)))))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1)))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1))))))
    (free! (mut text))
    failures))

(defn main [] (-> i64)
  (let [(mut opcode) (: 14 i32)
        (mut failures) 0]
    (while (<= opcode 23)
      (set! failures (+ failures (check opcode)))
      (set! opcode (+ opcode 1)))
    (println "all integer comparison checks: {} failures" failures)
    (if (= failures 0) 0 1)))
