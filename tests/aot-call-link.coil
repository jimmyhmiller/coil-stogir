(module stogir.tests.aot-call-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern stogir.call-test
        :as
        "stogir_call_test"
        :cc
        (cc/C)
        [u64 i64 i64]
        (-> i64))

(defn combine :cc (cc/C) [(a i64) (b i64) (c i64) (d i64)] (-> i64)
  (+ (+ (* a 3) (* b 5)) (+ (* c 7) (* d 11))))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of combine)))
        (mut p) -20
        (mut failures) 0]
    (while (<= p 20)
      (let [(mut q) -10]
        (while (<= q 10)
          (let [first (combine q p q 7)
                second (combine first p q first)
                expected (+ (+ second (* p q)) first)]
            (when (!= (stogir.call-test target p q) expected)
              (set! failures (+ failures 1))))
          (set! q (+ q 1))))
      (set! p (+ p 1)))
    (println "linked AOT call checks: {} failures" failures)
    (if (= failures 0) 0 1)))
