(module stogir.tests.a64-select)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.a64.select" :as s)
(import "stogir.a64.match" :as matching)
(import "stogir.pipeline" :as pipeline)
(import "stogir.register-live" :as live)
(import "stogir.live-ranges" :as ranges)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn shift-case [(ty i32)
                  (op i32)
                  (bits u64)
                  (constant-first bool)
                  (rule i32)
                  (amount u64)] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        arg (require (b/emit! (mut graph) 71 ty [start (: 0 i32) 0]))
        literal (require (b/scalar-constant! (mut graph) ty bits 8))
        value
          (require (b/emit! (mut graph)
                            op
                            ty
                            (if constant-first [literal arg] [arg literal])))
        result
          (match (s/arithmetic graph value)
            (Err [_] 1)
            (Ok [tile]
                (if (and (= (.rule tile) rule)
                         (= (.left tile) arg)
                         (= (.right tile) 0)
                         (= (.immediate tile) amount))
                    0
                    1)))]
    (g/release! (mut graph))
    result))

(defn logical-case [(ty i32)
                    (op i32)
                    (bits u64)
                    (constant-first bool)
                    (immediate? bool)] (-> i64)
  (let [a (malloc-allocator)
        wide (or (= ty 5) (= ty 11))
        width (case ty 1 1 2 8 8 8 3 16 9 16 4 32 10 32 64)
        word-mask
          (if wide
              (: 0xFFFFFFFFFFFFFFFF u64)
              (- (<< (: 1 u64) (cast u64 width)) 1))
        mask (& bits word-mask)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        arg (require (b/emit! (mut graph) 71 ty [start (: 0 i32) 0]))
        literal (require (b/scalar-constant! (mut graph) ty mask 8))
        value
          (require (b/emit! (mut graph)
                            op
                            ty
                            (if constant-first [literal arg] [arg literal])))
        ret (require (b/emit! (mut graph) 120 ty [start value (: 0 i32)]))
        (mut failures) 0]
    (match (s/arithmetic graph value)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [tile]
          (when (or (!= (.rule tile) (+ (if immediate? 41 6) (- op 46)))
                    (!= (.wide tile) wide)
                    (and immediate?
                         (or (!= (.left tile) arg) (!= (.right tile) 0))))
            (set! failures (+ failures 1)))))
    (g/release! (mut graph))
    failures))

;;; Fusion changes machine def/uses, while graph nodes and explicit roots remain intact.
(defn match-case [(protect bool) (shared bool)] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        cmp (require (b/emit! (mut graph) 16 1 [p q]))
        split (require (b/emit! (mut graph) 116 0 [start cmp]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        extended (require (b/emit! (mut graph) 34 11 [cmp]))
        yes-ret
          (require (b/emit! (mut graph)
                            120
                            11
                            [yes (if shared extended p) (: 0 i32)]))
        no-ret (require (b/emit! (mut graph) 120 11 [no q (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] (malloc-allocator))
        (mut failures) 0]
    (push! (mut roots) yes-ret)
    (push! (mut roots) no-ret)
    (when protect (push! (mut roots) cmp))
    (match (pipeline/prepare graph start (slice roots) (malloc-allocator))
      (Err [_] (set! failures 1))
      (Ok [prepared]
          (let [(mut owned) prepared]
            (match (matching/build graph
                                   (.schedule owned)
                                   (slice roots)
                                   true
                                   (malloc-allocator))
              (Err [_] (set! failures 1))
              (Ok [selected]
                  (let [(mut plan) selected
                        fused (not (or protect shared))
                        (mut analysis)
                          (live/analyze-matched graph
                                                (.blocks owned)
                                                (.schedule owned)
                                                (.order owned)
                                                (.operands plan)
                                                (malloc-allocator))
                        (mut intervals)
                          (ranges/build-matched graph
                                                (.schedule owned)
                                                analysis
                                                (.order owned)
                                                (.operands plan)
                                                (malloc-allocator))]
                    (when (!= (get (.omitted (.operands plan)) (cast i64 cmp))
                              fused)
                      (set! failures (+ failures 1)))
                    (when (!= (get (.comparisons plan) (cast i64 split))
                              (if fused cmp 0))
                      (set! failures (+ failures 1)))
                    (when (!= (= (len (.ranges (get intervals (cast i64 cmp))))
                                 0)
                              fused)
                      (set! failures (+ failures 1)))
                    (when fused
                      (let [inputs
                              (get (.ranges (.operands plan)) (cast i64 split))]
                        (when (!= (.count inputs) 2)
                          (set! failures (+ failures 1)))
                        (when (!= (get (.inputs (.operands plan))
                                       (.offset inputs))
                                  p)
                          (set! failures (+ failures 1)))
                        (when (!= (get (.inputs (.operands plan))
                                       (+ (.offset inputs) 1))
                                  q)
                          (set! failures (+ failures 1)))))
                    (ranges/release! (mut intervals))
                    (live/release-analysis! (mut analysis))
                    (matching/release! (mut plan)))))
            (pipeline/release! (mut owned)))))
    (free! (mut roots))
    (g/release! (mut graph))
    failures))

(defn division-selection [(ty i32) (exponent i32)] (-> void)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut graph) 71 ty [start (: 0 i32) 0]))
        width (cast i32 (* 8 (case ty 2 1 8 1 3 2 9 2 4 4 10 4 8)))
        constant
          (require (b/scalar-constant! (mut graph)
                                       ty
                                       (<< (: 1 u64) (cast u64 exponent))
                                       8))
        fallback
          (and (or (= ty 8) (= ty 9) (= ty 10) (= ty 11))
               (= exponent (- width 1)))]
    (for opcode [(: 29 i32) 30]
      (let [value
              (require (b/emit! (mut graph) opcode ty [input constant start]))]
        (match (s/arithmetic graph value)
          (Err [message] (panic "{}" message))
          (Ok [tile]
              (assert (= (.left tile) input))
              (assert (= (cast i64 (.rule tile))
                         (+ (if fallback 14 44)
                            (if (= opcode 30) 2 0)
                            (if (or (= ty 8) (= ty 9) (= ty 10) (= ty 11)) 1 0))))
              (assert (= (.right tile) (if fallback constant 0)))
              (when (not fallback)
                (assert (= (.immediate tile) (cast u64 exponent))))))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (for ty [(: 2 i32) 8 3 9 4 10 5 6 11]
    (for exponent (range 0 (* 8 (case ty 2 1 8 1 3 2 9 2 4 4 10 4 8)))
      (division-selection ty (cast i32 exponent))))
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        small (require (b/scalar-constant! (mut graph) 11 4096 8))
        large (require (b/scalar-constant! (mut graph) 11 4097 8))
        immediate-add (require (b/emit! (mut graph) 26 11 [small p]))
        register-sub (require (b/emit! (mut graph) 27 11 [p large]))
        (mut failures) 0]
    (match (s/arithmetic graph immediate-add)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [tile]
          (do
            (when (!= (.rule tile) 4) (set! failures (+ failures 1)))
            (when (!= (.left tile) p) (set! failures (+ failures 1)))
            (when (!= (.immediate tile) 4096) (set! failures (+ failures 1))))))
    (match (s/arithmetic graph register-sub)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [tile]
          (do
            (when (!= (.rule tile) 2) (set! failures (+ failures 1)))
            (when (!= (.right tile) large) (set! failures (+ failures 1))))))
    (match (s/arithmetic graph start)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (for ty [(: 4 i32) 10 5 11]
      (for op [(: 49 i32) 50 51]
        (set! failures
              (+ failures (shift-case ty op 65 false (+ 38 (- op 49)) 1))))
      (set! failures
            (+ failures
               (shift-case ty 28 8 false 38 3)
               (shift-case ty 28 8 true 38 3))))
    (for ty [(: 4 i32) 10 5 11]
      (for op [(: 46 i32) 47 48]
        (for first [false true]
          (for mask [(: 31 u64)
                     0xFFFF0000FFFF0000
                     0x8000000180000001
                     0x5555555555555555]
            (set! failures (+ failures (logical-case ty op mask first true))))
          (for mask [(: 0 u64) 0xFFFFFFFFFFFFFFFF 0x0123456789ABCDEF]
            (set! failures (+ failures (logical-case ty op mask first false)))))))
    (for ty [(: 2 i32) 8 3 9]
      (for op [(: 46 i32) 47 48]
        (for first [false true]
          (for mask [(: 1 u64) 3 15 31 128 240 255 65535]
            (set! failures (+ failures (logical-case ty op mask first true))))
          (for mask [(: 0 u64) 42 85 129]
            (set! failures (+ failures (logical-case ty op mask first false)))))))
    (for op [(: 46 i32) 47 48]
      (for first [false true]
        (set! failures
              (+ failures
                 (logical-case 1 op 1 first true)
                 (logical-case 1 op 0 first false)))))
    (set! failures
          (+ failures
             (match-case false false)
             (match-case true false)
             (match-case false true)))
    (g/release! (mut graph))
    (println "AArch64 selection checks: {} failures" failures)
    (if (= failures 0) 0 1)))
