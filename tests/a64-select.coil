(module stogir.tests.a64-select)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.a64.select" :as s)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        small (require (b/scalar-constant! (mut graph) 11 4096 8))
        large (require (b/scalar-constant! (mut graph) 11 4097 8))
        immediate-add (require (b/emit! (mut graph) 26 11 [small p]))
        register-sub (require (b/emit! (mut graph) 27 11 [p large]))
        (mut failures) 0]
    (match (s/arithmetic graph immediate-add)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [tile]
          (do
            (when (!= (.rule tile) 4) (set! failures (+ failures 1)))
            (when (!= (.left tile) p) (set! failures (+ failures 1)))
            (when (!= (.immediate tile) 4096) (set! failures (+ failures 1))))))
    (match (s/arithmetic graph register-sub)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [tile]
          (do
            (when (!= (.rule tile) 2) (set! failures (+ failures 1)))
            (when (!= (.right tile) large) (set! failures (+ failures 1))))))
    (match (s/arithmetic graph start)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    (println "AArch64 selection checks: {} failures" failures)
    (if (= failures 0) 0 1)))
