(module stogir.tests.jit-call)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.symbols" :as symbols)
(import "stogir.strings" :as strings)
(import "stogir.options" :as options)
(import "stogir.image" :as image)
(import "stogir.pipeline" :as pipeline)
(import "stogir.a64.tail-plan" :as tails)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.fs" :as fs)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Some None])

(defn combine :cc (cc/C) [(a i64) (b i64) (c i64) (d i64)] (-> i64)
  (+ (+ (* a 3) (* b 5)) (+ (* c 7) (* d 11))))

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn check [(graph g/Graph) (start i32) (ret i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0]
    (match (compile/text graph start [ret] allocator)
      (Err [msg]
           (do (println "compile: {}" msg) (set! failures (+ failures 1))))
      (Ok [compiled]
          (let [(mut code) compiled]
            (match (jit/map-text (slice code))
              (Err [msg]
                   (do (println "map: {}" msg) (set! failures (+ failures 1))))
              (Ok [image]
                  (let [(mut owned) image
                        f
                          (primitive/cast (fnptr (cc/C) [u64 i64 i64] i64)
                                          (.base owned))
                        target
                          (primitive/cast u64
                                          (primitive/cast (ptr u8)
                                                          (fnptr-of combine)))
                        (mut p) -20]
                    (while (<= p 20)
                      (let [(mut q) -10]
                        (while (<= q 10)
                          (let [first (combine q p q 7)
                                second (combine first p q first)
                                expected (+ (+ second (* p q)) first)
                                actual (call-ptr f target p q)]
                            (when (!= actual expected)
                              (when (= failures 0)
                                (println "p={} q={} expected={} actual={}"
                                         p
                                         q
                                         expected
                                         actual))
                              (set! failures (+ failures 1))))
                          (set! q (+ q 1))))
                      (set! p (+ p 1)))
                    (when (not (jit/release! (mut owned)))
                      (set! failures (+ failures 1))))))
            (free! (mut code)))))
    failures))

(defn check-tail [(prefix bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 2]))
        seven (require (b/scalar-constant! (mut graph) 11 7 8))]
    (match (calls/create 0 11 [(: 6 u8) 11 11] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut own) owned]
            (require (calls/function! (mut graph) own a))
            (calls/release! (mut own)))))
    (match (calls/create 0 11 [(: 11 u8) 11 11 11] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut prototype) owned
                before
                  (if prefix
                      (require (calls/emit! (mut graph)
                                            prototype
                                            start
                                            target
                                            [p q p seven]
                                            a))
                      start)
                done
                  (require (calls/emit-tail! (mut graph)
                                             prototype
                                             before
                                             target
                                             [q p q seven]
                                             0
                                             a))]
            (match (compile/text graph start [done] a)
              (Err [message] (panic "native tail: {}" message))
              (Ok [owned]
                  (let [(mut text) owned]
                    (match (jit/map-text (slice text))
                      (Err [message] (panic "tail mapping: {}" message))
                      (Ok [owned]
                          (let [(mut mapped) owned
                                function
                                  (primitive/cast (fnptr (cc/C)
                                                         [u64 i64 i64]
                                                         i64)
                                                  (.base mapped))
                                address
                                  (primitive/cast u64
                                                  (primitive/cast (ptr u8)
                                                                  (fnptr-of combine)))]
                            (for p [(: -100 i64) -1 0 1 127 1000]
                              (for q [(: -77 i64) -1 0 1 255]
                                (assert (= (function address p q)
                                           (combine q p q 7)))))
                            (jit/release! (mut mapped)))))
                    (free! (mut text)))))
            (calls/release! (mut prototype)))))
    (g/release! (mut graph))))

;;; A CALL/RET fallback exhausts the stack long before the millionth step.
;;; Test both self relocation and an opaque target with a register-copy cycle.
(defn recursive-tail [(direct bool) (prefix bool) (level i32) (explicit bool)]
  (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target
          (if direct
              (require (symbols/function! (mut graph) "_tail_recursive" 0))
              (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0])))
        first (if direct (: 0 i32) 1)
        count (require (b/emit! (mut graph) 71 11 [start (: 0 i32) first]))
        left (require (b/emit! (mut graph) 71 11 [start (: 0 i32) (+ first 1)]))
        right
          (require (b/emit! (mut graph) 71 11 [start (: 0 i32) (+ first 2)]))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        ten (require (b/scalar-constant! (mut graph) 11 10 8))
        condition (require (b/emit! (mut graph) 14 1 [count zero]))
        branch (require (b/emit! (mut graph) 116 0 [start condition]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        scaled (require (b/emit! (mut graph) 28 11 [left ten]))
        answer (require (b/emit! (mut graph) 26 11 [scaled right]))
        done (require (b/emit! (mut graph) 120 11 [yes answer (: 0 i32)]))
        next (require (b/emit! (mut graph) 27 11 [count one]))
        (mut types) (ArrayList::new [u8] a)
        (mut arguments) (ArrayList::new [i32] a)
        (mut control) no
        (mut tail-reference) (: 0 i32)]
    (when (not direct)
      (push! (mut types) 6)
      (push! (mut arguments) target))
    (for ty [(: 11 u8) 11 11] (push! (mut types) ty))
    (for value [next right left] (push! (mut arguments) value))
    (when prefix
      (match (calls/create 0 11 [(: 11 u8) 11 11 11] a)
        (Err [message] (panic "{}" message))
        (Ok [owned]
            (let [(mut prototype) owned
                  function
                    (require (b/scalar-constant! (mut graph)
                                                 6
                                                 (primitive/cast u64
                                                                 (primitive/cast (ptr u8)
                                                                                 (fnptr-of combine)))
                                                 8))]
              (set! control
                    (require (calls/emit! (mut graph)
                                          prototype
                                          control
                                          function
                                          [count left right one]
                                          a)))
              (calls/release! (mut prototype))))))
    (match (calls/create 0 11 (slice types) a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut prototype) owned]
            (require (calls/function! (mut graph) prototype a))
            (let [tail
                    (if explicit
                        (require (calls/emit-tail! (mut graph)
                                                   prototype
                                                   control
                                                   target
                                                   (slice arguments)
                                                   done
                                                   a))
                        (let [call
                                (require (calls/emit! (mut graph)
                                                      prototype
                                                      control
                                                      target
                                                      (slice arguments)
                                                      a))]
                          (require (b/emit! (mut graph) 120 11 [call call done]))))]
              (set! tail-reference tail)
              (match (compile/image-with-options graph
                                                 start
                                                 [done tail]
                                                 "_tail_recursive"
                                                 (options/Options :level level)
                                                 a)
                (Err [message]
                     (panic "recursive tail direct={} prefix={} level={}: {}"
                            direct
                            prefix
                            level
                            message))
                (Ok [owned]
                    (let [(mut output) owned]
                      (match (jit/map-image output a)
                        (Err [message]
                             (panic "recursive tail mapping: {}" message))
                        (Ok [owned]
                            (let [(mut mapped) owned
                                  address (get (.addresses mapped) 0)
                                  direct-function
                                    (primitive/cast (fnptr (cc/C)
                                                           [i64 i64 i64]
                                                           i64)
                                                    (primitive/cast (ptr u8)
                                                                    address))
                                  indirect-function
                                    (primitive/cast (fnptr (cc/C)
                                                           [u64 i64 i64 i64]
                                                           i64)
                                                    (primitive/cast (ptr u8)
                                                                    address))]
                              (for n [(: 0 i64) 1 2 31 1000001]
                                (assert (= (if direct
                                               (direct-function n 3 4)
                                               (indirect-function address n 3 4))
                                           (if (= (& n 1) 0) 34 43))))
                              (jit/release-image! (mut mapped)))))
                      (image/release! (mut output))))))
            (calls/release! (mut prototype)))))
    (when (and direct (not prefix) (= level 3) (not explicit))
      (match (compile/object-with-options graph
                                          start
                                          [done tail-reference]
                                          "_tail_recursive"
                                          (options/Options :level level)
                                          a)
        (Err [message] (panic "tail AOT object: {}" message))
        (Ok [owned]
            (let [(mut object) owned]
              (match (fs/write-file a
                                    "/tmp/coil-stogir-tail-recursive.o"
                                    (slice object))
                (Err [_] (panic "tail AOT write failed"))
                (Ok [_] 0))
              (free! (mut object))))))
    ; Late matching preserves the templates' original graph and root IDs.
    (let [terminal (get (.instructions graph) (cast i64 tail-reference))
          call (get (.instructions graph) (cast i64 (.op1 terminal)))]
      (assert (= (n/opcode terminal) (if explicit (: 121 u8) 120)))
      (assert (= (n/opcode call) (if explicit (: 80 u8) 79))))
    (free! (mut arguments))
    (free! (mut types))
    (g/release! (mut graph))))

(defn bump :cc (cc/C) [(counter (ptr i64))] (-> i64)
  (store! counter (+ (load counter) 1))
  97)

;;; A void caller can ignore a scalar return. An observed CALL identity must
;;; still retain its result definition and ordinary RETURN, even in this shape.
(defn ignored-tail [(observed bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        counter (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        (mut roots) (ArrayList::new [i32] a)]
    (match (calls/create 0 0 [(: 6 u8) 6] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut own) owned]
            (require (calls/function! (mut graph) own a))
            (calls/release! (mut own)))))
    (match (calls/create 0 11 [(: 6 u8)] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut prototype) owned
                call
                  (require (calls/emit! (mut graph)
                                        prototype
                                        start
                                        target
                                        [counter]
                                        a))
                done (require (b/emit! (mut graph) 120 0 [call (: 0 i32) 0]))]
            (push! (mut roots) done)
            (when observed (push! (mut roots) call))
            (match (pipeline/prepare graph start (slice roots) a)
              (Err [message] (panic "ignored tail schedule: {}" message))
              (Ok [owned]
                  (let [(mut prepared) owned]
                    (match (tails/select graph
                                         (.schedule prepared)
                                         (slice roots)
                                         true
                                         a)
                      (Err [message] (panic "ignored tail proof: {}" message))
                      (Ok [owned]
                          (let [(mut plan) owned]
                            (assert (= (len (.returns plan)) (if observed 0 1)))
                            (tails/release! (mut plan)))))
                    (pipeline/release! (mut prepared)))))
            (match (compile/text graph start (slice roots) a)
              (Err [message] (panic "ignored tail compile: {}" message))
              (Ok [owned]
                  (let [(mut text) owned]
                    (match (jit/map-text (slice text))
                      (Err [message] (panic "ignored tail mapping: {}" message))
                      (Ok [owned]
                          (let [(mut mapped) owned
                                function
                                  (primitive/cast (fnptr (cc/C)
                                                         [u64 (ptr i64)]
                                                         void)
                                                  (.base mapped))
                                target
                                  (primitive/cast u64
                                                  (primitive/cast (ptr u8)
                                                                  (fnptr-of bump)))
                                (mut count) (: 1 i64)]
                            (for [i 0 100]
                              (function target
                                        (primitive/cast (ptr i64) (mut count))))
                            (assert (= count 101))
                            (jit/release! (mut mapped)))))
                    (free! (mut text)))))
            (calls/release! (mut prototype)))))
    (free! (mut roots))
    (g/release! (mut graph))))

(defn mixed-tail-target :cc (cc/C) [(left i64) (x f64) (right i64) (y f32)]
  (-> f64)
  (+ (+ (* (cast f64 left) 3.0) (* x 5.0))
     (+ (* (cast f64 right) 7.0) (* (cast f64 y) 11.0))))

(defn stack-tail-target :cc (cc/C) [(a i64)
                                    (b i64)
                                    (c i64)
                                    (d i64)
                                    (e i64)
                                    (f i64)
                                    (g i64)
                                    (h i64)
                                    (i i64)] (-> i64)
  (+ (+ (+ a (* b 2)) (+ (* c 3) (* d 4)))
     (+ (+ (* e 5) (* f 6)) (+ (* g 7) (+ (* h 8) (* i 9))))))

;;; Stack arguments deliberately retain CALL/RET. Mixed register banks can jump.
(defn abi-tail [(stack bool) (explicit bool) (level i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        left (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        right (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 2]))
        x (if stack 0 (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 3])))
        y (if stack 0 (require (b/emit! (mut graph) 71 13 [start (: 0 i32) 4])))
        result-type (if stack (: 11 u8) 12)
        (mut arguments) (ArrayList::new [i32] a)
        (mut types) (ArrayList::new [u8] a)]
    (match (calls/create 0
                         result-type
                         (if stack [(: 6 u8) 11 11] [(: 6 u8) 11 11 12 13])
                         a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut signature) owned]
            (require (calls/function! (mut graph) signature a))
            (calls/release! (mut signature)))))
    (if stack
        (do
          (for value [right left right left right left right left right]
            (push! (mut arguments) value)
            (push! (mut types) 11)))
        (do
          (for value [right x left y] (push! (mut arguments) value))
          (for ty [(: 11 u8) 12 11 13] (push! (mut types) ty))))
    (match (calls/create 0 result-type (slice types) a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut prototype) owned
                done
                  (if explicit
                      (require (calls/emit-tail! (mut graph)
                                                 prototype
                                                 start
                                                 target
                                                 (slice arguments)
                                                 0
                                                 a))
                      (let [call
                              (require (calls/emit! (mut graph)
                                                    prototype
                                                    start
                                                    target
                                                    (slice arguments)
                                                    a))]
                        (require (b/emit! (mut graph)
                                          120
                                          (cast i32 result-type)
                                          [call call (: 0 i32)]))))]
            (match (pipeline/prepare graph start [done] a)
              (Err [message] (panic "tail ABI prepare: {}" message))
              (Ok [owned]
                  (let [(mut prepared) owned]
                    (match (tails/select graph
                                         (.schedule prepared)
                                         [done]
                                         true
                                         a)
                      (Err [message] (panic "tail ABI proof: {}" message))
                      (Ok [owned]
                          (let [(mut plan) owned]
                            (assert (= (len (.returns plan))
                                       (if (or explicit stack) 0 1)))
                            (when explicit
                              (let [call
                                      (.op1 (get (.instructions graph)
                                                 (cast i64 done)))]
                                (assert (= (get (.modes plan) (cast i64 call))
                                           (if stack 2 1)))))
                            (tails/release! (mut plan)))))
                    (pipeline/release! (mut prepared)))))
            (match (compile/image-with-options graph
                                               start
                                               [done]
                                               "_tail_abi"
                                               (options/Options :level level)
                                               a)
              (Err [message] (panic "tail ABI compile: {}" message))
              (Ok [owned]
                  (let [(mut output) owned]
                    (match (jit/map-image output a)
                      (Err [message] (panic "tail ABI map: {}" message))
                      (Ok [owned]
                          (let [(mut mapped) owned
                                address
                                  (primitive/cast (ptr u8)
                                                  (get (.addresses mapped) 0))]
                            (if stack
                                (let [function
                                        (primitive/cast (fnptr (cc/C)
                                                               [u64 i64 i64]
                                                               i64)
                                                        address)
                                      target
                                        (primitive/cast u64
                                                        (primitive/cast (ptr u8)
                                                                        (fnptr-of stack-tail-target)))]
                                  (for left [(: -17 i64) 0 93]
                                    (for right [(: -31 i64) 0 127]
                                      (assert (= (function target left right)
                                                 (stack-tail-target right
                                                                    left
                                                                    right
                                                                    left
                                                                    right
                                                                    left
                                                                    right
                                                                    left
                                                                    right))))))
                                (let [function
                                        (primitive/cast (fnptr (cc/C)
                                                               [u64 i64 i64 f64
                                                                f32]
                                                               f64)
                                                        address)
                                      target
                                        (primitive/cast u64
                                                        (primitive/cast (ptr u8)
                                                                        (fnptr-of mixed-tail-target)))]
                                  (for left [(: -17 i64) 0 93]
                                    (for right [(: -31 i64) 0 127]
                                      (assert (= (function target
                                                           left
                                                           right
                                                           1.25
                                                           (: -2.5 f32))
                                                 (mixed-tail-target right
                                                                    1.25
                                                                    left
                                                                    (: -2.5 f32))))))))
                            (jit/release-image! (mut mapped)))))
                    (image/release! (mut output)))))
            (calls/release! (mut prototype)))))
    (free! (mut arguments))
    (free! (mut types))
    (g/release! (mut graph))))

(defstruct TailPair [(a i64) (b i64)])

(defstruct TailHfa [(a f64) (b f64) (c f64) (d f64)])

(defstruct TailLarge [(a i64) (b i64) (c i64)])

(defn pair-target :cc (cc/C) [(x i64)] (-> TailPair)
  (TailPair :a x :b (+ x 17)))

(defn hfa-target :cc (cc/C) [(x i64)] (-> TailHfa)
  (TailHfa
    :a (cast f64 x)
    :b 1.25
    :c -2.5
    :d 97.0))

(defn large-target :cc (cc/C) [(x i64)] (-> TailLarge)
  (TailLarge
    :a x
    :b (+ x 17)
    :c (- x 31)))

;;; PARAM0 is a synthetic capture place for GP/HFA, and the real x8 for SRET.
(defn aggregate-tail [(kind i32) (explicit bool) (level i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        name
          (match (strings/intern! (mut (.strings graph)) "tail-result")
            (Some [id] id)
            (None [] (panic "tail result name failed")))
        named (require (b/emit! (mut graph) 71 6 [start name (: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        value (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 2]))
        spec
          (if (= kind 0)
              (results/pieces 11 2)
              (if (= kind 1) (results/pieces 12 4) (results/indirect)))]
    (match (calls/create-result 0 [(: 6 u8) 6 11] [] spec a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut signature) owned]
            (require (calls/function! (mut graph) signature a))
            (calls/release! (mut signature)))))
    (match (calls/create-result 0 [(: 6 u8) 11] [] spec a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut signature) owned
                done
                  (if explicit
                      (require (calls/emit-tail! (mut graph)
                                                 signature
                                                 start
                                                 target
                                                 [named value]
                                                 0
                                                 a))
                      (let [call
                              (require (calls/emit! (mut graph)
                                                    signature
                                                    start
                                                    target
                                                    [named value]
                                                    a))]
                        (require (b/emit! (mut graph) 120 0 [call (: 0 i32) 0]))))]
            (match (pipeline/prepare graph start [done] a)
              (Err [message] (panic "aggregate tail prepare: {}" message))
              (Ok [owned]
                  (let [(mut prepared) owned]
                    (match (tails/select graph
                                         (.schedule prepared)
                                         [done]
                                         true
                                         a)
                      (Err [message] (panic "aggregate tail proof: {}" message))
                      (Ok [owned]
                          (let [(mut plan) owned]
                            (assert (= (len (.returns plan)) (if explicit 0 1)))
                            (let [call
                                    (.op1 (get (.instructions graph)
                                               (cast i64 done)))]
                              (assert (= (get (.modes plan) (cast i64 call)) 1)))
                            (tails/release! (mut plan)))))
                    (pipeline/release! (mut prepared)))))
            (match (compile/image-with-options graph
                                               start
                                               [done]
                                               "_aggregate_tail"
                                               (options/Options :level level)
                                               a)
              (Err [message] (panic "aggregate tail compile: {}" message))
              (Ok [owned]
                  (let [(mut output) owned]
                    (match (jit/map-image output a)
                      (Err [message] (panic "aggregate tail map: {}" message))
                      (Ok [owned]
                          (let [(mut mapped) owned
                                address
                                  (primitive/cast (ptr u8)
                                                  (get (.addresses mapped) 0))]
                            (for value [(: -100 i64) 0 17 1000000]
                              (match kind
                                (0 (let [function
                                           (primitive/cast (fnptr (cc/C)
                                                                  [u64 i64]
                                                                  TailPair)
                                                           address)
                                         target
                                           (primitive/cast u64
                                                           (primitive/cast (ptr u8)
                                                                           (fnptr-of pair-target)))
                                         actual (function target value)]
                                     (assert (= (.a actual) value))
                                     (assert (= (.b actual) (+ value 17)))))
                                (1 (let [function
                                           (primitive/cast (fnptr (cc/C)
                                                                  [u64 i64]
                                                                  TailHfa)
                                                           address)
                                         target
                                           (primitive/cast u64
                                                           (primitive/cast (ptr u8)
                                                                           (fnptr-of hfa-target)))
                                         actual (function target value)]
                                     (assert (= (.a actual) (cast f64 value)))
                                     (assert (= (.b actual) 1.25))
                                     (assert (= (.c actual) -2.5))
                                     (assert (= (.d actual) 97.0))))
                                (_ (let [function
                                           (primitive/cast (fnptr (cc/C)
                                                                  [u64 i64]
                                                                  TailLarge)
                                                           address)
                                         target
                                           (primitive/cast u64
                                                           (primitive/cast (ptr u8)
                                                                           (fnptr-of large-target)))
                                         actual (function target value)]
                                     (assert (= (.a actual) value))
                                     (assert (= (.b actual) (+ value 17)))
                                     (assert (= (.c actual) (- value 31)))))))
                            (jit/release-image! (mut mapped)))))
                    (image/release! (mut output)))))
            (calls/release! (mut signature)))))
    (g/release! (mut graph))))

(defn copied-tail-target :cc (cc/C) [(copy (ptr i64)) (original (ptr i64))]
  (-> i64)
  (let [answer (+ (load copy) 3)]
    (store! copy 0)
    (if (or (= copy original) (!= (& (primitive/cast u64 copy) 63) 0))
        -999
        answer)))

(defn copied-tail [(explicit bool) (level i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        source (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        copy (require (b/argument-value! (mut graph) source 8 64))]
    (match (calls/create 0 11 [(: 6 u8) 6] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut own) owned]
            (require (calls/function! (mut graph) own a))
            (calls/release! (mut own)))))
    (match (calls/create 0 11 [(: 6 u8) 6] a)
      (Err [message] (panic "{}" message))
      (Ok [owned]
          (let [(mut prototype) owned
                done
                  (if explicit
                      (require (calls/emit-tail! (mut graph)
                                                 prototype
                                                 start
                                                 target
                                                 [copy source]
                                                 0
                                                 a))
                      (let [call
                              (require (calls/emit! (mut graph)
                                                    prototype
                                                    start
                                                    target
                                                    [copy source]
                                                    a))]
                        (require (b/emit! (mut graph)
                                          120
                                          11
                                          [call call (: 0 i32)]))))]
            (match (pipeline/prepare graph start [done] a)
              (Err [message] (panic "copied tail prepare: {}" message))
              (Ok [owned]
                  (let [(mut prepared) owned]
                    (match (tails/select graph
                                         (.schedule prepared)
                                         [done]
                                         true
                                         a)
                      (Err [message] (panic "copied tail proof: {}" message))
                      (Ok [owned]
                          (let [(mut plan) owned]
                            (assert (= (len (.returns plan)) 0))
                            (when explicit
                              (let [call
                                      (.op1 (get (.instructions graph)
                                                 (cast i64 done)))]
                                (assert (= (get (.modes plan) (cast i64 call))
                                           2))))
                            (tails/release! (mut plan)))))
                    (pipeline/release! (mut prepared)))))
            (match (compile/image-with-options graph
                                               start
                                               [done]
                                               "_copied_tail"
                                               (options/Options :level level)
                                               a)
              (Err [message] (panic "copied tail compile: {}" message))
              (Ok [owned]
                  (let [(mut output) owned]
                    (match (jit/map-image output a)
                      (Err [message] (panic "copied tail map: {}" message))
                      (Ok [owned]
                          (let [(mut mapped) owned
                                function
                                  (primitive/cast (fnptr (cc/C)
                                                         [u64 (ptr i64)]
                                                         i64)
                                                  (primitive/cast (ptr u8)
                                                                  (get (.addresses mapped)
                                                                       0)))
                                target
                                  (primitive/cast u64
                                                  (primitive/cast (ptr u8)
                                                                  (fnptr-of copied-tail-target)))
                                (mut value) (: 37 i64)]
                            (for [i 0 10]
                              (assert (= (function target
                                                   (primitive/cast (ptr i64)
                                                                   (mut value)))
                                         40))
                              (assert (= value 37)))
                            (jit/release-image! (mut mapped)))))
                    (image/release! (mut output)))))
            (calls/release! (mut prototype)))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (for explicit [false true]
    (for level [(: 1 i32) 2 3] (copied-tail explicit level)))
  (for kind [(: 0 i32) 1 2]
    (for explicit [false true]
      (for level [(: 1 i32) 2 3] (aggregate-tail kind explicit level))))
  (for stack [false true]
    (for explicit [false true]
      (for level [(: 1 i32) 2 3] (abi-tail stack explicit level))))
  (ignored-tail false)
  (ignored-tail true)
  (for direct [false true]
    (for prefix [false true]
      (for level [(: 1 i32) 2 3]
        (for explicit [false true]
          (recursive-tail direct prefix level explicit)))))
  (check-tail false)
  (check-tail true)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 2]))
        seven (require (b/scalar-constant! (mut graph) 11 7 8))
        (mut failures) 0]
    (match (calls/create 0 11 [(: 11 u8) 11 11 11] allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [prototype]
          (let [(mut owned) prototype
                first
                  (require (calls/emit! (mut graph)
                                        owned
                                        start
                                        target
                                        [q p q seven]
                                        allocator))
                second
                  (require (calls/emit! (mut graph)
                                        owned
                                        first
                                        target
                                        [first p q first]
                                        allocator))
                product (require (b/emit! (mut graph) 28 11 [p q]))
                sum (require (b/emit! (mut graph) 26 11 [second product]))
                result (require (b/emit! (mut graph) 26 11 [sum first]))
                ret
                  (require (b/emit! (mut graph)
                                    120
                                    11
                                    [second result (: 0 i32)]))]
            (match (compile/object graph
                                   start
                                   [ret]
                                   "_stogir_call_test"
                                   allocator)
              (Err [msg]
                   (do
                     (println "object: {}" msg)
                     (set! failures (+ failures 1))))
              (Ok [object]
                  (let [(mut owned-object) object]
                    (match (fs/write-file allocator
                                          "/tmp/coil-stogir-call.o"
                                          (slice owned-object))
                      (Err [_] (set! failures (+ failures 1)))
                      (Ok [_] 0))
                    (free! (mut owned-object)))))
            (set! failures (+ failures (check graph start ret)))
            (calls/release! (mut owned)))))
    (g/release! (mut graph))
    (println "native call checks: {} failures" failures)
    (if (= failures 0) 0 1)))
