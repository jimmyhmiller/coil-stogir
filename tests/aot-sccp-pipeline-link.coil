(module stogir.tests.aot-sccp-pipeline-link)
(import "coil.cc" :as cc)

(extern calculate :as "sccp_pipeline" :cc (cc/C) [i64 i64] (-> i64))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for x [-100 -7 0 3 29]
      (for y [-99 -1 0 17 53]
        (when (!= (calculate x y) (* 2 (+ x y)))
          (set! failures (+ failures 1)))))
    (println "SCCP pipeline linked AOT checks: {} failures" failures)
    (if (= failures 0) 0 1)))
