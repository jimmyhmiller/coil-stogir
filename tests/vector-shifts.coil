(defn rotate-cases [] (-> i64)
  (let [(mut failures) 0]
    (for row ROTATE-CHECK-CASES
      (set! failures
            (+ failures
               (check (.ty row)
                      (.opcode row)
                      (.rd row)
                      (.rn row)
                      (.count row)
                      (.scalar? row)
                      (.expected row)))))

    (let [allocator (malloc-allocator)
          (mut output) (ArrayList::new [u8] allocator)]
      (push! (mut output) 165)
      (for rejected [(native/emit-registers! (mut output) 52 37 30 1 2 false)
                     (native/emit-registers! (mut output) 53 37 31 1 2 false)
                     (native/emit-registers! (mut output) 52 37 0 31 2 false)
                     (native/emit-registers! (mut output) 53 61 0 1 2 false)]
        (match rejected (Err [_] 0) (Ok [_] (set! failures (+ failures 1)))))
      (when (or (!= (len output) 1) (!= (get output 0) 165))
        (set! failures (+ failures 1)))
      (free! (mut output)))
    (println "vector rotate register cases: 480 cases/4086 independent MC words, {} failures"
             failures)
    failures))
