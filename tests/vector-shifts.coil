(defn main [] (-> i64)
  (let [(mut failures) (+ (contracts) (rotate-cases))]
    (for row CHECK-CASES
      (set! failures
            (+ failures
               (check (.ty row)
                      (.opcode row)
                      (.rd row)
                      (.rn row)
                      (.count row)
                      (.scalar? row)
                      (.expected row)))))
    (println "vector shift contracts and 540 register cases/2160 independent MC words: {} failures"
             failures)
    (if (= failures 0) 0 1)))

