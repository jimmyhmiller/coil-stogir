(module stogir.tests.a64-encode)
(import "stogir.a64.encode" :as e)
(import "coil.result" :use [Result Ok Err])

(defn check [(result (Result u32 (slice u8))) (expected u32)] (-> i64)
  (match result (Ok [word] (if (= word expected) 0 1)) (Err [_] 1)))

(defn rejected [(result (Result u32 (slice u8)))] (-> i64)
  (match result (Ok [_] 1) (Err [_] 0)))

(defn main [] (-> i64)
