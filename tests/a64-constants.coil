(module stogir.tests.a64-constants)
(import "stogir.a64.constants" :as c)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn check [(bits u64) (expected-count i32)] (-> i64)
  (let [(mut output) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0
        (mut value) (: 0 u64)
        (mut i) 0]
    (match (c/emit! (mut output) true 0 bits)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [count]
          (when (!= count expected-count) (set! failures (+ failures 1)))))
    (while (< i (len output))
      (let [word
              (| (cast u32 (get output i))
                 (<< (cast u32 (get output (+ i 1))) 8)
                 (<< (cast u32 (get output (+ i 2))) 16)
                 (<< (cast u32 (get output (+ i 3))) 24))
            kind (& (>> word 29) 3)
            shift (* (& (>> word 21) 3) 16)
            payload (<< (cast u64 (& (>> word 5) 65535)) (cast u64 shift))]
        (if (= kind 2)
            (set! value payload)
            (if (= kind 0)
                (set! value (^ payload (: 0xFFFFFFFFFFFFFFFF u64)))
                (set! value
                      (| (& value
                            (^ (<< (: 65535 u64) (cast u64 shift))
                               (: 0xFFFFFFFFFFFFFFFF u64)))
                         payload)))))
      (set! i (+ i 4)))
    (when (!= value bits) (set! failures (+ failures 1)))
    (free! (mut output))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (check 0 1)
             (check 0xFFFFFFFFFFFFFFFF 1)
             (check 0x1234000000000000 1)
             (check 0xFFFFFFFFFFFF1234 1)
             (check 0x123456789ABCDEF0 4))]
    (println "constant materialization checks: {} failures" failures)
    (if (= failures 0) 0 1)))
