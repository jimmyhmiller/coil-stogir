(module stogir.tests.x64-host)
(import "stogir.target" :as target)

;;; The x86-64 Linux host runs library tests: this one only proves the round
;;; trip (tools/x86/remote-test.sh) and that target selection sees the host.
(defn main [] (-> i64)
  (let [arch (target/arch-pick 1 2)
        os (target/os-pick 1 2)]
    (println "target check: arch {} os {}" arch os)
    (if (and (= arch 2) (= os 2)) 0 1)))
