(module stogir.tests.aot-extrema-link)
(import "coil.cc" :as cc)

(extern signed8 :as "stogir_extrema_i8" :cc (cc/C) [i64 i8 i8] (-> i64))

(extern unsigned8 :as "stogir_extrema_u8" :cc (cc/C) [i64 u8 u8] (-> u64))

(extern signed16 :as "stogir_extrema_i16" :cc (cc/C) [i64 i16 i16] (-> i64))

(extern signed32 :as "stogir_extrema_i32" :cc (cc/C) [i64 i32 i32] (-> i64))

(extern signed64 :as "stogir_extrema_i64" :cc (cc/C) [i64 i64 i64] (-> i64))

(extern unsigned64 :as "stogir_extrema_u64" :cc (cc/C) [i64 u64 u64] (-> u64))

(extern boolean :as "stogir_extrema_bool" :cc (cc/C) [i64 bool bool] (-> bool))

(defn expected [(width i32) (signed? bool) (c i64) (a u64) (b u64)] (-> u64)
  (let [modulus (<< (: 1 i128) (cast i128 width))
        mask (cast u64 (- modulus 1))
        x (cast i128 (& a mask))
        y (cast i128 (& b mask))
        sx (if (and signed? (>= x (/ modulus 2))) (- x modulus) x)
        sy (if (and signed? (>= y (/ modulus 2))) (- y modulus) y)]
    (cast u64 (if (!= c 0) (if (<= sx sy) sx sy) (if (>= sx sy) sx sy)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for c [(: -1 i64) 0 1]
      (for a [(: 0 u64)
              1
              127
              128
              255
              32768
              65535
              0x80000000
              0xFFFFFFFF
              0x8000000000000000
              0xFFFFFFFFFFFFFFFF
              0xFEDCBA9876543280]
        (for b [(: 0 u64)
                1
                127
                128
                255
                32768
                65535
                0x80000000
                0xFFFFFFFF
                0x8000000000000000
                0xFFFFFFFFFFFFFFFF
                0x123456789ABC7F01]
          (when (or (!= (cast u64 (signed8 c (cast i8 a) (cast i8 b)))
                        (expected 8 true c a b))
                    (!= (unsigned8 c (cast u8 a) (cast u8 b))
                        (expected 8 false c a b))
                    (!= (cast u64 (signed16 c (cast i16 a) (cast i16 b)))
                        (expected 16 true c a b))
                    (!= (cast u64 (signed32 c (cast i32 a) (cast i32 b)))
                        (expected 32 true c a b))
                    (!= (cast u64 (signed64 c (cast i64 a) (cast i64 b)))
                        (expected 64 true c a b))
                    (!= (unsigned64 c a b) (expected 64 false c a b)))
            (set! failures (+ failures 1)))))
      (for a [false true]
        (for b [false true]
          (when (!= (boolean c a b) (if (!= c 0) (and a b) (or a b)))
            (set! failures (+ failures 1))))))
    (println "linked extrema/conditional checks: {} failures" failures)
    (if (= failures 0) 0 1)))
