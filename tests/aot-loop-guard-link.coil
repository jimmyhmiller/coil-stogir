(module stogir.tests.aot-loop-guard-link)
(import "coil.cc" :as cc)

(extern safe? :as "vector_guard" :cc (cc/C) [u64 u64 u64 u64] (-> bool))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for displacement [(: 0 u64) 4 8 12 16 20 24 28]
      (let [actual (safe? 1 5 4096 (+ (: 4096 u64) displacement))]
        (when (!= actual (>= displacement 20)) (set! failures (+ failures 1)))))
    (when (or (safe? 0 4 0 8192)
              (safe? 1 4 4096 8192)
              (safe? 7 3 4096 8192)
              (safe? 1 5 281474976710652 8192)
              (safe? 0xFFFFFFFFFFFFFFFF 8 4096 8192))
      (set! failures (+ failures 1)))
    (println "linked vector memory guard checks: {} failures" failures)
    (if (= failures 0) 0 1)))
