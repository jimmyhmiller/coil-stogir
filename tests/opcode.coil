(defn expected-rows [] (-> (slice (array (slice u8) 6)))
  EXPECTED)

(defn metadata-checks [] (-> i64)
  (let [(mut failures) 0]
    (for [opcode -2 134]
      (let [valid (and (>= opcode 0) (< opcode 131))]
        (when (!= (op/shape (cast i32 opcode))
                  (if valid (get (get (expected-rows) opcode) 0) ""))
          (set! failures (+ failures 1)))
        ; Derive arity independently from the pinned textual shapes above.
        (let [shape (if valid (get (get (expected-rows) opcode) 0) "")
              inputs
                (if (not valid)
                    (: -2 i32)
                    (if (< (len shape) 2)
                        0
                        (if (= (get shape 1) #\N)
                            -1
                            (cast i32 (- (get shape 1) #\0)))))
              slots
                (if (and (>= inputs 0)
                         (> (len shape) 3)
                         (= (get shape 2) #\X))
                    (+ inputs (cast i32 (- (get shape 3) #\0)))
                    inputs)]
          (when (!= (op/input-count (cast i32 opcode)) inputs)
            (set! failures (+ failures 1)))
          (when (!= (op/operand-slots (cast i32 opcode)) slots)
            (set! failures (+ failures 1))))
        (for index [(: -2147483648 i32) -1 0 1 2 3 4 5 6 7 8 2147483647]
          (let [expected
                  (if (and valid (> index 0))
                      (get (get (expected-rows) opcode)
                           (if (> index 4) 5 (cast i64 index)))
                      "___")]
            (when (!= (uses/edge-code? (op/operand-code (cast i32 opcode) index))
                      (uses/edge-kind? expected))
              (set! failures (+ failures 1)))
            (when (!= (op/operand-kind (cast i32 opcode) index) expected)
              (set! failures (+ failures 1)))))))
    (for invalid-code [(: 15 u32) 16 31 32 4294967295]
      (when (uses/edge-code? invalid-code) (set! failures (+ failures 1))))
    (for invalid [(: -2147483648 i32) -1 131 2147483647]
      (when (or (!= (op/input-count invalid) -2)
                (!= (op/operand-slots invalid) -2))
        (set! failures (+ failures 1))))
    failures))

(defn properties-checks [] (-> i64)
  (let [(mut failures) 0]
    (when (!= (len op/PROPERTIES) (cast i64 (op/count)))
      (set! failures (+ failures 1)))
    (for [opcode 0 (cast i64 (op/count))]
      (let [shape (get (get (expected-rows) opcode) 0)
            kind (get shape 0)
            (mut expected) (: 0 u8)]
        (when (or (= kind #\c)
                  (= kind #\S)
                  (= kind #\E)
                  (= kind #\T)
                  (= kind #\l)
                  (= kind #\s)
                  (= kind #\x)
                  (= kind #\a))
          (set! expected (| expected 1)))
        (when (= kind #\S) (set! expected (| expected 2)))
        (when (or (= kind #\E) (= kind #\T)) (set! expected (| expected 4)))
        (when (= kind #\T) (set! expected (| expected 8)))
        (when (or (= kind #\d) (= kind #\p) (= kind #\r))
          (set! expected (| expected 16)))
        (when (= kind #\p) (set! expected (| expected 32)))
        (when (= kind #\d) (set! expected (| expected 64)))
        (when (= kind #\l) (set! expected (| expected 128)))
        (when (or (!= (op/properties (cast i32 opcode)) expected)
                  (!= (op/control? (cast i32 opcode)) (!= (& expected 1) 0))
                  (!= (op/block-start? (cast i32 opcode)) (!= (& expected 2) 0))
                  (!= (op/block-end? (cast i32 opcode)) (!= (& expected 4) 0))
                  (!= (op/terminator? (cast i32 opcode)) (!= (& expected 8) 0))
                  (!= (op/shape (cast i32 opcode)) shape))
          (set! failures (+ failures 1)))))
    (for invalid [(: -2147483648 i32) -1 131 2147483647]
      (when (or (!= (op/properties invalid) 0)
                (op/control? invalid)
                (op/block-start? invalid)
                (op/block-end? invalid)
                (op/terminator? invalid)
                (!= (op/shape invalid) ""))
        (set! failures (+ failures 1))))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) (+ (metadata-checks) (properties-checks))
        (mut i) (: 0 i32)]
    (while (< i (op/count))
      (when (not (op/valid? i)) (set! failures (+ failures 1)))
      (when (= (op/name i) "INVALID") (set! failures (+ failures 1)))
      (when (< (op/input-count i) -1) (set! failures (+ failures 1)))
      (set! i (+ i 1)))
    (when (!= (op/name 26) "ADD") (set! failures (+ failures 1)))
    (when (!= (op/input-count 26) 2) (set! failures (+ failures 1)))
    (when (!= (op/operand-kind 29 3) "grd") (set! failures (+ failures 1)))
    (when (!= (op/operand-slots 121) 3) (set! failures (+ failures 1)))
    (when (!= (op/operand-kind 121 3) "ret") (set! failures (+ failures 1)))
    (when (op/valid? -1) (set! failures (+ failures 1)))
    (when (op/valid? (op/count)) (set! failures (+ failures 1)))
    (println "opcode checks: {} failures; {} opcodes" failures (op/count))
    (if (= failures 0) 0 1)))
