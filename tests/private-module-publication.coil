(module stogir.tests.private-module-publication)
(import "stogir.a64.private-leaf" :as private)
(import "stogir.a64.compile" :as compile)
(import "stogir.options" :as options)
(import "stogir.image" :as image)
(import "stogir.bytes" :as bytes)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [n] n) (Err [message] (panic "{}" message))))

(defn main [] (-> i32)
  (let [a (malloc-allocator) (mut target) (image/create a)
        scope (p/cast usize (p/cast (ptr u8) (mut target)))
        (mut context) (private/context-create a)
        signature [(: 0 u8) 5 1 5]]
    (bytes/append32! (mut (.text target)) 0x91000400)
    (bytes/append32! (mut (.text target)) 0xD65F03C0)
    (let [id (require (image/local-symbol! (mut target) "temporary_entry" 1 0))]
      (match (private/register-as! (mut context) "canonical_binding" target id 8 signature)
        (Err [message] (panic "{}" message)) (Ok [accepted] (assert accepted)))
      (match (private/register-as! (mut context) "second_binding" target id 8 signature)
        (Err [message] (panic "{}" message)) (Ok [accepted] (assert accepted))))
    (match (private/seal-module! (mut context) scope)
      (None [] 0) (Some [_] (panic "unpublished context sealed")))
    (match (private/confirm-publication! (mut context) scope "canonical_binding" 42 1 (slice (.text target)))
      (Err [_] 0) (Ok [_] (panic "global publication accepted")))
    (match (private/confirm-publication! (mut context) scope "canonical_binding" 42 0 [(: 0 u8) 0 0 0])
      (Err [_] 0) (Ok [_] (panic "different bytes accepted")))
    (match (private/confirm-publication! (mut context) scope "canonical_binding" 42 0 (slice (.text target)))
      (Err [message] (panic "{}" message)) (Ok [accepted] (assert accepted)))
    (match (private/confirm-publication! (mut context) (+ scope 1) "second_binding" 43 0 (slice (.text target)))
      (Err [_] 0) (Ok [_] (panic "foreign scope accepted")))
    (match (private/confirm-publication! (mut context) scope "second_binding" 42 0 (slice (.text target)))
      (Err [_] 0) (Ok [_] (panic "duplicate target symbol accepted")))
    (match (private/confirm-publication! (mut context) scope "second_binding" 43 0 (slice (.text target)))
      (Err [message] (panic "{}" message)) (Ok [accepted] (assert accepted)))
    (let [publication (match (private/seal-module! (mut context) scope)
                        (None [] (panic "complete context did not seal")) (Some [p] p))
          (mut graph) (g/create a)
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
          callee (require (symbols/function! (mut graph) "canonical_binding" 0))
          (mut prototype) (match (calls/create 0 5 [(: 5 u8)] a)
                            (Err [message] (panic "{}" message)) (Ok [p] p))
          call (require (calls/emit! (mut graph) prototype start callee [x] a))
          one (require (b/scalar-constant! (mut graph) 5 1 8))
          value (require (b/emit! (mut graph) 26 5 [call one]))
          ret (require (b/emit! (mut graph) 120 5 [call value (: 0 i32)]))]
      (assert (private/module-valid? context publication scope))
      (assert (not (private/module-valid? context publication (+ scope 1))))
      (assert (private/verify-publication context publication scope "canonical_binding" 42 0 (slice (.text target))))
      (assert (not (private/verify-publication context publication scope "canonical_binding" 43 0 (slice (.text target)))))
      (match (compile/image-for-private-module graph start [ret] "_caller" (options/Options :level 3)
               a context publication (+ scope 1))
        (Err [_] 0) (Ok [out] (let [(mut out) out] (image/release! (mut out)))
                             (panic "module entry accepted foreign scope")))
      (match (compile/image-for-private-module graph start [ret] "_caller" (options/Options :level 3)
               a context publication scope)
        (Err [message] (panic "{}" message))
        (Ok [out]
          (let [(mut out) out
                id (match (image/find-symbol out "canonical_binding")
                     (None [] (panic "declaration missing")) (Some [id] id))
                symbol (get (.symbols out) (cast i64 id))]
            (assert (= (.section symbol) 0)) (assert (.global? symbol))
            (image/release! (mut out)))))
      (calls/release! (mut prototype)) (g/release! (mut graph))
      (private/context-release! (mut context))
      (assert (not (private/module-valid? context publication scope))))
    (image/release! (mut target))
    (println "module publication identity, bytes, scope and nonembedding checks pass")
    0))
