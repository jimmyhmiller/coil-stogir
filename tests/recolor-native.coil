;;; Execute both bypass and call paths with 24 loop-carried values. Every final
;;; value is observable, preventing reassociation from hiding a bad assignment.
(module stogir.tests.recolor-native)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.options" :as options)
(import "stogir.image" :as image)
(import "stogir.link" :as link)
(import "stogir.a64.compile" :as compile)
(import "stogir.a64.private-leaf" :as private)
(import "stogir.aot.macho" :as macho)
(import "stogir.jit.darwin" :as jit)
(import "coil.fs" :as fs)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])
(defn need [T] [(r (Result T (slice u8)))] (-> T)
  (match r (Ok [v] v) (Err [message] (panic "{}" message))))
(defn raw [(graph (mut g/Graph)) (code u8) (ty u8) (inputs (slice i32))] (-> i32)
  (match (g/append-inputs! (mut graph) code ty inputs) (Some [r] r) (None [] (panic "append"))))
(defn callback :cc (cc/C) [(v u64)] (-> u64) (+ (* v 3) 7))
(defn fixture [(enabled bool) (allocator (dyn Allocator))] (-> image/Image)
  (let [(mut graph) (g/create allocator)
        (mut phis) (ArrayList::new [i32] allocator)
        (mut addresses) (ArrayList::new [i32] allocator)
        (mut initial) (ArrayList::new [i32] allocator)
        start (need (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        pointer (need (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        limit (need (b/emit! (mut graph) 71 5 [start (: 0 i32) 1]))
        function (need (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        zero (need (b/scalar-constant! (mut graph) 5 0 8))
        one (need (b/scalar-constant! (mut graph) 5 1 8))
        (mut effect) start]
    (for [j 0 24]
      (let [offset (need (b/scalar-constant! (mut graph) 5 (cast u64 (* j 8)) 8))
            address (need (b/emit! (mut graph) 26 6 [pointer offset]))
            value (need (b/emit! (mut graph) 91 5 [effect address]))]
        (push! (mut addresses) address) (push! (mut initial) value) (set! effect value)))
    (let [enter (need (b/emit! (mut graph) 114 0 [effect]))
          header (raw (mut graph) 113 0 [enter (: 0 i32)])
          counter (raw (mut graph) 67 5 [header zero (: 0 i32)])]
      (for value initial (push! (mut phis) (raw (mut graph) 67 5 [header value (: 0 i32)])))
      (let [condition (need (b/emit! (mut graph) 20 1 [counter limit]))
            branch (need (b/emit! (mut graph) 116 0 [header condition]))
            body (need (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
            exit (need (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
            call-condition (need (b/emit! (mut graph) 14 1 [counter one]))
            split (need (b/emit! (mut graph) 116 0 [body call-condition]))
            yes (need (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
            no (need (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
            (mut call-signature) (need (calls/create 9 5 [(: 5 u8)] allocator))
            called (need (calls/emit! (mut graph) call-signature yes function [(get phis 0)] allocator))
            yes-end (need (b/emit! (mut graph) 114 0 [called]))
            no-end (need (b/emit! (mut graph) 114 0 [no]))
            merge (raw (mut graph) 112 0 [yes-end no-end])
            selected (raw (mut graph) 67 5 [merge called (get phis 0)])
            next-counter (need (b/emit! (mut graph) 26 5 [counter one]))
            back (need (b/emit! (mut graph) 115 0 [merge]))]
        (calls/release! (mut call-signature))
        (need (b/patch! (mut graph) header 2 back))
        (need (b/patch! (mut graph) counter 3 next-counter))
        (for [j 0 24]
          (let [delta (need (b/scalar-constant! (mut graph) 5 (cast u64 (+ j 1)) 8))
                amount (need (b/emit! (mut graph) 26 5 [counter delta]))
                next (need (b/emit! (mut graph) 26 5 [(if (= j 0) selected (get phis j)) amount]))]
            (need (b/patch! (mut graph) (get phis j) 3 next))))
        (set! effect exit)
        (let [(mut sum) zero]
          (for [j 0 24]
            (set! effect (need (b/emit! (mut graph) 93 0 [effect (get addresses j) (get phis j)])))
            (set! sum (need (b/emit! (mut graph) 26 5 [sum (get phis j)]))))
          (let [ret (need (b/emit! (mut graph) 120 5 [effect sum (: 0 i32)]))
                (mut signature) (need (calls/create 9 5 [(: 6 u8) 5 6] allocator))]
            (need (calls/function! (mut graph) signature allocator)) (calls/release! (mut signature))
            (let [code (need (compile/image-with-private graph 1 [ret] "_stogir_recolor"
                               (options/Options :level 3) allocator
                               (private/with-recolor (private/with-loop-reloads
                                 (private/with-loop-evict (private/no-context) true) true) enabled)))]
              (g/release! (mut graph)) (free! (mut phis)) (free! (mut addresses)) (free! (mut initial))
              code)))))))

(defn execute [(code image/Image) (allocator (dyn Allocator))] (-> void)
  (let [(mut module) (need (link/compose [code] allocator))
        (mut loaded) (need (jit/map-image (.image module) allocator))
        index (match (image/find-symbol (.image module) "_stogir_recolor")
                (Some [i] i) (None [] (panic "symbol")))
        function (p/cast (fnptr (cc/C) [(ptr u64) u64 u64] u64)
                    (p/cast (ptr u8) (get (.addresses loaded) (cast i64 index))))
        target (p/cast u64 (p/cast (ptr u8) (fnptr-of callback)))]
    (for count [(: 0 u64) 1 2 3 9 31]
      (for seed [(: 0 u64) 17 0xFFFFFFFFFFFFFF00]
        (let [(mut cells) (ArrayList::new [u64] allocator)
              (mut expected) (ArrayList::new [u64] allocator) (mut sum) (: 0 u64)]
          (for [j 0 24]
            (push! (mut cells) (+ seed (cast u64 (* j 13))))
            (push! (mut expected) (get cells j)))
          (for [i (: 0 u64) count]
            (for [j 0 24]
              (let [v (get expected j) v (if (and (= i 1) (= j 0)) (+ (* v 3) 7) v)]
                (set! (mut expected) j (+ v (+ i (cast u64 (+ j 1))))))))
          (for v expected (set! sum (+ sum v)))
          (assert (= (function (.data cells) count target) sum))
          (for [j 0 24] (assert (= (get cells j) (get expected j))))
          (free! (mut cells)) (free! (mut expected)))))
    (jit/release-image! (mut loaded)) (link/release! (mut module))))
(defn main [] (-> i32)
  (let [allocator (malloc-allocator)]
    (for enabled [false true]
      (let [(mut code) (fixture enabled allocator)]
        (execute code allocator)
        (when enabled
          (let [(mut object) (need (macho/image-object code allocator))]
            (match (fs/write-file allocator "/tmp/coil-stogir-recolor.o" (slice object))
              (Err [_] (panic "write object")) (Ok [_] 0))
            (free! (mut object))))
        (image/release! (mut code)))))
  (println "recolor native bypass, calls and loop-carried pressure: pass") 0)
