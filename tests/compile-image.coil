(module stogir.tests.compile-image)
(import "stogir.graph" :as g)
(import "stogir.target" :as target)
(import "stogir.builder" :as b)
(import "stogir.image" :as image)
(import "stogir.native.compile" :as compile)
(import "stogir.aot.native" :as aot)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [id] id) (Err [msg] (do (println "{}" msg) 0))))

(defn make [] (-> (Result image/Image (slice u8)))
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        parameter (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        constant (require (b/scalar-constant! (mut graph) 11 17 8))
        sum (require (b/emit! (mut graph) 26 11 [parameter constant]))
        ret (require (b/emit! (mut graph) 120 11 [start sum (: 0 i32)]))
        result
          (compile/image graph start [ret] (target/os-pick "_stogir_compile_image" "stogir_compile_image") allocator)]
    (g/release! (mut graph))
    result))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0]
    (match (make)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [compiled]
          (let [(mut source) compiled]
            ; Image owns its code/names independently of the released graph.
            (when (!= (len (.symbols source)) 1) (set! failures (+ failures 1)))
            (match (aot/image-object source allocator)
              (Err [_] (set! failures (+ failures 1)))
              (Ok [object] (let [(mut owned) object] (free! (mut owned)))))
            (match (jit/map-image source allocator)
              (Err [_] (set! failures (+ failures 1)))
              (Ok [loaded]
                  (let [(mut owned) loaded
                        f
                          (primitive/cast (fnptr (cc/C) [i64] i64)
                                          (.base (.memory owned)))
                        (mut x) (: -100 i64)]
                    (while (<= x 100)
                      (when (!= (call-ptr f x) (+ x 17))
                        (set! failures (+ failures 1)))
                      (set! x (+ x 1)))
                    (jit/release-image! (mut owned)))))
            (image/release! (mut source)))))
    (println "compilation image ownership checks: {} failures" failures)
    (if (= failures 0) 0 1)))
