(module stogir.tests.sccp-fold-no-rule)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.sccp-fold" :as fold)
(import "stogir.sccp-values" :as v)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

;;; The fold bridge must retain these instructions, including prototype metadata.
;;; This checks the lattice decision only, not downstream opcode coverage.
(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        source (require (b/emit! (mut graph) 71 7 [start (: 0 i32) 0]))
        proto
          (match (g/append-inputs! (mut graph) 40 7 [source (: 17 i32)])
            (Some [r] r)
            (None [] (panic "graph exhausted")))
        address (require (b/emit! (mut graph) 65 7 [source]))
        frame (require (b/emit! (mut graph) 66 7 []))
        (mut domain) (v/create (len (.instructions graph)) a)
        (mut failures) 0]
    (v/kind! (mut domain) source 131)
    (for r [proto address frame]
      (for width [(: 4 i32) 8]
        (match (fold/evaluate graph domain r width)
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [decision]
              (when (!= (.kind decision) 0) (set! failures (+ failures 1)))))))
    (when (!= (.op2 (get (.instructions graph) (cast i64 proto))) 17)
      (set! failures (+ failures 1)))
    (v/release! (mut domain))
    (g/release! (mut graph))
    (println "SCCP no-rule families: {} failures" failures)
    (if (= failures 0) 0 1)))
