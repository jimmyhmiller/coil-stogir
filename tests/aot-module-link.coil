(module stogir.tests.aot-module-link)
(import "coil.cc" :as cc)

(extern a :as "stogir_module_a" :cc (cc/C) [i64] (-> i64))

(extern b :as "stogir_module_b" :cc (cc/C) [i64] (-> i64))

(extern via :as "stogir_module_via_pointer" :cc (cc/C) [i64] (-> i64))

(extern table :as "stogir_module_table" :cc (cc/C) [u64] (-> u64))

(defn expected [(n i64) (first? bool)] (-> i64)
  (let [(mut i) 0
        (mut a?) first?
        (mut result) 10]
    (while (<= i (if (< n 0) 0 n))
      (set! result (+ result (if a? 65 66)))
      (set! a? (not a?))
      (set! i (+ i 1)))
    result))

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut n) (: -2 i64)]
    (while (<= n 24)
      (when (or (!= (a n) (expected n true))
                (!= (b n) (expected n false))
                (!= (via n) (expected n true)))
        (set! failures (+ failures 1)))
      (set! n (+ n 1)))
    (for tag [(: 0 u64) 1 2 3 4 5 0xFFFFFFFFFFFFFFFF]
      (when (!= (table tag)
                (if (or (= tag 0) (= tag 2) (= tag 4)) (+ 100 tag) 777))
        (set! failures (+ failures 1))))
    (println "linked composed functions, shared data, indirect calls and tables: {} failures"
             failures)
    (if (= failures 0) 0 1)))
