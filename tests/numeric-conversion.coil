(module stogir.tests.numeric-conversion)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "stogir.conversion" :as conversion)
(import "stogir.verify" :as verify)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Option Some None])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [msg] (do (println "{}" msg) 0))))

(defn rejected [(r (Result i32 (slice u8)))] (-> i64)
  (match r (Ok [_] 1) (Err [_] 0)))

(defn check [(opcode i32)
             (src i32)
             (dst i32)
             (pointer-bytes i32)
             (bits u64)
             (wanted (Option u64))] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        constant
          (require (b/scalar-constant! (mut graph) src bits pointer-bytes))
        result
          (require (b/conversion! (mut graph) opcode dst pointer-bytes constant))
        actual (conversion/evaluate opcode src dst pointer-bytes bits)
        (mut failures) 0]
    (match wanted
      (None []
            (do
              (match actual
                (Some [_] (set! failures (+ failures 1)))
                (None [] 0))
              (when (<= result 0) (set! failures (+ failures 1)))))
      (Some [expected]
            (match actual
              (None [] (set! failures (+ failures 1)))
              (Some [value]
                    (when (!= value expected) (set! failures (+ failures 1)))))
            (when (>= result 0) (set! failures (+ failures 1)))
            (match (g/lookup graph result)
              (None [] (set! failures (+ failures 1)))
              (Some [node]
                    (when (or (!= (n/constant-bits node) expected)
                              (!= (cast i32 (n/type-id node)) dst))
                      (set! failures (+ failures 1)))))))
    (when (!= failures 0)
      (println "numeric fold op={} src={} dst={} pointer={} bits={}"
               opcode
               src
               dst
               pointer-bytes
               bits))
    (g/release! (mut graph))
    failures))

