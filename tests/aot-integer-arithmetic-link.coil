(module stogir.tests.aot-integer-arithmetic-link)
(import "coil.cc" :as cc)

(extern unsigned32 :as "stogir_arithmetic_u32" :cc (cc/C) [u32 u32] (-> u32))

(extern unsigned64 :as "stogir_arithmetic_u64" :cc (cc/C) [u64 u64] (-> u64))

(extern signed32 :as "stogir_arithmetic_i32" :cc (cc/C) [i32 i32] (-> i32))

(extern signed64 :as "stogir_arithmetic_i64" :cc (cc/C) [i64 i64] (-> i64))

(defstruct Case
  [(a u64)
   (b u64)
   (u32-result u64)
   (u64-result u64)
   (i32-result u64)
   (i64-result u64)])

;;; Fixed expected bit patterns for DIV(a,b) + MOD(a,b) + ROL(a,b).
(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row [(Case
                :a 0x0
                :b 0x0
                :u32-result 0x0
                :u64-result 0x0
                :i32-result 0x0
                :i64-result 0x0)
              (Case
                :a 0x0
                :b 0x1
                :u32-result 0x0
                :u64-result 0x0
                :i32-result 0x0
                :i64-result 0x0)
              (Case
                :a 0x1
                :b 0x0
                :u32-result 0x2
                :u64-result 0x2
                :i32-result 0x2
                :i64-result 0x2)
              (Case
                :a 0x7
                :b 0x3
                :u32-result 0x3B
                :u64-result 0x3B
                :i32-result 0x3B
                :i64-result 0x3B)
              (Case
                :a 0xFFFFFFFFFFFFFFF9
                :b 0x3
                :u32-result 0x55555522
                :u64-result 0x5555555555555522
                :i32-result 0xFFFFFFCC
                :i64-result 0xFFFFFFFFFFFFFFCC)
              (Case
                :a 0xFFFFFFFFFFFFFFF9
                :b 0xFFFFFFFFFFFFFFFD
                :u32-result 0x3FFFFFF8
                :u64-result 0x3FFFFFFFFFFFFFF8
                :i32-result 0x40000000
                :i64-result 0x4000000000000000)
              (Case
                :a 0x7
                :b 0xFFFFFFFFFFFFFFFD
                :u32-result 0xE0000007
                :u64-result 0xE000000000000007
                :i32-result 0xDFFFFFFF
                :i64-result 0xDFFFFFFFFFFFFFFF)
              (Case
                :a 0x8000000000000000
                :b 0xFFFFFFFFFFFFFFFF
                :u32-result 0x0
                :u64-result 0xC000000000000000
                :i32-result 0x0
                :i64-result 0xC000000000000000)
              (Case
                :a 0xFFFFFFFF80000000
                :b 0xFFFFFFFFFFFFFFFF
                :u32-result 0xC0000000
                :u64-result 0x7FFFFFFF40000000
                :i32-result 0xC0000000
                :i64-result 0x8000000040000000)
              (Case
                :a 0x8000000000000000
                :b 0x2
                :u32-result 0x0
                :u64-result 0x4000000000000002
                :i32-result 0x0
                :i64-result 0xC000000000000002)
              (Case
                :a 0xFFFFFFFF80000000
                :b 0x2
                :u32-result 0x40000002
                :u64-result 0x7FFFFFFDC0000003
                :i32-result 0xC0000002
                :i64-result 0xFFFFFFFDC0000003)
              (Case
                :a 0xFFFFFFFFFFFFFFFF
                :b 0x2
                :u32-result 0x7FFFFFFF
                :u64-result 0x7FFFFFFFFFFFFFFF
                :i32-result 0xFFFFFFFE
                :i64-result 0xFFFFFFFFFFFFFFFE)
              (Case
                :a 0xFFFFFFFF
                :b 0x3
                :u32-result 0x55555554
                :u64-result 0x85555554D
                :i32-result 0xFFFFFFFE
                :i64-result 0x85555554D)
              (Case
                :a 0xFEDCBA9876543210
                :b 0x20
                :u32-result 0x7A06D3B0
                :u64-result 0x7E4B17E5C28F5C38
                :i32-result 0x7A06D3B0
                :i64-result 0x764B17E5C28F5C19)
              (Case
                :a 0xFEDCBA9876543210
                :b 0x40
                :u32-result 0x782D82E8
                :u64-result 0x2D82D82D82D82E8
                :i32-result 0x782D82E8
                :i64-result 0xFED82D82D82D82A9)
              (Case
                :a 0xFEDCBA9876543210
                :b 0x7F
                :u32-result 0x3C189EF4
                :u64-result 0x81701A3B4A34D756
                :i32-result 0x3C189EF4
                :i64-result 0x7F6C122B29F455D4)
              (Case
                :a 0x7FFFFFFFFFFFFFFF
                :b 0x2
                :u32-result 0x7FFFFFFF
                :u64-result 0x3FFFFFFFFFFFFFFD
                :i32-result 0xFFFFFFFE
                :i64-result 0x3FFFFFFFFFFFFFFD)
              (Case
                :a 0x75BCD15
                :b 0x7
                :u32-result 0xAEF3A7D0
                :u64-result 0x3AEF3A7CD
                :i32-result 0xAEF3A7D0
                :i64-result 0x3AEF3A7CD)
              (Case
                :a 0x1
                :b 0x8000000000000000
                :u32-result 0x2
                :u64-result 0x2
                :i32-result 0x2
                :i64-result 0x2)
              (Case
                :a 0x8000000000000000
                :b 0x8000000000000000
                :u32-result 0x0
                :u64-result 0x8000000000000001
                :i32-result 0x0
                :i64-result 0x8000000000000001)]
      (when (or (!= (cast u64
                          (unsigned32 (cast u32 (.a row)) (cast u32 (.b row))))
                    (.u32-result row))
                (!= (unsigned64 (.a row) (.b row)) (.u64-result row))
                (!= (cast u64
                          (cast u32
                                (signed32 (cast i32 (.a row))
                                          (cast i32 (.b row)))))
                    (.i32-result row))
                (!= (cast u64
                          (signed64 (cast i64 (.a row)) (cast i64 (.b row))))
                    (.i64-result row)))
        (set! failures (+ failures 1))))
    (println "linked integer division/remainder/rotate-left checks: {} failures"
             failures)
    (if (= failures 0) 0 1)))
