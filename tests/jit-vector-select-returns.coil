    (22 (target/os-pick "_stogir_vector_select_return_22" "stogir_vector_select_return_22"))
    (23 (target/os-pick "_stogir_vector_select_return_23" "stogir_vector_select_return_23"))
    (_ "invalid")))

(defn fixture-path [(id i32)] (-> (slice u8))
  (match id
    (0 "/tmp/coil-stogir-vector-select-return-0.o")
    (1 "/tmp/coil-stogir-vector-select-return-1.o")
    (2 "/tmp/coil-stogir-vector-select-return-2.o")
    (3 "/tmp/coil-stogir-vector-select-return-3.o")
    (4 "/tmp/coil-stogir-vector-select-return-4.o")
    (5 "/tmp/coil-stogir-vector-select-return-5.o")
    (6 "/tmp/coil-stogir-vector-select-return-6.o")
    (7 "/tmp/coil-stogir-vector-select-return-7.o")
    (8 "/tmp/coil-stogir-vector-select-return-8.o")
    (9 "/tmp/coil-stogir-vector-select-return-9.o")
    (10 "/tmp/coil-stogir-vector-select-return-10.o")
    (11 "/tmp/coil-stogir-vector-select-return-11.o")
    (12 "/tmp/coil-stogir-vector-select-return-12.o")
    (13 "/tmp/coil-stogir-vector-select-return-13.o")
    (14 "/tmp/coil-stogir-vector-select-return-14.o")
    (15 "/tmp/coil-stogir-vector-select-return-15.o")
    (16 "/tmp/coil-stogir-vector-select-return-16.o")
    (17 "/tmp/coil-stogir-vector-select-return-17.o")
    (18 "/tmp/coil-stogir-vector-select-return-18.o")
    (19 "/tmp/coil-stogir-vector-select-return-19.o")
    (20 "/tmp/coil-stogir-vector-select-return-20.o")
    (21 "/tmp/coil-stogir-vector-select-return-21.o")
    (22 "/tmp/coil-stogir-vector-select-return-22.o")
    (23 "/tmp/coil-stogir-vector-select-return-23.o")
    (_ "invalid")))

(defn generate [(ty i32) (cty i32) (mode i32) (id i32)] (-> i64)
  (let [alc (malloc-allocator)
        (mut graph) (g/create alc)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        condition (require (b/emit! (mut graph) 71 cty [start (: 0 i32) 0]))
        (mut yes) (: 0 i32)
        (mut no) (: 0 i32)
        (mut parameters) (ArrayList::new [u8] alc)
        (mut yes-bytes) (ArrayList::new [u8] alc)
        (mut no-bytes) (ArrayList::new [u8] alc)
        (mut failures) 0
        (mut i) (: 0 i32)]
    (push! (mut parameters) (cast u8 cty))
    (if (= mode 0)
        (do
          (set! yes (require (b/emit! (mut graph) 71 ty [start (: 0 i32) 1])))
          (set! no (require (b/emit! (mut graph) 71 ty [start (: 0 i32) 2])))
          (push! (mut parameters) (cast u8 ty))
          (push! (mut parameters) (cast u8 ty)))
        (do
          (while (< i (types/size ty 8))
            (push! (mut yes-bytes)
                   (arm-byte (types/base-type ty) (cast i64 i) 0 mode false))
            (push! (mut no-bytes)
                   (arm-byte (types/base-type ty) (cast i64 i) 0 mode true))
            (set! i (+ i 1)))
          (set! yes
                (require (b/vector-constant! (mut graph) ty 8 (slice yes-bytes))))
          (set! no
                (require (b/vector-constant! (mut graph) ty 8 (slice no-bytes))))))
    (match (calls/create (target/arch-pick 9 8) (cast u8 ty) (slice parameters) alc)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (require (calls/function! (mut graph) prototype alc))
            (calls/release! (mut prototype)))))
    (let [result (require (b/conditional! (mut graph) ty condition yes no))
          ret (require (b/emit! (mut graph) 120 ty [start result (: 0 i32)]))]
      (match (compile/object graph start [ret] (fixture-name id) alc)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [object]
            (let [(mut object) object]
              (match (fs/write-file alc (fixture-path id) (slice object))
                (Err [_] (set! failures (+ failures 1)))
                (Ok [_] 0))
              (free! (mut object)))))
      (match (compile/image graph start [ret] (target/os-pick "_vector_select_return_jit" "vector_select_return_jit") alc)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [source]
            (let [(mut source) source]
              (match (jit/map-image source alc)
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [loaded]
                    (let [(mut loaded) loaded]
                      (set! failures
                            (+ failures
                               (exercise ty cty mode (.base (.memory loaded)))))
                      (jit/release-image! (mut loaded)))))
              (image/release! (mut source))))))
    (free! (mut parameters))
    (free! (mut yes-bytes))
    (free! (mut no-bytes))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (set! failures (+ failures (generate 81 5 0 0)))
    (set! failures (+ failures (generate 81 5 3 1)))
    (set! failures (+ failures (generate 81 12 0 2)))
    (set! failures (+ failures (generate 81 12 3 3)))
    (set! failures (+ failures (generate 81 13 0 4)))
    (set! failures (+ failures (generate 81 13 3 5)))
    (set! failures (+ failures (generate 22 5 0 6)))
    (set! failures (+ failures (generate 22 5 3 7)))
    (set! failures (+ failures (generate 22 12 0 8)))
    (set! failures (+ failures (generate 22 12 3 9)))
    (set! failures (+ failures (generate 22 13 0 10)))
    (set! failures (+ failures (generate 22 13 3 11)))
    (set! failures (+ failures (generate 45 5 0 12)))
    (set! failures (+ failures (generate 45 5 3 13)))
    (set! failures (+ failures (generate 45 12 0 14)))
    (set! failures (+ failures (generate 45 12 3 15)))
    (set! failures (+ failures (generate 45 13 0 16)))
    (set! failures (+ failures (generate 45 13 3 17)))
    (set! failures (+ failures (generate 44 5 0 18)))
    (set! failures (+ failures (generate 44 5 3 19)))
    (set! failures (+ failures (generate 44 12 0 20)))
    (set! failures (+ failures (generate 44 12 3 21)))
    (set! failures (+ failures (generate 44 13 0 22)))
    (set! failures (+ failures (generate 44 13 3 23)))
    (println "typed vector selection returns: 24 graphs; failures {}" failures)
    failures))
