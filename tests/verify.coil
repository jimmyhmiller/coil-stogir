(module stogir.tests.verify)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as v)
(import "stogir.node" :as n)
(import "stogir.vector" :as vector)
(import "stogir.floating" :as floating)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

(defn same [(left (Result i32 (slice u8))) (right (Result i32 (slice u8)))]
  (-> void)
  (match left
    (Ok [x]
        (match right
          (Ok [y] (assert (= x y)))
          (Err [_] (panic "unexpected error"))))
    (Err [x]
         (match right
           (Err [y] (assert (= x y)))
           (Ok [_] (panic "missing error"))))))

;;; Compare complete diagnostic priority and final counts with the original
;;; sequential API composition, including multiple simultaneous corruptions.
(defn composite-check [(graph g/Graph) (width i32)] (-> void)
  (let [pair
          (match (v/integer-operations-target graph width)
            (Err [message] (Err [i32 (slice u8)] message))
            (Ok [_] (v/phis graph)))
        triple
          (match (v/integer-operations-target graph width)
            (Err [message] (Err [i32 (slice u8)] message))
            (Ok [_]
                (match (v/constants graph width)
                  (Err [message] (Err [i32 (slice u8)] message))
                  (Ok [_] (v/phis graph)))))]
    (same pair (v/operations-and-phis-target graph width))
    (same triple (v/operations-constants-and-phis-target graph width))))

(defn composite-cases [] (-> void)
  (for mode (range 0 12)
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          input (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
          literal (require (b/scalar-constant! (mut graph) 5 42 8))
          left (require (b/emit! (mut graph) 114 0 [start]))
          right (require (b/emit! (mut graph) 114 0 [start]))
          merge (require (b/emit! (mut graph) 112 0 [left right]))
          phi (require (b/emit! (mut graph) 67 5 [merge input literal]))
          ret (require (b/emit! (mut graph) 120 5 [merge phi (: 0 i32)]))]
      (case mode
        1 (g/set-operand! (mut graph) phi 1 start)
        2 (g/set-operand! (mut graph) phi 2 999999)
        3 (set! (mut (.arities graph)) (cast i64 phi) 2)
        4
          (set! (mut (.instructions graph))
                (cast i64 phi)
                (n/make 67 4 3 merge input literal))
        5 (set! (mut (.constants graph)) 0 (n/constant 0 0 0 42))
        6
          (set! (mut (.instructions graph))
                (cast i64 input)
                (n/make 255 5 0 start 0 0))
        7 (set! (mut (.arities graph)) (cast i64 start) -1)
        8
          (set! (mut (.instructions graph))
                (cast i64 ret)
                (n/make 120 4 0 merge phi 0))
        9
          (do
            (set! (mut (.constants graph)) 0 (n/constant 0 0 0 42))
            (g/set-operand! (mut graph) phi 1 start))
        10
          (do
            (set! (mut (.constants graph)) 0 (n/constant 0 0 0 42))
            (set! (mut (.instructions graph))
                  (cast i64 ret)
                  (n/make 120 4 0 merge phi 0)))
        11 (pop! (mut (.arities graph)))
        0)
      (for width [(: 4 i32) 8] (composite-check graph width))
      (g/release! (mut graph)))))

;;; Preserve exact absence/local-storage diagnostics, including their priority.
;;; Void RETURN's absent value remains legal despite its data-reference role.
(defn structure-reference-cases [] (-> void)
  (for mode (range 0 10)
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          input (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          literal (require (b/scalar-constant! (mut graph) 11 42 8))
          local (require (b/variable! (mut graph) 11 start "local" 8))
          end (require (b/emit! (mut graph) 114 0 [start]))
          wide (require (b/emit! (mut graph) 112 0 [end end end end end]))
          add (require (b/emit! (mut graph) 26 11 [input literal]))
          ret (require (b/emit! (mut graph) 120 0 [start (: 0 i32) 0]))]
      (case mode
        1
          (do
            (g/set-operand! (mut graph) add 1 literal)
            (g/set-operand! (mut graph) add 2 input))
        2 (g/set-operand! (mut graph) add 1 0)
        3 (g/set-operand! (mut graph) add 2 0)
        4 (g/set-operand! (mut graph) add 1 2147483647)
        5 (g/set-operand! (mut graph) add 1 -2147483648)
        6 (g/set-operand! (mut graph) add 1 (+ wide 1))
        7 (g/set-operand! (mut graph) add 1 local)
        8
          (do
            (g/set-operand! (mut graph) add 1 local)
            (g/set-operand! (mut graph) add 2 999999))
        9
          (do
            (g/set-operand! (mut graph) add 1 999999)
            (g/set-operand! (mut graph) add 2 local))
        0)
      (match (v/structure graph)
        (Ok [_] (assert (< mode 2)))
        (Err [message]
             (assert (>= mode 2))
             (assert (= message
                        (if (or (= mode 7) (= mode 8))
                            "local storage is not a register value"
                            "dangling reference operand")))))
      (g/release! (mut graph)))))

;;; Compare independent original classifiers on raw storage, including absent,
;;; continuation, negative and ill-typed inputs. The classifier itself is pure;
;;; structural validation still rejects malformed graphs before its caller runs.
(defn classification-cases [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        (mut inputs) (ArrayList::new [i32] a)]
    (for ty [(: 0 u8) 1 5 6 11 12 13 18 37 44 127 255]
      (match (g/append-inputs! (mut graph) 71 ty [(: 0 i32) 0 0])
        (None [] (panic "classification input storage"))
        (Some [r] (push! (mut inputs) r))))
    (for ty [(: 5 u8) 12 37]
      (match (g/intern-scalar! (mut graph) ty 0)
        (None [] (panic "classification constant storage"))
        (Some [r] (push! (mut inputs) r))))
    (let [reference
            (match (g/append-inputs! (mut graph) 67 5
                                      [(: 0 i32) 0 0 0 0 0 0 0])
              (None [] (panic "classification subject storage"))
              (Some [r] r))]
      (for r [(: 0 i32) 999999 -2147483648 (+ reference 1)]
        (push! (mut inputs) r))
      (for first inputs
        (for second inputs
          (set! (mut (.arities graph)) (cast i64 reference) 8)
          (for i [(: 1 i32) 2 3 4 5 6 7 8]
            (assert (g/set-operand! (mut graph) reference i
                                     (if (= (% i 2) 0) second first))))
          (for opcode (range 0 134)
            (for ty [(: 0 u8) 1 5 12 37 255]
              (for count [(: 0 i32) 1 2 4 8]
                (set! (mut (.arities graph)) (cast i64 reference) count)
                (let [node (n/make (cast u8 opcode) ty 0 first second first)]
                  (set! (mut (.instructions graph)) (cast i64 reference) node)
                  (let [actual (v/classifications graph reference node count)]
                    (assert (= (.vector? actual) (vector/involves? graph reference)))
                    (assert (= (.floating? actual) (floating/node? graph reference)))))))))))
    (free! (mut inputs))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (classification-cases)
  (structure-reference-cases)
  (composite-cases)
  (let [(mut graph) (g/create (malloc-allocator))
        (mut failures) 0]
    (match (b/scalar-constant! (mut graph) 11 42 8)
      (Ok [c]
          (match (b/emit! (mut graph) 26 11 [c c])
            (Ok [r]
                (do
                  (match (v/structure graph)
                    (Ok [count]
                        (when (!= count 1) (set! failures (+ failures 1))))
                    (Err [_] (set! failures (+ failures 1))))
                  (g/set-operand! (mut graph) r 1 999)
                  (match (v/structure graph)
                    (Ok [_] (set! failures (+ failures 1)))
                    (Err [_] 0))))
            (Err [_] (set! failures (+ failures 1)))))
      (Err [_] (set! failures (+ failures 1))))
    (match (v/scalar-constants graph 8)
      (Ok [_] 0)
      (Err [_] (set! failures (+ failures 1))))
    (match (v/scalar-constants graph 3)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    (println "verifier checks: {} failures" failures)
    (if (= failures 0) 0 1)))
