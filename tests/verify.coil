(module stogir.tests.verify)
(import "stogir.validation-kind" :as kind)
(import "stogir.opcode" :as op)
(import "stogir.integer-binary" :as binary)
(import "stogir.integer-unary" :as unary)
(import "stogir.vector-lanes" :as lanes)
(import "stogir.checked" :as checked)
(import "stogir.atomic" :as atomic)
(import "stogir.terminal" :as terminal)
(import "stogir.switch" :as switch)
(import "stogir.calls" :as calls)
(import "stogir.noted" :as noted)
(import "stogir.stack" :as stack)
(import "stogir.locals" :as locals)
(import "stogir.conversion" :as conversion)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as v)
(import "stogir.node" :as n)
(import "stogir.vector" :as vector)
(import "stogir.floating" :as floating)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

(defn same [(left (Result i32 (slice u8))) (right (Result i32 (slice u8)))]
  (-> void)
  (match left
    (Ok [x]
        (match right
          (Ok [y] (assert (= x y)))
          (Err [_] (panic "unexpected error"))))
    (Err [x]
         (match right
           (Err [y] (assert (= x y)))
           (Ok [_] (panic "missing error"))))))

;;; Compare complete diagnostic priority and final counts with the original
;;; sequential API composition, including multiple simultaneous corruptions.
(defn composite-check [(graph g/Graph) (width i32)] (-> void)
  (let [pair
          (match (v/integer-operations-target graph width)
            (Err [message] (Err [i32 (slice u8)] message))
            (Ok [_] (v/phis graph)))
        triple
          (match (v/integer-operations-target graph width)
            (Err [message] (Err [i32 (slice u8)] message))
            (Ok [_]
                (match (v/constants graph width)
                  (Err [message] (Err [i32 (slice u8)] message))
                  (Ok [_] (v/phis graph)))))]
    (same pair (v/operations-and-phis-target graph width))
    (same triple (v/operations-constants-and-phis-target graph width))
    (noted-check graph width pair triple)))

;;; The noting forms give the same answers, and each later check gives the
;;; same answer from the notes as from its own walk over every node.
(defn noted-check [(graph g/Graph) (width i32)
                   (pair (Result i32 (slice u8))) (triple (Result i32 (slice u8)))] (-> void)
  (let [a (malloc-allocator)
        (mut first) (noted/create a)
        (mut second) (noted/create a)
        (mut third) (noted/create a)]
    (same pair (v/operations-and-phis-target-noting graph width (mut first)))
    (same triple (v/operations-constants-and-phis-target-noting graph width (mut second)))
    (same (v/structure graph) (v/structure-noting graph (mut third) true))
    (match (v/structure graph)
      (Err [_] 0)
      (Ok [_]
          ; The notes are exactly the nodes with a later role, in order.
          (let [(mut expected) (ArrayList::new [i32] a)
                (mut r) (: 1 i64)]
            (while (< r (len (.instructions graph)))
              (let [opcode (cast i32 (n/opcode (get (.instructions graph) r)))]
                (when (or (= opcode 67) (= opcode 40) (= opcode 79) (= opcode 80)
                          (= opcode 117) (= opcode 104) (terminal/chain? opcode))
                  (push! (mut expected) (cast i32 r))))
              (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4))))
            (assert (= (len expected) (len (.nodes third))))
            (for [i 0 (len expected)]
              (assert (= (get expected i) (get (.nodes third) i))))
            (free! (mut expected)))
          (same (v/phis-structured graph) (v/phis-among graph (slice (.nodes third))))
          (same (terminal/verify-chains graph a)
                (terminal/verify-chains-among graph (slice (.nodes third)) a))
          (same (calls/verify graph (malloc-allocator)) (calls/verify-among graph (slice (.nodes third)) (malloc-allocator)))
          (same (switch/verify graph a) (switch/verify-among graph third a))))
    (noted/release! (mut first))
    (noted/release! (mut second))
    (noted/release! (mut third))))

(defn composite-cases [] (-> void)
  (for mode (range 0 12)
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          input (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
          literal (require (b/scalar-constant! (mut graph) 5 42 8))
          left (require (b/emit! (mut graph) 114 0 [start]))
          right (require (b/emit! (mut graph) 114 0 [start]))
          merge (require (b/emit! (mut graph) 112 0 [left right]))
          phi (require (b/emit! (mut graph) 67 5 [merge input literal]))
          ret (require (b/emit! (mut graph) 120 5 [merge phi (: 0 i32)]))]
      (case mode
        1 (g/set-operand! (mut graph) phi 1 start)
        2 (g/set-operand! (mut graph) phi 2 999999)
        3 (set! (mut (.arities graph)) (cast i64 phi) 2)
        4
          (set! (mut (.instructions graph))
                (cast i64 phi)
                (n/make 67 4 3 merge input literal))
        5 (set! (mut (.constants graph)) 0 (n/constant 0 0 0 42))
        6
          (set! (mut (.instructions graph))
                (cast i64 input)
                (n/make 255 5 0 start 0 0))
        7 (set! (mut (.arities graph)) (cast i64 start) -1)
        8
          (set! (mut (.instructions graph))
                (cast i64 ret)
                (n/make 120 4 0 merge phi 0))
        9
          (do
            (set! (mut (.constants graph)) 0 (n/constant 0 0 0 42))
            (g/set-operand! (mut graph) phi 1 start))
        10
          (do
            (set! (mut (.constants graph)) 0 (n/constant 0 0 0 42))
            (set! (mut (.instructions graph))
                  (cast i64 ret)
                  (n/make 120 4 0 merge phi 0)))
        11 (pop! (mut (.arities graph)))
        0)
      (for width [(: 4 i32) 8] (composite-check graph width))
      (g/release! (mut graph)))))

;;; Preserve exact absence/local-storage diagnostics, including their priority.
;;; Void RETURN's absent value remains legal despite its data-reference role.
(defn structure-reference-cases [] (-> void)
  (for mode (range 0 10)
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          input (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          literal (require (b/scalar-constant! (mut graph) 11 42 8))
          local (require (b/variable! (mut graph) 11 start "local" 8))
          end (require (b/emit! (mut graph) 114 0 [start]))
          wide (require (b/emit! (mut graph) 112 0 [end end end end end]))
          add (require (b/emit! (mut graph) 26 11 [input literal]))
          ret (require (b/emit! (mut graph) 120 0 [start (: 0 i32) 0]))]
      (case mode
        1
          (do
            (g/set-operand! (mut graph) add 1 literal)
            (g/set-operand! (mut graph) add 2 input))
        2 (g/set-operand! (mut graph) add 1 0)
        3 (g/set-operand! (mut graph) add 2 0)
        4 (g/set-operand! (mut graph) add 1 2147483647)
        5 (g/set-operand! (mut graph) add 1 -2147483648)
        6 (g/set-operand! (mut graph) add 1 (+ wide 1))
        7 (g/set-operand! (mut graph) add 1 local)
        8
          (do
            (g/set-operand! (mut graph) add 1 local)
            (g/set-operand! (mut graph) add 2 999999))
        9
          (do
            (g/set-operand! (mut graph) add 1 999999)
            (g/set-operand! (mut graph) add 2 local))
        0)
      (match (v/structure graph)
        (Ok [_] (assert (< mode 2)))
        (Err [message]
             (assert (>= mode 2))
             (assert (= message
                        (if (or (= mode 7) (= mode 8))
                            "local storage is not a register value"
                            "dangling reference operand")))))
      (g/release! (mut graph)))))

;;; Compare independent original classifiers on raw storage, including absent,
;;; continuation, negative and ill-typed inputs. The classifier itself is pure;
;;; structural validation still rejects malformed graphs before its caller runs.
(defn classification-cases [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        (mut inputs) (ArrayList::new [i32] a)]
    (for ty [(: 0 u8) 1 5 6 11 12 13 18 37 44 127 255]
      (match (g/append-inputs! (mut graph) 71 ty [(: 0 i32) 0 0])
        (None [] (panic "classification input storage"))
        (Some [r] (push! (mut inputs) r))))
    (for ty [(: 5 u8) 12 37]
      (match (g/intern-scalar! (mut graph) ty 0)
        (None [] (panic "classification constant storage"))
        (Some [r] (push! (mut inputs) r))))
    (let [reference
            (match (g/append-inputs! (mut graph)
                                     67
                                     5
                                     [(: 0 i32) 0 0 0 0 0 0 0])
              (None [] (panic "classification subject storage"))
              (Some [r] r))]
      (for r [(: 0 i32) 999999 -2147483648 (+ reference 1)]
        (push! (mut inputs) r))
      (for first inputs
        (for second inputs
          (set! (mut (.arities graph)) (cast i64 reference) 8)
          (for i [(: 1 i32) 2 3 4 5 6 7 8]
            (assert (g/set-operand! (mut graph)
                                    reference
                                    i
                                    (if (= (% i 2) 0) second first))))
          (for opcode (range 0 134)
            (for ty [(: 0 u8) 1 5 12 37 255]
              (for count [(: 0 i32) 1 2 4 8]
                (set! (mut (.arities graph)) (cast i64 reference) count)
                (let [node (n/make (cast u8 opcode) ty 0 first second first)]
                  (set! (mut (.instructions graph)) (cast i64 reference) node)
                  (let [actual (v/classifications graph reference node count)]
                    (assert (= (.vector? actual)
                               (vector/involves? graph reference)))
                    (assert (= (.floating? actual)
                               (floating/node? graph reference)))))))))))
    (free! (mut inputs))
    (g/release! (mut graph))))

;;; Every table entry must retain exactly the canonical family selection,
;;; including invalid identifiers; dispatch never substitutes for validation.
(defn dispatch-cases [] (-> void)
  (assert (= (kind/count) (op/count)))
  (for [value -5 (+ (cast i64 (op/count)) 5)]
    (let [opcode (cast i32 value)
          flags (kind/flags opcode)]
      (assert (= (!= (& flags kind/BINARY) 0) (binary/operation? opcode)))
      (assert (= (!= (& flags kind/UNARY) 0) (unary/operation? opcode)))
      (assert (= (!= (& flags kind/LANES) 0) (lanes/operation? opcode)))
      (assert (= (!= (& flags kind/CHECKED) 0) (checked/operation? opcode)))
      (assert (= (!= (& flags kind/ATOMIC) 0) (atomic/operation? opcode)))
      (assert (= (!= (& flags kind/TERMINAL) 0) (terminal/operation? opcode)))
      (assert (= (!= (& flags kind/SWITCH) 0) (switch/operation? opcode)))
      (assert (= (!= (& flags kind/STACK) 0) (stack/operation? opcode)))
      (assert (= (!= (& flags kind/LOCALS) 0) (locals/operation? opcode)))
      (assert (= (!= (& flags kind/CONVERSION) 0)
                 (conversion/operation? opcode)))
      (assert (= (!= (& flags kind/FLOATING) 0) (floating/operation? opcode))))))

(defn reference-domain-case [] (-> void)
 (let [(mut graph) (g/create (malloc-allocator))
       instructions-len (.len (.instructions graph)) instructions-cap (.cap (.instructions graph))
       arities-len (.len (.arities graph)) arities-cap (.cap (.arities graph))]
  ; Fabricate only header metadata. The verifier must reject the impossible
  ; reference domain before touching storage beyond the real allocation.
  (set! (.len (.instructions graph)) 2147483649)
  (set! (.cap (.instructions graph)) 2147483649)
  (set! (.len (.arities graph)) 2147483649)
  (set! (.cap (.arities graph)) 2147483649)
  (let [checked (v/structure graph)]
   (set! (.len (.instructions graph)) instructions-len)
   (set! (.cap (.instructions graph)) instructions-cap)
   (set! (.len (.arities graph)) arities-len)
   (set! (.cap (.arities graph)) arities-cap)
   (match checked (Ok [_] (panic "oversized instruction storage accepted"))
     (Err [message] (assert (= message "instruction storage exceeds signed reference domain")))))
  (g/release! (mut graph))))

;;; The structured integer reader relies only on roles structure validates.
;;; Keep this precondition tied to every canonical dispatch entry.
(defn integer-data-role-cases [] (-> void)
  (for [opcode 0 (cast i64 (kind/count))]
    (let [code (cast i32 opcode) families (kind/flags code)
          comparison? (and (>= code 14) (<= code 23))
          binary? (!= (& families kind/BINARY) 0)
          unary? (!= (& families kind/UNARY) 0)]
      (when (or comparison? binary? unary?)
        (let [left (op/operand-code code 1)]
          (assert (or (= left op/OPERAND-DEF) (= left op/OPERAND-REF))))
        (when (or comparison? binary?)
          (let [right (op/operand-code code 2)]
            (assert (or (= right op/OPERAND-DEF) (= right op/OPERAND-REF)))))))))

(defn main [] (-> i64)
  (integer-data-role-cases)
  (reference-domain-case)
  (dispatch-cases)
  (classification-cases)
  (structure-reference-cases)
  (composite-cases)
  (let [(mut graph) (g/create (malloc-allocator))
        (mut failures) 0]
    (match (b/scalar-constant! (mut graph) 11 42 8)
      (Ok [c]
          (match (b/emit! (mut graph) 26 11 [c c])
            (Ok [r]
                (do
                  (match (v/structure graph)
                    (Ok [count]
                        (when (!= count 1) (set! failures (+ failures 1))))
                    (Err [_] (set! failures (+ failures 1))))
                  (g/set-operand! (mut graph) r 1 999)
                  (match (v/structure graph)
                    (Ok [_] (set! failures (+ failures 1)))
                    (Err [_] 0))))
            (Err [_] (set! failures (+ failures 1)))))
      (Err [_] (set! failures (+ failures 1))))
    (match (v/scalar-constants graph 8)
      (Ok [_] 0)
      (Err [_] (set! failures (+ failures 1))))
    (match (v/scalar-constants graph 3)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    (println "verifier checks: {} failures" failures)
    (if (= failures 0) 0 1)))
