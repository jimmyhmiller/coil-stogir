(module stogir.tests.unary)
(import "stogir.fold" :as f)
(import "coil.result" :use [Some None])

(defn check [(opcode i32) (ty i32) (bits u64) (want u64)] (-> i64)
  (match (f/integer-unary opcode ty 8 bits)
    (Some [got] (if (= got want) 0 1))
    (None [] 1)))

(defn main [] (-> i64)
  (let [failures
          (+ (check 31 2 1 255)
             (check 31 8 128 128)
             (check 31 11 0x8000000000000000 0x8000000000000000)
             (check 31 5 0 0)
             (check 45 2 0 255)
             (check 45 5 0 0xFFFFFFFFFFFFFFFF)
             (check 45 1 0 1)
             (check 45 1 1 0))]
    (println "unary checks: {} failures" failures)
    (if (= failures 0) 0 1)))
