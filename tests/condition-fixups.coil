(module stogir.tests.condition-fixups)
(import "stogir.a64.fixups" :as f)
(import "stogir.a64.function" :as function)
(import "stogir.a64.code" :as code)
(import "stogir.text-data" :as data)
(import "stogir.bytes" :as b)
(import "stogir.relocate" :as read)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

;;; Two B.EQ ; CMP ; B.NE triples to one target, at 0 and at 16. The first
;;; always merges and carries three labels (two on its branch, one on its
;;; comparison). `blocker` puts one thing on or beside the second triple;
;;; `blocked` says whether that must keep it from merging.
(defn merged [(blocker i64) (blocked bool)] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut alignment) (ArrayList::new [i32] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut relatives) (ArrayList::new [f/Relative] a)
        (mut removed) (ArrayList::new [i64] a)
        (mut failures) 0]
    (b/append32! (mut (.text output)) 0x54000000)
    (b/append32! (mut (.text output)) 0xEB02003F)
    (b/append32! (mut (.text output)) 0x54000001)
    (b/append32! (mut (.text output)) 0xAA0003E0)
    (b/append32! (mut (.text output)) 0x54000000)
    (b/append32! (mut (.text output)) 0xEB04007F)
    (b/append32! (mut (.text output)) 0x54000001)
    (b/append32! (mut (.text output)) 0xD65F03C0)
    (push! (mut labels) 28)
    (push! (mut labels) 0)
    (push! (mut labels) 0)
    (push! (mut labels) 16)
    (push! (mut labels) 4)
    (push! (mut labels)
           (cond (or (= blocker 2) (= blocker 11)) 20
                 (= blocker 10) 28
                 (= blocker 12) 12
                 :else -1))
    (for [i 0 5] (push! (mut alignment) 4))
    (push! (mut alignment) (if (or (= blocker 2) (= blocker 10) (= blocker 12)) 8 4))
    (push! (mut branches) (f/Branch :offset 0 :label 0 :condition 0 :link false))
    (push! (mut branches) (f/Branch :offset 8 :label 0 :condition 1 :link false))
    (push! (mut branches) (f/Branch :offset 16 :label 0 :condition 0 :link false))
    (push! (mut branches) (f/Branch :offset 24 :label 0 :condition 1 :link false))
    (when (= blocker 11)
      (push! (mut branches) (f/Branch :offset 28 :label 5 :condition -1 :link false)))
    (when (= blocker 1)
      (push! (mut (.references output)) (code/Reference :offset 22 :kind 4 :target -1)))
    (when (= blocker 3)
      (push! (mut relatives) (f/Relative :offset 24 :base 0 :label 0)))
    (when (= blocker 4)
      (push! (mut (.text-data output)) (data/Range :offset 18 :length 1 :kind 1)))
    (when (= blocker 5)
      (push! (mut (.text-data output)) (data/Range :offset 20 :length 0 :kind 1)))
    (when (= blocker 6)
      (push! (mut (.text-data output)) (data/Range :offset 16 :length 0 :kind 1)))
    (when (= blocker 7)
      (push! (mut (.text-data output)) (data/Range :offset 12 :length 4 :kind 4)))
    (when (= blocker 8)
      (push! (mut (.text-data output)) (data/Range :offset 28 :length 4 :kind 4))
      (push! (mut (.references output)) (code/Reference :offset 28 :kind 4 :target -1)))
    (when (= blocker 9)
      (push! (mut (.text-data output)) (data/Range :offset 27 :length 1 :kind 1)))
    (let [count (f/merge-conditions! (mut output) (mut labels) (mut branches) relatives
                                     alignment (mut removed))
          extra (if (= blocker 11) 1 0)]
      (when (!= count (if blocked 1 2)) (set! failures (+ failures 1)))
      (when (!= (len branches) (+ (if blocked 3 2) extra)) (set! failures (+ failures 1)))
      (when (!= (len removed) (if blocked 1 2)) (set! failures (+ failures 1)))
      (when (or (< (len removed) 1) (!= (get removed 0) 0)) (set! failures (+ failures 1)))
      (when (and (not blocked) (or (< (len removed) 2) (!= (get removed 1) 4)))
        (set! failures (+ failures 1)))
      ; The first triple: NOP, CCMP, and its labels on the comparison word.
      (when (or (!= (read/read32 (.text output) 0) 0xD503201F)
                (= (read/read32 (.text output) 4) 0xEB02003F)
                (!= (read/read32 (.text output) 8) 0x54000001)
                (!= (get labels 0) 28)
                (!= (get labels 1) 4)
                (!= (get labels 2) 4)
                (!= (get labels 4) 4))
        (set! failures (+ failures 1)))
      (if blocked
          (when (or (!= (read/read32 (.text output) 16) 0x54000000)
                    (!= (read/read32 (.text output) 20) 0xEB04007F)
                    (!= (get labels 3) 16))
            (set! failures (+ failures 1)))
          (when (or (!= (read/read32 (.text output) 16) 0xD503201F)
                    (= (read/read32 (.text output) 20) 0xEB04007F)
                    (!= (get labels 3) 20))
            (set! failures (+ failures 1))))
      (when (!= (get labels 5)
                (cond (or (= blocker 2) (= blocker 11)) 20
                      (= blocker 10) 28
                      (= blocker 12) 12
                      :else -1))
        (set! failures (+ failures 1))))
    (when (!= failures 0) (println "condition merge case {} failed" blocker))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut alignment))
    (free! (mut branches))
    (free! (mut relatives))
    (free! (mut removed))
    failures))

;;; SUB x0,x1,#1 ; MOV ; CMP x0,#0 ; B.GT ; RET with two labels on the CMP.
;;; `position` is where a fourth label sits and `kind` what makes it matter:
;;; 0 nothing, 1 a branch to it, 2 a table entry for it, 3 its alignment.
;;; `applied` says whether the fusion must happen.
(defn fused [(position i64) (kind i64) (applied bool)] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut alignment) (ArrayList::new [i32] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut relatives) (ArrayList::new [f/Relative] a)
        (mut fusions) (ArrayList::new [function/FlagFusion] a)
        (mut removed) (ArrayList::new [i64] a)
        (mut failures) 0]
    (b/append32! (mut (.text output)) 0xD1000420)
    (b/append32! (mut (.text output)) 0xAA0003E0)
    (b/append32! (mut (.text output)) 0xF100001F)
    (b/append32! (mut (.text output)) 0x5400000C)
    (b/append32! (mut (.text output)) 0xD65F03C0)
    (push! (mut labels) 16)
    (push! (mut labels) 8)
    (push! (mut labels) 8)
    (push! (mut labels) position)
    (for [i 0 3] (push! (mut alignment) 4))
    (push! (mut alignment) (if (= kind 3) 8 4))
    (push! (mut branches) (f/Branch :offset 12 :label 0 :condition 12 :link false))
    (when (= kind 1)
      (push! (mut branches) (f/Branch :offset 16 :label 3 :condition -1 :link false)))
    (when (= kind 2)
      (push! (mut relatives) (f/Relative :offset 16 :base 16 :label 3)))
    (push! (mut fusions) (function/FlagFusion :update 0 :compare 8))
    (match (function/apply-flag-fusions! (mut output) (mut labels) branches relatives
                                   alignment fusions (mut removed))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [count] (when (!= count (if applied 1 0)) (set! failures (+ failures 1)))))
    (if applied
        (when (or (!= (read/read32 (.text output) 0) 0xF1000420)
                  (!= (read/read32 (.text output) 8) 0xD503201F)
                  (!= (len removed) 1)
                  (!= (get labels 1) 12)
                  (!= (get labels 2) 12))
          (set! failures (+ failures 1)))
        (when (or (!= (read/read32 (.text output) 0) 0xD1000420)
                  (!= (read/read32 (.text output) 8) 0xF100001F)
                  (!= (len removed) 0)
                  (!= (get labels 1) 8)
                  (!= (get labels 2) 8))
          (set! failures (+ failures 1))))
    ; A label that is not on the CMP never moves; one on it moves with the rest.
    (when (!= (get labels 3) (if (and applied (= position 8)) 12 position))
      (set! failures (+ failures 1)))
    (when (!= (get labels 0) 16) (set! failures (+ failures 1)))
    (when (!= failures 0) (println "flag fusion case {} {} failed" position kind))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut alignment))
    (free! (mut branches))
    (free! (mut relatives))
    (free! (mut fusions))
    (free! (mut removed))
    failures))

;;; A record that does not name a SUB before a CMP inside the text is refused.
(defn refused [(update i64) (compare i64)] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut alignment) (ArrayList::new [i32] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut relatives) (ArrayList::new [f/Relative] a)
        (mut fusions) (ArrayList::new [function/FlagFusion] a)
        (mut removed) (ArrayList::new [i64] a)
        (mut failures) 0]
    (b/append32! (mut (.text output)) 0xD1000420)
    (b/append32! (mut (.text output)) 0xF100001F)
    (b/append32! (mut (.text output)) 0xD65F03C0)
    (push! (mut fusions) (function/FlagFusion :update update :compare compare))
    (match (function/apply-flag-fusions! (mut output) (mut labels) branches relatives
                                   alignment fusions (mut removed))
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (when (or (!= (read/read32 (.text output) 0) 0xD1000420)
              (!= (read/read32 (.text output) 4) 0xF100001F)
              (!= (len removed) 0))
      (set! failures (+ failures 1)))
    (when (!= failures 0) (println "flag fusion record {} {} was not refused" update compare))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut alignment))
    (free! (mut branches))
    (free! (mut relatives))
    (free! (mut fusions))
    (free! (mut removed))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (merged 0 false)
             (merged 1 true)
             (merged 2 true)
             (merged 3 true)
             (merged 4 true)
             (merged 5 true)
             (merged 6 false)
             (merged 7 false)
             (merged 8 false)
             (merged 9 true)
             (merged 10 false)
             (merged 11 true)
             (merged 12 false)
             (fused -1 0 true)
             (fused 8 1 false)
             (fused 4 1 false)
             (fused 0 1 true)
             (fused 12 1 true)
             (fused 1 1 false)
             (fused 6 2 false)
             (fused 8 2 false)
             (fused 12 2 true)
             (fused 8 3 false)
             (fused 5 3 false)
             (fused 0 3 true)
             (fused 12 3 true)
             (fused 8 0 true)
             (refused 4 4)
             (refused 4 0)
             (refused 0 12)
             (refused 0 6)
             (refused -4 4))]
    (println "condition fixup checks: {} failures" failures)
    (if (= failures 0) 0 1)))
