(module stogir.tests.elf-basic-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

;;; Links /tmp/stogir-x64-elf-basic.o and /tmp/stogir-x64-elf-text.o, written by
;;; tests/elf-basic.coil (Linux x86-64):
;;;   coil run tests/elf-basic-link.coil --link-flag /tmp/stogir-x64-elf-basic.o
;;;     --link-flag /tmp/stogir-x64-elf-text.o

(extern stogir.basic :as "stogir_x64_elf_basic" :cc (cc/C) [i64 i64] (-> i64))

(extern stogir.via :as "stogir_x64_elf_basic_via" :cc (cc/C) [] (-> (ptr u8)))

(extern stogir.forty-two :as "forty_two" :cc (cc/C) [] (-> i32))

(defn magnitude [(x i64)] (-> i64)
  (if (< x 0) (- 0 x) x))

(defn main [] (-> i64)
  (let [(mut failures) 0
        indirect (primitive/cast (fnptr (cc/C) [i64 i64] i64) (stogir.via))
        (mut a) -40]
    (while (<= a 40)
      (let [(mut b) -9]
        (while (<= b 9)
          (let [expected (+ (magnitude (+ a (* b 5))) 1000)]
            (when (!= (stogir.basic a (* b 5)) expected)
              (set! failures (+ failures 1)))
            (when (!= (call-ptr indirect a (* b 5)) expected)
              (set! failures (+ failures 1))))
          (set! b (+ b 1))))
      (set! a (+ a 1)))
    (when (!= (stogir.forty-two) 42) (set! failures (+ failures 1)))
    (println "linked ELF object checks: {} failures" failures)
    (if (= failures 0) 0 1)))
