(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row EXERCISE-CASES
      (set! failures
            (+ failures
               (exercise (.ty row)
                         (.op row)
                         (.preserve row)
                         (p/cast (ptr u8) (.address row))))))
    (set! failures
          (+ failures
             (contention (p/cast (ptr u8)
                                 (: (fnptr-of entry84)
                                    (fnptr (cc/C) [u64 u64 u64 u64] u64))))))
    (println "linked atomics: 112 graphs, {} failures" failures)
    (if (= failures 0) 0 1)))
