(module stogir.tests.allocation-regional)
(import "stogir.allocation" :as allocation)
(import "stogir.allocation-regional" :as regional)
(import "stogir.allocation-recolor" :as recolor)
(import "stogir.allocation-check" :as check)
(import "stogir.interval" :as range)
(import "stogir.constraints" :as constraints)
(import "stogir.frame" :as frame)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn need [T] [(r (Result T (slice u8)))] (-> T)
  (match r (Ok [value] value) (Err [message] (panic "{}" message))))

(defn partition-check [] (-> void)
  (let [a (malloc-allocator) (mut parts) (ArrayList::new [allocation/Part] a)
        (mut region) (regional/Region :anchor 1 :rank 1 :count 2 :spans (ArrayList::new [range/Range] a))]
    (range/add! (mut (.spans region)) 4 8) (range/add! (mut (.spans region)) 12 16)
    (let [(mut part) (allocation/create 1 a)]
      (set! (.register part) 0) (set! (.allowed part) 3) (set! (.spill-slot part) 24)
      (range/add! (mut (.ranges part)) 0 7) (range/add! (mut (.ranges part)) 9 20)
      (for position [(: 0 i64) 6 10 12]
        (assert (constraints/add! (mut (.uses part)) position 2 0)))
      (push! (mut parts) part))
    (allocation/reserve! (mut parts) 1 5 6 a)
    (let [(mut candidate) (regional/partition parts region a)]
      (need (check/verify (.parts candidate) 2 3))
      (for [position 0 20]
        (let [(mut count) 0]
          (for [i 0 (len (.parts candidate))]
            (let [part (get (.parts candidate) i)]
              (when (and (= (.parent part) 1) (range/covers? (.ranges part) position))
                (set! count (+ count 1))
                (assert (= (get (.mutable candidate) i) (range/covers? (.spans region) position)))
                (assert (= (.register part) 0)) (assert (= (.spill-slot part) 24)))))
          (assert (= count (if (or (< position 7) (>= position 9)) 1 0)))))
      (let [(mut uses) 0]
        (for [i 0 (len (.parts candidate))]
          (let [part (get (.parts candidate) i)]
            (when (< (.parent part) 0) (assert (not (get (.mutable candidate) i))))
            (when (= (.parent part) 1)
              (for use (.uses part)
                (set! uses (+ uses 1))
                (assert (= (get (.mutable candidate) i) (range/covers? (.spans region) (.position use))))))))
        (assert (= uses 4)))
      (regional/release-partition! (mut candidate)))
    ; Destroying the partition must not release or mutate its input's storage.
    (assert (= (len (.ranges (get parts 0))) 2))
    (assert (= (len (.uses (get parts 0))) 4))
    (regional/release-parts! (mut parts)) (free! (mut (.spans region)))))

(defn freeze-check [(move bool)] (-> void)
  (let [a (malloc-allocator) (mut parts) (ArrayList::new [allocation/Part] a)
        (mut copies) (ArrayList::new [recolor/Copy] a) (mut area) (frame/create a)]
    (for [i 0 2]
      (let [(mut part) (allocation/create 0 a)]
        (set! (.register part) (cast i32 i)) (set! (.allowed part) 3)
        (range/add! (mut (.ranges part)) (* i 4) (* (+ i 1) 4))
        (push! (mut parts) part)))
    (recolor/add-copy! (mut copies) (recolor/allocated 0) 1 0 100)
    (let [changed (need (recolor/run-scoped! (mut parts) (mut area)
                    [(allocation/SpillShape :size 8 :alignment 8)] copies 2 3 [false move] true a))]
      (assert (= changed (if move 1 0)))
      (assert (= (.register (get parts 0)) 0))
      (assert (= (.register (get parts 1)) (if move 0 1))))
    (regional/release-parts! (mut parts)) (free! (mut copies)) (frame/release! (mut area))))

(defn main [] (-> i32)
  (partition-check) (freeze-check false) (freeze-check true)
  (println "regional partition ownership, holes, uses and frozen scope: pass") 0)
