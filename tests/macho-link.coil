(module stogir.tests.macho-link)
(import "coil.cc" :as cc)

(extern stogir.object-test :as "stogir_object_test" :cc (cc/C) [i64] (-> i64))

(defn main [] (-> i64)
  (let [(mut x) -100
        (mut failures) 0]
    (while (<= x 100)
      (when (!= (stogir.object-test x) (+ x 42)) (set! failures (+ failures 1)))
      (set! x (+ x 1)))
    (println "linked AOT arithmetic checks: {} failures" failures)
    (if (= failures 0) 0 1)))
