(module stogir.tests.aot-narrow-return-link)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern ret-bool :as "stogir_ret_bool" :cc (cc/C) [u64 i32] (-> bool))

(extern ret-u8 :as "stogir_ret_u8" :cc (cc/C) [u64 i32] (-> u8))

(extern ret-u16 :as "stogir_ret_u16" :cc (cc/C) [u64 i32] (-> u16))

(extern ret-char :as "stogir_ret_char" :cc (cc/C) [u64 i32] (-> i8))

(extern ret-i8 :as "stogir_ret_i8" :cc (cc/C) [u64 i32] (-> i8))

(extern ret-i16 :as "stogir_ret_i16" :cc (cc/C) [u64 i32] (-> i16))

(defn ru8 :cc (cc/C) [(x i32)] (-> u8)
  (cast u8 x))

(defn ru16 :cc (cc/C) [(x i32)] (-> u16)
  (cast u16 x))

(defn ri8 :cc (cc/C) [(x i32)] (-> i8)
  (cast i8 x))

(defn ri16 :cc (cc/C) [(x i32)] (-> i16)
  (cast i16 x))

(defn rbool :cc (cc/C) [(x i32)] (-> bool)
  (!= (& x 1) 0))

(defn target [(ty u8)] (-> u64)
  (primitive/cast u64
                  (match ty
                    (1 (primitive/cast (ptr u8) (fnptr-of rbool)))
                    (2 (primitive/cast (ptr u8) (fnptr-of ru8)))
                    (3 (primitive/cast (ptr u8) (fnptr-of ru16)))
                    (9 (primitive/cast (ptr u8) (fnptr-of ri16)))
                    (_ (primitive/cast (ptr u8) (fnptr-of ri8))))))

(defn expected [(ty u8) (x i32)] (-> i64)
  (match ty
    (1 (if (!= (& x 1) 0) 1 0))
    (2 (cast i64 (cast u8 x)))
    (3 (cast i64 (cast u16 x)))
    (9 (cast i64 (cast i16 x)))
    (_ (cast i64 (cast i8 x)))))

(defn observe [(ty u8) (address u64) (x i32)] (-> i64)
  (match ty
    (1 (if (ret-bool address x) 1 0))
    (2 (cast i64 (ret-u8 address x)))
    (3 (cast i64 (ret-u16 address x)))
    (7 (cast i64 (ret-char address x)))
    (8 (cast i64 (ret-i8 address x)))
    (_ (cast i64 (ret-i16 address x)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for ty [(: 1 u8) 2 3 7 8 9]
      (for x [(: -2147483648 i32)
              -65537
              -65536
              -32769
              -32768
              -257
              -256
              -129
              -128
              -1
              0
              1
              127
              128
              255
              256
              257
              32767
              32768
              65535
              65536
              65537
              2147483647]
        (when (!= (observe ty (target ty) x) (expected ty x))
          (set! failures (+ failures 1)))))
    (println "linked narrow result checks: {} failures" failures)
    (if (= failures 0) 0 1)))
