(module stogir.tests.jit-mem2ssa)
(import "stogir.graph" :as g)
(import "stogir.iter-fold" :as iter)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "stogir.calls" :as calls)
(import "stogir.builder" :as b)
(import "stogir.mem2ssa" :as mem)
(import "stogir.liveness" :as live)
(import "stogir.load-forward" :as forward)
(import "stogir.node" :as n)
(import "stogir.symbols" :as symbols)
(import "stogir.types" :as types)
(import "stogir.options" :as options)
(import "stogir.sccp" :as sccp)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.a64.compile" :as compile)
(import "stogir.aot.macho" :as macho)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.fs" :as fs)

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))

(defn execute [(code image/Image)] (-> void)
  (match (jit/map-image code (malloc-allocator))
    (Err [e] (panic "{}" e))
    (Ok [loaded]
        (let [(mut loaded) loaded
              f (p/cast (fnptr (cc/C) [i64 i64] i64) (.base (.memory loaded)))]
          (for x [-100 -1 0 11 333]
            (for y [-77 -2 0 4 555]
              (assert (= (f x y) (+ (+ x 3) (* y 7))))))
          (jit/release-image! (mut loaded))))))

(defn fixture [(escape bool)
               (overlap bool)
               (volatile bool)
               (boundary bool)
               (container bool)]
  (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        sixteen (require (b/scalar-constant! (mut graph) 5 16 8))
        eight (require (b/scalar-constant! (mut graph) 5 8 8))
        three (require (b/scalar-constant! (mut graph) 11 3 8))
        seven (require (b/scalar-constant! (mut graph) 11 7 8))
        slot (require (b/stack-allocate! (mut graph) start sixteen 16))
        base (if container (require (b/emit! (mut graph) 36 5 [slot])) slot)
        first (if container (require (b/emit! (mut graph) 36 6 [base])) base)
        offset
          (require (b/emit! (mut graph) 26 (if container 5 6) [base eight]))
        hi (if container (require (b/emit! (mut graph) 36 6 [offset])) offset)
        xx (require (b/emit! (mut graph) 26 11 [x three]))
        yy (require (b/emit! (mut graph) 28 11 [y seven]))
        s0 (require (b/emit! (mut graph) 93 0 [slot first xx]))
        s1 (require (b/emit! (mut graph) 93 0 [s0 hi yy]))
        extra (if overlap (require (b/emit! (mut graph) 91 4 [s1 first])) s1)
        incoming
          (if boundary
              (let [end (require (b/emit! (mut graph) 114 0 [extra]))]
                (require (b/emit! (mut graph) 106 0 [end (: 0 i32)])))
              extra)
        loaded0
          (require (b/emit! (mut graph)
                            (if volatile 92 91)
                            (if container 5 11)
                            [incoming first]))
        l0
          (if container (require (b/emit! (mut graph) 36 11 [loaded0])) loaded0)
        l1 (require (b/emit! (mut graph) 91 11 [loaded0 hi]))
        value (require (b/emit! (mut graph) 26 11 [l0 l1]))
        result
          (if escape
              (let [same (require (b/emit! (mut graph) 14 1 [slot hi]))]
                (require (b/emit! (mut graph) 60 11 [same x value])))
              value)
        ret (require (b/emit! (mut graph) 120 11 [l1 result (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)
        (mut working) (g/duplicate graph a)]
    (push! (mut roots) ret)
    (push! (mut roots) loaded0)
    ; An unobserved overlapping read is dead; root it to exercise the actual
    ; incompatible-view guard rather than depending on missing dead-load DCE.
    (when overlap (push! (mut roots) extra))
    (match (compile/image graph start [ret] "_before" a)
      (Err [e] (panic "{}" e))
      (Ok [code]
          (let [(mut code) code] (execute code) (image/release! (mut code)))))
    (let [changes (require (mem/promote! (mut working) (mut roots) a))]
      (if (or escape overlap volatile)
          (assert (= changes 0))
          (do
            (assert (> changes 0))
            (assert (= (n/opcode (get (.instructions working) (cast i64 slot)))
                       0)))))
    (match (sccp/optimize working 8 (slice roots) a)
      (Err [e] (panic "{}" e))
      (Ok [optimized]
          (let [(mut optimized) optimized]
            (match (compile/image (.graph optimized)
                                  start
                                  (slice (.roots optimized))
                                  "_mem2ssa"
                                  a)
              (Err [e] (panic "{}" e))
              (Ok [code]
                  (let [(mut code) code]
                    (execute code)
                    (unless (or escape overlap volatile)
                      (match (macho/image-object code a)
                        (Err [e] (panic "{}" e))
                        (Ok [bytes]
                            (let [(mut bytes) bytes]
                              (match (fs/write-file a
                                                    "/tmp/coil-stogir-mem2ssa.o"
                                                    (slice bytes))
                                (Err [_] (panic "object write failed"))
                                (Ok [_] 0))
                              (free! (mut bytes))))))
                    (image/release! (mut code)))))
            (rewrite/release! (mut optimized)))))
    (for level [(: 2 i32) 3]
      (match (compile/image-with-options graph
                                         start
                                         [ret]
                                         "_public"
                                         (options/Options :level level)
                                         a)
        (Err [e] (panic "public mode: {}" e))
        (Ok [code]
            (let [(mut code) code] (execute code) (image/release! (mut code))))))
    ; Caller-owned graph remains unchanged by the explicitly owned pass fixture.
    (assert (= (n/opcode (get (.instructions graph) (cast i64 slot))) 81))
    (g/release! (mut working))
    (g/release! (mut graph))
    (free! (mut roots))))

;;; Memory and BITCAST views must agree on narrow sign bits and FP payloads.
(defn scalar-view [(stored i32) (loaded i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        bytes (types/scalar-size stored 8)
        unsigned (case bytes 1 (: 2 i32) 2 (: 3 i32) 4 (: 4 i32) 5)
        raw
          (if (= bytes 8)
              x
              (require (b/conversion! (mut graph) 35 unsigned 8 x)))
        input
          (if (= stored unsigned)
              raw
              (require (b/conversion! (mut graph) 36 stored 8 raw)))
        extent (require (b/scalar-constant! (mut graph) 5 (cast u64 bytes) 8))
        slot (require (b/stack-allocate! (mut graph) start extent 16))
        write (require (b/emit! (mut graph) 93 0 [slot slot input]))
        read (require (b/emit! (mut graph) 91 loaded [write slot]))
        bits
          (if (= loaded unsigned)
              read
              (require (b/conversion! (mut graph) 36 unsigned 8 read)))
        result
          (if (= bytes 8)
              bits
              (require (b/conversion! (mut graph) 34 5 8 bits)))
        ret (require (b/emit! (mut graph) 120 5 [read result (: 0 i32)]))
        mask
          (if (= bytes 8)
              (: 0xFFFFFFFFFFFFFFFF u64)
              (- (<< (: 1 u64) (cast u64 (* bytes 8))) 1))]
    (let [(mut forwarded) (g/duplicate graph a)
          (mut observed) (ArrayList::new [i32] a)]
      (push! (mut observed) ret)
      (assert (= (require (forward/run! (mut forwarded) (mut observed) 8 true a))
                 1))
      (require (rewrite/validate forwarded 8 a))
      (for level [(: 1 i32) 2 3 4]
        (match (compile/image-with-options (if (= level 4) forwarded graph)
                                           start
                                           [ret]
                                           "_view"
                                           (options/Options
                                             :level (if (= level 4) 1 level))
                                           a)
          (Err [e] (panic "{}" e))
          (Ok [code]
              (let [(mut code) code]
                (match (jit/map-image code a)
                  (Err [e] (panic "{}" e))
                  (Ok [loaded-code]
                      (let [(mut loaded-code) loaded-code
                            f
                              (p/cast (fnptr (cc/C) [u64] u64)
                                      (.base (.memory loaded-code)))]
                        (for value [(: 0 u64)
                                    1
                                    127
                                    128
                                    255
                                    65535
                                    0x80000000
                                    0x7FC00001
                                    0x8000000000000000
                                    0x7FF8000000001234
                                    0xFFFFFFFFFFFFFFFF]
                          (assert (= (f value) (& value mask))))
                        (jit/release-image! (mut loaded-code)))))
                (image/release! (mut code))))))
      (g/release! (mut forwarded))
      (free! (mut observed)))
    (g/release! (mut graph))))

(defn loop-fixture [(updates bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        limit (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        eight (require (b/scalar-constant! (mut graph) 5 8 8))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        slot (require (b/stack-allocate! (mut graph) start eight 16))
        initialized (require (b/emit! (mut graph) 93 0 [slot slot zero]))
        entry (require (b/emit! (mut graph) 114 0 [initialized]))
        head (require (b/loop-begin! (mut graph) entry))
        index (require (b/loop-phi! (mut graph) head zero))
        condition (require (b/emit! (mut graph) 16 1 [index limit]))
        branch (require (b/emit! (mut graph) 116 0 [head condition]))
        body (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        exit (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        previous (require (b/emit! (mut graph) 91 11 [body slot]))
        sum (require (b/emit! (mut graph) 26 11 [previous index]))
        store
          (if updates
              (require (b/emit! (mut graph) 93 0 [previous slot sum]))
              previous)
        next (require (b/emit! (mut graph) 26 11 [index one]))
        back (require (b/emit! (mut graph) 115 0 [store]))
        result (require (b/emit! (mut graph) 91 11 [exit slot]))
        ret (require (b/emit! (mut graph) 120 11 [result result (: 0 i32)]))]
    (require (b/patch! (mut graph) head 2 back))
    (require (b/patch! (mut graph) index 3 next))
    (for level [(: 1 i32) 2 3]
      (match (compile/image-with-options graph
                                         start
                                         [ret]
                                         "_flow_loop"
                                         (options/Options :level level)
                                         a)
        (Err [e] (panic "loop mode {}: {}" level e))
        (Ok [code]
            (let [(mut code) code]
              (match (jit/map-image code a)
                (Err [e] (panic "{}" e))
                (Ok [loaded]
                    (let [(mut loaded) loaded
                          f
                            (p/cast (fnptr (cc/C) [i64] i64)
                                    (.base (.memory loaded)))]
                      (for n [-10 -1 0 1 2 7 31 100]
                        (assert (= (f n)
                                   (if (and updates (> n 0))
                                       (/ (* n (- n 1)) 2)
                                       0))))
                      (jit/release-image! (mut loaded)))))
              (image/release! (mut code))))))
    (g/release! (mut graph))))

;;; One incoming edge lacks a definition. The owner and load must stay in
;;; memory; this graph is inspected but its uninitialized path is never run.
(defn uninitialized-fixture [(initialized bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        eight (require (b/scalar-constant! (mut graph) 5 8 8))
        slot (require (b/stack-allocate! (mut graph) start eight 16))
        branch (require (b/emit! (mut graph) 116 0 [slot x]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        store (require (b/emit! (mut graph) 93 0 [yes slot x]))
        end1 (require (b/emit! (mut graph) 114 0 [store]))
        seven (require (b/scalar-constant! (mut graph) 11 7 8))
        other
          (if initialized
              (require (b/emit! (mut graph) 93 0 [no slot seven]))
              no)
        end2 (require (b/emit! (mut graph) 114 0 [other]))
        merge (require (b/emit! (mut graph) 112 0 [end2 end1]))
        read (require (b/emit! (mut graph) 91 11 [merge slot]))
        ret (require (b/emit! (mut graph) 120 11 [read read (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)]
    (push! (mut roots) ret)
    (require (mem/promote! (mut graph) (mut roots) a))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 slot)))
               (if initialized (: 0 u8) (: 81 u8))))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 read)))
               (if initialized (: 68 u8) (: 91 u8))))
    (when initialized
      (match (compile/image-with-options graph
                                         start
                                         (slice roots)
                                         "_diamond"
                                         (options/Options :level 2)
                                         a)
        (Err [e] (panic "{}" e))
        (Ok [code]
            (let [(mut code) code]
              (match (jit/map-image code a)
                (Err [e] (panic "{}" e))
                (Ok [loaded]
                    (let [(mut loaded) loaded
                          f
                            (p/cast (fnptr (cc/C) [i64] i64)
                                    (.base (.memory loaded)))]
                      (for x [-100 -1 0 1 50]
                        (assert (= (f x) (if (= x 0) 7 x))))
                      (jit/release-image! (mut loaded)))))
              (image/release! (mut code))))))
    (require (rewrite/validate graph 8 a))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; A long incoming-definition walk uses heap work frames, not the host stack.
(defn deep-chain [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        bytes (require (b/scalar-constant! (mut graph) 5 8 8))
        slot (require (b/stack-allocate! (mut graph) start bytes 16))
        (mut control) (require (b/emit! (mut graph) 93 0 [slot slot x]))
        (mut roots) (ArrayList::new [i32] a)]
    (for [i 0 2048]
      (let [end (require (b/emit! (mut graph) 114 0 [control]))]
        (set! control (require (b/emit! (mut graph) 106 0 [end (: 0 i32)])))))
    (let [read (require (b/emit! (mut graph) 91 11 [control slot]))
          ret (require (b/emit! (mut graph) 120 11 [read read (: 0 i32)]))]
      (push! (mut roots) ret)
      (require (mem/promote! (mut graph) (mut roots) a))
      (assert (= (n/opcode (get (.instructions graph) (cast i64 slot))) 0))
      (assert (= (n/opcode (get (.instructions graph) (cast i64 read))) 68))
      (require (rewrite/validate graph 8 a)))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; Mixed-width extraction must agree with actual machine memory semantics,
;;; including signed high bytes and disjoint later stores. Opaque parameters
;;; prevent constant folding from hiding an incorrect extraction.
(defn forward-fixture [(type u8) (offset i64) (blocked i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        bytes (require (b/scalar-constant! (mut graph) 5 16 8))
        displacement
          (require (b/scalar-constant! (mut graph) 5 (cast u64 offset) 8))
        eight (require (b/scalar-constant! (mut graph) 11 8 8))
        slot (require (b/stack-allocate! (mut graph) start bytes 16))
        high (require (b/emit! (mut graph) 26 6 [slot eight]))
        bits (require (b/conversion! (mut graph) 36 5 8 slot))
        shifted (require (b/emit! (mut graph) 26 5 [bits displacement]))
        pointer (require (b/conversion! (mut graph) 36 6 8 shifted))
        store (require (b/emit! (mut graph) 93 0 [slot slot x]))
        later (require (b/emit! (mut graph) 93 0 [store high x]))
        incoming
          (case blocked
            1 (require (b/emit! (mut graph) 92 5 [later slot]))
            2
              (let [byte (require (b/scalar-constant! (mut graph) 2 255 8))]
                (require (b/emit! (mut graph) 93 0 [later pointer byte])))
            3
              (let [unknown
                      (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))]
                (require (b/emit! (mut graph) 93 0 [later unknown x])))
            4
              (let [end (require (b/emit! (mut graph) 114 0 [later]))]
                (require (b/emit! (mut graph) 106 0 [end (: 0 i32)])))
            later)
        read
          (require (b/emit! (mut graph) 91 (cast i32 type) [incoming pointer]))
        extended
          (if (= type 5)
              read
              (require (b/emit! (mut graph)
                                (if (types/signed? (cast i32 type)) 33 34)
                                5
                                [read])))
        ret (require (b/emit! (mut graph) 120 5 [read extended (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)
        (mut working) (g/duplicate graph a)]
    (push! (mut roots) ret)
    (push! (mut roots) read)
    (assert (= (require (forward/run! (mut working) (mut roots) 8 false a)) 0))
    (assert (= (require (forward/run! (mut working) (mut roots) 8 true a))
               (if (= blocked 0) 1 0)))
    (require (rewrite/validate working 8 a))
    (when (!= blocked 3)
      (match (compile/image graph start [ret] "_memory_before" a)
        (Err [e] (panic "{}" e))
        (Ok [before]
            (let [(mut before) before]
              (match (compile/image working
                                    start
                                    (slice roots)
                                    "_memory_after"
                                    a)
                (Err [e] (panic "{}" e))
                (Ok [after]
                    (let [(mut after) after]
                      (match (jit/map-image before a)
                        (Err [e] (panic "{}" e))
                        (Ok [first]
                            (let [(mut first) first]
                              (match (jit/map-image after a)
                                (Err [e] (panic "{}" e))
                                (Ok [second]
                                    (let [(mut second) second
                                          f
                                            (p/cast (fnptr (cc/C) [u64] u64)
                                                    (.base (.memory first)))
                                          g
                                            (p/cast (fnptr (cc/C) [u64] u64)
                                                    (.base (.memory second)))]
                                      (for bits [(: 0 u64)
                                                 1
                                                 9223372036854775808
                                                 18446744073709551615
                                                 18364758544493064720
                                                 81985529216486895]
                                        (assert (= (f bits) (g bits))))
                                      (jit/release-image! (mut second)))))
                              (jit/release-image! (mut first)))))
                      (image/release! (mut after)))))
              (image/release! (mut before))))))
    (g/release! (mut working))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; Splitting a rooted LOAD's value/control must retain preceding external
;;; effects even when the caller observes the loaded value without a RETURN.
(defn rooted-effects [(forwarded bool) (view bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        external (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        bytes (require (b/scalar-constant! (mut graph) 5 8 8))
        value (require (b/scalar-constant! (mut graph) 5 73 8))
        slot (require (b/stack-allocate! (mut graph) start bytes 16))
        effect (require (b/emit! (mut graph) 93 0 [slot external value]))
        write (require (b/emit! (mut graph) 93 0 [effect slot value]))
        read (require (b/emit! (mut graph) 91 (if view 12 5) [write slot]))
        (mut roots) (ArrayList::new [i32] a)
        (mut before) (live/mark graph [read] a)]
    (assert (get before (cast i64 effect)))
    (free! (mut before))
    (push! (mut roots) read)
    (if forwarded
        (require (forward/run! (mut graph) (mut roots) 8 true a))
        (require (mem/promote! (mut graph) (mut roots) a)))
    (let [(mut after) (live/mark graph (slice roots) a)]
      (assert (get after (cast i64 effect)))
      (free! (mut after)))
    (assert (= (get roots 0) read))
    ; The production ordering forwards before promotion, then runs SCCP.
    (require (mem/promote! (mut graph) (mut roots) a))
    (require (rewrite/validate graph 8 a))
    (match (sccp/optimize graph 8 (slice roots) a)
      (Err [e] (panic "{}" e))
      (Ok [result]
          (let [(mut result) result
                (mut marked)
                  (live/mark (.graph result) (slice (.roots result)) a)]
            (assert (get marked (cast i64 effect)))
            (assert (= (n/opcode (get (.instructions (.graph result))
                                      (cast i64 effect)))
                       93))
            (free! (mut marked))
            (rewrite/release! (mut result)))))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; Resolve the symbolic displacement to eight, deliberately different from
;;; its string-table ID. This catches using metadata as a numeric byte offset.
(defn symbolic-offset-execute [(code image/Image) (expected u64)] (-> void)
  (let [a (malloc-allocator)
        (mut values) (ArrayList::new [u64] a)
        (mut found) (ArrayList::new [bool] a)]
    (for symbol (.symbols code)
      (let [external (image/same-name? code symbol "_offset")]
        (push! (mut values) (if external (: 8 u64) 0))
        (push! (mut found) external)))
    (match (jit/map-image-resolved code (slice values) (slice found) a)
      (Err [e] (panic "{}" e))
      (Ok [loaded]
          (let [(mut loaded) loaded
                f
                  (p/cast (fnptr (cc/C) [(ptr u8)] u64)
                          (.base (.memory loaded)))
                (mut storage) [(: 0x0807060504030201 u64) 0x100F0E0D0C0B0A09]
                actual (f (p/cast (ptr u8) (mut storage)))]
            (unless (= actual expected)
              (panic "symbolic offset: expected {}, got {}" expected actual))
            (jit/release-image! (mut loaded)))))
    (free! (mut values))
    (free! (mut found))))

(defn symbolic-offset [(kind i32) (commuted bool) (write bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        base (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        named
          (require (case kind
                     73 (symbols/function-address! (mut graph) 8 0)
                     74 (symbols/function! (mut graph) "_offset" 0)
                     75 (symbols/symbol! (mut graph) "_offset")
                     (symbols/string! (mut graph) "_offset")))
        payload
          (match (g/lookup graph named)
            (None [] (panic "offset constant missing"))
            (Some [value] (n/constant-bits value)))
        number (require (b/scalar-constant! (mut graph) 6 payload 8))
        first (require (b/emit! (mut graph) 26 6 [base number]))
        second
          (require (b/emit! (mut graph)
                            26
                            6
                            (if commuted [named base] [base named])))
        before (require (b/emit! (mut graph) 91 2 [start first]))
        byte (require (b/scalar-constant! (mut graph) 2 147 8))
        incoming
          (if write
              (require (b/emit! (mut graph) 93 0 [before second byte]))
              before)
        read
          (require (b/emit! (mut graph) 91 2 [incoming (if write first second)]))
        a-value (require (b/emit! (mut graph) 34 5 [before]))
        b-value (require (b/emit! (mut graph) 34 5 [read]))
        answer (require (b/emit! (mut graph) 48 5 [a-value b-value]))
        ret (require (b/emit! (mut graph) 120 5 [read answer (: 0 i32)]))
        expected
          (if (= kind 73)
              (if write (: 154 u64) 0)
              (if write (: 0 u64) 11))
        (mut working) (g/duplicate graph a)
        (mut roots) (ArrayList::new [i32] a)]
    (push! (mut roots) ret)
    (require (rewrite/validate graph 8 a))
    (when (!= kind 77)
      (match (compile/image graph start [ret] "_symbolic_before" a)
        (Err [e] (panic "{}" e))
        (Ok [code]
            (let [(mut code) code]
              (symbolic-offset-execute code expected)
              (image/release! (mut code))))))
    (let [changes (require (forward/run! (mut working) (mut roots) 8 true a))]
      ; Native checking precedes the structural assertion so the old bug
      ; demonstrates wrong machine-code results, not just a missed guard.
      (when (!= kind 77)
        (match (compile/image working start (slice roots) "_symbolic_after" a)
          (Err [e] (panic "{}" e))
          (Ok [code]
              (let [(mut code) code]
                (symbolic-offset-execute code expected)
                (image/release! (mut code))))))
      (assert (= changes (if (= kind 73) 1 0))))
    (when (!= kind 73)
      (assert (= (.base (forward/address graph second)) second))
      (assert (= (.value (forward/find graph read 8)) 0)))
    (g/release! (mut working))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; Keep an opaque memory-writing call in the native barrier cases.
(defn late-opaque-write :cc (cc/C) [(pointer (ptr u8)) (value u64)] (-> void)
  (store! (p/cast (ptr u64) pointer) value))

(defn late-check-uses [(graph g/Graph) (actual uses/Uses)] (-> void)
  (let [(mut expected) (uses/build graph (malloc-allocator))]
    (for [r 0 (len (.ranges expected))]
      (let [a (get (.ranges actual) r)
            b (get (.ranges expected) r)]
        (assert (= (.count a) (.count b)))
        (for [i (.offset b) (+ (.offset b) (.count b))]
          (let [edge (get (.edges expected) i)
                (mut count) 0]
            (for [j (.offset a) (+ (.offset a) (.count a))]
              (let [other (get (.edges actual) j)]
                (when (and (= (.user edge) (.user other))
                           (= (.operand edge) (.operand other)))
                  (set! count (+ count 1)))))
            (assert (= count 1))))))
    (uses/release! (mut expected))))

(defn late-native [(before g/Graph)
                   (after g/Graph)
                   (ret i32)
                   (roots (slice i32))
                   (stored i32)] (-> void)
  (let [a (malloc-allocator)
        (mut first)
          (match (compile/image before 1 [ret] "_late_before" a)
            (Err [e] (panic "{}" e))
            (Ok [code] code))
        (mut second)
          (match (compile/image after 1 roots "_late_after" a)
            (Err [e] (panic "{}" e))
            (Ok [code] code))]
    (match (jit/map-image first a)
      (Err [e] (panic "{}" e))
      (Ok [one]
          (let [(mut one) one]
            (match (jit/map-image second a)
              (Err [e] (panic "{}" e))
              (Ok [two]
                  (let [(mut two) two
                        f
                          (p/cast (fnptr (cc/C) [(ptr u8) (ptr u8) u64] u64)
                                  (.base (.memory one)))
                        g
                          (p/cast (fnptr (cc/C) [(ptr u8) (ptr u8) u64] u64)
                                  (.base (.memory two)))]
                    (for value [(: 0 u64)
                                1
                                127
                                128
                                255
                                0x7FFFFFFF
                                0x80000000
                                0xFFFFFFFF
                                0x7FFFFFFFFFFFFFFF
                                0x8000000000000000
                                0x7FF8000000000042
                                0x7FF0000000000001
                                0x7FC00042
                                0xFFFFFFFFFFFFFFFF]
                      (for alias [false true]
                        (let [initial (if (= stored 1) (& value 1) value)
                              written (^ value 0xABCDEF1234567890)
                              (mut left) [initial (: 0x123456789ABCDEF0 u64)]
                              (mut right) [initial (: 0x123456789ABCDEF0 u64)]
                              lp (p/cast (ptr u8) (mut left))
                              rp (p/cast (ptr u8) (mut right))
                              a1 (f lp (p/index lp (if alias 0 8)) written)
                              a2 (g rp (p/index rp (if alias 0 8)) written)]
                          (assert (= a1 a2))
                          (assert (= (get left 0) (get right 0)))
                          (assert (= (get left 1) (get right 1))))))
                    (jit/release-image! (mut two)))))
            (jit/release-image! (mut one)))))
    (image/release! (mut second))
    (image/release! (mut first))))

;;; Exercise the late worklist directly: early forwarding/promotion never runs.
;;; Unknown stores/calls, volatility, block boundaries and partial views remain
;;; barriers. Known stores and proven disjoint writes retain exact effects.
(defn late-forward [(stored i32) (loaded i32) (barrier i32) (observation i32)]
  (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        pointer (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        unknown (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 2]))
        bytes (types/scalar-size stored 8)
        unsigned (case bytes 1 (: 2 i32) 2 (: 3 i32) 4 (: 4 i32) (: 5 i32))
        raw
          (if (= bytes 8)
              x
              (require (b/conversion! (mut graph) 35 unsigned 8 x)))
        input
          (if (= stored 1)
              (require (b/conversion! (mut graph) 35 1 8 x))
              (if (= stored unsigned)
                  raw
                  (require (b/conversion! (mut graph) 36 stored 8 raw))))
        first (require (b/emit! (mut graph) 91 stored [start pointer]))
        eight (require (b/scalar-constant! (mut graph) 5 8 8))
        high (require (b/emit! (mut graph) 26 6 [pointer eight]))
        (mut branch) (: 0 i32)
        incoming
          (case barrier
            1 (require (b/emit! (mut graph) 93 0 [first pointer input]))
            2 (require (b/emit! (mut graph) 93 0 [first unknown input]))
            3 (require (b/emit! (mut graph) 92 stored [first unknown]))
            4
              (let [end (require (b/emit! (mut graph) 114 0 [first]))]
                (require (b/emit! (mut graph) 106 0 [end (: 0 i32)])))
            5
              (let [truth (require (b/scalar-constant! (mut graph) 1 1 8))
                    split (require (b/emit! (mut graph) 116 0 [first truth]))
                    yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
                    no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
                    a-end (require (b/emit! (mut graph) 114 0 [yes]))
                    b-end (require (b/emit! (mut graph) 114 0 [no]))]
                (set! branch split)
                (require (b/emit! (mut graph) 112 0 [a-end b-end])))
            6
              (let [byte (require (b/conversion! (mut graph) 35 2 8 x))]
                (require (b/emit! (mut graph) 93 0 [first pointer byte])))
            7
              (let [target
                      (require (b/scalar-constant! (mut graph)
                                                   6
                                                   (p/cast u64
                                                           (p/cast (ptr u8)
                                                                   (fnptr-of late-opaque-write)))
                                                   8))]
                (match (calls/create 0 0 [(: 6 u8) 5] a)
                  (Err [e] (panic "{}" e))
                  (Ok [proto]
                      (let [(mut proto) proto
                            call
                              (require (calls/emit! (mut graph)
                                                    proto
                                                    first
                                                    target
                                                    [unknown x]
                                                    a))]
                        (calls/release! (mut proto))
                        call))))
            8 (require (b/emit! (mut graph) 93 0 [first high input]))
            first)
        read (require (b/emit! (mut graph) 91 loaded [incoming pointer]))
        result-bytes (types/scalar-size loaded 8)
        result-type
          (case result-bytes 1 (: 2 i32) 2 (: 3 i32) 4 (: 4 i32) (: 5 i32))
        viewed
          (if (= loaded result-type)
              read
              (require (b/conversion! (mut graph) 36 result-type 8 read)))
        result
          (if (= result-bytes 8)
              viewed
              (require (b/conversion! (mut graph) 34 5 8 viewed)))
        first-view
          (if (= stored unsigned)
              first
              (require (b/conversion! (mut graph) 36 unsigned 8 first)))
        first-bits
          (if (= bytes 8)
              first-view
              (require (b/conversion! (mut graph) 34 5 8 first-view)))
        combined (require (b/emit! (mut graph) 48 5 [first-bits result]))
        ret (require (b/emit! (mut graph) 120 5 [read combined (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)
        (mut seeds) (ArrayList::new [i32] a)
        expected
          (if (= barrier 6)
              (and (= result-bytes 1)
                   (forward/convertible? 2 (cast u8 loaded) 0 8))
              (and (or (= barrier 0) (= barrier 1) (= barrier 5) (= barrier 8))
                   (= bytes result-bytes)
                   (forward/convertible? (cast u8 stored) (cast u8 loaded) 0 8)))]
    (unless (= observation 4) (push! (mut roots) ret))
    (when (or (= observation 1) (= observation 3) (= observation 4))
      (push! (mut roots) read)
      (push! (mut roots) read))
    (when (or (= observation 2) (= observation 3)) (push! (mut roots) first))
    (push! (mut seeds) read)
    (when (> branch 0) (push! (mut seeds) branch))
    (when (= barrier 5) (assert (= (.value (forward/find graph read 8)) 0)))
    (match (iter/optimize graph 8 (slice roots) (slice seeds) a)
      (Err [e]
           (panic "late memory {} {} {} {}: {}"
                  stored
                  loaded
                  barrier
                  observation
                  e))
      (Ok [optimized]
          (let [(mut optimized) optimized
                after (.graph optimized)]
            (let [actual (n/opcode (get (.instructions after) (cast i64 read)))]
              (unless (= (!= actual 91) expected)
                (panic "late result stored={} loaded={} barrier={} observation={} expected={} opcode={}"
                       stored
                       loaded
                       barrier
                       observation
                       expected
                       actual)))
            (when (or (= observation 2) (= observation 3))
              (assert (= (n/opcode (get (.instructions after) (cast i64 first)))
                         91)))
            (when (or (= observation 1) (= observation 3) (= observation 4))
              (assert (= (n/type-id (get (.instructions after) (cast i64 read)))
                         (cast u8 loaded))))
            (when (or (= barrier 1) (= barrier 2) (= barrier 7) (= barrier 8))
              (let [(mut marked) (live/mark after (slice (.roots optimized)) a)]
                (assert (get marked (cast i64 incoming)))
                (free! (mut marked))))
            (unless (= observation 4)
              (late-native graph after ret (slice (.roots optimized)) stored))
            (rewrite/release! (mut optimized)))))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 read))) 91))
    (let [(mut working) (g/duplicate graph a)
          (mut observed) (ArrayList::new [i32] a)
          (mut edges) (uses/build working a)
          (mut queue) (q/create (len (.instructions working)) a)
          (mut protected) (bits/create (len (.instructions working)) a)]
      (for root roots
        (push! (mut observed) root)
        (bits/add! (mut protected) (cast i64 root)))
      (for seed seeds (q/add! (mut queue) (cast i64 seed)))
      (require (iter/run-rooted! (mut working)
                                 (mut observed)
                                 (mut edges)
                                 (mut queue)
                                 (mut protected)
                                 8
                                 a))
      (late-check-uses working edges)
      (require (rewrite/validate working 8 a))
      (let [count (len observed)]
        (q/add! (mut queue) (cast i64 read))
        (assert (= (require (iter/run-rooted! (mut working)
                                              (mut observed)
                                              (mut edges)
                                              (mut queue)
                                              (mut protected)
                                              8
                                              a))
                   0))
        (assert (= (len observed) count)))
      (bits/release! (mut protected))
      (q/release! (mut queue))
      (uses/release! (mut edges))
      (free! (mut observed))
      (g/release! (mut working)))
    (free! (mut seeds))
    (free! (mut roots))
    (g/release! (mut graph))))

;;; A RETURN can consume the same LOAD as both control and data. Rootless
;;; compatibility calls cannot extend observations and leave a protected load.
(defn late-direct-return [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        pointer (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        unused (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        value (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 2]))
        store (require (b/emit! (mut graph) 93 0 [start pointer value]))
        read (require (b/emit! (mut graph) 91 5 [store pointer]))
        ret (require (b/emit! (mut graph) 120 5 [read read (: 0 i32)]))
        (mut working) (g/duplicate graph a)
        (mut roots) (ArrayList::new [i32] a)
        (mut edges) (uses/build working a)
        (mut queue) (q/create (len (.instructions working)) a)
        (mut protected) (bits/create (len (.instructions working)) a)]
    (push! (mut roots) ret)
    (push! (mut roots) read)
    (for root roots (bits/add! (mut protected) (cast i64 root)))
    (q/add! (mut queue) (cast i64 read))
    (assert (= (require (iter/run! (mut working)
                                   (mut edges)
                                   (mut queue)
                                   protected
                                   8
                                   a))
               0))
    (assert (= (n/opcode (get (.instructions working) (cast i64 read))) 91))
    (q/add! (mut queue) (cast i64 read))
    (assert (> (require (iter/run-rooted! (mut working)
                                          (mut roots)
                                          (mut edges)
                                          (mut queue)
                                          (mut protected)
                                          8
                                          a))
               0))
    (assert (= (.op1 (get (.instructions working) (cast i64 ret))) store))
    (assert (= (.op2 (get (.instructions working) (cast i64 ret))) value))
    (assert (= (n/opcode (get (.instructions working) (cast i64 read))) 68))
    (late-check-uses working edges)
    (require (rewrite/validate working 8 a))
    (late-native graph working ret (slice roots) 5)
    (bits/release! (mut protected))
    (q/release! (mut queue))
    (uses/release! (mut edges))
    (free! (mut roots))
    (g/release! (mut working))
    (g/release! (mut graph))))

;;; Explicitly seed a dead load as well as its late-constant branch. Memory
;;; folding must not erase the control dependency before observation checking.
(defn late-unreachable-observation [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        pointer (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        truth (require (b/scalar-constant! (mut graph) 1 1 8))
        value (require (b/scalar-constant! (mut graph) 5 42 8))
        branch (require (b/emit! (mut graph) 116 0 [start truth]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        store (require (b/emit! (mut graph) 93 0 [no pointer value]))
        read (require (b/emit! (mut graph) 91 5 [store pointer]))
        observed (require (b/emit! (mut graph) 68 5 [read (: 0 i32)]))
        dead-end (require (b/emit! (mut graph) 114 0 [read]))
        ret (require (b/emit! (mut graph) 120 5 [yes value (: 0 i32)]))]
    (match (iter/optimize graph 8 [ret observed dead-end] [branch read] a)
      (Err [message]
           (assert (= message "observable iterative data root is unreachable")))
      (Ok [output]
          (let [(mut output) output]
            (rewrite/release! (mut output))
            (panic "late memory erased an unreachable data observation"))))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 branch))) 116))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 read))) 91))
    (g/release! (mut graph))))

; Only original entry-prefix objects may cross opaque stack scopes. Exercise
; inner objects, copied/observed saved pointers, and explicit frees as fallbacks.
(defn scoped-entry [(mode i32)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        size (require (b/scalar-constant! (mut graph) 5 8 8))
        three (require (b/scalar-constant! (mut graph) 11 3 8))
        seven (require (b/scalar-constant! (mut graph) 11 7 8))
        early (if (= mode 1) (require (b/emit! (mut graph) 83 6 [start])) start)
        slot (require (b/stack-allocate! (mut graph) early size 16))
        xx (require (b/emit! (mut graph) 26 11 [x three]))
        yy (require (b/emit! (mut graph) 28 11 [y seven]))
        sum (require (b/emit! (mut graph) 26 11 [xx yy]))
        stored (require (b/emit! (mut graph) 93 0 [slot slot sum]))
        saved (if (= mode 1) early (require (b/emit! (mut graph) 83 6 [stored])))
        inner (require (b/stack-allocate! (mut graph) (if (= mode 1) stored saved) size 16))
        prior (if (= mode 4) (require (b/stack-free! (mut graph) inner size)) inner)
        restore (if (= mode 2) (require (b/emit! (mut graph) 68 6 [saved (: 0 i32)])) saved)
        ; Read inner storage before restoration, and outer storage after it.
        loaded (require (b/emit! (mut graph) 91 11 [prior slot]))
        ended (require (b/emit! (mut graph) 84 0 [loaded restore]))
        value (if (= mode 1) loaded (require (b/emit! (mut graph) 91 11 [ended slot])))
        ret (require (b/emit! (mut graph) 120 11 [(if (= mode 1) ended value) value (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)
        (mut working) (g/duplicate graph a)]
    (push! (mut roots) ret)
    (when (= mode 3) (push! (mut roots) saved))
    (for before [true false]
      (unless before
        (require (mem/promote! (mut working) (mut roots) a))
        (assert (= (n/opcode (get (.instructions working) (cast i64 slot)))
                   (if (= mode 0) (: 0 u8) 81))))
      (match (compile/image (if before graph working) start (slice roots) "_scoped" a)
        (Err [e] (panic "{}" e))
        (Ok [code]
            (let [(mut code) code] (execute code) (image/release! (mut code))))))
    (for level [(: 2 i32) 3]
      (match (compile/image-with-options graph start [ret] "_scoped_public"
                                         (options/Options :level level) a)
        (Err [e] (panic "{}" e))
        (Ok [code]
            (let [(mut code) code] (execute code) (image/release! (mut code))))))
    (free! (mut roots))
    (g/release! (mut working))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (for mode [(: 0 i32) 1 2 3 4] (scoped-entry mode))
  (for kind [(: 73 i32) 74 75 77]
    (for commuted [false true]
      (for write [false true] (symbolic-offset kind commuted write))))
  (late-unreachable-observation)
  (late-direct-return)
  (for spec [[(: 2 i32) 2]
             [2 7]
             [2 8]
             [7 2]
             [7 7]
             [7 8]
             [8 2]
             [8 7]
             [8 8]
             [3 3]
             [3 9]
             [9 3]
             [9 9]
             [4 4]
             [4 10]
             [4 13]
             [10 4]
             [10 10]
             [10 13]
             [13 4]
             [13 10]
             [13 13]
             [5 5]
             [5 6]
             [5 11]
             [5 12]
             [6 5]
             [6 6]
             [6 11]
             [6 12]
             [11 5]
             [11 6]
             [11 11]
             [11 12]
             [12 5]
             [12 6]
             [12 11]
             [12 12]
             [1 1]
             [1 2]
             [2 1]
             [5 2]
             [5 4]
             [4 2]
             [2 5]
             [13 2]
             [6 4]]
    (for barrier [(: 0 i32) 1 2 3 4 5 6 7 8]
      (for observation [(: 0 i32) 1 2 3 4]
        (late-forward (get spec 0) (get spec 1) barrier observation))))
  (rooted-effects false false)
  (rooted-effects false true)
  (rooted-effects true false)
  (rooted-effects true true)
  (for type [(: 2 u8) 8 3 9 4 10 5]
    (let [width (cast i64 (types/size (cast i32 type) 8))]
      (for [offset 0 (+ (- 8 width) 1)]
        (forward-fixture type offset 0))))
  (for barrier [(: 1 i32) 2 3 4] (forward-fixture 10 4 barrier))
  (deep-chain)
  (loop-fixture false)
  (loop-fixture true)
  (uninitialized-fixture false)
  (uninitialized-fixture true)
  (fixture false false false false false)
  (fixture false false false false true)
  (fixture true false false false true)
  (fixture false true false false true)
  (fixture false false true false true)
  (fixture false false false true true)
  (for stored [(: 2 i32) 7 8]
    (for loaded [(: 2 i32) 7 8] (scalar-view stored loaded)))
  (for stored [(: 3 i32) 9]
    (for loaded [(: 3 i32) 9] (scalar-view stored loaded)))
  (for stored [(: 4 i32) 10 13]
    (for loaded [(: 4 i32) 10 13] (scalar-view stored loaded)))
  (for stored [(: 5 i32) 6 11 12]
    (for loaded [(: 5 i32) 6 11 12] (scalar-view stored loaded)))
  (println "mem2ssa: 2115 late-forward cases, observation ordering, 1254 scalar-view answers and existing partition/barrier checks pass")
  0)
