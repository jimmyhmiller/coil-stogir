(module stogir.tests.aot-bulk-link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern copy-dynamic
        :as
        "stogir_bulk_copy_dynamic"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64]
        (-> void))

(extern move-dynamic
        :as
        "stogir_bulk_move_dynamic"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64]
        (-> void))

(extern zero-dynamic
        :as
        "stogir_bulk_zero_dynamic"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64]
        (-> void))

(extern copy17
        :as
        "stogir_bulk_copy_17"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64]
        (-> void))

(extern move63
        :as
        "stogir_bulk_move_63"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64]
        (-> void))

(extern move65
        :as
        "stogir_bulk_move_65"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64]
        (-> void))

(extern zero9
        :as
        "stogir_bulk_zero_9"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64]
        (-> void))

;;; C ABI probe overwrites every allocatable GPR and both emitter scratches.
(defn probe :cc (cc/C) [] (-> u64)
  (primitive/machine-code (Aarch64)
                          0xe0
                          0x00
                          0x80
                          0xd2
                          0x21
                          0x20
                          0x80
                          0xd2
                          0x42
                          0x20
                          0x80
                          0xd2
                          0x63
                          0x20
                          0x80
                          0xd2
                          0x84
                          0x20
                          0x80
                          0xd2
                          0xa5
                          0x20
                          0x80
                          0xd2
                          0xc6
                          0x20
                          0x80
                          0xd2
                          0xe7
                          0x20
                          0x80
                          0xd2
                          0x08
                          0x21
                          0x80
                          0xd2
                          0x29
                          0x21
                          0x80
                          0xd2
                          0x4a
                          0x21
                          0x80
                          0xd2
                          0x6b
                          0x21
                          0x80
                          0xd2
                          0x8c
                          0x21
                          0x80
                          0xd2
                          0xad
                          0x21
                          0x80
                          0xd2
                          0xce
                          0x21
                          0x80
                          0xd2
                          0xef
                          0x21
                          0x80
                          0xd2
                          0x10
                          0x22
                          0x80
                          0xd2
                          0x31
                          0x22
                          0x80
                          0xd2
                          0xc0
                          0x03
                          0x5f
                          0xd6))

(extern pressure-forward
        :as
        "stogir_bulk_pressure_forward"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) (ptr u64) u64 u64]
        (-> u64))

(extern pressure-backward
        :as
        "stogir_bulk_pressure_backward"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) (ptr u64) u64 u64]
        (-> u64))

(defn pressure [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut input) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut numbers) (ArrayList::new [u64] allocator)
        target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of probe)))
        (mut failures) 0
        (mut i) (: 0 i64)]
    (while (< i 200)
      (push! (mut input) (cast u8 (+ i 19)))
      (push! (mut output) 0)
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i 40)
      (push! (mut numbers) (cast u64 (+ i 11)))
      (set! i (+ i 1)))
    (for backward? [false true]
      (let [f
              (if backward?
                  (fnptr-of pressure-backward)
                  (fnptr-of pressure-forward))]
        (for size [(: 0 i64) 1 7 8 9 17 63 64 65 127 129]
          (set! i 0)
          (while (< i 200)
            (primitive/store! (primitive/index (.data output) i) (: 251 u8))
            (set! i (+ i 1)))
          (when (!= (call-ptr f
                              (primitive/index (.data output) 3)
                              (.data input)
                              (.data numbers)
                              target
                              (cast u64 size))
                    1555)
            (set! failures (+ failures 1)))
          (set! i 0)
          (while (< i 200)
            (when (!= (get output i)
                      (if (and (>= i 3) (< i (+ size 3)))
                          (get input (- i 3))
                          251))
              (set! failures (+ failures 1)))
            (set! i (+ i 1))))))
    (free! (mut input))
    (free! (mut output))
    (free! (mut numbers))
    failures))

(defn check [(f (fnptr (cc/C) [(ptr u8) (ptr u8) u64] void))
             (mode i32)
             (fixed i64)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut actual) (ArrayList::new [u8] allocator)
        (mut expected) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) (: 0 i64)]
    (while (< i 132000)
      (push! (mut actual) 0)
      (push! (mut expected) 0)
      (set! i (+ i 1)))
    (for size [(: 0 i64) 1 7 8 9 17 31 32 33 63 64 65 127 129 257 4097 65537]
      (when (or (< fixed 0) (= fixed size))
        (for delta [(: -17 i64) -8 -1 0 1 7 17 66000]
          (let [source (: 64 i64)
                destination (if (= mode 0) (+ source 66000) (+ source delta))]
            (set! i 0)
            (while (< i 132000)
              (let [v (cast u8 (% (+ (* i 37) 19) 251))]
                (primitive/store! (primitive/index (.data actual) i) v)
                (primitive/store! (primitive/index (.data expected) i) v))
              (set! i (+ i 1)))
            (set! i 0)
            (while (< i size)
              (primitive/store! (primitive/index (.data expected)
                                                 (+ destination i))
                                (if (= mode 2) 0 (get actual (+ source i))))
              (set! i (+ i 1)))
            (call-ptr f
                      (primitive/index (.data actual) destination)
                      (primitive/index (.data actual) source)
                      (cast u64 size))
            (set! i 0)
            (while (< i 132000)
              (when (!= (get actual i) (get expected i))
                (set! failures (+ failures 1)))
              (set! i (+ i 1)))))))
    (free! (mut actual))
    (free! (mut expected))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (pressure)
             (check (fnptr-of copy-dynamic) 0 -1)
             (check (fnptr-of move-dynamic) 1 -1)
             (check (fnptr-of zero-dynamic) 2 -1)
             (check (fnptr-of copy17) 0 17)
             (check (fnptr-of move63) 1 63)
             (check (fnptr-of move65) 1 65)
             (check (fnptr-of zero9) 2 9))]
    (println "linked bulk memory byte comparisons: {} failures" failures)
    (if (= failures 0) 0 1)))
