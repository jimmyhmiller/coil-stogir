(module stogir.tests.aot-image-link)
(import "coil.cc" :as cc)

(extern entry :as "stogir_image_entry" :cc (cc/C) [i64] (-> i64))

(extern via-pointer :as "stogir_image_via_pointer" :cc (cc/C) [] (-> i64))

(extern via-negative :as "stogir_image_via_negative" :cc (cc/C) [] (-> i64))

(extern via-add :as "stogir_image_page_add" :cc (cc/C) [] (-> i64))

(extern branch-addend :as "stogir_image_branch_addend" :cc (cc/C) [] (-> i64))

(defn main [] (-> i64)
  (let [(mut x) (: -100 i64)
        (mut failures) 0]
    (while (<= x 100)
      (when (!= (entry x) (+ (if (< x 0) (- 0 x) x) 202))
        (set! failures (+ failures 1)))
      (set! x (+ x 1)))
    (when (!= (via-pointer) 100) (set! failures (+ failures 1)))
    (when (!= (via-negative) 100) (set! failures (+ failures 1)))
    (when (!= (via-add) 100) (set! failures (+ failures 1)))
    (when (!= (branch-addend) 37) (set! failures (+ failures 1)))
    (println "linked shared-image checks: {} failures" failures)
    (if (= failures 0) 0 1)))
