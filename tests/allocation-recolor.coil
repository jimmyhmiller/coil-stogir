(module stogir.tests.allocation-recolor)
(import "stogir.allocation" :as a)
(import "stogir.allocation-recolor" :as rc)
(import "stogir.allocation-check" :as check)
(import "stogir.interval" :as r)
(import "stogir.constraints" :as c)
(import "stogir.frame" :as f)
(import "stogir.locations" :as loc)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])
(defn need [T] [(value (Result T (slice u8)))] (-> T)
  (match value (Ok [v] v) (Err [message] (panic "{}" message))))

;;; A's second child wants its incoming color. B occupies it and must move in
;;; the same transaction. Modes cover fixed clobbers, a lifetime hole, a new
;;; 16-byte spill home, and the SIMD bank (physical IDs 32/33).
(defn case! [(mode i32)] (-> void)
  (let [allocator (malloc-allocator) base (if (= mode 4) (: 32 i32) 0)
        allowed (| (rc/mask base) (rc/mask (+ base 1)))
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut shapes) (ArrayList::new [a/SpillShape] allocator)
        (mut copies) (ArrayList::new [rc/Copy] allocator)
        (mut plan) (ArrayList::new [rc/Change] allocator)
        (mut layout) (f/create allocator)]
    (push! (mut shapes) (a/SpillShape :size 8 :alignment 8))
    (push! (mut shapes) (a/SpillShape :size 16 :alignment 16))
    (need (f/private-slot! (mut layout) 8 8))
    (for [i 0 3]
      (let [(mut part) (a/create (if (< i 2) 0 1) allocator)]
        (set! (.allowed part) (if (and (= mode 3) (= i 2)) (rc/mask base) allowed))
        (set! (.register part) (if (= i 1) (+ base 1) base))
        (if (= i 0) (r/add! (mut (.ranges part)) 0 5)
            (if (or (= mode 2) (and (= mode 1) (= i 2)))
                (do (r/add! (mut (.ranges part)) 5 (if (= mode 1) 6 7)) (r/add! (mut (.ranges part)) (if (= mode 1) 7 8) 10))
                (r/add! (mut (.ranges part)) 5 10)))
        (unless (and (= mode 3) (= i 2))
          (assert (c/add! (mut (.uses part)) (if (= i 0) 0 5) (if (= i 0) 2 1) base)))
        (push! (mut parts) part)))
    (when (= mode 1) (a/reserve! (mut parts) base 6 7 allocator))
    (when (= mode 2) (a/reserve! (mut parts) base 7 8 allocator))
    (rc/add-copy! (mut copies) (rc/allocated 0) 1 0 100)
    (rc/add-copy! (mut copies) (rc/allocated 0) 1 0 100)
    (assert (= (len copies) 1))
    (assert (= (rc/score parts copies plan) 100))
    (need (check/verify parts 64 allowed))
    (let [changed (need (rc/run! (mut parts) (mut layout) (slice shapes) copies 64 allowed allocator))]
      (assert (= changed (if (= mode 1) 0 2)))
      (assert (= (rc/score parts copies plan) (if (= mode 1) 100 0)))
      (assert (= (.register (get parts 0)) base))
      (assert (= (.register (get parts 1)) (if (= mode 1) (+ base 1) base)))
      (when (= mode 3)
        (assert (= (.register (get parts 2)) -1))
        (assert (= (.spill-slot (get parts 2)) 16))
        (assert (= (.size layout) 32))
        (assert (= (need (f/spill-slot! (mut layout) 1 16 16)) 16))))
    ; A second invocation has no remaining improving transaction.
    (assert (= (need (rc/run! (mut parts) (mut layout) (slice shapes) copies 64 allowed allocator)) 0))
    (need (check/verify parts 64 allowed))
    ; Read-only recipes count as copies, including when targeting a new home.
    (rc/add-copy! (mut copies) (rc/recipe (loc/Location :kind 4 :value -7)) 2 1 10)
    (assert (= (rc/score parts copies plan) (+ (if (= mode 1) 100 0) (if (= mode 3) 30 10))))
    (push! (mut copies) (rc/Copy :source (rc/allocated 0) :target 99 :site 2 :weight 1 :store-only false))
    (match (rc/run! (mut parts) (mut layout) (slice shapes) copies 64 allowed allocator)
      (Ok [_] (panic "invalid endpoint accepted")) (Err [_] 0))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts)) (free! (mut shapes)) (free! (mut copies)) (free! (mut plan))
    (f/release! (mut layout))))
;;; A reload-friendly downstream copy must not turn an odd-phase spill into
;;; an unsupported register move. The unrestricted optimum uses r1; the legal
;;; odd-phase optimum keeps r0 and pays the downstream transfer instead.
(defn phase! [(restricted bool)] (-> void)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut copies) (ArrayList::new [rc/Copy] allocator)
        (mut plan) (ArrayList::new [rc/Change] allocator)
        (mut layout) (f/create allocator)
        shape (a/SpillShape :size 8 :alignment 8)
        home (need (f/spill-slot! (mut layout) 0 8 8))]
    (for [i 0 3]
      (let [(mut part) (a/create 0 allocator)]
        (set! (.allowed part) 3)
        (set! (.register part) (if (= i 1) -1 (if (= i 0) 0 1)))
        (set! (.spill-slot part) home)
        (r/add! (mut (.ranges part)) (* i 5) (* (+ i 1) 5))
        (unless (= i 1) (assert (c/add! (mut (.uses part)) (* i 5) 2 (.register part))))
        (push! (mut parts) part)))
    (rc/add-copy-with-limit! (mut copies) (rc/allocated 0) 1 0 1 restricted)
    (rc/add-copy! (mut copies) (rc/allocated 1) 2 1 100)
    (assert (= (rc/score parts copies plan) 303))
    (need (rc/run! (mut parts) (mut layout) [shape] copies 2 3 allocator))
    (assert (= (.register (get parts 1)) (if restricted 0 1)))
    (assert (= (rc/score parts copies plan) (if restricted 100 1)))
    (assert (rc/legal? parts copies plan))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts)) (free! (mut copies)) (free! (mut plan)) (f/release! (mut layout))))

(defn main [] (-> i32)
  (for [i 0 5] (case! (cast i32 i)))
  (phase! false) (phase! true)
  (println "bounded allocation recoloring: pass") 0)
