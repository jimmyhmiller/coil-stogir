(module stogir.tests.fixed-use-sort)
(import "stogir.fixed-uses" :as f)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

;;; Sorted output is ordered by before? and is a permutation of the input,
;;; across empty, single, insertion-sized and multi-merge register buckets,
;;; with duplicate positions and duplicate events.
(defn check [(seed i64) (count i64)] (-> i64)
  (let [a (malloc-allocator)
        (mut events) (ArrayList::new [f/Event] a)
        (mut original) (ArrayList::new [f/Event] a)
        (mut failures) 0
        (mut state) (% (+ (* seed 2654435761) 12345) 2147483648)]
    (for [i 0 count]
      (set! state (% (+ (* state 1103515245) 12345) 2147483648))
      (let [reg (cast i32 (if (= (% i 3) 0) (% state 3) (% state 64)))
            event (f/Event :position (% (/ state 64) 97) :register reg
                           :owner (cast i32 (% (/ state 4096) 13)))]
        (push! (mut events) event)
        (push! (mut original) event)))
    (f/sort! (mut events) a)
    (assert (= (len events) count))
    (for [i 1 count]
      (when (f/before? (get events i) (get events (- i 1)))
        (set! failures (+ failures 1))))
    ; Permutation: every original event occurs as often in the output.
    (for [i 0 count]
      (let [e (get original i)
            (mut want) 0
            (mut have) 0]
        (for [j 0 count]
          (let [x (get original j) y (get events j)]
            (when (and (= (.position x) (.position e)) (= (.register x) (.register e))
                       (= (.owner x) (.owner e)))
              (set! want (+ want 1)))
            (when (and (= (.position y) (.position e)) (= (.register y) (.register e))
                       (= (.owner y) (.owner e)))
              (set! have (+ have 1)))))
        (when (!= want have) (set! failures (+ failures 1)))))
    (free! (mut events))
    (free! (mut original))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for count [(: 0 i64) 1 2 15 16 17 33 100 517 2000]
      (for [seed 0 6] (set! failures (+ failures (check seed count)))))
    (println "fixed-use sort checks: {} failures" failures)
    (if (= failures 0) 0 1)))
