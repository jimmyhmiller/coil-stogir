    (_ 0)))

(defn score [(id i32) (seed u64)] (-> u64)
  (let [(mut i) (: 0 i32)
        (mut sum) (: 0 u64)]
    (while (< i (field-count id))
      (let [bits (+ seed (: 506 u64) (* (cast u64 i) (: 257 u64)))
            ty (memory-type id i)
            value
              (if (= ty 2) (& bits 255) (if (= ty 4) (& bits 0xFFFFFFFF) bits))]
        (set! sum (+ sum (* value (cast u64 (+ i 1))))))
      (set! i (+ i 1)))
    sum))

(defn incoming [(id i32) (mode i32) (seed u64) (data u64)] (-> u64)
  (match id
    (1 (let [value
               (if (= mode 1)
                   (pure1 seed
                          (: 1 u64)
                          (: 2 u64)
                          (: 3 u64)
                          (: 4 u64)
                          (: 5 u64)
                          (: 6 u64)
                          (: 7 u64)
                          (: 8 u64)
                          (: 9 u64)
                          (: 10 u64)
                          (: 11 u64))
                   (forward1 (target id)
