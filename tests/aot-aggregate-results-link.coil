(defn outgoing [(id i32) (place u64) (seed u64) (data u64)] (-> u64)
  (match id
    (1 (out1 (target id) place seed data))
    (6 (out6 (target id) place seed data))
    (11 (out11 (target id) place seed data))
    (13 (out13 (target id) place seed data))
    (14 (out14 (target id) place seed data))
    (15 (out15 (target id) place seed data))
    (_ 0)))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut integers) (ArrayList::new [u64] allocator)
        (mut singles) (ArrayList::new [f32] allocator)
        (mut doubles) (ArrayList::new [f64] allocator)
        (mut bytes) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i64)
        (mut failures) 0]
    (while (< i 40)
      (push! (mut integers) (cast u64 (+ i 11)))
      (push! (mut singles) (cast f32 (+ i 11)))
      (push! (mut doubles) (cast f64 (+ i 11)))
      (set! i (+ i 1)))
    (set! i 0)
    (while (< i 96) (push! (mut bytes) 165) (set! i (+ i 1)))
    (for id [(: 1 i32) 6 11 13 14 15]
      (for pattern [(: 0 u64)
                    1
                    0x80000000
                    0x7F800000
                    0x7FC12345
                    0xFF800000
                    0x8000000000000000
                    0x7FF0000000000000
                    0x7FF8123456789ABC
                    0xFFF0000000000000
                    0xFFFFFFFFFFFFFFFF]
        (let [seed (- pattern (: 506 u64))
              ty (data-type id)
              offset (if (= id 13) (: 16 i64) (: 3 i64))
              data
                (if (= ty 5)
                    (primitive/cast u64 (.data integers))
                    (if (= ty 13)
                        (primitive/cast u64 (.data singles))
                        (primitive/cast u64 (.data doubles))))
              expected (score id seed)]
          (set! i 0)
          (while (< i (len bytes))
            (primitive/store! (primitive/index (.data bytes) i) (: 165 u8))
            (set! i (+ i 1)))
          (when (or (!= (outgoing id
                                  (primitive/cast u64
                                                  (primitive/index (.data bytes)
                                                                   offset))
                                  seed
                                  data)
                        (+ expected 1862))
                    (!= (incoming id 1 seed data) expected)
                    (!= (incoming id 2 seed data) expected))
            (set! failures (+ failures 1)))
          (set! i 0)
          (while (< i (len bytes))
            (when (and (or (< i offset)
                           (>= i (+ offset (cast i64 (payload-size id)))))
                       (!= (get bytes i) 165))
              (set! failures (+ failures 1)))
            (set! i (+ i 1))))))
    (free! (mut integers))
    (free! (mut singles))
    (free! (mut doubles))
    (free! (mut bytes))
    (println "linked aggregate results, x8, payload bits, nested calls and aligned frames: {} failures"
             failures)
    (if (= failures 0) 0 1)))
