(defn target [(id i32)] (-> u64)
  (match id
    (1 (primitive/cast u64
                       (primitive/cast (ptr u8)
                                       (: (fnptr-of callback1)
                                          (fnptr (cc/C)
                                                 [u64 u64 u64 u64 u64 u64 u64
                                                  u64 u64 u64 u64 u64]
                                                 R1)))))
    (6 (primitive/cast u64
                       (primitive/cast (ptr u8)
                                       (: (fnptr-of callback6)
                                          (fnptr (cc/C)
                                                 [u64 u64 u64 u64 u64 u64 u64
                                                  u64 u64 u64 u64 u64]
                                                 R6)))))
    (11 (primitive/cast u64
                        (primitive/cast (ptr u8)
                                        (: (fnptr-of callback11)
                                           (fnptr (cc/C)
                                                  [u64 u64 u64 u64 u64 u64 u64
                                                   u64 u64 u64 u64 u64]
                                                  R11)))))
    (13 (primitive/cast u64
                        (primitive/cast (ptr u8)
                                        (: (fnptr-of callback13)
                                           (fnptr (cc/C)
                                                  [u64 u64 u64 u64 u64 u64 u64
                                                   u64 u64 u64 u64 u64]
                                                  R13)))))
    (14 (primitive/cast u64
                        (primitive/cast (ptr u8)
                                        (: (fnptr-of callback14)
                                           (fnptr (cc/C)
                                                  [u64 u64 u64 u64 u64 u64 u64
                                                   u64 u64 u64 u64 u64]
                                                  R14)))))
    (15 (primitive/cast u64
                        (primitive/cast (ptr u8)
                                        (: (fnptr-of callback15)
                                           (fnptr (cc/C)
                                                  [u64 u64 u64 u64 u64 u64 u64
                                                   u64 u64 u64 u64 u64]
                                                  R15)))))
    (_ 0)))

