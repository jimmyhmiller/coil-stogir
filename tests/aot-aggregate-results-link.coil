  (match id
    (0 1)
    (1 2)
    (2 1)
    (3 2)
    (4 1)
    (5 2)
    (6 3)
    (7 4)
    (8 1)
    (9 2)
    (10 3)
    (11 4)
    (12 3)
    (13 5)
    (14 3)
    (15 2)
    (_ 0)))

