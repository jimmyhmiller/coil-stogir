(module stogir.tests.aot-floating-loop-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern add64 :as "stogir_fp_add_f64" :cc (cc/C) [i64 f64] (-> f64))

(extern add32 :as "stogir_fp_add_f32" :cc (cc/C) [i64 f32] (-> f32))

(extern swap64 :as "stogir_fp_swap_f64" :cc (cc/C) [i64 f64] (-> f64))

(extern swap32 :as "stogir_fp_swap_f32" :cc (cc/C) [i64 f32] (-> f32))

(defn nan? [(ty i32) (bits u64)] (-> bool)
  (let [exp (if (= ty 12) (: 0x7FF0000000000000 u64) 0x7F800000)
        fraction (if (= ty 12) (: 0xFFFFFFFFFFFFF u64) 0x7FFFFF)]
    (and (= (& bits exp) exp) (!= (& bits fraction) 0))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for n [(: -1 i64) 0 1 2 10 31]
      (for bits [(: 0 u64)
                 0x80000000
                 0x3FF4000000000000
                 0x8000000000000000
                 0x7F812345
                 0x7FF0123456789ABC]
        (let [(mut d) (: 0.0 f64)
              (mut f) (: 0.0 f32)
              (mut i) (: 0 i64)]
          (store! (primitive/cast (ptr u64) (mut d)) bits)
          (store! (primitive/cast (ptr u32) (mut f)) (cast u32 bits))
          (let [(mut sum64) (add64 n d)
                (mut sum32) (add32 n f)
                (mut result64) (swap64 n d)
                (mut result32) (swap32 n f)
                swap-wide
                  (if (and (> n 0) (= (% n 2) 1))
                      (: 0x8000000000000000 u64)
                      bits)
                swap-narrow
                  (if (and (> n 0) (= (% n 2) 1))
                      (: 0x80000000 u64)
                      (cast u64 (cast u32 bits)))
                (mut expected64) d
                (mut expected32) f]
            (while (< i n)
              (set! expected64 (+ expected64 1.0))
              (set! expected32 (+ expected32 (: 1.0 f32)))
              (set! i (+ i 1)))
            (let [actual64 (load (primitive/cast (ptr u64) (mut sum64)))
                  actual32
                    (cast u64 (load (primitive/cast (ptr u32) (mut sum32))))
                  wanted64 (load (primitive/cast (ptr u64) (mut expected64)))
                  wanted32
                    (cast u64
                          (load (primitive/cast (ptr u32) (mut expected32))))]
              (when (or (!= (load (primitive/cast (ptr u64) (mut result64)))
                            swap-wide)
                        (!= (cast u64
                                  (load (primitive/cast (ptr u32)
                                                        (mut result32))))
                            swap-narrow)
                        (if (and (> n 0) (nan? 12 wanted64))
                            (not (nan? 12 actual64))
                            (!= actual64 wanted64))
                        (if (and (> n 0) (nan? 13 wanted32))
                            (not (nan? 13 actual32))
                            (!= actual32 wanted32)))
                (set! failures (+ failures 1))))))))
    (println "linked floating arithmetic/parallel-phi loops: {} failures"
             failures)
    (if (= failures 0) 0 1)))
