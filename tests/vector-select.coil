(defstruct InvalidCase [(ty i32) (rd i32) (yes i32) (no i32)])

(def INVALID-CASES
  (table InvalidCase
         [37 30 1 2]
         [37 31 1 2]
         [37 -1 1 2]
         [37 0 -1 2]
         [37 0 32 2]
         [37 0 1 32]
         [5 0 1 2]
         [53 0 1 2]
         [18 0 1 2]))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row CHECK-CASES
      (set! failures
            (+ failures
               (check (.ty row) (.rd row) (.yes row) (.no row) (.words row)))))
    (for row MASK-WORD-CASES
      (set! failures
            (+ failures
               (mask-word (.wide row)
                          (.rd row)
                          (.condition row)
                          (.expected row)))))
    (for row INVALID-CASES
      (set! failures
            (+ failures (invalid (.ty row) (.rd row) (.yes row) (.no row)))))
    (match (encode/conditional-set-mask true -1 1)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (match (encode/conditional-set-mask true 32 1)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (match (encode/conditional-set-mask true 0 -1)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (match (encode/conditional-set-mask true 0 14)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (println "vector selection: 338 register cases plus 112 conditional masks, 1412 MC words; failures {}"
             failures)
    failures))
