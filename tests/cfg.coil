(module stogir.tests.cfg)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.loops" :as loops)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        end (require (b/emit! (mut graph) 114 0 [start]))
        loop (require (b/loop-begin! (mut graph) end))
        back (require (b/emit! (mut graph) 115 0 [loop]))
        (mut failures) 0
        disconnected (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))]
    (b/patch! (mut graph) loop 2 back)
    (match (cfg/build graph a)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [blocks]
          (let [(mut owned) blocks]
            (when (!= (len (.starts owned)) 3) (set! failures (+ failures 1)))
            (when (!= (get (.membership owned) (cast i64 end)) start)
              (set! failures (+ failures 1)))
            (when (!= (get (.membership owned) (cast i64 back)) loop)
              (set! failures (+ failures 1)))
            (when (!= (len (.edges owned)) 2) (set! failures (+ failures 1)))
            (when (= (len (.edges owned)) 2)
              (let [entry-edge (get (.edges owned) 0)
                    back-edge (get (.edges owned) 1)]
                (when (!= (.from entry-edge) start)
                  (set! failures (+ failures 1)))
                (when (!= (.to entry-edge) loop) (set! failures (+ failures 1)))
                (when (!= (.position entry-edge) 1)
                  (set! failures (+ failures 1)))
                (when (!= (.from back-edge) loop)
                  (set! failures (+ failures 1)))
                (when (!= (.source back-edge) back)
                  (set! failures (+ failures 1)))
                (when (!= (.position back-edge) 2)
                  (set! failures (+ failures 1)))))
            (let [(mut predecessors) (adj/build owned true a)
                  (mut successors) (adj/build owned false a)
                  incoming (get (.ranges predecessors) (cast i64 loop))
                  outgoing (get (.ranges successors) (cast i64 start))]
              (when (!= (.count incoming) 2) (set! failures (+ failures 1)))
              (when (!= (.count outgoing) 1) (set! failures (+ failures 1)))
              (when (!= (get (.edges predecessors) (.offset incoming)) 0)
                (set! failures (+ failures 1)))
              (when (!= (get (.edges predecessors) (+ (.offset incoming) 1)) 1)
                (set! failures (+ failures 1)))
              (let [(mut seen) (adj/reachable owned successors start a)
                    (mut order) (adj/reverse-postorder owned successors start a)]
                (when (not (get seen (cast i64 start)))
                  (set! failures (+ failures 1)))
                (when (not (get seen (cast i64 loop)))
                  (set! failures (+ failures 1)))
                (when (get seen (cast i64 disconnected))
                  (set! failures (+ failures 1)))
                (when (get seen (cast i64 end)) (set! failures (+ failures 1)))
                (when (!= (len order) 2) (set! failures (+ failures 1)))
                (when (= (len order) 2)
                  (when (!= (get order 0) start) (set! failures (+ failures 1)))
                  (when (!= (get order 1) loop) (set! failures (+ failures 1))))
                (let [(mut idom) (dom/build owned predecessors order a)]
                  (when (!= (get idom (cast i64 start)) start)
                    (set! failures (+ failures 1)))
                  (when (!= (get idom (cast i64 loop)) start)
                    (set! failures (+ failures 1)))
                  (when (!= (get idom (cast i64 disconnected)) 0)
                    (set! failures (+ failures 1)))
                  (when (not (dom/dominates? idom start loop))
                    (set! failures (+ failures 1)))
                  (when (dom/dominates? idom loop start)
                    (set! failures (+ failures 1)))
                  (let [(mut depth) (loops/depths owned predecessors idom a)]
                    (when (!= (get depth (cast i64 start)) 0)
                      (set! failures (+ failures 1)))
                    (when (!= (get depth (cast i64 loop)) 1)
                      (set! failures (+ failures 1)))
                    (when (!= (get depth (cast i64 disconnected)) 0)
                      (set! failures (+ failures 1)))
                    (free! (mut depth)))
                  (free! (mut idom)))
                (free! (mut seen))
                (free! (mut order)))
              (adj/release! (mut predecessors))
              (adj/release! (mut successors)))
            (cfg/release! (mut owned)))))
    (b/patch! (mut graph) end 1 end)
    (match (cfg/build graph a)
      (Err [_] 0)
      (Ok [blocks]
          (let [(mut owned) blocks]
            (set! failures (+ failures 1))
            (cfg/release! (mut owned)))))
    (g/release! (mut graph))
    (println "CFG checks: {} failures" failures)
    (if (= failures 0) 0 1)))
