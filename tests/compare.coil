(module stogir.tests.compare)
(import "stogir.fold" :as f)
(import "coil.result" :use [Some None])

(defn check [(opcode i32) (ty i32) (a u64) (b u64) (want u64)] (-> i64)
  (match (f/integer-compare opcode ty 8 a b)
    (Some [got] (if (= got want) 0 1))
    (None [] 1)))

(defn main [] (-> i64)
  (let [failures
          (+ (check 16 1 1 0 0)
             (check 16 1 0 1 1)
             (check 17 1 1 0 1)
             (check 18 1 1 0 0)
             (check 19 1 1 0 1)
             (check 16 8 255 0 1)
             (check 20 8 255 0 0)
             (check 17 8 128 127 0)
             (check 21 8 128 127 1)
             (check 18 11 0x8000000000000000 0 1)
             (check 19 11 0x7FFFFFFFFFFFFFFF 0x8000000000000000 1)
             (check 14 2 255 255 1)
             (check 15 2 255 255 0)
             (check 22 4 42 42 1)
             (check 23 4 42 42 0))]
    (println "comparison checks: {} failures" failures)
    (if (= failures 0) 0 1)))
