(module stogir.tests.aot-narrow-binary-link)
(import "coil.cc" :as cc)

(extern unsigned8 :as "stogir_binary_u8" :cc (cc/C) [u8 u8] (-> u64))

(extern unsigned16 :as "stogir_binary_u16" :cc (cc/C) [u16 u16] (-> u64))

(extern character :as "stogir_binary_char" :cc (cc/C) [i8 i8] (-> u64))

(extern signed8 :as "stogir_binary_i8" :cc (cc/C) [i8 i8] (-> u64))

(extern signed16 :as "stogir_binary_i16" :cc (cc/C) [i16 i16] (-> u64))

(extern bool-lt :as "stogir_bool_lt" :cc (cc/C) [bool bool] (-> bool))

(defstruct Case
  [(a u64)
   (b u64)
   (u8-result u64)
   (u16-result u64)
   (i8-result u64)
   (i16-result u64)])

;;; Fixed expected XOR of all binary families and both preserved original inputs.
(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row [(Case
                :a 0x0
                :b 0x0
                :u8-result 0x0
                :u16-result 0x0
                :i8-result 0x0
                :i16-result 0x0)
              (Case
                :a 0x0
                :b 0x1
                :u8-result 0xFF
                :u16-result 0xFFFF
                :i8-result 0xFF
                :i16-result 0xFFFF)
              (Case
                :a 0x1
                :b 0x0
                :u8-result 0x1
                :u16-result 0x1
                :i8-result 0x1
                :i16-result 0x1)
              (Case
                :a 0x1
                :b 0x1
                :u8-result 0x82
                :u16-result 0x8002
                :i8-result 0x82
                :i16-result 0x8002)
              (Case
                :a 0x7
                :b 0x3
                :u8-result 0xFC
                :u16-result 0xE01C
                :i8-result 0xFC
                :i16-result 0xE01C)
              (Case
                :a 0xFFFFFFFFFFFFFFF9
                :b 0x3
                :u8-result 0x90
                :u16-result 0x8AB0
                :i8-result 0xC2
                :i16-result 0xDFE2)
              (Case
                :a 0xFFFFFFFFFFFFFFF9
                :b 0xFFFFFFFFFFFFFFFD
                :u8-result 0xCA
                :u16-result 0xE02A
                :i8-result 0xCE
                :i16-result 0xE02E)
              (Case
                :a 0x7
                :b 0xFFFFFFFFFFFFFFFD
                :u8-result 0x20
                :u16-result 0x20
                :i8-result 0xD8
                :i16-result 0xFFD8)
              (Case
                :a 0x80
                :b 0xFFFFFFFFFFFFFFFF
                :u8-result 0x3E
                :u16-result 0x1C1
                :i8-result 0x3E
                :i16-result 0xFEC1)
              (Case
                :a 0x8000
                :b 0xFFFFFFFFFFFFFFFF
                :u8-result 0x1
                :u16-result 0x3FFE
                :i8-result 0x1
                :i16-result 0x3FFE)
              (Case
                :a 0xFF
                :b 0x8
                :u8-result 0x18
                :u16-result 0xF9E7
                :i8-result 0xFF
                :i16-result 0xF9E7)
              (Case
                :a 0x8001
                :b 0x10
                :u8-result 0xE1
                :u16-result 0xF7E1
                :i8-result 0xE1
                :i16-result 0xF810)
              (Case
                :a 0x8080
                :b 0x20
                :u8-result 0xE4
                :u16-result 0x14E4
                :i8-result 0x1C
                :i16-result 0xECE4)
              (Case
                :a 0xABCD
                :b 0xFF
                :u8-result 0xCD
                :u16-result 0x7155
                :i8-result 0x33
                :i16-result 0x7155)
              (Case
                :a 0xFEDCBA9876543280
                :b 0x41
                :u8-result 0x40
                :u16-result 0xF903
                :i8-result 0x40
                :i16-result 0xF903)
              (Case
                :a 0xFFFFFFFF
                :b 0x7F
                :u8-result 0x82
                :u16-result 0x8206
                :i8-result 0x7E
                :i16-result 0x7FFE)
              (Case
                :a 0x8000000000000000
                :b 0xFFFF
                :u8-result 0x1
                :u16-result 0x1
                :i8-result 0x1
                :i16-result 0x1)
              (Case
                :a 0xFFFFFFFFFFFFFFFF
                :b 0xFFFFFFFFFFFFFFFF
                :u8-result 0x80
                :u16-result 0x8000
                :i8-result 0x80
                :i16-result 0x8000)]
      (when (or (!= (unsigned8 (cast u8 (.a row)) (cast u8 (.b row)))
                    (.u8-result row))
                (!= (unsigned16 (cast u16 (.a row)) (cast u16 (.b row)))
                    (.u16-result row))
                (!= (character (cast i8 (.a row)) (cast i8 (.b row)))
                    (.i8-result row))
                (!= (signed8 (cast i8 (.a row)) (cast i8 (.b row)))
                    (.i8-result row))
                (!= (signed16 (cast i16 (.a row)) (cast i16 (.b row)))
                    (.i16-result row)))
        (set! failures (+ failures 1))))
    (when (or (bool-lt false false)
              (not (bool-lt false true))
              (bool-lt true false)
              (bool-lt true true))
      (set! failures (+ failures 1)))
    (println "linked narrow binary/comparison checks: {} failures" failures)
    (if (= failures 0) 0 1)))
