(module stogir.tests.aot-overaligned-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern aligned64
        :as
        "stogir_overaligned_64"
        :cc
        (cc/C)
        [u64 i64 i64 i64 i64 i64 i64 i64 i32 i32 i64 i32 i64]
        (-> i64))

(extern aligned4096
        :as
        "stogir_overaligned_4096"
        :cc
        (cc/C)
        [u64 i64 i64 i64 i64 i64 i64 i64 i32 i32 i64 i32 i64]
        (-> i64))

(defn combine :cc (cc/C) [(a i64) (b i64)] (-> i64)
  (+ (* a 3) (* b 5)))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of combine)))
        (mut failures) 0]
    (when (!= (aligned64 target 7 0 0 0 0 0 0 -3 0 11 0 13) 66)
      (set! failures (+ failures 1)))
    (when (!= (aligned4096 target 7 0 0 0 0 0 0 -3 0 11 0 13) 66)
      (set! failures (+ failures 1)))
    (println "linked overaligned frame and incoming arguments: {} failures"
             failures)
    (if (= failures 0) 0 1)))
