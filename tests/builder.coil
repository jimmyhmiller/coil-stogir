(module stogir.tests.builder)
(import "stogir.builder" :as b)
(import "stogir.graph" :as g)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        (mut failures) 0]
    (match (b/scalar-constant! (mut graph) 11 42 8)
      (Ok [r]
          (let [args [r r]]
            (match (b/emit! (mut graph) 26 11 args)
              (Ok [sum]
                  (do
                    (match (b/patch! (mut graph) sum 2 r)
                      (Ok [_] 0)
                      (Err [_] (set! failures (+ failures 1))))
                    (match (b/patch! (mut graph) sum 3 r)
                      (Ok [_] (set! failures (+ failures 1)))
                      (Err [_] 0))
                    (match (b/patch! (mut graph) sum 1 999)
                      (Ok [_] (set! failures (+ failures 1)))
                      (Err [_] 0))))
              (Err [_] (set! failures (+ failures 1))))))
      (Err [_] (set! failures (+ failures 1))))
    (match (b/scalar-constant! (mut graph) 1 2 8)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (b/scalar-constant! (mut graph) 2 256 8)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (b/emit! (mut graph) 26 11 [(: 999 i32) 999])
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (b/emit! (mut graph) 26 11 [(: -1 i32)])
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    (println "builder checks: {} failures" failures)
    (if (= failures 0) 0 1)))
