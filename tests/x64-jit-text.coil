(module stogir.tests.x64-jit-text)
(import "stogir.jit.native" :as jit)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Ok Err])

;;; Hand-assembled x86-64 text through the raw text mapping (Linux x86-64 host).
(defn main [] (-> i64)
  (let [(mut failures) 0]
    ; mov eax, 42; ret
    (match (jit/map-text [(: 0xB8 u8) 0x2A 0 0 0 0xC3])
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [image]
          (let [(mut owned) image
                f (primitive/cast (fnptr (cc/C) [] i64) (.base owned))]
            (when (!= (call-ptr f) 42) (set! failures (+ failures 1)))
            (when (!= (.text-size owned) 6) (set! failures (+ failures 1)))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1))))))
    ; lea rax, [rdi+rsi]; ret
    (match (jit/map-text [(: 0x48 u8) 0x8D 0x04 0x37 0xC3])
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [image]
          (let [(mut owned) image
                f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (.base owned))
                (mut x) -50]
            (while (<= x 50)
              (when (!= (call-ptr f x (* x 7)) (* x 8))
                (set! failures (+ failures 1)))
              (set! x (+ x 1)))
            (when (!= (call-ptr f 0x100000000 -1) 0xFFFFFFFF)
              (set! failures (+ failures 1)))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1))))))
    (match (jit/map-text [])
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (println "x86-64 raw text JIT checks: {} failures" failures)
    (if (= failures 0) 0 1)))
