(module stogir.tests.return-validation)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as verify)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [reference] reference) (Err [msg] (do (println "{}" msg) 0))))

(defn check [(kind i32) (expected (slice u8))] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        value (require (b/scalar-constant! (mut graph) 10 42 8))
        ret
          (require (b/emit! (mut graph)
                            120
                            (if (= kind 2) 11 0)
                            [start (if (= kind 0) (: 0 i32) value) (: 0 i32)]))
        (mut failures) 0]
    (when (= kind 0)
      (match (b/patch! (mut graph) ret 2 0)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [_] 0)))
    (match (verify/integer-operations graph)
      (Err [msg] (when (!= msg expected) (set! failures (+ failures 1))))
      (Ok [_] (when (!= expected "") (set! failures (+ failures 1)))))
    (match (b/emit! (mut graph) 120 11 [start (: 0 i32) 0])
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (check 0 "")
             (check 1 "void return cannot have a value")
             (check 2 "return value type mismatch"))]
    (println "return typing checks: {} failures" failures)
    (if (= failures 0) 0 1)))
