(defstruct PressureCase [(ty i32) (opcode i32) (alignment i32) (id i32)])

(def PRESSURE-CASES
  (table PressureCase
         [81 14 16 804]
         [81 14 4096 805]
         [81 16 16 806]
         [81 16 4096 807]
         [81 20 16 808]
         [81 20 4096 809]
         [88 14 16 810]
         [88 14 4096 811]
         [88 16 16 812]
         [88 16 4096 813]
         [88 20 16 814]
         [88 20 4096 815]
         [67 14 16 816]
         [67 14 4096 817]
         [67 16 16 818]
         [67 16 4096 819]
         [67 20 16 820]
         [67 20 4096 821]
         [52 14 16 822]
         [52 14 4096 823]
         [52 16 16 824]
         [52 16 4096 825]
         [52 20 16 826]
         [52 20 4096 827]
         [37 14 16 828]
         [37 14 4096 829]
         [37 16 16 830]
         [37 16 4096 831]
         [37 20 16 832]
         [37 20 4096 833]
         [43 14 16 834]
         [43 14 4096 835]
         [43 16 16 836]
         [43 16 4096 837]
         [43 20 16 838]
         [43 20 4096 839]
         [45 14 16 840]
         [45 14 4096 841]
         [45 16 16 842]
         [45 16 4096 843]
         [45 20 16 844]
         [45 20 4096 845]
         [45 24 16 846]
         [45 24 4096 847]
         [45 25 16 848]
         [45 25 4096 849]
         [44 14 16 850]
         [44 14 4096 851]
         [44 16 16 852]
         [44 16 4096 853]
         [44 20 16 854]
         [44 20 4096 855]
         [44 24 16 856]
         [44 24 4096 857]
         [44 25 16 858]
         [44 25 4096 859]))

(defn main [] (-> i64)
  (let [(mut failures) (forced-aliases)]
    (for row GENERATE-CASES
      (set! failures
            (+ failures (generate (.ty row) (.opcode row) (.mode row)))))
    (for row PRESSURE-CASES
      (set! failures
            (+ failures
               (pressure (.ty row) (.opcode row) (.alignment row) (.id row)))))
    (println "vector comparisons: 1340 matrix graphs, 56 pressure graphs, 3484 forced aliases; failures {}"
             failures)
    failures))
