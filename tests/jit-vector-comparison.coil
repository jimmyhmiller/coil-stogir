(defn forced-aliases [] (-> i64)
  (let [(mut failures) 0]
    (for row ALIAS-CHECK-CASES
      (set! failures
            (+ failures
               (alias-check (.ty row)
                            (.opcode row)
                            (.rd row)
                            (.rn row)
                            (.rm row)))))
    failures))

