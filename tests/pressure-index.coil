(module stogir.tests.pressure-index)
(import "stogir.allocation" :as a)
(import "stogir.fixed-uses" :as f)
(import "stogir.frame" :as frame)
(import "stogir.interval-queue" :as queue)
(import "coil.result" :use [Result Ok Err Some None])
(import "stogir.constraints" :as c)
(import "stogir.interval" :as range)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn compare [(parts (ArrayList a/Part))
               (fixed a/PressureIndex)
               (registers i32)
               (reused (mut a/Pressure))]
  (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0]
    (for [i 0 (len parts)]
      (when (> (len (.ranges (get parts i))) 0)
        (let [(mut expected) (a/pressure parts (cast i32 i) registers allocator)
              (mut actual)
                (a/pressure-indexed parts
                                    (cast i32 i)
                                    registers
                                    fixed
                                    allocator)]
          (a/pressure-into! parts (cast i32 i) fixed (mut reused))
          (for [r 0 (cast i64 registers)]
            (when (or (!= (get (.free expected) r) (get (.free actual) r))
                      (!= (get (.next-use expected) r)
                          (get (.next-use actual) r))
                      (!= (get (.fixed-at expected) r)
                          (get (.fixed-at actual) r)))
              (set! failures (+ failures 1)))
            (when (or (!= (get (.free expected) r) (get (.free reused) r))
                      (!= (get (.next-use expected) r)
                          (get (.next-use reused) r))
                      (!= (get (.fixed-at expected) r)
                          (get (.fixed-at reused) r)))
              (set! failures (+ failures 1))))
          (a/release-pressure! (mut expected))
          (a/release-pressure! (mut actual)))))
    failures))

(defn check [(seed i64) (registers i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut fixed)
          (a/PressureIndex :known 0 :parts (ArrayList::new [i32] allocator))
        (mut reused) (a/pressure-buffer registers allocator)
        (mut failures) 0]
    (for [i 0 32]
      (let [(mut part) (a/create (cast i32 i) allocator)
            start (% (+ (* i 7) seed) 32)]
        (push! (mut (.ranges part)) (range/Range :start start :end (+ start 8)))
        (push! (mut (.ranges part))
               (range/Range :start (+ start 16) :end (+ start 32)))
        (when (= (% i 3) 0)
          (set! (.register part) (cast i32 (% i (cast i64 registers)))))
        (for [j 0 12]
          (let [position (+ (* j 5) (% (+ seed i) 4))
                fixed?
                  (or (= (% seed 3) 0)
                      (and (= (% seed 3) 2) (= (% i 4) 0)))
                kind (if (and fixed? (= (% j 3) 0)) 2 (cast i32 (% j 2)))
                reg
                  (if (= kind 2) (cast i32 (% (+ i j) (cast i64 registers))) -1)]
            (when (not (c/add! (mut (.uses part)) position kind reg))
              (panic "inconsistent test use"))))
        (push! (mut parts) part)))
    (a/refresh-pressure! (mut fixed) parts)
    (when (!= (len (.parts fixed))
              (if (= (% seed 3) 0) 32 (if (= (% seed 3) 1) 0 8)))
      (set! failures (+ failures 1)))
    (set! failures (+ failures (compare parts fixed registers (mut reused))))
    ; Split indexed prefixes. Moved fixed uses must be found in appended children.
    (for [i 0 32]
      (let [part (elem (mut parts) i)
            cut (+ (.start (get (.ranges part) 0)) (if (= (% i 2) 0) 4 20))
            child (a/split! part cut allocator)]
        (push! (mut parts) child)))
    (a/refresh-pressure! (mut fixed) parts)
    (set! failures (+ failures (compare parts fixed registers (mut reused))))
    ; A later reservation and repeated refresh cannot omit or duplicate effects.
    (a/reserve! (mut parts) (- registers 1) 3 47 allocator)
    (a/refresh-pressure! (mut fixed) parts)
    (let [count (len (.parts fixed))]
      (a/refresh-pressure! (mut fixed) parts)
      (when (or (!= count (len (.parts fixed))) (!= (.known fixed) (len parts)))
        (set! failures (+ failures 1))))
    (set! failures (+ failures (compare parts fixed registers (mut reused))))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (free! (mut (.parts fixed)))
    (a/release-pressure! (mut reused))
    failures))

(defn compare-events [(parts (ArrayList a/Part))
                      (index (mut f/Index))
                      (registers i32)] (-> i64)
  (let [(mut failures) 0
        (mut actual) (a/pressure-buffer registers (malloc-allocator))]
    (for [i 0 (len parts)]
      (when (> (len (.ranges (get parts i))) 0)
        (let [(mut expected)
                (a/pressure parts (cast i32 i) registers (malloc-allocator))]
          (a/pressure-events-into! parts (cast i32 i) (mut index) (mut actual))
          (for [reg 0 (cast i64 registers)]
            (when (or (!= (get (.fixed-at expected) reg)
                          (get (.fixed-at actual) reg))
                      (!= (get (.free expected) reg) (get (.free actual) reg))
                      (!= (get (.next-use expected) reg)
                          (get (.next-use actual) reg)))
              (set! failures (+ failures 1))))
          (a/release-pressure! (mut expected)))))
    (a/release-pressure! (mut actual))
    failures))

(defn check-events [(seed i64) (registers i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut events) (ArrayList::new [f/Event] allocator)
        (mut failures) 0]
    (for [i 0 16]
      (let [(mut part) (a/create (cast i32 i) allocator)
            start (% (+ (* i 7) seed) 32)]
        (range/add! (mut (.ranges part)) start (+ start 8))
        (range/add! (mut (.ranges part)) (+ start 16) (+ start 32))
        (for [j 0 12]
          (let [position (+ (* j 5) (% (+ seed i) 4))
                reg (cast i32 (% (+ i j) (cast i64 registers)))]
            (assert (c/add! (mut (.uses part)) position 2 reg))
            (push! (mut events)
                   (f/Event
                     :position position
                     :register reg
                     :owner (cast i32 i)))))
        (push! (mut parts) part)))
    ; Incoming long reservations and call reservations share the same virtual
    ; parent -1; exclusion must still use the exact split-part identity.
    (assert (a/reserve! (mut parts) 0 3 47 allocator))
    (push! (mut events)
           (f/Event
             :position 3
             :register 0
             :owner 16))
    (assert (a/reserve! (mut parts) (- registers 1) 9 10 allocator))
    (push! (mut events)
           (f/Event
             :position 9
             :register (- registers 1)
             :owner 17))
    (match (f/create (len parts) registers (slice events) allocator)
      (Err [message] (panic "{}" message))
      (Ok [built]
          (let [(mut index) built]
            (set! failures
                  (+ failures (compare-events parts (mut index) registers)))
            (for [round 0 2]
              (let [count (len parts)]
                (for [i 0 count]
                  (when (> (len (.ranges (get parts i))) 0)
                    (let [cut
                            (+ (.start (get (.ranges (get parts i)) 0))
                               (if (= (% (+ i round) 2) 0) 4 20))
                          child (a/split! (elem (mut parts) i) cut allocator)
                          child-id (cast i32 (len parts))]
                      (push! (mut parts) child)
                      (assert (f/split! (mut index) (cast i32 i) child-id cut))))))
              (set! failures
                    (+ failures (compare-events parts (mut index) registers))))
            (f/release! (mut index)))))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (free! (mut events))
    failures))

(defn compare-state [(parts (ArrayList a/Part))
                     (part i32)
                     (events (mut f/Index))
                     (state (mut a/AssignedIndex))
                     (actual (mut a/Pressure))
                     (registers i32)] (-> i64)
  (let [(mut expected) (a/pressure parts part registers (malloc-allocator))
        (mut failures) 0]
    (assert (a/pressure-state-into! parts
                                    part
                                    (mut events)
                                    (mut state)
                                    (mut actual)))
    (for [reg 0 (cast i64 registers)]
      (when (or (!= (get (.free expected) reg) (get (.free actual) reg))
                (!= (get (.next-use expected) reg) (get (.next-use actual) reg))
                (!= (get (.fixed-at expected) reg) (get (.fixed-at actual) reg)))
        (println "assigned query part={} reg={} free {}/{} next {}/{} fixed {}/{}"
                 part
                 reg
                 (get (.free expected) reg)
                 (get (.free actual) reg)
                 (get (.next-use expected) reg)
                 (get (.next-use actual) reg)
                 (get (.fixed-at expected) reg)
                 (get (.fixed-at actual) reg))
        (set! failures (+ failures 1))))
    (a/release-pressure! (mut expected))
    failures))

(defn check-assigned [(seed i64) (registers i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut order) (ArrayList::new [queue/Item] allocator)
        (mut pressure) (a/pressure-buffer registers allocator)
        (mut failures) 0]
    (for [i 0 24]
      (let [(mut part) (a/create (cast i32 i) allocator)
            start (% (+ (* i 7) seed) 32)]
        (range/add! (mut (.ranges part)) start (+ start 4))
        (range/add! (mut (.ranges part)) (+ start 16) (+ start 30))
        (when (= (% i 3) 0)
          (set! (.register part) (cast i32 (% i (cast i64 registers)))))
        (for [j 0 12]
          (assert (c/add! (mut (.uses part))
                          (+ (* j 9) (% (+ seed i) 4))
                          2
                          (cast i32 (% (+ i j) (cast i64 registers))))))
        (push! (mut parts) part)))
    (assert (a/reserve! (mut parts) 0 0 200 allocator))
    (assert (a/reserve! (mut parts) (- registers 1) 0 17 allocator))
    (for [i 0 24]
      (assert (a/reserve! (mut parts)
                          (cast i32 (% i (cast i64 registers)))
                          (+ (* i 4) 3)
                          (+ (* i 4) 4)
                          allocator)))
    (let [(mut unusual) (a/create -1 allocator)]
      (set! (.register unusual) (- registers 1))
      (range/add! (mut (.ranges unusual)) 3 19)
      (range/add! (mut (.ranges unusual)) 40 60)
      (assert (c/add! (mut (.uses unusual)) 0 2 (- registers 1)))
      (push! (mut parts) unusual))
    (let [(mut later) (a/create 24 allocator)]
      (range/add! (mut (.ranges later)) 100 140)
      (push! (mut parts) later))
    (for [i 0 (len parts)]
      (queue/insert! (mut order)
                     (queue/Item
                       :position (.start (at (.ranges (at parts i)) 0))
                       :interval (cast i32 i))))
    (match (a/event-index parts registers allocator)
      (Err [message] (panic "{}" message))
      (Ok [built]
          (let [(mut events) built]
            (match (a/assigned-index parts registers allocator)
              (Err [message] (panic "{}" message))
              (Ok [built-state]
                  (let [(mut state) built-state]
                    (while (> (len order) 0)
                      (match (queue/take! (mut order))
                        (None [] (panic "missing query"))
                        (Some [item]
                              (for [repeat 0 2]
                                (set! failures
                                      (+ failures
                                         (compare-state parts
                                                        (.interval item)
                                                        (mut events)
                                                        (mut state)
                                                        (mut pressure)
                                                        registers)))))))
                    (a/release-assigned! (mut state)))))
            (f/release! (mut events)))))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (free! (mut order))
    (a/release-pressure! (mut pressure))
    failures))

(defn assigned-mutations [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut part) (a/create 0 allocator)
        (mut area) (frame/create allocator)
        (mut work) (ArrayList::new [queue/Item] allocator)
        (mut pressure) (a/pressure-buffer 1 allocator)
        (mut failures) 0]
    (set! (.register part) 0)
    (range/add! (mut (.ranges part)) 0 100)
    (assert (c/add! (mut (.uses part)) 10 1 -1))
    (assert (c/add! (mut (.uses part)) 50 2 0))
    (assert (c/add! (mut (.uses part)) 90 1 -1))
    (assert (c/add! (mut (.uses part)) 130 2 0))
    (push! (mut parts) part)
    (for start [(: 5 i64) 12 120]
      (let [(mut probe) (a/create (cast i32 (len parts)) allocator)]
        (range/add! (mut (.ranges probe))
                    start
                    (+ start (if (= start 120) 20 3)))
        (push! (mut parts) probe)))
    (match (a/event-index parts 1 allocator)
      (Err [message] (panic "{}" message))
      (Ok [built]
          (let [(mut events) built]
            (match (a/assigned-index parts 1 allocator)
              (Err [message] (panic "{}" message))
              (Ok [built-state]
                  (let [(mut state) built-state]
                    (set! failures
                          (+ failures
                             (compare-state parts
                                            1
                                            (mut events)
                                            (mut state)
                                            (mut pressure)
                                            1)))
                    (match (a/evict-tracked! (mut parts)
                                             (mut work)
                                             0
                                             5
                                             (mut area)
                                             8
                                             8
                                             allocator
                                             (cast (ptr f/Index) (mut events)))
                      (Err [message] (panic "{}" message))
                      (Ok [_] 0))
                    (assert (= (len parts) 6))
                    (set! failures
                          (+ failures
                             (compare-state parts
                                            1
                                            (mut events)
                                            (mut state)
                                            (mut pressure)
                                            1)))
                    (set! failures
                          (+ failures
                             (compare-state parts
                                            5
                                            (mut events)
                                            (mut state)
                                            (mut pressure)
                                            1)))
                    (assert (a/grant-free-tracked! (mut parts)
                                                   (mut work)
                                                   5
                                                   (.free pressure)
                                                   1
                                                   allocator
                                                   (cast (ptr f/Index)
                                                         (mut events))))
                    (a/note-assigned! (mut state) 5)
                    (set! failures
                          (+ failures
                             (compare-state parts
                                            2
                                            (mut events)
                                            (mut state)
                                            (mut pressure)
                                            1)))
                    (set! failures
                          (+ failures
                             (compare-state parts
                                            3
                                            (mut events)
                                            (mut state)
                                            (mut pressure)
                                            1)))
                    (assert (= (len (.live state)) 0))
                    (a/release-assigned! (mut state)))))
            (f/release! (mut events)))))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (free! (mut work))
    (a/release-pressure! (mut pressure))
    (frame/release! (mut area))
    failures))

;;; Exercise each solver mutation, including eviction's nested spill split.
(defn tracked-splits [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut part) (a/create 0 allocator)
        (mut probe) (a/create 1 allocator)
        (mut area) (frame/create allocator)
        (mut work) (ArrayList::new [queue/Item] allocator)
        (mut summary) (a/pressure-buffer 1 allocator)
        (mut failures) 0]
    (range/add! (mut (.ranges part)) 0 100)
    (assert (c/add! (mut (.uses part)) 10 1 -1))
    (assert (c/add! (mut (.uses part)) 50 2 0))
    (assert (c/add! (mut (.uses part)) 90 1 -1))
    (assert (c/add! (mut (.uses part)) 130 2 0))
    (range/add! (mut (.ranges probe)) 120 140)
    (push! (mut parts) part)
    (push! (mut parts) probe)
    (match (a/event-index parts 1 allocator)
      (Err [message] (panic "{}" message))
      (Ok [built]
          (let [(mut index) built]
            (set! failures (+ failures (compare-events parts (mut index) 1)))
            (set! (mut (.free summary)) 0 30)
            (assert (a/grant-free-tracked! (mut parts)
                                           (mut work)
                                           0
                                           (.free summary)
                                           1
                                           allocator
                                           (cast (ptr f/Index) (mut index))))
            (set! failures (+ failures (compare-events parts (mut index) 1)))
            (match (a/spill-prefix-tracked! (mut parts)
                                            (mut work)
                                            2
                                            (mut area)
                                            8
                                            8
                                            allocator
                                            (cast (ptr f/Index) (mut index)))
              (Err [message] (panic "{}" message))
              (Ok [_] 0))
            (set! failures (+ failures (compare-events parts (mut index) 1)))
            (match (a/evict-tracked! (mut parts)
                                     (mut work)
                                     0
                                     5
                                     (mut area)
                                     8
                                     8
                                     allocator
                                     (cast (ptr f/Index) (mut index)))
              (Err [message] (panic "{}" message))
              (Ok [_] 0))
            (assert (= (len parts) 6))
            (set! failures (+ failures (compare-events parts (mut index) 1)))
            (f/release! (mut index)))))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (free! (mut work))
    (a/release-pressure! (mut summary))
    (frame/release! (mut area))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) (+ (tracked-splits) (assigned-mutations))]
    (for registers [(: 1 i32) 4 16 64]
      (for [seed 0 16]
        (set! failures (+ failures (check-assigned seed registers)))
        (set! failures (+ failures (check-events seed registers))))
      (for [seed 0 64] (set! failures (+ failures (check seed registers)))))
    (println "indexed pressure oracle checks: {} failures" failures)
    (if (= failures 0) 0 1)))
