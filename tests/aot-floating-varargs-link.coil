(module stogir.tests.aot-floating-varargs-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(extern snprintf :cc (cc/C) [(ptr u8) u64 (ptr i8) ...] (-> i32))

(extern entry
        :as
        "stogir_fp_varargs"
        :cc
        (cc/C)
        [u64 (ptr u8) (ptr i8) f64 f32]
        (-> i32))

(defn main [] (-> i64)
  (let [(mut output) (ArrayList::new [u8] (malloc-allocator))
        target
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of snprintf)))
        expected "1.25 -2.50 -1"
        (mut i) 0
        (mut failures) 0]
    (while (< i 128) (push! (mut output) 0) (set! i (+ i 1)))
    (when (!= (entry target (.data output) c"%.2f %.2f %d" 1.25 (: -2.5 f32))
              (cast i32 (len expected)))
      (set! failures (+ failures 1)))
    (set! i 0)
    (while (< i (len expected))
      (when (!= (get output i) (get expected i)) (set! failures (+ failures 1)))
      (set! i (+ i 1)))
    (free! (mut output))
    (println "linked float variadic promotion: {} failures" failures)
    (if (= failures 0) 0 1)))
