(module stogir.tests.aot-varargs-link)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern snprintf :cc (cc/C) [(ptr u8) u64 (ptr i8) ...] (-> i32))

(extern stogir.varargs-test
        :as
        "stogir_varargs_test"
        :cc
        (cc/C)
        [u64 (ptr u8) (ptr i8) i32 i64]
        (-> i32))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        address
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of snprintf)))
        (mut actual) (ArrayList::new [u8] allocator)
        (mut expected) (ArrayList::new [u8] allocator)
        (mut i) 0
        (mut failures) 0]
    (while (< i 128)
      (push! (mut actual) 0)
      (push! (mut expected) 0)
      (set! i (+ i 1)))
    (for x [(: -2147483648 i32) -100 -1 0 1 100 2147483647]
      (for y [(: -9223372036854775808 i64) -100 -1 0 1 100 9223372036854775807]
        (let [reference (snprintf (elem (mut expected) 0) 128 c"%d|%lld" x y)
              result
                (stogir.varargs-test address
                                     (elem (mut actual) 0)
                                     c"%d|%lld"
                                     x
                                     y)]
          (when (!= reference result) (set! failures (+ failures 1)))
          (set! i 0)
          (while (< i 128)
            (when (!= (get actual i) (get expected i))
              (set! failures (+ failures 1)))
            (set! i (+ i 1))))))
    (free! (mut actual))
    (free! (mut expected))
    (println "linked AOT variadic call checks: {} failures" failures)
    (if (= failures 0) 0 1)))
