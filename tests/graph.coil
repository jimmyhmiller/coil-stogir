(module stogir.tests.graph)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Some None])

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        (mut failures) 0
        (mut i) (: 1 i32)]
    (when (g/contains? graph 0) (set! failures (+ failures 1)))
    (when (g/contains? graph -2147483648) (set! failures (+ failures 1)))
    (while (<= i 4096)
      (match (g/append! (mut graph) (n/make 26 11 0 i 0 0))
        (Some [r] (when (!= r i) (set! failures (+ failures 1))))
        (None [] (set! failures (+ failures 1))))
      (match (g/append-constant! (mut graph) (n/constant 11 11 0 (cast u64 i)))
        (Some [r] (when (!= r (- 0 i)) (set! failures (+ failures 1))))
        (None [] (set! failures (+ failures 1))))
      (set! i (+ i 1)))
    (set! i 1)
    (while (<= i 4096)
      (match (g/lookup graph i)
        (Some [v] (when (!= (.op1 v) i) (set! failures (+ failures 1))))
        (None [] (set! failures (+ failures 1))))
      (match (g/lookup graph (- 0 i))
        (Some [v]
              (when (!= (n/constant-bits v) (cast u64 i))
                (set! failures (+ failures 1))))
        (None [] (set! failures (+ failures 1))))
      (set! i (+ i 1)))
    (when (g/contains? graph 4097) (set! failures (+ failures 1)))
    (when (g/contains? graph -4097) (set! failures (+ failures 1)))
    (g/release! (mut graph))
    (println "graph checks: {} failures" failures)
    (if (= failures 0) 0 1)))
