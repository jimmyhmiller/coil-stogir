(module stogir.tests.zext-known-zero)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.options" :as options)
(import "stogir.a64.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))

(defn word [(text (slice u8)) (i i64)] (-> u32)
  (| (cast u32 (get text i))
     (<< (cast u32 (get text (+ i 1))) 8)
     (<< (cast u32 (get text (+ i 2))) 16)
     (<< (cast u32 (get text (+ i 3))) 24)))

;;; UBFX Xd, Xn, #0, #32 (UBFM Xd, Xn, #0, #31).
(defn zero-extend? [(w u32)] (-> bool)
  (= (& w (: 0xFFFFFC00 u32)) (: 0xD3407C00 u32)))

;;; ZEXT of a merge of a 32-bit load and a 32-bit AND needs no UBFX: both W
;;; writes cleared the upper bits. When one arm is a 32-bit parameter, whose
;;; upper bits the ABI leaves unspecified, the extension remains.
(defn fixture [(parameter-arm bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        address (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        raw (require (b/emit! (mut graph) 71 4 [start (: 0 i32) 1]))
        which (require (b/emit! (mut graph) 71 1 [start (: 0 i32) 2]))
        mask (require (b/scalar-constant! (mut graph) 4 0xFF00 8))
        split (require (b/emit! (mut graph) 116 0 [start which]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        loaded (require (b/emit! (mut graph) 91 4 [yes address]))
        masked (require (b/emit! (mut graph) 47 4 [raw mask]))
        left (require (b/emit! (mut graph) 114 0 [loaded]))
        right (require (b/emit! (mut graph) 114 0 [no]))
        merge (require (b/emit! (mut graph) 112 0 [left right]))
        phi (require (b/emit! (mut graph) 67 4 [merge loaded (if parameter-arm raw masked)]))
        widened (require (b/emit! (mut graph) 34 5 [phi]))
        ret (require (b/emit! (mut graph) 120 5 [merge widened (: 0 i32)]))]
    (match (compile/image-with-options graph start [ret] "_zext_known"
                                       (options/Options :level 1) a)
      (Err [e] (panic "{}" e))
      (Ok [code]
          (let [(mut code) code
                text (slice (.text code))
                (mut extensions) 0]
            (for [i 0 (/ (len text) 4)]
              (when (zero-extend? (word text (* i 4))) (set! extensions (+ extensions 1))))
            (if parameter-arm (assert (> extensions 0)) (assert (= extensions 0)))
            (match (jit/map-image code a)
              (Err [e] (panic "{}" e))
              (Ok [mapped]
                  (let [(mut mapped) mapped
                        f (p/cast (fnptr (cc/C) [(ptr u32) u64 bool] u64) (.base (.memory mapped)))
                        (mut cell) (ArrayList::new [u32] a)]
                    (push! (mut cell) 0xFFFFFFF0)
                    ; Garbage above bit 31 in the parameter must not survive ZEXT.
                    (let [raw (: 0xABCD00001234FF77 u64)]
                      (assert (= (f (.data cell) raw true) 0xFFFFFFF0))
                      (assert (= (f (.data cell) raw false)
                                 (if parameter-arm (: 0x1234FF77 u64) 0xFF00))))
                    (free! (mut cell))
                    (jit/release-image! (mut mapped)))))
            (image/release! (mut code)))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (fixture false)
  (fixture true)
  (println "ZEXT of known zero-extended merges is a register view")
  0)
