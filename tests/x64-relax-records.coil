(module stogir.tests.x64-relax-records)
(import "stogir.text-data" :as text-data)
(import "stogir.x64.code" :as code)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.fixups" :as fixups)
(import "stogir.x64.testing" :as t)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

;;; Branch relaxation and alignment padding (stogir.x64.fixups/relax!) on
;;; synthetic text, checked against an independent model.
;;;
;;; A program is a list of items: filler bytes, `jmp`, `jcc`, `lea` of a
;;; label, a jump table, inline data. Item i starts at label i; some labels
;;; ask for loop alignment. The pass runs on the real records; the model
;;; below decides the same layout with plain quadratic loops over item
;;; indices (no offsets, no trees) and builds the expected text byte by
;;; byte: every filler byte in place, every branch in the predicted form
;;; with the displacement that reaches its target item, every table word,
;;; every padding byte. Labels, references, data ranges and table records
;;; are compared with the model's offsets as well. Runs on any host: nothing
;;; is executed.

(const FILLER 0)
(const JMP 1)
(const JCC 2)
(const LEA 3)
(const TABLE 4)
(const DATA 5)

;;; `size` is the long size. `target` is an item index (a label); a table's
;;; targets are `targets[target .. target + count)`. `aligned` asks for loop
;;; alignment of this item's label. `inner` is the offset of a reference
;;; field inside a filler, or -1.
(defstruct Item
  [(kind i32) (size i64) (target i64) (count i64) (cc i32) (aligned bool) (inner i64)])

(defstruct Program [(items (ArrayList Item)) (targets (ArrayList i64)) (seed u64)])

(defn below [(state (mut u64)) (bound i64)] (-> i64)
  (cast i64 (% (t/random! (mut state)) (cast u64 bound))))

;;; A random program of `count` items. `dense` makes the fillers short, so
;;; that most displacements are near the rel8 limits.
(defn generate [(seed u64) (count i64) (dense bool) (a (dyn Allocator))] (-> Program)
  (let [(mut state) seed
        (mut items) (ArrayList::new [Item] a)
        (mut targets) (ArrayList::new [i64] a)]
    (for [i 0 count]
      (let [roll (below (mut state) 100)
            reach (if dense 14 40)
            ; Mostly near targets, some anywhere.
            near (if (< (below (mut state) 10) 8)
                     (let [delta (- (below (mut state) (* reach 2)) reach)
                           raw (+ i delta)]
                       (if (< raw 0) 0 (if (> raw count) count raw)))
                     (below (mut state) (+ count 1)))
            aligned (< (below (mut state) 100) 12)]
        (cond (< roll 30)
                (push! (mut items)
                       (Item :kind FILLER
                             :size (+ 1 (below (mut state) (if dense 12 60)))
                             :target 0 :count 0 :cc 0 :aligned aligned :inner -1))
              (< roll 34)
                (let [size (+ 4 (below (mut state) 30))]
                  (push! (mut items)
                         (Item :kind FILLER :size size :target 0 :count 0 :cc 0
                               :aligned aligned :inner (below (mut state) (- size 3)))))
              (< roll 60)
                (push! (mut items)
                       (Item :kind JMP :size 5 :target near :count 0 :cc 0 :aligned aligned
                             :inner -1))
              (< roll 92)
                (push! (mut items)
                       (Item :kind JCC :size 6 :target near :count 0
                             :cc (cast i32 (below (mut state) 16)) :aligned aligned :inner -1))
              (< roll 95)
                (push! (mut items)
                       (Item :kind LEA :size 7 :target near :count 0 :cc 0 :aligned aligned
                             :inner -1))
              (< roll 98)
                (let [entries (+ 1 (below (mut state) 6))]
                  (push! (mut items)
                         (Item :kind TABLE :size (* entries 4) :target (len targets)
                               :count entries :cc 0 :aligned false :inner -1))
                  (for [k 0 entries] (push! (mut targets) (below (mut state) (+ count 1)))))
              :else
                (push! (mut items)
                       (Item :kind DATA :size (+ 1 (below (mut state) 9)) :target 0 :count 0
                             :cc 0 :aligned false :inner -1)))))
    (Program :items items :targets targets :seed seed)))

(defn release! [(program (mut Program))] (-> void)
  (free! (mut (.items program)))
  (free! (mut (.targets program))))

;;; The byte of filler or data item `item` at `position`: a function of the
;;; item, so a byte copied from the wrong place shows.
(defn filler [(seed u64) (item i64) (position i64)] (-> u8)
  (cast u8 (& (+ (* (cast u64 item) 131) (* (cast u64 position) 17) seed) 255)))

;;; What the pass is given.
(defstruct Built
  [(buffer code/Buffer)
   (labels (ArrayList i64))
   (branches (ArrayList fixups/Branch))
   (relatives (ArrayList fixups/Relative))
   (alignments (ArrayList fixups/Alignment))])

(defn release-built! [(built (mut Built))] (-> void)
  (code/release! (mut (.buffer built)))
  (free! (mut (.labels built)))
  (free! (mut (.branches built)))
  (free! (mut (.relatives built)))
  (free! (mut (.alignments built))))

(defn must [(result (Result i32 (slice u8)))] (-> void)
  (match result
    (Ok [_] 0)
    (Err [message] (panic "relax test construction: {}" message))))

;;; Emit the program in its long forms with every record. Label i is item
;;; i's start and label `count` the end of the text; table k (in item order)
;;; has no label of its own: its base is its item's label.
(defn build [(program Program) (a (dyn Allocator))] (-> Built)
  (let [(mut built) (Built :buffer (code/create a)
                           :labels (ArrayList::new [i64] a)
                           :branches (ArrayList::new [fixups/Branch] a)
                           :relatives (ArrayList::new [fixups/Relative] a)
                           :alignments (ArrayList::new [fixups/Alignment] a))]
    (for [i 0 (len (.items program))]
      (let [item (get (.items program) i)
            start (len (.text (.buffer built)))]
        (push! (mut (.labels built)) start)
        (when (.aligned item)
          (push! (mut (.alignments built)) (fixups/loop-alignment (cast i32 i))))
        (cond (or (= (.kind item) FILLER) (= (.kind item) DATA))
                (do
                  (for [k 0 (.size item)]
                    (push! (mut (.text (.buffer built))) (filler (.seed program) i k)))
                  (when (>= (.inner item) 0)
                    (push! (mut (.references (.buffer built)))
                           (code/Reference :offset (+ start (.inner item)) :kind 5
                                           :target -1 :addend -4)))
                  (when (= (.kind item) DATA)
                    (push! (mut (.text-data (.buffer built)))
                           (text-data/Range :offset start :length (.size item) :kind 1))))
              (= (.kind item) JMP)
                (must (fixups/jump! (mut (.buffer built)) (mut (.branches built))
                                    (cast i32 (.target item)) fixups/JUMP))
              (= (.kind item) JCC)
                (must (fixups/jump! (mut (.buffer built)) (mut (.branches built))
                                    (cast i32 (.target item)) (.cc item)))
              (= (.kind item) LEA)
                (must (fixups/address! (mut (.buffer built)) (mut (.branches built))
                                       (cast i32 (.target item)) 11))
              :else
                (do
                  (push! (mut (.alignments built))
                         (fixups/Alignment :label (cast i32 i) :boundary 4 :limit 3
                                           :loop false))
                  (for [k 0 (.count item)]
                    (push! (mut (.relatives built))
                           (fixups/Relative
                             :offset (len (.text (.buffer built)))
                             :base start
                             :label (cast i32 (get (.targets program) (+ (.target item) k)))))
                    (for [b 0 4] (push! (mut (.text (.buffer built))) 0)))
                  (push! (mut (.text-data (.buffer built)))
                         (text-data/Range :offset start :length (.size item) :kind 4))))))
    (push! (mut (.labels built)) (len (.text (.buffer built))))
    built))

;;; The model's layout: per item its form and its offset behind any padding;
;;; `pads[i]` is the padding in front of item i; the last offset is the end.
(defstruct Layout [(short (ArrayList bool)) (offsets (ArrayList i64)) (pads (ArrayList i64))])

(defn branch? [(item Item)] (-> bool)
  (or (= (.kind item) JMP) (= (.kind item) JCC)))

;;; The alignment of item i's label: boundary and limit, or boundary 0 when
;;; there is none. A loop request stands when a jump at or behind the item
;;; targets it; a table is always aligned to 4.
(defstruct Wanted [(boundary i64) (limit i64)])

(defn wanted [(program Program) (i i64)] (-> Wanted)
  (let [item (get (.items program) i)
        (mut back) false]
    (when (.aligned item)
      (for [k i (len (.items program))]
        (let [other (get (.items program) k)]
          (when (and (branch? other) (= (.target other) i)) (set! back true)))))
    (cond (= (.kind item) TABLE) (Wanted :boundary 4 :limit 3)
          back (Wanted :boundary 16 :limit 10)
          :else (Wanted :boundary 0 :limit 0))))

(defn model [(program Program) (a (dyn Allocator))] (-> Layout)
  (let [count (len (.items program))
        (mut wants) (ArrayList::new [Wanted] a)
        (mut short) (ArrayList::new [bool] a)
        (mut offsets) (ArrayList::new [i64] a)
        (mut pads) (ArrayList::new [i64] a)
        (mut unpadded) (ArrayList::new [i64] a)
        (mut changed) true]
    (for [i 0 count]
      (push! (mut short) false)
      (push! (mut pads) 0)
      (push! (mut wants) (wanted program i)))
    (for [i 0 (+ count 1)] (push! (mut offsets) 0) (push! (mut unpadded) 0))
    (while changed
      (set! changed false)
      (let [(mut at) (: 0 i64)]
        (for [i 0 count]
          (set! (mut unpadded) i at)
          (set! at (+ at (if (get short i) 2 (.size (get (.items program) i))))))
        (set! (mut unpadded) count at))
      (for [i 0 count]
        (let [item (get (.items program) i)]
          (when (and (branch? item) (not (get short i)))
            (let [forward (> (.target item) i)
                  (mut slack) (: 0 i64)]
              (if forward
                  (for [j (+ i 1) (+ (.target item) 1)]
                    (when (< j count) (set! slack (+ slack (.limit (get wants j))))))
                  (for [j (+ (.target item) 1) (+ i 1)]
                    (set! slack (+ slack (.limit (get wants j))))))
              (when (if forward
                        (<= (+ (- (get unpadded (.target item))
                                  (+ (get unpadded i) (.size item)))
                               slack)
                            127)
                        (>= (- (- (get unpadded (.target item)) (+ (get unpadded i) 2))
                               slack)
                            -128))
                (set! (mut short) i true)
                (set! changed true)))))))
    (let [(mut at) (: 0 i64)]
      (for [i 0 count]
        (let [want (get wants i)
              needed (if (> (.boundary want) 0)
                         (% (- (.boundary want) (% at (.boundary want))) (.boundary want))
                         0)
              pad (if (> needed (.limit want)) 0 needed)]
          (set! (mut pads) i pad)
          (set! at (+ at pad))
          (set! (mut offsets) i at)
          (set! at (+ at (if (get short i) 2 (.size (get (.items program) i)))))))
      (set! (mut offsets) count at))
    (free! (mut unpadded))
    (free! (mut wants))
    (Layout :short short :offsets offsets :pads pads)))

(defn word! [(out (mut (ArrayList u8))) (value i64)] (-> void)
  (for [i 0 4] (push! (mut out) (cast u8 (& (>> value (* i 8)) 255)))))

;;; The text the model expects.
(defn expected [(program Program) (layout Layout) (a (dyn Allocator))] (-> (ArrayList u8))
  (let [(mut out) (ArrayList::new [u8] a)]
    (for [i 0 (len (.items program))]
      (let [item (get (.items program) i)
            (mut pad) (get (.pads layout) i)
            target (if (= (.kind item) TABLE) 0 (get (.offsets layout) (.target item)))]
        (while (> pad 0)
          (let [piece (if (> pad 9) 9 pad)]
            (match (encode/nop (mut out) (cast i32 piece))
              (Err [message] (panic "{}" message))
              (Ok [_] 0))
            (set! pad (- pad piece))))
        (when (!= (len out) (get (.offsets layout) i)) (panic "model offsets disagree"))
        (cond (or (= (.kind item) FILLER) (= (.kind item) DATA))
                (for [k 0 (.size item)] (push! (mut out) (filler (.seed program) i k)))
              (and (= (.kind item) JMP) (get (.short layout) i))
                (do (push! (mut out) 0xEB)
                    (push! (mut out) (cast u8 (& (- target (+ (len out) 1)) 255))))
              (= (.kind item) JMP)
                (do (push! (mut out) 0xE9)
                    (word! (mut out) (- target (+ (len out) 4))))
              (and (= (.kind item) JCC) (get (.short layout) i))
                (do (push! (mut out) (cast u8 (+ 0x70 (.cc item))))
                    (push! (mut out) (cast u8 (& (- target (+ (len out) 1)) 255))))
              (= (.kind item) JCC)
                (do (push! (mut out) 0x0F)
                    (push! (mut out) (cast u8 (+ 0x80 (.cc item))))
                    (word! (mut out) (- target (+ (len out) 4))))
              (= (.kind item) LEA)
                (do (push! (mut out) 0x4C) (push! (mut out) 0x8D) (push! (mut out) 0x1D)
                    (word! (mut out) (- target (+ (len out) 4))))
              :else
                (for [k 0 (.count item)]
                  (word! (mut out)
                         (- (get (.offsets layout) (get (.targets program) (+ (.target item) k)))
                            (get (.offsets layout) i)))))))
    out))

(defn note! [(tally (mut t/Tally)) (ok bool) (label (slice u8)) (seed u64)] (-> void)
  (set! (.checks tally) (+ (.checks tally) 1))
  (unless ok
    (when (< (.failures tally) 20) (println "{} (seed {:x})" label seed))
    (t/fail! (mut tally))))

;;; Run the pass on `program` and compare everything with the model.
;;; Returns the number of short branches.
(defn check! [(tally (mut t/Tally)) (program Program) (a (dyn Allocator))] (-> i64)
  (let [(mut built) (build program a)
        (mut layout) (model program a)
        (mut want) (expected program layout a)
        seed (.seed program)
        original (len (.text (.buffer built)))
        (mut shorts) (: 0 i64)]
    (set! (.functions tally) (+ (.functions tally) 1))
    (match (fixups/relax! (mut (.buffer built)) (mut (.labels built)) (mut (.branches built))
                          (mut (.relatives built)) (.alignments built))
      (Err [message] (println "relax: {} (seed {:x})" message seed) (t/fail! (mut tally)))
      (Ok [removed]
          (match (fixups/apply! (mut (.text (.buffer built))) (.labels built) (.branches built))
            (Err [message] (println "apply: {} (seed {:x})" message seed) (t/fail! (mut tally)))
            (Ok [_] 0))
          (match (fixups/apply-relative! (mut (.text (.buffer built))) (.labels built)
                                         (.relatives built))
            (Err [message] (println "tables: {} (seed {:x})" message seed)
                 (t/fail! (mut tally)))
            (Ok [_] 0))
          (match (fixups/verify (.text (.buffer built)) (.labels built) (.branches built)
                                (.relatives built))
            (Err [message] (println "verify: {} (seed {:x})" message seed) (t/fail! (mut tally)))
            (Ok [_] 0))
          (let [text (.text (.buffer built))
                (mut same) (= (len text) (len want))]
            (when same
              (for [i 0 (len want)]
                (when (!= (get text i) (get want i)) (set! same false))))
            (note! (mut tally) same "text differs from the model" seed))
          ; Every label is its item's offset behind the padding.
          (let [(mut ok) (= (len (.labels built)) (+ (len (.items program)) 1))]
            (when ok
              (for [i 0 (len (.labels built))]
                (when (!= (get (.labels built) i) (get (.offsets layout) i)) (set! ok false))))
            (note! (mut tally) ok "labels differ from the model" seed))
          ; References, data ranges and table records, in item order.
          (let [(mut reference) (: 0 i64)
                (mut range) (: 0 i64)
                (mut relative) (: 0 i64)
                (mut ok) true]
            (for [i 0 (len (.items program))]
              (let [item (get (.items program) i)
                    start (get (.offsets layout) i)]
                (when (>= (.inner item) 0)
                  (unless (and (< reference (len (.references (.buffer built))))
                               (= (.offset (get (.references (.buffer built)) reference))
                                  (+ start (.inner item))))
                    (set! ok false))
                  (set! reference (+ reference 1)))
                (when (or (= (.kind item) DATA) (= (.kind item) TABLE))
                  (unless (and (< range (len (.text-data (.buffer built))))
                               (= (.offset (get (.text-data (.buffer built)) range)) start)
                               (= (.length (get (.text-data (.buffer built)) range))
                                  (.size item)))
                    (set! ok false))
                  (set! range (+ range 1)))
                (when (= (.kind item) TABLE)
                  (when (!= (% start 4) 0) (set! ok false))
                  (for [k 0 (.count item)]
                    (unless (and (< relative (len (.relatives built)))
                                 (= (.offset (get (.relatives built) relative))
                                    (+ start (* k 4)))
                                 (= (.base (get (.relatives built) relative)) start))
                      (set! ok false))
                    (set! relative (+ relative 1))))))
            (note! (mut tally) ok "references, data ranges or table records misplaced" seed))
          (match (text-data/validate (.text-data (.buffer built)) (len (.text (.buffer built))))
            (Err [message] (note! (mut tally) false "data ranges invalid after relaxation" seed))
            (Ok [_] 0))
          (note! (mut tally) (= removed (- original (len want)))
                 "reported size change is wrong" seed)
          (for [i 0 (len (.items program))]
            (when (get (.short layout) i) (set! shorts (+ shorts 1))))))
    (free! (mut want))
    (free! (mut (.short layout)))
    (free! (mut (.offsets layout)))
    (free! (mut (.pads layout)))
    (release-built! (mut built))
    shorts))

;;; A chain in which every jump's short form depends on the others being
;;; short: `count` forward jumps to the end, then `count` backward jumps to
;;; the start, with filler sized so that the outermost jumps fit rel8 only
;;; once every jump between them and their target has shrunk.
(defn chain! [(tally (mut t/Tally)) (count i64) (conditional bool) (a (dyn Allocator))]
  (-> void)
  (let [(mut items) (ArrayList::new [Item] a)
        long (if conditional 6 5)
        ; Forward: the first jump spans count-1 short jumps and the filler.
        gap (- 127 (* (- count 1) 2))
        ; Backward: the last jump spans the filler and count short jumps.
        back-gap (- 128 (* count 2))]
    ; Items 0..count-1 jump to item count+1 (the filler's end).
    (for [i 0 count]
      (push! (mut items)
             (Item :kind (if conditional JCC JMP) :size long :target (+ count 1) :count 0
                   :cc 5 :aligned false :inner -1)))
    (push! (mut items)
           (Item :kind FILLER :size gap :target 0 :count 0 :cc 0 :aligned false :inner -1))
    ; Item count+1: filler, then the backward jumps to it.
    (push! (mut items)
           (Item :kind FILLER :size back-gap :target 0 :count 0 :cc 0 :aligned false :inner -1))
    (for [i 0 count]
      (push! (mut items)
             (Item :kind (if conditional JCC JMP) :size long :target (+ count 1) :count 0
                   :cc 4 :aligned false :inner -1)))
    (let [(mut program) (Program :items items :targets (ArrayList::new [i64] a) :seed 7)
          shorts (check! (mut tally) program a)]
      (note! (mut tally) (= shorts (* count 2)) "a dependent chain did not shrink completely"
             (cast u64 count))
      (release! (mut program)))
    ; One byte more of filler and the first jump is out of reach whatever
    ; the others do; every later one still fits.
    (let [(mut items) (ArrayList::new [Item] a)]
      (for [i 0 count]
        (push! (mut items)
               (Item :kind (if conditional JCC JMP) :size long :target (+ count 1) :count 0
                     :cc 5 :aligned false :inner -1)))
      (push! (mut items)
             (Item :kind FILLER :size (+ gap 1) :target 0 :count 0 :cc 0 :aligned false
                   :inner -1))
      (push! (mut items)
             (Item :kind FILLER :size 1 :target 0 :count 0 :cc 0 :aligned false :inner -1))
      (let [(mut program) (Program :items items :targets (ArrayList::new [i64] a) :seed 9)
            shorts (check! (mut tally) program a)]
        (note! (mut tally) (= shorts (- count 1)) "an out-of-reach jump was shrunk"
               (cast u64 count))
        (release! (mut program))))))

;;; Padding followed by jumps: an aligned loop label in front of short
;;; backward jumps, with the code before it one byte longer each round, so
;;; that every padding amount from 0 to 15 occurs (above the limit: none).
(defn padding! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (for [lead 1 34]
    (let [(mut items) (ArrayList::new [Item] a)]
      (push! (mut items)
             (Item :kind FILLER :size lead :target 0 :count 0 :cc 0 :aligned false :inner -1))
      ; A forward jump across the aligned label: its reach must allow for
      ; the padding.
      (push! (mut items)
             (Item :kind JCC :size 6 :target 4 :count 0 :cc 2 :aligned false :inner -1))
      (push! (mut items)
             (Item :kind FILLER :size 100 :target 0 :count 0 :cc 0 :aligned true :inner -1))
      (push! (mut items)
             (Item :kind JCC :size 6 :target 2 :count 0 :cc 5 :aligned false :inner -1))
      (push! (mut items)
             (Item :kind JMP :size 5 :target 2 :count 0 :cc 0 :aligned false :inner -1))
      (push! (mut items)
             (Item :kind FILLER :size 3 :target 0 :count 0 :cc 0 :aligned true :inner -1))
      (let [(mut program) (Program :items items :targets (ArrayList::new [i64] a) :seed 3)
            (mut layout) (model program a)
            shorts (check! (mut tally) program a)
            needed (% (- 16 (% (+ lead 2) 16)) 16)]
        ; The label behind the forward jump (short: 2 bytes) is padded up to
        ; 16 when that takes at most 10 bytes; the last label has no jump
        ; back to it and is never padded.
        (note! (mut tally) (= (get (.pads layout) 2) (if (> needed 10) 0 needed))
               "loop padding is not the policy's" (cast u64 lead))
        (note! (mut tally) (= (get (.pads layout) 5) 0)
               "a label without a back edge was padded" (cast u64 lead))
        (note! (mut tally) (= shorts 3) "jumps around padding did not shrink" (cast u64 lead))
        (free! (mut (.short layout)))
        (free! (mut (.offsets layout)))
        (free! (mut (.pads layout)))
        (release! (mut program))))))

;;; Records the pass must reject, leaving everything as it was.
(defn rejects! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut items) (ArrayList::new [Item] a)]
    (push! (mut items)
           (Item :kind JMP :size 5 :target 2 :count 0 :cc 0 :aligned false :inner -1))
    (push! (mut items)
           (Item :kind FILLER :size 9 :target 0 :count 0 :cc 0 :aligned false :inner -1))
    (push! (mut items)
           (Item :kind JCC :size 6 :target 0 :count 0 :cc 1 :aligned false :inner -1))
    (let [(mut program) (Program :items items :targets (ArrayList::new [i64] a) :seed 1)]
      ; Each case damages one record of a fresh build.
      (for [mode 0 6]
        (let [(mut built) (build program a)
              (mut before) (ArrayList::new [u8] a)]
          (cond (= mode 0) (set! (mut (.labels built)) 2 3)          ; inside the first jump
                (= mode 1) (set! (mut (.labels built)) 0 -1)         ; unbound target
                (= mode 2) (set! (.short (elem (mut (.branches built)) 0)) true)
                (= mode 3) (push! (mut (.text-data (.buffer built)))
                                  (text-data/Range :offset 0 :length 4 :kind 1))
                (= mode 4) (push! (mut (.alignments built))
                                  (fixups/Alignment :label 1 :boundary 12 :limit 3 :loop false))
                :else (set! (.label (elem (mut (.branches built)) 1)) 9))
          (for byte (.text (.buffer built)) (push! (mut before) byte))
          (match (fixups/relax! (mut (.buffer built)) (mut (.labels built))
                                (mut (.branches built)) (mut (.relatives built))
                                (.alignments built))
            (Ok [_] (note! (mut tally) false "an invalid record was accepted" (cast u64 mode)))
            (Err [_]
                 (let [(mut same) (= (len before) (len (.text (.buffer built))))]
                   (when same
                     (for [i 0 (len before)]
                       (when (!= (get before i) (get (.text (.buffer built)) i))
                         (set! same false))))
                   (note! (mut tally) same "a rejected relaxation changed the text"
                          (cast u64 mode)))))
          (free! (mut before))
          (release-built! (mut built))))
      ; Records out of text order are sorted, not rejected.
      (let [(mut built) (build program a)
            first (get (.branches built) 0)]
        (set! (mut (.branches built)) 0 (get (.branches built) 1))
        (set! (mut (.branches built)) 1 first)
        (match (fixups/relax! (mut (.buffer built)) (mut (.labels built))
                              (mut (.branches built)) (mut (.relatives built))
                              (.alignments built))
          (Err [message] (note! (mut tally) false "unordered records were rejected" 0))
          (Ok [removed] (note! (mut tally) (= removed 7) "unordered records: wrong shrinkage" 0)))
        (release-built! (mut built)))
      (release! (mut program)))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut tally) (t/tally)
        (mut shorts) (: 0 i64)]
    (for [count 1 60]
      (chain! (mut tally) count false a)
      (chain! (mut tally) count true a))
    (padding! (mut tally) a)
    (rejects! (mut tally) a)
    (for [round 0 1500]
      (let [(mut state) (+ (* (cast u64 round) 0x9E3779B97F4A7C15) 12345)
            count (+ 1 (cast i64 (% (t/random! (mut state)) 120)))
            (mut program) (generate (t/random! (mut state)) count (= (% round 2) 0) a)]
        (set! shorts (+ shorts (check! (mut tally) program a)))
        (release! (mut program))))
    ; A few large ones: tens of thousands of records.
    (for [round 0 4]
      (let [(mut program) (generate (+ 77 (cast u64 round)) 20000 (= round 0) a)]
        (set! shorts (+ shorts (check! (mut tally) program a)))
        (release! (mut program))))
    (println "x64 relax records: {} programs, {} checks, {} short jumps, {} failures"
             (.functions tally) (.checks tally) shorts (.failures tally))
    (if (= (.failures tally) 0) 0 1)))
