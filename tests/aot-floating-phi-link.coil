(module stogir.tests.aot-floating-phi-link)
(import "coil.cc" :as cc)

(extern wide :as "stogir_fp_phi_f64" :cc (cc/C) [i64 f64 f64] (-> u64))

(extern narrow :as "stogir_fp_phi_f32" :cc (cc/C) [i64 f32 f32] (-> u64))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for input [(: -1 i64) 0 1]
      (when (or (!= (wide input 1.0 2.0)
                    (if (= input 0)
                        (: 0x8000000000000000 u64)
                        0x7FF0123456789ABC))
                (!= (narrow input (: 1.0 f32) (: 2.0 f32))
                    (if (= input 0) (: 0x80000000 u64) 0x7F812345)))
        (set! failures (+ failures 1))))
    (println "linked floating phi constants: {} failures" failures)
    (if (= failures 0) 0 1)))
