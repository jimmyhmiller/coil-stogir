(module stogir.tests.bytes)
(import "stogir.bytes" :as b)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn main [] (-> i64)
  (let [(mut output) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0]
    (when (b/patch32! (mut output) 0 0) (set! failures (+ failures 1)))
    (b/append32! (mut output) 0xFEDCBA98)
    (when (!= (get output 0) 0x98) (set! failures (+ failures 1)))
    (when (!= (get output 3) 0xFE) (set! failures (+ failures 1)))
    (when (b/patch32! (mut output) -1 0) (set! failures (+ failures 1)))
    (when (b/patch32! (mut output) 1 0) (set! failures (+ failures 1)))
    (when (not (b/patch32! (mut output) 0 0x12345678))
      (set! failures (+ failures 1)))
    (when (!= (get output 0) 0x78) (set! failures (+ failures 1)))
    (when (!= (get output 3) 0x12) (set! failures (+ failures 1)))
    (free! (mut output))
    (println "byte output checks: {} failures" failures)
    (if (= failures 0) 0 1)))
