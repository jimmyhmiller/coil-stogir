(module stogir.tests.rotates)
(import "stogir.fold" :as f)
(import "coil.result" :use [Some None])

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut value) (: 0 u64)]
    (while (< value 256)
      (let [(mut count) (: 0 u64)]
        (while (< count 24)
          (match (f/integer-binary 52 2 8 value count)
            (None [] (set! failures (+ failures 1)))
            (Some [rotated]
                  (do
                    (when (> rotated 255) (set! failures (+ failures 1)))
                    (match (f/integer-binary 53 2 8 rotated count)
                      (None [] (set! failures (+ failures 1)))
                      (Some [restored]
                            (when (!= restored value)
                              (set! failures (+ failures 1)))))
                    (when (= (& count 7) 0)
                      (when (!= rotated value) (set! failures (+ failures 1)))))))
          (set! count (+ count 1))))
      (set! value (+ value 1)))
    (match (f/integer-binary 52 5 8 0x8000000000000000 1)
      (Some [got] (when (!= got 1) (set! failures (+ failures 1))))
      (None [] (set! failures (+ failures 1))))
    (match (f/integer-binary 53 5 8 1 1)
      (Some [got]
            (when (!= got 0x8000000000000000) (set! failures (+ failures 1))))
      (None [] (set! failures (+ failures 1))))
    (println "rotate checks: {} failures" failures)
    (if (= failures 0) 0 1)))
