(defn callback0 :cc (cc/C) [(aggregate Pair8) (tail u64)] (-> u64)
  (+ (* (cast u64 (.a aggregate)) (: 1 u64))
     (* (cast u64 (.b aggregate)) (: 2 u64))
     (* (cast u64 tail) (: 3 u64))))

