(defn score [(total i32) (seed u64)] (-> u64)
  (let [(mut i) (: 0 i32)
        (mut sum) (: 0 u64)]
    (while (< i total)
      (set! sum (+ sum (* (+ seed (cast u64 i)) (cast u64 (+ i 1)))))
      (set! i (+ i 1)))
    sum))

(defn fixture? [(id i32)] (-> bool)
  (or (= id 4) (= id 7) (= id 25) (= id 48) (= id 54)))

(defn callback-symbol [(id i32)] (-> (slice u8))
  (match id
    (4 "_stogir_group_aot_callback_4")
    (7 "_stogir_group_aot_callback_7")
    (25 "_stogir_group_aot_callback_25")
    (48 "_stogir_group_aot_callback_48")
    (54 "_stogir_group_aot_callback_54")
    (_ "invalid")))

(defn fixture-name [(id i32) (mode i32)] (-> (slice u8))
  (match id
    (4 (match mode
         (0 "_stogir_group_4_0")
         (1 "_stogir_group_4_1")
         (2 "_stogir_group_4_2")
         (_ "_stogir_group_4_3")))
    (7 (match mode
         (0 "_stogir_group_7_0")
         (1 "_stogir_group_7_1")
         (2 "_stogir_group_7_2")
         (_ "_stogir_group_7_3")))
    (25 (match mode
          (0 "_stogir_group_25_0")
          (1 "_stogir_group_25_1")
          (2 "_stogir_group_25_2")
          (_ "_stogir_group_25_3")))
    (48 (match mode
          (0 "_stogir_group_48_0")
          (1 "_stogir_group_48_1")
          (2 "_stogir_group_48_2")
          (_ "_stogir_group_48_3")))
    (54 (match mode
          (0 "_stogir_group_54_0")
          (1 "_stogir_group_54_1")
          (2 "_stogir_group_54_2")
          (_ "_stogir_group_54_3")))
    (_ "invalid")))

(defn fixture-path [(id i32) (mode i32)] (-> (slice u8))
  (match id
    (4 (match mode
         (0 "/tmp/coil-stogir-group-4-0.o")
         (1 "/tmp/coil-stogir-group-4-1.o")
         (2 "/tmp/coil-stogir-group-4-2.o")
         (_ "/tmp/coil-stogir-group-4-3.o")))
    (7 (match mode
         (0 "/tmp/coil-stogir-group-7-0.o")
         (1 "/tmp/coil-stogir-group-7-1.o")
         (2 "/tmp/coil-stogir-group-7-2.o")
         (_ "/tmp/coil-stogir-group-7-3.o")))
    (25 (match mode
          (0 "/tmp/coil-stogir-group-25-0.o")
          (1 "/tmp/coil-stogir-group-25-1.o")
          (2 "/tmp/coil-stogir-group-25-2.o")
          (_ "/tmp/coil-stogir-group-25-3.o")))
    (48 (match mode
          (0 "/tmp/coil-stogir-group-48-0.o")
          (1 "/tmp/coil-stogir-group-48-1.o")
          (2 "/tmp/coil-stogir-group-48-2.o")
          (_ "/tmp/coil-stogir-group-48-3.o")))
    (54 (match mode
          (0 "/tmp/coil-stogir-group-54-0.o")
          (1 "/tmp/coil-stogir-group-54-1.o")
          (2 "/tmp/coil-stogir-group-54-2.o")
          (_ "/tmp/coil-stogir-group-54-3.o")))
    (_ "invalid")))

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [message] (println "{}" message) 0)))

(defn uint! [(graph (mut g/Graph)) (ty i32) (value i32)] (-> i32)
  (if (= ty 5) value (require (b/conversion! (mut graph) 38 5 8 value))))

;;; mode0: grouped outgoing call with forty pinned live values; mode1: all
;;; incoming pieces; mode2: only the final incoming projection survives.
(defn exercise [(id i32) (mode i32) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        ty (case-type id)
        total (+ (case-prefix id) (case-count id) 1)
        outgoing (primitive/cast (fnptr (cc/C) [u64 u64 u64] u64) address)
        (mut integers) (ArrayList::new [u64] allocator)
        (mut doubles) (ArrayList::new [f64] allocator)
        (mut singles) (ArrayList::new [f32] allocator)
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i 40)
      (push! (mut integers) (cast u64 (+ i 11)))
      (push! (mut doubles) (cast f64 (+ i 11)))
      (push! (mut singles) (cast f32 (+ i 11)))
      (set! i (+ i 1)))
    (for seed [(: 0 u64) 1 7 29 99]
      (let [result
              (if (or (= mode 0) (= mode 3))
                  (call-ptr outgoing
                            (target id)
                            seed
                            (if (= ty 5)
                                (primitive/cast u64 (.data integers))
                                (if (= ty 13)
                                    (primitive/cast u64 (.data singles))
                                    (primitive/cast u64 (.data doubles)))))
                  (incoming id address seed))
            expected
              (if (or (= mode 0) (= mode 3))
                  (+ (score total seed) 1220 (* seed 17))
                  (if (= mode 1)
                      (score total seed)
                      (+ seed (cast u64 (- total 1)))))]
        (when (!= result expected)
          (println "grouped id{} mode{} seed{} got{} expected{}"
                   id
                   mode
                   seed
                   result
                   expected)
          (set! failures (+ failures 1)))))
    (free! (mut integers))
    (free! (mut doubles))
    (free! (mut singles))
    failures))

(defn check [(id i32) (mode i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        ty (case-type id)
        prefix (case-prefix id)
        count (case-count id)
        variadic? (>= id 52)
        total (+ prefix count 1)
        descriptor
          (groups/Group
            :first prefix
            :count count
            :alignment (case-align id))
        (mut types) (ArrayList::new [u8] allocator)
        (mut arguments) (ArrayList::new [i32] allocator)
        (mut saved) (ArrayList::new [i32] allocator)
        (mut control) start
        (mut answer) (: 0 i32)
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i total)
      (push! (mut types)
             (cast u8 (if (and variadic? (< i prefix)) (: 12 i32) ty)))
      (set! i (+ i 1)))
    (let [fixed (if variadic? (cast i64 prefix) (len types))]
      (match (calls/create-grouped (if variadic? (: 25 u8) (: 9 u8))
                                   5
                                   (subslice (slice types) 0 fixed)
                                   [descriptor]
                                   allocator)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [prototype]
            (let [(mut prototype) prototype]
              (if (or (= mode 0) (= mode 3))
                  (let [target
                          (require (b/emit! (mut graph)
                                            71
                                            6
                                            [start (: 0 i32) 0]))
                        seed
                          (require (b/emit! (mut graph)
                                            71
                                            5
                                            [start (: 0 i32) 1]))
                        data
                          (require (b/emit! (mut graph)
                                            71
                                            6
                                            [start (: 0 i32) 2]))]
                    (set! i 0)
                    (while (< i total)
                      (let [offset
                              (require (b/scalar-constant! (mut graph)
                                                           5
                                                           (cast u64 i)
                                                           8))
                            value
                              (require (b/emit! (mut graph) 26 5 [seed offset]))
                            aty (cast i32 (get types (cast i64 i)))]
                        (push! (mut arguments)
                               (if (= aty 5)
                                   value
                                   (require (b/conversion! (mut graph)
                                                           37
                                                           aty
                                                           8
                                                           value)))))
                      (set! i (+ i 1)))
                    (set! i 0)
                    (while (< i 40)
                      (let [offset
                              (require (b/scalar-constant! (mut graph)
                                                           5
                                                           (cast u64
                                                                 (* i
                                                                    (if (= ty
                                                                           13)
                                                                        4
                                                                        8)))
                                                           8))
                            address
                              (require (b/emit! (mut graph) 26 6 [data offset]))
                            loaded
                              (require (b/emit! (mut graph)
                                                91
                                                ty
                                                [control address]))]
                        (push! (mut saved) loaded)
                        (set! control loaded))
                      (set! i (+ i 1)))
                    (let [called
                            (require (calls/emit! (mut graph)
                                                  prototype
                                                  control
                                                  (if (= mode 3)
                                                      (require (symbols/function! (mut graph)
                                                                                  (callback-symbol id)
                                                                                  0))
                                                      target)
                                                  (slice arguments)
                                                  allocator))
                          multiplier
                            (require (b/scalar-constant! (mut graph) 5 17 8))
                          extra
                            (require (b/emit! (mut graph)
                                              28
                                              5
                                              [seed multiplier]))]
                      (set! control called)
                      (set! answer
                            (require (b/emit! (mut graph) 26 5 [called extra])))
                      (for value saved
                        (set! answer
                              (require (b/emit! (mut graph)
                                                26
                                                5
                                                [answer
                                                 (uint! (mut graph) ty value)]))))))
                  (do
                    (require (calls/function! (mut graph) prototype allocator))
                    (set! answer
                          (require (b/scalar-constant! (mut graph) 5 0 8)))
                    (set! i 0)
                    (while (< i total)
                      (when (or (= mode 1) (= i (- total 1)))
                        (let [param
                                (require (b/emit! (mut graph)
                                                  71
                                                  ty
                                                  [start (: 0 i32) i]))
                              value (uint! (mut graph) ty param)
                              weight
                                (require (b/scalar-constant! (mut graph)
                                                             5
                                                             (if (= mode 2)
                                                                 1
                                                                 (cast u64
                                                                       (+ i 1)))
                                                             8))
                              product
                                (require (b/emit! (mut graph)
                                                  28
                                                  5
                                                  [value weight]))]
                          (set! answer
                                (require (b/emit! (mut graph)
                                                  26
                                                  5
                                                  [answer product])))))
                      (set! i (+ i 1)))))
              (calls/release! (mut prototype))))))
    (let [ret (require (b/emit! (mut graph) 120 5 [control answer (: 0 i32)]))]
      (when (fixture? id)
        (match (compile/object graph
                               start
                               [ret]
                               (fixture-name id mode)
                               allocator)
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [object]
              (let [(mut object) object]
                (match (fs/write-file allocator
                                      (fixture-path id mode)
                                      (slice object))
                  (Err [_] (set! failures (+ failures 1)))
                  (Ok [_] 0))
                (free! (mut object))))))
      (if (= mode 3)
          (match (compile/image graph
                                start
                                [ret]
                                (fixture-name id mode)
                                allocator)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [source]
                (let [(mut source) source
                      (mut addresses) (ArrayList::new [u64] allocator)
                      (mut present) (ArrayList::new [bool] allocator)]
                  (for symbol (.symbols source)
                    (push! (mut addresses) (target id))
                    (push! (mut present) true))
                  (match (jit/map-image-resolved source
                                                 (slice addresses)
                                                 (slice present)
                                                 allocator)
                    (Err [message]
                         (println "{}" message)
                         (set! failures (+ failures 1)))
                    (Ok [loaded]
                        (let [(mut loaded) loaded]
                          (set! failures
                                (+ failures
                                   (exercise id mode (.base (.memory loaded)))))
                          (jit/release-image! (mut loaded)))))
                  (free! (mut addresses))
                  (free! (mut present))
                  (image/release! (mut source)))))
          (match (compile/text graph start [ret] allocator)
            (Err [message]
                 (println "grouped id{} mode{}: {}" id mode message)
                 (set! failures (+ failures 1)))
            (Ok [text]
                (let [(mut text) text]
                  (match (jit/map-text (slice text))
                    (Err [message]
                         (println "{}" message)
                         (set! failures (+ failures 1)))
                    (Ok [image]
                        (let [(mut image) image]
                          (set! failures
                                (+ failures (exercise id mode (.base image))))
                          (jit/release! (mut image)))))
                  (free! (mut text)))))))
    (free! (mut types))
    (free! (mut arguments))
    (free! (mut saved))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut id) (: 0 i32)]
    (while (< id 56)
      (for mode [(: 0 i32) 1 2 3]
        (when (and (or (< id 52) (= mode 0) (= mode 3))
                   (or (!= mode 3) (fixture? id)))
          (set! failures (+ failures (check id mode)))))
      (set! id (+ id 1)))
    (println "native grouped arguments, both directions, omitted projections and GP/FP pressure: {} failures"
             failures)
    (if (= failures 0) 0 1)))
