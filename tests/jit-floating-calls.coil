(module stogir.tests.jit-floating-calls)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn probe :cc (cc/C) [(g0 i64)
                        (f0 f64)
                        (g1 i64)
                        (f1 f32)
                        (g2 i64)
                        (f2 f64)
                        (g3 i64)
                        (f3 f32)
                        (g4 i64)
                        (f4 f64)
                        (g5 i64)
                        (f5 f32)
                        (g6 i64)
                        (f6 f64)
                        (g7 i64)
                        (f7 f32)
                        (g8 i64)
                        (f8 f64)
                        (g9 i64)
                        (f9 f32)] (-> f64)
  (+ (* (cast f64 g0) 1.0)
     (* (cast f64 f0) 2.0)
     (* (cast f64 g1) 3.0)
     (* (cast f64 f1) 4.0)
     (* (cast f64 g2) 5.0)
     (* (cast f64 f2) 6.0)
     (* (cast f64 g3) 7.0)
     (* (cast f64 f3) 8.0)
     (* (cast f64 g4) 9.0)
     (* (cast f64 f4) 10.0)
     (* (cast f64 g5) 11.0)
     (* (cast f64 f5) 12.0)
     (* (cast f64 g6) 13.0)
     (* (cast f64 f6) 14.0)
     (* (cast f64 g7) 15.0)
     (* (cast f64 f7) 16.0)
     (* (cast f64 g8) 17.0)
     (* (cast f64 f8) 18.0)
     (* (cast f64 g9) 19.0)
     (* (cast f64 f9) 20.0)))

(defn probe32 :cc (cc/C) [(g0 i64)
                          (f0 f64)
                          (g1 i64)
                          (f1 f32)
                          (g2 i64)
                          (f2 f64)
                          (g3 i64)
                          (f3 f32)
                          (g4 i64)
                          (f4 f64)
                          (g5 i64)
                          (f5 f32)
                          (g6 i64)
                          (f6 f64)
                          (g7 i64)
                          (f7 f32)
                          (g8 i64)
                          (f8 f64)
                          (g9 i64)
                          (f9 f32)] (-> f32)
  (cast f32 (probe g0 f0 g1 f1 g2 f2 g3 f3 g4 f4 g5 f5 g6 f6 g7 f7 g8 f8 g9 f9)))

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn check [(mode i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        (mut args) (ArrayList::new [i32] allocator)
        (mut types) (ArrayList::new [u8] allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        p (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 1]))
        s (require (b/emit! (mut graph) 71 13 [start (: 0 i32) 2]))
        n (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 3]))
        result-type (if (= mode 4) (: 13 u8) 12)
        return-type
          (if (= mode 2) (: 13 u8) (if (= mode 3) (: 11 u8) result-type))
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i 10)
      (let [(mut d) (+ (cast f64 i) 0.5)
            (mut f) (+ (cast f32 i) (: 0.25 f32))
            constant? (= (% i 3) 0)
            gp
              (if constant?
                  (require (b/scalar-constant! (mut graph)
                                               11
                                               (cast u64 (+ i 10))
                                               8))
                  n)
            fp
              (if constant?
                  (require (b/scalar-constant! (mut graph)
                                               (if (= (% i 2) 0) 12 13)
                                               (if (= (% i 2) 0)
                                                   (load (primitive/cast (ptr u64)
                                                                         (mut d)))
                                                   (cast u64
                                                         (load (primitive/cast (ptr u32)
                                                                               (mut f)))))
                                               8))
                  (if (= (% i 2) 0) p s))]
        (push! (mut args) gp)
        (push! (mut types) 11)
        (push! (mut args) fp)
        (push! (mut types) (if (= (% i 2) 0) 12 13)))
      (set! i (+ i 1)))
    (match (calls/create 0 result-type (slice types) allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype
                call
                  (require (calls/emit! (mut graph)
                                        owned
                                        start
                                        target
                                        (slice args)
                                        allocator))
                returned
                  (if (= mode 1) p (if (= mode 2) s (if (= mode 3) n call)))
                ret
                  (require (b/emit! (mut graph)
                                    120
                                    (cast i32 return-type)
                                    [call returned (: 0 i32)]))]
            (match (calls/create 0 return-type [(: 6 u8) 12 13 11] allocator)
              (Err [_] (set! failures (+ failures 1)))
              (Ok [incoming]
                  (let [(mut owned-incoming) incoming]
                    (require (calls/function! (mut graph)
                                              owned-incoming
                                              allocator))
                    (calls/release! (mut owned-incoming)))))
            (let [symbol
                    (match mode
                      (0 "_stogir_fp_call_0")
                      (1 "_stogir_fp_call_1")
                      (2 "_stogir_fp_call_2")
                      (3 "_stogir_fp_call_3")
                      (_ "_stogir_fp_call_4"))
                  path
                    (match mode
                      (0 "/tmp/coil-stogir-fp-call-0.o")
                      (1 "/tmp/coil-stogir-fp-call-1.o")
                      (2 "/tmp/coil-stogir-fp-call-2.o")
                      (3 "/tmp/coil-stogir-fp-call-3.o")
                      (_ "/tmp/coil-stogir-fp-call-4.o"))]
              (match (compile/object graph start [ret] symbol allocator)
                (Err [msg]
                     (do (println "{}" msg) (set! failures (+ failures 1))))
                (Ok [object]
                    (let [(mut bytes) object]
                      (match (fs/write-file allocator path (slice bytes))
                        (Err [_] (set! failures (+ failures 1)))
                        (Ok [_] 0))
                      (free! (mut bytes))))))
            (match (compile/text graph start [ret] allocator)
              (Err [msg]
                   (do
                     (println "floating call mode={}: {}" mode msg)
                     (set! failures (+ failures 1))))
              (Ok [text]
                  (let [(mut code) text]
                    (match (jit/map-text (slice code))
                      (Err [_] (set! failures (+ failures 1)))
                      (Ok [loaded]
                          (let [(mut image) loaded
                                target-address
                                  (primitive/cast u64
                                                  (if (= mode 4)
                                                      (primitive/cast (ptr u8)
                                                                      (fnptr-of probe32))
                                                      (primitive/cast (ptr u8)
                                                                      (fnptr-of probe))))]
                            (for input [(: -7 i64) -1 0 1 7 100]
                              (let [d (* (cast f64 input) 0.25)
                                    f (* (cast f32 input) (: 0.125 f32))
                                    (mut wanted) (: 0.0 f64)]
                                (set! i 0)
                                (while (< i 10)
                                  (let [constant? (= (% i 3) 0)
                                        gp
                                          (if constant?
                                              (cast f64 (+ i 10))
                                              (cast f64 input))
                                        fp
                                          (if constant?
                                              (if (= (% i 2) 0)
                                                  (+ (cast f64 i) 0.5)
                                                  (+ (cast f64 i) 0.25))
                                              (if (= (% i 2) 0) d (cast f64 f)))]
                                    (set! wanted
                                          (+ wanted
                                             (* gp (cast f64 (+ (* i 2) 1)))
                                             (* fp (cast f64 (+ (* i 2) 2))))))
                                  (set! i (+ i 1)))
                                (if (= mode 3)
                                    (let [fun
                                            (primitive/cast (fnptr (cc/C)
                                                                   [u64 f64 f32
                                                                    i64]
                                                                   i64)
                                                            (.base image))]
                                      (when (!= (call-ptr fun
                                                          target-address
                                                          d
                                                          f
                                                          input)
                                                input)
                                        (set! failures (+ failures 1))))
                                    (if (or (= mode 2) (= mode 4))
                                        (let [fun
                                                (primitive/cast (fnptr (cc/C)
                                                                       [u64 f64
                                                                        f32 i64]
                                                                       f32)
                                                                (.base image))
                                              expected
                                                (if (= mode 2)
                                                    f
                                                    (cast f32 wanted))]
                                          (when (!= (call-ptr fun
                                                              target-address
                                                              d
                                                              f
                                                              input)
                                                    expected)
                                            (set! failures (+ failures 1))))
                                        (let [fun
                                                (primitive/cast (fnptr (cc/C)
                                                                       [u64 f64
                                                                        f32 i64]
                                                                       f64)
                                                                (.base image))
                                              expected (if (= mode 1) d wanted)
                                              actual
                                                (call-ptr fun
                                                          target-address
                                                          d
                                                          f
                                                          input)]
                                          (when (!= actual expected)
                                            (when (= failures 0)
                                              (println "floating call mode={} input={} wanted={} actual={}"
                                                       mode
                                                       input
                                                       expected
                                                       actual))
                                            (set! failures (+ failures 1))))))))
                            (jit/release! (mut image)))))
                    (free! (mut code)))))
            (calls/release! (mut owned)))))
    (free! (mut types))
    (free! (mut args))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [failures (+ (check 0) (check 1) (check 2) (check 3) (check 4))]
    (println "native mixed floating/integer calls and live-through values: {} failures"
             failures)
    (if (= failures 0) 0 1)))
