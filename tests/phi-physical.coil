(module stogir.tests.phi-physical)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.edge-moves" :as edge)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as r)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Some None Ok Err])

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        (mut packed)
          (schedule/Schedule
            :ranges (ArrayList::new [schedule/Range] allocator)
            :nodes (ArrayList::new [i32] allocator))
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut entry) (a/create 2 allocator)
        (mut phi) (a/create 2 allocator)
        (mut incoming) (a/create 3 allocator)
        (mut failures) 0]
    (g/append-constant! (mut graph) (n/constant 11 11 0 42))
    (g/append-inputs! (mut graph) 113 0 [(: 1 i32) 1])
    (g/append-inputs! (mut graph) 67 11 [(: 1 i32) -1 3])
    (g/append-inputs! (mut graph) 26 11 [(: 2 i32) -1])
    (for node [(: 1 i32) 2 3] (push! (mut (.nodes packed)) node))
    (push! (mut (.ranges packed)) (schedule/Range :offset 0 :count 0))
    (push! (mut (.ranges packed)) (schedule/Range :offset 0 :count 3))
    ; The Phi is defined on entry in a stack slot, then later reloaded into
    ; a register. Every incoming edge must target that common entry location.
    (r/add! (mut (.ranges entry)) 0 3)
    (set! (.spill-slot entry) 64)
    (r/add! (mut (.ranges phi)) 3 6)
    (set! (.register phi) 0)
    (r/add! (mut (.ranges incoming)) 5 6)
    (set! (.register incoming) 1)
    (push! (mut parts) entry)
    (push! (mut parts) phi)
    (push! (mut parts) incoming)
    (match (edge/phis graph packed parts 1 1 5 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [group]
          (let [(mut owned) group]
            (when (!= (len (.literals owned)) 1) (set! failures (+ failures 1)))
            (when (!= (.bits (get (.literals owned) 0)) 42)
              (set! failures (+ failures 1)))
            (when (or (!= (.kind (.destination (get (.literals owned) 0))) 1)
                      (!= (.value (.destination (get (.literals owned) 0))) 64))
              (set! failures (+ failures 1)))
            (edge/release-phis! (mut owned)))))
    (match (edge/phis graph packed parts 1 2 5 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [group]
          (let [(mut owned) group]
            (when (!= (len (.moves owned)) 1) (set! failures (+ failures 1)))
            (when (!= (.value (.source (get (.moves owned) 0))) 1)
              (set! failures (+ failures 1)))
            (when (or (!= (.kind (.destination (get (.moves owned) 0))) 1)
                      (!= (.value (.destination (get (.moves owned) 0))) 64))
              (set! failures (+ failures 1)))
            (edge/release-phis! (mut owned)))))
    (a/release! (elem (mut parts) 0))
    (a/release! (elem (mut parts) 1))
    (a/release! (elem (mut parts) 2))
    (free! (mut parts))
    (schedule/release! (mut packed))
    (g/release! (mut graph))
    (println "physical phi copy checks: {} failures" failures)
    (if (= failures 0) 0 1)))
