(module stogir.tests.aot-aggregate-result-recursion-link)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defn bits-f32 [(bits u32)] (-> f32)
  (let [p (primitive/alloc-stack u32)]
    (primitive/store! p bits)
    (primitive/load (primitive/cast (ptr f32) p))))

(defn f32-bits [(value f32)] (-> u32)
  (let [p (primitive/alloc-stack f32)]
    (primitive/store! p value)
    (primitive/load (primitive/cast (ptr u32) p))))

(defn bits-f64 [(bits u64)] (-> f64)
  (let [p (primitive/alloc-stack u64)]
    (primitive/store! p bits)
    (primitive/load (primitive/cast (ptr f64) p))))

(defn f64-bits [(value f64)] (-> u64)
  (let [p (primitive/alloc-stack f64)]
    (primitive/store! p value)
    (primitive/load (primitive/cast (ptr u64) p))))

(defstruct R0 [(a u64)])

(defstruct R1 [(a u64) (b u64)])

(defstruct R2 [(a i64)])

(defstruct R3 [(a i64) (b i64)])

(defstruct R4 [(a f32)])

(defstruct R5 [(a f32) (b f32)])

(defstruct R6 [(a f32) (b f32) (c f32)])

(defstruct R7 [(a f32) (b f32) (c f32) (d f32)])

(defstruct R8 [(a f64)])

(defstruct R9 [(a f64) (b f64)])

(defstruct R10 [(a f64) (b f64) (c f64)])

(defstruct R11 [(a f64) (b f64) (c f64) (d f64)])

(defstruct R12 [(a u64) (b u64) (c u64)])

(defstruct R13 [(a u64) (b u64) (c u64) (d u64) (e u64)])

(defstruct R14 [(a u8) (b u8) (c u8)])

(defstruct R15 [(a u64) (b u32)])

(extern rec1_16 :as "stogir_results_rec_1_16" :cc (cc/C) [u64 u64] (-> R1))

(extern rec1_4096 :as "stogir_results_rec_1_4096" :cc (cc/C) [u64 u64] (-> R1))

(extern rec6_16 :as "stogir_results_rec_6_16" :cc (cc/C) [u64 u64] (-> R6))

(extern rec6_4096 :as "stogir_results_rec_6_4096" :cc (cc/C) [u64 u64] (-> R6))

(extern rec11_16 :as "stogir_results_rec_11_16" :cc (cc/C) [u64 u64] (-> R11))

(extern rec11_4096
        :as
        "stogir_results_rec_11_4096"
        :cc
        (cc/C)
        [u64 u64]
        (-> R11))

(extern rec13_16 :as "stogir_results_rec_13_16" :cc (cc/C) [u64 u64] (-> R13))

(extern rec13_4096
        :as
        "stogir_results_rec_13_4096"
        :cc
        (cc/C)
        [u64 u64]
        (-> R13))

(extern rec14_16 :as "stogir_results_rec_14_16" :cc (cc/C) [u64 u64] (-> R14))

(extern rec14_4096
        :as
        "stogir_results_rec_14_4096"
        :cc
        (cc/C)
        [u64 u64]
        (-> R14))

(extern rec15_16 :as "stogir_results_rec_15_16" :cc (cc/C) [u64 u64] (-> R15))

(extern rec15_4096
        :as
        "stogir_results_rec_15_4096"
        :cc
        (cc/C)
        [u64 u64]
        (-> R15))

(defn field-count [(id i32)] (-> i32)
  (match id
    (0 1)
    (1 2)
    (2 1)
    (3 2)
    (4 1)
    (5 2)
    (6 3)
    (7 4)
    (8 1)
    (9 2)
    (10 3)
    (11 4)
    (12 3)
    (13 5)
    (14 3)
    (15 2)
    (_ 0)))

(defn data-type [(id i32)] (-> i32)
  (match id
    (0 5)
    (1 5)
    (2 5)
    (3 5)
    (4 13)
    (5 13)
    (6 13)
    (7 13)
    (8 12)
    (9 12)
    (10 12)
    (11 12)
    (12 5)
    (13 5)
    (14 5)
    (15 5)
    (_ 0)))

(defn payload-size [(id i32)] (-> i32)
  (match id
    (0 8)
    (1 16)
    (2 8)
    (3 16)
    (4 4)
    (5 8)
    (6 12)
    (7 16)
    (8 8)
    (9 16)
    (10 24)
    (11 32)
    (12 24)
    (13 40)
    (14 8)
    (15 16)
    (_ 0)))

(defn field-type [(id i32) (index i32)] (-> i32)
  (match id
    (0 (match index (0 5) (_ 0)))
    (1 (match index (0 5) (1 5) (_ 0)))
    (2 (match index (0 11) (_ 0)))
    (3 (match index (0 11) (1 11) (_ 0)))
    (4 (match index (0 13) (_ 0)))
    (5 (match index (0 13) (1 13) (_ 0)))
    (6 (match index (0 13) (1 13) (2 13) (_ 0)))
    (7 (match index (0 13) (1 13) (2 13) (3 13) (_ 0)))
    (8 (match index (0 12) (_ 0)))
    (9 (match index (0 12) (1 12) (_ 0)))
    (10 (match index (0 12) (1 12) (2 12) (_ 0)))
    (11 (match index (0 12) (1 12) (2 12) (3 12) (_ 0)))
    (12 (match index (0 5) (1 5) (2 5) (_ 0)))
    (13 (match index (0 5) (1 5) (2 5) (3 5) (4 5) (_ 0)))
    (14 (match index (0 2) (1 2) (2 2) (_ 0)))
    (15 (match index (0 5) (1 4) (_ 0)))
    (_ 0)))

(defn field-offset [(id i32) (index i32)] (-> i32)
  (match id
    (0 (match index (0 0) (_ 0)))
    (1 (match index (0 0) (1 8) (_ 0)))
    (2 (match index (0 0) (_ 0)))
    (3 (match index (0 0) (1 8) (_ 0)))
    (4 (match index (0 0) (_ 0)))
    (5 (match index (0 0) (1 4) (_ 0)))
    (6 (match index (0 0) (1 4) (2 8) (_ 0)))
    (7 (match index (0 0) (1 4) (2 8) (3 12) (_ 0)))
    (8 (match index (0 0) (_ 0)))
    (9 (match index (0 0) (1 8) (_ 0)))
    (10 (match index (0 0) (1 8) (2 16) (_ 0)))
    (11 (match index (0 0) (1 8) (2 16) (3 24) (_ 0)))
    (12 (match index (0 0) (1 8) (2 16) (_ 0)))
    (13 (match index (0 0) (1 8) (2 16) (3 24) (4 32) (_ 0)))
    (14 (match index (0 0) (1 1) (2 2) (_ 0)))
    (15 (match index (0 0) (1 8) (_ 0)))
    (_ 0)))

(defn memory-type [(id i32) (index i32)] (-> i32)
  (match id
    (0 (match index (0 5) (_ 0)))
    (1 (match index (0 5) (1 5) (_ 0)))
    (2 (match index (0 5) (_ 0)))
    (3 (match index (0 5) (1 5) (_ 0)))
    (4 (match index (0 4) (_ 0)))
    (5 (match index (0 4) (1 4) (_ 0)))
    (6 (match index (0 4) (1 4) (2 4) (_ 0)))
    (7 (match index (0 4) (1 4) (2 4) (3 4) (_ 0)))
    (8 (match index (0 5) (_ 0)))
    (9 (match index (0 5) (1 5) (_ 0)))
    (10 (match index (0 5) (1 5) (2 5) (_ 0)))
    (11 (match index (0 5) (1 5) (2 5) (3 5) (_ 0)))
    (12 (match index (0 5) (1 5) (2 5) (_ 0)))
    (13 (match index (0 5) (1 5) (2 5) (3 5) (4 5) (_ 0)))
    (14 (match index (0 2) (1 2) (2 2) (_ 0)))
    (15 (match index (0 5) (1 4) (_ 0)))
    (_ 0)))

(defn score [(id i32) (seed u64)] (-> u64)
  (let [(mut i) (: 0 i32)
        (mut sum) (: 0 u64)]
    (while (< i (field-count id))
      (let [bits (+ seed (: 506 u64) (* (cast u64 i) (: 257 u64)))
            ty (memory-type id i)
            value
              (if (= ty 2) (& bits 255) (if (= ty 4) (& bits 0xFFFFFFFF) bits))]
        (set! sum (+ sum (* value (cast u64 (+ i 1))))))
      (set! i (+ i 1)))
    sum))

(defn expected [(id i32) (depth u64) (seed u64)] (-> u64)
  (let [(mut toggle) (: 0 u64)
        (mut n) depth
        (mut answer) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (> n 0) (set! toggle (^ toggle n)) (set! n (- n 1)))
    (while (< i (field-count id))
      (let [raw (+ seed (cast u64 (* i 257)))
            value (if (= i 0) (^ raw toggle) raw)
            narrow
              (if (= (field-type id i) 2)
                  (cast u64 (cast u8 value))
                  (if (or (= (field-type id i) 4) (= (field-type id i) 13))
                      (cast u64 (cast u32 value))
                      value))]
        (set! answer (+ answer (* narrow (cast u64 (+ i 1))))))
      (set! i (+ i 1)))
    answer))

(defn invoke [(id i32) (address (ptr u8)) (depth u64) (seed u64)] (-> u64)
  (match id
    (1 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R1) address)
             value (call-ptr f depth seed)]
         (+ (: 0 u64)
            (* (cast u64 (.a value)) (: 1 u64))
            (* (cast u64 (.b value)) (: 2 u64)))))
    (6 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R6) address)
             value (call-ptr f depth seed)]
         (+ (: 0 u64)
            (* (cast u64 (f32-bits (.a value))) (: 1 u64))
            (* (cast u64 (f32-bits (.b value))) (: 2 u64))
            (* (cast u64 (f32-bits (.c value))) (: 3 u64)))))
    (11 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R11) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (f64-bits (.a value)) (: 1 u64))
             (* (f64-bits (.b value)) (: 2 u64))
             (* (f64-bits (.c value)) (: 3 u64))
             (* (f64-bits (.d value)) (: 4 u64)))))
    (13 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R13) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64))
             (* (cast u64 (.c value)) (: 3 u64))
             (* (cast u64 (.d value)) (: 4 u64))
             (* (cast u64 (.e value)) (: 5 u64)))))
    (14 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R14) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64))
             (* (cast u64 (.c value)) (: 3 u64)))))
    (15 (let [f (primitive/cast (fnptr (cc/C) [u64 u64] R15) address)
              value (call-ptr f depth seed)]
          (+ (: 0 u64)
             (* (cast u64 (.a value)) (: 1 u64))
             (* (cast u64 (.b value)) (: 2 u64)))))
    (_ 0)))

(defn address16 [(id i32)] (-> (ptr u8))
  (match id
    (1 (primitive/cast (ptr u8)
                       (: (fnptr-of rec1_16) (fnptr (cc/C) [u64 u64] R1))))
    (6 (primitive/cast (ptr u8)
                       (: (fnptr-of rec6_16) (fnptr (cc/C) [u64 u64] R6))))
    (11 (primitive/cast (ptr u8)
                        (: (fnptr-of rec11_16) (fnptr (cc/C) [u64 u64] R11))))
    (13 (primitive/cast (ptr u8)
                        (: (fnptr-of rec13_16) (fnptr (cc/C) [u64 u64] R13))))
    (14 (primitive/cast (ptr u8)
                        (: (fnptr-of rec14_16) (fnptr (cc/C) [u64 u64] R14))))
    (15 (primitive/cast (ptr u8)
                        (: (fnptr-of rec15_16) (fnptr (cc/C) [u64 u64] R15))))
    (_ (primitive/cast (ptr u8) (: 0 u64)))))

(defn address4096 [(id i32)] (-> (ptr u8))
  (match id
    (1 (primitive/cast (ptr u8)
                       (: (fnptr-of rec1_4096) (fnptr (cc/C) [u64 u64] R1))))
    (6 (primitive/cast (ptr u8)
                       (: (fnptr-of rec6_4096) (fnptr (cc/C) [u64 u64] R6))))
    (11 (primitive/cast (ptr u8)
                        (: (fnptr-of rec11_4096) (fnptr (cc/C) [u64 u64] R11))))
    (13 (primitive/cast (ptr u8)
                        (: (fnptr-of rec13_4096) (fnptr (cc/C) [u64 u64] R13))))
    (14 (primitive/cast (ptr u8)
                        (: (fnptr-of rec14_4096) (fnptr (cc/C) [u64 u64] R14))))
    (15 (primitive/cast (ptr u8)
                        (: (fnptr-of rec15_4096) (fnptr (cc/C) [u64 u64] R15))))
    (_ (primitive/cast (ptr u8) (: 0 u64)))))

(defn exercise [(id i32) (address (ptr u8))] (-> i64)
  (let [(mut failures) 0]
    (for depth [(: 0 u64) 1 2 3 7 15 31]
      (for seed [(: 0 u64)
                 1
                 0x80000000
                 0x7FC12345
                 0x8000000000000000
                 0x7FF8123456789ABC
                 0xFFFFFFFFFFFFFFFF]
        (let [got (invoke id address depth seed)
              want (expected id depth seed)]
          (when (!= got want)
            (println "recursive result {} depth{} seed{}: {} expected{}"
                     id
                     depth
                     seed
                     got
                     want)
            (set! failures (+ failures 1))))))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for id [(: 1 i32) 6 11 13 14 15]
      (set! failures
            (+ failures
               (exercise id (address16 id))
               (exercise id (address4096 id)))))
    (println "linked recursive aggregate results: {} failures" failures)
    (if (= failures 0) 0 1)))
