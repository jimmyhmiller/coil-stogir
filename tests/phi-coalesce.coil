(module stogir.tests.phi-coalesce)
(import "stogir.a64.phi-coalesce" :as phi)
(import "stogir.allocation" :as allocation)
(import "stogir.a64.coalesce" :as coalesce)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.pipeline" :as pipeline)
(import "stogir.register-live" :as live)
(import "stogir.live-ranges" :as ranges)
(import "stogir.a64.registers" :as registers)
(import "stogir.node" :as n)
(import "coil.result" :use [Result Ok Err])
(import "stogir.interval" :as interval)
(import "stogir.constraints" :as c)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

;;; Exhaust all pairs of six-position lifetime sets. This checks holes,
;;; adjacency, overlap rejection, exact union, and rejection immutability.
(defn exhaustive [] (-> i64)
  (let [a (malloc-allocator) (mut failures) 0]
    (for [left 1 64]
      (for [right 1 64]
        (let [(mut parts) (ArrayList::new [allocation/Part] a)
              (mut x) (allocation/create 1 a)
              (mut y) (allocation/create 2 a)]
          (for [position 0 6]
            (when (!= (& left (<< 1 position)) 0)
              (interval/add! (mut (.ranges x)) position (+ position 1)))
            (when (!= (& right (<< 1 position)) 0)
              (interval/add! (mut (.ranges y)) position (+ position 1))))
          (push! (mut parts) x) (push! (mut parts) y)
          (let [accepted (phi/join! (mut parts) 0 1 a)
                expected (= (& left right) 0)]
            (when (!= accepted expected) (set! failures (+ failures 1)))
            (for [position 0 6]
              (when (!= (interval/covers? (.ranges (at parts 0)) position)
                         (!= (& (if expected (| left right) left) (<< 1 position)) 0))
                (set! failures (+ failures 1)))
              (when (!= (interval/covers? (.ranges (at parts 1)) position)
                         (and (not expected) (!= (& right (<< 1 position)) 0)))
                (set! failures (+ failures 1))))
            (let [(mut previous) -1]
              (for range (.ranges (at parts 0))
                (when (<= (.start range) previous) (set! failures (+ failures 1)))
                (set! previous (.end range)))))
          (for [i 0 (len parts)] (allocation/release! (elem (mut parts) i)))
          (free! (mut parts)))))
    failures))

(defn requirements [] (-> i64)
  (let [a (malloc-allocator) (mut failures) 0
        (mut parts) (ArrayList::new [allocation/Part] a)
        (mut x) (allocation/create 1 a)
        (mut y) (allocation/create 2 a)]
    (interval/add! (mut (.ranges x)) 0 2)
    (interval/add! (mut (.ranges y)) 2 4)
    (c/add! (mut (.uses x)) 2 2 3)
    (c/add! (mut (.uses y)) 2 2 4)
    (push! (mut parts) x) (push! (mut parts) y)
    (when (phi/join! (mut parts) 0 1 a) (set! failures (+ failures 1)))
    (when (!= (.register (get (.uses (at parts 1)) 0)) 4)
      (set! failures (+ failures 1)))
    (clear! (mut (.uses (elem (mut parts) 1))))
    (c/add! (mut (.uses (elem (mut parts) 1))) 2 1 -1)
    (c/add! (mut (.uses (elem (mut parts) 1))) 3 2 4)
    (set! (.allowed (elem (mut parts) 1)) 1)
    (when (phi/join! (mut parts) 0 1 a) (set! failures (+ failures 1)))
    (set! (.allowed (elem (mut parts) 1)) (.allowed (at parts 0)))
    (unless (phi/join! (mut parts) 0 1 a) (set! failures (+ failures 1)))
    (when (or (!= (len (.ranges (at parts 0))) 1)
              (!= (len (.uses (at parts 0))) 2)
              (!= (.kind (get (.uses (at parts 0)) 0)) 2)
              (!= (.register (get (.uses (at parts 0)) 0)) 3)
              (!= (.register (get (.uses (at parts 0)) 1)) 4)
              (!= (len (.uses (at parts 1))) 0))
      (set! failures (+ failures 1)))
    ; Transitive merge retains the previous union and all fixed requirements.
    (let [(mut z) (allocation/create 3 a)]
      (interval/add! (mut (.ranges z)) 6 8)
      (c/add! (mut (.uses z)) 7 2 5)
      (push! (mut parts) z))
    (unless (phi/join! (mut parts) 0 2 a) (set! failures (+ failures 1)))
    (when (or (!= (len (.ranges (at parts 0))) 2)
              (!= (len (.uses (at parts 0))) 3))
      (set! failures (+ failures 1)))
    (for [i 0 (len parts)] (allocation/release! (elem (mut parts) i)))
    (free! (mut parts))
    failures))

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (println "{}" message) 0)))

;;; Real scheduled diamond: p and q overlap, but each ends before the Phi.
;;; Only one can join it. A subsequent COPY cannot reuse this multi-value group.
(defn pipeline-checks [] (-> i64)
  (let [a (malloc-allocator) (mut failures) 0
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        cmp (require (b/emit! (mut graph) 16 1 [p q]))
        branch (require (b/emit! (mut graph) 116 0 [start cmp]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        left (require (b/emit! (mut graph) 114 0 [yes]))
        right (require (b/emit! (mut graph) 114 0 [no]))
        merge (require (b/emit! (mut graph) 112 0 [left right]))
        value (require (b/emit! (mut graph) 67 11 [merge p q]))
        copy (require (b/emit! (mut graph) 68 11 [value (: 1 i32)]))
        ret (require (b/emit! (mut graph) 120 11 [merge copy (: 0 i32)]))]
    (match (pipeline/prepare-native graph start [ret] a)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prepared]
        (let [(mut owned) prepared
              (mut analysis) (live/analyze graph (.blocks owned) (.schedule owned) (.order owned) a)
              (mut intervals) (ranges/build graph (.schedule owned) analysis (.order owned) a)
              (mut parts) (ArrayList::new [allocation/Part] a)
              (mut aliases) (ArrayList::new [i32] a)]
          (for [i 1 (len intervals)]
            (let [(mut part) (allocation/create (cast i32 i) a)]
              (set! (.allowed part) (registers/class-mask (cast i32 (n/type-id (get (.instructions graph) i)))))
              (for range (.ranges (at intervals i)) (push! (mut (.ranges part)) range))
              (push! (mut parts) part)))
          (let [(mut groups) (phi/run! (mut parts) (mut aliases) graph (.schedule owned)
                                       (.blocks owned) (.depths owned) a)
                proot (phi/root aliases p)
                qroot (phi/root aliases q)
                vroot (phi/root aliases value)]
            (when (or (= proot qroot)
                      (not (or (= proot vroot) (= qroot vroot)))
                      (not (phi/group? groups vroot)))
              (set! failures (+ failures 1)))
            (coalesce/extend! (mut aliases) groups (mut parts) graph (.schedule owned) a)
            (when (!= (phi/root aliases copy) copy) (set! failures (+ failures 1)))
            (free! (mut groups)))
          (for [i 0 (len parts)] (allocation/release! (elem (mut parts) i)))
          (free! (mut parts)) (free! (mut aliases))
          (ranges/release! (mut intervals)) (live/release-analysis! (mut analysis))
          (pipeline/release! (mut owned)))))
    (g/release! (mut graph))
    failures))

(defn boundary-checks [] (-> i64)
  (let [a (malloc-allocator) (mut failures) 0
        (mut part) (allocation/create 1 a)
        (mut limits) (ArrayList::new [i64] a)]
    (interval/add! (mut (.ranges part)) 0 10)
    (push! (mut limits) 5) (push! (mut limits) 7)
    (let [native (allocation/free-decision-at-boundaries part limits 0 3 -1 2 a)
          generic (allocation/free-decision-hinted part limits 0 3 -1 a)]
      (when (or (!= (.register native) 1) (!= (.until native) 6)
                (!= (.register generic) 1) (!= (.until generic) 7))
        (set! failures (+ failures 1))))
    ; Rounding must happen before selection, including when it removes every
    ; legal assignment. Fixed-use limits obey the same lowering constraint.
    (when (!= (.register (allocation/free-decision-at-boundaries part limits 5 1 -1 2 a)) -1)
      (set! failures (+ failures 1)))
    (c/add! (mut (.uses part)) 5 2 1)
    (let [choice (allocation/free-decision-at-boundaries part limits 0 1 -1 2 a)]
      (when (or (!= (.register choice) 0) (!= (.until choice) 4))
        (set! failures (+ failures 1))))
    (clear! (mut (.uses part)))
    (clear! (mut (.ranges part)))
    (interval/add! (mut (.ranges part)) 0 7)
    (let [choice (allocation/free-decision-at-boundaries part limits 0 3 -1 2 a)]
      (when (or (!= (.register choice) 1) (!= (.until choice) 7))
        (set! failures (+ failures 1))))
    (allocation/release! (mut part)) (free! (mut limits))
    failures))

(defn main [] (-> i64)
  (let [failures (+ (+ (exhaustive) (requirements)) (+ (pipeline-checks) (boundary-checks)))]
    (println "Phi coalescing range/constraint checks: {} failures" failures)
    (if (= failures 0) 0 1)))
