(module stogir.tests.image-layout)
(import "stogir.alignment" :as a)
(import "stogir.jit.layout" :as layout)
(import "coil.result" :use [Result Ok Err])

(defn rounded [(offset i64) (alignment i64) (expected i64)] (-> i64)
  (match (a/up offset alignment)
    (Err [_] 1)
    (Ok [got] (if (= got expected) 0 1))))

(defn rejected [(result (Result layout/Plan (slice u8)))] (-> i64)
  (match result (Err [_] 0) (Ok [_] 1)))

(defn main [] (-> i64)
  (let [(mut failures)
          (+ (rounded 0 1048576 0)
             (rounded 17 16 32)
             (rounded 0x7FFFFFFFFFFFFFFF 1 0x7FFFFFFFFFFFFFFF))]
    (for value [(: -1 i64) 0 3 6]
      (when (a/valid? value) (set! failures (+ failures 1))))
    (match (a/up 0x7FFFFFFFFFFFFFFF 8)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (when (or (!= (a/exponent 4) 2) (!= (a/exponent 1048576) 20))
      (set! failures (+ failures 1)))
    (match (layout/plan 12 8 0 16384 32 1048576)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [p]
          (when (or (!= (.text-pages p) 16384)
                    (!= (.data-offset p) 1048576)
                    (!= (.data-pages p) 16384)
                    (!= (.size p) 1064960)
                    (!= (.reservation p) 2097152)
                    (!= (.alignment p) 1048576))
            (set! failures (+ failures 1)))))
    (match (layout/plan 12 8 2 4096 65536 64)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [p]
          (when (or (!= (.text-size p) 44)
                    (!= (.data-offset p) 4096)
                    (!= (.size p) 8192)
                    (!= (.reservation p) 69632))
            (set! failures (+ failures 1)))))
    (match (layout/plan 0 8 0 16384 4 65536)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [p]
          (when (or (!= (.text-pages p) 0)
                    (!= (.data-offset p) 0)
                    (!= (.size p) 16384)
                    (!= (.reservation p) 65536))
            (set! failures (+ failures 1)))))
    (set! failures
          (+ failures
             (rejected (layout/plan 0 0 0 16384 4 8))
             (rejected (layout/plan 1 8 0 16384 4 8))
             (rejected (layout/plan 4 -1 0 16384 4 8))
             (rejected (layout/plan 4 8 -1 16384 4 8))
             (rejected (layout/plan 4 8 0 3 4 8))
             (rejected (layout/plan 4 8 0 16384 3 8))
             (rejected (layout/plan 4 8 0 16384 4 7))
             (rejected (layout/plan 0x7FFFFFFFFFFFFFFC 8 1 16384 4 8))
             (rejected (layout/plan 4
                                    1
                                    0
                                    4
                                    0x4000000000000000
                                    0x4000000000000000))))
    (println "checked aligned image/JIT reservation layout: {} failures"
             failures)
    (if (= failures 0) 0 1)))
