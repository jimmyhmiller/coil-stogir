(module stogir.tests.liveness)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.liveness" :as l)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        param (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        dead (require (b/emit! (mut graph) 26 11 [param param]))
        sum (require (b/emit! (mut graph) 27 11 [param param]))
        ret (require (b/emit! (mut graph) 120 11 [start sum (: 0 i32)]))
        (mut live) (l/mark graph [ret ret] allocator)
        (mut failures) 0]
    (when (not (get live (cast i64 start))) (set! failures (+ failures 1)))
    (when (not (get live (cast i64 param))) (set! failures (+ failures 1)))
    (when (not (get live (cast i64 sum))) (set! failures (+ failures 1)))
    (when (not (get live (cast i64 ret))) (set! failures (+ failures 1)))
    (when (get live (cast i64 dead)) (set! failures (+ failures 1)))
    (free! (mut live))
    (g/release! (mut graph))
    (println "liveness checks: {} failures" failures)
    (if (= failures 0) 0 1)))
