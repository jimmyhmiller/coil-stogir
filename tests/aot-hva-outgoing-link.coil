(defn callback-address [(id i32)] (-> u64)
  (match id
    (0 (p/cast u64
               (p/cast (ptr u8)
                       (: (fnptr-of callback0)
                          (fnptr (cc/C) [(ptr u64) u64 H8_1 H8_1] H8_1)))))
    (1 (p/cast u64
               (p/cast (ptr u8)
                       (: (fnptr-of callback1)
                          (fnptr (cc/C)
                                 [(ptr u64)
                                  u64
                                  H8_1
                                  H8_1
