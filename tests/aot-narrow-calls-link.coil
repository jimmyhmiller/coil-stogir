(module stogir.tests.aot-narrow-calls-link)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern stogir.narrow-calls-test
        :as
        "stogir_narrow_calls_test"
        :cc
        (cc/C)
        [u64 i8 u8 i16 u16 i8 bool i32 u32 i8 u8 i16 u16 i8 bool i64 (ptr i64)]
        (-> i64))

(defn mix :cc (cc/C) [(a i8)
                      (b u8)
                      (c i16)
                      (d u16)
                      (e i8)
                      (f bool)
                      (g i32)
                      (h u32)
                      (i i8)
                      (j u8)
                      (k i16)
                      (l u16)
                      (m i8)
                      (n bool)
                      (o i64)
                      (p (ptr i64))] (-> i64)
  (+ (cast i64 a)
     (* (cast i64 b) 3)
     (* (cast i64 c) 5)
     (* (cast i64 d) 7)
     (* (cast i64 e) 11)
     (if f (: 13 i64) 0)
     (* (cast i64 g) 17)
     (* (cast i64 h) 19)
     (* (cast i64 i) 23)
     (* (cast i64 j) 29)
     (* (cast i64 k) 31)
     (* (cast i64 l) 37)
     (* (cast i64 m) 41)
     (if n (: 43 i64) 0)
     (* o 47)
     (* (load p) 53)))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of mix)))
        (mut cell) (: 7001 i64)
        (mut x) (: -128 i64)
        (mut failures) 0]
    (while (<= x 127)
      (let [a (cast i8 x)
            b (cast u8 (+ x 128))
            c (cast i16 (* x 200))
            d (cast u16 (* (+ x 128) 257))
            e (cast i8 (- 0 x))
            flag (!= x 0)
            g (cast i32 (* x 1234))
            h (cast u32 (* x 1234567))
            i (cast i8 (- 0 x))
            j (cast u8 (- 127 x))
            k (cast i16 (* (- 0 x) 201))
            l (cast u16 (* (- 127 x) 257))
            m (cast i8 (+ x 1))
            n (< x 0)
            o (+ (* x 100000) 99)
            expected (mix i j k l m n g h a b c d e flag o (mut cell))
            actual
              (stogir.narrow-calls-test target
                                        a
                                        b
                                        c
                                        d
                                        e
                                        flag
                                        g
                                        h
                                        i
                                        j
                                        k
                                        l
                                        m
                                        n
                                        o
                                        (mut cell))]
        (when (!= actual expected)
          (when (= failures 0)
            (println "x={} expected={} actual={}" x expected actual))
          (set! failures (+ failures 1))))
      (set! x (+ x 1)))
    (println "linked narrow call checks: {} failures" failures)
    (if (= failures 0) 0 1)))
