(module stogir.tests.inputs)
(import "stogir.graph" :as g)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Some None])

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        args [(: -1 i32) 2 -3 4 -5 6 -7 8]
        (mut failures) 0]
    (match (g/append-inputs! (mut graph) 75 11 args)
      (Some [r]
            (do
              (when (!= r 1) (set! failures (+ failures 1)))
              (when (g/contains? graph 2) (set! failures (+ failures 1)))
              (when (g/contains? graph 3) (set! failures (+ failures 1)))
              (let [(mut i) (: 1 i32)]
                (while (<= i 8)
                  (match (g/operand graph r i)
                    (Some [v]
                          (when (!= v (get args (- (cast i64 i) 1)))
                            (set! failures (+ failures 1))))
                    (None [] (set! failures (+ failures 1))))
                  (set! i (+ i 1))))
              (match (g/operand graph r 9)
                (Some [_] (set! failures (+ failures 1)))
                (None [] 0))
              (match (g/operand graph r 0)
                (Some [_] (set! failures (+ failures 1)))
                (None [] 0))))
      (None [] (set! failures (+ failures 1))))
    (g/release! (mut graph))
    (println "input checks: {} failures" failures)
    (if (= failures 0) 0 1)))
