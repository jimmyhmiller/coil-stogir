(module stogir.tests.jit-incoming-fp-layout)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.native.compile" :as compile)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [reference] reference) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        a (require (b/emit! (mut graph) 71 10 [start (: 0 i32) 17]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        wide-a (require (b/emit! (mut graph) 33 11 [a]))
        sum (require (b/emit! (mut graph) 26 11 [x wide-a]))
        ret (require (b/emit! (mut graph) 120 11 [start sum (: 0 i32)]))
        (mut failures) 0]
    ; Nine doubles consume d0–d7 plus one 8-byte stack slot. The first integer
    ; lives in x0 despite ordinal 1; the final int32 follows that FP stack slot.
    (match (calls/create 9
                         11
                         [(: 12 u8)
                          11
                          12
                          12
                          12
                          12
                          12
                          12
                          12
                          12
                          11
                          11
                          11
                          11
                          11
                          11
                          11
                          10]
                         allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype]
            (require (calls/function! (mut graph) owned allocator))
            (calls/release! (mut owned)))))
    (match (compile/text graph start [ret] allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [compiled]
          (let [(mut code) compiled]
            (match (jit/map-text (slice code))
              (Err [_] (set! failures (+ failures 1)))
              (Ok [image]
                  (let [(mut owned) image
                        f
                          (primitive/cast (fnptr (cc/C)
                                                 [f64 i64 f64 f64 f64 f64 f64
                                                  f64 f64 f64 i64 i64 i64 i64
                                                  i64 i64 i64 i32]
                                                 i64)
                                          (.base owned))]
                    (for a [(: -2147483648 i32) -1 0 1 2147483647]
                      (for x [(: -100 i64) -1 0 1 100]
                        (when (!= (call-ptr f
                                            1.5
                                            x
                                            2.5
                                            3.5
                                            4.5
                                            5.5
                                            6.5
                                            7.5
                                            8.5
                                            9.5
                                            11
                                            22
                                            33
                                            44
                                            55
                                            66
                                            77
                                            a)
                                  (+ x (cast i64 a)))
                          (set! failures (+ failures 1)))))
                    (jit/release! (mut owned)))))
            (free! (mut code)))))
    (g/release! (mut graph))
    (println "unused FP parameter layout checks: {} failures" failures)
    (if (= failures 0) 0 1)))
