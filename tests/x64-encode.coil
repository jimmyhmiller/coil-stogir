;;; GENERATED by tools/x86/gen-encode-cases.py from tools/x86/encode_cases.py.
;;; Do not edit: change the case list and regenerate. Expected bytes are what
;;; llvm-mc assembles for the instruction named beside each case.
(module stogir.tests.x64-encode)
(import "stogir.x64.encode" :as e)
(import "stogir.test-data" :use [table])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

;;; One case: the instruction as the assembler reads it, the encoder call, the
;;; bytes llvm-mc assembled for it and the Ok value the call must return. The
;;; call is run when its row is checked, and appends to the buffer it is given.
(defstruct EncodeCase
  [(index i64)
   (assembly (slice u8))
   (encode (fnptr (cc/C) [(mut (ArrayList u8))] (Result i64 (slice u8))))
   (hex (slice u8))
   (field i64)])

;;; A call that must return Err.
(defstruct Rejection
  [(index i64) (encode (fnptr (cc/C) [(mut (ArrayList u8))] (Result i64 (slice u8))))])

;;; `form` with every `$` replaced by `buffer`.
(defn with-buffer [(form Code) (buffer Code)] (-> Code)
  (cond (and (primitive/code-sym? form) (primitive/code-eq form `$)) buffer
        (or (primitive/code-list? form) (primitive/code-vector? form))
          (let [(mut items) (primitive/code-list-new)]
            (for item form (push! (mut items) (with-buffer item buffer)))
            (primitive/code-list-like form (primitive/code-list-done items)))
        :else form))

;;; `(encodings T [cell ...] ...)` is `(table T ...)` whose rows write an
;;; encoder call as the call itself, `$` standing for the output buffer:
;;; `(e/mov-rr $ 64 0 1)` is the cell
;;; `(fn [b] (e/mov-rr (mut b) 64 0 1))`, so listing a row does not run it.
(defn encodings [(type Code) & (rows Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)
        buffer `b]
    (for row rows
      (let [(mut cells) (primitive/code-list-new)]
        (for cell row
          (push! (mut cells)
                 (if (primitive/code-list? cell)
                     `(fn [~buffer] ~(with-buffer cell `(mut ~buffer)))
                     cell)))
        (push! (mut out) `[~@cells])))
    `(table ~type ~@out)))

(defn hex-digit [(value u8)] (-> u8)
  (if (< value 10) (+ value #\0) (+ (- value 10) #\a)))

(defn same-bytes [(b (ArrayList u8)) (hex (slice u8))] (-> bool)
  (if (!= (* (len b) 2) (len hex))
      false
      (let [(mut same) true
            (mut i) (: 0 i64)]
        (while (< i (len b))
          (let [byte (get b i)]
            (when (or (!= (hex-digit (>> byte 4)) (get hex (* i 2)))
                      (!= (hex-digit (& byte 15)) (get hex (+ (* i 2) 1))))
              (set! same false)))
          (set! i (+ i 1)))
        same)))

(defn print-bytes [(b (ArrayList u8))] (-> void)
  (for byte b (print "{:02x}" byte)))

;;; The encoder call has already appended to `b`. Its bytes must be exactly
;;; `hex` and its Ok value `field`. Leaves `b` empty for the next case.
(defn check [(b (mut (ArrayList u8))) (index i64) (assembly (slice u8))
             (result (Result i64 (slice u8))) (hex (slice u8)) (field i64)]
  (-> i64)
  (let [failed
          (match result
            (Ok [actual]
              (if (and (= actual field) (same-bytes b hex))
                  0
                  (do
                    (print "case {} ({}): expected {} field {}, got " index assembly hex field)
                    (print-bytes b)
                    (println " field {}" actual)
                    1)))
            (Err [message]
              (do
                (println "case {} ({}): expected {}, got Err {}" index assembly hex message)
                1)))]
    (clear! (mut b))
    failed))

;;; An invalid operand must return Err and append nothing.
(defn rejected [(b (mut (ArrayList u8))) (index i64)
                (result (Result i64 (slice u8)))] (-> i64)
  (let [failed
          (match result
            (Ok [_]
              (do
                (print "rejection {}: expected Err, got Ok with " index)
                (print-bytes b)
                (println "")
                1))
            (Err [_]
              (if (= (len b) 0)
                  0
                  (do
                    (println "rejection {}: Err but bytes were appended" index)
                    1))))]
    (clear! (mut b))
    failed))
(defn expect [(condition bool) (what (slice u8))] (-> i64)
  (if condition
      0
      (do
        (println "extra check failed: {}" what)
        1)))

(defn field-end [(b (mut (ArrayList u8))) (result (Result i64 (slice u8)))
                 (expected i64)] (-> i64)
  (let [distance (match result (Ok [field] (e/field-to-end b field)) (Err [_] -1))]
    (clear! (mut b))
    (expect (= distance expected) "distance from a patchable field to the instruction end")))

;;; Checks that are not byte comparisons: the condition table, and the distance
;;; from a patchable field to the end of its instruction, which is what a
;;; PC-relative relocation's addend must cancel.
(defn extra-checks [(b (mut (ArrayList u8)))] (-> i64)
  (+ (expect (= (e/invert e/CC-O) e/CC-NO) "invert o")
     (expect (= (e/invert e/CC-NO) e/CC-O) "invert no")
     (expect (= (e/invert e/CC-B) e/CC-AE) "invert b")
     (expect (= (e/invert e/CC-AE) e/CC-B) "invert ae")
     (expect (= (e/invert e/CC-E) e/CC-NE) "invert e")
     (expect (= (e/invert e/CC-NE) e/CC-E) "invert ne")
     (expect (= (e/invert e/CC-BE) e/CC-A) "invert be")
     (expect (= (e/invert e/CC-A) e/CC-BE) "invert a")
     (expect (= (e/invert e/CC-S) e/CC-NS) "invert s")
     (expect (= (e/invert e/CC-NS) e/CC-S) "invert ns")
     (expect (= (e/invert e/CC-P) e/CC-NP) "invert p")
     (expect (= (e/invert e/CC-NP) e/CC-P) "invert np")
     (expect (= (e/invert e/CC-L) e/CC-GE) "invert l")
     (expect (= (e/invert e/CC-GE) e/CC-L) "invert ge")
     (expect (= (e/invert e/CC-LE) e/CC-G) "invert le")
     (expect (= (e/invert e/CC-G) e/CC-LE) "invert g")
     (expect (and (= e/CC-O 0) (= e/CC-B 2) (= e/CC-E 4) (= e/CC-BE 6) (= e/CC-S 8)
                  (= e/CC-P 10) (= e/CC-L 12) (= e/CC-LE 14))
             "condition numbering")
     (expect (and (e/condition? 0) (e/condition? 15) (not (e/condition? 16))
                  (not (e/condition? -1)))
             "condition range")
     (expect (and (= (e/sse-feature e/ADDSD) e/FEATURE-SSE2)
                  (= (e/sse-feature e/PSHUFD) e/FEATURE-SSE2)
                  (= (e/sse-feature e/PSLLW-I) e/FEATURE-SSE2)
                  (= (e/sse-feature e/PMOVMSKB) e/FEATURE-SSE2)
                  (= (e/sse-feature e/MOVDQA) e/FEATURE-SSE2)
                  (= (e/sse-feature e/PSHUFB) e/FEATURE-SSSE3)
                  (= (e/sse-feature e/PMULLD) e/FEATURE-SSE41)
                  (= (e/sse-feature e/PCMPEQQ) e/FEATURE-SSE41)
                  (= (e/sse-feature e/PTEST) e/FEATURE-SSE41)
                  (= (e/sse-feature e/ROUNDSS) e/FEATURE-SSE41)
                  (= (e/sse-feature e/ROUNDSD) e/FEATURE-SSE41))
             "SSE feature levels")
     (field-end (mut b) (e/mov-rm (mut b) 64 0 (e/mem-rip 0)) 4)
     (field-end (mut b) (e/lea (mut b) 64 9 (e/mem-rip 0)) 4)
     (field-end (mut b) (e/sse-rm (mut b) e/ADDSD 32 (e/mem-rip 0)) 4)
     (field-end (mut b) (e/alu-mi (mut b) e/CMP 64 (e/mem-rip 0) 5) 5)
     (field-end (mut b) (e/alu-mi (mut b) e/CMP 8 (e/mem-rip 0) 5) 5)
     (field-end (mut b) (e/alu-mi (mut b) e/CMP 16 (e/mem-rip 0) 4660) 6)
     (field-end (mut b) (e/alu-mi (mut b) e/CMP 32 (e/mem-rip 0) 305419896) 8)
     (field-end (mut b) (e/mov-mi (mut b) 8 (e/mem-rip 0) 1) 5)
     (field-end (mut b) (e/mov-mi (mut b) 16 (e/mem-rip 0) 1) 6)
     (field-end (mut b) (e/mov-mi (mut b) 32 (e/mem-rip 0) 1) 8)
     (field-end (mut b) (e/mov-mi (mut b) 64 (e/mem-rip 0) 1) 8)
     (field-end (mut b) (e/test-mi (mut b) 32 (e/mem-rip 0) 1) 8)
     (field-end (mut b) (e/shift-mi (mut b) e/SHL 64 (e/mem-rip 0) 3) 5)
     (field-end (mut b) (e/shift-mi (mut b) e/SHL 64 (e/mem-rip 0) 1) 4)
     (field-end (mut b) (e/imul-rmi (mut b) 64 0 (e/mem-rip 0) 1000) 8)
     (field-end (mut b) (e/sse-rmi (mut b) e/PSHUFD 32 (e/mem-rip 0) 27) 5)
     (field-end (mut b) (e/pinsr-xm (mut b) 32 32 (e/mem-rip 0) 1) 5)
     (field-end (mut b) (e/call-rel32 (mut b) 0) 4)
     (field-end (mut b) (e/jmp-rel32 (mut b) 0) 4)
     (field-end (mut b) (e/jcc-rel32 (mut b) e/CC-NE 0) 4)
     (field-end (mut b) (e/jmp-rel8 (mut b) 0) 1)
     (field-end (mut b) (e/jcc-rel8 (mut b) e/CC-NE 0) 1)
     (field-end (mut b) (e/movabs-ri (mut b) 0 0) 8)
