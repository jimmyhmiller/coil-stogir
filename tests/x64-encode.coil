(defn main [] (-> i64)
  (let [(mut b) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) (: 0 i64)]
    (for row CASES
      (set! failures
            (+ failures
               (check (mut b) (.index row) (.assembly row)
                      (call-ptr (.encode row) (mut b)) (.hex row) (.field row)))))
    (for row REJECTIONS
      (set! failures
            (+ failures (rejected (mut b) (.index row) (call-ptr (.encode row) (mut b))))))
    (set! failures (+ failures (extra-checks (mut b))))
    (free! (mut b))
    (println "x64 encode: 4981 cases, 189 rejections, {} failures" failures)
    (if (= failures 0) 0 1)))
