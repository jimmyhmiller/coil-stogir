(module stogir.tests.frame-direct-access)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.options" :as options)
(import "stogir.a64.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))

(defn word [(text (slice u8)) (i i64)] (-> u32)
  (| (cast u32 (get text i))
     (<< (cast u32 (get text (+ i 1))) 8)
     (<< (cast u32 (get text (+ i 2))) 16)
     (<< (cast u32 (get text (+ i 3))) 24)))

;;; ADD Xd, SP, #imm (unshifted) into x16.
(defn sp-address-to-x16? [(w u32)] (-> bool)
  (= (& w (: 0xFFC003FF u32)) (: 0x910003F0 u32)))

;;; LDR/STR Xt, [SP, #imm] in the scaled unsigned-offset form.
(defn sp-word-access? [(w u32)] (-> bool)
  (= (& w (: 0xFF8003E0 u32)) (: 0xF90003E0 u32)))

(defn fill :cc (cc/C) [(address (ptr u64))] (-> u64)
  (store! address 1000)
  (store! (p/cast (ptr u64) (+ (p/cast u64 address) 24)) 7)
  0)

;;; A frame object whose fields are read at constant offsets after an opaque
;;; call must be accessed as [sp, #slot+offset], not through an x16 address.
(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 1]))
        size (require (b/scalar-constant! (mut graph) 5 32 8))
        sixteen (require (b/scalar-constant! (mut graph) 5 16 8))
        twenty-four (require (b/scalar-constant! (mut graph) 5 24 8))
        slot (require (b/frame-object! (mut graph) start size 16))
        field (require (b/emit! (mut graph) 26 6 [slot sixteen]))
        last (require (b/emit! (mut graph) 26 6 [slot twenty-four]))
        stored (require (b/emit! (mut graph) 93 0 [slot field x]))]
    (match (calls/create 0 5 [(: 6 u8)] a)
      (Err [e] (panic "{}" e))
      (Ok [proto]
          (let [(mut proto) proto
                called (require (calls/emit! (mut graph) proto stored target [slot] a))
                first (require (b/emit! (mut graph) 91 5 [called slot]))
                middle (require (b/emit! (mut graph) 91 5 [first field]))
                high (require (b/emit! (mut graph) 91 5 [middle last]))
                sum (require (b/emit! (mut graph) 26 5 [first middle]))
                sum (require (b/emit! (mut graph) 26 5 [sum high]))
                ret (require (b/emit! (mut graph) 120 5 [high sum (: 0 i32)]))]
            (calls/release! (mut proto))
            (for level [(: 1 i32) 2 3]
              (match (compile/image-with-options graph start [ret] "_frame_direct"
                                                 (options/Options :level level) a)
                (Err [e] (panic "{}" e))
                (Ok [code]
                    (let [(mut code) code
                          text (slice (.text code))
                          (mut direct) 0]
                      (for [i 0 (/ (len text) 4)]
                        (let [w (word text (* i 4))]
                          (assert (not (sp-address-to-x16? w)))
                          (when (sp-word-access? w) (set! direct (+ direct 1)))))
                      (assert (> direct 0))
                      (match (jit/map-image code a)
                        (Err [e] (panic "{}" e))
                        (Ok [mapped]
                            (let [(mut mapped) mapped
                                  f (p/cast (fnptr (cc/C) [u64 u64] u64) (.base (.memory mapped)))
                                  target (p/cast u64 (p/cast (ptr u8) (fnptr-of fill)))]
                              (for v [(: 0 u64) 5 123456]
                                (assert (= (f target v) (+ 1000 v 7))))
                              (jit/release-image! (mut mapped)))))
                      (image/release! (mut code)))))))))
    (g/release! (mut graph))
    (println "frame fields are addressed directly from the frame base")
    0))
