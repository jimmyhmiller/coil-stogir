(module stogir.tests.vector-unary)
(import "stogir.a64.vector-unary" :as native)
(import "stogir.vector-arithmetic" :as va)
(import "stogir.types" :as types)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as verify)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn check [(opcode i32) (ty i32) (rd i32) (rn i32) (expected (slice u32))]
  (-> i64)
  (let [allocator (malloc-allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) (: 0 i64)]
    (push! (mut output) 165)
    (match (native/emit-registers! (mut output) opcode ty rd rn)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [count]
          (when (!= (cast i64 count) (* (len expected) 4))
            (set! failures (+ failures 1)))))
    (when (!= (len output) (+ 1 (* 4 (len expected))))
      (set! failures (+ failures 1)))
    (let [limit
            (if (< (len output) (+ 1 (* 4 (len expected))))
                (len output)
                (+ 1 (* 4 (len expected))))]
      (while (< i limit)
        (let [wanted
                (if (= i 0)
                    (: 165 u8)
                    (cast u8
                          (>> (get expected (/ (- i 1) 4))
                              (cast u32 (* (% (- i 1) 4) 8)))))]
          (when (!= (get output i) wanted)
            (println "vector unary MC ty{} op{} rd{} rn{} byte{} got{} expected{}"
                     ty
                     opcode
                     rd
                     rn
                     i
                     (get output i)
                     wanted)
            (set! failures (+ failures 1))))
        (set! i (+ i 1))))
    (free! (mut output))
    failures))

(defn contracts [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        a (require (b/emit! (mut graph) 71 37 [start (: 0 i32) 0]))
        b (require (b/emit! (mut graph) 71 61 [start (: 0 i32) 1]))
        c (require (b/emit! (mut graph) 71 22 [start (: 0 i32) 2]))
        storage (require (b/variable! (mut graph) 37 start "storage" 0))
        (mut failures) 0
        before (len (.instructions graph))]
    (for rejected [(b/vector-unary! (mut graph) 26 37 a)
                   (b/vector-binary! (mut graph) 31 37 a a 0)
                   (b/vector-unary! (mut graph) 31 37 b)
                   (b/vector-unary! (mut graph) 31 37 storage)
                   (b/vector-unary! (mut graph) 31 37 0)
                   (b/vector-unary! (mut graph) 31 22 c)
                   (b/vector-unary! (mut graph) 32 37 a)
                   (b/vector-unary! (mut graph) 45 61 b)]
      (match rejected (Err [_] 0) (Ok [_] (set! failures (+ failures 1)))))
    (when (!= (len (.instructions graph)) before)
      (set! failures (+ failures 1)))
    (let [(mut ty) (: 16 i32)
          (mut ordinal) (: 3 i32)]
      (while (< ty 128)
        (when (types/vector? ty)
          (let [input
                  (require (b/emit! (mut graph) 71 ty [start (: 0 i32) ordinal]))]
            (set! ordinal (+ ordinal 1))
            (for opcode [(: 31 i32) 32 45 54 55 56 57]
              (when (va/valid-type? opcode ty)
                (let [result
                        (require (b/vector-unary! (mut graph) opcode ty input))]
                  (match (va/validate graph result)
                    (Err [_] (set! failures (+ failures 1)))
                    (Ok [actual]
                        (when (!= actual ty) (set! failures (+ failures 1))))))))))
        (set! ty (+ ty 1))))
    ; The raw graph can contain wide values; target emission still rejects them.
    (match (verify/integer-operations graph)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [_] 0))
    (let [bad (require (b/emit! (mut graph) 31 37 [b]))]
      (match (verify/integer-operations graph)
        (Err [_] 0)
        (Ok [_] (set! failures (+ failures 1)))))
    (g/release! (mut graph))
    (let [(mut output) (ArrayList::new [u8] allocator)]
      (push! (mut output) 165)
      (for rejected [(native/emit-registers! (mut output) 26 37 0 1)
                     (native/emit-registers! (mut output) 31 53 0 1)
                     (native/emit-registers! (mut output) 31 37 -1 1)
                     (native/emit-registers! (mut output) 31 37 0 32)
                     (native/emit-registers! (mut output) 32 37 0 1)
                     (native/emit-registers! (mut output) 45 61 0 1)]
        (match rejected (Err [_] 0) (Ok [_] (set! failures (+ failures 1)))))
      (when (or (!= (len output) 1) (!= (get output 0) 165))
        (set! failures (+ failures 1)))
      (free! (mut output)))
    failures))

