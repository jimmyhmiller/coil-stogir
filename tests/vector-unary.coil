(defn main [] (-> i64)
  (let [(mut failures) (contracts)]
    (for row CHECK-CASES
      (set! failures
            (+ failures
               (check (.opcode row)
                      (.ty row)
                      (.rd row)
                      (.rn row)
                      (.expected row)))))
    (println "vector unary contracts and 528 register cases/940 independent MC words: {} failures"
             failures)
    (if (= failures 0) 0 1)))
