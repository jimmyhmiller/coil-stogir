(module stogir.tests.a64-callee-saved-layout)
(import "stogir.a64.callee-saved" :as callee)
(import "stogir.allocation" :as allocation)
(import "stogir.interval" :as interval)
(import "stogir.frame" :as frame)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn main [] (-> i32)
  (let [a (malloc-allocator)
        (mut parts) (ArrayList::new [allocation/Part] a)
        (mut area) (frame/create a)]
    (for [reg 0 32]
      (let [(mut part) (allocation/create 1 a)]
        (set! (.register part) (cast i32 reg))
        (push! (mut (.ranges part)) (interval/Range :start 0 :end 4))
        (push! (mut parts) part)
        (match (callee/layout! parts (mut area))
          (Err [message] (panic "{}" message))
          (Ok [saved]
              (let [expected
                      (if (< reg 19)
                          (: 0 u64)
                          (if (> reg 28)
                              (: 536346624 u64)
                              (get [(: 524288 u64)
                                    1572864
                                    3670016
                                    7864320
                                    16252928
                                    33030144
                                    66584576
                                    133693440
                                    267911168
                                    536346624]
                                   (- reg 19))))]
                (assert (= (.mask saved) expected))
                (assert (= (>= (.offset saved) 0) (>= reg 19))))))))
    (for [i 0 (len parts)]
      (allocation/release! (elem (mut parts) i)))
    (free! (mut parts))
    (frame/release! (mut area)))
  0)
