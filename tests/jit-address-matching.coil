(module stogir.tests.jit-address-matching)
(import "stogir.graph" :as g)
(import "stogir.a64.address" :as address)
(import "stogir.symbols" :as symbols)
(import "stogir.builder" :as b)
(import "stogir.types" :as types)
(import "stogir.pipeline" :as pipeline)
(import "stogir.a64.match" :as matching)
(import "stogir.a64.compile" :as compile)
(import "stogir.a64.memory" :as memory)
(import "stogir.a64.code" :as code)
(import "stogir.allocation" :as allocation)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

;;; Expected encoding ranges are independent of the selector implementation.
(defn encodable? [(bytes i32) (offset i64)] (-> bool)
  (or (and (>= offset -256) (< offset 256))
      (and (>= offset 0)
           (= (% offset (cast i64 bytes)) 0)
           (< offset (* (cast i64 bytes) 4096)))))

;;; Shape 0 is the old direct ADDR ADD. Shapes 1/2 use the compiler's
;;; word ADD followed by a pointer cast; 3 commutes the constant, 4 has
;;; multiple full-width views, 5 uses a numeric ADDR literal, 6 exceeds the
;;; bounded view walk and must conservatively retain its original expression.
(defn offset-address! [(graph (mut g/Graph))
                       (base i32)
                       (offset i64)
                       (shape i32)] (-> i32)
  (let [word-type (if (= shape 2) (: 11 i32) 5)
        delta
          (require (b/scalar-constant! (mut graph)
                                       (if (= shape 5) 6 word-type)
                                       (cast u64 offset)
                                       8))
        raw
          (if (or (= shape 0) (= shape 5) (= shape 6))
              (require (b/emit! (mut graph) 26 6 [base delta]))
              (let [word (require (b/emit! (mut graph) 36 word-type [base]))
                    sum
                      (require (b/emit! (mut graph)
                                        26
                                        word-type
                                        (if (= shape 3)
                                            [delta word]
                                            [word delta])))]
                (require (b/emit! (mut graph) 36 6 [sum]))))
        (mut result) raw]
    (when (or (= shape 4) (= shape 6))
      (for [i 0 (if (= shape 6) 21 3)]
        (set! result
              (require (b/emit! (mut graph)
                                36
                                (case (% i 3) 0 (: 5 i32) 1 11 6)
                                [result])))))
    result))

(defn literal-kinds [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        base (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))]
    (for kind [(: 6 i32) 73 74 75 77]
      (let [delta
              (require (case kind
                         6 (b/scalar-constant! (mut graph) 6 8 8)
                         73 (symbols/function-address! (mut graph) 8 0)
                         74 (symbols/function! (mut graph) "_offset" 0)
                         75 (symbols/symbol! (mut graph) "_offset")
                         (symbols/string! (mut graph) "_offset")))
            sum (require (b/emit! (mut graph) 26 6 [base delta]))]
        (match (address/select graph sum 8)
          (None [] (assert (and (!= kind 6) (!= kind 73))))
          (Some [selected]
                (assert (or (= kind 6) (= kind 73)))
                (assert (= (.base selected) base))
                (assert (= (.offset selected) 8))))))
    (g/release! (mut graph))))

;;; Variant 0: ordinary shared address; 1: rooted address; 2: HARD COPY barrier;
;;; 3: address escapes as return; 4: mixed-width memory sharing.
(defn check [(ty i32) (offset i64) (variant i32) (shape i32)] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        source (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        destination (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        address (offset-address! (mut graph) source offset shape)
        target (offset-address! (mut graph) destination offset shape)
        actual-address
          (if (= variant 2)
              (require (b/emit! (mut graph) 68 6 [address (: 1 i32)]))
              address)
        loaded (require (b/emit! (mut graph) 91 ty [start actual-address]))
        extra
          (if (= variant 4)
              (require (b/emit! (mut graph) 91 2 [loaded address]))
              loaded)
        stored (require (b/emit! (mut graph) 93 0 [extra target loaded]))
        result
          (if (= variant 3)
              (require (b/emit! (mut graph) 36 5 [address]))
              (require (b/scalar-constant! (mut graph) 5 0 8)))
        returned (require (b/emit! (mut graph) 120 5 [stored result (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)
        bytes (types/size ty 8)
        selected (and (!= shape 6) (!= variant 2) (encodable? bytes offset))
        omitted
          (and (!= shape 6)
               (!= variant 1)
               (!= variant 2)
               (!= variant 3)
               (encodable? bytes offset)
               (or (!= variant 4) (encodable? 1 offset)))
        (mut failures) 0]
    (push! (mut roots) returned)
    (when (= variant 1) (push! (mut roots) address))
    (match (pipeline/prepare graph start (slice roots) a)
      (Err [message] (panic "{}" message))
      (Ok [prepared]
          (let [(mut prepared) prepared]
            (match (matching/build graph
                                   (.schedule prepared)
                                   (slice roots)
                                   true
                                   a)
              (Err [message] (panic "{}" message))
              (Ok [plan]
                  (let [(mut plan) plan
                        range (get (.ranges (.operands plan)) (cast i64 loaded))]
                    (when (!= (> (get (.addresses plan) (cast i64 loaded)) 0)
                              selected)
                      (set! failures (+ failures 1)))
                    (when (!= (get (.omitted (.operands plan))
                                   (cast i64 address))
                              omitted)
                      (set! failures (+ failures 1)))
                    (when (!= (.count range) 1) (set! failures (+ failures 1)))
                    (when (!= (get (.inputs (.operands plan)) (.offset range))
                              (if selected source actual-address))
                      (set! failures (+ failures 1)))
                    (when selected
                      (when (!= (get (.offsets plan) (cast i64 loaded)) offset)
                        (set! failures (+ failures 1))))
                    (matching/release! (mut plan)))))
            (pipeline/release! (mut prepared)))))
    (match (compile/text graph start (slice roots) a)
      (Err [message] (panic "{}" message))
      (Ok [text]
          (let [(mut text) text]
            (match (jit/map-text (slice text))
              (Err [message] (panic "{}" message))
              (Ok [mapped]
                  (let [(mut mapped) mapped
                        function
                          (p/cast (fnptr (cc/C) [(ptr u8) (ptr u8)] u64)
                                  (.base mapped))
                        (mut input) (ArrayList::new [u8] a)
                        (mut output) (ArrayList::new [u8] a)]
                    (for [i 0 66064]
                      (push! (mut input) (cast u8 (+ (* i 137) 253)))
                      (push! (mut output) (: 0xA5 u8)))
                    (let [src (p/index (.data input) 512)
                          dst (p/index (.data output) 512)
                          answer (function src dst)]
                      (when (!= answer
                                (if (= variant 3)
                                    (cast u64
                                          (+ (cast i64 (p/cast u64 src)) offset))
                                    (: 0 u64)))
                        (set! failures (+ failures 1)))
                      (for [i 0 66064]
                        (let [inside
                                (and (>= i (+ 512 offset))
                                     (< i (+ (+ 512 offset) (cast i64 bytes))))]
                          (when (!= (get output i)
                                    (if inside (get input i) (: 0xA5 u8)))
                            (set! failures (+ failures 1))))))
                    (free! (mut input))
                    (free! (mut output))
                    (jit/release! (mut mapped)))))
            (free! (mut text)))))
    (free! (mut roots))
    (g/release! (mut graph))
    (when (!= failures 0)
      (println "address ty={} offset={} variant={} shape={} failures={}"
               ty
               offset
               variant
               shape
               failures))
    failures))

(defn check-indexed [(ty i32) (offset i64) (variant i32) (shape i32)] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        source (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        destination (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        index (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 2]))
        shift (case (types/size ty 8) 1 (: 0 i32) 2 1 4 2 8 3 16 4 -1)
        amount (require (b/scalar-constant! (mut graph) 5 (cast u64 shift) 8))
        factor (require (b/scalar-constant! (mut graph) 5 (cast u64 (types/size ty 8)) 8))
        scaled (require (b/emit! (mut graph) (if (= shape 2) 28 49) 5
                                 [index (if (= shape 2) factor amount)]))
        selected-index (if (= shape 0) index scaled)
        source-word (require (b/emit! (mut graph) 36 5 [source]))
        target-word (require (b/emit! (mut graph) 36 5 [destination]))
        source-sum (require (b/emit! (mut graph) 26 5 [selected-index source-word]))
        target-sum (require (b/emit! (mut graph) 26 5 [selected-index target-word]))
        address (if (= shape 2) (require (b/emit! (mut graph) 36 6 [source-sum]))
                    (require (b/emit! (mut graph) 26 6 [source selected-index])))
        target (if (= shape 2) (require (b/emit! (mut graph) 36 6 [target-sum]))
                   (require (b/emit! (mut graph) 26 6 [destination selected-index])))
        actual-address
          (if (= variant 2)
              (require (b/emit! (mut graph) 68 6 [address (: 1 i32)]))
              address)
        loaded (require (b/emit! (mut graph) 91 ty [start actual-address]))
        extra
          (if (= variant 4)
              (require (b/emit! (mut graph) 91 2 [loaded address]))
              loaded)
        stored (require (b/emit! (mut graph) 93 0 [extra target loaded]))
        result
          (if (= variant 3)
              (require (b/emit! (mut graph) 36 5 [address]))
              (require (b/scalar-constant! (mut graph) 5 0 8)))
        returned (require (b/emit! (mut graph) 120 5 [stored result (: 0 i32)]))
        (mut roots) (ArrayList::new [i32] a)
        bytes (types/size ty 8)
        effective-offset (* offset (if (= shape 0) 1 (cast i64 bytes)))
        selected (!= variant 2)
        omitted (and (!= variant 1) (!= variant 2) (!= variant 3))
        (mut failures) 0]
    (push! (mut roots) returned)
    (when (= variant 1) (push! (mut roots) address))
    (match (pipeline/prepare graph start (slice roots) a)
      (Err [message] (panic "{}" message))
      (Ok [prepared]
          (let [(mut prepared) prepared]
            (match (matching/build graph
                                   (.schedule prepared)
                                   (slice roots)
                                   true
                                   a)
              (Err [message] (panic "{}" message))
              (Ok [plan]
                  (let [(mut plan) plan
                        range (get (.ranges (.operands plan)) (cast i64 loaded))]
                    (when (!= (> (get (.addresses plan) (cast i64 loaded)) 0)
                              selected)
                      (set! failures (+ failures 1)))
                    (when (!= (get (.omitted (.operands plan))
                                   (cast i64 address))
                              omitted)
                      (set! failures (+ failures 1)))
                    (when (!= (.count range) (if selected 2 1)) (set! failures (+ failures 1)))
                    (when (!= (get (.inputs (.operands plan)) (.offset range))
                              (if selected (if (= shape 2) scaled source) actual-address))
                      (set! failures (+ failures 1)))
                    (when selected
                      (for [i 0 (.count range)]
                        (let [input (get (.inputs (.operands plan)) (+ (.offset range) i))]
                          (when (> input 0)
                            (assert (not (get (.omitted (.operands plan)) (cast i64 input)))))))
                      (when (!= (get (.offsets plan) (cast i64 loaded)) 0)
                        (set! failures (+ failures 1))))
                    (matching/release! (mut plan)))))
            (pipeline/release! (mut prepared)))))
    (match (compile/text graph start (slice roots) a)
      (Err [message] (panic "{}" message))
      (Ok [text]
          (let [(mut text) text]
            (match (jit/map-text (slice text))
              (Err [message] (panic "{}" message))
              (Ok [mapped]
                  (let [(mut mapped) mapped
                        function
                          (p/cast (fnptr (cc/C) [(ptr u8) (ptr u8) i64] u64)
                                  (.base mapped))
                        (mut input) (ArrayList::new [u8] a)
                        (mut output) (ArrayList::new [u8] a)]
                    (for [i 0 66064]
                      (push! (mut input) (cast u8 (+ (* i 137) 253)))
                      (push! (mut output) (: 0xA5 u8)))
                    (let [src (p/index (.data input) 512)
                          dst (p/index (.data output) 512)
                          answer (function src dst offset)]
                      (when (!= answer
                                (if (= variant 3)
                                    (cast u64
                                          (+ (cast i64 (p/cast u64 src)) effective-offset))
                                    (: 0 u64)))
                        (set! failures (+ failures 1)))
                      (for [i 0 66064]
                        (let [inside
                                (and (>= i (+ 512 effective-offset))
                                     (< i (+ (+ 512 effective-offset) (cast i64 bytes))))]
                          (when (!= (get output i)
                                    (if inside (get input i) (: 0xA5 u8)))
                            (set! failures (+ failures 1))))))
                    (free! (mut input))
                    (free! (mut output))
                    (jit/release! (mut mapped)))))
            (free! (mut text)))))
    (free! (mut roots))
    (g/release! (mut graph))
    (when (!= failures 0)
      (println "address ty={} offset={} variant={} shape={} failures={}"
               ty
               offset
               variant
               shape
               failures))
    failures))

;;; Forty independent volatile loads remain observable across the store.
;;; Their final sum checks reloads and the selected base/index live ranges.
(defn indexed-pressure [] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        source (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        index (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 2]))
        three (require (b/scalar-constant! (mut graph) 5 3 8))
        scaled (require (b/emit! (mut graph) 49 5 [index three]))
        address (require (b/emit! (mut graph) 26 6 [source scaled]))
        output (require (b/emit! (mut graph) 26 6 [target scaled]))
        literal (require (b/scalar-constant! (mut graph) 5 128 8))
        (mut control) start
        (mut values) (ArrayList::new [i32] a)
        (mut roots) (ArrayList::new [i32] a)]
    (for [i 0 40]
      (set! control (require (b/emit! (mut graph) 92 5 [control address])))
      (push! (mut values) control))
    (let [stored (require (b/emit! (mut graph) 94 0 [control output literal]))
          (mut result) (get values 0)]
      (for [i 1 (len values)]
        (set! result (require (b/emit! (mut graph) 26 5 [result (get values i)]))))
      (push! (mut roots) (require (b/emit! (mut graph) 120 5 [stored result (: 0 i32)]))))
    (match (compile/text graph start (slice roots) a)
      (Err [message] (panic "{}" message))
      (Ok [text]
        (let [(mut text) text]
          (match (jit/map-text (slice text))
            (Err [message] (panic "{}" message))
            (Ok [mapped]
              (let [(mut mapped) mapped
                    function (p/cast (fnptr (cc/C) [(ptr u8) (ptr u8) i64] u64) (.base mapped))
                    (mut input) (ArrayList::new [u8] a)
                    (mut output) (ArrayList::new [u8] a)]
                (for [i 0 2048]
                  (push! (mut input) (cast u8 (+ (* i 137) 253)))
                  (push! (mut output) (: 0xA5 u8)))
                (for index [(: -7 i64) 0 1 31]
                  (for [i 0 2048] (set! (mut output) i (: 0xA5 u8)))
                  (let [offset (+ 512 (* index 8)) (mut word) (: 0 u64)]
                    (for [i 0 8]
                      (set! word (| word (<< (cast u64 (get input (+ offset i))) (cast u64 (* i 8))))))
                    (assert (= (function (p/index (.data input) 512)
                                         (p/index (.data output) 512) index)
                               (* word (: 40 u64))))
                    (for [i 0 2048]
                      (assert (= (get output i)
                        (if (and (>= i offset) (< i (+ offset 8)))
                            (if (= i offset) (: 128 u8) (: 0 u8)) (: 0xA5 u8)))))))
                (free! (mut input)) (free! (mut output))
                (jit/release! (mut mapped)))))
          (free! (mut text)))))
    (free! (mut values)) (free! (mut roots)) (g/release! (mut graph))))

(defn invalid-references [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        (mut output) (code/create a)
        (mut parts) (ArrayList::new [allocation/Part] a)
        (mut failures) 0]
    (for reference [(: 0 i32) -1 999]
      (match (memory/emit! (mut output) graph parts reference 0)
        (Err [_] 0)
        (Ok [_] (set! failures (+ failures 1)))))
    (when (!= (len (.text output)) 0) (set! failures (+ failures 1)))
    (free! (mut parts))
    (code/release! (mut output))
    (g/release! (mut graph))
    failures))

;;; Independent expected address geometry; selection never rewrites the graph.
(defn indexed-selection-cases [] (-> void)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        base (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        index (require (b/emit! (mut graph) 71 5 [start (: 1 i32) 0]))]
    (for width [(: 1 i32) 2 4 8 16]
      (for amount [(: 0 i32) 1 2 3 4 5 63 64]
        (let [literal (require (b/scalar-constant! (mut graph) 5 (cast u64 amount) 8))
              shifted (require (b/emit! (mut graph) 49 5 [index literal]))
              sum (require (b/emit! (mut graph) 26 6 [base shifted]))
              copied (require (b/emit! (mut graph) 68 6 [sum (: 0 i32)]))
              before (len (.instructions graph))
              expected (case width 1 (: 0 i32) 2 1 4 2 8 3 16 4 -1)]
          (match (address/select-indexed graph sum width)
            (None [] (panic "indexed address not recognized"))
            (Some [chosen]
              (assert (= (.base chosen) base))
              (assert (= (.index chosen) (if (= amount expected) index shifted)))
              (assert (= (.shift chosen) (if (= amount expected) expected 0)))))
          (match (address/select-indexed graph copied width)
            (Some [_] (panic "COPY barrier bypassed")) (None [] 0))
          (assert (= before (len (.instructions graph)))))))
    (let [sum (require (b/emit! (mut graph) 26 6 [base index]))]
      (for width [(: -1 i32) 0 3 32]
        (match (address/select-indexed graph sum width)
          (Some [_] (panic "invalid indexed width accepted")) (None [] 0)))
      (for ref [(: -2147483648 i32) 0 2147483647]
        (match (address/select-indexed graph ref 8)
          (Some [_] (panic "missing indexed address accepted")) (None [] 0))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (indexed-selection-cases)
  (indexed-pressure)
  (for ty [(: 2 i32) 3 4 5 8 9 10 11 12 13 (types/vector-type 2 16) (types/vector-type 4 4) (types/vector-type 5 2)]
    (for offset [(: -7 i64) 0 1 31]
      (for variant [(: 0 i32) 1 2 3 4]
        (for shape [(: 0 i32) 1 2]
          (assert (= (check-indexed ty offset variant shape) 0))))))
  (assert (= (check 5 16 0 1) 0))
  (literal-kinds)
  (let [(mut failures) (invalid-references)]
    (for ty [(: 2 i32)
             3
             4
             5
             8
             9
             10
             11
             12
             13
             (types/vector-type 2 16)
             (types/vector-type 3 8)
             (types/vector-type 4 4)
             (types/vector-type 5 2)]
      (let [bytes (cast i64 (types/size ty 8))]
        (for offset [(: -257 i64)
                     -256
                     -1
                     0
                     1
                     255
                     256
                     257
                     (* bytes 4095)
                     (* bytes 4096)]
          (for variant [(: 0 i32) 1 2 3 4]
            (set! failures (+ failures (check ty offset variant 0)))))))
    (for ty [(: 2 i32) 5 13 (types/vector-type 2 16)]
      (let [bytes (cast i64 (types/size ty 8))]
        (for offset [(: -256 i64) -1 16 255 256 (* bytes 4095) (* bytes 4096)]
          (for shape [(: 1 i32) 2 3 4 5]
            (for variant [(: 0 i32) 1 2 3 4]
              (set! failures (+ failures (check ty offset variant shape))))))))
    (set! failures (+ failures (check 5 16 0 6)))
    (println "matched memory address checks: {} failures" failures)
    (if (= failures 0) 0 1)))
