(module stogir.tests.jit-bitwise)
(import "stogir.jit.darwin" :as jit)
(import "stogir.a64.encode" :as e)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.a64.select" :as select)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.compile" :as compile)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defstruct LogicalCase [(mask u64) (wide bool) (offset i64)])

;;; Enumerate masks by their mathematical circular bit positions, independently
;;; of the encoder's period/run analysis. Hardware execution is the word oracle.
(defn logical-native-check [] (-> i64)
  (let [a (malloc-allocator)
        (mut code) (ArrayList::new [u8] a)
        (mut cases) (ArrayList::new [LogicalCase] a)
        (mut failures) 0]
    (for wide [false true]
      (let [width (if wide 64 32)
            (mut element) 2]
        (while (<= element width)
          (for [ones 1 element]
            (for [rotation 0 element]
              (let [(mut mask) (: 0 u64)]
                (for [bit 0 width]
                  (when (< (% (+ bit rotation) element) ones)
                    (set! mask (| mask (<< (: 1 u64) (cast u64 bit))))))
                (match (e/logical-mask wide mask)
                  (None [] (set! failures (+ failures 1)))
                  (Some [fields]
                        (push! (mut cases)
                               (LogicalCase
                                 :mask mask
                                 :wide wide
                                 :offset (len code)))
                        (for [operation 0 3]
                          (match (e/logical-immediate wide
                                                      (cast i32 operation)
                                                      0
                                                      0
                                                      fields)
                            (Err [_]
                                 (set! failures (+ failures 1))
                                 (bytes/append32! (mut code) 0xD503201F))
                            (Ok [word] (bytes/append32! (mut code) word)))
                          (bytes/append32! (mut code) 0xD65F03C0)))))))
          (set! element (* element 2)))))
    (when (!= (len cases) 6636) (set! failures (+ failures 1)))
    (match (jit/map-text (slice code))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [mapped]
          (let [(mut mapped) mapped]
            (for spec cases
              (for [operation 0 3]
                (let [address
                        (primitive/index (.base mapped)
                                         (+ (.offset spec) (* operation 8)))]
                  (for value [(: 0 u64)
                              1
                              0xFFFFFFFFFFFFFFFF
                              0x8000000080000000
                              0x0123456789ABCDEF]
                    (let [expected
                            (case operation
                              0 (& value (.mask spec))
                              1 (| value (.mask spec))
                              (^ value (.mask spec)))
                          answer
                            (if (.wide spec)
                                (let [f
                                        (primitive/cast (fnptr (cc/C) [u64] u64)
                                                        address)]
                                  (f value))
                                (let [f
                                        (primitive/cast (fnptr (cc/C) [u32] u32)
                                                        address)]
                                  (cast u64 (f (cast u32 value)))))]
                      (when (!= answer
                                (if (.wide spec)
                                    expected
                                    (& expected 0xFFFFFFFF)))
                        (set! failures (+ failures 1))))))))
            (jit/release! (mut mapped)))))
    (for wide [false true]
      (for value [(: 0 u64) 0xFFFFFFFFFFFFFFFF 0x0123456789ABCDEF]
        (match (e/logical-mask wide value)
          (None [] 0)
          (Some [_] (set! failures (+ failures 1))))))
    (free! (mut cases))
    (free! (mut code))
    failures))

(defn logical-compiled-case [(ty i32)
                             (op i32)
                             (bits u64)
                             (constant-first bool)
                             (immediate? bool)] (-> i64)
  (let [a (malloc-allocator)
        wide (or (= ty 5) (= ty 11))
        width (case ty 1 1 2 8 8 8 3 16 9 16 4 32 10 32 64)
        word-mask
          (if wide
              (: 0xFFFFFFFFFFFFFFFF u64)
              (- (<< (: 1 u64) (cast u64 width)) 1))
        mask (& bits word-mask)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        arg (require (b/emit! (mut graph) 71 ty [start (: 0 i32) 0]))
        literal (require (b/scalar-constant! (mut graph) ty mask 8))
        value
          (require (b/emit! (mut graph)
                            op
                            ty
                            (if constant-first [literal arg] [arg literal])))
        ret (require (b/emit! (mut graph) 120 ty [start value (: 0 i32)]))
        (mut failures) 0]
    (match (select/arithmetic graph value)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [tile]
          (when (or (!= (.rule tile) (+ (if immediate? 41 6) (- op 46)))
                    (!= (.wide tile) wide)
                    (and immediate?
                         (or (!= (.left tile) arg) (!= (.right tile) 0))))
            (set! failures (+ failures 1)))))
    (match (compile/text graph start [ret] a)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [text]
          (let [(mut text) text]
            (match (jit/map-text (slice text))
              (Err [_] (set! failures (+ failures 1)))
              (Ok [mapped]
                  (let [(mut mapped) mapped]
                    (for input [(: 0 u64)
                                1
                                0xFFFFFFFFFFFFFFFF
                                0x8000000080000000
                                0x0123456789ABCDEF]
                      (let [expected
                              (case op
                                46 (| input mask)
                                47 (& input mask)
                                (^ input mask))
                            answer
                              (case ty
                                1
                                  (let [f
                                          (primitive/cast (fnptr (cc/C)
                                                                 [bool]
                                                                 bool)
                                                          (.base mapped))]
                                    (if (f (!= (& input 1) 0)) (: 1 u64) 0))
                                2
                                  (let [f
                                          (primitive/cast (fnptr (cc/C) [u8] u8)
                                                          (.base mapped))]
                                    (cast u64 (f (cast u8 input))))
                                8
                                  (let [f
                                          (primitive/cast (fnptr (cc/C) [i8] i8)
                                                          (.base mapped))]
                                    (cast u64 (cast u8 (f (cast i8 input)))))
                                3
                                  (let [f
                                          (primitive/cast (fnptr (cc/C)
                                                                 [u16]
                                                                 u16)
                                                          (.base mapped))]
                                    (cast u64 (f (cast u16 input))))
                                9
                                  (let [f
                                          (primitive/cast (fnptr (cc/C)
                                                                 [i16]
                                                                 i16)
                                                          (.base mapped))]
                                    (cast u64 (cast u16 (f (cast i16 input)))))
                                4
                                  (let [f
                                          (primitive/cast (fnptr (cc/C)
                                                                 [u32]
                                                                 u32)
                                                          (.base mapped))]
                                    (cast u64 (f (cast u32 input))))
                                10
                                  (let [f
                                          (primitive/cast (fnptr (cc/C)
                                                                 [i32]
                                                                 i32)
                                                          (.base mapped))]
                                    (cast u64 (cast u32 (f (cast i32 input)))))
                                11
                                  (let [f
                                          (primitive/cast (fnptr (cc/C)
                                                                 [i64]
                                                                 i64)
                                                          (.base mapped))]
                                    (cast u64 (f (cast i64 input))))
                                (let [f
                                        (primitive/cast (fnptr (cc/C) [u64] u64)
                                                        (.base mapped))]
                                  (f input)))]
                        (when (!= answer
                                  (& expected word-mask))
                          (set! failures (+ failures 1)))))
                    (jit/release! (mut mapped)))))
            (free! (mut text)))))
    (g/release! (mut graph))
    failures))

;;; Direct selected emission accepts full u64 ABI inputs, deliberately retaining
;;; dirty upper bits. Check low-width semantics independently, including rd
;;; aliasing either source, unsigned/signed extension, and boolean byte width.
(defn narrow-register-check [] (-> i64)
  (let [a (malloc-allocator) (mut failures) 0]
    (for ty [(: 1 i32) 2 3 7 8 9]
      (let [bits (if (or (= ty 3) (= ty 9)) (: 16 i32) 8)
            mask (if (= bits 8) (: 255 u64) 65535)
            signed? (or (= ty 7) (= ty 8) (= ty 9))]
        (for opcode [(: 46 i32) 47 48]
          (for destination [(: 0 i32) 1 2]
            (let [(mut code) (ArrayList::new [u8] a)
                  tile (select/Tile :rule (+ 6 (- opcode 46)) :wide false
                                     :left 1 :right 2 :immediate 0)]
              (match (emit/narrow! (mut code) tile opcode ty bits destination 0 1)
                (Err [message] (panic "{}" message)) (Ok [_] 0))
              (when (!= destination 0)
                (match (e/logical-shifted false 1 0 31 destination 0)
                  (Err [message] (panic "{}" message))
                  (Ok [word] (bytes/append32! (mut code) word))))
              (bytes/append32! (mut code) 0xD65F03C0)
              (match (jit/map-text (slice code))
                (Err [message] (panic "{}" message))
                (Ok [owned]
                  (let [(mut image) owned
                        f (primitive/cast (fnptr (cc/C) [u64 u64] u64) (.base image))]
                    (for left [(: 0 u64) 1 127 128 255 32768 65535
                               0x123456789ABCDEF0 0xFFFFFFFFFFFFFFFF]
                      (for right [(: 0 u64) 1 128 255 32768 65535
                                  0xFEDCBA9876543210 0xFFFFFFFFFFFFFFFF]
                        (let [raw (& mask (case opcode 46 (| left right)
                                                   47 (& left right) (^ left right)))
                              expected (if (and signed?
                                                (!= (& raw (<< (: 1 u64) (cast u64 (- bits 1)))) 0))
                                           (| raw (& (^ mask 0xFFFFFFFFFFFFFFFF) 0xFFFFFFFF)) raw)]
                          (when (!= (f left right) expected)
                            (set! failures (+ failures 1))))))
                    (unless (jit/release! (mut image)) (set! failures (+ failures 1))))))
              (free! (mut code)))))))
    failures))

(defn main [] (-> i64)
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) (+ (logical-native-check) (narrow-register-check))]
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
          constant (require (b/scalar-constant! (mut graph) 11 42 8))
          sum (require (b/emit! (mut graph) 47 11 [p constant]))
          product (require (b/emit! (mut graph) 48 11 [sum q]))
          ret (require (b/emit! (mut graph) 120 11 [start product (: 0 i32)]))]
      (match (compile/text graph start [ret] (malloc-allocator))
        (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
        (Ok [compiled]
            (let [(mut code) compiled]
              (for byte code (push! (mut text) byte))
              (free! (mut code)))))
      (g/release! (mut graph)))
    (match (jit/map-text (slice text))
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [image]
          (let [(mut owned) image
                f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (.base owned))]
            (when (!= (call-ptr f 100 2) (^ (& 100 42) 2))
              (set! failures (+ failures 1)))
            (when (!= (call-ptr f -42 5) (^ (& -42 42) 5))
              (set! failures (+ failures 1)))
            (let [(mut x) -100]
              (while (<= x 100)
                (let [(mut y) -4]
                  (while (<= y 4)
                    (when (!= (call-ptr f x y) (^ (& x 42) y))
                      (set! failures (+ failures 1)))
                    (set! y (+ y 1))))
                (set! x (+ x 1))))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1)))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1))))))
    (for ty [(: 4 i32) 10 5 11]
      (for op [(: 46 i32) 47 48]
        (for first [false true]
          (for mask [(: 31 u64)
                     0xFFFF0000FFFF0000
                     0x8000000180000001
                     0x5555555555555555]
            (set! failures
                  (+ failures (logical-compiled-case ty op mask first true))))
          (for mask [(: 0 u64) 0xFFFFFFFFFFFFFFFF 0x0123456789ABCDEF]
            (set! failures
                  (+ failures (logical-compiled-case ty op mask first false)))))))
    (for ty [(: 2 i32) 8 3 9]
      (for op [(: 46 i32) 47 48]
        (for first [false true]
          (for mask [(: 1 u64) 3 15 31 128 240 255 65535]
            (set! failures
                  (+ failures (logical-compiled-case ty op mask first true))))
          (for mask [(: 0 u64) 42 85 129]
            (set! failures
                  (+ failures (logical-compiled-case ty op mask first false)))))))
    (for op [(: 46 i32) 47 48]
      (for first [false true]
        (set! failures
              (+ failures
                 (logical-compiled-case 1 op 1 first true)
                 (logical-compiled-case 1 op 0 first false)))))
    (free! (mut text))
    (println "compiled bitwise checks: {} failures" failures)
    (if (= failures 0) 0 1)))
