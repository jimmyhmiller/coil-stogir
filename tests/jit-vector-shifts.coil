(defn fixture-name [(id i32)] (-> (slice u8))
  (block :found
    (for fixture FIXTURES
      (when (= (.id fixture) id) (return-from :found (.name fixture))))
    "invalid"))

(defn fixture-path [(id i32)] (-> (slice u8))
  (block :found
    (for fixture FIXTURES
      (when (= (.id fixture) id) (return-from :found (.path fixture))))
    "invalid"))

(defn generate [(ty i32) (opcode i32) (count-type i32) (mode i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        counts (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        loaded (require (b/vector-load! (mut graph) ty 8 start input true))
        counter
          (if (= count-type 0)
              (require (b/vector-load! (mut graph) ty 8 loaded counts true))
              (require (b/emit! (mut graph) 92 count-type [loaded counts])))
        width (types/size ty 8)
        base (types/base-type ty)
        (mut payload) (ArrayList::new [u8] allocator)
        (mut count-payload) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i width)
      (push! (mut payload) (input-byte base (cast i64 i) 9 false))
      (push! (mut count-payload) (count-byte base 0 (cast i64 i) 20))
      (set! i (+ i 1)))
    (let [left
            (if (or (= mode 2) (= mode 3))
                (require (b/vector-constant! (mut graph) ty 8 (slice payload)))
                loaded)
          right
            (if (= mode 4)
                left
                (if (or (= mode 1) (= mode 3))
                    (if (= count-type 0)
                        (require (b/vector-constant! (mut graph)
                                                     ty
                                                     8
                                                     (slice count-payload)))
                        (require (b/scalar-constant! (mut graph)
                                                     count-type
                                                     (count-value count-type
                                                                  0
                                                                  20)
                                                     8)))
                    counter))
          result (require (b/vector-binary! (mut graph) opcode ty left right 0))
          (mut control)
            (require (b/vector-store! (mut graph) 8 counter output result true))]
      (when (< mode 4)
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph) output 24)
                                        left
                                        true)))
        (set! control
              (if (= count-type 0)
                  (require (b/vector-store! (mut graph)
                                            8
                                            control
                                            (address! (mut graph) output 48)
                                            right
                                            true))
                  (require (b/emit! (mut graph)
                                    93
                                    0
                                    [control
                                     (address! (mut graph) output 48)
                                     right])))))
      (let [ret (require (b/emit! (mut graph) 120 0 [control (: 0 i32) 0]))
            id (fixture-id ty opcode count-type mode)]
        (when (>= id 0)
          (match (compile/object graph start [ret] (fixture-name id) allocator)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [object]
                (let [(mut object) object]
                  (match (fs/write-file allocator
                                        (fixture-path id)
                                        (slice object))
                    (Err [_] (set! failures (+ failures 1)))
                    (Ok [_] 0))
                  (free! (mut object))))))
        (match (compile/image graph start [ret] "_vector_shift_jit" allocator)
          (Err [message]
               (println "shift ty{} op{} count{} mode{}: {}"
                        ty
                        opcode
                        count-type
                        mode
                        message)
               (set! failures (+ failures 1)))
          (Ok [source]
              (let [(mut source) source]
                (match (jit/map-image source allocator)
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [loaded]
                      (let [(mut loaded) loaded]
                        (set! failures
                              (+ failures
                                 (exercise ty
                                           opcode
                                           count-type
                                           mode
                                           (.base (.memory loaded)))))
                        (jit/release-image! (mut loaded)))))
                (image/release! (mut source)))))))
    (free! (mut payload))
    (free! (mut count-payload))
    (g/release! (mut graph))
    failures))

(defn pressure [(ty i32) (opcode i32) (count-type i32) (alignment i32) (id i32)]
  (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        guard (require (b/variable! (mut graph) 5 start "guard" alignment))
        sentinel (require (b/scalar-constant! (mut graph) 5 321 8))
        moving (require (b/scalar-constant! (mut graph) 5 317 8))
        size (require (b/scalar-constant! (mut graph) 5 73 8))
        guarded (require (b/emit! (mut graph) 87 0 [start guard sentinel]))
        dynamic (require (b/stack-allocate! (mut graph) guarded size alignment))
        (mut control)
          (require (b/emit! (mut graph) 93 0 [dynamic dynamic moving]))
        width (types/size ty 8)
        base (types/base-type ty)
        (mut inputs) (ArrayList::new [i32] allocator)
        (mut results) (ArrayList::new [i32] allocator)
        (mut payload) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i 40)
      (clear! (mut payload))
      (let [(mut j) (: 0 i32)]
        (while (< j width)
          (push! (mut payload)
                 (count-byte base 0 (cast i64 (+ (* i width) j)) 20))
          (set! j (+ j 1))))
      (let [loaded
              (require (b/vector-load! (mut graph)
                                       ty
                                       8
                                       control
                                       (address! (mut graph) input (* i width))
                                       true))
            constant
              (if (= count-type 0)
                  (require (b/vector-constant! (mut graph) ty 8 (slice payload)))
                  (require (b/scalar-constant! (mut graph)
                                               count-type
                                               (count-value count-type
                                                            (cast i64 i)
                                                            20)
                                               8)))
            result
              (require (b/vector-binary! (mut graph)
                                         opcode
                                         ty
                                         loaded
                                         constant
                                         0))
            storage (require (b/variable! (mut graph) ty start "computed" 0))]
        (push! (mut inputs) loaded)
        (push! (mut results) result)
        ; The volatile store keeps the arithmetic before the clobbering call.
        (set! control
              (require (b/emit! (mut graph) 88 0 [loaded storage result]))))
      (set! i (+ i 1)))
    (match (calls/create 9 5 [(: 6 u8)] allocator)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (set! control
                  (require (calls/emit! (mut graph)
                                        prototype
                                        control
                                        target
                                        [input]
                                        allocator)))
            (calls/release! (mut prototype)))))
    (let [called control]
      (set! i 0)
      (while (< i 40)
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph)
                                                  output
                                                  (* i width))
                                        (get results (cast i64 i))
                                        true)))
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph)
                                                  output
                                                  (+ 1024 (* i width)))
                                        (get inputs (cast i64 i))
                                        true)))
        (set! i (+ i 1)))
      (let [fixed (require (b/emit! (mut graph) 86 5 [control guard]))
            live-dynamic (require (b/emit! (mut graph) 91 5 [fixed dynamic]))
            sum (require (b/emit! (mut graph) 26 5 [fixed live-dynamic]))
            answer (require (b/emit! (mut graph) 26 5 [sum called]))
            freed (require (b/stack-free! (mut graph) live-dynamic size))
            ret (require (b/emit! (mut graph) 120 5 [freed answer (: 0 i32)]))]
        (match (compile/object graph start [ret] (fixture-name id) allocator)
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [object]
              (let [(mut object) object]
                (match (fs/write-file allocator
                                      (fixture-path id)
                                      (slice object))
                  (Err [_] (set! failures (+ failures 1)))
                  (Ok [_] 0))
                (free! (mut object)))))
        (match (compile/image graph
                              start
                              [ret]
                              "_vector_arithmetic_pressure"
                              allocator)
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [source]
              (let [(mut source) source]
                (match (jit/map-image source allocator)
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [loaded]
                      (let [(mut loaded) loaded]
                        (set! failures
                              (+ failures
                                 (pressure-exercise ty
                                                    opcode
                                                    count-type
                                                    (.base (.memory loaded)))))
                        (jit/release-image! (mut loaded)))))
                (image/release! (mut source)))))))
    (free! (mut inputs))
    (free! (mut results))
    (free! (mut payload))
    (g/release! (mut graph))
    failures))

(import "stogir.a64.encode" :as encode)
(import "stogir.a64.vector-shift" :as native)
(import "stogir.bytes" :as bytes)

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

; A leaf C-ABI harness forces physical register aliases, independently of allocator choices.
(defn alias-check [(ty i32)
                   (opcode i32)
                   (rd i32)
                   (rn i32)
                   (count i32)
                   (scalar? bool)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut text) (ArrayList::new [u8] allocator)
        width (types/size ty 8)
        (mut error) ""
        (mut failures) 0]
    (word! (mut text)
           (mut error)
           (encode/floating-load-store true width rn 1 0))
    (when (or scalar? (!= rn count))
      (word! (mut text)
             (mut error)
             (if scalar?
                 (encode/load-store true 8 count 2 0)
                 (encode/floating-load-store true width count 2 0))))
    (match (native/emit-registers! (mut text) opcode ty rd rn count scalar?)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (word! (mut text)
           (mut error)
           (encode/floating-load-store false width rd 0 0))
    (bytes/append32! (mut text) 0xD65F03C0)
    (if (!= error "")
        (do (println "{}" error) (set! failures (+ failures 1)))
        (match (jit/map-text (slice text))
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [loaded]
              (let [(mut loaded) loaded]
                (set! failures
                      (+ failures
                         (exercise ty
                                   opcode
                                   (if scalar? 5 0)
                                   (if (and (not scalar?) (= rn count)) 4 5)
                                   (.base loaded))))
                (jit/release! (mut loaded))))))
    (free! (mut text))
    failures))

(defstruct Alias [(rd i32) (rn i32) (count i32) (scalar? bool)])

(defn forced-aliases [] (-> i64)
  (let [(mut failures) 0
        roles
          (table Alias
                 [0 1 2 false]
                 [1 1 2 false]
                 [2 1 2 false]
                 [1 1 1 false]
                 [0 1 1 false]
                 [0 30 31 false]
                 [1 1 30 false]
                 [1 1 17 true]
                 [0 30 17 true]
                 [0 1 3 true]
                 [0 1 16 true])]
    (for ty [(: 66 i32) 82 51 67 36 52 21 37]
      (for opcode [(: 52 i32) 53]
        (for role roles
          (set! failures
                (+ failures
                   (alias-check ty
                                opcode
                                (.rd role)
                                (.rn role)
                                (.count role)
                                (.scalar? role)))))))
    failures))

