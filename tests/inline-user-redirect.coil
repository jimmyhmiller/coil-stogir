(module stogir.tests.inline-user-redirect)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.uses" :as uses)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.verify" :as verify)
(import "stogir.call-inline" :as inlining)
(import "stogir.sccp-rewrite" :as rewrite)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

;;; Number of reference operands of GRAPH that still name one of CALLS.
(defn stale-operands [(graph g/Graph) (calls (slice i32))] (-> i64)
  (let [(mut stale) 0 (mut r) (: 1 i64)]
    (while (< r (len (.instructions graph)))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (for [i 1 (+ (cast i64 count) 1)]
          (when (uses/edge-code? (op/operand-code (cast i32 (n/opcode node)) (cast i32 i)))
            (match (g/operand graph (cast i32 r) (cast i32 i))
              (None [] (set! stale (+ stale 1)))
              (Some [value]
                    (for [k 0 (len calls)]
                      (when (= value (get calls k)) (set! stale (+ stale 1))))))))
        (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))
    stale))

;;; Expand SITES in the order given and check the result: every site inlined,
;;; no operand left naming an expanded call, control sources still control
;;; nodes, and RETURN reading add(add(input, 3), 3) straight after ENTRY.
(defn order-failures [(registry inlining/Registry) (caller g/Graph) (entry i32) (input i32)
                      (result i32) (sites (slice inlining/RegisteredSite))
                      (calls (slice i32)) (label (slice u8))] (-> i64)
  (let [a (malloc-allocator) (mut failures) 0]
    (match (inlining/optimize-registered-prioritized-policy
             registry caller entry [result] sites (inlining/default-policy 512) a)
      (Err [message] (panic "{}: expansion: {}" label message))
      (Ok [maybe]
          (match maybe
            (None [] (do (println "{}: nothing inlined" label) (set! failures (+ failures 1))))
            (Some [owned]
                  (let [(mut expanded) owned graph (.graph expanded)]
                    (unless (= (.changes expanded) 4)
                      (println "{}: changes {}" label (.changes expanded))
                      (set! failures (+ failures 1)))
                    (unless (= (stale-operands graph calls) 0)
                      (println "{}: {} operands still name an expanded call"
                               label (stale-operands graph calls))
                      (set! failures (+ failures 1)))
                    (match (rewrite/validate graph 8 a)
                      (Err [message] (do (println "{}: invalid result: {}" label message)
                                         (set! failures (+ failures 1))))
                      (Ok [_] 0))
                    (match (verify/control-sources graph)
                      (Err [message] (do (println "{}: control: {}" label message)
                                         (set! failures (+ failures 1))))
                      (Ok [_] 0))
                    (let [returned (get (.instructions graph) (cast i64 result))
                          outer (get (.instructions graph) (cast i64 (.op2 returned)))
                          inner (if (> (.op1 outer) 0)
                                    (get (.instructions graph) (cast i64 (.op1 outer)))
                                    outer)]
                      (unless (and (= (n/opcode returned) 120)
                                   (= (.op1 returned) entry)
                                   (> (.op2 returned) 0)
                                   (= (n/opcode outer) 26)
                                   (> (.op1 outer) 0)
                                   (= (n/opcode inner) 26)
                                   (= (.op1 inner) input))
                        (println "{}: RETURN does not read add(add(input, 3), 3) after ENTRY" label)
                        (set! failures (+ failures 1))))
                    (rewrite/release! (mut expanded)))))))
    failures))

;;; first = leaf(input); second = same(first); third = leaf(second);
;;; fourth = same(third), each call following the previous one in control, where
;;; leaf adds three and same returns its argument. Expanding a call hands its
;;; users the callee's result and the call's own control input, which here are
;;; other calls still to be expanded: whatever the order, every later expansion
;;; must find the operands an earlier one redirected to it.
(defn main [] (-> i32)
  (let [a (malloc-allocator) (mut leaf) (g/create a) (mut same) (g/create a)
        (mut caller) (g/create a)
        start (require (b/emit! (mut leaf) 104 0 [(: 0 i32)]))
        param (require (b/emit! (mut leaf) 71 5 [start (: 0 i32) 0]))
        three (require (b/scalar-constant! (mut leaf) 5 3 8))
        answer (require (b/emit! (mut leaf) 26 5 [param three]))
        returned (require (b/emit! (mut leaf) 120 5 [start answer (: 0 i32)]))
        same-start (require (b/emit! (mut same) 104 0 [(: 0 i32)]))
        same-param (require (b/emit! (mut same) 71 5 [same-start (: 0 i32) 0]))
        same-returned (require (b/emit! (mut same) 120 5 [same-start same-param (: 0 i32)]))
        entry (require (b/emit! (mut caller) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut caller) 71 5 [entry (: 0 i32) 0]))
        leaf-name (require (symbols/function! (mut caller) "_redirect_leaf" 0))
        same-name (require (symbols/function! (mut caller) "_redirect_same" 0))
        (mut signature) (match (calls/create 0 5 [(: 5 u8)] a)
                          (Err [message] (panic "signature: {}" message))
                          (Ok [owned] owned))
        _ (require (calls/function! (mut leaf) signature a))
        _ (require (calls/function! (mut same) signature a))
        _ (require (calls/function! (mut caller) signature a))
        first (require (calls/emit! (mut caller) signature entry leaf-name [input] a))
        second (require (calls/emit! (mut caller) signature first same-name [first] a))
        third (require (calls/emit! (mut caller) signature second leaf-name [second] a))
        fourth (require (calls/emit! (mut caller) signature third same-name [third] a))
        result (require (b/emit! (mut caller) 120 5 [fourth fourth (: 0 i32)]))
        (mut registry) (inlining/registry-create 8 a)
        (mut failures) 0
        leaf-handle
          (match (inlining/register! (mut registry)
                   (inlining/Callee :name "_redirect_leaf" :graph leaf :entry start
                                    :roots [returned] :observed [returned]
                                    :never false :always false))
            (Err [message] (panic "register leaf: {}" message))
            (Ok [handle] handle))
        same-handle
          (match (inlining/register! (mut registry)
                   (inlining/Callee :name "_redirect_same" :graph same :entry same-start
                                    :roots [same-returned] :observed [same-returned]
                                    :never false :always false))
            (Err [message] (panic "register same: {}" message))
            (Ok [handle] handle))
        calls [first second third fourth]
        one (inlining/RegisteredSite :reference first :callee leaf-handle)
        two (inlining/RegisteredSite :reference second :callee same-handle)
        three-site (inlining/RegisteredSite :reference third :callee leaf-handle)
        four (inlining/RegisteredSite :reference fourth :callee same-handle)]
    (set! failures (+ failures (order-failures registry caller entry input result
                                               [one two three-site four] calls "forward")))
    (set! failures (+ failures (order-failures registry caller entry input result
                                               [four three-site two one] calls "backward")))
    (set! failures (+ failures (order-failures registry caller entry input result
                                               [two four one three-site] calls "pass-through first")))
    (set! failures (+ failures (order-failures registry caller entry input result
                                               [three-site one four two] calls "leaf first")))
    (println "inline user redirection: {} failures" failures)
    (if (= failures 0) 0 1)))
