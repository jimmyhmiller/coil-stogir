(module stogir.tests.aot-stack-scopes-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern scopes16 :as "stogir_scopes_16" :cc (cc/C) [u64 u64] (-> u64))

(extern scopes4096 :as "stogir_scopes_4096" :cc (cc/C) [u64 u64] (-> u64))

(defn sum10 :cc (cc/C) [(a u64)
                        (b u64)
                        (c u64)
                        (d u64)
                        (e u64)
                        (f u64)
                        (g u64)
                        (h u64)
                        (i u64)
                        (j u64)] (-> u64)
  (+ a b c d e f g h i j))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of sum10)))
        (mut failures) 0]
    (for n [(: 1 u64) 15 16 17 63 65 4097]
      (when (!= (scopes16 target n) (* n 10)) (set! failures (+ failures 1)))
      (when (!= (scopes4096 target n) (* n 10)) (set! failures (+ failures 1))))
    (println "linked nested stack scopes: {} failures" failures)
    (if (= failures 0) 0 1)))
