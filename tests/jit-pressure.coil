(module stogir.tests.jit-pressure)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn phi-pressure [(count i64) (operation i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        parameter (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        four (require (b/scalar-constant! (mut graph) 11 4 8))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        condition (require (b/emit! (mut graph) 16 1 [parameter zero]))
        split (require (b/emit! (mut graph) 116 0 [start condition]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        yes-end (require (b/emit! (mut graph) 114 0 [yes]))
        no-end (require (b/emit! (mut graph) 114 0 [no]))
        merge (require (b/emit! (mut graph) 112 0 [yes-end no-end]))
        (mut phis) (ArrayList::new [i32] allocator)
        (mut failures) 0]
    (for [i 1 (+ count 1)]
      (let [constant
              (require (b/scalar-constant! (mut graph) 11 (cast u64 i) 8))
            left (require (b/emit! (mut graph) 26 11 [parameter constant]))
            right (require (b/emit! (mut graph) 27 11 [parameter constant]))]
        (let [phi (require (b/emit! (mut graph) 67 11 [merge left right]))]
          (push! (mut phis)
                 (if (= operation 0)
                     phi
                     (require (b/emit! (mut graph)
                                       operation
                                       11
                                       [phi four merge])))))))
    ; All Phis start together; reverse consumption makes newer values require
    ; registers before older owners. Edge copies must populate spilled prefixes.
    (let [(mut total) (get phis (- count 1))
          (mut i) (- count 2)]
      (while (>= i 0)
        (set! total (require (b/emit! (mut graph) 26 11 [total (get phis i)])))
        (set! i (- i 1)))
      (let [ret (require (b/emit! (mut graph) 120 11 [merge total (: 0 i32)]))]
        (when (and (= count 24) (= operation 0))
          (match (compile/object graph
                                 start
                                 [ret]
                                 "_stogir_phi_pressure"
                                 allocator)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [object]
                (let [(mut bytes) object]
                  (match (fs/write-file allocator
                                        "/tmp/coil-stogir-phi-pressure.o"
                                        (slice bytes))
                    (Err [_] (set! failures (+ failures 1)))
                    (Ok [_] 0))
                  (free! (mut bytes))))))
        (match (compile/text graph start [ret] allocator)
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [text]
              (let [(mut bytes) text]
                (match (jit/map-text (slice bytes))
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [image]
                      (let [(mut owned) image
                            function
                              (primitive/cast (fnptr (cc/C) [i64] i64)
                                              (.base owned))]
                        (for [x -100 101]
                          (let [(mut expected) (: 0 i128)]
                            (for [i 1 (+ count 1)]
                              (let [value
                                      (cast i128 (+ x (if (< x 0) i (- 0 i))))
                                    quotient (/ value (: 4 i128))]
                                (set! expected
                                      (+ expected
                                         (case operation
                                           29 quotient
                                           30 (- value (* quotient 4))
                                           value)))))
                            (when (!= (call-ptr function x) (cast i64 expected))
                              (set! failures (+ failures 1)))))
                        (jit/release! (mut owned)))))
                (free! (mut bytes)))))))
    (free! (mut phis))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        param (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        (mut values) (ArrayList::new [i32] allocator)
        (mut i) 1
        (mut failures) 0]
    (while (<= i 24)
      (let [constant
              (require (b/scalar-constant! (mut graph) 11 (cast u64 i) 8))
            value (require (b/emit! (mut graph) 26 11 [param constant]))]
        (push! (mut values) value))
      (set! i (+ i 1)))
    (let [(mut total) (get values 0)]
      (set! i 1)
      (while (< i (len values))
        (set! total
              (require (b/emit! (mut graph) 26 11 [total (get values i)])))
        (set! i (+ i 1)))
      (let [ret (require (b/emit! (mut graph) 120 11 [start total (: 0 i32)]))]
        (match (compile/text graph start [ret] allocator)
          (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
          (Ok [text]
              (let [(mut bytes) text]
                (match (jit/map-text (slice bytes))
                  (Err [_] (set! failures (+ failures 1)))
                  (Ok [image]
                      (let [(mut owned) image
                            f
                              (primitive/cast (fnptr (cc/C) [i64] i64)
                                              (.base owned))
                            (mut x) -100]
                        (while (<= x 100)
                          (when (!= (call-ptr f x) (+ (* 24 x) 300))
                            (set! failures (+ failures 1)))
                          (set! x (+ x 1)))
                        (jit/release! (mut owned)))))
                (free! (mut bytes)))))))
    (free! (mut values))
    (g/release! (mut graph))
    (for count [8 16 17 24 40]
      (for operation [(: 0 i32) 29 30]
        (set! failures (+ failures (phi-pressure count operation)))))
    (println "native register pressure checks: {} failures" failures)
    (if (= failures 0) 0 1)))
