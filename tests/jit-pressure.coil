(module stogir.tests.jit-pressure)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        param (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        (mut values) (ArrayList::new [i32] allocator)
        (mut i) 1
        (mut failures) 0]
    (while (<= i 24)
      (let [constant
              (require (b/scalar-constant! (mut graph) 11 (cast u64 i) 8))
            value (require (b/emit! (mut graph) 26 11 [param constant]))]
        (push! (mut values) value))
      (set! i (+ i 1)))
    (let [(mut total) (get values 0)]
      (set! i 1)
      (while (< i (len values))
        (set! total
              (require (b/emit! (mut graph) 26 11 [total (get values i)])))
        (set! i (+ i 1)))
      (let [ret (require (b/emit! (mut graph) 120 11 [start total (: 0 i32)]))]
        (match (compile/text graph start [ret] allocator)
          (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
          (Ok [text]
              (let [(mut bytes) text]
                (match (jit/map-text (slice bytes))
                  (Err [_] (set! failures (+ failures 1)))
                  (Ok [image]
                      (let [(mut owned) image
                            f
                              (primitive/cast (fnptr (cc/C) [i64] i64)
                                              (.base owned))
                            (mut x) -100]
                        (while (<= x 100)
                          (when (!= (call-ptr f x) (+ (* 24 x) 300))
                            (set! failures (+ failures 1)))
                          (set! x (+ x 1)))
                        (jit/release! (mut owned)))))
                (free! (mut bytes)))))))
    (free! (mut values))
    (g/release! (mut graph))
    (println "native register pressure checks: {} failures" failures)
    (if (= failures 0) 0 1)))
