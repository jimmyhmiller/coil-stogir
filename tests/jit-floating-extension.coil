;;; Extension floating opcodes 131..141 (SQRT, FMA, FMIN, FMAX, FMINNM, FMAXNM
;;; and five roundings), executed natively for both widths against tables
;;; made by an independent exact model (tests/jit-floating-extension-table.py):
;;; signed zeros, infinities, subnormals, quiet and signalling NaNs, ties, and a
;;; product whose low bits only a fused multiply-add keeps. Operands arrive as
;;; parameters, as literals (construction folding where IEEE fixes the bits, a
;;; materialised literal otherwise), and from stack slots across a call.
(module stogir.tests.jit-floating-extension)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.floating" :as floating)
(import "stogir.opcode" :as opcode)
(import "stogir.calls" :as calls)
(import "stogir.native.compile" :as compile)
(import "stogir.jit.native" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Some None])

