; ---- GENERATED: end ----

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn pattern [(ty u8) (index i64)] (-> u64)
  (if (= ty 12) (get WIDE-PATTERNS index) (get NARROW-PATTERNS index)))

;;; How many patterns each operand of OPCODE ranges over.
(defn extent [(opcode i32)] (-> i64)
  (cond (floating/ternary? opcode) TERNARY-COUNT
        (floating/unary? opcode) PATTERN-COUNT
        :else BINARY-COUNT))

(defn expected [(opcode i32) (ty u8) (i i64) (j i64) (k i64)] (-> u64)
  (cond (floating/ternary? opcode)
          (let [at (+ (* (+ (* i TERNARY-COUNT) j) TERNARY-COUNT) k)]
            (if (= ty 12) (get WIDE-TERNARY at) (get NARROW-TERNARY at)))
        (floating/unary? opcode)
          (let [at (+ (* (if (= opcode 131) 0 (cast i64 (- opcode 136)))
                         PATTERN-COUNT)
                      i)]
            (if (= ty 12) (get WIDE-UNARY at) (get NARROW-UNARY at)))
        :else
          (let [at (+ (* (+ (* (cast i64 (- opcode 133)) BINARY-COUNT) i)
                         BINARY-COUNT)
                      j)]
            (if (= ty 12) (get WIDE-BINARY at) (get NARROW-BINARY at)))))

(defn invoke [(base (ptr u8)) (ty u8) (x u64) (y u64) (z u64)] (-> u64)
  (if (= ty 12)
      (let [f (primitive/cast (fnptr (cc/C) [f64 f64 f64] u64) base)
            (mut a) (: 0.0 f64)
            (mut b) (: 0.0 f64)
            (mut c) (: 0.0 f64)]
        (store! (primitive/cast (ptr u64) (mut a)) x)
        (store! (primitive/cast (ptr u64) (mut b)) y)
        (store! (primitive/cast (ptr u64) (mut c)) z)
        (call-ptr f a b c))
      (let [f (primitive/cast (fnptr (cc/C) [f32 f32 f32] u64) base)
            (mut a) (: 0.0 f32)
            (mut b) (: 0.0 f32)
            (mut c) (: 0.0 f32)]
        (store! (primitive/cast (ptr u32) (mut a)) (cast u32 x))
        (store! (primitive/cast (ptr u32) (mut b)) (cast u32 y))
        (store! (primitive/cast (ptr u32) (mut c)) (cast u32 z))
        (call-ptr f a b c))))

;;; One function of three parameters computing OPCODE. Bit N of LITERALS makes
;;; operand N the literal pattern CI/CJ/CK instead of its parameter; the other
;;; operands range over every pattern of the opcode.
(defn check [(opcode i32) (ty u8) (literals i64) (ci i64) (cj i64) (ck i64)]
  (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p0 (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 0]))
        p1 (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 1]))
        p2 (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 2]))
        left
          (if (!= (& literals 1) 0)
              (require (b/scalar-constant! (mut graph) (cast i32 ty) (pattern ty ci) 8))
              p0)
        right
          (if (!= (& literals 2) 0)
              (require (b/scalar-constant! (mut graph) (cast i32 ty) (pattern ty cj) 8))
              p1)
        third
          (if (!= (& literals 4) 0)
              (require (b/scalar-constant! (mut graph) (cast i32 ty) (pattern ty ck) 8))
              p2)
        operation
          (require (b/floating! (mut graph)
                                opcode
                                (cast i32 ty)
                                left
                                (if (floating/unary? opcode) 0 right)
                                (if (floating/ternary? opcode) third 0)))
        bits (require (b/emit! (mut graph) 36 (if (= ty 12) 5 4) [operation]))
        value (if (= ty 13) (require (b/emit! (mut graph) 34 5 [bits])) bits)
        ret (require (b/emit! (mut graph) 120 5 [start value (: 0 i32)]))
        n (extent opcode)
        unary? (floating/unary? opcode)
        ternary? (floating/ternary? opcode)
        (mut failures) 0]
    (match (calls/create 0 5 [ty ty ty] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype]
            (require (calls/function! (mut graph) owned allocator))
            (calls/release! (mut owned)))))
    (match (compile/text graph start [ret] allocator)
      (Err [msg]
           (do
             (println "FP extension op={} ty={} literals={}: {}" opcode ty literals msg)
             (set! failures (+ failures 1))))
      (Ok [text]
          (let [(mut code) text]
            (match (jit/map-text (slice code))
              (Err [_] (set! failures (+ failures 1)))
              (Ok [loaded]
                  (let [(mut image) loaded
                        (mut i) (if (!= (& literals 1) 0) ci 0)]
                    (while (< i (if (!= (& literals 1) 0) (+ ci 1) n))
                      (let [(mut j) (if (!= (& literals 2) 0) cj 0)]
                        (while (< j (cond unary? 1
                                          (!= (& literals 2) 0) (+ cj 1)
                                          :else n))
                          (let [(mut k) (if (!= (& literals 4) 0) ck 0)]
                            (while (< k (cond (not ternary?) 1
                                              (!= (& literals 4) 0) (+ ck 1)
                                              :else n))
                              (let [wanted (expected opcode ty i j k)
                                    actual
                                      (invoke (.base image)
                                              ty
                                              (pattern ty i)
                                              (pattern ty j)
                                              (pattern ty k))]
                                (when (!= actual wanted)
                                  (when (= failures 0)
                                    (println "FP extension mismatch {} ty={} literals={} x={:x} y={:x} z={:x} wanted={:x} actual={:x}"
                                             (opcode/name opcode)
                                             ty
                                             literals
                                             (pattern ty i)
                                             (pattern ty j)
                                             (pattern ty k)
                                             wanted
                                             actual))
                                  (set! failures (+ failures 1))))
                              (set! k (+ k 1))))
                          (set! j (+ j 1))))
                      (set! i (+ i 1)))
                    (jit/release! (mut image)))))
            (free! (mut code)))))
    (g/release! (mut graph))
    failures))

;;; Construction folds exactly the results IEEE 754 fixes: extrema and
;;; roundings of non-NaN literals. Everything else stays an instruction.
(defn folding [(ty u8)] (-> i64)
  (let [(mut failures) 0]
    (for opcode [(: 131 i32) 132 133 134 135 136 137 138 139 140 141]
      (let [n (extent opcode)]
        (for [i 0 n]
          (for [j 0 (if (floating/unary? opcode) 1 n)]
            (let [x (pattern ty i)
                  y (pattern ty j)
                  magnitude (if (= ty 12) (: 0x7FFFFFFFFFFFFFFF u64) 0x7FFFFFFF)
                  infinity (if (= ty 12) (: 0x7FF0000000000000 u64) 0x7F800000)
                  nan? (or (> (& x magnitude) infinity)
                           (and (not (floating/unary? opcode))
                                (> (& y magnitude) infinity)))
                  folds? (and (not nan?)
                              (or (floating/rounding? opcode)
                                  (floating/extremum? opcode)))]
              (match (floating/evaluate opcode (cast i32 ty) x y)
                (None []
                      (when folds?
                        (println "FP extension {} ty={} did not fold {:x} {:x}"
                                 (opcode/name opcode) ty x y)
                        (set! failures (+ failures 1))))
                (Some [bits]
                      (when (or (not folds?) (!= bits (expected opcode ty i j 0)))
                        (println "FP extension {} ty={} folded {:x} {:x} to {:x}"
                                 (opcode/name opcode) ty x y bits)
                        (set! failures (+ failures 1))))))))))
    failures))

(defn sum32 :cc (cc/C) [(a0 f32) (a1 f32) (a2 f32) (a3 f32) (a4 f32) (a5 f32)
                        (a6 f32) (a7 f32) (a8 f32) (a9 f32) (a10 f32) (a11 f32)
                        (a12 f32) (a13 f32) (a14 f32) (a15 f32) (a16 f32)
                        (a17 f32) (a18 f32) (a19 f32) (a20 f32) (a21 f32)
                        (a22 f32) (a23 f32)] (-> f32)
  (+ a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20
     a21 a22 a23))

(defn sum64 :cc (cc/C) [(a0 f64) (a1 f64) (a2 f64) (a3 f64) (a4 f64) (a5 f64)
                        (a6 f64) (a7 f64) (a8 f64) (a9 f64) (a10 f64) (a11 f64)
                        (a12 f64) (a13 f64) (a14 f64) (a15 f64) (a16 f64)
                        (a17 f64) (a18 f64) (a19 f64) (a20 f64) (a21 f64)
                        (a22 f64) (a23 f64)] (-> f64)
  (+ a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20
     a21 a22 a23))

(defn float-bits [(ty u8) (value i64)] (-> u64)
  (let [(mut d) (cast f64 value)
        (mut f) (cast f32 value)]
    (if (= ty 12)
        (load (primitive/cast (ptr u64) (mut d)))
        (cast u64 (load (primitive/cast (ptr u32) (mut f)))))))

;;; Forty values stay live across a call and through every operation after it,
;;; more than there are SIMD registers, so operands reach FMA and the unary and
;;; binary forms from stack slots, including FMA with all three in memory.
;;; Small integers keep every expected result exact.
(defn pressure [(ty u8)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        (mut values) (ArrayList::new [i32] allocator)
        (mut args) (ArrayList::new [i32] allocator)
        (mut types) (ArrayList::new [u8] allocator)
        (mut cells) (ArrayList::new [u64] allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 1]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        (mut failures) 0]
    (for [i 1 41]
      (push! (mut values)
             (require (b/floating! (mut graph)
                                   26
                                   (cast i32 ty)
                                   input
                                   (require (b/scalar-constant! (mut graph)
                                                                (cast i32 ty)
                                                                (float-bits ty i)
                                                                8))
                                   0))))
    (for [i 0 24]
      (push! (mut args) (get values i))
      (push! (mut types) ty))
    (for [i 0 120] (push! (mut cells) 0))
    (match (calls/create 0 ty (slice types) allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype
                call
                  (require (calls/emit! (mut graph)
                                        owned
                                        start
                                        target
                                        (slice args)
                                        allocator))
                (mut control) call]
            (for [i 0 120]
              (let [a (get values (% i 40))
                    b (get values (% (+ i 13) 40))
                    c (get values (% (+ i 27) 40))
                    value
                      (cond (< i 40)
                              (require (b/floating! (mut graph) 132 (cast i32 ty) a b c))
                            (< i 80)
                              (require (b/floating! (mut graph) 134 (cast i32 ty) a b 0))
                            :else
                              (require (b/floating! (mut graph) 131 (cast i32 ty)
                                                    (require (b/floating! (mut graph)
                                                                          28
                                                                          (cast i32 ty)
                                                                          a
                                                                          a
                                                                          0))
                                                    0
                                                    0)))
                    offset
                      (require (b/scalar-constant! (mut graph) 6 (cast u64 (* i 8)) 8))
                    address (require (b/emit! (mut graph) 26 6 [output offset]))]
                (set! control
                      (require (b/emit! (mut graph) 93 0 [control address value])))))
            (let [ret
                    (require (b/emit! (mut graph)
                                      120
                                      (cast i32 ty)
                                      [control call (: 0 i32)]))]
              (match (calls/create 0 ty [(: 6 u8) ty 6] allocator)
                (Err [_] (set! failures (+ failures 1)))
                (Ok [incoming]
                    (let [(mut owned-incoming) incoming]
                      (require (calls/function! (mut graph) owned-incoming allocator))
                      (calls/release! (mut owned-incoming)))))
              (match (compile/text graph start [ret] allocator)
                (Err [msg]
                     (do
                       (println "FP extension pressure ty={}: {}" ty msg)
                       (set! failures (+ failures 1))))
                (Ok [text]
                    (let [(mut code) text]
                      (match (jit/map-text (slice code))
                        (Err [_] (set! failures (+ failures 1)))
                        (Ok [loaded]
                            (let [(mut image) loaded]
                              (for base [(: -30 i64) 0 7]
                                (if (= ty 12)
                                    (let [f (primitive/cast (fnptr (cc/C)
                                                                   [u64 f64 (ptr u64)]
                                                                   f64)
                                                            (.base image))]
                                      (call-ptr f
                                                (primitive/cast u64
                                                                (primitive/cast (ptr u8)
                                                                                (fnptr-of sum64)))
                                                (cast f64 base)
                                                (.data cells)))
                                    (let [f (primitive/cast (fnptr (cc/C)
                                                                   [u64 f32 (ptr u64)]
                                                                   f32)
                                                            (.base image))]
                                      (call-ptr f
                                                (primitive/cast u64
                                                                (primitive/cast (ptr u8)
                                                                                (fnptr-of sum32)))
                                                (cast f32 base)
                                                (.data cells))))
                                (for [i 0 120]
                                  (let [a (+ base 1 (% i 40))
                                        b (+ base 1 (% (+ i 13) 40))
                                        c (+ base 1 (% (+ i 27) 40))
                                        wanted
                                          (float-bits ty
                                                      (cond (< i 40) (+ (* a b) c)
                                                            (< i 80) (if (> a b) a b)
                                                            :else (if (< a 0) (- 0 a) a)))
                                        actual
                                          (if (= ty 12)
                                              (get cells i)
                                              (& (get cells i) 0xFFFFFFFF))]
                                    (when (!= actual wanted)
                                      (when (= failures 0)
                                        (println "FP extension pressure ty={} base={} i={} wanted={:x} actual={:x}"
                                                 ty base i wanted actual))
                                      (set! failures (+ failures 1))))))
                              (jit/release! (mut image)))))
                      (free! (mut code))))))
            (calls/release! (mut owned)))))
    (free! (mut cells))
    (free! (mut values))
    (free! (mut args))
    (free! (mut types))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0
        (mut functions) 0]
    (for ty [(: 12 u8) 13]
      (set! failures (+ failures (folding ty) (pressure ty)))
      (for opcode [(: 131 i32) 132 133 134 135 136 137 138 139 140 141]
        (let [n (extent opcode)]
          (set! failures (+ failures (check opcode ty 0 0 0 0)))
          (set! functions (+ functions 1))
          (for [i 0 n]
            ; literal first operand; for a unary operation the whole input
            (set! failures (+ failures (check opcode ty 1 i 0 0)))
            (set! functions (+ functions 1))
            (when (not (floating/unary? opcode))
              (set! failures (+ failures (check opcode ty 2 0 i 0)))
              (set! functions (+ functions 1))
              (if (floating/ternary? opcode)
                  (let [j (% (+ i 3) n)
                        k (% (+ i 5) n)]
                    (set! failures
                          (+ failures
                             (check opcode ty 4 0 0 i)
                             (check opcode ty 3 i j 0)
                             (check opcode ty 5 i 0 k)
                             (check opcode ty 6 0 j k)
                             (check opcode ty 7 i j k)))
                    (set! functions (+ functions 5)))
                  (for [j 0 n]
                    (set! failures (+ failures (check opcode ty 3 i j 0)))
                    (set! functions (+ functions 1)))))))))
    (println "native floating extension opcodes: {} functions, {} failures"
             functions
             failures)
    (if (= failures 0) 0 1)))
