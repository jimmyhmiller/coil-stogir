(module stogir.tests.jit-hva-outgoing)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.simd" :as v)

(defstruct H8_1 [(m0 (vec u64 1))])

(defstruct H8_2 [(m0 (vec u64 1)) (m1 (vec u64 1))])

(defstruct H8_3 [(m0 (vec u64 1)) (m1 (vec u64 1)) (m2 (vec u64 1))])

(defstruct H8_4
  [(m0 (vec u64 1)) (m1 (vec u64 1)) (m2 (vec u64 1)) (m3 (vec u64 1))])

(defstruct H16_1 [(m0 (vec u64 2))])

(defstruct H16_2 [(m0 (vec u64 2)) (m1 (vec u64 2))])

(defstruct H16_3 [(m0 (vec u64 2)) (m1 (vec u64 2)) (m2 (vec u64 2))])

(defstruct H16_4
  [(m0 (vec u64 2)) (m1 (vec u64 2)) (m2 (vec u64 2)) (m3 (vec u64 2))])

(defn word [(index u64)] (-> u64)
  (^ (* (+ index 1) 0x123456789ABCDEF) 0x8000000000000000))

(defn lane8 [(index u64)] (-> (vec u64 1))
  (v/vsplat [u64 1] (word index)))

(defn lane16 [(index u64)] (-> (vec u64 2))
  (v/vinsert (v/vsplat [u64 2] (word index)) 1 (word (+ index 71))))

(defn callback0 :cc (cc/C) [(output (ptr u64))
                            (seed u64)
                            (value H8_1)
                            (tail H8_1)] (-> H8_1)
  (p/store! (p/index output 0) (v/vextract (.m0 tail) 0))
  (p/store! (p/index output 1) seed)
  (H8_1
    :m0 (v/vinsert (.m0 value) 0 (^ (v/vextract (.m0 value) 0) seed))))

(export-c [callback0 :as "stogir_hva_out_callback_0"])

(defn callback1 :cc (cc/C) [(output (ptr u64))
                            (seed u64)
                            (p0 H8_1)
                            (p1 H8_1)
                            (p2 H8_1)
                            (p3 H8_1)
                            (p4 H8_1)
                            (p5 H8_1)
                            (p6 H8_1)
                            (value H8_1)
                            (tail H8_1)] (-> H8_1)
  (p/store! (p/index output 0) (v/vextract (.m0 p0) 0))
  (p/store! (p/index output 1) (v/vextract (.m0 p1) 0))
  (p/store! (p/index output 2) (v/vextract (.m0 p2) 0))
  (p/store! (p/index output 3) (v/vextract (.m0 p3) 0))
  (p/store! (p/index output 4) (v/vextract (.m0 p4) 0))
  (p/store! (p/index output 5) (v/vextract (.m0 p5) 0))
  (p/store! (p/index output 6) (v/vextract (.m0 p6) 0))
  (p/store! (p/index output 7) (v/vextract (.m0 tail) 0))
  (p/store! (p/index output 8) seed)
  (H8_1
    :m0 (v/vinsert (.m0 value) 0 (^ (v/vextract (.m0 value) 0) seed))))

(export-c [callback1 :as "stogir_hva_out_callback_1"])

