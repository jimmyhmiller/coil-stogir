(module stogir.tests.jit-return-merge)
(import "stogir.return-merge" :as merge)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.call-inline" :as inline)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.a64.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Some None])
(defn require [(x (Result i32 (slice u8)))] (-> i32)
  (match x (Ok [v] v) (Err [e] (panic "{}" e))))
(defn reject [(value (Result merge/Canonical (slice u8)))] (-> void)
  (match value (Err [_] 0) (Ok [owned]
    (let [(mut owned) owned] (merge/release! (mut owned))
      (panic "invalid return canonicalization accepted")))))
(defn execute [(graph g/Graph) (roots (slice i32)) (ty i32)] (-> void)
  (let [a (malloc-allocator)]
    (match (compile/image graph 1 roots "_return_merge_test" a)
      (Err [e] (panic "{}" e))
      (Ok [owned]
        (let [(mut code) owned]
          (match (jit/map-image code a)
            (Err [e] (panic "{}" e))
            (Ok [owned]
              (let [(mut loaded) owned address (.base (.memory loaded))
                    fv (p/cast (fnptr (cc/C) [u64 (ptr u64)] void) address)
                    fb (p/cast (fnptr (cc/C) [u64 (ptr u64)] bool) address)
                    fu (p/cast (fnptr (cc/C) [u64 (ptr u64)] u64) address)]
                (for x [(: 0 u64) 1 7 0x8000000000000000 0xFFFFFFFFFFFFFFFF]
                  (let [(mut output) [(: 123 u64) 456]
                        ptr (p/cast (ptr u64) (mut output))
                        expected (if (= x 0) 9 x)]
                    (if (= ty 0)
                        (fv x ptr)
                        (if (= ty 1)
                            (assert (= (fb x ptr) (= x 0)))
                            (assert (= (fu x ptr) expected))))
                    (assert (= (get output 0) expected))
                    (assert (= (get output 1) 456))))
                (jit/release-image! (mut loaded)))))
          (image/release! (mut code)))))))
(defn test [(ty i32) (linked bool)] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        out (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        zero (require (b/scalar-constant! (mut graph) 5 0 8))
        nine (require (b/scalar-constant! (mut graph) 5 9 8))
        yes-value (if (= ty 0) 0 (if (= ty 1) (require (b/scalar-constant! (mut graph) 1 1 8)) nine))
        no-value (if (= ty 0) 0 (if (= ty 1) (require (b/scalar-constant! (mut graph) 1 0 8)) x))
        condition (require (b/emit! (mut graph) 14 1 [x zero]))
        branch (require (b/emit! (mut graph) 116 0 [start condition]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        store1 (require (b/emit! (mut graph) 93 0 [yes out nine]))
        store2 (require (b/emit! (mut graph) 93 0 [no out x]))
        ret1 (require (b/emit! (mut graph) 120 ty [store1 yes-value (: 0 i32)]))
        ret2 (require (b/emit! (mut graph) 120 ty [store2 no-value (if linked ret1 (: 0 i32))]))]
    (when linked (assert (g/set-operand! (mut graph) start 1 ret2)))
    (match (calls/create 0 (cast u8 ty) [(: 5 u8) 6] a)
      (Err [e] (panic "{}" e))
      (Ok [owned] (let [(mut proto) owned]
        (require (calls/function! (mut graph) proto a))
        (calls/release! (mut proto)))))
    (reject (merge/canonicalize graph start [ret1] 8 a))
    (reject (merge/canonicalize graph 999999 [ret1 ret2] 8 a))
    (reject (merge/canonicalize graph start [ret1 ret2 999999] 8 a))
    (reject (merge/canonicalize graph start [ret1 ret2] 3 a))
    (set! (mut (.arities graph)) (cast i64 ret1) 2)
    (reject (merge/canonicalize graph start [ret1 ret2] 8 a))
    (set! (mut (.arities graph)) (cast i64 ret1) 3)
    (when linked
      (assert (g/set-operand! (mut graph) ret1 3 ret2))
      (reject (merge/canonicalize graph start [ret1 ret2] 8 a))
      (assert (g/set-operand! (mut graph) ret1 3 0)))
    (execute graph [ret1 ret2] ty)
    (match (merge/canonicalize graph start [ret1 ret2 x] 8 a)
      (Err [e] (panic "{}" e))
      (Ok [owned]
        (let [(mut canonical) owned body (.graph canonical) ret (.returned canonical)]
          (assert (= (len (.roots canonical)) 2))
          (assert (= (get (.roots canonical) 1) x))
          (assert (= (n/opcode (get (.instructions graph) (cast i64 ret1))) 120))
          (assert (= (n/opcode (get (.instructions body) (cast i64 ret1))) 114))
          (execute body (slice (.roots canonical)) ty)
          (let [(mut caller) (g/create a)
                entry (require (b/emit! (mut caller) 104 0 [(: 0 i32)]))
                arg (require (b/emit! (mut caller) 71 5 [entry (: 0 i32) 0]))
                dest (require (b/emit! (mut caller) 71 6 [entry (: 0 i32) 1]))
                fn (require (symbols/function! (mut caller) "_return_merge_case" 0))]
            (match (calls/create 0 (cast u8 ty) [(: 5 u8) 6] a)
              (Err [e] (panic "{}" e))
              (Ok [owned]
                (let [(mut proto) owned call (require (calls/emit! (mut caller) proto entry fn [arg dest] a))
                      returned (require (b/emit! (mut caller) 120 ty [call (if (= ty 0) 0 call) (: 0 i32)]))
                      target (inline/Callee :name "_return_merge_case" :graph body :entry 1
                               :roots [ret] :observed (slice (.roots canonical)) :never false :always false)]
                  (when linked
                    (assert (not (.common (inline/inspect-verified-site caller [returned] call target 8 512 a)))))
                  (unless linked
                  (match (inline/optimize caller [returned] call target 8 512 a)
                    (Err [e] (panic "{}" e))
                    (Ok [owned]
                      (let [(mut changed) owned]
                        (assert (= (.changes changed) 1))
                        (execute (.graph changed) (slice (.roots changed)) ty)
                        (rewrite/release! (mut changed))))))
                  (calls/release! (mut proto)))))
            (g/release! (mut caller)))
          (merge/release! (mut canonical)))))
    (g/release! (mut graph))))
;;; A surviving side exit between two RETURNs in the membership list must
;;; remain linked, while its previous-return link is removed. Input2 traps;
;;; execute checks the returning inputs and preserves the side-exit root.
(defn terminal-membership [] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        out (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        zero (require (b/scalar-constant! (mut graph) 5 0 8))
        two (require (b/scalar-constant! (mut graph) 5 2 8))
        nine (require (b/scalar-constant! (mut graph) 5 9 8))
        trap? (require (b/emit! (mut graph) 14 1 [x two]))
        outer (require (b/emit! (mut graph) 116 0 [start trap?]))
        bad (require (b/emit! (mut graph) 107 0 [outer (: 0 i32)]))
        continuing (require (b/emit! (mut graph) 108 0 [outer (: 0 i32)]))
        side (require (b/emit! (mut graph) 121 0 [bad (: 0 i32) 0]))
        empty? (require (b/emit! (mut graph) 14 1 [x zero]))
        branch (require (b/emit! (mut graph) 116 0 [continuing empty?]))
        yes (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        store1 (require (b/emit! (mut graph) 93 0 [yes out nine]))
        store2 (require (b/emit! (mut graph) 93 0 [no out x]))
        ret1 (require (b/emit! (mut graph) 120 5 [store1 nine (: 0 i32)]))
        ret2 (require (b/emit! (mut graph) 120 5 [store2 x side]))]
    (assert (g/set-operand! (mut graph) side 3 ret1))
    (assert (g/set-operand! (mut graph) start 1 ret2))
    (execute graph [ret1 ret2 side] 5)
    (match (merge/canonicalize graph start [ret1 ret2 side] 8 a)
      (Err [e] (panic "{}" e))
      (Ok [owned]
        (let [(mut canonical) owned body (.graph canonical) ret (.returned canonical)]
          (assert (= (.op1 (get (.instructions body) 1)) ret))
          (assert (= (.op3 (get (.instructions body) (cast i64 ret))) side))
          (assert (= (.op3 (get (.instructions body) (cast i64 side))) 0))
          (assert (= (len (.roots canonical)) 2))
          (assert (= (get (.roots canonical) 1) side))
          (assert (= (.op3 (get (.instructions graph) (cast i64 side))) ret1))
          (execute body (slice (.roots canonical)) 5)
          (merge/release! (mut canonical)))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (terminal-membership)
  (for ty [(: 0 i32) 1 5] (for linked [false true] (test ty linked)))
  (println "return canonicalization native/inlining checks: passed") 0)
