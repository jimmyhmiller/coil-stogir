(module stogir.tests.fold)
(import "stogir.fold" :as f)
(import "coil.result" :use [Some None])

(defn check [(opcode i32) (ty i32) (a u64) (b u64) (want u64)] (-> i64)
  (match (f/integer-binary opcode ty 8 a b)
    (Some [got] (if (= got want) 0 1))
    (None [] 1)))

(defn main [] (-> i64)
  (let [failures
          (+ (check 26 2 255 1 0)
             (check 27 8 0 1 255)
             (check 28 5 0xFFFFFFFFFFFFFFFF 2 0xFFFFFFFFFFFFFFFE)
             (check 26 11 0xFFFFFFFFFFFFFFFF 1 0)
             (check 46 4 0x100 3 0x103)
             (check 47 4 0xFF 0xF0 0xF0)
             (check 48 4 0xFF 0xF0 0xF))]
    (println "fold checks: {} failures" failures)
    (if (= failures 0) 0 1)))
