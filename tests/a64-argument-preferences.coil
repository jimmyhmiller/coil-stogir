;;; Outgoing arguments prefer their ABI register. The preference walk must name
;;; exactly the registers call-abi/layout assigns, and a call whose arguments
;;; are computed just before it needs no setup moves.
(module stogir.tests.a64-argument-preferences)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.allocation" :as allocation)
(import "stogir.relocate" :as read)
(import "stogir.a64.call-abi" :as abi)
(import "stogir.a64.preferences" :as preferences)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [subslice])
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

;;; One call whose arguments are distinct parameters of TYPES. Compares every
;;; argument's preference with the register the ABI layout gives it; stack,
;;; hidden-result and unnamed arguments must stay without preference.
(defn agrees [(label (slice u8)) (types (slice u8))
              (prototype (Result calls/Prototype (slice u8)))] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        (mut arguments) (ArrayList::new [i32] a)
        (mut parts) (ArrayList::new [allocation/Part] a)
        (mut aliases) (ArrayList::new [i32] a)
        (mut failures) 0]
    (for [i 0 (len types)]
      (let [value (require (b/emit! (mut graph) 71 (cast i32 (get types i))
                                    [start (: 0 i32) (cast i32 (+ i 1))]))]
        (push! (mut arguments) value)
        (push! (mut parts) (allocation/create value a))))
    (match prototype
      (Err [message] (println "{}: {}" label message) (set! failures 1))
      (Ok [owned]
        (let [(mut prototype) owned
              call (require (calls/emit! (mut graph) prototype start target
                                         (slice arguments) a))]
          (preferences/prefer-arguments! (mut parts) graph aliases call)
          (match (abi/layout graph call a)
            (Err [message] (println "{}: {}" label message) (set! failures 1))
            (Ok [planned]
              (let [(mut layout) planned]
                (when (!= (len (.arguments layout)) (len arguments))
                  (set! failures (+ failures 1)))
                (for [i 0 (len (.arguments layout))]
                  (let [register (.register (get (.arguments layout) i))
                        hidden? (and (= i 0)
                                     (!= (.kind (.result layout)) 0))
                        expected (if (or hidden? (< register 0)) -1 register)
                        actual (.preferred (at parts i))]
                    (when (!= actual expected)
                      (println "{}: argument {} prefers {}, ABI register {}"
                               label i actual expected)
                      (set! failures (+ failures 1)))))
                (abi/release! (mut layout)))))
          (calls/release! (mut prototype)))))
    (for [i 0 (len parts)] (allocation/release! (elem (mut parts) i)))
    (free! (mut parts)) (free! (mut arguments)) (free! (mut aliases))
    (g/release! (mut graph))
    failures))

(defn walk-checks [] (-> i64)
  (let [a (malloc-allocator)
        ints [(: 11 u8) 11 5 10 11 11 11 11 11 11]
        mixed [(: 11 u8) 12 11 12 12 12 12 12 12 12 12 11 11 11 11 11 11 11]
        grouped [(: 11 u8) 11 11 11 11 11 11 11 11 11]
        placed [(: 6 u8) 11 11 11 11 11 11 11 11 11]]
    (+ (agrees "integers" ints (calls/create 0 11 ints a))
       (agrees "mixed banks" mixed (calls/create 9 11 mixed a))
       (agrees "unnamed" ints
               (calls/create 25 11 (subslice ints 0 2) a))
       ; A two-word group after seven words cannot fit and exhausts the bank.
       (agrees "group overflow" grouped
               (calls/create-grouped 9 11 grouped
                 [(groups/Group :first 7 :count 2 :alignment 8)] a))
       ; The second four-member floating group no longer fits its bank.
       (agrees "floating groups" mixed
               (calls/create-grouped 9 11 mixed
                 [(groups/Group :first 3 :count 4 :alignment 8)
                  (groups/Group :first 7 :count 4 :alignment 8)] a))
       (agrees "group in registers" grouped
               (calls/create-grouped 9 11 grouped
                 [(groups/Group :first 1 :count 2 :alignment 8)
                  (groups/Group :first 5 :count 2 :alignment 8)] a))
       (agrees "indirect result" placed
               (calls/create-result 9 placed [] (results/indirect) a))
       (agrees "result pieces" placed
               (calls/create-result 9 placed [] (results/pieces 11 2) a)))))

(defn combine :cc (cc/C) [(a i64) (b i64) (c i64) (d i64)] (-> i64)
  (primitive/iadd (primitive/iadd (primitive/imul a 3) (primitive/imul b 5))
                  (primitive/iadd (primitive/imul c 7) (primitive/imul d 11))))

(defn blend :cc (cc/C) [(a i64) (x f64) (b i64) (y f64)] (-> f64)
  (+ (+ (* (cast f64 a) 3.0) (* x 5.0)) (+ (* (cast f64 b) 7.0) (* y 11.0))))

;;; Register-to-register moves in either bank: ORR Rd, ZR, Rm and FMOV Dd, Dn.
;;; An indirect call copies its target into a scratch register: one move.
(defn register-moves [(bytes (ArrayList u8))] (-> i64)
  (let [(mut count) 0]
    (for [i 0 (/ (len bytes) 4)]
      (let [word (read/read32 bytes (* i 4))]
        (when (or (= (& word 0x7FE0FFE0) 0x2A0003E0)
                  (= (& word 0xFFFFFC00) 0x1E604000))
          (set! count (+ count 1)))))
    count))

;;; f(_, _, _, _, target, p, q) = combine(p+q, p-q, p*q, p^q) + 1. The
;;; arguments are created last-first, so ascending free-register choice alone
;;; would place each of them in another argument's register.
(defn integer-call [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        (mut failures) 0]
    (for [i 0 4]
      (require (b/emit! (mut graph) 71 11 [start (: 0 i32) (cast i32 i)])))
    (let [target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 4]))
          p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 5]))
          q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 6]))
          fourth (require (b/emit! (mut graph) 48 11 [p q]))
          third (require (b/emit! (mut graph) 28 11 [p q]))
          second (require (b/emit! (mut graph) 27 11 [p q]))
          first (require (b/emit! (mut graph) 26 11 [p q]))
          one (require (b/scalar-constant! (mut graph) 11 1 8))]
      (match (calls/create 0 11 [(: 11 u8) 11 11 11 6 11 11] a)
        (Err [message] (panic "{}" message))
        (Ok [owned]
          (let [(mut own) owned]
            (require (calls/function! (mut graph) own a))
            (calls/release! (mut own)))))
      (match (calls/create 0 11 [(: 11 u8) 11 11 11] a)
        (Err [message] (panic "{}" message))
        (Ok [owned]
          (let [(mut prototype) owned
                call (require (calls/emit! (mut graph) prototype start target
                                           [first second third fourth] a))
                sum (require (b/emit! (mut graph) 26 11 [call one]))
                ret (require (b/emit! (mut graph) 120 11 [call sum (: 0 i32)]))]
            (match (compile/text graph start [ret] a)
              (Err [message] (println "{}" message) (set! failures (+ failures 1)))
              (Ok [text]
                (let [(mut bytes) text]
                  (when (!= (register-moves bytes) 1)
                    (println "integer call: {} register moves"
                             (register-moves bytes))
                    (set! failures (+ failures 1)))
                  (match (jit/map-text (slice bytes))
                    (Err [message] (println "{}" message)
                         (set! failures (+ failures 1)))
                    (Ok [image]
                      (let [(mut mapped) image
                            f (primitive/cast
                                (fnptr (cc/C) [i64 i64 i64 i64 u64 i64 i64] i64)
                                (.base mapped))
                            address (primitive/cast u64
                                      (primitive/cast (ptr u8) (fnptr-of combine)))
                            values [(: -9223372036854775807 i64) -2147483648 -77
                                    -1 0 1 255 2147483647 9223372036854775807]]
                        (for p values
                          (for q values
                            (when (!= (call-ptr f 11 22 33 44 address p q)
                                      (primitive/iadd
                                        (combine (primitive/iadd p q)
                                                 (primitive/isub p q)
                                                 (primitive/imul p q)
                                                 (primitive/ixor p q))
                                        1))
                              (set! failures (+ failures 1)))))
                        (jit/release! (mut mapped)))))
                  (free! (mut bytes)))))
            (calls/release! (mut prototype))))))
    (g/release! (mut graph))
    failures))

;;; f(_, _, target, p, q, _, _, u, v) = blend(p+q, u+v, p-q, u*v) as a tail
;;; call: each bank counts its own arguments.
(defn mixed-call [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        (mut failures) 0]
    (for [i 0 2]
      (require (b/emit! (mut graph) 71 11 [start (: 0 i32) (cast i32 i)])))
    (let [target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
          p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 3]))
          q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 4]))
          _x (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 5]))
          _y (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 6]))
          u (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 7]))
          v (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 8]))
          product (require (b/emit! (mut graph) 28 12 [u v]))
          difference (require (b/emit! (mut graph) 27 11 [p q]))
          total (require (b/emit! (mut graph) 26 12 [u v]))
          sum (require (b/emit! (mut graph) 26 11 [p q]))]
      (match (calls/create 0 12 [(: 11 u8) 11 6 11 11 12 12 12 12] a)
        (Err [message] (panic "{}" message))
        (Ok [owned]
          (let [(mut own) owned]
            (require (calls/function! (mut graph) own a))
            (calls/release! (mut own)))))
      (match (calls/create 0 12 [(: 11 u8) 12 11 12] a)
        (Err [message] (panic "{}" message))
        (Ok [owned]
          (let [(mut prototype) owned
                call (require (calls/emit! (mut graph) prototype start target
                                           [sum total difference product] a))
                ret (require (b/emit! (mut graph) 120 12 [call call (: 0 i32)]))]
            (match (compile/text graph start [ret] a)
              (Err [message] (println "{}" message) (set! failures (+ failures 1)))
              (Ok [text]
                (let [(mut bytes) text]
                  (when (!= (register-moves bytes) 1)
                    (println "mixed call: {} register moves" (register-moves bytes))
                    (set! failures (+ failures 1)))
                  (match (jit/map-text (slice bytes))
                    (Err [message] (println "{}" message)
                         (set! failures (+ failures 1)))
                    (Ok [image]
                      (let [(mut mapped) image
                            f (primitive/cast
                                (fnptr (cc/C)
                                       [i64 i64 u64 i64 i64 f64 f64 f64 f64] f64)
                                (.base mapped))
                            address (primitive/cast u64
                                      (primitive/cast (ptr u8) (fnptr-of blend)))
                            integers [(: -1000000 i64) -1 0 1 123456789]
                            reals [(: -2.5 f64) -0.0 0.0 1.0 1.0e10]]
                        (for p integers
                          (for q integers
                            (for u reals
                              (for v reals
                                (when (!= (call-ptr f 1 2 address p q 3.0 4.0 u v)
                                          (blend (+ p q) (+ u v) (- p q) (* u v)))
                                  (set! failures (+ failures 1)))))))
                        (jit/release! (mut mapped)))))
                  (free! (mut bytes)))))
            (calls/release! (mut prototype))))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [failures (+ (walk-checks) (integer-call) (mixed-call))]
    (println "argument preference checks: {} failures" failures)
    (if (= failures 0) 0 1)))
