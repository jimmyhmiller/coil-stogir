(module stogir.tests.stack)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.stack" :as stack)
(import "stogir.a64.compile" :as compile)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn rejected [(result (Result i32 (slice u8)))] (-> i64)
  (match result (Ok [_] 1) (Err [_] 0)))

(defn frame-object-rejections [] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        dynamic (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        count (require (b/scalar-constant! (mut graph) 5 17 8))
        zero (require (b/scalar-constant! (mut graph) 5 0 8))
        object (require (b/frame-object! (mut graph) start count 16))
        saved (require (b/stack-save! (mut graph) object))
        ret (require (b/emit! (mut graph) 120 6 [saved object (: 0 i32)]))
        before (len (.instructions graph))]
    (assert (= (rejected (b/frame-object! (mut graph) saved count 16)) 0))
    (assert (= (rejected (b/frame-object! (mut graph) start dynamic 16)) 0))
    (assert (= (rejected (b/frame-object! (mut graph) start zero 16)) 0))
    (assert (= (len (.instructions graph)) before))
    (for malformed [(n/make 81 6 32768 saved count 16)
                    (n/make 81 6 32768 start dynamic 16)
                    (n/make 81 6 32768 start zero 16)
                    (n/make 81 6 32769 start count 16)
                    (n/make 81 5 32768 start count 16)]
      (set! (mut (.instructions graph)) (cast i64 object) malformed)
      (assert (= (rejected (stack/validate graph object)) 0))
      (match (compile/text graph start [ret] a)
        (Err [_] 0)
        (Ok [text]
            (let [(mut text) text]
              (free! (mut text))
              (panic "native pipeline accepted malformed frame object")))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (frame-object-rejections)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        count (require (b/scalar-constant! (mut graph) 5 17 8))
        negative
          (require (b/scalar-constant! (mut graph) 11 0xFFFFFFFFFFFFFFFF 8))
        overflow
          (require (b/scalar-constant! (mut graph) 5 0x7FFFFFFFFFFFFFF1 8))
        negative-byte (require (b/scalar-constant! (mut graph) 8 255 8))
        fp (require (b/scalar-constant! (mut graph) 12 0 8))
        variable (require (b/variable! (mut graph) 5 start "not-count" 8))
        rounding-overflow
          (require (b/scalar-constant! (mut graph) 5 0x7FFFFFFFFFFFFFE0 8))
        (mut failures) 0]
    (match (stack/constant-size graph count)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [amount] (when (!= amount 32) (set! failures (+ failures 1)))))
    (let [before (len (.instructions graph))]
      (set! failures
            (+ failures
               (rejected (b/stack-allocate! (mut graph) start negative 16))
               (rejected (b/stack-allocate! (mut graph) start negative-byte 16))
               (rejected (b/stack-allocate! (mut graph) start overflow 16))
               (rejected (b/stack-allocate! (mut graph)
                                            start
                                            rounding-overflow
                                            64))
               (rejected (b/stack-allocate! (mut graph) start fp 16))
               (rejected (b/stack-allocate! (mut graph) start variable 16))
               (rejected (b/stack-allocate! (mut graph) count count 16))
               (rejected (b/stack-allocate! (mut graph) start count 3))
               (rejected (b/stack-free! (mut graph) start negative))
               (rejected (b/stack-free! (mut graph) start overflow))
               (rejected (b/frame-object! (mut graph) start negative 16))
               (rejected (b/frame-object! (mut graph) start overflow 16))
               (rejected (b/frame-object! (mut graph) start fp 16))
               (rejected (b/frame-object! (mut graph) count count 16))
               (rejected (b/frame-object! (mut graph) start count 3))))
      (when (!= (len (.instructions graph)) before)
        (set! failures (+ failures 1))))
    (let [before (len (.instructions graph))]
      (set! failures
            (+ failures
               (rejected (b/stack-save! (mut graph) count))
               (rejected (b/stack-restore! (mut graph) count count))
               (rejected (b/stack-restore! (mut graph) start count))
               (rejected (b/stack-restore! (mut graph) start fp))
               (rejected (b/stack-restore! (mut graph) start variable))
               (rejected (b/stack-restore! (mut graph) start 0))))
      (when (!= (len (.instructions graph)) before)
        (set! failures (+ failures 1))))
    (for bad [(require (b/emit! (mut graph) 83 5 [start]))
              (require (b/emit! (mut graph) 83 6 [count]))
              (require (b/emit! (mut graph) 84 6 [start count]))
              (require (b/emit! (mut graph) 84 0 [start fp]))
              (require (b/emit! (mut graph) 84 0 [start variable]))]
      (set! failures (+ failures (rejected (stack/validate graph bad)))))
    (for bad [(require (b/emit! (mut graph) 81 5 [start count (: 16 i32)]))
              (require (b/emit! (mut graph) 82 6 [start count]))
              (require (b/emit! (mut graph) 81 6 [start fp (: 16 i32)]))]
      (set! failures (+ failures (rejected (stack/validate graph bad)))))
    (g/release! (mut graph))
    (let [(mut graph) (g/create allocator)
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          count (require (b/scalar-constant! (mut graph) 5 17 8))
          allocation (require (b/stack-allocate! (mut graph) start count 32))
          ret
            (require (b/emit! (mut graph)
                              120
                              6
                              [allocation allocation (: 0 i32)]))]
      (match (compile/text graph start [ret] allocator)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [text]
            (let [(mut bytes) text]
              (free! (mut bytes)))))
      (g/release! (mut graph)))
    (println "stack byte-count, type, control and alignment checks: {} failures"
             failures)
    (if (= failures 0) 0 1)))
