(module stogir.tests.dominators)
(import "stogir.cfg" :as cfg)
(import "stogir.adjacency" :as adj)
(import "stogir.dominators" :as dom)
(import "stogir.loops" :as loops)
(import "stogir.placement" :as placement)
(import "coil.result" :use [Ok Err])
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defn fixture [(allocator (dyn Allocator))] (-> cfg/Blocks)
  (let [(mut blocks)
          (cfg/Blocks
            :starts (ArrayList::new [i32] allocator)
            :membership (ArrayList::new [i32] allocator)
            :edges (ArrayList::new [cfg/Edge] allocator))
        (mut i) (: 0 i32)]
    (while (< i 6)
      (push! (mut (.membership blocks)) i)
      (when (> i 0) (push! (mut (.starts blocks)) i))
      (set! i (+ i 1)))
    blocks))

(defn edge! [(blocks (mut cfg/Blocks)) (from i32) (to i32)] (-> void)
  (push! (mut (.edges blocks))
         (cfg/Edge
           :from from
           :to to
           :source from
           :position 1)))

(defn analyze [(blocks cfg/Blocks)
               (irreducible bool)
               (allocator (dyn Allocator))]
  (-> i64)
  (let [(mut pred) (adj/build blocks true allocator)
        (mut succ) (adj/build blocks false allocator)
        (mut order) (adj/reverse-postorder blocks succ 1 allocator)
        (mut idom) (dom/build blocks pred order allocator)
        (mut failures) 0]
    (when (!= (get idom 1) 1) (set! failures (+ failures 1)))
    (when (!= (get idom 2) 1) (set! failures (+ failures 1)))
    (when (!= (get idom 3) 1) (set! failures (+ failures 1)))
    (when (!= (get idom 4) 1) (set! failures (+ failures 1)))
    (when (!= (get idom 5) (if irreducible 0 4)) (set! failures (+ failures 1)))
    (when (dom/dominates? idom 2 4) (set! failures (+ failures 1)))
    (when (dom/dominates? idom 3 4) (set! failures (+ failures 1)))
    (when (not (dom/dominates? idom 1 4)) (set! failures (+ failures 1)))
    (when (!= (dom/common idom 2 3) 1) (set! failures (+ failures 1)))
    (when (!= (dom/common idom 4 4) 4) (set! failures (+ failures 1)))
    (when (!= (dom/common idom 4 5) (if irreducible 0 4))
      (set! failures (+ failures 1)))
    (free! (mut idom))
    (free! (mut order))
    (adj/release! (mut pred))
    (adj/release! (mut succ))
    failures))

(defn nested-check [(blocks cfg/Blocks) (allocator (dyn Allocator))] (-> i64)
  (let [(mut pred) (adj/build blocks true allocator)
        (mut succ) (adj/build blocks false allocator)
        (mut order) (adj/reverse-postorder blocks succ 1 allocator)
        (mut idom) (dom/build blocks pred order allocator)
        (mut depth) (loops/depths blocks pred idom allocator)
        (mut failures) 0]
    (when (!= (get depth 1) 0) (set! failures (+ failures 1)))
    (when (!= (get depth 2) 1) (set! failures (+ failures 1)))
    (when (!= (get depth 3) 2) (set! failures (+ failures 1)))
    (when (!= (get depth 4) 2) (set! failures (+ failures 1)))
    (when (!= (get depth 5) 0) (set! failures (+ failures 1)))
    (match (placement/choose-block idom depth 1 4)
      (Ok [block] (when (!= block 1) (set! failures (+ failures 1))))
      (Err [_] (set! failures (+ failures 1))))
    (match (placement/choose-block idom depth 2 4)
      (Ok [block] (when (!= block 2) (set! failures (+ failures 1))))
      (Err [_] (set! failures (+ failures 1))))
    (match (placement/choose-block idom depth 3 4)
      (Ok [block] (when (!= block 4) (set! failures (+ failures 1))))
      (Err [_] (set! failures (+ failures 1))))
    (match (placement/choose-block idom depth 4 2)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (free! (mut depth))
    (free! (mut idom))
    (free! (mut order))
    (adj/release! (mut pred))
    (adj/release! (mut succ))
    failures))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut diamond) (fixture allocator)
        (mut irreducible) (fixture allocator)
        (mut nested) (fixture allocator)]
    (edge! (mut diamond) 1 2)
    (edge! (mut diamond) 1 3)
    (edge! (mut diamond) 2 4)
    (edge! (mut diamond) 3 4)
    (edge! (mut diamond) 4 5)
    (edge! (mut irreducible) 1 2)
    (edge! (mut irreducible) 1 3)
    (edge! (mut irreducible) 2 4)
    (edge! (mut irreducible) 3 4)
    (edge! (mut irreducible) 4 2)
    (edge! (mut irreducible) 4 3)
    (edge! (mut nested) 1 2)
    (edge! (mut nested) 2 3)
    (edge! (mut nested) 3 4)
    (edge! (mut nested) 4 3)
    (edge! (mut nested) 4 2)
    (edge! (mut nested) 3 2)
    (edge! (mut nested) 2 5)
    (let [failures
            (+ (analyze diamond false allocator)
               (analyze irreducible true allocator)
               (nested-check nested allocator))]
      (cfg/release! (mut nested))
      (cfg/release! (mut diamond))
      (cfg/release! (mut irreducible))
      (println "dominator checks: {} failures" failures)
      (if (= failures 0) 0 1))))
