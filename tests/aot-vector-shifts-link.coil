(module stogir.tests.aot-vector-shifts-link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "stogir.types" :as types)
(import "stogir.test-data" :use [table link-entries])

(defn pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [i (% (+ lane seed (if right? (: 3 i64) 0)) 11)
        fp? (types/floating? base)
        wide? (= base 12)]
    (if fp?
        (if wide?
            (match i
              (0 (: 0 u64))
              (1 0x8000000000000000)
              (2 0x3FF0000000000000)
              (3 0xBFF0000000000000)
              (4 1)
              (5 0x000FFFFFFFFFFFFF)
              (6 0x7FEFFFFFFFFFFFFF)
              (7 0x7FF0000000000000)
              (8 0xFFF0000000000000)
              (9 0x7FF8123456789ABC)
              (_ 0x7FF0123456789ABC))
            (match i
              (0 (: 0 u64))
              (1 0x80000000)
              (2 0x3F800000)
              (3 0xBF800000)
              (4 1)
              (5 0x007FFFFF)
              (6 0x7F7FFFFF)
              (7 0x7F800000)
              (8 0xFF800000)
              (9 0x7FC12345)
              (_ 0x7F812345)))
        (match i
          (0 (: 0 u64))
          (1 1)
          (2 0xFFFFFFFFFFFFFFFF)
          (3 0x8000000000000000)
          (4 0x7FFFFFFFFFFFFFFF)
          (5 0x8080808080808080)
          (6 0x7F7F7F7F7F7F7F7F)
          (7 0xFFFF0000FFFF0000)
          (8 0x123456789ABCDEF0)
          (9 0xFFFFFFFFFFFFFFFE)
          (_ 0x0102030405060708)))))

(defn input-byte [(base i32) (index i64) (seed i64) (right? bool)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (pattern base (/ index width) seed right?)
              (cast u64 (* (% index width) 8))))))

(defn count-pattern [(index i64) (seed i64)] (-> u64)
  (match (% (+ index seed) 22)
    (0 (: 0 u64))
    (1 1)
    (2 7)
    (3 8)
    (4 9)
    (5 15)
    (6 16)
    (7 17)
    (8 31)
    (9 32)
    (10 33)
    (11 63)
    (12 64)
    (13 65)
    (14 127)
    (15 128)
    (16 255)
    (17 256)
    (18 0x100000001)
    (19 0x8000000000000000)
    (20 0xFFFFFFFFFFFFFFFF)
    (_ 0x123456789ABCDEF0)))

(defn count-value [(count-type i32) (index i64) (seed i64)] (-> u64)
  (let [bits (count-pattern index seed)]
    (if (= count-type 0)
        bits
        (if (= count-type 1)
            (& bits 1)
            (& bits
               (cast u64
                     (- (<< (: 1 u128)
                            (cast u128 (* 8 (types/scalar-size count-type 8))))
                        1)))))))

(defn count-byte [(base i32) (count-type i32) (index i64) (seed i64)] (-> u8)
  (let [element
          (cast i64 (types/scalar-size (if (= count-type 0) base count-type) 8))]
    (cast u8
          (>> (count-value count-type (/ index element) seed)
              (cast u64 (* (% index element) 8))))))

(defn expected [(opcode i32) (base i32) (bits u64) (count u64)] (-> u64)
  (let [width (* (types/scalar-size base 8) 8)
        range (<< (: 1 u128) (cast u128 width))
        mask (- range 1)
        x (& (cast u128 bits) mask)
        shift (& count (cast u64 (- width 1)))]
    (cast u64
          (& mask
             (cond (= opcode 49) (<< x (cast u128 shift))
                   (= opcode 50) (>> x (cast u128 shift))
                   (= opcode 52)
                     (| (<< x (cast u128 shift))
                        (>> x
                            (cast u128
                                  (& (- (cast u64 width) shift)
                                     (cast u64 (- width 1))))))
                   (= opcode 53)
                     (| (>> x (cast u128 shift))
                        (<< x
                            (cast u128
                                  (& (- (cast u64 width) shift)
                                     (cast u64 (- width 1))))))
                   :else
                     (let [signed
                             (if (>= x (>> range 1))
                                 (- (cast i128 x) (cast i128 range))
                                 (cast i128 x))]
                       (cast u128 (>> signed (cast i128 shift)))))))))

(defn read-word [(buffer (slice u8)) (offset i64) (width i32)] (-> u64)
  (let [(mut result) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (< i width)
      (set! result
            (| result
               (<< (cast u64 (get buffer (+ offset (cast i64 i))))
                   (cast u64 (* i 8)))))
      (set! i (+ i 1)))
    result))

(defn exercise [(ty i32)
                (opcode i32)
                (count-type i32)
                (mode i32)
                (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        base (types/base-type ty)
        width (types/size ty 8)
        element (types/scalar-size base 8)
        lanes (/ width element)
        count-width (if (= count-type 0) width (types/scalar-size count-type 8))
        f (p/cast (fnptr (cc/C) [u64 u64 u64] void) address)
        (mut input) (ArrayList::new [u8] allocator)
        (mut counts) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut seed) (: 0 i64)
        (mut failures) 0]
    (while (< seed 22)
      (clear! (mut input))
      (clear! (mut counts))
      (clear! (mut output))
      (let [(mut i) (: 0 i64)]
        (while (< i 32)
          (push! (mut input) (input-byte base i seed false))
          (push! (mut counts) (count-byte base count-type i seed))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 80) (push! (mut output) 165) (set! i (+ i 1))))
      (call-ptr f
                (p/cast u64 (.data output))
                (p/cast u64 (.data input))
                (p/cast u64 (.data counts)))
      (let [(mut lane) (: 0 i32)]
        (while (< lane lanes)
          (let [x
                  (pattern base
                           (cast i64 lane)
                           (if (or (= mode 2) (= mode 3)) (: 9 i64) seed)
                           false)
                count
                  (if (= mode 4)
                      x
                      (count-value count-type
                                   (if (= count-type 0)
                                       (cast i64 lane)
                                       (: 0 i64))
                                   (if (or (= mode 1) (= mode 3))
                                       (: 20 i64)
                                       seed)))
                wanted (expected opcode base x count)
                got
                  (read-word (slice output)
                             (* (cast i64 lane) (cast i64 element))
                             element)]
            (when (!= got wanted)
              (println "vector shift ty{} op{} count-type{} mode{} seed{} lane{} got{} expected{}"
                       ty
                       opcode
                       count-type
                       mode
                       seed
                       lane
                       got
                       wanted)
              (set! failures (+ failures 1))))
          (set! lane (+ lane 1))))
      (let [(mut i) (: 0 i64)]
        (while (< i 80)
          (when (>= i (cast i64 width))
            (let [wanted
                    (if (and (< mode 4)
                             (>= i 24)
                             (< i (+ 24 (cast i64 width))))
                        (input-byte base
                                    (- i 24)
                                    (if (or (= mode 2) (= mode 3))
                                        (: 9 i64)
                                        seed)
                                    false)
                        (if (and (< mode 4)
                                 (>= i 48)
                                 (< i (+ 48 (cast i64 count-width))))
                            (count-byte base
                                        count-type
                                        (- i 48)
                                        (if (or (= mode 1) (= mode 3))
                                            (: 20 i64)
                                            seed))
                            (: 165 u8)))]
              (when (!= (get output i) wanted) (set! failures (+ failures 1)))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 32)
          (when (or (!= (get input i) (input-byte base i seed false))
                    (!= (get counts i) (count-byte base count-type i seed)))
            (set! failures (+ failures 1)))
          (set! i (+ i 1))))
      (set! seed (+ seed 1)))
    (free! (mut input))
    (free! (mut counts))
    (free! (mut output))
    failures))

