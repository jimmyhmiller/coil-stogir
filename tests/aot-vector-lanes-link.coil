    (set! failures (+ failures (linked 65 61 1 5 3 1 c"stogir_vector_lane_7")))
    (set! failures (+ failures (linked 65 61 1 5 4 0 c"stogir_vector_lane_8")))
    (set! failures (+ failures (linked 65 61 1 5 4 1 c"stogir_vector_lane_9")))
    (set! failures (+ failures (linked 65 61 1 5 5 0 c"stogir_vector_lane_10")))
    (set! failures (+ failures (linked 65 61 1 5 5 1 c"stogir_vector_lane_11")))
    (set! failures (+ failures (linked 65 61 1 5 6 0 c"stogir_vector_lane_12")))
    (set! failures (+ failures (linked 65 61 1 5 6 1 c"stogir_vector_lane_13")))
    (set! failures (+ failures (linked 65 61 1 5 7 0 c"stogir_vector_lane_14")))
    (set! failures (+ failures (linked 65 61 1 5 7 1 c"stogir_vector_lane_15")))
