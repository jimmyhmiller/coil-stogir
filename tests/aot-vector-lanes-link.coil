(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row LINKED-CASES
      (set! failures
            (+ failures
               (linked (.ty row)
                       (.op row)
                       (.st row)
                       (.ity row)
                       (.lane row)
                       (.mode row)
                       (.name row)))))
    (for row LINKED-PRESSURE-CASES
      (set! failures
            (+ failures
               (linked-pressure (.ty row) (.op row) (.st row) (.name row)))))
    (println "linked vector lanes: 1490 objects; failures {}" failures)
    failures))
