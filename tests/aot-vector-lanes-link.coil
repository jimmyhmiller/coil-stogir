(module stogir.tests.aot-vector-lanes-link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "stogir.types" :as types)
(import "stogir.test-data" :use [table])

(defn pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [i (% (+ lane (if right? (/ seed 11) (% seed 11))) 11)
        fp? (types/floating? base)
        wide? (= base 12)]
    (if fp?
        (if wide?
            (match i
              (0 (: 0 u64))
              (1 0x8000000000000000)
              (2 0x3FF0000000000000)
              (3 0xBFF0000000000000)
              (4 1)
              (5 0x000FFFFFFFFFFFFF)
              (6 0x7FEFFFFFFFFFFFFF)
              (7 0x7FF0000000000000)
              (8 0xFFF0000000000000)
              (9 0x7FF8123456789ABC)
              (_ 0x7FF0123456789ABC))
            (match i
              (0 (: 0 u64))
              (1 0x80000000)
              (2 0x3F800000)
              (3 0xBF800000)
              (4 1)
              (5 0x007FFFFF)
              (6 0x7F7FFFFF)
              (7 0x7F800000)
              (8 0xFF800000)
              (9 0x7FC12345)
              (_ 0x7F812345)))
        (match i
          (0 (: 0 u64))
          (1 1)
          (2 0xFFFFFFFFFFFFFFFF)
          (3 (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1))))
          (4 (- (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1)))
                1))
          (5 0x8080808080808080)
          (6 0x7F7F7F7F7F7F7F7F)
          (7 0xFFFF0000FFFF0000)
          (8 0x123456789ABCDEF0)
          (9 0xFFFFFFFFFFFFFFFE)
          (_ 0x0102030405060708)))))

(defn input-byte [(base i32) (index i64) (seed i64) (right? bool)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (pattern base (/ index width) seed right?)
              (cast u64 (* (% index width) 8))))))

(defn read-word [(buffer (slice u8)) (offset i64) (width i32)] (-> u64)
  (let [(mut result) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (< i width)
      (set! result
            (| result
               (<< (cast u64 (get buffer (+ offset (cast i64 i))))
                   (cast u64 (* i 8)))))
      (set! i (+ i 1)))
    result))

(defn mask-width [(ty i32)] (-> u64)
  (cast u64 (- (<< (: 1 u128) (cast u128 (* 8 (types/scalar-size ty 8)))) 1)))

(defn replacement-bits [(st i32) (seed i64) (mode i32)] (-> u64)
  (let [literal? (or (= mode 2) (= mode 3))
        bits (& (pattern st 0 (if literal? 10 seed) false) (mask-width st))]
    (if (and literal? (= st 1)) (& bits 1) bits)))

(defn vector-byte [(base i32) (i i64) (seed i64) (mode i32)] (-> u8)
  (input-byte base i (if (= mode 1) 9 (if (= mode 3) 10 seed)) false))

(defn count-value [(ty i32) (test i32)] (-> u64)
  (let [raw
          (match test
            (0 (: 0 u64))
            (1 1)
            (2 2)
            (3 3)
            (4 4)
            (5 7)
            (6 8)
            (7 15)
            (8 16)
            (9 31)
            (10 32)
            (11 63)
            (12 64)
            (13 127)
            (14 128)
            (15 255)
            (16 256)
            (17 0x100000001)
            (18 0x8000000000000000)
            (19 0xFFFFFFFFFFFFFFFF)
            (20 0xFFFFFFFFFFFFFFFE)
            (_ 0x123456789ABCDEF0))]
    (& raw (mask-width ty))))

(defn signed-wide [(st i32) (bits u64)] (-> u64)
  (let [width (* 8 (types/scalar-size st 8))
        modulus (<< (: 1 u128) (cast u128 width))]
    (if (and (types/signed? st) (>= (cast u128 bits) (>> modulus 1)))
        (cast u64 (- (cast i128 bits) (cast i128 modulus)))
        bits)))

(defn exercise [(ty i32)
                (op i32)
                (st i32)
                (ity i32)
                (lane i32)
                (mode i32)
                (address (ptr u8))] (-> i64)
  (let [alc (malloc-allocator)
        width (types/size ty 8)
        base (types/base-type ty)
        element (types/scalar-size st 8)
        f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] void) address)
        (mut input) (ArrayList::new [u8] alc)
        (mut index) (ArrayList::new [u8] alc)
        (mut replacement) (ArrayList::new [u8] alc)
        (mut output) (ArrayList::new [u8] alc)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (let [(mut test) (: 0 i32)]
        (while (< test (if (and (< lane 0) (!= op 63)) 22 1))
          (clear! (mut input))
          (clear! (mut index))
          (clear! (mut replacement))
          (clear! (mut output))
          (let [index-bits (count-value ity test)
                selected (if (>= lane 0) (cast u64 lane) index-bits)
                fresh (replacement-bits st seed mode)
                (mut i) (: 0 i64)]
            (while (< i 128) (push! (mut output) 165) (set! i (+ i 1)))
            (set! i 0)
            (while (< i 32)
              (push! (mut input) (input-byte base i seed false))
              (set! i (+ i 1)))
            (set! i 0)
            (while (< i 16)
              (push! (mut index)
                     (cast u8 (>> index-bits (cast u64 (* (% i 8) 8)))))
              (push! (mut replacement)
                     (cast u8 (>> fresh (cast u64 (* (% i 8) 8)))))
              (set! i (+ i 1)))
            (call-ptr f
                      (p/cast u64 (.data output))
                      (p/cast u64 (.data input))
                      (p/cast u64 (.data index))
                      (p/cast u64 (.data replacement)))
            (let [valid? (< selected (cast u64 (types/lanes ty)))
                  offset
                    (if valid?
                        (* (cast i64 selected) (cast i64 element))
                        (: 0 i64))
                  (mut extracted) (: 0 u64)]
              (set! i 0)
              (while (< i (cast i64 element))
                (when valid?
                  (set! extracted
                        (| extracted
                           (<< (cast u64
                                     (vector-byte base (+ offset i) seed mode))
                               (cast u64 (* i 8))))))
                (set! i (+ i 1)))
              (set! i 0)
              (while (< i 128)
                (let [wanted
                        (cond (< i
                                 (if (= op 61)
                                     (cast i64 element)
                                     (cast i64 width)))
                                (if (= op 61)
                                    (cast u8 (>> extracted (cast u64 (* i 8))))
                                    (if (or (= op 63)
                                            (and valid?
                                                 (>= i offset)
                                                 (< i
                                                    (+ offset
                                                       (cast i64 element)))))
                                        (cast u8
                                              (>> fresh
                                                  (cast u64
                                                        (* (% i
                                                              (cast i64 element))
                                                           8))))
                                        (vector-byte base i seed mode)))
                              (and (= op 61)
                                   (types/integer? st)
                                   (>= i 16)
                                   (< i 24))
                                (cast u8
                                      (>> (signed-wide st extracted)
                                          (cast u64 (* (- i 16) 8))))
                              (and (< mode 4)
                                   (!= op 63)
                                   (>= i 32)
                                   (< i (+ 32 (cast i64 width))))
                                (vector-byte base (- i 32) seed mode)
                              (and (< mode 4)
                                   (!= op 61)
                                   (>= i 64)
                                   (< i (+ 64 (cast i64 element))))
                                (cast u8 (>> fresh (cast u64 (* (- i 64) 8))))
                              (and (< mode 4)
                                   (!= op 63)
                                   (>= i 80)
                                   (< i
                                      (+ 80
                                         (cast i64 (types/scalar-size ity 8)))))
                                (cast u8
                                      (>> selected (cast u64 (* (- i 80) 8))))
                              :else (: 165 u8))]
                  (when (!= (get output i) wanted)
                    (when (< failures 6)
                      (println "lane ty{} op{} st{} ity{} lane{} mode{} seed{} test{} byte{} got{} expected{}"
                               ty
                               op
                               st
                               ity
                               lane
                               mode
                               seed
                               test
                               i
                               (get output i)
                               wanted))
                    (set! failures (+ failures 1))))
                (set! i (+ i 1))))
            (set! i 0)
            (while (< i 32)
              (when (!= (get input i) (input-byte base i seed false))
                (set! failures (+ failures 1)))
              (set! i (+ i 1)))
            (set! i 0)
            (while (< i 16)
              (when (or (!= (get index i)
                            (cast u8 (>> index-bits (cast u64 (* (% i 8) 8)))))
                        (!= (get replacement i)
                            (cast u8 (>> fresh (cast u64 (* (% i 8) 8))))))
                (set! failures (+ failures 1)))
              (set! i (+ i 1))))
          (set! test (+ test 1))))
      (set! seed (+ seed 1)))
    (free! (mut input))
    (free! (mut index))
    (free! (mut replacement))
    (free! (mut output))
    failures))

