(defn pressure-exercise [(ty i32) (op i32) (st i32) (address (ptr u8))] (-> i64)
  (let [alc (malloc-allocator)
        width (types/size ty 8)
        base (types/base-type ty)
        element (types/scalar-size st 8)
        lanes (types/lanes ty)
        f (p/cast (fnptr (cc/C) [u64 u64 u64] u64) address)
        target
          (p/cast u64
                  (p/cast (ptr u8)
                          (: (fnptr-of probe) (fnptr (cc/C) [(ptr u8)] u64))))
        (mut input) (ArrayList::new [u8] alc)
        (mut snapshot) (ArrayList::new [u8] alc)
        (mut output) (ArrayList::new [u8] alc)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (clear! (mut input))
      (clear! (mut snapshot))
      (clear! (mut output))
      (let [(mut i) (: 0 i64)]
        (while (< i 4096) (push! (mut input) 165) (set! i (+ i 1)))
        (set! i 0)
        (while (< i 2048) (push! (mut output) 165) (set! i (+ i 1)))
        (set! i 0)
        (while (< i (* 40 (cast i64 width)))
          (set! (mut input) i (input-byte base i seed false))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 40)
          (let [count (count-value 5 (cast i32 (% i 22)))
                bits (& (pattern st i seed false) (mask-width st))
                (mut byte) (: 0 i64)]
            (while (< byte 8)
              (set! (mut input)
                    (+ 1024 (* i 8) byte)
                    (cast u8 (>> count (cast u64 (* byte 8)))))
              (set! (mut input)
                    (+ 1536 (* i 8) byte)
                    (cast u8 (>> bits (cast u64 (* byte 8)))))
              (set! byte (+ byte 1))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 4096) (push! (mut snapshot) (get input i)) (set! i (+ i 1)))
        (when (!= (call-ptr f
                            (p/cast u64 (.data output))
                            (p/cast u64 (.data input))
                            target)
                  811)
          (println "lane pressure guard ty{} op{}" ty op)
          (set! failures (+ failures 1)))
        (set! i 0)
        (while (< i 2048)
          (let [slot (/ i 16)
                byte (% i 16)
                original-slot (/ (- i 640) 16)
                original-byte (% (- i 640) 16)
                replacement-slot (/ (- i 1280) 8)
                replacement-byte (% (- i 1280) 8)
                index-slot (/ (- i 1600) 8)
                index-byte (% (- i 1600) 8)
                selected (count-value 5 (cast i32 (% slot 22)))
                valid? (< selected (cast u64 lanes))
                fresh (& (pattern st slot seed false) (mask-width st))
                wanted
                  (cond (and (< i 640)
                             (< byte
                                (if (= op 61)
                                    (cast i64 element)
                                    (cast i64 width))))
                          (if (= op 61)
                              (if valid?
                                  (get snapshot
                                       (+ (* slot (cast i64 width))
                                          (* (cast i64 selected)
                                             (cast i64 element))
                                          byte))
                                  (: 0 u8))
                              (if (or (= op 63)
                                      (and valid?
                                           (= (/ byte (cast i64 element))
                                              (cast i64 selected))))
                                  (cast u8
                                        (>> fresh
                                            (cast u64
                                                  (* (% byte (cast i64 element))
                                                     8))))
                                  (get snapshot
                                       (+ (* slot (cast i64 width)) byte))))
                        (and (!= op 63)
                             (>= i 640)
                             (< i 1280)
                             (< original-byte (cast i64 width)))
                          (get snapshot
                               (+ (* original-slot (cast i64 width))
                                  original-byte))
                        (and (!= op 61)
                             (>= i 1280)
                             (< i 1600)
                             (< replacement-byte (cast i64 element)))
                          (cast u8
                                (>> (& (pattern st replacement-slot seed false)
                                       (mask-width st))
                                    (cast u64 (* replacement-byte 8))))
                        (and (!= op 63) (>= i 1600) (< i 1920))
                          (cast u8
                                (>> (count-value 5 (cast i32 (% index-slot 22)))
                                    (cast u64 (* index-byte 8))))
                        :else (: 165 u8))]
            (when (!= (get output i) wanted)
              (when (< failures 6)
                (println "lane pressure ty{} op{} st{} seed{} byte{} got{} expected{}"
                         ty
                         op
                         st
                         seed
                         i
                         (get output i)
                         wanted))
              (set! failures (+ failures 1))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 4096)
          (when (!= (get input i) (get snapshot i))
            (set! failures (+ failures 1)))
          (set! i (+ i 1))))
      (set! seed (+ seed 1)))
    (free! (mut input))
    (free! (mut snapshot))
    (free! (mut output))
    failures))

(import "coil.os" :as os)

(defn linked [(ty i32)
              (op i32)
              (st i32)
              (ity i32)
              (lane i32)
              (mode i32)
              (name (ptr i8))] (-> i64)
  (let [address (os/dlsym (p/cast (ptr i8) (: -2 i64)) name)]
    (if (= (p/cast u64 address) 0)
        (do (println "missing linked lane symbol") 1)
        (exercise ty op st ity lane mode (p/cast (ptr u8) address)))))

(defn linked-pressure [(ty i32) (op i32) (st i32) (name (ptr i8))] (-> i64)
  (let [address (os/dlsym (p/cast (ptr i8) (: -2 i64)) name)]
    (if (= (p/cast u64 address) 0)
        (do (println "missing lane pressure symbol") 1)
        (pressure-exercise ty op st (p/cast (ptr u8) address)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (set! failures (+ failures (linked 65 61 1 5 0 0 c"stogir_vector_lane_0")))
    (set! failures (+ failures (linked 65 61 1 5 0 1 c"stogir_vector_lane_1")))
    (set! failures (+ failures (linked 65 61 1 5 1 0 c"stogir_vector_lane_2")))
