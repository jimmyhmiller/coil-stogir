(module stogir.tests.jit-vector-locals)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

;;; A callee that overwrites every register a call may change. AArch64: v0-v7
;;; and v16-v31 loaded from `input`, x0-x15 set, x0 = 173. x86-64 (bytes from
;;; tools/x86/asm-bytes.sh): movups xmm0..xmm15, [rdi]; mov eax, 173;
;;; mov ecx, 174; mov edx, 175; mov esi, 176; mov edi, 177; mov r8d, 178;
;;; mov r9d, 179; mov r10d, 180; mov r11d, 181.
(target/arch-pick
  (defn probe :cc (cc/C) [(input (ptr u8))] (-> u64)
    (p/machine-code (Aarch64)
                    0xf1
                    0x03
                    0x00
                    0xaa
                    0x20
                    0x02
                    0xc0
                    0x3d
                    0x21
                    0x02
                    0xc0
                    0x3d
                    0x22
                    0x02
                    0xc0
                    0x3d
                    0x23
                    0x02
                    0xc0
                    0x3d
                    0x24
                    0x02
                    0xc0
                    0x3d
                    0x25
                    0x02
                    0xc0
                    0x3d
                    0x26
                    0x02
                    0xc0
                    0x3d
                    0x27
                    0x02
                    0xc0
                    0x3d
                    0x30
                    0x02
                    0xc0
                    0x3d
                    0x31
                    0x02
                    0xc0
                    0x3d
                    0x32
                    0x02
                    0xc0
                    0x3d
                    0x33
                    0x02
                    0xc0
                    0x3d
                    0x34
                    0x02
                    0xc0
                    0x3d
                    0x35
                    0x02
                    0xc0
                    0x3d
                    0x36
                    0x02
                    0xc0
                    0x3d
                    0x37
                    0x02
                    0xc0
                    0x3d
                    0x38
                    0x02
                    0xc0
                    0x3d
                    0x39
                    0x02
                    0xc0
                    0x3d
                    0x3a
                    0x02
                    0xc0
                    0x3d
                    0x3b
                    0x02
                    0xc0
                    0x3d
                    0x3c
                    0x02
                    0xc0
                    0x3d
                    0x3d
                    0x02
                    0xc0
                    0x3d
                    0x3e
                    0x02
                    0xc0
                    0x3d
                    0x3f
                    0x02
                    0xc0
                    0x3d
                    0xa0
                    0x15
                    0x80
                    0xd2
                    0xc1
                    0x15
                    0x80
                    0xd2
                    0xe2
                    0x15
                    0x80
                    0xd2
                    0x03
                    0x16
                    0x80
                    0xd2
                    0x24
                    0x16
                    0x80
                    0xd2
                    0x45
                    0x16
                    0x80
                    0xd2
                    0x66
                    0x16
                    0x80
                    0xd2
                    0x87
                    0x16
                    0x80
                    0xd2
                    0xa8
                    0x16
                    0x80
                    0xd2
                    0xc9
                    0x16
                    0x80
                    0xd2
                    0xea
                    0x16
                    0x80
                    0xd2
                    0x0b
                    0x17
                    0x80
                    0xd2
                    0x2c
                    0x17
                    0x80
                    0xd2
                    0x4d
                    0x17
                    0x80
                    0xd2
                    0x6e
                    0x17
                    0x80
                    0xd2
                    0x8f
                    0x17
                    0x80
                    0xd2
                    0xc0
                    0x03
                    0x5f
                    0xd6))
  (defn probe :cc (cc/C) [(input (ptr u8))] (-> u64)
    (p/machine-code (X86_64)
                             0x0f 0x10 0x07 0x0f 0x10 0x0f 0x0f 0x10 0x17 0x0f 0x10 0x1f
                             0x0f 0x10 0x27 0x0f 0x10 0x2f 0x0f 0x10 0x37 0x0f 0x10 0x3f
                             0x44 0x0f 0x10 0x07 0x44 0x0f 0x10 0x0f 0x44 0x0f 0x10 0x17
                             0x44 0x0f 0x10 0x1f 0x44 0x0f 0x10 0x27 0x44 0x0f 0x10 0x2f
                             0x44 0x0f 0x10 0x37 0x44 0x0f 0x10 0x3f 0xb8 0xad 0x00 0x00
                             0x00 0xb9 0xae 0x00 0x00 0x00 0xba 0xaf 0x00 0x00 0x00 0xbe
                             0xb0 0x00 0x00 0x00 0xbf 0xb1 0x00 0x00 0x00 0x41 0xb8 0xb2
                             0x00 0x00 0x00 0x41 0xb9 0xb3 0x00 0x00 0x00 0x41 0xba 0xb4
                             0x00 0x00 0x00 0x41 0xbb 0xb5 0x00 0x00 0x00)))

(defn input-byte [(index i64) (seed u64)] (-> u8)
  (let [word
          (match (% (/ index 8) 7)
            (0 (: 0 u64))
            (1 0x8000000000000000)
            (2 0x7FF0000000000000)
            (3 0x7FF8123456789ABC)
            (4 0xFFFFFFFFFFFFFFFF)
            (5 0x7FC123457F800000)
            (_ 0x0123456789ABCDEF))]
    (cast u8 (>> (^ word seed) (cast u64 (* (% index 8) 8))))))

(defn exercise [(width i32) (pressure? bool) (literal? bool) (address (ptr u8))]
  (-> i64)
  (let [allocator (malloc-allocator)
        f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] u64) address)
        target
          (p/cast u64
                  (p/cast (ptr u8)
                          (: (fnptr-of probe) (fnptr (cc/C) [(ptr u8)] u64))))
        (mut input) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) (: 0 i64)]
    (for seed [(: 0 u64) 17 255]
      (clear! (mut input))
      (set! i 0)
      (while (< i 2048)
        (push! (mut input) (input-byte i seed))
        (set! i (+ i 1)))
      (for count [(: 0 u64) 1 2 3 7]
        (when (or pressure? (= count 0))
          (clear! (mut output))
          (set! i 0)
          (while (< i 2064) (push! (mut output) 165) (set! i (+ i 1)))
          (let [got
                  (call-ptr f
                            (p/cast u64 (p/index (.data output) 3))
                            (p/cast u64 (.data input))
                            count
                            target)
                expected (if pressure? (: 638 u64) (: 0 u64))]
            (when (!= got expected)
              (println "vector local width{} pressure{} literal{} seed{} count{} return{} expected{}"
                       width
                       pressure?
                       literal?
                       seed
                       count
                       got
                       expected)
              (set! failures (+ failures 1))))
          (set! i 0)
          (while (< i 2048)
            (when (!= (get input i) (input-byte i seed))
              (set! failures (+ failures 1)))
            (set! i (+ i 1)))
          (set! i 0)
          (while (< i 2064)
            (let [pos (- i 3)
                  expected
                    (if pressure?
                        (if (and (>= pos 0) (< pos (* 40 (cast i64 width))))
                            (input-byte (+ (* (if (= (% count 2) 0)
                                                  (/ pos (cast i64 width))
                                                  (^ (/ pos (cast i64 width)) 1))
                                              (cast i64 width))
                                           (% pos (cast i64 width)))
                                        seed)
                            (if (and (>= pos 1024) (< pos 1344))
                                (input-byte pos seed)
                                (: 165 u8)))
                        (if (and (>= pos 0) (< pos (cast i64 width)))
                            (input-byte pos (if literal? (: 0 u64) seed))
                            (: 165 u8)))]
              (when (!= (get output i) expected)
                (println "vector local width{} pressure{} literal{} seed{} count{} byte{} got{} expected{}"
                         width
                         pressure?
                         literal?
                         seed
                         count
                         i
                         (get output i)
                         expected)
                (set! failures (+ failures 1))))
            (set! i (+ i 1))))))
    (free! (mut input))
    (free! (mut output))
    failures))

(import "stogir.graph" :as g)
(import "stogir.target" :as target)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.types" :as types)
(import "stogir.native.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn signature! [(graph (mut g/Graph))] (-> i64)
  (let [allocator (malloc-allocator)]
    (match (calls/create (target/arch-pick 9 8) 5 [(: 6 u8) 6 5 6] allocator)
      (Err [message] (println "{}" message) 1)
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (require (calls/function! (mut graph) prototype allocator))
            (calls/release! (mut prototype))
            0)))))

(defn address! [(graph (mut g/Graph)) (base i32) (offset i32)] (-> i32)
  (require (b/emit! (mut graph)
                    26
                    6
                    [base
                     (require (b/scalar-constant! (mut graph)
                                                  5
                                                  (cast u64 offset)
                                                  8))])))

(defn fixture-id [(pressure? bool)
                  (ty i32)
                  (mode i32)
                  (literal? bool)
                  (storage i32)
                  (alignment i32)] (-> i32)
  (cond (and (= pressure? false)
             (= ty 21)
             (= mode 0)
             (= literal? false)
             (= storage 21)
             (= alignment 0))
          0
        (and (= pressure? false)
             (= ty 21)
             (= mode 2)
             (= literal? false)
             (= storage 21)
             (= alignment 0))
          1
        (and (= pressure? false)
             (= ty 21)
             (= mode 3)
             (= literal? true)
             (= storage 21)
             (= alignment 0))
          2
        (and (= pressure? false)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 37)
             (= alignment 0))
          3
        (and (= pressure? false)
             (= ty 37)
             (= mode 2)
             (= literal? false)
             (= storage 37)
             (= alignment 0))
          4
        (and (= pressure? false)
             (= ty 37)
             (= mode 3)
             (= literal? true)
             (= storage 37)
             (= alignment 0))
          5
        (and (= pressure? false)
             (= ty 45)
             (= mode 0)
             (= literal? false)
             (= storage 45)
             (= alignment 0))
          6
        (and (= pressure? false)
             (= ty 45)
             (= mode 2)
             (= literal? false)
             (= storage 45)
             (= alignment 0))
          7
        (and (= pressure? false)
             (= ty 45)
             (= mode 3)
             (= literal? true)
             (= storage 45)
             (= alignment 0))
          8
        (and (= pressure? false)
             (= ty 61)
             (= mode 0)
             (= literal? false)
             (= storage 61)
             (= alignment 0))
          9
        (and (= pressure? false)
             (= ty 61)
             (= mode 2)
             (= literal? false)
             (= storage 61)
             (= alignment 0))
          10
        (and (= pressure? false)
             (= ty 61)
             (= mode 3)
             (= literal? true)
             (= storage 61)
             (= alignment 0))
          11
        (and (= pressure? false)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 53)
             (= alignment 0))
          12
        (and (= pressure? false)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 69)
             (= alignment 0))
          13
        (and (= pressure? false)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 85)
             (= alignment 0))
          14
        (and (= pressure? false)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 101)
             (= alignment 0))
          15
        (and (= pressure? false)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 117)
             (= alignment 0))
          16
        (and (= pressure? true)
             (= ty 21)
             (= mode 0)
             (= literal? false)
             (= storage 21)
             (= alignment 16))
          17
        (and (= pressure? true)
             (= ty 21)
             (= mode 0)
             (= literal? false)
             (= storage 21)
             (= alignment 4096))
          18
        (and (= pressure? true)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 37)
             (= alignment 16))
          19
        (and (= pressure? true)
             (= ty 37)
             (= mode 0)
             (= literal? false)
             (= storage 37)
             (= alignment 4096))
          20
        (and (= pressure? true)
             (= ty 45)
             (= mode 0)
             (= literal? false)
             (= storage 45)
             (= alignment 16))
          21
        (and (= pressure? true)
             (= ty 45)
             (= mode 0)
             (= literal? false)
             (= storage 45)
             (= alignment 4096))
          22
        (and (= pressure? true)
             (= ty 61)
             (= mode 0)
             (= literal? false)
             (= storage 61)
             (= alignment 16))
          23
        (and (= pressure? true)
             (= ty 61)
             (= mode 0)
             (= literal? false)
             (= storage 61)
             (= alignment 4096))
          24
        (and (= pressure? false)
             (= ty 45)
             (= mode 2)
             (= literal? false)
             (= storage 37)
             (= alignment 0))
          25
        (and (= pressure? false)
             (= ty 61)
             (= mode 2)
             (= literal? false)
             (= storage 37)
             (= alignment 0))
          26
        :else (: -1 i32)))

(defn fixture-name [(id i32)] (-> (slice u8))
  (match id
    (0 (target/os-pick "_stogir_vector_local_0" "stogir_vector_local_0"))
    (1 (target/os-pick "_stogir_vector_local_1" "stogir_vector_local_1"))
    (2 (target/os-pick "_stogir_vector_local_2" "stogir_vector_local_2"))
    (3 (target/os-pick "_stogir_vector_local_3" "stogir_vector_local_3"))
    (4 (target/os-pick "_stogir_vector_local_4" "stogir_vector_local_4"))
    (5 (target/os-pick "_stogir_vector_local_5" "stogir_vector_local_5"))
    (6 (target/os-pick "_stogir_vector_local_6" "stogir_vector_local_6"))
    (7 (target/os-pick "_stogir_vector_local_7" "stogir_vector_local_7"))
    (8 (target/os-pick "_stogir_vector_local_8" "stogir_vector_local_8"))
    (9 (target/os-pick "_stogir_vector_local_9" "stogir_vector_local_9"))
    (10 (target/os-pick "_stogir_vector_local_10" "stogir_vector_local_10"))
    (11 (target/os-pick "_stogir_vector_local_11" "stogir_vector_local_11"))
    (12 (target/os-pick "_stogir_vector_local_12" "stogir_vector_local_12"))
    (13 (target/os-pick "_stogir_vector_local_13" "stogir_vector_local_13"))
    (14 (target/os-pick "_stogir_vector_local_14" "stogir_vector_local_14"))
    (15 (target/os-pick "_stogir_vector_local_15" "stogir_vector_local_15"))
    (16 (target/os-pick "_stogir_vector_local_16" "stogir_vector_local_16"))
    (17 (target/os-pick "_stogir_vector_local_17" "stogir_vector_local_17"))
    (18 (target/os-pick "_stogir_vector_local_18" "stogir_vector_local_18"))
    (19 (target/os-pick "_stogir_vector_local_19" "stogir_vector_local_19"))
    (20 (target/os-pick "_stogir_vector_local_20" "stogir_vector_local_20"))
