    (0 "/tmp/coil-stogir-vector-local-0.o")
    (1 "/tmp/coil-stogir-vector-local-1.o")
    (2 "/tmp/coil-stogir-vector-local-2.o")
    (3 "/tmp/coil-stogir-vector-local-3.o")
    (4 "/tmp/coil-stogir-vector-local-4.o")
    (5 "/tmp/coil-stogir-vector-local-5.o")
    (6 "/tmp/coil-stogir-vector-local-6.o")
    (7 "/tmp/coil-stogir-vector-local-7.o")
    (8 "/tmp/coil-stogir-vector-local-8.o")
