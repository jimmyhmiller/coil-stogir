(module stogir.tests.jit-argument-value)
(import "stogir.graph" :as g)
(import "stogir.target" :as target)
(import "stogir.builder" :as b)
(import "stogir.bulk" :as bulk)
(import "stogir.calls" :as calls)
(import "stogir.native.compile" :as compile)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [message] (println "{}" message) 0)))

(defn pattern [(i i64)] (-> u8)
  (cast u8 (% (+ (* i 37) 19) 251)))

;;; Pointer arguments model ARGVAL's lowered indirect interface. Each occurrence
;;; must receive an independent copy, including the two pointers passed on stack.
(defn inspect :cc (cc/C) [(a u64)
                          (b u64)
                          (c u64)
                          (d u64)
                          (e u64)
                          (f u64)
                          (g u64)
                          (h u64)
                          (j u64)
                          (k u64)
                          (original u64)
                          (size u64)
                          (alignment u64)] (-> u64)
  (let [(mut ordinal) (: 0 u64)
        (mut errors) (: 0 u64)]
    (for address [a b c d e f g h j k]
      (when (or (= address original) (!= (& address (- alignment 1)) 0))
        (set! errors 1000001))
      (let [(mut other) (: 0 u64)]
        (for previous [a b c d e f g h j k]
          (when (and (< other ordinal) (= previous address))
            (set! errors 1000002))
          (set! other (+ other 1))))
      (let [p (primitive/cast (ptr u8) address)
            (mut i) (: 0 i64)]
        (while (< i (cast i64 size))
          (when (!= (primitive/load (primitive/index p i)) (pattern i))
            (set! errors 1000003))
          (primitive/store! (primitive/index p i) (: 255 u8))
          (set! i (+ i 1))))
      (set! ordinal (+ ordinal 1)))
    (let [p (primitive/cast (ptr u8) original)
          (mut i) (: 0 i64)]
      (while (< i (cast i64 size))
        (when (!= (primitive/load (primitive/index p i)) (pattern i))
          (set! errors 1000004))
        (set! i (+ i 1))))
    (if (= errors 0) 7 errors)))

;;; System V passes an ARGVAL as the aggregate's bytes in the stack arguments
;;; (upstream `pass_struct_by_val`), not as a pointer to a private copy. With
;;; ten aggregates of 17 to 24 bytes, the copies are thirty consecutive stack
;;; words, three per aggregate, and the three trailing integers (the original's
;;; address, the size and the alignment) take rdi, rsi and rdx. This callback
;;; receives exactly that image through the C ABI: six integer register
;;; parameters, then the thirty stack words. Every copy must hold the pattern
;;; and the original must be untouched. (A by-value struct parameter would say
;;; the same thing, but the Linux Coil compiler does not yet receive MEMORY
;;; class aggregates correctly in a C-convention function.)
(defn inspect-words :cc (cc/C) [(original u64) (size u64) (alignment u64)
                                (r3 u64) (r4 u64) (r5 u64)
                                (w0 u64) (w1 u64) (w2 u64) (w3 u64) (w4 u64) (w5 u64) (w6 u64) (w7 u64) (w8 u64) (w9 u64) (w10 u64) (w11 u64) (w12 u64) (w13 u64) (w14 u64) (w15 u64) (w16 u64) (w17 u64) (w18 u64) (w19 u64) (w20 u64) (w21 u64) (w22 u64) (w23 u64) (w24 u64) (w25 u64) (w26 u64) (w27 u64) (w28 u64) (w29 u64)] (-> u64)
  (let [words [w0 w1 w2 w3 w4 w5 w6 w7 w8 w9 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29]
        (mut errors) (: 0 u64)]
    (for [copy 0 10]
      (for [i 0 (cast i64 size)]
        (let [word (get words (+ (* copy 3) (/ i 8)))
              byte (cast u8 (& (>> word (cast u64 (* 8 (% i 8)))) 255))]
          (when (!= byte (pattern i)) (set! errors (+ errors 1))))))
    (let [p (primitive/cast (ptr u8) original)]
      (for [i 0 (cast i64 size)]
        (when (!= (primitive/load (primitive/index p i)) (pattern i))
          (set! errors (+ errors 1)))))
    (when (or (< size 17) (> size 24)) (set! errors (+ errors 1)))
    (if (= errors 0) 7 (+ 1000000 errors))))

(defn check [(size i32)
             (alignment i32)
             (dynamic? bool)
             (ty i32)
             (variadic? bool)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        numbers (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        guard (require (b/variable! (mut graph) 5 start "argval-guard" 8))
        sentinel (require (b/scalar-constant! (mut graph) 5 321 8))
        count (require (b/scalar-constant! (mut graph) 5 (cast u64 size) 8))
        align-value
          (require (b/scalar-constant! (mut graph)
                                       5
                                       (cast u64
                                             (if (< alignment 8) 8 alignment))
                                       8))
        (mut control)
          (require (b/emit! (mut graph) 87 0 [start guard sentinel]))
        (mut source) input
        (mut values) (ArrayList::new [i32] allocator)
        (mut integers) (ArrayList::new [u64] allocator)
        (mut floats) (ArrayList::new [f64] allocator)
        (mut bytes) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i64)
        (mut failures) 0]
    (when dynamic?
      (let [allocation
              (require (b/stack-allocate! (mut graph) control count alignment))]
        (set! source allocation)
        (set! control
              (require (bulk/copy-bytes! (mut graph)
                                         allocation
                                         source
                                         input
                                         (cast i64 size))))))
    (let [value (require (b/argument-value! (mut graph) source size alignment))]
      ; The copy must see writes made after ARGVAL construction.
      (when (> size 0)
        (let [byte (require (b/scalar-constant! (mut graph) 2 19 8))]
          (set! control
                (require (b/emit! (mut graph) 93 0 [control source byte])))))
      (while (< i 40)
        (let [offset
                (require (b/scalar-constant! (mut graph) 5 (cast u64 (* i 8)) 8))
              address (require (b/emit! (mut graph) 26 6 [numbers offset]))
              loaded (require (b/emit! (mut graph) 91 ty [control address]))]
          (push! (mut values) loaded)
          (push! (mut integers) (cast u64 (+ i 11)))
          (push! (mut floats) (cast f64 (+ i 11)))
          (set! control loaded))
        (set! i (+ i 1)))
      (match (if variadic?
                 (calls/create (target/arch-pick 25 24) 5 [(: 6 u8) 6 6 6 6 6 6 6] allocator)
                 (calls/create (target/arch-pick 9 8) 5 [(: 6 u8) 6 6 6 6 6 6 6 6 6 6 5 5] allocator))
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [prototype]
            (let [(mut prototype) prototype
                  first
                    (require (calls/emit! (mut graph)
                                          prototype
                                          control
                                          target
                                          [value value value value value value
                                           value value value value source count
                                           align-value]
                                          allocator))
                  second
                    (require (calls/emit! (mut graph)
                                          prototype
                                          first
                                          target
                                          [value value value value value value
                                           value value value value source count
                                           align-value]
                                          allocator))
                  saved (require (b/emit! (mut graph) 85 5 [second guard]))
                  calls-sum (require (b/emit! (mut graph) 26 5 [first second]))
                  initial (require (b/emit! (mut graph) 26 5 [calls-sum saved]))
                  (mut sum)
                    (if (= ty 5)
                        initial
                        (require (b/conversion! (mut graph) 37 ty 8 initial)))]
              (for value values
                (set! sum (require (b/emit! (mut graph) 26 ty [sum value]))))
              (let [ret
                      (require (b/emit! (mut graph)
                                        120
                                        ty
                                        [saved sum (: 0 i32)]))]
                (when (and (= size 65) (= alignment 4096) dynamic?)
                  (let [name
                          (if variadic?
                              (if (= ty 5)
                                  (target/os-pick "_stogir_argval_var_gp" "stogir_argval_var_gp")
                                  (target/os-pick "_stogir_argval_var_fp" "stogir_argval_var_fp"))
                              (if (= ty 5)
                                  (target/os-pick "_stogir_argval_gp" "stogir_argval_gp")
                                  (target/os-pick "_stogir_argval_fp" "stogir_argval_fp")))
                        path
                          (if variadic?
                              (if (= ty 5)
                                  "/tmp/coil-stogir-argval-var-gp.o"
                                  "/tmp/coil-stogir-argval-var-fp.o")
                              (if (= ty 5)
                                  "/tmp/coil-stogir-argval-gp.o"
                                  "/tmp/coil-stogir-argval-fp.o"))]
                    (match (compile/object graph start [ret] name allocator)
                      (Err [message]
                           (println "{}" message)
                           (set! failures (+ failures 1)))
                      (Ok [object]
                          (let [(mut bytes) object]
                            (match (fs/write-file allocator path (slice bytes))
                              (Err [_] (set! failures (+ failures 1)))
                              (Ok [_] 0))
                            (free! (mut bytes)))))))
                (match (compile/text graph start [ret] allocator)
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [text]
                      (let [(mut text) text]
                        (match (jit/map-text (slice text))
                          (Err [message]
                               (println "{}" message)
                               (set! failures (+ failures 1)))
                          (Ok [image]
                              (let [(mut image) image
                                    f
                                      (primitive/cast (fnptr (cc/C)
                                                             [u64 u64 u64]
                                                             u64)
                                                      (.base image))
                                    fp
                                      (primitive/cast (fnptr (cc/C)
                                                             [u64 u64 u64]
                                                             f64)
                                                      (.base image))
                                    target
                                      (target/arch-pick
                                        (primitive/cast u64
                                                        (primitive/cast (ptr u8)
                                                                        (fnptr-of inspect)))
                                        (primitive/cast u64
                                                        (primitive/cast (ptr u8)
                                                                        (fnptr-of inspect-words))))]
                                (set! i 0)
                                (while (< i (+ (cast i64 size) 16))
                                  (push! (mut bytes)
                                         (if (= i 3) 0 (pattern (- i 3))))
                                  (set! i (+ i 1)))
                                (let [input
                                        (if (= size 0)
                                            (: 0 u64)
                                            (primitive/cast u64
                                                            (primitive/index (.data bytes)
                                                                             3)))
                                      data
                                        (if (= ty 5)
                                            (primitive/cast u64
                                                            (.data integers))
                                            (primitive/cast u64 (.data floats)))
                                      answer
                                        (if (= ty 5)
                                            (cast f64
                                                  (call-ptr f target input data))
                                            (call-ptr fp target input data))]
                                  (when (!= answer 1555.0)
                                    (println "ARGVAL size {} align {} dynamic {} ty {} result {}"
                                             size
                                             alignment
                                             dynamic?
                                             ty
                                             answer)
                                    (set! failures (+ failures 1))))
                                (set! i 0)
                                (while (< i (len bytes))
                                  (let [expected
                                          (if (and (= i 3)
                                                   (or dynamic? (= size 0)))
                                              0
                                              (pattern (- i 3)))]
                                    (when (!= (get bytes i) expected)
                                      (set! failures (+ failures 1))))
                                  (set! i (+ i 1)))
                                (jit/release! (mut image)))))
                        (free! (mut text)))))
                (calls/release! (mut prototype)))))))
    (free! (mut values))
    (free! (mut integers))
    (free! (mut floats))
    (free! (mut bytes))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    ; x86-64: sizes whose copies are three stack words each, which is what
    ; inspect-words receives, at the 8-byte stack alignment of a C aggregate
    ; of bytes (the pointer form above has no such limits).
    (for size (target/arch-pick
                [(: 0 i32) 1 2 3 7 8 9 15 16 17 21 31 32 33 63 64 65 127 129 4097 65537]
                [(: 17 i32) 21 24])
      (for alignment (target/arch-pick [(: 0 i32) 16 64 4096] [(: 0 i32)])
        (for dynamic? [false true]
          (for ty [(: 5 i32) 12]
            (for variadic? [false true]
              (set! failures
                    (+ failures (check size alignment dynamic? ty variadic?))))))))
    (println "native ARGVAL copies, repeated fixed/variadic calls, GP/FP pressure and frames: {} failures"
             failures)
    (if (= failures 0) 0 1)))
