(module stogir.tests.fold-builder)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err Some None])

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        (mut failures) 0]
    (match (b/scalar-constant! (mut graph) 2 255 8)
      (Ok [a]
          (match (b/scalar-constant! (mut graph) 2 1 8)
            (Ok [one]
                (match (b/integer-binary! (mut graph) 26 2 8 a one)
                  (Ok [r]
                      (do
                        (when (>= r 0) (set! failures (+ failures 1)))
                        (when (!= (len (.instructions graph)) 1)
                          (set! failures (+ failures 1)))
                        (match (g/lookup graph r)
                          (Some [node]
                                (when (!= (n/constant-bits node) 0)
                                  (set! failures (+ failures 1))))
                          (None [] (set! failures (+ failures 1))))))
                  (Err [_] (set! failures (+ failures 1)))))
            (Err [_] (set! failures (+ failures 1)))))
      (Err [_] (set! failures (+ failures 1))))
    (g/release! (mut graph))
    (println "fold builder checks: {} failures" failures)
    (if (= failures 0) 0 1)))
