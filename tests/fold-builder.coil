(module stogir.tests.fold-builder)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [message] (do (println "{}" message) 0))))

(defn canonical-order [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        constant (require (b/scalar-constant! (mut graph) 11 7 8))
        (mut failures) 0]
    (for op [(: 26 i32) 28 46 47 48 58 59]
      (let [a (require (b/integer-binary! (mut graph) op 11 8 constant p))
            other (require (b/integer-binary! (mut graph) op 11 8 p constant))
            v (require (b/integer-binary! (mut graph) op 11 8 p q))]
        (when (!= a other) (set! failures (+ failures 1)))
        (match (g/lookup graph a)
          (Some [x]
                (when (or (!= (.op1 x) p) (!= (.op2 x) constant))
                  (set! failures (+ failures 1))))
          (None [] (set! failures (+ failures 1))))
        (match (g/lookup graph v)
          (Some [x]
                (when (or (!= (.op1 x) q) (!= (.op2 x) p))
                  (set! failures (+ failures 1))))
          (None [] (set! failures (+ failures 1))))))
    (for op [(: 41 i32) 43]
      (let [v (require (b/checked! (mut graph) op 11 8 constant p))]
        (match (g/lookup graph v)
          (Some [x]
                (when (or (!= (.op1 x) p) (!= (.op2 x) constant))
                  (set! failures (+ failures 1))))
          (None [] (set! failures (+ failures 1))))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        (mut failures) (canonical-order)]
    (match (b/scalar-constant! (mut graph) 2 255 8)
      (Ok [a]
          (match (b/scalar-constant! (mut graph) 2 1 8)
            (Ok [one]
                (match (b/integer-binary! (mut graph) 26 2 8 a one)
                  (Ok [r]
                      (do
                        (when (>= r 0) (set! failures (+ failures 1)))
                        (when (!= (len (.instructions graph)) 1)
                          (set! failures (+ failures 1)))
                        (match (g/lookup graph r)
                          (Some [node]
                                (when (!= (n/constant-bits node) 0)
                                  (set! failures (+ failures 1))))
                          (None [] (set! failures (+ failures 1))))))
                  (Err [_] (set! failures (+ failures 1)))))
            (Err [_] (set! failures (+ failures 1)))))
      (Err [_] (set! failures (+ failures 1))))
    (g/release! (mut graph))
    (println "fold builder checks: {} failures" failures)
    (if (= failures 0) 0 1)))
