(module stogir.tests.vector-arithmetic)
(import "stogir.a64.vector-arithmetic" :as native)
(import "stogir.vector-arithmetic" :as va)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as verify)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Encoding
  [(opcode i32) (ty i32) (rd i32) (rn i32) (rm i32) (word u32)])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn contracts [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        a (require (b/emit! (mut graph) 71 37 [start (: 0 i32) 0]))
        b (require (b/emit! (mut graph) 71 21 [start (: 0 i32) 1]))
        fp (require (b/emit! (mut graph) 71 61 [start (: 0 i32) 2]))
        scalar (require (b/scalar-constant! (mut graph) 5 0 8))
        variable (require (b/variable! (mut graph) 37 start "storage" 0))
        good (require (b/vector-binary! (mut graph) 26 37 a a 0))
        div (require (b/vector-binary! (mut graph) 29 61 fp fp start))
        (mut failures) 0
        before (len (.instructions graph))]
    (for rejected [(b/vector-binary! (mut graph) 26 37 a b 0)
                   (b/vector-binary! (mut graph) 26 37 scalar a 0)
                   (b/vector-binary! (mut graph) 26 37 variable a 0)
                   (b/vector-binary! (mut graph) 26 37 a a start)
                   (b/vector-binary! (mut graph) 30 61 fp fp 0)
                   (b/vector-binary! (mut graph) 30 37 a a scalar)
                   (b/vector-binary! (mut graph) 47 61 fp fp 0)
                   (b/vector-binary! (mut graph) 29 61 fp fp scalar)
                   (b/vector-binary! (mut graph) 26 37 a 999 0)]
      (match rejected (Err [_] 0) (Ok [_] (set! failures (+ failures 1)))))
    (when (!= (len (.instructions graph)) before)
      (set! failures (+ failures 1)))
    (for reference [good div]
      (match (va/validate graph reference)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [_] 0)))
    (match (verify/integer-operations graph)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [_] 0))
    (let [bad (require (b/emit! (mut graph) 26 37 [a b]))]
      (match (verify/integer-operations graph)
        (Err [_] 0)
        (Ok [_] (set! failures (+ failures 1)))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) (+ (contracts) (expanded-contracts))
        cases
          [(Encoding
