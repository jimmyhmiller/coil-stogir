           (Encoding
             :opcode 28
             :ty 52
             :rd 0
             :rn 1
             :rm 1
             :word 0x4EA19C20)]]
    ; Independent LLVM MC words include all D/Q arrangements and register aliases.
    (for entry cases
      (match (native/instruction (.opcode entry)
                                 (.ty entry)
                                 (.rd entry)
                                 (.rn entry)
                                 (.rm entry))
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [word]
            (when (!= word (.word entry))
              (println "vector encoding ty{} op{} got{} expected{}"
                       (.ty entry)
                       (.opcode entry)
                       word
                       (.word entry))
              (set! failures (+ failures 1))))))
    (for rejected [(native/instruction 26 53 0 1 2)
                   (native/instruction 26 37 -1 1 2)
                   (native/instruction 26 37 0 32 2)
                   (native/instruction 26 37 0 1 32)
                   (native/instruction 28 37 0 1 2)
                   (native/instruction 47 61 0 1 2)
                   (native/instruction 26 81 0 1 2)
                   (native/instruction 26 5 0 1 2)]
      (match rejected (Err [_] 0) (Ok [_] (set! failures (+ failures 1)))))
    (println "vector binary contracts and {} independent instruction words: {} failures"
             (len cases)
             failures)
    (if (= failures 0) 0 1)))

(import "coil.arraylist" :use [ArrayList])
(import "stogir.bytes" :as bytes)

(defn check-sequence [(opcode i32)
                      (ty i32)
                      (rd i32)
                      (rn i32)
                      (rm i32)
                      (expected (slice u32))] (-> i64)
  (let [allocator (malloc-allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) (: 0 i64)]
    (bytes/append32! (mut output) 0xDEADBEEF)
    (match (native/integer-sequence! (mut output) opcode ty rd rn rm)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [count]
          (when (!= (cast i64 count) (* (len expected) 4))
            (set! failures (+ failures 1)))))
    (when (!= (len output) (+ 4 (* 4 (len expected))))
      (set! failures (+ failures 1)))
    (while (< i (len output))
      (let [wanted (if (< i 4) (: 0xDEADBEEF u32) (get expected (- (/ i 4) 1)))
            byte (cast u8 (>> wanted (cast u32 (* (% i 4) 8))))]
        (when (!= (get output i) byte)
          (println "integer vector sequence ty{} op{} rd{} rn{} rm{} byte{}"
                   ty
                   opcode
                   rd
                   rn
                   rm
                   i)
          (set! failures (+ failures 1))))
      (set! i (+ i 1)))
    (free! (mut output))
    failures))

