(module stogir.tests.a64-emit)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.a64.select" :as s)
(import "stogir.a64.emit" :as e)
(import "stogir.a64.constraints" :as constraints)
(import "stogir.schedule" :as schedule)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        (mut output) (ArrayList::new [u8] a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        param (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        constant (require (b/scalar-constant! (mut graph) 11 42 8))
        add (require (b/emit! (mut graph) 26 11 [param constant]))
        (mut failures) 0]
    (match (s/arithmetic graph add)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [tile]
          (do
            (match (e/arithmetic! (mut output) tile 0 0 0)
              (Err [_] (set! failures (+ failures 1)))
              (Ok [size] (when (!= size 4) (set! failures (+ failures 1)))))
            (match (e/arithmetic! (mut output) tile 31 0 0)
              (Ok [_] (set! failures (+ failures 1)))
              (Err [_] 0)))))
    (when (!= (len output) 4) (set! failures (+ failures 1)))
    (when (= (len output) 4)
      (when (!= (get output 0) 0) (set! failures (+ failures 1)))
      (when (!= (get output 1) 0xA8) (set! failures (+ failures 1)))
      (when (!= (get output 2) 0) (set! failures (+ failures 1)))
      (when (!= (get output 3) 0x91) (set! failures (+ failures 1))))
    (let [ret (require (b/emit! (mut graph) 120 11 [start add (: 0 i32)]))
          (mut scheduled)
            (schedule/Schedule
              :ranges (ArrayList::new [schedule/Range] a)
              :nodes (ArrayList::new [i32] a))]
      (for node [start param add ret] (push! (mut (.nodes scheduled)) node))
      (match (constraints/build graph scheduled a)
        (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
        (Ok [values]
            (let [(mut owned) values
                  parameter (at owned (cast i64 param))
                  result (at owned (cast i64 add))]
              (when (!= (.register (get (.uses parameter) 0)) 0)
                (set! failures (+ failures 1)))
              (when (!= (.kind (get (.uses parameter) 0)) 2)
                (set! failures (+ failures 1)))
              ; Returns accept register or spill locations; ABI capture occurs
              ; at emission. Parameter definitions retain their hard ABI register.
              (when (!= (.register (get (.uses result) 1)) -1)
                (set! failures (+ failures 1)))
              (when (!= (.kind (get (.uses result) 1)) 0)
                (set! failures (+ failures 1)))
              (constraints/release! (mut owned)))))
      (schedule/release! (mut scheduled)))
    (for raw [(: 8192 u64) 0x100000000]
      (let [tile
              (s/Tile
                :rule 42
                :wide true
                :left param
                :right 0
                :immediate raw)]
        (match (e/arithmetic! (mut output) tile 0 0 0)
          (Ok [_] (set! failures (+ failures 1)))
          (Err [_] 0))))
    (for rule [(: 44 i32) 45 46 47]
      (for wide [false true]
        (for exponent [(if wide (: 64 u64) (: 32 u64)) 0x100000000]
          (let [tile
                  (s/Tile
                    :rule rule
                    :wide wide
                    :left param
                    :right 0
                    :immediate exponent)]
            (match (e/arithmetic! (mut output) tile 0 0 0)
              (Ok [_] (set! failures (+ failures 1)))
              (Err [_] 0))))))
    (when (!= (len output) 4) (set! failures (+ failures 1)))
    (free! (mut output))
    (g/release! (mut graph))
    (println "AArch64 emission checks: {} failures" failures)
    (if (= failures 0) 0 1)))
