(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row LINKED-CASES
      (set! failures
            (+ failures (linked (.ty row) (.cty row) (.mode row) (.name row)))))
    (for row LINKED-PRESSURE-CASES
      (set! failures
            (+ failures (linked-pressure (.ty row) (.cty row) (.name row)))))
    (for row LINKED-CASES-2
      (set! failures
            (+ failures (linked (.ty row) (.cty row) (.mode row) (.name row)))))
    (println "linked vector selection: 988 objects; failures {}" failures)
    failures))
