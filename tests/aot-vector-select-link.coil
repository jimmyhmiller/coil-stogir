(module stogir.tests.aot-vector-select-link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "stogir.types" :as types)

(defn pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [i (% (+ lane seed (if right? (: 3 i64) 0)) 11)
        fp? (types/floating? base)
        wide? (= base 12)]
    (if fp?
        (if wide?
            (match i
              (0 (: 0 u64))
              (1 0x8000000000000000)
              (2 0x3FF0000000000000)
              (3 0xBFF0000000000000)
              (4 1)
              (5 0x000FFFFFFFFFFFFF)
              (6 0x7FEFFFFFFFFFFFFF)
              (7 0x7FF0000000000000)
              (8 0xFFF0000000000000)
              (9 0x7FF8123456789ABC)
              (_ 0x7FF0123456789ABC))
            (match i
              (0 (: 0 u64))
              (1 0x80000000)
              (2 0x3F800000)
              (3 0xBF800000)
              (4 1)
              (5 0x007FFFFF)
              (6 0x7F7FFFFF)
              (7 0x7F800000)
              (8 0xFF800000)
              (9 0x7FC12345)
              (_ 0x7F812345)))
        (match i
          (0 (: 0 u64))
          (1 1)
          (2 0xFFFFFFFFFFFFFFFF)
          (3 (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1))))
          (4 (- (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1)))
                1))
          (5 0x8080808080808080)
          (6 0x7F7F7F7F7F7F7F7F)
          (7 0xFFFF0000FFFF0000)
          (8 0x123456789ABCDEF0)
          (9 0xFFFFFFFFFFFFFFFE)
          (_ 0x0102030405060708)))))

(defn input-byte [(base i32) (index i64) (seed i64) (right? bool)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (pattern base (/ index width) seed right?)
              (cast u64 (* (% index width) 8))))))

(defn arm-literal? [(mode i32) (right? bool)] (-> bool)
  (or (= mode 10)
      (= mode 11)
      (= mode 3)
      (= mode 6)
      (= mode 7)
      (= mode (if right? 2 1))))

(defn arm-byte [(base i32) (i i64) (seed i64) (mode i32) (right? bool)] (-> u8)
  (let [right? (and right? (!= mode 4) (!= mode 9))
        chosen-seed (if (arm-literal? mode right?) (if right? (: 7 i64) 9) seed)]
    (input-byte base i chosen-seed right?)))

(defn condition-bits [(ty i32) (seed i64) (mode i32)] (-> u64)
  (if (or (= mode 6) (= mode 10))
      (if (= ty 12) (: 0x8000000000000000 u64) (if (= ty 13) 0x80000000 0))
      (if (or (= mode 7) (= mode 11))
          (if (= ty 12) (: 0x7FF0123456789ABC u64) (if (= ty 13) 0x7F812345 1))
          (& (pattern ty 0 seed false)
             (cast u64
                   (- (<< (: 1 u128) (cast u128 (* 8 (types/scalar-size ty 8))))
                      1))))))

(defn truth? [(ty i32) (bits u64)] (-> bool)
  (!= (if (= ty 12)
          (& bits 0x7FFFFFFFFFFFFFFF)
          (if (= ty 13) (& bits 0x7FFFFFFF) bits))
      0))

(defn exercise [(ty i32) (cty i32) (mode i32) (address (ptr u8))] (-> i64)
  (let [alc (malloc-allocator)
        width (types/size ty 8)
        base (types/base-type ty)
        f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] void) address)
        (mut yes) (ArrayList::new [u8] alc)
        (mut no) (ArrayList::new [u8] alc)
        (mut condition) (ArrayList::new [u8] alc)
        (mut output) (ArrayList::new [u8] alc)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (let [(mut test) (: 0 i64)]
        (while (< test 11)
          (clear! (mut yes))
          (clear! (mut no))
          (clear! (mut condition))
          (clear! (mut output))
          (let [bits (condition-bits cty test mode)
                selected? (truth? cty bits)
                (mut i) (: 0 i64)]
            (while (< i 32)
              (push! (mut yes) (input-byte base i seed false))
              (push! (mut no) (input-byte base i seed true))
              (set! i (+ i 1)))
            (set! i 0)
            (while (< i 16)
              (push! (mut condition)
                     (cast u8 (>> bits (cast u64 (* (% i 8) 8)))))
              (set! i (+ i 1)))
            (set! i 0)
            (while (< i 128) (push! (mut output) 165) (set! i (+ i 1)))
            (call-ptr f
                      (p/cast u64 (.data output))
                      (p/cast u64 (.data yes))
                      (p/cast u64 (.data no))
                      (p/cast u64 (.data condition)))
            (set! i 0)
            (while (< i 128)
              (let [wanted
                      (cond (< i (cast i64 width))
                              (arm-byte base i seed mode (not selected?))
                            (and (!= mode 5)
                                 (!= mode 8)
                                 (!= mode 9)
                                 (>= i 32)
                                 (< i (+ 32 (cast i64 width))))
                              (arm-byte base (- i 32) seed mode false)
                            (and (!= mode 5)
                                 (!= mode 8)
                                 (!= mode 9)
                                 (>= i 64)
                                 (< i (+ 64 (cast i64 width))))
                              (arm-byte base (- i 64) seed mode true)
                            (and (!= mode 5)
                                 (!= mode 8)
                                 (!= mode 9)
                                 (>= i 96)
                                 (< i
                                    (+ 96 (cast i64 (types/scalar-size cty 8)))))
                              (cast u8 (>> bits (cast u64 (* (- i 96) 8))))
                            :else (: 165 u8))]
                (when (!= (get output i) wanted)
                  (when (< failures 6)
                    (println "select ty{} cty{} mode{} seed{} test{} byte{} got{} expected{}"
                             ty
                             cty
                             mode
                             seed
                             test
                             i
                             (get output i)
                             wanted))
                  (set! failures (+ failures 1))))
              (set! i (+ i 1)))
            (set! i 0)
            (while (< i 32)
              (when (or (!= (get yes i) (input-byte base i seed false))
                        (!= (get no i) (input-byte base i seed true)))
                (set! failures (+ failures 1)))
              (set! i (+ i 1)))
            (set! i 0)
            (while (< i 16)
              (when (!= (get condition i)
                        (cast u8 (>> bits (cast u64 (* (% i 8) 8)))))
                (set! failures (+ failures 1)))
              (set! i (+ i 1))))
          (set! test (+ test 1))))
      (set! seed (+ seed 1)))
    (free! (mut yes))
    (free! (mut no))
    (free! (mut condition))
    (free! (mut output))
    failures))

