(defn read-word [(buffer (slice u8)) (offset i64) (width i32)] (-> u64)
  (let [(mut result) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (< i width)
      (set! result
            (| result
               (<< (cast u64 (get buffer (+ offset (cast i64 i))))
                   (cast u64 (* i 8)))))
      (set! i (+ i 1)))
    result))

(defn pressure-exercise [(ty i32) (cty i32) (address (ptr u8))] (-> i64)
  (let [alc (malloc-allocator)
        width (types/size ty 8)
        base (types/base-type ty)
        f (p/cast (fnptr (cc/C) [u64 u64 u64] u64) address)
        target
          (p/cast u64
                  (p/cast (ptr u8)
                          (: (fnptr-of probe) (fnptr (cc/C) [(ptr u8)] u64))))
        (mut input) (ArrayList::new [u8] alc)
        (mut snapshot) (ArrayList::new [u8] alc)
        (mut output) (ArrayList::new [u8] alc)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (clear! (mut input))
      (clear! (mut snapshot))
      (clear! (mut output))
      (let [(mut i) (: 0 i64)]
        (while (< i 4096) (push! (mut input) 165) (set! i (+ i 1)))
        (set! i 0)
        (while (< i 2304) (push! (mut output) 165) (set! i (+ i 1)))
        (set! i 0)
        (while (< i (* 40 (cast i64 width)))
          (set! (mut input) i (input-byte base i seed false))
          (set! (mut input) (+ 640 i) (input-byte base i seed true))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 40)
          (let [bits (condition-bits cty (+ i seed) 0)
                (mut byte) (: 0 i64)]
            (while (< byte 8)
              (set! (mut input)
                    (+ 1536 (* i 8) byte)
                    (cast u8 (>> bits (cast u64 (* byte 8)))))
              (set! byte (+ byte 1))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 4096) (push! (mut snapshot) (get input i)) (set! i (+ i 1)))
        (when (!= (call-ptr f
                            (p/cast u64 (.data output))
                            (p/cast u64 (.data input))
                            target)
                  811)
          (println "select pressure guard ty{} cty{}" ty cty)
          (set! failures (+ failures 1)))
        (set! i 0)
        (while (< i 2304)
          (let [slot (/ i 16)
                byte (% i 16)
                yes-slot (/ (- i 640) 16)
                yes-byte (% (- i 640) 16)
                no-slot (/ (- i 1280) 16)
                no-byte (% (- i 1280) 16)
                condition-slot (/ (- i 1920) 8)
                condition-byte (% (- i 1920) 8)
                selected? (truth? cty (condition-bits cty (+ slot seed) 0))
                wanted
                  (cond (and (< i 640) (< byte (cast i64 width)))
                          (get snapshot
                               (+ (if selected? (: 0 i64) 640)
                                  (* slot (cast i64 width))
                                  byte))
                        (and (>= i 640)
                             (< i 1280)
                             (< yes-byte (cast i64 width)))
                          (get snapshot
                               (+ (* yes-slot (cast i64 width)) yes-byte))
                        (and (>= i 1280)
                             (< i 1920)
                             (< no-byte (cast i64 width)))
                          (get snapshot
                               (+ 640 (* no-slot (cast i64 width)) no-byte))
                        (and (>= i 1920)
                             (< i 2240)
                             (< condition-byte
                                (cast i64 (types/scalar-size cty 8))))
                          (cast u8
                                (>> (condition-bits cty
                                                    (+ condition-slot seed)
                                                    0)
                                    (cast u64 (* condition-byte 8))))
                        :else (: 165 u8))]
            (when (!= (get output i) wanted)
              (when (< failures 6)
                (println "select pressure ty{} cty{} seed{} byte{} got{} expected{}"
                         ty
                         cty
                         seed
                         i
                         (get output i)
                         wanted))
              (set! failures (+ failures 1))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 4096)
          (when (!= (get input i) (get snapshot i))
            (set! failures (+ failures 1)))
          (set! i (+ i 1))))
      (set! seed (+ seed 1)))
    (free! (mut input))
    (free! (mut snapshot))
    (free! (mut output))
    failures))

(import "coil.os" :as os)

(defn linked [(ty i32) (cty i32) (mode i32) (name (ptr i8))] (-> i64)
  (let [address (os/dlsym (p/cast (ptr i8) (: -2 i64)) name)]
    (if (= (p/cast u64 address) 0)
        (do (println "missing linked vector select symbol") 1)
        (exercise ty cty mode (p/cast (ptr u8) address)))))

(defn linked-pressure [(ty i32) (cty i32) (name (ptr i8))] (-> i64)
  (let [address (os/dlsym (p/cast (ptr i8) (: -2 i64)) name)]
    (if (= (p/cast u64 address) 0)
        (do (println "missing select pressure symbol") 1)
        (pressure-exercise ty cty (p/cast (ptr u8) address)))))

