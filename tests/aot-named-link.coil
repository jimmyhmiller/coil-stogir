(module stogir.tests.aot-named-link)
(import "coil.cc" :as cc)

(extern entry :as "stogir_named" :cc (cc/C) [i64] (-> i64))

(defn main [] (-> i64)
  (let [(mut x) (: -100 i64)
        (mut failures) 0]
    (while (<= x 100)
      (when (!= (entry x) (+ (if (< x 0) (- 0 x) x) 266))
        (set! failures (+ failures 1)))
      (set! x (+ x 1)))
    (println "linked named IR checks: {} failures" failures)
    (if (= failures 0) 0 1)))
