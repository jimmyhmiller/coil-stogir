(module stogir.tests.aot-large-outgoing-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern outgoing :as "stogir_large_outgoing" :cc (cc/C) [u64] (-> u64))

(extern dynamic :as "stogir_large_outgoing_dynamic" :cc (cc/C) [u64] (-> u64))

;;; Eight named GP arguments, then Darwin stack-only variadic arguments.
(extern probe
        :as
        "stogir_large_probe"
        :cc
        (cc/C)
        [u64 u64 u64 u64 u64 u64 u64 u64 ...]
        (-> u64))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of probe)))
        (mut failures) 0]
    (when (!= (outgoing target) 0x123456789ABCDEF0)
      (set! failures (+ failures 1)))
    (when (!= (dynamic target) 0x123456789ABCE031)
      (set! failures (+ failures 1)))
    (println "linked large outgoing areas: {} failures" failures)
    (if (= failures 0) 0 1)))
