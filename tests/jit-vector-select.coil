(defn generate [(ty i32) (cty i32) (mode i32)] (-> i64)
  (let [alc (malloc-allocator)
        (mut graph) (g/create alc)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        yes-address (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        no-address (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        condition-address
          (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 3]))
        left (require (b/vector-load! (mut graph) ty 8 start yes-address true))
        right (require (b/vector-load! (mut graph) ty 8 left no-address true))
        loaded-condition
          (require (b/emit! (mut graph) 92 cty [right condition-address]))
        condition
          (if (or (= mode 6) (= mode 7) (= mode 10) (= mode 11))
              (require (b/scalar-constant! (mut graph)
                                           cty
                                           (condition-bits cty 0 mode)
                                           8))
              loaded-condition)
        (mut yes-bytes) (ArrayList::new [u8] alc)
        (mut no-bytes) (ArrayList::new [u8] alc)
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i (types/size ty 8))
      (push! (mut yes-bytes)
             (arm-byte (types/base-type ty) (cast i64 i) 0 mode false))
      (push! (mut no-bytes)
             (arm-byte (types/base-type ty) (cast i64 i) 0 mode true))
      (set! i (+ i 1)))
    (let [yes
            (if (arm-literal? mode false)
                (require (b/vector-constant! (mut graph) ty 8 (slice yes-bytes)))
                left)
          no
            (if (= mode 4)
                yes
                (if (arm-literal? mode true)
                    (require (b/vector-constant! (mut graph)
                                                 ty
                                                 8
                                                 (slice no-bytes)))
                    right))
          result
            (require (if (or (= mode 6) (= mode 7))
                         (b/emit! (mut graph) 60 ty [condition yes no])
                         (b/conditional! (mut graph) ty condition yes no)))
          (mut control)
            (require (b/vector-store! (mut graph)
                                      8
                                      loaded-condition
                                      output
                                      result
                                      true))]
      (when (and (or (= mode 10) (= mode 11)) (>= result 0))
        (println "constant vector COND was not folded")
        (set! failures (+ failures 1)))
      (when (!= mode 5)
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph) output 32)
                                        yes
                                        true)))
        (set! control
              (require (b/vector-store! (mut graph)
                                        8
                                        control
                                        (address! (mut graph) output 64)
                                        no
                                        true)))
        (set! control
              (require (b/emit! (mut graph)
                                94
                                0
                                [control
                                 (address! (mut graph) output 96)
                                 condition]))))
      (let [ret (require (b/emit! (mut graph) 120 0 [control (: 0 i32) 0]))
            id (fixture-id ty cty mode)]
        (when (>= id 0)
          (match (compile/object graph start [ret] (fixture-name id) alc)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [object]
                (let [(mut object) object]
                  (match (fs/write-file alc (fixture-path id) (slice object))
                    (Err [_] (set! failures (+ failures 1)))
                    (Ok [_] 0))
                  (free! (mut object))))))
        (match (compile/image graph start [ret] "_vector_select_jit" alc)
          (Err [message]
               (println "select ty{} cty{} mode{}: {}" ty cty mode message)
               (set! failures (+ failures 1)))
          (Ok [source]
              (let [(mut source) source]
                (match (jit/map-image source alc)
                  (Err [message]
                       (println "{}" message)
                       (set! failures (+ failures 1)))
                  (Ok [loaded]
                      (let [(mut loaded) loaded]
                        (set! failures
                              (+ failures
                                 (exercise ty cty mode (.base (.memory loaded)))))
                        (jit/release-image! (mut loaded)))))
                (image/release! (mut source)))))))
    (free! (mut yes-bytes))
    (free! (mut no-bytes))
    (g/release! (mut graph))
    failures))

(import "stogir.a64.vector-select" :as native)
(import "stogir.a64.encode" :as encode)
(import "stogir.bytes" :as bytes)

(defn word! [(out (mut (ArrayList u8)))
             (error (mut (slice u8)))
             (word (Result u32 (slice u8)))] (-> void)
  (match word
    (Err [message] (set! error message))
    (Ok [bits] (bytes/append32! (mut out) bits))))

(defn alias-check [(ty i32) (cty i32) (rd i32) (yes i32) (no i32)] (-> i64)
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))
        (mut error) ""
        (mut failures) 0
        width (types/size ty 8)]
    (if (types/floating? cty)
        (do
          (word! (mut text)
                 (mut error)
                 (encode/floating-load-store true
                                             (types/scalar-size cty 8)
                                             30
                                             3
                                             0))
          (word! (mut text)
                 (mut error)
                 (encode/floating-compare-zero (= cty 12) 30)))
        (do
          (word! (mut text) (mut error) (encode/load-store true 8 9 3 0))
          (word! (mut text) (mut error) (encode/add-sub true true true 31 9 31))))
    ; Loading the arms after truth flags also exercises reuse of private v30.
    (word! (mut text)
           (mut error)
           (encode/floating-load-store true width yes 1 0))
    (when (!= yes no)
      (word! (mut text)
             (mut error)
             (encode/floating-load-store true width no 2 0)))
    (match (native/emit-flags! (mut text) ty rd yes no)
      (Err [message] (set! error message))
      (Ok [_] 0))
    (word! (mut text)
           (mut error)
           (encode/floating-load-store false width rd 0 0))
    (bytes/append32! (mut text) 0xD65F03C0)
    (if (!= error "")
        (do (println "{}" error) (set! failures (+ failures 1)))
        (match (jit/map-text (slice text))
          (Err [message] (println "{}" message) (set! failures (+ failures 1)))
          (Ok [loaded]
              (let [(mut loaded) loaded]
                (set! failures
                      (+ failures
                         (exercise ty cty (if (= yes no) 9 8) (.base loaded))))
                (jit/release! (mut loaded))))))
    (free! (mut text))
    failures))

(defn forced-aliases [] (-> i64)
  (let [(mut failures) 0]
    (set! failures (+ failures (alias-check 65 5 0 1 2)))
    (set! failures (+ failures (alias-check 65 5 1 1 2)))
    (set! failures (+ failures (alias-check 65 5 2 1 2)))
    (set! failures (+ failures (alias-check 65 5 1 1 1)))
