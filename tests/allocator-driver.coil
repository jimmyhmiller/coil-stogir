(module stogir.tests.allocator-driver)
(import "stogir.allocation" :as a)
(import "stogir.allocation-check" :as verify)
(import "stogir.locations" :as locations)
(import "stogir.interval" :as r)
(import "stogir.constraints" :as c)
(import "stogir.frame" :as f)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn fixed-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut first) (a/create 1 allocator)
        (mut second) (a/create 2 allocator)
        (mut layout) (f/create allocator)
        (mut failures) 0]
    (r/add! (mut (.ranges first)) 0 20)
    (c/add! (mut (.uses first)) 0 2 0)
    (c/add! (mut (.uses first)) 19 2 1)
    (r/add! (mut (.ranges second)) 2 10)
    (c/add! (mut (.uses second)) 2 2 0)
    (c/add! (mut (.uses second)) 9 1 -1)
    (push! (mut parts) first)
    (push! (mut parts) second)
    (a/reserve! (mut parts) 1 12 13 allocator)
    (match (a/run! (mut parts) (mut layout) 2 3 8 8 allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (match (verify/verify parts 2 3)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    (f/release! (mut layout))
    failures))

(defn reservation-transfers [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)]
    (a/reserve! (mut parts) 0 1 2 allocator)
    (a/reserve! (mut parts) 1 2 3 allocator)
    (let [(mut transfers) (locations/contiguous parts allocator)
          failures (if (= (len transfers) 0) 0 1)]
      (free! (mut transfers))
      (let [(mut i) 0]
        (while (< i (len parts))
          (a/release! (elem (mut parts) i))
          (set! i (+ i 1))))
      (free! (mut parts))
      failures)))

(defn same-start [(position i64) (next-use i64)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut first) (a/create 1 allocator)
        (mut second) (a/create 2 allocator)
        (mut layout) (f/create allocator)
        (mut failures) 0]
    ; A live-in Phi can start at the same point as a short-lived use while its
    ; first register-required use is later. Its whole prefix can reside in a slot.
    (r/add! (mut (.ranges first)) position (+ next-use 8))
    (c/add! (mut (.uses first)) next-use 1 -1)
    (r/add! (mut (.ranges second)) position (+ position 1))
    (c/add! (mut (.uses second)) position 1 -1)
    (push! (mut parts) first)
    (push! (mut parts) second)
    (match (a/run! (mut parts) (mut layout) 1 1 8 8 allocator)
      (Err [message]
           (do
             (println "same-start allocation: {}" message)
             (set! failures (+ failures 1))))
      (Ok [_] 0))
    (match (verify/verify parts 1 1)
      (Err [message]
           (do
             (println "same-start consistency: {}" message)
             (set! failures (+ failures 1))))
      (Ok [_] 0))
    (for item [[(: 1 i64) position 1] [1 next-use 0] [2 position 0]]
      (match (locations/lookup parts (cast i32 (get item 0)) (get item 1))
        (Err [_] (set! failures (+ failures 1)))
        (Ok [location]
            (when (!= (.kind location) (cast i32 (get item 2)))
              (set! failures (+ failures 1))))))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (f/release! (mut layout))
    failures))

(defn indexed-location-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0
        (mut queries) 0]
    (for [scenario 0 9]
      (let [(mut parts) (ArrayList::new [a/Part] allocator)]
        (for [i 0 (if (= scenario 8) 0 85)]
          (let [(mut part)
                  (a/create (cast i32 (% (+ (* i 7) scenario) 17)) allocator)
                start (* (/ i 17) 20)]
            (if (= (% scenario 2) 0)
                (do
                  (r/add! (mut (.ranges part)) start (+ start 10))
                  (r/add! (mut (.ranges part)) (+ start 14) (+ start 20)))
                (r/add! (mut (.ranges part)) start (+ start 24)))
            (set! (.register part) (cast i32 (- (% (+ i scenario) 5) 1)))
            (set! (.spill-slot part) (if (= (% i 3) 0) -1 (* (% i 9) 8)))
            (push! (mut parts) part)))
        (a/reserve! (mut parts) 3 5 19 allocator)
        (match (locations/build-index parts 25 allocator)
          (Err [message] (panic "{}" message))
          (Ok [index]
              (let [(mut index) index]
                (for mode [(: 0 i32) 1 2]
                  (for [parent -1 27]
                    (for [position -1 125]
                      (set! queries (+ queries 1))
                      (let [actual
                              (case mode
                                0
                                  (locations/lookup-indexed parts
                                                            index
                                                            (cast i32 parent)
                                                            position)
                                1
                                  (locations/resolve (locations/indexed-view parts
                                                                             index)
                                                     (cast i32 parent)
                                                     position)
                                (locations/resolve (locations/linear-view parts)
                                                   (cast i32 parent)
                                                   position))]
                        (match (locations/lookup parts
                                                 (cast i32 parent)
                                                 position)
                          (Err [message]
                               (match actual
                                 (Err [other]
                                      (when (!= message other)
                                        (set! failures (+ failures 1))))
                                 (Ok [_] (set! failures (+ failures 1)))))
                          (Ok [expected]
                              (match actual
                                (Err [_] (set! failures (+ failures 1)))
                                (Ok [value]
                                    (when (not (locations/same? expected value))
                                      (set! failures (+ failures 1)))))))))))
                (let [(mut expected) (locations/contiguous parts allocator)
                      (mut actual)
                        (locations/contiguous-indexed parts index allocator)]
                  (if (!= (len expected) (len actual))
                      (set! failures (+ failures 1))
                      (for [i 0 (len expected)]
                        (let [a (get expected i)
                              b (get actual i)]
                          (when (or (!= (.position a) (.position b))
                                    (!= (.parent a) (.parent b))
                                    (not (locations/same? (.source a)
                                                          (.source b)))
                                    (not (locations/same? (.destination a)
                                                          (.destination b))))
                            (set! failures (+ failures 1))))))
                  (free! (mut expected))
                  (free! (mut actual)))
                (locations/release-index! (mut index)))))
        (match (locations/build-index parts 0 allocator)
          (Err [_] 0)
          (Ok [index]
              (let [(mut index) index]
                (when (!= scenario 8) (set! failures (+ failures 1)))
                (locations/release-index! (mut index)))))
        (match (locations/build-index parts -1 allocator)
          (Err [_] 0)
          (Ok [index]
              (let [(mut index) index]
                (set! failures (+ failures 1))
                (locations/release-index! (mut index)))))
        (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
        (free! (mut parts))))
    (println "indexed location oracle: {} queries; {} failures"
             queries
             failures)
    failures))

;;; Frozen pairwise acceptance oracle for the indexed verifier.
(defn pairwise-verify [(parts (ArrayList a/Part))
                       (register-count i32)
                       (allowed u64)]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut checked) (: 0 i32)
        (mut i) 0
        target-mask
          (if (and (> register-count 0) (< register-count 64))
              (- (<< (: 1 u64) (cast u64 register-count)) 1)
              (: 0xFFFFFFFFFFFFFFFF u64))]
    (when (or (<= register-count 0) (> register-count 64))
      (set! error "invalid physical register count"))
    (while (and (= error "") (< i (len parts)))
      (let [part (at parts i)
            reg (.register part)
            (mut last-end) -1]
        (when (> (len (.ranges part)) 0)
          (when (= (& (& allowed target-mask) (.allowed part)) 0)
            (set! error "interval has no admissible target register"))
          (if (>= reg 0)
              (when (or (>= reg register-count)
                        (>= reg 64)
                        (= (& (& allowed (.allowed part))
                              (<< (: 1 u64) (cast u64 reg)))
                           0))
                (set! error "assignment uses forbidden register"))
              (when (< (.spill-slot part) 0)
                (set! error "interval has no physical location")))
          (for range (.ranges part)
            (when (or (< (.start range) 0)
                      (<= (.end range) (.start range))
                      (<= (.start range) last-end))
              (set! error "invalid or unmerged live ranges"))
            (set! last-end (.end range)))
          (for use (.uses part)
            (when (not (r/covers? (.ranges part) (.position use)))
              (set! error "constraint outside interval"))
            (when (and (>= (.kind use) 1) (< reg 0))
              (set! error "register-required use spilled"))
            (when (and (= (.kind use) 2) (!= reg (.register use)))
              (set! error "fixed register constraint violated")))
          (let [(mut j) 0]
            (while (and (= error "") (< j i))
              (let [other (at parts j)]
                (when (and (>= (.parent part) 0)
                           (= (.parent part) (.parent other))
                           (!= (.allowed part) (.allowed other)))
                  (set! error "split intervals disagree on register class"))
                (when (and (>= reg 0)
                           (= (.register other) reg)
                           (>= (r/intersection (.ranges part)
                                               (.ranges other)
                                               0)
                               0))
                  (set! error "overlapping intervals share register")))
              (set! j (+ j 1))))
          (set! checked (+ checked 1))))
      (set! i (+ i 1)))
    (if (= error "") (Ok checked) (Err error))))

(defn verifier-differential [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut failures) 0
        (mut accepted) 0]
    (for [scenario 0 1200]
      (let [(mut parts) (ArrayList::new [a/Part] allocator)
            variant (% scenario 12)
            count (+ 1 (% (/ scenario 12) 23))
            mask (if (= variant 10) (: 0x8000000000000000 u64) (: 3 u64))
            registers (if (= variant 10) (: 64 i32) (: 2 i32))]
        (for [j 0 count]
          (let [i (- (- count j) 1)
                (mut part)
                  (a/create (if (= variant 9)
                                (: 2147483647 i32)
                                (cast i32 (if (= variant 8) -1 (% i 5))))
                            allocator)
                start (* i 16)]
            (set! (.allowed part) mask)
            (set! (.register part)
                  (if (= variant 10) (: 63 i32) (cast i32 (% i 2))))
            (for [k 0 3]
              (r/add! (mut (.ranges part))
                      (+ start (* k 4))
                      (+ start (* k 4) 2)))
            (when (= i 0)
              (case variant
                1 (r/add! (mut (.ranges part)) 0 500)
                2 (set! (.register part) 3)
                3 (set! (.register part) -1)
                4 (c/add! (mut (.uses part)) 3 1 -1)
                5 (c/add! (mut (.uses part)) 0 2 1)
                6 (push! (mut (.ranges part)) (r/Range :start -1 :end 2))
                7 (set! (.allowed part) 1)
                9 (set! (.allowed part) 1)
                11 (clear! (mut (.ranges part)))
                0))
            (when (and (= variant 11) (= i 1)) (set! (.allowed part) 1))
            (push! (mut parts) part)))
        (let [expected (pairwise-verify parts registers mask)
              actual (verify/verify parts registers mask)]
          (match expected
            (Err [_]
                 (match actual
                   (Err [_] 0)
                   (Ok [_] (set! failures (+ failures 1)))))
            (Ok [count]
                (set! accepted (+ accepted 1))
                (match actual
                  (Err [_] (set! failures (+ failures 1)))
                  (Ok [other]
                      (unless (= count other) (set! failures (+ failures 1))))))))
        (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
        (free! (mut parts))))
    (println "verifier differential: 1200 cases, {} accepted, {} differences"
             accepted
             failures)
    failures))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut first) (a/create 1 allocator)
        (mut second) (a/create 2 allocator)
        (mut frame) (f/create allocator)
        (mut failures)
          (+ (indexed-location-check)
             (fixed-check)
             (reservation-transfers)
             (same-start 0 1)
             (same-start 0 10)
             (same-start 7 70))]
    (r/add! (mut (.ranges first)) 0 20)
    (c/add! (mut (.uses first)) 0 1 -1)
    (c/add! (mut (.uses first)) 19 1 -1)
    (r/add! (mut (.ranges second)) 2 10)
    (c/add! (mut (.uses second)) 2 1 -1)
    (c/add! (mut (.uses second)) 9 1 -1)
    (push! (mut parts) first)
    (push! (mut parts) second)
    (match (a/run! (mut parts) (mut frame) 1 1 8 8 allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (when (!= (len parts) 4) (set! failures (+ failures 1)))
    (match (verify/verify parts 1 1)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (let [(mut transfers) (locations/contiguous parts allocator)]
      (when (!= (len transfers) 2) (set! failures (+ failures 1)))
      (match (locations/lookup parts 1 3)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [location]
            (when (!= (.kind location) 1) (set! failures (+ failures 1)))))
      (match (locations/lookup parts 1 19)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [location]
            (when (!= (.kind location) 0) (set! failures (+ failures 1)))))
      (for transfer transfers
        (when (not (or (= (.position transfer) 2) (= (.position transfer) 19)))
          (set! failures (+ failures 1))))
      (free! (mut transfers)))
    (let [spilled (elem (mut parts) 2)]
      (set! (.register spilled) 0)
      (match (verify/verify parts 1 1)
        (Err [_] 0)
        (Ok [_] (set! failures (+ failures 1))))
      (set! (.register spilled) -1))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    (f/release! (mut frame))
    (set! failures (+ failures (verifier-differential)))
    (println "allocator driver checks: {} failures" failures)
    (if (= failures 0) 0 1)))
