(module stogir.tests.allocator-driver)
(import "stogir.allocation" :as a)
(import "stogir.allocation-check" :as verify)
(import "stogir.locations" :as locations)
(import "stogir.interval" :as r)
(import "stogir.constraints" :as c)
(import "stogir.frame" :as f)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn fixed-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut first) (a/create 1 allocator)
        (mut second) (a/create 2 allocator)
        (mut layout) (f/create allocator)
        (mut failures) 0]
    (r/add! (mut (.ranges first)) 0 20)
    (c/add! (mut (.uses first)) 0 2 0)
    (c/add! (mut (.uses first)) 19 2 1)
    (r/add! (mut (.ranges second)) 2 10)
    (c/add! (mut (.uses second)) 2 2 0)
    (c/add! (mut (.uses second)) 9 1 -1)
    (push! (mut parts) first)
    (push! (mut parts) second)
    (a/reserve! (mut parts) 1 12 13 allocator)
    (match (a/run! (mut parts) (mut layout) 2 3 8 8 allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (match (verify/verify parts 2 3)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    (f/release! (mut layout))
    failures))

(defn reservation-transfers [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)]
    (a/reserve! (mut parts) 0 1 2 allocator)
    (a/reserve! (mut parts) 1 2 3 allocator)
    (let [(mut transfers) (locations/contiguous parts allocator)
          failures (if (= (len transfers) 0) 0 1)]
      (free! (mut transfers))
      (let [(mut i) 0]
        (while (< i (len parts))
          (a/release! (elem (mut parts) i))
          (set! i (+ i 1))))
      (free! (mut parts))
      failures)))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut first) (a/create 1 allocator)
        (mut second) (a/create 2 allocator)
        (mut frame) (f/create allocator)
        (mut failures) (+ (fixed-check) (reservation-transfers))]
    (r/add! (mut (.ranges first)) 0 20)
    (c/add! (mut (.uses first)) 0 1 -1)
    (c/add! (mut (.uses first)) 19 1 -1)
    (r/add! (mut (.ranges second)) 2 10)
    (c/add! (mut (.uses second)) 2 1 -1)
    (c/add! (mut (.uses second)) 9 1 -1)
    (push! (mut parts) first)
    (push! (mut parts) second)
    (match (a/run! (mut parts) (mut frame) 1 1 8 8 allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (when (!= (len parts) 4) (set! failures (+ failures 1)))
    (match (verify/verify parts 1 1)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (let [(mut transfers) (locations/contiguous parts allocator)]
      (when (!= (len transfers) 2) (set! failures (+ failures 1)))
      (match (locations/lookup parts 1 3)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [location]
            (when (!= (.kind location) 1) (set! failures (+ failures 1)))))
      (match (locations/lookup parts 1 19)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [location]
            (when (!= (.kind location) 0) (set! failures (+ failures 1)))))
      (for transfer transfers
        (when (not (or (= (.position transfer) 2) (= (.position transfer) 19)))
          (set! failures (+ failures 1))))
      (free! (mut transfers)))
    (let [spilled (elem (mut parts) 2)]
      (set! (.register spilled) 0)
      (match (verify/verify parts 1 1)
        (Err [_] 0)
        (Ok [_] (set! failures (+ failures 1))))
      (set! (.register spilled) -1))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    (f/release! (mut frame))
    (println "allocator driver checks: {} failures" failures)
    (if (= failures 0) 0 1)))
