(module stogir.tests.a64-pairing)
;;; Adjacent same-base LDR/STR at consecutive scaled slots become LDP/STP plus
;;; NOP, whichever of the two slots comes first. Labels on the second word, relocations, inline data, a load whose
;;; first destination is the base or equals the second, gaps, mixed widths and
;;; out-of-range offsets keep both words.
(import "stogir.a64.fixups" :as f)
(import "stogir.a64.code" :as code)
(import "stogir.text-data" :as data)
(import "stogir.bytes" :as b)
(import "stogir.relocate" :as read)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn ldr [(rt u32) (rn u32) (slot u32)] (-> u32) (| (: 0xF9400000 u32) (<< slot 10) (<< rn 5) rt))
(defn str [(rt u32) (rn u32) (slot u32)] (-> u32) (| (: 0xF9000000 u32) (<< slot 10) (<< rn 5) rt))
(defn ldrw [(rt u32) (rn u32) (slot u32)] (-> u32) (| (: 0xB9400000 u32) (<< slot 10) (<< rn 5) rt))
(defn ldrsw [(rt u32) (rn u32) (slot u32)] (-> u32) (| (: 0xB9800000 u32) (<< slot 10) (<< rn 5) rt))

;;; Pairing in the middle of a function, then compaction: STR x9,[sp]; LDR;LDR
;;; pair; B to a label after them; a relocated word; a switch-style table whose
;;; base is a Relative. Every record moves down by the four removed bytes, and a
;;; pair inside a table's 16-byte ADR window keeps its NOP.
(defn compaction [] (-> i64)
  (let [a (malloc-allocator)
        nop (: 0xD503201F u32)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut relatives) (ArrayList::new [f/Relative] a)
        (mut removed) (ArrayList::new [i64] a)
        (mut failures) 0]
    (b/append32! (mut (.text output)) (ldr 1 0 1))   ; 0
    (b/append32! (mut (.text output)) (ldr 2 0 2))   ; 4: paired away
    (push! (mut branches) (f/Branch :offset 8 :label 0 :condition -1 :link false))
    (b/append32! (mut (.text output)) 0)             ; 8: branch to label 0
    (push! (mut (.references output)) (code/Reference :offset 12 :kind 4 :target -1))
    (b/append32! (mut (.text output)) (: 0x94000000 u32)) ; 12: relocated BL
    (b/append32! (mut (.text output)) (str 3 4 1))   ; 16
    (b/append32! (mut (.text output)) (str 5 4 2))   ; 20: inside ADR window, kept
    (b/append32! (mut (.text output)) (: 0xD61F0200 u32)) ; 24
    (b/append32! (mut (.text output)) (: 0xD61F0200 u32)) ; 28
    (push! (mut relatives) (f/Relative :offset 32 :base 32 :label 0))
    (push! (mut (.text-data output)) (data/Range :offset 32 :length 4 :kind 4))
    (b/append32! (mut (.text output)) 0)             ; 32: table word
    (push! (mut labels) 36)
    (b/append32! (mut (.text output)) (: 0xD65F03C0 u32)) ; 36: RET, label 0
    (match (f/pair-adjacent! (mut output) labels (mut removed))
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [_] 0))
    (when (!= (len removed) 2) (set! failures (+ failures 1)))
    (match (f/compact-removed! (mut output) (mut labels) (mut branches) (mut relatives) removed)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [count] (when (!= count 1) (set! failures (+ failures 1)))))
    (when (or (!= (len (.text output)) 36)
              (!= (get labels 0) 32)
              (!= (.offset (get branches 0)) 4)
              (!= (.offset (get (.references output) 0)) 8)
              (!= (.offset (get relatives 0)) 28)
              (!= (.base (get relatives 0)) 28)
              (!= (.offset (get (.text-data output) 0)) 28)
              (!= (read/read32 (.text output) 0) (: 0xA9408801 u32))
              (!= (read/read32 (.text output) 12) (: 0xA9009483 u32))
              (!= (read/read32 (.text output) 16) nop)
              (!= (read/read32 (.text output) 32) (: 0xD65F03C0 u32)))
      (set! failures (+ failures 1)))
    (code/release! (mut output))
    (free! (mut labels)) (free! (mut branches)) (free! (mut relatives)) (free! (mut removed))
    failures))

;;; Runs the pass over two words; returns 1 if the result differs from expected.
(defn check [(first u32) (second u32) (label-second bool) (relocated bool) (inline bool)
             (expected-first u32) (expected-second u32)] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut failures) 0]
    (b/append32! (mut (.text output)) first)
    (b/append32! (mut (.text output)) second)
    (push! (mut labels) 0)
    (when label-second (push! (mut labels) 4))
    (when relocated
      (push! (mut (.references output)) (code/Reference :offset 0 :kind 4 :target -1)))
    (when inline
      (push! (mut (.text-data output)) (data/Range :offset 4 :length 4 :kind 4)))
    (let [(mut removed) (ArrayList::new [i64] a)]
      (match (f/pair-adjacent! (mut output) labels (mut removed))
        (Err [message] (println "{}" message) (set! failures 1))
        (Ok [_] 0))
      (when (!= (len removed) (if (= expected-second (: 0xD503201F u32)) 1 0))
        (set! failures 1))
      (free! (mut removed)))
    (when (or (!= (read/read32 (.text output) 0) expected-first)
              (!= (read/read32 (.text output) 4) expected-second))
      (set! failures 1))
    (code/release! (mut output))
    (free! (mut labels))
    failures))

;;; A word recorded as a volatile access (code Buffer fixed) pairs with
;;; neither neighbour; the same words unmarked do pair. Returns 1 on a
;;; difference. A mark that does not name a load or store is an error.
(defn fixed-check [(first u32) (second u32) (third u32) (mark i64) (invalid bool)] (-> i64)
  (let [a (malloc-allocator)
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut removed) (ArrayList::new [i64] a)
        (mut failures) 0]
    (for word [first second third] (b/append32! (mut (.text output)) word))
    (push! (mut labels) 0)
    (when (>= mark 0) (push! (mut (.fixed output)) mark))
    (match (f/pair-adjacent! (mut output) labels (mut removed))
      (Err [_] (unless invalid (set! failures 1)))
      (Ok [pairs]
        (when (or invalid (!= pairs (if (= mark 4) 0 1))) (set! failures 1))))
    (unless invalid
      (when (!= (len (.fixed output)) 0) (set! failures 1))
      (when (>= mark 0)
        (when (!= (read/read32 (.text output) mark)
                  (if (= mark 0) first (if (= mark 4) second third)))
          (set! failures 1))))
    (code/release! (mut output))
    (free! (mut labels)) (free! (mut removed))
    failures))

(defn main [] (-> i64)
  (let [nop (: 0xD503201F u32)
        failures
          (+ ; Three consecutive slots: unmarked, the first two pair. A fixed
             ; first word leaves the last two to pair, a fixed middle word
             ; leaves all three, a fixed last word the first two.
             (fixed-check (ldr 1 0 1) (ldr 2 0 2) (ldr 3 0 3) -1 false)
             (fixed-check (ldr 1 0 1) (ldr 2 0 2) (ldr 3 0 3) 0 false)
             (fixed-check (ldr 1 0 1) (ldr 2 0 2) (ldr 3 0 3) 4 false)
             (fixed-check (ldr 1 0 1) (ldr 2 0 2) (ldr 3 0 3) 8 false)
             (fixed-check (str 1 0 1) (str 2 0 2) (str 3 0 3) 4 false)
             ; A mark on a word that is no memory access, off a word boundary
             ; or outside the text.
             (fixed-check (ldr 1 0 1) (: 0xD503201F u32) (ldr 3 0 3) 4 true)
             (fixed-check (ldr 1 0 1) (ldr 2 0 2) (ldr 3 0 3) 2 true)
             (fixed-check (ldr 1 0 1) (ldr 2 0 2) (ldr 3 0 3) 12 true)
             ; STR x1,[x0,#8]; STR x2,[x0,#16] -> STP x1,x2,[x0,#8]
             (check (str 1 0 1) (str 2 0 2) false false false (: 0xA9008801 u32) nop)
             ; LDR x3,[sp,#16]; LDR x4,[sp,#24] -> LDP x3,x4,[sp,#16]
             (check (ldr 3 31 2) (ldr 4 31 3) false false false (: 0xA94113E3 u32) nop)
             ; 32-bit LDR w5,[x6,#4]; LDR w7,[x6,#8] -> LDP w5,w7,[x6,#4]
             (check (ldrw 5 6 1) (ldrw 7 6 2) false false false (: 0x29409CC5 u32) nop)
             ; LDRSW x5,[x6,#4]; LDRSW x7,[x6,#8] -> LDPSW x5,x7,[x6,#4]
             (check (ldrsw 5 6 1) (ldrsw 7 6 2) false false false (: 0x69409CC5 u32) nop)
             (check (ldrsw 5 6 1) (ldrw 7 6 2) false false false (ldrsw 5 6 1) (ldrw 7 6 2))
             ; Second load may overwrite the base: LDP x1,x0,[x0]
             (check (ldr 1 0 0) (ldr 0 0 1) false false false (: 0xA9400001 u32) nop)
             ; Descending slots: LDR x20,[sp,#104]; LDR x27,[sp,#96] -> LDP x27,x20,[sp,#96]
             (check (ldr 20 31 13) (ldr 27 31 12) false false false (: 0xA94653FB u32) nop)
             ; STR x1,[x0,#16]; STR x2,[x0,#8] -> STP x2,x1,[x0,#8]
             (check (str 1 0 2) (str 2 0 1) false false false (: 0xA9008402 u32) nop)
             ; LDRSW x5,[x6,#8]; LDRSW x7,[x6,#4] -> LDPSW x7,x5,[x6,#4]
             (check (ldrsw 5 6 2) (ldrsw 7 6 1) false false false (: 0x694094C7 u32) nop)
             ; Descending, second load overwrites the base: LDP x0,x1,[x0]
             (check (ldr 1 0 1) (ldr 0 0 0) false false false (: 0xA9400400 u32) nop)
             ; Descending with the first destination the base, equal destinations,
             ; or a lower slot out of range stays two words; slot 64 over 63 pairs.
             (check (ldr 0 0 2) (ldr 2 0 1) false false false (ldr 0 0 2) (ldr 2 0 1))
             (check (ldr 3 0 2) (ldr 3 0 1) false false false (ldr 3 0 2) (ldr 3 0 1))
             (check (str 1 0 65) (str 2 0 64) false false false (str 1 0 65) (str 2 0 64))
             (check (str 1 0 64) (str 2 0 63) false false false (: 0xA91F8402 u32) nop)
             (check (str 1 0 1) (str 2 0 2) true false false (str 1 0 1) (str 2 0 2))
             (check (str 1 0 1) (str 2 0 2) false true false (str 1 0 1) (str 2 0 2))
             (check (str 1 0 1) (str 2 0 2) false false true (str 1 0 1) (str 2 0 2))
             (check (ldr 0 0 1) (ldr 2 0 2) false false false (ldr 0 0 1) (ldr 2 0 2))
             (check (ldr 3 0 1) (ldr 3 0 2) false false false (ldr 3 0 1) (ldr 3 0 2))
             (check (str 1 0 1) (str 2 0 3) false false false (str 1 0 1) (str 2 0 3))
             (check (str 1 0 1) (str 2 1 2) false false false (str 1 0 1) (str 2 1 2))
             (check (ldr 1 0 1) (ldrw 2 0 2) false false false (ldr 1 0 1) (ldrw 2 0 2))
             (check (str 1 0 64) (str 2 0 65) false false false (str 1 0 64) (str 2 0 65))
             (compaction))]
    (println "AArch64 load/store pairing: {} failures" failures)
    (if (= failures 0) 0 1)))
