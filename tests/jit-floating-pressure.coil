(module stogir.tests.jit-floating-pressure)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn sum32 :cc (cc/C) [(a0 f32)
                        (a1 f32)
                        (a2 f32)
                        (a3 f32)
                        (a4 f32)
                        (a5 f32)
                        (a6 f32)
                        (a7 f32)
                        (a8 f32)
                        (a9 f32)
                        (a10 f32)
                        (a11 f32)
                        (a12 f32)
                        (a13 f32)
                        (a14 f32)
                        (a15 f32)
                        (a16 f32)
                        (a17 f32)
                        (a18 f32)
                        (a19 f32)
                        (a20 f32)
                        (a21 f32)
                        (a22 f32)
                        (a23 f32)] (-> f32)
  (+ a0
     a1
     a2
     a3
     a4
     a5
     a6
     a7
     a8
     a9
     a10
     a11
     a12
     a13
     a14
     a15
     a16
     a17
     a18
     a19
     a20
     a21
     a22
     a23))

(defn sum64 :cc (cc/C) [(a0 f64)
                        (a1 f64)
                        (a2 f64)
                        (a3 f64)
                        (a4 f64)
                        (a5 f64)
                        (a6 f64)
                        (a7 f64)
                        (a8 f64)
                        (a9 f64)
                        (a10 f64)
                        (a11 f64)
                        (a12 f64)
                        (a13 f64)
                        (a14 f64)
                        (a15 f64)
                        (a16 f64)
                        (a17 f64)
                        (a18 f64)
                        (a19 f64)
                        (a20 f64)
                        (a21 f64)
                        (a22 f64)
                        (a23 f64)] (-> f64)
  (+ a0
     a1
     a2
     a3
     a4
     a5
     a6
     a7
     a8
     a9
     a10
     a11
     a12
     a13
     a14
     a15
     a16
     a17
     a18
     a19
     a20
     a21
     a22
     a23))

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [v] v) (Err [msg] (do (println "{}" msg) 0))))

(defn check [(ty u8) (anchored? bool) (dynamic? bool) (padding? bool)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        (mut args) (ArrayList::new [i32] allocator)
        (mut types) (ArrayList::new [u8] allocator)
        (mut cells) (ArrayList::new [u64] allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        frame
          (if anchored?
              (require (b/emit! (mut graph) 66 6 []))
              (require (b/scalar-constant! (mut graph) 6 1 8)))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        input
          (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 1]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        count (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 3]))
        allocation
          (let [(mut control) start
                (mut j) (: 0 i64)
                zero (require (b/scalar-constant! (mut graph) 5 0 8))]
            (when padding?
              (while (< j 4200)
                (let [variable
                        (require (b/variable! (mut graph)
                                              5
                                              start
                                              "large-padding"
                                              8))]
                  (set! control
                        (require (b/emit! (mut graph)
                                          87
                                          0
                                          [control variable zero]))))
                (set! j (+ j 1))))
            (if dynamic?
                (require (b/stack-allocate! (mut graph) control count 16))
                control))
        (mut i) (: 1 i64)
        (mut failures) 0]
    (while (<= i 24)
      (let [(mut d) (cast f64 i)
            (mut f) (cast f32 i)
            bits
              (if (= ty 12)
                  (load (primitive/cast (ptr u64) (mut d)))
                  (cast u64 (load (primitive/cast (ptr u32) (mut f)))))
            constant
              (require (b/scalar-constant! (mut graph) (cast i32 ty) bits 8))
            value
              (require (b/floating! (mut graph)
                                    26
                                    (cast i32 ty)
                                    input
                                    constant
                                    0))]
        (push! (mut args) value)
        (push! (mut types) ty)
        (push! (mut cells) 0))
      (set! i (+ i 1)))
    (match (calls/create 0 ty (slice types) allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype
                call
                  (require (calls/emit! (mut graph)
                                        owned
                                        allocation
                                        target
                                        (slice args)
                                        allocator))
                (mut control) call]
            (set! i 0)
            (while (< i 24)
              (let [offset
                      (require (b/scalar-constant! (mut graph)
                                                   6
                                                   (cast u64 (* i 8))
                                                   8))
                    address (require (b/emit! (mut graph) 26 6 [output offset]))]
                (set! control
                      (require (b/emit! (mut graph)
                                        93
                                        0
                                        [control address (get args i)]))))
              (set! i (+ i 1)))
            (when dynamic?
              (set! control (require (b/stack-free! (mut graph) control count))))
            (let [zero
                    (require (b/scalar-constant! (mut graph) (cast i32 ty) 0 8))
                  result
                    (require (b/emit! (mut graph)
                                      60
                                      (cast i32 ty)
                                      [frame call zero]))
                  ret
                    (require (b/emit! (mut graph)
                                      120
                                      (cast i32 ty)
                                      [control result (: 0 i32)]))]
              (match (calls/create 0 ty [(: 6 u8) ty 6 5] allocator)
                (Err [_] (set! failures (+ failures 1)))
                (Ok [incoming]
                    (let [(mut owned-incoming) incoming]
                      (require (calls/function! (mut graph)
                                                owned-incoming
                                                allocator))
                      (calls/release! (mut owned-incoming)))))
              (match (compile/text graph start [ret] allocator)
                (Err [msg]
                     (do
                       (println "FP pressure ty={}: {}" ty msg)
                       (set! failures (+ failures 1))))
                (Ok [text]
                    (let [(mut code) text]
                      (match (jit/map-text (slice code))
                        (Err [_] (set! failures (+ failures 1)))
                        (Ok [loaded]
                            (let [(mut image) loaded
                                  target
                                    (primitive/cast u64
                                                    (if (= ty 12)
                                                        (primitive/cast (ptr u8)
                                                                        (fnptr-of sum64))
                                                        (primitive/cast (ptr u8)
                                                                        (fnptr-of sum32))))]
                              (for base [(: -100 i64) -1 0 1 100]
                                (let [d (* (cast f64 base) 0.25)
                                      f (* (cast f32 base) (: 0.25 f32))
                                      (mut total64) (: 0.0 f64)
                                      (mut total32) (: 0.0 f32)]
                                  (set! i 1)
                                  (while (<= i 24)
                                    (set! total64
                                          (+ total64 (+ d (cast f64 i))))
                                    (set! total32
                                          (+ total32 (+ f (cast f32 i))))
                                    (set! i (+ i 1)))
                                  (if (= ty 12)
                                      (let [fun
                                              (primitive/cast (fnptr (cc/C)
                                                                     [u64
                                                                      f64
                                                                      (ptr u64)
                                                                      u64]
                                                                     f64)
                                                              (.base image))]
                                        (when (!= (call-ptr fun
                                                            target
                                                            d
                                                            (.data cells)
                                                            33)
                                                  total64)
                                          (set! failures (+ failures 1))))
                                      (let [fun
                                              (primitive/cast (fnptr (cc/C)
                                                                     [u64
                                                                      f32
                                                                      (ptr u64)
                                                                      u64]
                                                                     f32)
                                                              (.base image))]
                                        (when (!= (call-ptr fun
                                                            target
                                                            f
                                                            (.data cells)
                                                            33)
                                                  total32)
                                          (set! failures (+ failures 1)))))
                                  (set! i 0)
                                  (while (< i 24)
                                    (let [(mut expected64)
                                            (+ d (cast f64 (+ i 1)))
                                          (mut expected32)
                                            (+ f (cast f32 (+ i 1)))
                                          wanted
                                            (if (= ty 12)
                                                (load (primitive/cast (ptr u64)
                                                                      (mut expected64)))
                                                (cast u64
                                                      (load (primitive/cast (ptr u32)
                                                                            (mut expected32)))))]
                                      (when (!= (get cells i) wanted)
                                        (when (= failures 0)
                                          (println "FP pressure ty={} base={} i={} wanted={} actual={}"
                                                   ty
                                                   base
                                                   i
                                                   wanted
                                                   (get cells i)))
                                        (set! failures (+ failures 1))))
                                    (set! i (+ i 1)))))
                              (jit/release! (mut image)))))
                      (free! (mut code))))))
            (calls/release! (mut owned)))))
    (free! (mut cells))
    (free! (mut args))
    (free! (mut types))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (check 12 false false false)
             (check 13 false false false)
             (check 12 true false false)
             (check 13 true false false)
             (check 12 false true false)
             (check 13 false true false)
             (check 12 true true false)
             (check 13 true true false)
             (check 12 false false true)
             (check 12 false true true)
             (check 13 false true true))]
    (println "native floating 24-value call pressure: {} failures" failures)
    (if (= failures 0) 0 1)))
