(module stogir.tests.aot-grouped-arguments-link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.layout" :as layout)

(defstruct Pair8 [(a u64) (b u64)])

(defstruct Pair16 :layout (layout/Explicit) :size 16 :align 16
  [(a u64 :at 0) (b u64 :at 8)])

(defstruct H13_1 [(a f32)])

(defstruct H13_2 [(a f32) (b f32)])

(defstruct H13_3 [(a f32) (b f32) (c f32)])

(defstruct H13_4 [(a f32) (b f32) (c f32) (d f32)])

(defstruct H12_1 [(a f64)])

(defstruct H12_2 [(a f64) (b f64)])

(defstruct H12_3 [(a f64) (b f64) (c f64)])

(defstruct H12_4 [(a f64) (b f64) (c f64) (d f64)])

(defn callback4 :cc (cc/C) [(p0 u64)
                            (p1 u64)
                            (p2 u64)
                            (p3 u64)
                            (p4 u64)
                            (p5 u64)
                            (p6 u64)
                            (aggregate Pair8)
                            (tail u64)] (-> u64)
  (+ (* (cast u64 p0) (: 1 u64))
     (* (cast u64 p1) (: 2 u64))
     (* (cast u64 p2) (: 3 u64))
     (* (cast u64 p3) (: 4 u64))
     (* (cast u64 p4) (: 5 u64))
     (* (cast u64 p5) (: 6 u64))
     (* (cast u64 p6) (: 7 u64))
     (* (cast u64 (.a aggregate)) (: 8 u64))
     (* (cast u64 (.b aggregate)) (: 9 u64))
     (* (cast u64 tail) (: 10 u64))))

(defn callback7 :cc (cc/C) [(p0 u64) (aggregate Pair16) (tail u64)] (-> u64)
  (+ (* (cast u64 p0) (: 1 u64))
     (* (cast u64 (.a aggregate)) (: 2 u64))
     (* (cast u64 (.b aggregate)) (: 3 u64))
     (* (cast u64 tail) (: 4 u64))))

(defn callback25 :cc (cc/C) [(p0 f32)
                             (p1 f32)
                             (p2 f32)
                             (p3 f32)
                             (p4 f32)
                             (p5 f32)
                             (p6 f32)
                             (aggregate H13_3)
                             (tail f32)] (-> u64)
  (+ (* (cast u64 p0) (: 1 u64))
     (* (cast u64 p1) (: 2 u64))
     (* (cast u64 p2) (: 3 u64))
     (* (cast u64 p3) (: 4 u64))
     (* (cast u64 p4) (: 5 u64))
     (* (cast u64 p5) (: 6 u64))
     (* (cast u64 p6) (: 7 u64))
     (* (cast u64 (.a aggregate)) (: 8 u64))
     (* (cast u64 (.b aggregate)) (: 9 u64))
     (* (cast u64 (.c aggregate)) (: 10 u64))
     (* (cast u64 tail) (: 11 u64))))

(defn callback48 :cc (cc/C) [(p0 f64)
                             (p1 f64)
                             (p2 f64)
                             (p3 f64)
                             (p4 f64)
                             (aggregate H12_4)
                             (tail f64)] (-> u64)
  (+ (* (cast u64 p0) (: 1 u64))
     (* (cast u64 p1) (: 2 u64))
     (* (cast u64 p2) (: 3 u64))
     (* (cast u64 p3) (: 4 u64))
     (* (cast u64 p4) (: 5 u64))
     (* (cast u64 (.a aggregate)) (: 6 u64))
     (* (cast u64 (.b aggregate)) (: 7 u64))
     (* (cast u64 (.c aggregate)) (: 8 u64))
     (* (cast u64 (.d aggregate)) (: 9 u64))
     (* (cast u64 tail) (: 10 u64))))

(defn callback54 :cc (cc/C) [(p0 f64)
                             (p1 f64)
                             (p2 f64)
                             (p3 f64)
                             (p4 f64)
                             (p5 f64)
                             (p6 f64)
                             (p7 f64)
                             (aggregate H13_3)
                             (tail f64)] (-> u64)
  (+ (* (cast u64 p0) (: 1 u64))
     (* (cast u64 p1) (: 2 u64))
     (* (cast u64 p2) (: 3 u64))
     (* (cast u64 p3) (: 4 u64))
     (* (cast u64 p4) (: 5 u64))
     (* (cast u64 p5) (: 6 u64))
     (* (cast u64 p6) (: 7 u64))
     (* (cast u64 p7) (: 8 u64))
     (* (cast u64 (.a aggregate)) (: 9 u64))
     (* (cast u64 (.b aggregate)) (: 10 u64))
     (* (cast u64 (.c aggregate)) (: 11 u64))
     (* (cast u64 tail) (: 12 u64))))

(export-c [callback4 :as "stogir_group_aot_callback_4"])

(export-c [callback7 :as "stogir_group_aot_callback_7"])

(export-c [callback25 :as "stogir_group_aot_callback_25"])

(export-c [callback48 :as "stogir_group_aot_callback_48"])

(export-c [callback54 :as "stogir_group_aot_callback_54"])

(extern out4 :as "stogir_group_4_0" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern in4_1
        :as
        "stogir_group_4_1"
        :cc
        (cc/C)
        [u64 u64 u64 u64 u64 u64 u64 Pair8 u64]
        (-> u64))

(extern in4_2
        :as
        "stogir_group_4_2"
        :cc
        (cc/C)
        [u64 u64 u64 u64 u64 u64 u64 Pair8 u64]
        (-> u64))

(extern out7 :as "stogir_group_7_0" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern in7_1 :as "stogir_group_7_1" :cc (cc/C) [u64 Pair16 u64] (-> u64))

(extern in7_2 :as "stogir_group_7_2" :cc (cc/C) [u64 Pair16 u64] (-> u64))

(extern out25 :as "stogir_group_25_0" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern in25_1
        :as
        "stogir_group_25_1"
        :cc
        (cc/C)
        [f32 f32 f32 f32 f32 f32 f32 H13_3 f32]
        (-> u64))

(extern in25_2
        :as
        "stogir_group_25_2"
        :cc
        (cc/C)
        [f32 f32 f32 f32 f32 f32 f32 H13_3 f32]
        (-> u64))

(extern out48 :as "stogir_group_48_0" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern in48_1
        :as
        "stogir_group_48_1"
        :cc
        (cc/C)
        [f64 f64 f64 f64 f64 H12_4 f64]
        (-> u64))

(extern in48_2
        :as
        "stogir_group_48_2"
        :cc
        (cc/C)
        [f64 f64 f64 f64 f64 H12_4 f64]
        (-> u64))

(extern out54 :as "stogir_group_54_0" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern direct4 :as "stogir_group_4_3" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern direct7 :as "stogir_group_7_3" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern direct25 :as "stogir_group_25_3" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern direct48 :as "stogir_group_48_3" :cc (cc/C) [u64 u64 u64] (-> u64))

(extern direct54 :as "stogir_group_54_3" :cc (cc/C) [u64 u64 u64] (-> u64))

(defn target [(id i32)] (-> u64)
  (match id
    (4 (primitive/cast u64
                       (primitive/cast (ptr u8)
                                       (: (fnptr-of callback4)
                                          (fnptr (cc/C)
                                                 [u64 u64 u64 u64 u64 u64 u64
                                                  Pair8 u64]
                                                 u64)))))
    (7 (primitive/cast u64
                       (primitive/cast (ptr u8)
                                       (: (fnptr-of callback7)
                                          (fnptr (cc/C) [u64 Pair16 u64] u64)))))
    (25 (primitive/cast u64
                        (primitive/cast (ptr u8)
                                        (: (fnptr-of callback25)
                                           (fnptr (cc/C)
                                                  [f32 f32 f32 f32 f32 f32 f32
                                                   H13_3 f32]
                                                  u64)))))
    (48 (primitive/cast u64
                        (primitive/cast (ptr u8)
                                        (: (fnptr-of callback48)
                                           (fnptr (cc/C)
                                                  [f64 f64 f64 f64 f64 H12_4 f64]
                                                  u64)))))
    (54 (primitive/cast u64
                        (primitive/cast (ptr u8)
                                        (: (fnptr-of callback54)
                                           (fnptr (cc/C)
                                                  [f64 f64 f64 f64 f64 f64 f64
                                                   f64 H13_3 f64]
                                                  u64)))))
    (_ 0)))

(defn incoming [(id i32) (mode i32) (seed u64)] (-> u64)
  (match id
    (4 (if (= mode 1)
           (in4_1 (cast u64 (+ seed 0))
                  (cast u64 (+ seed 1))
                  (cast u64 (+ seed 2))
                  (cast u64 (+ seed 3))
                  (cast u64 (+ seed 4))
                  (cast u64 (+ seed 5))
                  (cast u64 (+ seed 6))
                  (Pair8 :a (cast u64 (+ seed 7)) :b (cast u64 (+ seed 8)))
                  (cast u64 (+ seed 9)))
           (in4_2 (cast u64 (+ seed 0))
                  (cast u64 (+ seed 1))
                  (cast u64 (+ seed 2))
                  (cast u64 (+ seed 3))
                  (cast u64 (+ seed 4))
                  (cast u64 (+ seed 5))
                  (cast u64 (+ seed 6))
                  (Pair8 :a (cast u64 (+ seed 7)) :b (cast u64 (+ seed 8)))
                  (cast u64 (+ seed 9)))))
    (7 (if (= mode 1)
           (in7_1 (cast u64 (+ seed 0))
                  (Pair16 :a (cast u64 (+ seed 1)) :b (cast u64 (+ seed 2)))
                  (cast u64 (+ seed 3)))
           (in7_2 (cast u64 (+ seed 0))
                  (Pair16 :a (cast u64 (+ seed 1)) :b (cast u64 (+ seed 2)))
                  (cast u64 (+ seed 3)))))
    (25 (if (= mode 1)
            (in25_1 (cast f32 (+ seed 0))
                    (cast f32 (+ seed 1))
                    (cast f32 (+ seed 2))
                    (cast f32 (+ seed 3))
                    (cast f32 (+ seed 4))
                    (cast f32 (+ seed 5))
                    (cast f32 (+ seed 6))
                    (H13_3
                      :a (cast f32 (+ seed 7))
                      :b (cast f32 (+ seed 8))
                      :c (cast f32 (+ seed 9)))
                    (cast f32 (+ seed 10)))
            (in25_2 (cast f32 (+ seed 0))
                    (cast f32 (+ seed 1))
                    (cast f32 (+ seed 2))
                    (cast f32 (+ seed 3))
                    (cast f32 (+ seed 4))
                    (cast f32 (+ seed 5))
                    (cast f32 (+ seed 6))
                    (H13_3
                      :a (cast f32 (+ seed 7))
                      :b (cast f32 (+ seed 8))
                      :c (cast f32 (+ seed 9)))
                    (cast f32 (+ seed 10)))))
    (48 (if (= mode 1)
            (in48_1 (cast f64 (+ seed 0))
                    (cast f64 (+ seed 1))
                    (cast f64 (+ seed 2))
                    (cast f64 (+ seed 3))
                    (cast f64 (+ seed 4))
                    (H12_4
                      :a (cast f64 (+ seed 5))
                      :b (cast f64 (+ seed 6))
                      :c (cast f64 (+ seed 7))
                      :d (cast f64 (+ seed 8)))
                    (cast f64 (+ seed 9)))
            (in48_2 (cast f64 (+ seed 0))
                    (cast f64 (+ seed 1))
                    (cast f64 (+ seed 2))
                    (cast f64 (+ seed 3))
                    (cast f64 (+ seed 4))
                    (H12_4
                      :a (cast f64 (+ seed 5))
                      :b (cast f64 (+ seed 6))
                      :c (cast f64 (+ seed 7))
                      :d (cast f64 (+ seed 8)))
                    (cast f64 (+ seed 9)))))
    (_ 0)))

(defn outgoing [(id i32) (mode i32) (seed u64) (data u64)] (-> u64)
  (match id
    (4 (if (= mode 0)
           (out4 (target id) seed data)
           (direct4 (target id) seed data)))
    (7 (if (= mode 0)
           (out7 (target id) seed data)
           (direct7 (target id) seed data)))
    (25 (if (= mode 0)
            (out25 (target id) seed data)
            (direct25 (target id) seed data)))
    (48 (if (= mode 0)
            (out48 (target id) seed data)
            (direct48 (target id) seed data)))
    (54 (if (= mode 0)
            (out54 (target id) seed data)
            (direct54 (target id) seed data)))
    (_ 0)))

(defn total [(id i32)] (-> i32)
  (match id (4 10) (7 4) (25 11) (48 10) (54 12) (_ 0)))

(defn score [(count i32) (seed u64)] (-> u64)
  (let [(mut i) (: 0 i32)
        (mut sum) (: 0 u64)]
    (while (< i count)
      (set! sum (+ sum (* (+ seed (cast u64 i)) (cast u64 (+ i 1)))))
      (set! i (+ i 1)))
    sum))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut integers) (ArrayList::new [u64] allocator)
        (mut singles) (ArrayList::new [f32] allocator)
        (mut doubles) (ArrayList::new [f64] allocator)
        (mut i) (: 0 i32)
        (mut failures) 0]
    (while (< i 40)
      (push! (mut integers) (cast u64 (+ i 11)))
      (push! (mut singles) (cast f32 (+ i 11)))
      (push! (mut doubles) (cast f64 (+ i 11)))
      (set! i (+ i 1)))
    (for id [(: 4 i32) 7 25 48 54]
      (for seed [(: 0 u64) 1 7 29 99]
        (let [data
                (if (< id 12)
                    (primitive/cast u64 (.data integers))
                    (if (< id 32)
                        (primitive/cast u64 (.data singles))
                        (if (= id 54)
                            (primitive/cast u64 (.data singles))
                            (primitive/cast u64 (.data doubles)))))
              expected (score (total id) seed)]
          (for mode [(: 0 i32) 3]
            (when (!= (outgoing id mode seed data)
                      (+ expected 1220 (* seed 17)))
              (set! failures (+ failures 1))))
          (when (< id 52)
            (when (or (!= (incoming id 1 seed) expected)
                      (!= (incoming id 2 seed)
                          (+ seed (cast u64 (- (total id) 1)))))
              (set! failures (+ failures 1)))))))
    (free! (mut integers))
    (free! (mut singles))
    (free! (mut doubles))
    (println "linked grouped arguments, incoming/outgoing, omitted pieces and spills: {} failures"
             failures)
    (if (= failures 0) 0 1)))
