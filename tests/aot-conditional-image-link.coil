(module stogir.tests.aot-conditional-image-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern entry :as "stogir_conditional_image" :cc (cc/C) [i64] (-> (ptr u8)))

(defn main [] (-> i64)
  (let [(mut c) (: -100 i64)
        (mut failures) 0]
    (while (<= c 100)
      (let [pointer (entry c)]
        (when (or (!= (load pointer) (if (= c 0) (: 78 u8) (: 65 u8)))
                  (!= (load (primitive/index pointer 1))
                      (if (= c 0) (: 73 u8) (: 0 u8)))
                  (!= (load (primitive/index pointer 3)) 0))
          (set! failures (+ failures 1))))
      (set! c (+ c 1)))
    (println "linked symbolic conditional checks: {} failures" failures)
    (if (= failures 0) 0 1)))
