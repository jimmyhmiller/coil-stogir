(module stogir.tests.interval)
(import "stogir.interval" :as r)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(defn split-checks [] (-> i64)
  (let [a (malloc-allocator)
        (mut failures) 0
        (mut cut) 0]
    (while (<= cut 40)
      (let [(mut ranges) (ArrayList::new [r/Range] a)]
        (r/add! (mut ranges) 0 10)
        (r/add! (mut ranges) 20 30)
        (let [(mut suffix) (r/split! (mut ranges) cut a)
              (mut point) 0]
          (while (< point 40)
            (let [(mut before?) false
                  (mut after?) false
                  expected (or (< point 10) (and (>= point 20) (< point 30)))]
              (for range ranges
                (when (and (>= point (.start range)) (< point (.end range)))
                  (set! before? true)))
              (for range suffix
                (when (and (>= point (.start range)) (< point (.end range)))
                  (set! after? true)))
              (when (!= before? (and expected (< point cut)))
                (set! failures (+ failures 1)))
              (when (!= after? (and expected (>= point cut)))
                (set! failures (+ failures 1))))
            (set! point (+ point 1)))
          (free! (mut suffix)))
        (free! (mut ranges)))
      (set! cut (+ cut 1)))
    failures))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut x) (ArrayList::new [r/Range] a)
        (mut y) (ArrayList::new [r/Range] a)
        (mut failures) (split-checks)]
    (r/add! (mut x) 20 30)
    (r/add! (mut x) 0 10)
    (r/add! (mut y) 12 18)
    (when (!= (len x) 2) (set! failures (+ failures 1)))
    (when (!= (r/intersection x y 0) -1) (set! failures (+ failures 1)))
    (r/add! (mut x) 10 20)
    (when (!= (len x) 1) (set! failures (+ failures 1)))
    (when (!= (.start (get x 0)) 0) (set! failures (+ failures 1)))
    (when (!= (.end (get x 0)) 30) (set! failures (+ failures 1)))
    (when (!= (r/intersection x y 15) 15) (set! failures (+ failures 1)))
    (when (!= (r/intersection x y 18) -1) (set! failures (+ failures 1)))
    (when (r/add! (mut x) 5 5) (set! failures (+ failures 1)))
    (when (r/add! (mut x) -1 1) (set! failures (+ failures 1)))
    (free! (mut x))
    (free! (mut y))
    (println "interval checks: {} failures" failures)
    (if (= failures 0) 0 1)))
