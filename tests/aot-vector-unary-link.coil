         [88 56 (fnptr-of entry160)]
         [88 56 (fnptr-of entry161)]
         [37 56 (fnptr-of entry162)]
         [37 56 (fnptr-of entry163)]
         [73 57 (fnptr-of entry164)]
         [73 57 (fnptr-of entry165)]
         [37 57 (fnptr-of entry166)]
         [37 57 (fnptr-of entry167)]))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row EXERCISE-CASES
      (set! failures
            (+ failures
               (exercise (.ty row)
                         (.opcode row)
                         (.mode row)
                         (p/cast (ptr u8) (.address row))))))
    (for row PRESSURE-EXERCISE-CASES
      (set! failures
            (+ failures
               (pressure-exercise (.ty row)
                                  (.opcode row)
                                  (p/cast (ptr u8) (.address row))))))
    (println "linked vector unary operations and full call pressure: {} failures"
             failures)
    (if (= failures 0) 0 1)))
