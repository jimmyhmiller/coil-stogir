(module stogir.tests.aot-vector-unary-link)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "stogir.types" :as types)

(defn pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [i (% (+ lane seed (if right? (: 3 i64) 0)) 11)
        fp? (types/floating? base)
        wide? (= base 12)]
    (if fp?
        (if wide?
            (match i
              (0 (: 0 u64))
              (1 0x8000000000000000)
              (2 0x3FF0000000000000)
              (3 0xBFF0000000000000)
              (4 1)
              (5 0x000FFFFFFFFFFFFF)
              (6 0x7FEFFFFFFFFFFFFF)
              (7 0x7FF0000000000000)
              (8 0xFFF0000000000000)
              (9 0x7FF8123456789ABC)
              (_ 0x7FF0123456789ABC))
            (match i
              (0 (: 0 u64))
              (1 0x80000000)
              (2 0x3F800000)
              (3 0xBF800000)
              (4 1)
              (5 0x007FFFFF)
              (6 0x7F7FFFFF)
              (7 0x7F800000)
              (8 0xFF800000)
              (9 0x7FC12345)
              (_ 0x7F812345)))
        (match i
          (0 (: 0 u64))
          (1 1)
          (2 0xFFFFFFFFFFFFFFFF)
          (3 0x8000000000000000)
          (4 0x7FFFFFFFFFFFFFFF)
          (5 0x8080808080808080)
          (6 0x7F7F7F7F7F7F7F7F)
          (7 0xFFFF0000FFFF0000)
          (8 0x123456789ABCDEF0)
          (9 0xFFFFFFFFFFFFFFFE)
          (_ 0x0102030405060708)))))

(defn input-byte [(base i32) (index i64) (seed i64) (right? bool)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (pattern base (/ index width) seed right?)
              (cast u64 (* (% index width) 8))))))

(defn expected [(opcode i32) (base i32) (bits u64)] (-> u64)
  (let [width (* 8 (types/scalar-size base 8))
        range (<< (: 1 u128) (cast u128 width))
        mask (cast u64 (- range 1))
        sign (cast u64 (>> range 1))
        x (& bits mask)]
    (if (types/floating? base)
        (if (= opcode 31) (^ x sign) (& x (^ mask sign)))
        (cond (= opcode 45) (^ x mask)
              (= opcode 31)
                (cast u64 (& (- range (cast u128 x)) (cast u128 mask)))
              (= opcode 32)
                (if (= (& x sign) 0)
                    x
                    (cast u64 (& (- range (cast u128 x)) (cast u128 mask))))
              (= opcode 54)
                (let [(mut result) (: 0 u64)
                      (mut i) (: 0 i32)]
                  (while (< i (/ width 8))
                    (set! result
                          (| (<< result 8) (& (>> x (cast u64 (* i 8))) 255)))
                    (set! i (+ i 1)))
                  result)
              (= opcode 55)
                (let [(mut count) (: 0 i32)]
                  (while (and (< count width)
                              (= (& (>> x (cast u64 (- width count 1))) 1) 0))
                    (set! count (+ count 1)))
                  (cast u64 count))
              (= opcode 56)
                (let [(mut count) (: 0 i32)]
                  (while (and (< count width)
                              (= (& (>> x (cast u64 count)) 1) 0))
                    (set! count (+ count 1)))
                  (cast u64 count))
              :else
                (let [(mut count) (: 0 u64)
                      (mut i) (: 0 i32)]
                  (while (< i width)
                    (set! count (+ count (& (>> x (cast u64 i)) 1)))
                    (set! i (+ i 1)))
                  count)))))

(defn read-word [(buffer (slice u8)) (offset i64) (width i32)] (-> u64)
  (let [(mut result) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (< i width)
      (set! result
            (| result
               (<< (cast u64 (get buffer (+ offset (cast i64 i))))
                   (cast u64 (* i 8)))))
      (set! i (+ i 1)))
    result))

(defn exercise [(ty i32) (opcode i32) (mode i32) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        base (types/base-type ty)
        width (types/size ty 8)
        element (types/scalar-size base 8)
        lanes (/ width element)
        f (p/cast (fnptr (cc/C) [u64 u64] void) address)
        (mut input) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (clear! (mut input))
      (clear! (mut output))
      (let [(mut i) (: 0 i64)]
        (while (< i 32)
          (push! (mut input) (input-byte base i seed false))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 80) (push! (mut output) 165) (set! i (+ i 1))))
      (call-ptr f (p/cast u64 (.data output)) (p/cast u64 (.data input)))
      (let [(mut lane) (: 0 i32)]
        (while (< lane lanes)
          (let [x
                  (pattern base
                           (cast i64 lane)
                           (if (= mode 1) (if (= width 8) (: 10 i64) 9) seed)
                           false)
                wanted (expected opcode base x)
                got
                  (read-word (slice output)
                             (* (cast i64 lane) (cast i64 element))
                             element)]
            (when (!= got wanted)
              (println "vector unary ty{} op{} mode{} seed{} lane{} got{} expected{}"
                       ty
                       opcode
                       mode
                       seed
                       lane
                       got
                       wanted)
              (set! failures (+ failures 1))))
          (set! lane (+ lane 1))))
      (let [(mut i) (: 0 i64)]
        (while (< i 80)
          (when (>= i (cast i64 width))
            (let [wanted
                    (if (and (!= mode 2)
                             (>= i 24)
                             (< i (+ 24 (cast i64 width))))
                        (input-byte base
                                    (- i 24)
                                    (if (= mode 1)
                                        (if (= width 8) (: 10 i64) 9)
                                        seed)
                                    false)
                        (: 165 u8))]
              (when (!= (get output i) wanted) (set! failures (+ failures 1)))))
          (set! i (+ i 1)))
        (set! i 0)
        (while (< i 32)
          (when (!= (get input i) (input-byte base i seed false))
            (set! failures (+ failures 1)))
          (set! i (+ i 1))))
      (set! seed (+ seed 1)))
    (free! (mut input))
    (free! (mut output))
    failures))

