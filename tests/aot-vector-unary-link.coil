(defstruct PressureExerciseCase
  [(ty i32) (opcode i32) (address (fnptr (cc/C) [u64 u64 u64] u64))])

(def PRESSURE-EXERCISE-CASES
  (table PressureExerciseCase
         [82 31 (fnptr-of entry144)]
         [82 31 (fnptr-of entry145)]
         [88 32 (fnptr-of entry146)]
         [88 32 (fnptr-of entry147)]
         [37 45 (fnptr-of entry148)]
