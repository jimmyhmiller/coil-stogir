(module stogir.tests.jit-call-pressure)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn sum24 :cc (cc/C) [(a i64)
                        (b i64)
                        (c i64)
                        (d i64)
                        (e i64)
                        (f i64)
                        (g i64)
                        (h i64)
                        (i i64)
                        (j i64)
                        (k i64)
                        (l i64)
                        (m i64)
                        (n i64)
                        (o i64)
                        (p i64)
                        (q i64)
                        (r i64)
                        (s i64)
                        (t i64)
                        (u i64)
                        (v i64)
                        (w i64)
                        (x i64)] (-> i64)
  (+ a b c d e f g h i j k l m n o p q r s t u v w x))

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn wrap [(value i64) (ty u8)] (-> i64)
  (if (= ty 11)
      value
      (let [bits (if (= ty 8) (: 8 u64) (: 16 u64))
            modulus (<< (: 1 u64) bits)
            raw (& (cast u64 value) (- modulus 1))]
        (if (>= raw (/ modulus 2))
            (- (cast i64 raw) (cast i64 modulus))
            (cast i64 raw)))))

(defn check [(ty u8) (with-cond? bool)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        address (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        narrow-x
          (if (= ty 11) x (require (b/emit! (mut graph) 35 (cast i32 ty) [x])))
        (mut values) (ArrayList::new [i32] allocator)
        (mut arguments) (ArrayList::new [i32] allocator)
        (mut inputs) (ArrayList::new [i64] allocator)
        (mut types) (ArrayList::new [u8] allocator)
        (mut i) (: 1 i64)
        (mut failures) 0]
    (while (<= i 24)
      (let [constant
              (require (b/scalar-constant! (mut graph)
                                           (cast i32 ty)
                                           (cast u64 i)
                                           8))
            summed
              (require (b/emit! (mut graph)
                                26
                                (cast i32 ty)
                                [narrow-x constant]))
            value
              (if with-cond?
                  (let [difference
                          (require (b/emit! (mut graph)
                                            27
                                            (cast i32 ty)
                                            [narrow-x constant]))]
                    (require (b/conditional! (mut graph)
                                             (cast i32 ty)
                                             x
                                             summed
                                             difference)))
                  summed)
            widened
              (if (= ty 11) value (require (b/emit! (mut graph) 33 11 [value])))]
        (push! (mut values) value)
        (push! (mut arguments) widened)
        (push! (mut types) 11))
      (set! i (+ i 1)))
    (match (calls/create 0 11 (slice types) allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [prototype]
          (let [(mut owned-prototype) prototype
                call
                  (require (calls/emit! (mut graph)
                                        owned-prototype
                                        start
                                        target
                                        (slice arguments)
                                        allocator))
                (mut control) call]
            (set! i 0)
            (while (< i 24)
              (let [offset
                      (require (b/scalar-constant! (mut graph)
                                                   5
                                                   (cast u64 (* i 8))
                                                   8))
                    destination
                      (require (b/emit! (mut graph) 26 6 [address offset]))]
                (set! control
                      (require (b/emit! (mut graph)
                                        93
                                        0
                                        [control destination (get values i)]))))
              (set! i (+ i 1)))
            (let [ret
                    (require (b/emit! (mut graph)
                                      120
                                      11
                                      [control call (: 0 i32)]))]
              (match (compile/text graph start [ret] allocator)
                (Err [msg]
                     (do (println "{}" msg) (set! failures (+ failures 1))))
                (Ok [compiled]
                    (let [(mut code) compiled]
                      (match (jit/map-text (slice code))
                        (Err [msg]
                             (do
                               (println "{}" msg)
                               (set! failures (+ failures 1))))
                        (Ok [image]
                            (let [(mut owned-image) image
                                  f
                                    (primitive/cast (fnptr (cc/C)
                                                           [u64 i64 (ptr i64)]
                                                           i64)
                                                    (.base owned-image))
                                  target
                                    (primitive/cast u64
                                                    (primitive/cast (ptr u8)
                                                                    (fnptr-of sum24)))
                                  (mut cells) (ArrayList::new [i64] allocator)
                                  (mut x) (: -150 i64)]
                              (while (<= x 150)
                                (push! (mut inputs) x)
                                (set! x (+ x 1)))
                              (for edge [(: -32790 i64)
                                         -32769
                                         -32768
                                         -32767
                                         32743
                                         32766
                                         32767
                                         32768
                                         32790]
                                (push! (mut inputs) edge))
                              (set! i 0)
                              (while (< i 24)
                                (push! (mut cells) 0)
                                (set! i (+ i 1)))
                              (for input inputs
                                (let [(mut expected) (: 0 i64)
                                      (mut j) (: 1 i64)]
                                  (while (<= j 24)
                                    (set! expected
                                          (+ expected
                                             (wrap (if (and with-cond?
                                                            (= input 0))
                                                       (- input j)
                                                       (+ input j))
                                                   ty)))
                                    (set! j (+ j 1)))
                                  (let [actual
                                          (call-ptr f
                                                    target
                                                    input
                                                    (elem (mut cells) 0))]
                                    (when (!= actual expected)
                                      (when (= failures 0)
                                        (println "ty={} x={} call expected={} actual={}"
                                                 ty
                                                 input
                                                 expected
                                                 actual))
                                      (set! failures (+ failures 1)))))
                                (set! i 0)
                                (while (< i 24)
                                  (let [expected
                                          (wrap (if (and with-cond? (= input 0))
                                                    (- input (+ i 1))
                                                    (+ input i 1))
                                                ty)
                                        stored
                                          (if (= ty 11)
                                              expected
                                              (cast i64
                                                    (& (cast u64 expected)
                                                       (if (= ty 8)
                                                           (: 255 u64)
                                                           (: 65535 u64)))))]
                                    (when (!= (get cells i) stored)
                                      (when (= failures 0)
                                        (println "ty={} x={} cell={} expected={} actual={}"
                                                 ty
                                                 input
                                                 i
                                                 stored
                                                 (get cells i)))
                                      (set! failures (+ failures 1))))
                                  (set! i (+ i 1))))
                              (free! (mut cells))
                              (when (not (jit/release! (mut owned-image)))
                                (set! failures (+ failures 1))))))
                      (free! (mut code))))))
            (calls/release! (mut owned-prototype)))))
    (free! (mut types))
    (free! (mut arguments))
    (free! (mut inputs))
    (free! (mut values))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (check 11 false)
             (check 8 false)
             (check 9 false)
             (check 11 true)
             (check 8 true)
             (check 9 true))]
    (println "native wide/narrow call pressure checks: {} failures" failures)
    (if (= failures 0) 0 1)))
