(module stogir.tests.jit-block-move)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.a64.compile" :as compile)
(import "stogir.a64.block-move" :as block-move)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.var" :use [var-static])
(import "coil.result" :use [Result Ok Err])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(extern reserve :as "mmap" :cc (cc/C) [(ptr u8) i64 i32 i32 i32 i64] (-> (ptr u8)))
(extern protect :as "mprotect" :cc (cc/C) [(ptr u8) i64 i32] (-> i32))
(extern page-size :as "getpagesize" :cc (cc/C) [] (-> i32))

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))

(defn at [(base (ptr u8)) (offset i64)] (-> (ptr u8))
  (p/cast (ptr u8) (+ (p/cast u64 base) (cast u64 offset))))

(def runtime-calls (var-static i64 0))

;;; The runtime routine a move outside the inline range still calls: memmove
;;; semantics, byte by byte in the direction that preserves the source.
(defn runtime-move :cc (cc/C) [(destination (ptr u8)) (source (ptr u8)) (count u64)] (-> (ptr u8))
  (set runtime-calls (+ (get runtime-calls) 1))
  (if (< (p/cast u64 destination) (p/cast u64 source))
      (let [(mut i) (: 0 i64)]
        (while (< i (cast i64 count))
          (store! (at destination i) (load (at source i)))
          (set! i (+ i 1))))
      (let [(mut i) (- (cast i64 count) 1)]
        (while (>= i 0)
          (store! (at destination i) (load (at source i)))
          (set! i (- i 1)))))
  destination)

(defn pattern [(index i64)] (-> u8)
  (cast u8 (% (+ (* index 37) 19) 251)))

;;; One move of SIZE bytes inside the readable region [base, base+capacity),
;;; which lies between two inaccessible pages: every byte of the region is
;;; compared with a model memmove, so a stray write shows as a difference and a
;;; stray access past either end faults.
(defn case [(f (fnptr (cc/C) [(ptr u8) (ptr u8)] (ptr u8)))
            (base (ptr u8))
            (model (ptr u8))
            (capacity i64)
            (destination i64)
            (source i64)
            (size i64)] (-> i64)
  (let [(mut failures) 0]
    (for [i 0 capacity]
      (store! (at base i) (pattern i))
      (store! (at model i) (pattern i)))
    (for [i 0 size]
      (store! (at model (+ destination i)) (pattern (+ source i))))
    (let [result (call-ptr f (at base destination) (at base source))]
      (when (!= (p/cast u64 result) (p/cast u64 (at base destination)))
        (set! failures (+ failures 1))))
    (for [i 0 capacity]
      (when (!= (load (at base i)) (load (at model i)))
        (set! failures (+ failures 1))))
    failures))

(defn check [(size i64) (base (ptr u8)) (model (ptr u8)) (capacity i64)] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        destination (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        source (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        count (require (b/scalar-constant! (mut graph) 5 (cast u64 size) 8))
        mover (require (symbols/function! (mut graph) "_block_move_runtime" 0))
        (mut failures) 0]
    (match (calls/create-builtin-move 0 a)
      (Err [e] (panic "{}" e))
      (Ok [proto]
        (let [(mut proto) proto
              moved (require (calls/emit! (mut graph) proto start mover
                                          [destination source count] a))
              ret (require (b/emit! (mut graph) 120 6 [moved moved (: 0 i32)]))]
          (calls/release! (mut proto))
          (match (compile/image graph start [ret] "_block_move" a)
            (Err [e] (panic "size {}: {}" size e))
            (Ok [code]
              (let [(mut code) code
                    (mut values) (ArrayList::new [u64] a)
                    (mut found) (ArrayList::new [bool] a)]
                (for symbol (.symbols code)
                  (let [external (image/same-name? code symbol "_block_move_runtime")]
                    (push! (mut values)
                           (if external
                               (p/cast u64 (p/cast (ptr u8) (fnptr-of runtime-move)))
                               0))
                    (push! (mut found) external)))
                (match (jit/map-image-resolved code (slice values) (slice found) a)
                  (Err [e] (panic "size {}: {}" size e))
                  (Ok [mapped]
                    (let [(mut mapped) mapped
                          f (p/cast (fnptr (cc/C) [(ptr u8) (ptr u8)] (ptr u8))
                                    (.base (.memory mapped)))
                          last (- capacity size)
                          before (get runtime-calls)
                          (mut cases) 0]
                      ; Disjoint regions at both ends of the readable region
                      ; and at unaligned addresses.
                      (when (<= (* 2 size) capacity)
                        (set! failures (+ failures (case f base model capacity 0 last size)))
                        (set! failures (+ failures (case f base model capacity last 0 size)))
                        (set! cases (+ cases 2))
                        (for [shift 1 18]
                          (when (<= (+ (* 2 size) (* 2 shift)) capacity)
                            (set! failures
                                  (+ failures (case f base model capacity shift
                                                    (- last (* shift 3)) size)))
                            (set! failures
                                  (+ failures (case f base model capacity (- last shift)
                                                    (+ shift 1) size)))
                            (set! cases (+ cases 2)))))
                      ; Identical regions, then every overlap distance in both
                      ; directions, at an unaligned address and at each end.
                      (set! failures (+ failures (case f base model capacity 3 3 size)))
                      (set! failures (+ failures (case f base model capacity last last size)))
                      (set! cases (+ cases 2))
                      (for [distance 1 (+ size 1)]
                        (when (<= (+ size distance 5) capacity)
                          (set! failures
                                (+ failures (case f base model capacity (+ 5 distance) 5 size)))
                          (set! failures
                                (+ failures (case f base model capacity 5 (+ 5 distance) size)))
                          (set! failures
                                (+ failures (case f base model capacity 0 distance size)))
                          (set! failures
                                (+ failures (case f base model capacity last (- last distance)
                                                  size)))
                          (set! cases (+ cases 4))))
                      ; Exactly the inline range reaches no runtime routine.
                      (let [calls (- (get runtime-calls) before)]
                        (when (!= calls (if (block-move/inline? size) 0 cases))
                          (println "size {}: {} runtime calls in {} moves" size calls cases)
                          (set! failures (+ failures 1))))
                      (jit/release-image! (mut mapped)))))
                (free! (mut values))
                (free! (mut found))
                (image/release! (mut code))))))))
    (g/release! (mut graph))
    (when (> failures 0) (println "size {}: {} failures" size failures))
    failures))

(defn main [] (-> i64)
  (let [page (cast i64 (page-size))
        region (reserve (p/cast (ptr u8) 0) (* 3 page) 0 0x1002 -1 0)
        model (reserve (p/cast (ptr u8) 0) page 3 0x1002 -1 0)
        (mut failures) 0]
    (when (or (= (p/cast i64 region) -1) (= (p/cast i64 model) -1)
              (!= (protect (at region page) page 3) 0))
      (panic "cannot reserve the guarded region"))
    (assert (= (block-move/minimum) 16))
    (assert (= (block-move/maximum) 256))
    ; Every size from empty through both thresholds and beyond.
    (for [size 0 301]
      (set! failures (+ failures (check size (at region page) model page))))
    (for size [(: 511 i64) 512 513 1024 2000]
      (set! failures (+ failures (check size (at region page) model page))))
    (println "native block move checks: {} failures" failures)
    (if (= failures 0) 0 1)))
