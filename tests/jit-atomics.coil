(import "coil.arraylist" :use [ArrayList])
(import "coil.thread" :use [Thread])

(defn mask [(ty i32)] (-> u64)
  (case ty 2 (: 255 u64) 3 65535 4 0xFFFFFFFF 0xFFFFFFFFFFFFFFFF))

(defn width [(ty i32)] (-> i32)
  (case ty 2 1 3 2 4 4 8))

(defn sample [(i i32)] (-> u64)
  (case i
    0 (: 0 u64)
    1 1
    2 255
    3 0x8000000000000000
    4 0xFFFFFFFFFFFFFFFF
    5 0x8000800080000080
    6 0x7FFF7FFF7FFF007F
    7 0x0123456789ABCDEF
    0xFEDCBA9876543210))

(defn updated [(ty i32) (op i32) (old u64) (input u64) (expected u64)] (-> u64)
  (let [m (mask ty)
        x (& input m)
        sign (<< (: 1 u64) (cast u64 (- (* (width ty) 8) 1)))
        sless (< (^ old sign) (^ x sign))]
    (& (case op
         0 (cast u64 (+ (cast u128 old) (cast u128 x)))
         1 (p/isub old x)
         2 (& old x)
         3 (| old x)
         4 (^ old x)
         5 x
         6 (if sless x old)
         7 (if sless old x)
         8 (if (< old x) x old)
         9 (if (< old x) old x)
         10 (if (= old (& expected m)) x old)
         12 x
         old)
       m)))

(defn exercise [(ty i32) (op i32) (preserve bool) (address (ptr u8))] (-> i64)
  (let [f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] u64) address)
        (mut memory) (ArrayList::new [u8] (malloc-allocator))
        (mut output) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0]
    (for [i 0 32]
      (push! (mut memory) (: 165 u8))
      (push! (mut output) (: 165 u8)))
    (for seed [(: 0 i32) 1 2 3 4 5 6 7 8]
      (for input-seed [(: 0 i32) 1 2 3 4 5 6 7 8]
        (for match? [false true]
          (let [old (& (sample seed) (mask ty))
                input (sample input-seed)
                expected (if match? old (^ old 1))
                cell (p/index (.data memory) 8)
                pointer (p/cast u64 cell)]
            (for [i 0 32] (set! (mut memory) i 165) (set! (mut output) i 165))
            (for [i 0 (cast i64 (width ty))]
              (set! (mut memory) (+ i 8) (cast u8 (>> old (* (cast u64 i) 8)))))
            (let [got
                    (call-ptr f
                              pointer
                              input
                              expected
                              (p/cast u64 (.data output)))
                  wanted (if (or (= op 12) (= op 13)) (: 0 u64) old)
                  after (updated ty op old input expected)]
              (when (!= got wanted)
                (println "atomic return ty{} op{} preserve{} seed{} input{} match{}: {} != {}"
                         ty
                         op
                         preserve
                         seed
                         input-seed
                         match?
                         got
                         wanted)
                (set! failures (+ failures 1)))
              (for [i 0 32]
                (let [byte
                        (if (and (>= i 8) (< i (+ 8 (cast i64 (width ty)))))
                            (cast u8 (>> after (* (cast u64 (- i 8)) 8)))
                            (: 165 u8))
                      output-byte
                        (if (and preserve (< i 24))
                            (let [bits (case (/ i 8) 0 input 1 expected pointer)]
                              (cast u8 (>> bits (* (cast u64 (% i 8)) 8))))
                            (: 165 u8))]
                  (when (or (!= (get memory i) byte)
                            (!= (get output i) output-byte))
                    (println "atomic bytes ty{} op{} preserve{} byte{}"
                             ty
                             op
                             preserve
                             i)
                    (set! failures (+ failures 1))))))))))
    (free! (mut memory))
    (free! (mut output))
    failures))

(defstruct AtomicWork
  [(function (fnptr (cc/C) [u64 u64 u64 u64] u64)) (cell (ptr u64)) (sum u64)])

(defn worker :cc (cc/C) [(arg (ptr i8))] (-> (ptr i8))
  (let [work (p/cast (ptr AtomicWork) arg)
        (mut sum) (: 0 u64)]
    (for [i 0 10000]
      (set! sum
            (+ sum (call-ptr (.function work) (p/cast u64 (.cell work)) 1 0 0))))
    (set! (.sum work) sum)
    (p/cast (ptr i8) 0)))

(defn contention [(address (ptr u8))] (-> i64)
  (let [f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] u64) address)
        (mut counter) (: 0 u64)
        (mut jobs) (ArrayList::new [AtomicWork] (malloc-allocator))
        (mut threads) (ArrayList::new [Thread] (malloc-allocator))
        (mut started) (ArrayList::new [bool] (malloc-allocator))
        (mut failures) 0
        (mut sum) (: 0 u64)]
    (for [i 0 4]
      (push! (mut jobs)
             (AtomicWork
               :function f
               :cell (p/cast (ptr u64) (mut counter))
               :sum 0))
      (push! (mut threads) (zeroed Thread))
      (push! (mut started) false))
    (let [body (: (fnptr-of worker) (fnptr (cc/C) [(ptr i8)] (ptr i8)))]
      (for [i 0 4]
        (let [rc
                (Thread::spawn (p/cast (ptr Thread) (elem (mut threads) i))
                               body
                               (p/cast (ptr i8) (elem (mut jobs) i)))]
          (if (= rc 0)
              (set! (mut started) i true)
              (set! failures (+ failures 1))))))
    (for [i 0 4]
      (when (get started i)
        (when (!= (Thread::join (p/cast (ptr Thread) (elem (mut threads) i))) 0)
          (set! failures (+ failures 1))))
      (set! sum (+ sum (.sum (get jobs i)))))
    (when (or (!= counter 40000) (!= sum 799980000))
      (println "atomic contention count{} sum{}" counter sum)
      (set! failures (+ failures 1)))
    (free! (mut jobs))
    (free! (mut threads))
    (free! (mut started))
    failures))

