(module stogir.tests.shrink-wrap)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.symbols" :as symbols)
(import "stogir.options" :as options)
(import "stogir.link" :as link)
(import "stogir.image" :as image)
(import "stogir.bytes" :as bytes)
(import "stogir.a64.compile" :as compile)
(import "stogir.a64.private-leaf" :as private)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator Allocator])
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

(defn slow-model [(x i64)] (-> i64) (* x 3))

;;; Shapes: 0 = fast RETURN in the region, slow RETURN after a call;
;;; 1 = both paths END into a MERGE that needs the frame (END crossing);
;;; 2 = a counted loop on the fast path, the call in the slow path;
;;; 3 = SWITCH: case 0 and default return directly, case 1 calls;
;;; 4 = an entry ALLOCA whose address only the slow path uses (store, reload,
;;; then call), so the fast path stays frameless;
;;; 5 = both paths END into a MERGE that only returns its PHI: a shared return
;;; tail the fast path emits in place without the frame (the slow path adds to
;;; its call's result, so the call is not in tail position and keeps the frame);
;;; 6 = nested merges as slice equality lowers: the fast inner path reaches the
;;; shared tail only through an inner MERGE that the call path also enters, so
;;; it must build the frame on that edge and return through the epilogue.
(defn model [(shape i32) (x i64)] (-> i64)
  (cond (= shape 0) (if (< x 100) (+ x 1) (+ (slow-model x) x))
        (= shape 1) (+ (if (< x 100) (+ x 1) (slow-model x)) x)
        (= shape 2) (if (< x 100)
                        (let [(mut sum) (: 0 i64)]
                          (for [i 0 x] (set! sum (+ sum i)))
                          sum)
                        (+ (slow-model x) 1))
        (= shape 3) (cond (= x 0) 7 (= x 1) (+ (slow-model x) 5) :else (+ x 2))
        (= shape 5) (if (< x 100) (+ x 1) (+ (slow-model x) 1))
        (= shape 6) (if (< x 100) (if (= x 7) 1 (+ (slow-model x) 1)) 0)
        :else (if (< x 100) (+ x 1) (+ (slow-model (+ x 4)) 1))))

(defn slow-graph [(a (dyn Allocator))] (-> g/Graph)
  (let [(mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        three (require (b/scalar-constant! (mut graph) 11 3 8))
        product (require (b/emit! (mut graph) 28 11 [x three]))
        (mut signature) (match (calls/create 0 11 [(: 11 u8)] a)
                          (Err [message] (panic "{}" message)) (Ok [s] s))]
    (require (calls/function! (mut graph) signature a))
    (require (b/emit! (mut graph) 120 11 [start product (: 0 i32)]))
    (calls/release! (mut signature))
    graph))

(defn slow-call! [(graph (mut g/Graph)) (control i32) (x i32) (a (dyn Allocator))] (-> i32)
  (let [(mut signature) (match (calls/create 0 11 [(: 11 u8)] a)
                          (Err [message] (panic "{}" message)) (Ok [s] s))
        target (require (symbols/function! (mut graph) "_sw_slow" 0))
        call (require (calls/emit! (mut graph) signature control target [x] a))]
    (calls/release! (mut signature))
    call))

;;; Builds the entry graph for SHAPE; returns it with its START and roots.
(defn entry-graph [(shape i32) (a (dyn Allocator))] (-> g/Graph)
  (let [(mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        (mut signature) (match (calls/create 0 11 [(: 11 u8)] a)
                          (Err [message] (panic "{}" message)) (Ok [s] s))]
    (require (calls/function! (mut graph) signature a))
    (calls/release! (mut signature))
    (cond
      (= shape 3)
        (let [zero (require (b/scalar-constant! (mut graph) 11 0 8))
              one (require (b/scalar-constant! (mut graph) 11 1 8))
              two (require (b/scalar-constant! (mut graph) 11 2 8))
              five (require (b/scalar-constant! (mut graph) 11 5 8))
              seven (require (b/scalar-constant! (mut graph) 11 7 8))
              dispatch (require (b/emit! (mut graph) 117 0 [start x]))
              case0 (require (b/emit! (mut graph) 109 0 [dispatch zero (: 0 i32)]))
              case1 (require (b/emit! (mut graph) 109 0 [dispatch one (: 0 i32)]))
              other (require (b/emit! (mut graph) 111 0 [dispatch (: 0 i32)]))
              called (slow-call! (mut graph) case1 x a)
              plus5 (require (b/emit! (mut graph) 26 11 [called five]))
              plus2 (require (b/emit! (mut graph) 26 11 [x two]))]
          (require (b/emit! (mut graph) 120 11 [case0 seven (: 0 i32)]))
          (require (b/emit! (mut graph) 120 11 [called plus5 (: 0 i32)]))
          (require (b/emit! (mut graph) 120 11 [other plus2 (: 0 i32)]))
          graph)
      (= shape 4)
        (let [sixteen (require (b/scalar-constant! (mut graph) 5 16 8))
              object (require (b/frame-object! (mut graph) start sixteen (: 8 i32)))
              hundred (require (b/scalar-constant! (mut graph) 11 100 8))
              one (require (b/scalar-constant! (mut graph) 11 1 8))
              four (require (b/scalar-constant! (mut graph) 11 4 8))
              condition (require (b/emit! (mut graph) 16 1 [x hundred]))
              split (require (b/emit! (mut graph) 116 0 [object condition]))
              fast (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
              slow (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
              plus (require (b/emit! (mut graph) 26 11 [x one]))
              shifted (require (b/emit! (mut graph) 26 11 [x four]))
              stored (require (b/emit! (mut graph) 93 0 [slow object shifted]))
              loaded (require (b/emit! (mut graph) 91 11 [stored object]))
              called (slow-call! (mut graph) loaded loaded a)
              total (require (b/emit! (mut graph) 26 11 [called one]))]
          (require (b/emit! (mut graph) 120 11 [fast plus (: 0 i32)]))
          (require (b/emit! (mut graph) 120 11 [called total (: 0 i32)]))
          graph)
      :else
        (let [hundred (require (b/scalar-constant! (mut graph) 11 100 8))
              one (require (b/scalar-constant! (mut graph) 11 1 8))
              condition (require (b/emit! (mut graph) 16 1 [x hundred]))
              split (require (b/emit! (mut graph) 116 0 [start condition]))
              fast (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
              slow (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))]
          (cond
            (= shape 0)
              (let [plus (require (b/emit! (mut graph) 26 11 [x one]))
                    called (slow-call! (mut graph) slow x a)
                    sum (require (b/emit! (mut graph) 26 11 [called x]))]
                (require (b/emit! (mut graph) 120 11 [fast plus (: 0 i32)]))
                (require (b/emit! (mut graph) 120 11 [called sum (: 0 i32)]))
                graph)
            (= shape 6)
              (let [seven (require (b/scalar-constant! (mut graph) 11 7 8))
                    zero (require (b/scalar-constant! (mut graph) 11 0 8))
                    same (require (b/emit! (mut graph) 14 1 [x seven]))
                    inner (require (b/emit! (mut graph) 116 0 [fast same]))
                    hit (require (b/emit! (mut graph) 107 0 [inner (: 0 i32)]))
                    miss (require (b/emit! (mut graph) 108 0 [inner (: 0 i32)]))
                    called (slow-call! (mut graph) miss x a)
                    total (require (b/emit! (mut graph) 26 11 [called one]))
                    hit-end (require (b/emit! (mut graph) 114 0 [hit]))
                    miss-end (require (b/emit! (mut graph) 114 0 [called]))
                    joined (require (b/emit! (mut graph) 112 0 [hit-end miss-end]))
                    partial (require (b/emit! (mut graph) 67 11 [joined one total]))
                    joined-end (require (b/emit! (mut graph) 114 0 [joined]))
                    slow-end (require (b/emit! (mut graph) 114 0 [slow]))
                    outer (require (b/emit! (mut graph) 112 0 [joined-end slow-end]))
                    value (require (b/emit! (mut graph) 67 11 [outer partial zero]))]
                (require (b/emit! (mut graph) 120 11 [outer value (: 0 i32)]))
                graph)
            (= shape 5)
              (let [plus (require (b/emit! (mut graph) 26 11 [x one]))
                    called (slow-call! (mut graph) slow x a)
                    total (require (b/emit! (mut graph) 26 11 [called one]))
                    fast-end (require (b/emit! (mut graph) 114 0 [fast]))
                    slow-end (require (b/emit! (mut graph) 114 0 [called]))
                    join (require (b/emit! (mut graph) 112 0 [fast-end slow-end]))
                    value (require (b/emit! (mut graph) 67 11 [join plus total]))]
                (require (b/emit! (mut graph) 120 11 [join value (: 0 i32)]))
                graph)
            (= shape 1)
              (let [plus (require (b/emit! (mut graph) 26 11 [x one]))
                    called (slow-call! (mut graph) slow x a)
                    fast-end (require (b/emit! (mut graph) 114 0 [fast]))
                    slow-end (require (b/emit! (mut graph) 114 0 [called]))
                    join (require (b/emit! (mut graph) 112 0 [fast-end slow-end]))
                    value (require (b/emit! (mut graph) 67 11 [join plus called]))
                    total (require (b/emit! (mut graph) 26 11 [value x]))]
                (require (b/emit! (mut graph) 120 11 [join total (: 0 i32)]))
                graph)
            :else
              (let [zero (require (b/scalar-constant! (mut graph) 11 0 8))
                    enter (require (b/emit! (mut graph) 114 0 [fast]))
                    loop (require (b/loop-begin! (mut graph) enter))
                    index (require (b/loop-phi! (mut graph) loop zero))
                    sum (require (b/loop-phi! (mut graph) loop zero))
                    more (require (b/emit! (mut graph) 16 1 [index x]))
                    test (require (b/emit! (mut graph) 116 0 [loop more]))
                    body (require (b/emit! (mut graph) 107 0 [test (: 0 i32)]))
                    done (require (b/emit! (mut graph) 108 0 [test (: 0 i32)]))
                    next-sum (require (b/emit! (mut graph) 26 11 [sum index]))
                    next-index (require (b/emit! (mut graph) 26 11 [index one]))
                    back (require (b/emit! (mut graph) 115 0 [body]))
                    called (slow-call! (mut graph) slow x a)
                    plus (require (b/emit! (mut graph) 26 11 [called one]))]
                (require (b/patch! (mut graph) loop 2 back))
                (require (b/patch! (mut graph) index 3 next-index))
                (require (b/patch! (mut graph) sum 3 next-sum))
                (require (b/emit! (mut graph) 120 11 [done sum (: 0 i32)]))
                (require (b/emit! (mut graph) 120 11 [called plus (: 0 i32)]))
                graph))))))

;;; RETURN references of GRAPH, in order.
(defn returns [(graph g/Graph) (a (dyn Allocator))] (-> (coil.arraylist.ArrayList i32))
  (let [(mut roots) (coil.arraylist.ArrayList::new [i32] a)
        (mut r) (: 1 i64)]
    (while (< r (len (.instructions graph)))
      (when (= (cast i32 (& (.header (get (.instructions graph) r)) 255)) 120)
        (push! (mut roots) (cast i32 r)))
      (set! r (+ r (/ (+ (cast i64 (get (.arities graph) r)) 4) 4))))
    roots))

(defn compiled [(graph g/Graph) (roots (slice i32)) (name (slice u8)) (shrink bool)
                (retry bool) (a (dyn Allocator))] (-> image/Image)
  (match (compile/image-with-private graph 1 roots name (options/Options :level 1) a
                                     (private/with-shrink-retry
                                       (private/with-shrink-wrap (private/no-context) shrink)
                                       retry))
    (Ok [code] code)
    (Err [message] (panic "compile {}: {}" name message))))

;;; First instruction word of NAME in IMAGE.
(defn first-word [(source image/Image) (name (slice u8))] (-> u32)
  (match (image/find-symbol source name)
    (None [] (panic "missing symbol {}" name))
    (Some [id]
          (let [offset (.offset (get (.symbols source) (cast i64 id)))
                text (.text source)]
            (| (cast u32 (get text offset))
               (<< (cast u32 (get text (+ offset 1))) 8)
               (<< (cast u32 (get text (+ offset 2))) 16)
               (<< (cast u32 (get text (+ offset 3))) 24))))))

;;; Instruction word at byte offset OFFSET of TEXT.
(defn word-at [(text (coil.arraylist.ArrayList u8)) (offset i64)] (-> u32)
  (| (cast u32 (get text offset))
     (<< (cast u32 (get text (+ offset 1))) 8)
     (<< (cast u32 (get text (+ offset 2))) 16)
     (<< (cast u32 (get text (+ offset 3))) 24)))

(defn signed [(value u32) (bits u32)] (-> i64)
  (let [shift (- (: 64 u32) bits)]
    (>> (<< (cast i64 value) (cast i64 shift)) (cast i64 shift))))

;;; Walks NAME's machine code from its entry along every branch, tracking
;;; whether the frame is built (0 = entry state). Counts a RET with the frame,
;;; a frame release or call without it, and joins reached in both states.
;;; Indirect jumps and BRK end a path.
(defn frame-faults [(source image/Image) (name (slice u8))] (-> i64)
  (match (image/find-symbol source name)
    (None [] (panic "missing symbol {}" name))
    (Some [id]
          (let [a (malloc-allocator)
                base (.offset (get (.symbols source) (cast i64 id)))
                text (.text source)
                limit (len text)
                (mut seen) (coil.arraylist.ArrayList::new [i8] a)
                (mut work) (coil.arraylist.ArrayList::new [i64] a)
                (mut faults) (: 0 i64)]
            (for [i 0 limit] (push! (mut seen) (: -1 i8)))
            (push! (mut work) (* base 2))
            (while (> (len work) 0)
              (let [item (get work (- (len work) 1))
                    _ (pop! (mut work))
                    (mut at) (/ item 2)
                    (mut state) (% item 2)
                    (mut going) true]
                (while (and going (>= at 0) (< (+ at 3) limit))
                  (let [previous (get seen at)]
                    (if (>= previous 0)
                        (do (when (!= (cast i64 previous) state) (set! faults (+ faults 1)))
                            (set! going false))
                        (let [w (word-at text at)]
                          (set! (mut seen) at (cast i8 state))
                          (cond
                            (or (= (& w 0xFFC07FFF) 0xA9807BFD) (= (& w 0xFF8003FF) 0xD10003FF))
                              (do (when (= state 1) (set! faults (+ faults 1))) (set! state 1)
                                  (set! at (+ at 4)))
                            (or (= (& w 0xFFC07FFF) 0xA8C07BFD) (= (& w 0xFF8003FF) 0x910003FF))
                              (do (when (= state 0) (set! faults (+ faults 1))) (set! state 0)
                                  (set! at (+ at 4)))
                            (= w 0xD65F03C0)
                              (do (when (= state 1) (set! faults (+ faults 1))) (set! going false))
                            (or (= (& w 0xFC000000) 0x94000000) (= (& w 0xFFFFFC1F) 0xD63F0000))
                              (do (when (= state 0) (set! faults (+ faults 1))) (set! at (+ at 4)))
                            (or (= (& w 0xFFFFFC1F) 0xD61F0000) (= (& w 0xFFE0001F) 0xD4200000))
                              (set! going false)
                            (= (& w 0xFC000000) 0x14000000)
                              (set! at (+ at (* 4 (signed (& w 0x3FFFFFF) 26))))
                            (or (= (& w 0xFF000010) 0x54000000) (= (& w 0x7E000000) 0x34000000))
                              (do (push! (mut work) (+ (* (+ at (* 4 (signed (& (>> w 5) 0x7FFFF) 19))) 2) state))
                                  (set! at (+ at 4)))
                            (= (& w 0x7E000000) 0x36000000)
                              (do (push! (mut work) (+ (* (+ at (* 4 (signed (& (>> w 5) 0x3FFF) 14))) 2) state))
                                  (set! at (+ at 4)))
                            :else (set! at (+ at 4)))))))))
            (free! (mut seen)) (free! (mut work))
            faults))))

;;; STP x29, x30, [sp, #-n]! or SUB sp, sp, #n: the frame built at entry.
(defn frame-entry? [(word u32)] (-> bool)
  (or (= (& word 0xFFC07FFF) 0xA9807BFD)
      (= (& word 0xFF8003FF) 0xD10003FF)))

(defn check-shape [(shape i32)] (-> i64)
  (let [a (malloc-allocator) (mut failures) (: 0 i64)
        (mut slow) (slow-graph a)]
    ; Without shrink-wrapping, with it, and with its second allocation.
    (for mode [(: 0 i32) 1 2]
      (let [shrink (> mode 0)
            (mut graph) (entry-graph shape a)
            (mut roots) (returns graph a)
            (mut code) (compiled graph (slice roots) "_sw_entry" shrink (= mode 2) a)
            (mut slow-roots) (returns slow a)
            (mut leaf) (match (compile/image slow 1 (slice slow-roots) "_sw_slow" a)
                         (Ok [c] c) (Err [message] (panic "slow: {}" message)))
            word (first-word code "_sw_entry")]
        ; Shapes 0, 2 and 3 have a RETURN reachable without the frame.
        (when (and shrink (!= shape 1) (frame-entry? word))
          (println "shape {} mode {}: shrink-wrapped entry still builds the frame (0x{:x})" shape mode word)
          (set! failures (+ failures 1)))
        (let [faults (frame-faults code "_sw_entry")]
          (when (> faults 0)
            (println "shape {} mode {}: {} frame-state faults" shape mode faults)
            (set! failures (+ failures faults))))
        (when (and (not shrink) (not (frame-entry? word)))
          (println "shape {}: reference entry has no frame (0x{:x})" shape word)
          (set! failures (+ failures 1)))
        (match (link/compose [code leaf] a)
          (Err [message] (panic "compose: {}" message))
          (Ok [module]
              (let [(mut module) module]
                (match (jit/map-image (.image module) a)
                  (Err [message] (panic "map: {}" message))
                  (Ok [loaded]
                      (let [(mut loaded) loaded
                            index (match (image/find-symbol (.image module) "_sw_entry")
                                    (Some [id] id) (None [] (panic "entry symbol")))
                            function (primitive/cast (fnptr (cc/C) [i64] i64)
                                       (primitive/cast (ptr u8)
                                         (get (.addresses loaded) (cast i64 index))))]
                        (for x [(: 0 i64) 1 2 5 99 100 101 1000 -7]
                          (let [got (function x) want (model shape x)]
                            (unless (= got want)
                              (println "shape {} mode {} x {}: got {} want {}" shape mode x got want)
                              (set! failures (+ failures 1)))))
                        (jit/release-image! (mut loaded)))))
                (link/release! (mut module)))))
        (image/release! (mut code)) (image/release! (mut leaf))
        (free! (mut roots)) (free! (mut slow-roots)) (g/release! (mut graph))))
    (g/release! (mut slow))
    failures))

(defn main [] (-> i32)
  (let [(mut failures) (: 0 i64)]
    (for shape [(: 0 i32) 1 2 3 4 5 6]
      (set! failures (+ failures (check-shape shape))))
    (println "shrink-wrap: {} failures" failures)
    (if (= failures 0) 0 1)))
