(module stogir.tests.jit-rematerialized-transfers)
(import "stogir.locations" :as loc)
(import "stogir.a64.transfers" :as transfers)
(import "stogir.a64.typed-transfers" :as typed)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.a64.frame-memory" :as memory)
(import "stogir.a64.encode" :as e)
(import "stogir.a64.constants" :as constants)
(import "stogir.bytes" :as bytes)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn checked [(r (Result i32 (slice u8)))] (-> void)
  (match r (Ok [_] 0) (Err [message] (panic "{}" message))))
(defn word! [(out (mut (ArrayList u8))) (r (Result u32 (slice u8)))] (-> void)
  (match r (Ok [word] (bytes/append32! (mut out) word)) (Err [e] (panic "{}" e))))
(defn reg [(r i64)] (-> loc/Location) (loc/Location :kind 0 :value r))
(defn slot [(n i64)] (-> loc/Location) (loc/Location :kind 1 :value n))
(defn addr [(base frame/Base) (n i64)] (-> loc/Location)
  (loc/Location :kind (if (= (.reg base) 29) 2 3) :value n))
(defn copy [(source loc/Location) (destination loc/Location) (size i32)] (-> typed/Copy)
  (typed/Copy :size size :transfer (loc/Transfer :position 0 :parent 0
                                               :source source :destination destination)))
(defn equals! [(out (mut (ArrayList u8))) (a i32) (b i32)] (-> void)
  (word! (mut out) (e/add-sub true true true 31 a b))
  (word! (mut out) (e/conditional-set false 12 0))
  (word! (mut out) (e/logical-register false 0 11 11 12)))

(defn run [(anchored bool) (bias i64) (reverse bool) (mixed bool)] (-> void)
  (let [a (malloc-allocator)
        base (frame/Base :reg (if anchored 29 31) :bias bias :call-area 0)
        (mut text) (ArrayList::new [u8] a)
        (mut copies) (ArrayList::new [typed/Copy] a)
        (mut ordered) (ArrayList::new [typed/Copy] a)
        (mut ordinary) (ArrayList::new [loc/Transfer] a)]
    (checked (frame/adjust! (mut text) true 66048 16))
    (word! (mut text) (e/load-store false 8 29 31 0))
    (word! (mut text) (e/load-store false 8 30 31 8))
    (when anchored (checked (frame/address! (mut text) 29 31 bias)))
    ; SP is not an ordinary second register operand. Capture the base first.
    (word! (mut text) (e/add-sub-immediate true false false 9 (.reg base) 0))
    (word! (mut text) (e/logical-register true 1 10 31 0))
    (checked (memory/access! (mut text) false 8 0 (.reg base) 64 false 16))
    (checked (constants/emit! (mut text) true 4 0x1234))
    (checked (constants/emit! (mut text) true 5 0x5678))
    (checked (constants/emit! (mut text) true 6 0xAAAA12345678))
    (when anchored (checked (frame/adjust! (mut text) true 256 16)))
    (for c [(copy (addr base 64) (reg 0) 8)
            (copy (reg 0) (reg 1) 8)
            (copy (slot (+ bias 64)) (reg 2) 8)
            (copy (addr base 65536) (slot (+ bias 128)) 8)
            (copy (reg 4) (reg 5) 8)
            (copy (reg 5) (reg 4) 8)
            (copy (addr base 64) (reg 32) 8)]
      (push! (mut copies) c))
    (when mixed (push! (mut copies) (copy (reg 6) (reg 33) 4)))
    (for [i 0 (len copies)]
      (push! (mut ordered) (get copies (if reverse (- (len copies) 1 i) i))))
    (word! (mut text) (e/add-sub true true true 31 10 10))
    (if mixed
        (checked (typed/parallel-frame! (mut text) (slice ordered) a base))
        (do
          (for c ordered (push! (mut ordinary) (.transfer c)))
          (checked (transfers/parallel-frame! (mut text) (slice ordinary) 8 a base))))
    (checked (constants/emit! (mut text) false 11 1))
    (word! (mut text) (e/conditional-set false 12 0))
    (word! (mut text) (e/logical-register false 0 11 11 12))
    (equals! (mut text) 1 10)
    (equals! (mut text) 2 10)
    (word! (mut text) (e/add-sub true true false 14 0 9))
    (checked (constants/emit! (mut text) true 13 64))
    (equals! (mut text) 14 13)
    (checked (memory/access! (mut text) true 8 7 (.reg base) 128 false 16))
    (word! (mut text) (e/add-sub true true false 14 7 9))
    (checked (constants/emit! (mut text) true 13 65536))
    (equals! (mut text) 14 13)
    (checked (constants/emit! (mut text) true 13 0x5678))
    (equals! (mut text) 4 13)
    (checked (constants/emit! (mut text) true 13 0x1234))
    (equals! (mut text) 5 13)
    (word! (mut text) (e/scalar-transfer true false 8 0))
    (word! (mut text) (e/add-sub true true false 14 8 9))
    (checked (constants/emit! (mut text) true 13 64))
    (equals! (mut text) 14 13)
    (when mixed
      (word! (mut text) (e/scalar-transfer false false 8 1))
      (checked (constants/emit! (mut text) true 13 0x12345678))
      (equals! (mut text) 8 13))
    (word! (mut text) (e/logical-register false 1 0 31 11))
    (checked (frame/restore! (mut text) base))
    (word! (mut text) (e/load-store true 8 29 31 0))
    (word! (mut text) (e/load-store true 8 30 31 8))
    (checked (frame/adjust! (mut text) false 66048 16))
    (word! (mut text) (e/ret 30))
    (match (jit/map-text (slice text))
      (Err [message] (panic "{}" message))
      (Ok [mapped]
          (let [(mut mapped) mapped
                f (p/cast (fnptr (cc/C) [u64] u64) (.base mapped))]
            (for x [(: 0 u64) 1 16 0xDEADBEEF 0x123456789ABCDEF0 0xFFFFFFFFFFFFFFFF]
              (assert (= (f x) 1)))
            (jit/release! (mut mapped)))))
    (free! (mut ordinary)) (free! (mut ordered)) (free! (mut copies)) (free! (mut text))))

(defn main [] (-> i64)
  (for anchored [false true]
    (for bias [(: 0 i64) 128]
      (when (or anchored (= bias 0))
        (for reverse [false true]
          (for mixed [false true] (run anchored bias reverse mixed))))))
  (let [a (malloc-allocator) (mut text) (ArrayList::new [u8] a)
        base (frame/stack-base)]
    (push! (mut text) 0xA5)
    (for result [(transfers/emit-at! (mut text) (loc/Location :kind 2 :value 64) (reg 0) 8 17 base)
                 (transfers/emit-at! (mut text) (addr base -1) (reg 0) 8 17 base)
                 (transfers/emit-at! (mut text) (reg 0) (addr base 64) 8 17 base)
                 (transfers/emit-at! (mut text) (addr base 64) (reg 0) 4 17 base)
                 (transfers/emit-at! (mut text) (addr base 64) (reg 0) 16 17 base)
                 (typed/parallel-frame! (mut text)
                   [(copy (reg 0) (addr base 64) 8)] a base)
                 (typed/parallel-frame! (mut text)
                   [(copy (addr base 64) (reg 1) 8) (copy (reg 0) (reg 1) 8)] a base)]
      (match result (Err [_] 0) (Ok [_] (panic "invalid rematerialized transfer accepted"))))
    (assert (= (len text) 1))
    (assert (= (get text 0) 0xA5))
    (free! (mut text)))
  (println "read-only frame address transfers: SP/FP, large offsets, alias identities, cycles and mixed widths pass")
  0)
