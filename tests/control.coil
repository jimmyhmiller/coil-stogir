(module stogir.tests.control)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as v)
(import "stogir.opcode" :as op)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        param (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        end (require (b/emit! (mut graph) 114 0 [start]))
        (mut failures) 0]
    (when (not (op/block-start? 104)) (set! failures (+ failures 1)))
    (when (not (op/block-end? 114)) (set! failures (+ failures 1)))
    (when (not (op/terminator? 120)) (set! failures (+ failures 1)))
    (when (op/control? 26) (set! failures (+ failures 1)))
    (match (v/control-sources graph)
      (Ok [_] 0)
      (Err [_] (set! failures (+ failures 1))))
    (b/patch! (mut graph) end 1 param)
    (match (v/control-sources graph)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    (println "control checks: {} failures" failures)
    (if (= failures 0) 0 1)))
