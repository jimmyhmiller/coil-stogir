(module stogir.tests.constants)
(import "stogir.graph" :as g)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Some None])

(defn intern [(graph (mut g/Graph)) (ty u8) (bits u64)] (-> i32)
  (match (g/intern-scalar! (mut graph) ty bits)
    (Some [r] r)
    (None [] 0)))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        a (intern (mut graph) 11 0)
        b (intern (mut graph) 12 0x0700000000000000)
        positive-zero (intern (mut graph) 12 0)
        negative-zero (intern (mut graph) 12 0x8000000000000000)
        nan (intern (mut graph) 12 0x7FF8000000000042)
        other-nan (intern (mut graph) 12 0x7FF8000000000043)
        (mut failures) 0]
    (when (= a b) (set! failures (+ failures 1)))
    (when (!= a (intern (mut graph) 11 0)) (set! failures (+ failures 1)))
    (when (!= b (intern (mut graph) 12 0x0700000000000000))
      (set! failures (+ failures 1)))
    (when (= positive-zero negative-zero) (set! failures (+ failures 1)))
    (when (= nan other-nan) (set! failures (+ failures 1)))
    (when (!= nan (intern (mut graph) 12 0x7FF8000000000042))
      (set! failures (+ failures 1)))
    (when (!= (len (.constants graph)) 6) (set! failures (+ failures 1)))
    (g/release! (mut graph))
    (println "constant checks: {} failures" failures)
    (if (= failures 0) 0 1)))
