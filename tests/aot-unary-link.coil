(module stogir.tests.aot-unary-link)
(import "coil.cc" :as cc)

(extern narrow8 :as "stogir_unary_i8" :cc (cc/C) [i8] (-> u64))

(extern narrow16 :as "stogir_unary_i16" :cc (cc/C) [i16] (-> u64))

(extern narrow32 :as "stogir_unary_i32" :cc (cc/C) [i32] (-> u64))

(extern signed64 :as "stogir_unary_i64" :cc (cc/C) [i64] (-> i64))

(extern unsigned64 :as "stogir_unary_u64" :cc (cc/C) [u64] (-> u64))

(defstruct Case
  [(input u64)
   (i8-result u64)
   (i16-result u64)
   (i32-result u64)
   (i64-result u64)
   (u64-result u64)])

;;; XOR of every applicable unary result; narrow results are zero-extended.
;;; Inputs have nonzero low bytes, so CLZ/CTZ stay inside their defined domain.
(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row [(Case
                :input 0x1
                :i8-result 0x6
                :i16-result 0x10E
                :i32-result 0x100001E
                :i64-result 0x10000000000003E
                :u64-result 0x10000000000003F)
              (Case
                :input 0x2
                :i8-result 0x7
                :i16-result 0x20F
                :i32-result 0x200001F
                :i64-result 0x20000000000003F
                :u64-result 0x20000000000003D)
              (Case
                :input 0x3
                :i8-result 0x6
                :i16-result 0x30E
                :i32-result 0x300001E
                :i64-result 0x30000000000003E
                :u64-result 0x30000000000003D)
              (Case
                :input 0x7
                :i8-result 0x0
                :i16-result 0x708
                :i32-result 0x7000018
                :i64-result 0x700000000000038
                :u64-result 0x70000000000003F)
              (Case
                :input 0x7F
                :i8-result 0x78
                :i16-result 0x7F70
                :i32-result 0x7F000060
                :i64-result 0x7F00000000000040
                :u64-result 0x7F0000000000003F)
              (Case
                :input 0x80
                :i8-result 0x79
                :i16-result 0x8071
                :i32-result 0x80000061
                :i64-result 0x8000000000000041
                :u64-result 0x80000000000000C1)
              (Case
                :input 0xFF
                :i8-result 0x8
                :i16-result 0xFFFE
                :i32-result 0xFF0000EE
                :i64-result 0xFF000000000000CE
                :u64-result 0xFF00000000000031)
              (Case
                :input 0x8080
                :i8-result 0x79
                :i16-result 0xFFFA
                :i32-result 0x8080806A
                :i64-result 0x808000000000804A
                :u64-result 0x80800000000000CA)
              (Case
                :input 0x80000080
                :i8-result 0x79
                :i16-result 0x8071
                :i32-result 0xFFFFFFFA
                :i64-result 0x800000808000005A
                :u64-result 0x80000080000000DA)
              (Case
                :input 0x8000000000000080
                :i8-result 0x79
                :i16-result 0x8071
                :i32-result 0x80000061
                :i64-result 0xFFFFFFFFFFFFFFFA
                :u64-result 0x800000000000007A)
              (Case
                :input 0x7FFFFFFFFFFFFFFF
                :i8-result 0x8
                :i16-result 0xFFEF
                :i32-result 0xFFFFFFDF
                :i64-result 0x80000000000000BF
                :u64-result 0xFFFFFFFFFFFFFF40)
              (Case
                :input 0xFFFFFFFFFFFFFFFF
                :i8-result 0x8
                :i16-result 0xFFEF
                :i32-result 0xFFFFFFDF
                :i64-result 0xFFFFFFFFFFFFFFBF
                :u64-result 0xFFFFFFFFFFFFFFBE)
              (Case
                :input 0xFEDCBA9876543280
                :i8-result 0x79
                :i16-result 0xB24C
                :i32-result 0xF6666603
                :i64-result 0x81111111111111A6
                :u64-result 0x8032547698BADC26)]
      (when (or (!= (narrow8 (cast i8 (.input row))) (.i8-result row))
                (!= (narrow16 (cast i16 (.input row))) (.i16-result row))
                (!= (narrow32 (cast i32 (.input row))) (.i32-result row))
                (!= (cast u64 (signed64 (cast i64 (.input row))))
                    (.i64-result row))
                (!= (unsigned64 (.input row)) (.u64-result row)))
        (set! failures (+ failures 1))))
    (println "linked integer unary checks: {} failures" failures)
    (if (= failures 0) 0 1)))
