(module stogir.tests.aot-void-return-link)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern stogir.void-return
        :as
        "stogir_void_return_test"
        :cc
        (cc/C)
        [u64 (ptr i64) i64]
        (-> void))

(defn receive :cc (cc/C) [(cell (ptr i64)) (x i64)] (-> void)
  (set! (index cell 0) (+ x 17)))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of receive)))
        (mut cell) (: 0 i64)
        (mut x) (: -100 i64)
        (mut failures) 0]
    (while (<= x 100)
      (stogir.void-return target (mut cell) x)
      (when (!= cell (+ x 17)) (set! failures (+ failures 1)))
      (set! x (+ x 1)))
    (println "linked void return checks: {} failures" failures)
    (if (= failures 0) 0 1)))
