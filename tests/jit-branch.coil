(module stogir.tests.jit-branch)
(import "stogir.jit.darwin" :as jit)
(import "stogir.a64.encode" :as e)
(import "stogir.a64.code" :as code)
(import "stogir.a64.image" :as emitted-image)
(import "stogir.image" :as image)
(import "stogir.aot.macho" :as macho)
(import "stogir.symbols" :as symbols)
(import "coil.fs" :as fs)
(import "stogir.a64.fixups" :as f)
(import "stogir.graph" :as g)
(import "stogir.calls" :as calls)
(import "stogir.builder" :as b)
(import "stogir.a64.select" :as select)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.compile" :as compile)
(import "stogir.bytes" :as bytes)
(import "stogir.relocate" :as read)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(extern labs :cc (cc/C) [i64] (-> i64))

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn relaxed-execution [(backward bool) (aligned bool)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut output) (code/create allocator)
        (mut labels) (ArrayList::new [i64] allocator)
        (mut branches) (ArrayList::new [f/Branch] allocator)
        (mut relatives) (ArrayList::new [f/Relative] allocator)
        (mut alignment) (ArrayList::new [i32] allocator)
        far (: 1048592 i64)
        (mut failures) 0]
    (bytes/append32! (mut (.text output)) (if backward 0 0xF100001F))  ; CMP x0,#0
    (bytes/append32! (mut (.text output)) (if backward 0xD2800540 0))  ; MOV x0,#42
    (bytes/append32! (mut (.text output)) (if backward 0xD65F03C0 0xD28000E0))  ; RET / MOV x0,#7
    (bytes/append32! (mut (.text output)) 0xD65F03C0)
    (while (< (len (.text output)) far)
      (bytes/append32! (mut (.text output)) 0xD503201F))
    (if backward
        (do
          (bytes/append32! (mut (.text output)) 0xF100001F)
          (bytes/append32! (mut (.text output)) 0)
          (bytes/append32! (mut (.text output)) 0xD28000E0)
          (bytes/append32! (mut (.text output)) 0xD65F03C0))
        (do
          (bytes/append32! (mut (.text output)) 0xD2800540)
          (bytes/append32! (mut (.text output)) 0xD65F03C0)))
    (push! (mut labels) (if backward 4 far))
    (when backward
      (push! (mut labels) far)
      (push! (mut branches)
             (f/Branch
               :offset 0
               :label 1
               :condition -1
               :link false)))
    (push! (mut branches)
           (f/Branch
             :offset (if backward (+ far 4) 4)
             :label 0
             :condition 0
             :link false))
    (for [i 0 (len labels)]
      (push! (mut alignment) (if (and aligned (= i 0)) 8 4)))
    (match (f/relax-aligned! (mut output)
                             (mut labels)
                             (mut branches)
                             (mut relatives)
                             alignment)
      (Err [message] (do (println "{}" message) (set! failures 1)))
      (Ok [count]
          (when (!= count 1) (set! failures (+ failures 1)))
          (when (!= (read/read32 (.text output)
                                 (- (.offset (get branches (- (len branches) 1)))
                                    4))
                    0x54000041)
            (set! failures (+ failures 1)))
          (when (and aligned (!= (% (get labels 0) 8) 0))
            (set! failures (+ failures 1)))
          (match (jit/map-text (slice (.text output)))
            (Err [message]
                 (do (println "{}" message) (set! failures (+ failures 1))))
            (Ok [image]
                (let [(mut owned) image
                      function
                        (primitive/cast (fnptr (cc/C) [i64] i64) (.base owned))]
                  (when (!= (call-ptr function 0) 42)
                    (set! failures (+ failures 1)))
                  (for input [(: -1 i64) 1 9223372036854775807]
                    (when (!= (call-ptr function input) 7)
                      (set! failures (+ failures 1))))
                  (when (not (jit/release! (mut owned)))
                    (set! failures (+ failures 1))))))))
    (match (f/relax! (mut output) (mut labels) (mut branches) (mut relatives))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [count] (when (!= count 0) (set! failures (+ failures 1)))))
    (free! (mut alignment))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut branches))
    (free! (mut relatives))
    failures))

;;; Real PAGE21/PAGEOFF12 and call relocations directly adjoin an expanding
;;; conditional branch. Execute both paths and retain an object for linked AOT.
(defn relocated-long-branch [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        target (require (symbols/function! (mut graph) "_labs" 0))
        (mut output) (code/create a)
        (mut labels) (ArrayList::new [i64] a)
        (mut branches) (ArrayList::new [f/Branch] a)
        (mut relatives) (ArrayList::new [f/Relative] a)
        (mut alignment) (ArrayList::new [i32] a)
        far (: 1048624 i64)
        (mut branch-position) (: 0 i64)
        (mut failures) 0]
    (bytes/append32! (mut (.text output)) 0xA9BF7BFD)  ; STP x29,x30,[sp,#-16]!
    (bytes/append32! (mut (.text output)) 0x910003FD)  ; MOV x29,sp
    (bytes/append32! (mut (.text output)) 0xF100001F)  ; CMP x0,#0
    (require (code/reference-address! (mut output) target 16 false))
    (set! branch-position (len (.text output)))
    (bytes/append32! (mut (.text output)) 0)
    (require (code/direct-call! (mut output) graph target))
    (bytes/append32! (mut (.text output)) 0xA8C17BFD)  ; LDP x29,x30,[sp],#16
    (bytes/append32! (mut (.text output)) 0xD65F03C0)
    (while (< (len (.text output)) far)
      (bytes/append32! (mut (.text output)) 0xD503201F))
    (bytes/append32! (mut (.text output)) 0xD2800540)  ; MOV x0,#42
    (bytes/append32! (mut (.text output)) 0xA8C17BFD)
    (bytes/append32! (mut (.text output)) 0xD65F03C0)
    (push! (mut labels) far)
    (push! (mut labels) branch-position)
    (push! (mut alignment) 8)
    (push! (mut alignment) 8)
    (push! (mut branches)
           (f/Branch
             :offset branch-position
             :label 0
             :condition 0
             :link false))
    (match (f/relax-aligned! (mut output)
                             (mut labels)
                             (mut branches)
                             (mut relatives)
                             alignment)
      (Err [message] (do (println "{}" message) (set! failures (+ failures 1))))
      (Ok [count] (when (!= count 1) (set! failures (+ failures 1)))))
    (match (emitted-image/finish! (mut output)
                                  graph
                                  "_stogir_long_relocated_branch"
                                  a)
      (Err [message] (do (println "{}" message) (set! failures (+ failures 1))))
      (Ok [compiled]
          (let [(mut source) compiled
                (mut addresses) (ArrayList::new [u64] a)
                (mut present) (ArrayList::new [bool] a)]
            (when (!= (.text-alignment source) 8)
              (set! failures (+ failures 1)))
            (match (macho/image-object source a)
              (Err [message]
                   (do (println "{}" message) (set! failures (+ failures 1))))
              (Ok [object]
                  (let [(mut owned) object]
                    (match (fs/write-file a
                                          "/tmp/coil-stogir-long-relocated-branch.o"
                                          (slice owned))
                      (Err [_] (set! failures (+ failures 1)))
                      (Ok [_] 0))
                    (free! (mut owned)))))
            (for symbol (.symbols source)
              (push! (mut addresses)
                     (primitive/cast u64
                                     (primitive/cast (ptr u8) (fnptr-of labs))))
              (push! (mut present) true))
            (match (jit/map-image-resolved source
                                           (slice addresses)
                                           (slice present)
                                           a)
              (Err [message]
                   (do (println "{}" message) (set! failures (+ failures 1))))
              (Ok [loaded]
                  (let [(mut owned) loaded
                        function
                          (primitive/cast (fnptr (cc/C) [i64] i64)
                                          (.base (.memory owned)))]
                    (for x [(: -100 i64) -1 0 1 73]
                      (let [expected (if (= x 0) 42 (if (< x 0) (- 0 x) x))]
                        (when (!= (call-ptr function x) expected)
                          (set! failures (+ failures 1)))))
                    (jit/release-image! (mut owned)))))
            (free! (mut addresses))
            (free! (mut present))
            (image/release! (mut source)))))
    (code/release! (mut output))
    (free! (mut labels))
    (free! (mut branches))
    (free! (mut relatives))
    (free! (mut alignment))
    (g/release! (mut graph))
    failures))

;;; The branch operands must survive a caller-clobbering call after matching.
(defn clobber :cc (cc/C) [(x i64) (y i64)] (-> i64)
  (+ (* x 17) (* y 31)))

(defn call-control [(graph (mut g/Graph))
                    (start i32)
                    (target i32)
                    (p i32)
                    (q i32)] (-> i32)
  (match (calls/create 0 11 [(: 11 u8) 11] (malloc-allocator))
    (Err [message] (do (println "{}" message) 0))
    (Ok [prototype]
        (let [(mut owned) prototype
              result
                (require (calls/emit! (mut graph)
                                      owned
                                      start
                                      target
                                      [p q]
                                      (malloc-allocator)))]
          (calls/release! (mut owned))
          result))))

(defn predicate-case [(opcode i32) (shared bool)] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        control (call-control (mut graph) start target p q)
        condition (require (b/emit! (mut graph) opcode 1 [p q]))
        split (require (b/emit! (mut graph) 116 0 [control condition]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        extended (require (b/emit! (mut graph) 34 11 [condition]))
        yes-ret
          (require (b/emit! (mut graph)
                            120
                            11
                            [yes (if shared extended one) (: 0 i32)]))
        no-ret (require (b/emit! (mut graph) 120 11 [no zero (: 0 i32)]))
        (mut failures) 0]
    (match (compile/text graph start [yes-ret no-ret] (malloc-allocator))
      (Err [message] (do (println "{}" message) (set! failures 1)))
      (Ok [compiled]
          (let [(mut text) compiled]
            (for [word 0 (/ (len text) 4)]
              (when (= (read/read32 text (* word 4)) 0x14000001)
                (set! failures (+ failures 1))))
            (match (jit/map-text (slice text))
              (Err [message] (do (println "{}" message) (set! failures 1)))
              (Ok [image]
                  (let [(mut owned) image
                        f
                          (primitive/cast (fnptr (cc/C) [i64 i64 u64] i64)
                                          (.base owned))]
                    (for x [(: -9223372036854775808 i64)
                            -1
                            0
                            1
                            9223372036854775807]
                      (for y [(: -9223372036854775808 i64)
                              -1
                              0
                              1
                              9223372036854775807]
                        (let [ux (cast u64 x)
                              uy (cast u64 y)
                              expected
                                (case opcode
                                  14 (= x y)
                                  15 (!= x y)
                                  16 (< x y)
                                  17 (>= x y)
                                  18 (<= x y)
                                  19 (> x y)
                                  20 (< ux uy)
                                  21 (>= ux uy)
                                  22 (<= ux uy)
                                  23 (> ux uy)
                                  false)]
                          (when (!= (call-ptr f
                                              x
                                              y
                                              (primitive/cast u64
                                                              (primitive/cast (ptr u8)
                                                                              (fnptr-of clobber))))
                                    (if expected 1 0))
                            (set! failures (+ failures 1))))))
                    (when (not (jit/release! (mut owned)))
                      (set! failures (+ failures 1))))))
            (free! (mut text)))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))
        (mut failures)
          (+ (relaxed-execution false false)
             (relaxed-execution true false)
             (relaxed-execution false true)
             (relaxed-execution true true))]
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
          constant (require (b/scalar-constant! (mut graph) 11 42 8))
          sum (require (b/emit! (mut graph) 26 11 [p constant]))
          product (require (b/emit! (mut graph) 16 1 [p q]))
          split (require (b/emit! (mut graph) 116 0 [start product]))
          yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
          no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
          yes-ret (require (b/emit! (mut graph) 120 11 [yes p (: 0 i32)]))
          no-ret (require (b/emit! (mut graph) 120 11 [no q (: 0 i32)]))]
      ; An unused projection must not replace the live true target.
      (b/emit! (mut graph) 107 0 [split (: 0 i32)])
      (match (compile/text graph start [yes-ret no-ret] (malloc-allocator))
        (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
        (Ok [compiled]
            (let [(mut code) compiled]
              (for byte code (push! (mut text) byte))
              (free! (mut code)))))
      (g/release! (mut graph)))
    (match (jit/map-text (slice text))
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [image]
          (let [(mut owned) image
                f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (.base owned))]
            (when (!= (call-ptr f 100 2) 2) (set! failures (+ failures 1)))
            (when (!= (call-ptr f -42 5) -42) (set! failures (+ failures 1)))
            (let [(mut x) -100]
              (while (<= x 100)
                (let [(mut y) -4]
                  (while (<= y 4)
                    (when (!= (call-ptr f x y) (if (< x y) x y))
                      (set! failures (+ failures 1)))
                    (set! y (+ y 1))))
                (set! x (+ x 1))))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1)))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1))))))
    (for [opcode 14 24]
      (set! failures
            (+ failures
               (predicate-case (cast i32 opcode) false)
               (predicate-case (cast i32 opcode) true))))
    (free! (mut text))
    (set! failures (+ failures (relocated-long-branch)))
    (println "compiled branch checks: {} failures" failures)
    (if (= failures 0) 0 1)))
