(module stogir.tests.jit-branch)
(import "stogir.jit.darwin" :as jit)
(import "stogir.a64.encode" :as e)
(import "stogir.graph" :as g)
(import "stogir.calls" :as calls)
(import "stogir.builder" :as b)
(import "stogir.a64.select" :as select)
(import "stogir.a64.emit" :as emit)
(import "stogir.a64.compile" :as compile)
(import "stogir.bytes" :as bytes)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

;;; The branch operands must survive a caller-clobbering call after matching.
(defn clobber :cc (cc/C) [(x i64) (y i64)] (-> i64)
  (+ (* x 17) (* y 31)))

(defn call-control [(graph (mut g/Graph))
                    (start i32)
                    (target i32)
                    (p i32)
                    (q i32)] (-> i32)
  (match (calls/create 0 11 [(: 11 u8) 11] (malloc-allocator))
    (Err [message] (do (println "{}" message) 0))
    (Ok [prototype]
        (let [(mut owned) prototype
              result
                (require (calls/emit! (mut graph)
                                      owned
                                      start
                                      target
                                      [p q]
                                      (malloc-allocator)))]
          (calls/release! (mut owned))
          result))))

(defn predicate-case [(opcode i32) (shared bool)] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        target (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        control (call-control (mut graph) start target p q)
        condition (require (b/emit! (mut graph) opcode 1 [p q]))
        split (require (b/emit! (mut graph) 116 0 [control condition]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        extended (require (b/emit! (mut graph) 34 11 [condition]))
        yes-ret
          (require (b/emit! (mut graph)
                            120
                            11
                            [yes (if shared extended one) (: 0 i32)]))
        no-ret (require (b/emit! (mut graph) 120 11 [no zero (: 0 i32)]))
        (mut failures) 0]
    (match (compile/text graph start [yes-ret no-ret] (malloc-allocator))
      (Err [message] (do (println "{}" message) (set! failures 1)))
      (Ok [compiled]
          (let [(mut text) compiled]
            (match (jit/map-text (slice text))
              (Err [message] (do (println "{}" message) (set! failures 1)))
              (Ok [image]
                  (let [(mut owned) image
                        f
                          (primitive/cast (fnptr (cc/C) [i64 i64 u64] i64)
                                          (.base owned))]
                    (for x [(: -9223372036854775808 i64)
                            -1
                            0
                            1
                            9223372036854775807]
                      (for y [(: -9223372036854775808 i64)
                              -1
                              0
                              1
                              9223372036854775807]
                        (let [ux (cast u64 x)
                              uy (cast u64 y)
                              expected
                                (case opcode
                                  14 (= x y)
                                  15 (!= x y)
                                  16 (< x y)
                                  17 (>= x y)
                                  18 (<= x y)
                                  19 (> x y)
                                  20 (< ux uy)
                                  21 (>= ux uy)
                                  22 (<= ux uy)
                                  23 (> ux uy)
                                  false)]
                          (when (!= (call-ptr f
                                              x
                                              y
                                              (primitive/cast u64
                                                              (primitive/cast (ptr u8)
                                                                              (fnptr-of clobber))))
                                    (if expected 1 0))
                            (set! failures (+ failures 1))))))
                    (when (not (jit/release! (mut owned)))
                      (set! failures (+ failures 1))))))
            (free! (mut text)))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0]
    (let [(mut graph) (g/create (malloc-allocator))
          start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
          p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
          q (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
          constant (require (b/scalar-constant! (mut graph) 11 42 8))
          sum (require (b/emit! (mut graph) 26 11 [p constant]))
          product (require (b/emit! (mut graph) 16 1 [p q]))
          split (require (b/emit! (mut graph) 116 0 [start product]))
          yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
          no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
          yes-ret (require (b/emit! (mut graph) 120 11 [yes p (: 0 i32)]))
          no-ret (require (b/emit! (mut graph) 120 11 [no q (: 0 i32)]))]
      ; An unused projection must not replace the live true target.
      (b/emit! (mut graph) 107 0 [split (: 0 i32)])
      (match (compile/text graph start [yes-ret no-ret] (malloc-allocator))
        (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
        (Ok [compiled]
            (let [(mut code) compiled]
              (for byte code (push! (mut text) byte))
              (free! (mut code)))))
      (g/release! (mut graph)))
    (match (jit/map-text (slice text))
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [image]
          (let [(mut owned) image
                f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (.base owned))]
            (when (!= (call-ptr f 100 2) 2) (set! failures (+ failures 1)))
            (when (!= (call-ptr f -42 5) -42) (set! failures (+ failures 1)))
            (let [(mut x) -100]
              (while (<= x 100)
                (let [(mut y) -4]
                  (while (<= y 4)
                    (when (!= (call-ptr f x y) (if (< x y) x y))
                      (set! failures (+ failures 1)))
                    (set! y (+ y 1))))
                (set! x (+ x 1))))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1)))
            (when (not (jit/release! (mut owned)))
              (set! failures (+ failures 1))))))
    (for [opcode 14 24]
      (set! failures
            (+ failures
               (predicate-case (cast i32 opcode) false)
               (predicate-case (cast i32 opcode) true))))
    (free! (mut text))
    (println "compiled branch checks: {} failures" failures)
    (if (= failures 0) 0 1)))
