(module stogir.tests.sccp-iteration-seeds)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "stogir.sccp-analysis" :as analysis)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

;;; Tail-only edits must seed users and former/new definitions even though the
;;; first 16-byte instruction cell, opcode header and arity are all unchanged.
(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut source) (g/create a)
        start (require (b/emit! (mut source) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut source) 71 11 [start (: 0 i32) 0]))
        y (require (b/emit! (mut source) 71 11 [start (: 0 i32) 1]))
        end (require (b/emit! (mut source) 114 0 [start]))
        merge (require (b/emit! (mut source) 112 0 [end end end end end]))
        phi (require (b/emit! (mut source) 67 11 [merge x x x x x]))
        user (require (b/emit! (mut source) 26 11 [phi x]))
        inherited (require (b/emit! (mut source) 31 11 [x]))
        untouched (require (b/emit! (mut source) 45 11 [x]))
        (mut graph) (g/duplicate source a)
        (mut facts) (analysis/create (len (.instructions source)) 8 a)
        (mut edges) (uses/build source a)
        (mut queue) (q/create (len (.instructions source)) a)
        (mut failures) 0]
    (g/set-operand! (mut graph) phi 5 y)
    (q/add! (mut (.iteration facts)) (cast i64 inherited))
    (rewrite/seed-iteration! source graph edges facts (mut queue))
    (for r [phi user merge x y inherited]
      (when (not (q/contains? queue (cast i64 r)))
        (set! failures (+ failures 1))))
    (when (q/contains? queue (cast i64 untouched))
      (set! failures (+ failures 1)))
    (when (not (q/contains? (.iteration facts) (cast i64 inherited)))
      (set! failures (+ failures 1)))
    (let [before (get (.instructions source) (cast i64 phi))
          after (get (.instructions graph) (cast i64 phi))]
      (when (or (!= (.header before) (.header after))
                (!= (.op1 before) (.op1 after))
                (!= (.op2 before) (.op2 after))
                (!= (.op3 before) (.op3 after)))
        (set! failures (+ failures 1))))
    (q/release! (mut queue))
    (uses/release! (mut edges))
    (analysis/release! (mut facts))
    (g/release! (mut graph))
    (g/release! (mut source))
    (println "SCCP iteration seed checks: {} failures" failures)
    (if (= failures 0) 0 1)))
