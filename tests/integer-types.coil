(module stogir.tests.integer-types)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as v)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (panic "{}" msg))))

;;; Scalar and pointer-offset compatibility, including complete error priority.
(defn type-matrix [] (-> void)
  (for opcode [(: 14 i32) 26 27 28 46]
    (for left-type (range 1 12)
      (for right-type (range 1 12)
        (for wrong-result [false true]
          (let [(mut graph) (g/create (malloc-allocator))
                start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
                left
                  (require (b/emit! (mut graph)
                                    71
                                    (cast i32 left-type)
                                    [start (: 0 i32) 0]))
                right
                  (require (b/emit! (mut graph)
                                    71
                                    (cast i32 right-type)
                                    [start (: 0 i32) 1]))
                correct-type (if (= opcode 14) 1 left-type)
                result-type
                  (if wrong-result
                      (if (= correct-type 11) 10 (+ correct-type 1))
                      correct-type)
                operation
                  (require (b/emit! (mut graph)
                                    opcode
                                    (cast i32 result-type)
                                    [left right]))
                compatible
                  (or (= left-type right-type)
                      (and (or (= opcode 26) (= opcode 27))
                           (= left-type 6)
                           (= result-type 6)
                           (or (= right-type 5) (= right-type 11))))
                expected
                  (cond (not compatible) "integer operand type mismatch"
                        wrong-result "integer operation result type mismatch"
                        (and (= left-type 1)
                             (or (= opcode 26) (= opcode 27) (= opcode 28)))
                          "invalid integer operand type"
                        :else "")]
            (for width [(: 4 i32) 8]
              (match (v/integer-operations-target graph width)
                (Ok [count] (assert (= expected "")) (assert (= count 1)))
                (Err [message]
                     (assert (!= expected ""))
                     (assert (= message expected)))))
            (g/release! (mut graph))))))))

(defn main [] (-> i64)
  (type-matrix)
  (let [(mut graph) (g/create (malloc-allocator))
        a (require (b/scalar-constant! (mut graph) 11 42 8))
        narrow (require (b/scalar-constant! (mut graph) 2 42 8))
        sum (require (b/emit! (mut graph) 26 11 [a a]))
        cmp (require (b/emit! (mut graph) 14 1 [sum a]))
        (mut failures) 0]
    (match (v/integer-operations graph)
      (Ok [count] (when (!= count 2) (set! failures (+ failures 1))))
      (Err [_] (set! failures (+ failures 1))))
    (b/patch! (mut graph) sum 2 narrow)
    (match (v/integer-operations graph)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (b/patch! (mut graph) sum 2 a)
    (b/patch! (mut graph) cmp 1 narrow)
    (match (v/integer-operations graph)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (g/release! (mut graph))
    (println "integer typing checks: {} failures" failures)
    (if (= failures 0) 0 1)))
