(module stogir.tests.aot-recursion-link)
(import "coil.cc" :as cc)

(extern factorial :as "stogir_factorial" :cc (cc/C) [i64] (-> i64))

(defn main [] (-> i64)
  (let [(mut x) (: -3 i64)
        (mut expected) (: 1 i64)
        (mut failures) 0]
    (while (<= x 18)
      (when (> x 1) (set! expected (* expected x)))
      (when (!= (factorial x) expected) (set! failures (+ failures 1)))
      (set! x (+ x 1)))
    (println "linked recursive function checks: {} failures" failures)
    (if (= failures 0) 0 1)))
