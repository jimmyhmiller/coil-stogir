                          ; retain the call, not erase that observable control.
                          (match (inlining/optimize caller
                                                    (slice roots)
                                                    called
                                                    (inlining/Callee
                                                      :name "_inline_leaf"
                                                      :graph callee
                                                      :entry start
                                                      :roots [exit]
                                                      :observed [exit]
                                                      :never false)
                                                    8
                                                    128
                                                    a)
                            (Err [message] (panic "{}" message))
                            (Ok [kept]
                                (let [(mut kept) kept]
                                  (assert (= (.changes kept) 0))
                                  (rewrite/release! (mut kept))))))
                        (when (and (= kind 18) (= expected 1))
                          ; A separate infinite control region cannot be lost
                          ; merely because the provider supplied one RETURN.
                          (let [(mut open) (g/duplicate callee a)
                                enter
                                  (require (b/emit! (mut open) 114 0 [start]))
                                loop (require (b/loop-begin! (mut open) enter))
                                back (require (b/emit! (mut open) 115 0 [loop]))]
                            (b/patch! (mut open) loop 2 back)
                            (match (inlining/optimize caller
                                                      (slice roots)
                                                      called
                                                      (inlining/Callee
                                                        :name "_inline_leaf"
                                                        :graph open
                                                        :entry start
                                                        :roots [exit]
                                                        :observed
                                                          (slice callee-observed)
                                                        :never false)
                                                      8
                                                      128
                                                      a)
                              (Err [message] (panic "{}" message))
                              (Ok [rejected]
                                  (let [(mut rejected) rejected]
                                    (assert (= (.changes rejected) 0))
                                    (rewrite/release! (mut rejected)))))
                            (g/release! (mut open))))
                        (when (and (= kind 17) (> expected 0))
                          (let [(mut found) false]
                            (for [i 0 (len (.constants (.graph output)))]
                              (when (> (get (.constant-spans (.graph output)) i)
                                       0)
                                (let [value (get (.constants (.graph output)) i)]
                                  (when (= (n/opcode value) 74)
