                                                      :name "_inline_leaf"
                                                      :graph callee
                                                      :entry start
                                                      :roots [exit]
                                                      :observed
                                                        (slice callee-observed)
                                                      :never false)
                                                    8
                                                    64
                                                    a)
                            (Err [message] (panic "{}" message))
                            (Ok [rooted]
                                (let [(mut rooted) rooted
                                      (mut marked)
                                        (live/mark (.graph rooted)
                                                   (slice (.roots rooted))
                                                   a)
                                      (mut stores) 0]
                                  (for [r
                                        before-count
                                        (len (.instructions (.graph rooted)))]
                                    (when (= (n/opcode (get (.instructions (.graph rooted))
