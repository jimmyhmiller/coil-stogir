(module stogir.tests.module-execution)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.symbols" :as symbols)
(import "stogir.strings" :as strings)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.options" :as options)
(import "stogir.call-inline" :as inlining)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.liveness" :as live)
(import "stogir.link" :as link)
(import "stogir.image" :as image)
(import "stogir.text-data" :as text-data)
(import "stogir.a64.compile" :as compile)
(import "stogir.aot.macho" :as macho)
(import "stogir.bytes" :as bytes)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.fs" :as fs)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn owned-image [(result (Result image/Image (slice u8)))] (-> image/Image)
  (match result
    (Ok [source] source)
    (Err [message] (println "{}" message) (image/create (malloc-allocator)))))

(defn pair-image [(first? bool)] (-> image/Image)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        n (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        literal (require (symbols/string! (mut graph) (if first? "A" "B")))
        byte (require (b/emit! (mut graph) 91 2 [start literal]))
        tag (require (b/conversion! (mut graph) 34 11 8 byte))
        global (require (symbols/symbol! (mut graph) "_stogir_module_shared"))
        value (require (b/emit! (mut graph) 91 11 [byte global]))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        positive (require (b/emit! (mut graph) 16 1 [zero n]))
        split (require (b/emit! (mut graph) 116 0 [value positive]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        base (require (b/emit! (mut graph) 26 11 [value tag]))
        base-ret (require (b/emit! (mut graph) 120 11 [no base (: 0 i32)]))
        previous (require (b/emit! (mut graph) 27 11 [n one]))
        callee
          (require (symbols/function! (mut graph)
                                      (if first?
                                          "_stogir_module_b"
                                          "_stogir_module_a")
                                      0))
        (mut roots) (ArrayList::new [i32] allocator)]
    (push! (mut roots) base-ret)
    (match (calls/create 9 11 [(: 11 u8)] allocator)
      (Err [message] (println "{}" message))
      (Ok [prototype]
          (let [(mut owned) prototype
                called
                  (require (calls/emit! (mut graph)
                                        owned
                                        yes
                                        callee
                                        [previous]
                                        allocator))
                answer (require (b/emit! (mut graph) 26 11 [called tag]))
                ret
                  (require (b/emit! (mut graph)
                                    120
                                    11
                                    [called answer (: 0 i32)]))]
            (require (calls/function! (mut graph) owned allocator))
            (push! (mut roots) ret)
            (free! (mut (.parameters owned))))))
    (let [result
            (owned-image (compile/image graph
                                        start
                                        (slice roots)
                                        (if first?
                                            "_stogir_module_a"
                                            "_stogir_module_b")
                                        allocator))]
      (free! (mut roots))
      (g/release! (mut graph))
      result)))

(defn pointer-image [] (-> image/Image)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        n (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        slot (require (symbols/symbol! (mut graph) "_stogir_module_fnptr"))
        target (require (b/emit! (mut graph) 91 6 [start slot]))
        (mut root) (: 0 i32)]
    (match (calls/create 9 11 [(: 11 u8)] allocator)
      (Err [message] (println "{}" message))
      (Ok [prototype]
          (let [(mut owned) prototype
                called
                  (require (calls/emit! (mut graph)
                                        owned
                                        target
                                        target
                                        [n]
                                        allocator))]
            (require (calls/function! (mut graph) owned allocator))
            (set! root
                  (require (b/emit! (mut graph)
                                    120
                                    11
                                    [called called (: 0 i32)])))
            (free! (mut (.parameters owned))))))
    (let [result
            (owned-image (compile/image graph
                                        start
                                        [root]
                                        "_stogir_module_via_pointer"
                                        allocator))]
      (g/release! (mut graph))
      result)))

(defn table-image [] (-> image/Image)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        n (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        split (require (b/switch! (mut graph) start n))
        (mut roots) (ArrayList::new [i32] allocator)]
    (for tag [(: 0 u64) 2 4]
      (let [value (require (b/scalar-constant! (mut graph) 5 tag 8))
            projection (require (b/case-value! (mut graph) split value))
            answer (require (b/scalar-constant! (mut graph) 5 (+ 100 tag) 8))]
        (push! (mut roots)
               (require (b/emit! (mut graph)
                                 120
                                 5
                                 [projection answer (: 0 i32)])))))
    (let [fallback (require (b/case-default! (mut graph) split))
          answer (require (b/scalar-constant! (mut graph) 5 777 8))]
      (push! (mut roots)
             (require (b/emit! (mut graph) 120 5 [fallback answer (: 0 i32)]))))
    (let [result
            (owned-image (compile/image graph
                                        start
                                        (slice roots)
                                        "_stogir_module_table"
                                        allocator))]
      (free! (mut roots))
      (g/release! (mut graph))
      result)))

(defn data-image [] (-> image/Image)
  (let [allocator (malloc-allocator)
        (mut source) (image/create allocator)]
    (while (< (len (.data source)) 8) (push! (mut (.data source)) 0xA5))
    (bytes/append32! (mut (.data source)) 10)
    (bytes/append32! (mut (.data source)) 0)
    (bytes/append32! (mut (.data source)) 0)
    (bytes/append32! (mut (.data source)) 0)
    (require (image/symbol! (mut source) "_stogir_module_shared" 2 8))
    (require (image/symbol! (mut source) "_stogir_module_fnptr" 2 16))
    (let [target (require (image/symbol! (mut source) "_stogir_module_a" 0 0))]
      (image/relocate! (mut source)
                       (image/Relocation
                         :section 2
                         :offset 16
                         :kind 1
                         :symbol target
                         :addend 0)))
    source))

(defn expected [(n i64) (first? bool) (shared i64)] (-> i64)
  (let [(mut i) 0
        (mut a?) first?
        (mut result) shared]
    (while (<= i (if (< n 0) 0 n))
      (set! result (+ result (if a? 65 66)))
      (set! a? (not a?))
      (set! i (+ i 1)))
    result))

(defn find [(source image/Image) (text (slice u8))] (-> i32)
  (match (image/find-symbol source text) (Some [id] id) (None [] -1)))

(defn run [(module link/Module)] (-> i64)
  (let [allocator (malloc-allocator)
        source (.image module)
        ai (find source "_stogir_module_a")
        bi (find source "_stogir_module_b")
        vi (find source "_stogir_module_via_pointer")
        ti (find source "_stogir_module_table")
        si (find source "_stogir_module_shared")
        pi (find source "_stogir_module_fnptr")
        (mut failures) 0]
    (if (or (< ai 0) (< bi 0) (< vi 0) (< ti 0) (< si 0) (< pi 0))
        1
        (do
          (match (macho/image-object source allocator)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [object]
                (let [(mut bytes) object]
                  (match (fs/write-file allocator
                                        "/tmp/coil-stogir-module.o"
                                        (slice bytes))
                    (Err [_] (set! failures (+ failures 1)))
                    (Ok [_] 0))
                  (free! (mut bytes)))))
          (match (jit/map-image source allocator)
            (Err [message]
                 (println "{}" message)
                 (set! failures (+ failures 1)))
            (Ok [loaded]
                (let [(mut owned) loaded
                      a
                        (primitive/cast (fnptr (cc/C) [i64] i64)
                                        (primitive/cast (ptr u8)
                                                        (get (.addresses owned)
                                                             (cast i64 ai))))
                      b
                        (primitive/cast (fnptr (cc/C) [i64] i64)
                                        (primitive/cast (ptr u8)
                                                        (get (.addresses owned)
                                                             (cast i64 bi))))
                      via
                        (primitive/cast (fnptr (cc/C) [i64] i64)
                                        (primitive/cast (ptr u8)
                                                        (get (.addresses owned)
                                                             (cast i64 vi))))
                      table
                        (primitive/cast (fnptr (cc/C) [u64] u64)
                                        (primitive/cast (ptr u8)
                                                        (get (.addresses owned)
                                                             (cast i64 ti))))
                      shared
                        (primitive/cast (ptr i64)
                                        (get (.addresses owned) (cast i64 si)))
                      pointer
                        (primitive/cast (ptr u64)
                                        (get (.addresses owned) (cast i64 pi)))
                      (mut n) (: -2 i64)]
                  (when (!= (primitive/load pointer)
                            (get (.addresses owned) (cast i64 ai)))
                    (set! failures (+ failures 1)))
                  (while (<= n 24)
                    (when (or (!= (call-ptr a n) (expected n true 10))
                              (!= (call-ptr b n) (expected n false 10))
                              (!= (call-ptr via n) (expected n true 10)))
                      (set! failures (+ failures 1)))
                    (set! n (+ n 1)))
                  (for tag [(: 0 u64) 1 2 3 4 5 0xFFFFFFFFFFFFFFFF]
                    (let [want
                            (if (or (= tag 0) (= tag 2) (= tag 4))
                                (+ 100 tag)
                                777)]
                      (when (!= (call-ptr table tag) want)
                        (set! failures (+ failures 1)))))
                  (primitive/store! shared 20)
                  (when (!= (call-ptr via 12) (expected 12 true 20))
                    (set! failures (+ failures 1)))
                  (match (jit/map-image source allocator)
                    (Err [message]
                         (println "{}" message)
                         (set! failures (+ failures 1)))
                    (Ok [another]
                        (let [(mut other) another
                              second
                                (primitive/cast (fnptr (cc/C) [i64] i64)
                                                (primitive/cast (ptr u8)
                                                                (get (.addresses other)
                                                                     (cast i64
                                                                           ai))))]
                          (when (!= (call-ptr second 12) (expected 12 true 10))
                            (set! failures (+ failures 1)))
                          (jit/release-image! (mut other)))))
                  (jit/release-image! (mut owned)))))
          failures))))

;;; Compare independently linked caller/callee images with graph expansion. The
;;; original graphs remain immutable, including their constant-reference spaces.
(defn inline-target-image [] (-> image/Image)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        value (require (b/scalar-constant! (mut graph) 11 61 8))
        ret (require (b/emit! (mut graph) 120 11 [start value (: 0 i32)]))]
    (match (calls/create 0 11 [] a)
      (Err [message] (panic "{}" message))
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (require (calls/function! (mut graph) prototype a))
            (calls/release! (mut prototype)))))
    (let [output
            (owned-image (compile/image graph start [ret] "_inline_target" a))]
      (g/release! (mut graph))
      output)))

(defn inline-case [(kind i32)
                   (never bool)
                   (budget i32)
                   (matching bool)
                   (compatible bool)] (-> void)
  (let [a (malloc-allocator)
        pointer (or (= kind 3) (= kind 4) (= kind 7))
        floating (or (= kind 5) (= kind 6) (= kind 9))
        scalar (if floating (: 12 i32) 11)
        result (if (= kind 4) (: 0 i32) scalar)
        (mut callee) (g/create a)
        (mut caller) (g/create a)
        start (require (b/emit! (mut callee) 104 0 [(: 0 i32)]))
        entry (require (b/emit! (mut caller) 104 0 [(: 0 i32)]))
        parameter
          (if pointer (: 6 i32) (if (or (= kind 12) (= kind 13)) 10 scalar))
        input-type (if (= kind 12) (: 4 i32) (if (= kind 13) 5 parameter))
        x (require (b/emit! (mut callee) 71 parameter [start (: 0 i32) 0]))
        input (require (b/emit! (mut caller) 71 input-type [entry (: 0 i32) 0]))
        (mut descriptors) (ArrayList::new [groups/Group] a)
        (mut parameters) (ArrayList::new [u8] a)
        (mut arguments) (ArrayList::new [i32] a)
        (mut control) start
        (mut returned) x
        (mut roots) (ArrayList::new [i32] a)]
    (push! (mut parameters) (cast u8 input-type))
    (push! (mut arguments) input)
    (cond (= kind 0)
            (set! returned (require (b/scalar-constant! (mut callee) 11 73 8)))
          (= kind 2)
            (let [three (require (b/scalar-constant! (mut callee) 11 3 8))]
              (set! returned (require (b/emit! (mut callee) 26 11 [x three]))))
          (= kind 3)
            (do
              (set! returned (require (b/emit! (mut callee) 91 11 [start x])))
              (set! control returned))
          (or (= kind 4) (= kind 7))
            (let [value
                    (require (b/emit! (mut callee) 71 11 [start (: 0 i32) 1]))
                  argument
                    (require (b/emit! (mut caller) 71 11 [entry (: 0 i32) 1]))]
              (push! (mut parameters) 11)
              (push! (mut arguments) argument)
              (set! control
                    (require (b/emit! (mut callee) 93 0 [start x value])))
              (set! returned (if (= kind 4) 0 value)))
          (= kind 5)
            (let [three
                    (require (b/scalar-constant! (mut callee)
                                                 12
                                                 0x4008000000000000
                                                 8))]
              (set! returned (require (b/emit! (mut callee) 26 12 [x three]))))
          (= kind 6)
            (set! returned
                  (require (b/scalar-constant! (mut callee)
                                               12
                                               0x8000000000000000
                                               8)))
          :else 0)
    (when (or (= kind 12) (= kind 13))
      (set! returned (require (b/conversion! (mut callee) 33 11 8 x))))
    (when (and (>= kind 14) (<= kind 16))
      (let [address
              (require (if (= kind 14)
                           (symbols/symbol! (mut callee) "_inline_global")
                           (if (= kind 15)
                               (symbols/function! (mut callee)
                                                  "_inline_global"
                                                  0)
                               (symbols/string! (mut callee) "12345678"))))]
        (set! returned (require (b/emit! (mut callee) 91 11 [start address])))
        (set! control returned)))
    (when (= kind 17)
      (let [target (require (symbols/function! (mut callee) "_inline_target" 0))]
        (match (calls/create 0 11 [] a)
          (Err [message] (panic "{}" message))
          (Ok [prototype]
              (let [(mut prototype) prototype
                    attached
                      (require (calls/attach! (mut callee) prototype target a))]
                (set! returned
                      (require (b/conversion! (mut callee) 36 11 8 attached)))
                (calls/release! (mut prototype)))))))
    (when (or (= kind 8) (= kind 9))
      (let [y (require (b/emit! (mut callee) 71 scalar [start (: 0 i32) 1]))
            three
              (require (b/scalar-constant! (mut caller)
                                           scalar
                                           (if floating 0x4008000000000000 3)
                                           8))]
        (push! (mut parameters) (cast u8 scalar))
        (push! (mut arguments) three)
        (push! (mut descriptors)
               (groups/Group
                 :first 0
                 :count 2
                 :alignment 8))
        (set! returned (require (b/emit! (mut callee) 26 scalar [x y])))))
    (when (= kind 10)
      (let [zero (require (b/scalar-constant! (mut callee) 11 0 8))
            three (require (b/scalar-constant! (mut callee) 11 3 8))
            positive (require (b/emit! (mut callee) 16 1 [zero x]))
            split (require (b/emit! (mut callee) 116 0 [start positive]))
            yes (require (b/emit! (mut callee) 107 0 [split (: 0 i32)]))
            no (require (b/emit! (mut callee) 108 0 [split (: 0 i32)]))
            plus (require (b/emit! (mut callee) 26 11 [x three]))
            minus (require (b/emit! (mut callee) 27 11 [x three]))
            yes-end (require (b/emit! (mut callee) 114 0 [yes]))
            no-end (require (b/emit! (mut callee) 114 0 [no]))
            join (require (b/emit! (mut callee) 112 0 [yes-end no-end]))]
        (set! control join)
        (set! returned (require (b/emit! (mut callee) 67 11 [join plus minus])))))
    (let [exit
            (require (b/emit! (mut callee)
                              120
                              result
                              [control returned (: 0 i32)]))
          target (require (symbols/function! (mut caller) "_inline_leaf" 0))]
      (match (calls/create-grouped 0
                                   (cast u8 result)
                                   (slice parameters)
                                   (slice descriptors)
                                   a)
        (Err [message] (panic "{}" message))
        (Ok [signature]
            (let [(mut signature) signature]
              (if compatible
                  (if (or (= kind 12) (= kind 13))
                      (match (calls/create 0 (cast u8 result) [(: 10 u8)] a)
                        (Err [message] (panic "{}" message))
                        (Ok [definition]
                            (let [(mut definition) definition]
                              (require (calls/function! (mut callee)
                                                        definition
                                                        a))
                              (calls/release! (mut definition)))))
                      (require (calls/function! (mut callee) signature a)))
                  (match (calls/create 32 (cast u8 result) (slice parameters) a)
                    (Err [message] (panic "{}" message))
                    (Ok [definition]
                        (let [(mut definition) definition]
                          (require (calls/function! (mut callee) definition a))
                          (calls/release! (mut definition))))))
              (let [called
                      (require (calls/emit! (mut caller)
                                            signature
                                            entry
                                            target
                                            (slice arguments)
                                            a))
                    value
                      (if (= kind 4)
                          (require (b/emit! (mut caller) 91 11 [called input]))
                          called)
                    done
                      (require (b/emit! (mut caller)
                                        120
                                        scalar
                                        [(if (= kind 4) value called)
                                         value
                                         (: 0 i32)]))
                    before-count (len (.instructions caller))
                    before-constants (len (.constants caller))
                    callee-count (len (.instructions callee))]
                (push! (mut roots) done)
                (push! (mut roots) called)
                (match (calls/create 0
                                     (cast u8 scalar)
                                     (if (>= kind 8)
                                         [(cast u8 input-type)]
                                         (slice parameters))
                                     a)
                  (Err [message] (panic "{}" message))
                  (Ok [caller-signature]
                      (let [(mut caller-signature) caller-signature]
                        (require (calls/function! (mut caller)
                                                  caller-signature
                                                  a))
                        (calls/release! (mut caller-signature)))))
                (when (= kind 2)
                  (let [(mut chain) (g/duplicate caller a)
                        second
                          (require (calls/emit! (mut chain)
                                                signature
                                                called
                                                target
                                                [called]
                                                a))
                        definition
                          (inlining/Callee
                            :name "_inline_leaf"
                            :graph callee
                            :entry start
                            :roots [exit]
                            :never false)
                        sites
                          [(inlining/Site :reference called :target definition)
                           (inlining/Site :reference second :target definition)]]
                    (g/write-input-word! (mut chain) done 1 second)
                    (g/write-input-word! (mut chain) done 2 second)
                    (for limit [(: 0 i32)
                                (cast i32 (- callee-count 1))
                                (cast i32 (* 2 (- callee-count 1)))]
                      (match (inlining/optimize-sites chain
                                                      [done]
                                                      sites
                                                      8
                                                      limit
                                                      a)
                        (Err [message] (panic "{}" message))
                        (Ok [batch]
                            (let [(mut batch) batch]
                              (assert (= (.changes batch)
                                         (if (= limit 0)
                                             0
                                             (if (= limit
                                                    (cast i32
                                                          (- callee-count 1)))
                                                 1
                                                 2))))
                              (let [(mut code)
                                      (owned-image (compile/image (.graph batch)
                                                                  entry
                                                                  (slice (.roots batch))
                                                                  "_inline_batch"
                                                                  a))
                                    (mut leaf)
                                      (owned-image (compile/image callee
                                                                  start
                                                                  [exit]
                                                                  "_inline_leaf"
                                                                  a))]
                                (match (link/compose [code leaf] a)
                                  (Err [message] (panic "{}" message))
                                  (Ok [module]
                                      (let [(mut module) module]
                                        (match (jit/map-image (.image module) a)
                                          (Err [message] (panic "{}" message))
                                          (Ok [loaded]
                                              (let [(mut loaded) loaded
                                                    index
                                                      (find (.image module)
                                                            "_inline_batch")]
                                                (assert (>= index 0))
                                                (let [address
                                                        (get (.addresses loaded)
                                                             (cast i64 index))
                                                      function
                                                        (primitive/cast (fnptr (cc/C)
                                                                               [i64]
                                                                               i64)
                                                                        (primitive/cast (ptr u8)
                                                                                        address))]
                                                  (for value [-100 -1 0 5 222]
                                                    (assert (= (function value)
                                                               (+ value 6)))))
                                                (jit/release-image! (mut loaded)))))
                                        (link/release! (mut module)))))
                                (image/release! (mut code))
                                (image/release! (mut leaf)))
                              (rewrite/release! (mut batch))))))
                    (match (inlining/optimize-sites chain
                                                    [done]
                                                    [(get sites 0)
                                                     (get sites 0)]
                                                    8
                                                    64
                                                    a)
                      (Err [_] 0)
                      (Ok [bad]
                          (let [(mut bad) bad]
                            (rewrite/release! (mut bad))
                            (panic "duplicate sites accepted"))))
                    (g/release! (mut chain))))
                (match (inlining/optimize caller
                                          (slice roots)
                                          called
                                          (inlining/Callee
                                            :name
                                              (if matching
                                                  "_inline_leaf"
                                                  "_other_leaf")
                                            :graph callee
                                            :entry start
                                            :roots [exit]
                                            :never never)
                                          8
                                          budget
                                          a)
                  (Err [message] (panic "{}" message))
                  (Ok [output]
                      (let [(mut output) output
                            expected
                              (if (or (= kind 13)
                                      (= kind 16)
                                      never
                                      (<= budget 1)
                                      (not matching)
                                      (not compatible))
                                  (: 0 i32)
                                  1)]
                        (assert (= (.changes output) expected))
                        (when (and (= kind 17) (> expected 0))
                          (let [(mut found) false]
                            (for [i 0 (len (.constants (.graph output)))]
                              (when (> (get (.constant-spans (.graph output)) i)
                                       0)
                                (let [value (get (.constants (.graph output)) i)]
                                  (when (= (n/opcode value) 74)
                                    (match (strings/lookup (.strings (.graph output))
                                                           (cast i32
                                                                 (n/constant-bits value)))
                                      (None [] (panic "function name missing"))
                                      (Some [name]
                                            (when (= name "_inline_target")
                                              (assert (> (n/auxiliary value) 0))
                                              (match (strings/lookup (.strings (.graph output))
                                                                     (cast i32
                                                                           (n/auxiliary value)))
                                                (None []
                                                      (panic "function prototype missing"))
                                                (Some [bytes]
                                                      (assert (= bytes
                                                                 [(: 0 u8) 11 0]))))
                                              (set! found true))))))))
                            (assert found)))

                        (assert (= (n/opcode (get (.instructions caller)
                                                  (cast i64 called)))
                                   79))
                        (assert (= before-count (len (.instructions caller))))
                        (assert (= before-constants (len (.constants caller))))
                        (assert (= callee-count (len (.instructions callee))))
                        (assert (= (n/opcode (get (.instructions (.graph output))
                                                  (cast i64 called)))
                                   (if (= expected 0) 79 (if (= result 0) 0 68))))
                        (when (and (= expected 1) (or (= kind 4) (= kind 7)))
                          ; An explicit CALL value/control root must retain the
                          ; cloned STORE without relying on a separate RETURN root.
                          (match (inlining/optimize caller
                                                    [called]
                                                    called
                                                    (inlining/Callee
                                                      :name "_inline_leaf"
                                                      :graph callee
                                                      :entry start
                                                      :roots [exit]
                                                      :never false)
                                                    8
                                                    64
                                                    a)
                            (Err [message] (panic "{}" message))
                            (Ok [rooted]
                                (let [(mut rooted) rooted
                                      (mut marked)
                                        (live/mark (.graph rooted)
                                                   (slice (.roots rooted))
                                                   a)
                                      (mut stores) 0]
                                  (for [r
                                        before-count
                                        (len (.instructions (.graph rooted)))]
                                    (when (= (n/opcode (get (.instructions (.graph rooted))
                                                            r))
                                             93)
                                      (assert (get marked r))
                                      (set! stores (+ stores 1))))
                                  (assert (= stores 1))
                                  (free! (mut marked))
                                  (rewrite/release! (mut rooted))))))
                        (let [(mut original)
                                (owned-image (compile/image caller
                                                            entry
                                                            (slice roots)
                                                            "_inline_caller"
                                                            a))
                              (mut expanded)
                                (owned-image (compile/image (.graph output)
                                                            entry
                                                            (slice (.roots output))
                                                            "_inline_caller"
                                                            a))
                              (mut target-code) (inline-target-image)
                              (mut global) (image/create a)
                              (mut leaf)
                                (owned-image (compile/image callee
                                                            start
                                                            [exit]
                                                            "_inline_leaf"
                                                            a))]
                          (bytes/append32! (mut (.data global)) 73)
                          (bytes/append32! (mut (.data global)) 0)
                          (set! (.data-alignment global) 8)
                          (require (image/symbol! (mut global)
                                                  "_inline_global"
                                                  2
                                                  0))
                          (when (= expected 0)
                            (assert (= (slice (.text original))
                                       (slice (.text expanded))))
                            (assert (= (slice (.data original))
                                       (slice (.data expanded)))))
                          (for after [false true]
                            (match (link/compose [(if after expanded original)
                                                  leaf
                                                  global
                                                  target-code]
                                                 a)
                              (Err [message] (panic "{}" message))
                              (Ok [module]
                                  (let [(mut module) module]
                                    (match (jit/map-image (.image module) a)
                                      (Err [message] (panic "{}" message))
                                      (Ok [loaded]
                                          (let [(mut loaded) loaded
                                                index
                                                  (find (.image module)
                                                        "_inline_caller")
                                                address
                                                  (if (< index 0)
                                                      (panic "inline caller symbol missing")
                                                      (get (.addresses loaded)
                                                           (cast i64 index)))]
                                            (assert (>= index 0))
                                            (if floating
                                                (let [function
                                                        (primitive/cast (fnptr (cc/C)
                                                                               [f64]
                                                                               f64)
                                                                        (primitive/cast (ptr u8)
                                                                                        address))]
                                                  (for value [(: -100.0 f64)
                                                              -1.0
                                                              0.0
                                                              5.0
                                                              222.0]
                                                    (let [(mut answer)
                                                            (function value)]
                                                      (if (= kind 6)
                                                          (assert (= (load (primitive/cast (ptr u64)
                                                                                           (mut answer)))
                                                                     0x8000000000000000))
                                                          (assert (= answer
                                                                     (+ value
                                                                        3.0)))))))
                                                (if pointer
                                                    (let [(mut slot) (: 0 i64)]
                                                      (for value [-100 -1 0 5
                                                                  222]
                                                        (if (= kind 3)
                                                            (do
                                                              (set! slot value)
                                                              (let [function
                                                                      (primitive/cast (fnptr (cc/C)
                                                                                             [(ptr i64)]
                                                                                             i64)
                                                                                      (primitive/cast (ptr u8)
                                                                                                      address))]
                                                                (assert (= (function (primitive/cast (ptr i64)
                                                                                                     (mut slot)))
                                                                           value))))
                                                            (do
                                                              (set! slot 0)
                                                              (let [function
                                                                      (primitive/cast (fnptr (cc/C)
                                                                                             [(ptr i64)
                                                                                              i64]
                                                                                             i64)
                                                                                      (primitive/cast (ptr u8)
                                                                                                      address))]
                                                                (assert (= (function (primitive/cast (ptr i64)
                                                                                                     (mut slot))
                                                                                     value)
                                                                           value))
                                                                (assert (= slot
                                                                           value)))))))
                                                    (let [function
                                                            (primitive/cast (fnptr (cc/C)
                                                                                   [i64]
                                                                                   i64)
                                                                            (primitive/cast (ptr u8)
                                                                                            address))]
                                                      (for value [-4294967296
                                                                  -100 -1 0 5
                                                                  222 2147483648
                                                                  4294967295]
                                                        (if (= kind 17)
                                                            (let [answer
                                                                    (function value)
                                                                  target-index
                                                                    (find (.image module)
                                                                          "_inline_target")]
                                                              (assert (>= target-index
                                                                          0))
                                                              (assert (= (cast u64
                                                                               answer)
                                                                         (get (.addresses loaded)
                                                                              (cast i64
                                                                                    target-index))))
                                                              (let [target
                                                                      (primitive/cast (fnptr (cc/C)
                                                                                             []
                                                                                             i64)
                                                                                      (primitive/cast (ptr u8)
                                                                                                      answer))]
                                                                (assert (= (target)
                                                                           61))))
                                                            (assert (= (function value)
                                                                       (case kind
                                                                         0 73
                                                                         14 73
                                                                         15 73
                                                                         16
                                                                           4050765991979987505
                                                                         13
                                                                           (cast i64
                                                                                 (cast i32
                                                                                       value))
                                                                         12
                                                                           (cast i64
                                                                                 (cast i32
                                                                                       value))
                                                                         10
                                                                           (if (> value
                                                                                  0)
                                                                               (+ value
                                                                                  3)
                                                                               (- value
                                                                                  3))
                                                                         8
                                                                           (+ value
                                                                              3)
                                                                         2
                                                                           (+ value
                                                                              3)
                                                                         value))))))))
                                            (jit/release-image! (mut loaded)))))
                                    (link/release! (mut module))))))
                          (image/release! (mut original))
                          (image/release! (mut expanded))
                          (image/release! (mut leaf))
                          (image/release! (mut global))
                          (image/release! (mut target-code)))
                        (rewrite/release! (mut output)))))
                (calls/release! (mut signature)))))))
    (free! (mut roots))
    (free! (mut arguments))
    (free! (mut parameters))
    (free! (mut descriptors))
    (g/release! (mut caller))
    (g/release! (mut callee))))

(defn indirect-inline-case [(never bool) (budget i32)] (-> void)
  (let [a (malloc-allocator)
        (mut callee) (g/create a)
        (mut caller) (g/create a)
        start (require (b/emit! (mut callee) 104 0 [(: 0 i32)]))
        result (require (b/emit! (mut callee) 71 6 [start (: 0 i32) 0]))
        input (require (b/emit! (mut callee) 71 6 [start (: 0 i32) 1]))
        seed (require (b/emit! (mut callee) 71 5 [start (: 0 i32) 2]))
        one (require (b/scalar-constant! (mut callee) 5 1 8))
        eight (require (b/scalar-constant! (mut callee) 5 8 8))
        initial (require (b/emit! (mut callee) 91 5 [start input]))
        first (require (b/emit! (mut callee) 26 5 [initial seed]))
        written (require (b/emit! (mut callee) 93 0 [initial result first]))
        observed (require (b/emit! (mut callee) 91 5 [written input]))
        second (require (b/emit! (mut callee) 26 5 [observed one]))
        offset (require (b/emit! (mut callee) 26 6 [result eight]))
        final (require (b/emit! (mut callee) 93 0 [observed offset second]))
        exit (require (b/emit! (mut callee) 120 0 [final (: 0 i32) 0]))
        entry (require (b/emit! (mut caller) 104 0 [(: 0 i32)]))
        destination (require (b/emit! (mut caller) 71 6 [entry (: 0 i32) 0]))
        source (require (b/emit! (mut caller) 71 6 [entry (: 0 i32) 1]))
        value (require (b/emit! (mut caller) 71 5 [entry (: 0 i32) 2]))
        function (require (symbols/function! (mut caller) "_indirect_leaf" 0))]
    (match (calls/create-result 0 [(: 6 u8) 6 5] [] (results/indirect) a)
      (Err [message] (panic "{}" message))
      (Ok [prototype]
          (let [(mut prototype) prototype
                _ (require (calls/function! (mut callee) prototype a))
                called
                  (require (calls/emit! (mut caller)
                                        prototype
                                        entry
                                        function
                                        [destination source value]
                                        a))
                first (require (b/emit! (mut caller) 91 5 [called destination]))
                eight (require (b/scalar-constant! (mut caller) 5 8 8))
                offset (require (b/emit! (mut caller) 26 6 [destination eight]))
                second (require (b/emit! (mut caller) 91 5 [first offset]))
                answer (require (b/emit! (mut caller) 26 5 [first second]))
                done
                  (require (b/emit! (mut caller)
                                    120
                                    5
                                    [second answer (: 0 i32)]))]
            (match (calls/create 0 5 [(: 6 u8) 6 5] a)
              (Err [message] (panic "{}" message))
              (Ok [signature]
                  (let [(mut signature) signature]
                    (require (calls/function! (mut caller) signature a))
                    (calls/release! (mut signature)))))
            (let [before-count (len (.instructions caller))]
              (match (inlining/optimize caller
                                        [done called]
                                        called
                                        (inlining/Callee
                                          :name "_indirect_leaf"
                                          :graph callee
                                          :entry start
                                          :roots [exit]
                                          :never never)
                                        8
                                        budget
                                        a)
                (Err [message] (panic "{}" message))
                (Ok [expanded]
                    (let [(mut expanded) expanded
                          expected (if (or never (= budget 0)) (: 0 i32) 1)]
                      (assert (= (.changes expanded) expected))
                      (assert (= before-count (len (.instructions caller))))
                      (assert (= (n/opcode (get (.instructions caller)
                                                (cast i64 called)))
                                 79))
                      (let [(mut original)
                              (owned-image (compile/image-with-options caller
                                                                       entry
                                                                       [done
                                                                        called]
                                                                       "_indirect_caller"
                                                                       (options/Options
                                                                         :level
                                                                           3)
                                                                       a))
                            (mut output)
                              (owned-image (compile/image-with-options (.graph expanded)
                                                                       entry
                                                                       (slice (.roots expanded))
                                                                       "_indirect_caller"
                                                                       (options/Options
                                                                         :level
                                                                           3)
                                                                       a))
                            (mut leaf)
                              (owned-image (compile/image callee
                                                          start
                                                          [exit]
                                                          "_indirect_leaf"
                                                          a))]
                        (when (= expected 0)
                          (assert (= (slice (.text original))
                                     (slice (.text output))))
                          (assert (= (slice (.data original))
                                     (slice (.data output)))))
                        (for after [false true]
                          (match (link/compose [(if after output original) leaf]
                                               a)
                            (Err [message] (panic "{}" message))
                            (Ok [module]
                                (let [(mut module) module]
                                  (match (jit/map-image (.image module) a)
                                    (Err [message] (panic "{}" message))
                                    (Ok [mapped]
                                        (let [(mut mapped) mapped
                                              index
                                                (find (.image module)
                                                      "_indirect_caller")]
                                          (assert (>= index 0))
                                          (let [function
                                                  (primitive/cast (fnptr (cc/C)
                                                                         [(ptr u64)
                                                                          (ptr u64)
                                                                          u64]
                                                                         u64)
                                                                  (primitive/cast (ptr u8)
                                                                                  (get (.addresses mapped)
                                                                                       (cast i64
                                                                                             index))))
                                                (mut storage)
                                                  (ArrayList::new [u64] a)
                                                (mut separate) (: 73 u64)]
                                            (push! (mut storage) 11)
                                            (push! (mut storage) 22)
                                            (for alias [false true]
                                              (for seed [(: 0 u64) 3 17]
                                                (set! (mut storage) 0 11)
                                                (set! (mut storage) 1 22)
                                                (set! separate 73)
                                                (let [destination
                                                        (.data storage)
                                                      source
                                                        (if alias
                                                            destination
                                                            (primitive/cast (ptr u64)
                                                                            (mut separate)))
                                                      first
                                                        (+ (if alias
                                                               (: 11 u64)
                                                               73)
                                                           seed)
                                                      second
                                                        (if alias
                                                            (+ first 1)
                                                            (: 74 u64))]
                                                  (assert (= (function destination
                                                                       source
                                                                       seed)
                                                             (+ first second)))
                                                  (assert (= (get storage 0)
                                                             first))
                                                  (assert (= (get storage 1)
                                                             second)))))
                                            (free! (mut storage)))
                                          (jit/release-image! (mut mapped)))))
                                  (link/release! (mut module))))))
                        (image/release! (mut original))
                        (image/release! (mut output))
                        (image/release! (mut leaf)))
                      (rewrite/release! (mut expanded))))))
            (calls/release! (mut prototype)))))
    (g/release! (mut caller))
    (g/release! (mut callee))))

(defn main [] (-> i64)
  (indirect-inline-case false 64)
  (indirect-inline-case true 64)
  (indirect-inline-case false 0)
  (inline-case 17 false 64 true true)
  (inline-case 14 false 64 true true)
  (inline-case 15 false 64 true true)
  (inline-case 16 false 64 true true)
  (inline-case 13 false 64 true true)
  (inline-case 12 false 64 true true)
  (inline-case 12 true 64 true true)
  (inline-case 12 false 0 true true)
  (inline-case 0 false 1 true true)
  (inline-case 0 false 64 false true)
  (inline-case 0 false 64 true false)
  (for [kind 0 11]
    (inline-case (cast i32 kind) false 64 true true)
    (inline-case (cast i32 kind) true 64 true true)
    (inline-case (cast i32 kind) false 0 true true))
  (let [allocator (malloc-allocator)
        (mut data) (data-image)
        (mut a) (pair-image true)
        (mut b) (pair-image false)
        (mut via) (pointer-image)
        (mut table) (table-image)
        (mut prefix) (image/create allocator)
        (mut sources-live?) true
        (mut failures) 0]
    (bytes/append32! (mut (.text prefix)) 0xD65F03C0)
    (while (< (len (.text prefix)) 5004)
      (bytes/append32! (mut (.text prefix)) 0xD503201F))
    (while (< (len (.data prefix)) 8201)
      (push! (mut (.data prefix)) 0xCC))
    (require (image/local-symbol! (mut prefix) "L_same" 1 0))
    (match (link/compose [data b a via table] allocator)
      (Err [message]
           (println "inner: {}" message)
           (set! failures (+ failures 1)))
      (Ok [module]
          (let [(mut inner) module
                table-base (.text (get (.parts inner) 4))]
            (when (or (!= (len (.text-data (.image inner))) 1)
                      (!= (.offset (get (.text-data (.image inner)) 0))
                          (+ table-base (.offset (get (.text-data table) 0)))))
              (set! failures (+ failures 1)))
            (match (link/compose [prefix (.image inner)] allocator)
              (Err [message]
                   (println "outer: {}" message)
                   (set! failures (+ failures 1))
                   (link/release! (mut inner)))
              (Ok [composed]
                  (let [(mut outer) composed]
                    (when (or (!= (.text (get (.parts outer) 1)) 5004)
                              (!= (.data (get (.parts outer) 1)) 8208)
                              (!= (.offset (get (.text-data (.image outer)) 0))
                                  (+ 5004
                                     (.offset (get (.text-data (.image inner))
                                                   0)))))
                      (set! failures (+ failures 1)))
                    ; Destroy every original allocation before executing the outer
                    ; module: all bytes, names, maps and metadata must be owned.
                    (link/release! (mut inner))
                    (image/release! (mut data))
                    (image/release! (mut a))
                    (image/release! (mut b))
                    (image/release! (mut via))
                    (image/release! (mut table))
                    (image/release! (mut prefix))
                    (set! sources-live? false)
                    (set! failures (+ failures (run outer)))
                    (link/release! (mut outer))))))))
    (when sources-live?
      (image/release! (mut data))
      (image/release! (mut a))
      (image/release! (mut b))
      (image/release! (mut via))
      (image/release! (mut table))
      (image/release! (mut prefix)))
    (println "composed recursive functions, globals, pointers and tables: {} failures"
             failures)
    (if (= failures 0) 0 1)))
