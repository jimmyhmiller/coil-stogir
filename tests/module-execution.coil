                                                           (cast i64 index)))]
                                            (assert (>= index 0))
                                            (if floating
                                                (let [function
                                                        (primitive/cast (fnptr (cc/C)
                                                                               [f64]
                                                                               f64)
                                                                        (primitive/cast (ptr u8)
                                                                                        address))]
                                                  (for value [(: -100.0 f64)
                                                              -1.0
                                                              0.0
                                                              5.0
                                                              222.0]
                                                    (let [(mut answer)
                                                            (function value)]
                                                      (if (= kind 6)
                                                          (assert (= (load (primitive/cast (ptr u64)
                                                                                           (mut answer)))
                                                                     0x8000000000000000))
                                                          (assert (= answer
                                                                     (+ value
                                                                        3.0)))))))
                                                (if pointer
