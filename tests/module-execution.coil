                                                                                           value))
                                                                             12
                                                                               (cast i64
                                                                                     (cast i32
                                                                                           value))
                                                                             10
                                                                               (if (> value
                                                                                      0)
                                                                                   (+ value
                                                                                      3)
                                                                                   (- value
                                                                                      3))
                                                                             8
