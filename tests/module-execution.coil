                                                                  222]
                                                        (if (= kind 3)
                                                            (do
                                                              (set! slot value)
                                                              (let [function
                                                                      (primitive/cast (fnptr (cc/C)
                                                                                             [(ptr i64)]
                                                                                             i64)
                                                                                      (primitive/cast (ptr u8)
                                                                                                      address))]
                                                                (assert (= (function (primitive/cast (ptr i64)
                                                                                                     (mut slot)))
                                                                           value))))
                                                            (do
                                                              (set! slot 0)
                                                              (let [function
                                                                      (primitive/cast (fnptr (cc/C)
                                                                                             [(ptr i64)
                                                                                              i64]
                                                                                             i64)
                                                                                      (primitive/cast (ptr u8)
                                                                                                      address))]
                                                                (assert (= (function (primitive/cast (ptr i64)
                                                                                                     (mut slot))
                                                                                     value)
                                                                           value))
                                                                (assert (= slot
                                                                           value)))))))
                                                    (let [function
                                                            (primitive/cast (fnptr (cc/C)
                                                                                   [i64]
                                                                                   i64)
                                                                            (primitive/cast (ptr u8)
                                                                                            address))]
                                                      (for value [-4294967296
                                                                  -100 -1 0 5
                                                                  222 2147483648
                                                                  4294967295]
                                                        (if (and (= kind 23)
                                                                 (> value 0))
                                                            (assert (inline-trapped? function
                                                                                     value))
                                                            (if (= kind 17)
                                                                (let [answer
                                                                        (function value)
                                                                      target-index
                                                                        (find (.image module)
                                                                              "_inline_target")]
                                                                  (assert (>= target-index
                                                                              0))
                                                                  (assert (= (cast u64
                                                                                   answer)
                                                                             (get (.addresses loaded)
                                                                                  (cast i64
                                                                                        target-index))))
                                                                  (let [target
                                                                          (primitive/cast (fnptr (cc/C)
                                                                                                 []
                                                                                                 i64)
                                                                                          (primitive/cast (ptr u8)
                                                                                                          answer))]
                                                                    (assert (= (target)
                                                                               61))))
                                                                (assert (= (function value)
                                                                           (case kind
                                                                             25
                                                                               7
                                                                             24
                                                                               7
                                                                             23
                                                                               (+ value
                                                                                  3)
                                                                             21
                                                                               (+ value
                                                                                  61)
                                                                             22
                                                                               (+ value
                                                                                  61)
                                                                             19
                                                                               (+ value
                                                                                  61)
                                                                             20
                                                                               (let [n
                                                                                       (& value
                                                                                          31)]
                                                                                 (+ (* n
                                                                                       61)
                                                                                    (/ (* n
                                                                                          (- n
                                                                                             1))
                                                                                       2)))
                                                                             18
                                                                               (let [n
                                                                                       (& value
                                                                                          31)]
                                                                                 (/ (* n
                                                                                       (- n
                                                                                          1))
                                                                                    2))
                                                                             0
                                                                               73
                                                                             14
                                                                               73
                                                                             15
                                                                               73
                                                                             16
