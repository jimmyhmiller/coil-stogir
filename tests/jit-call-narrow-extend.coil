(module stogir.tests.jit-call-narrow-extend)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.a64.compile" :as compile)
(import "stogir.a64.encode" :as e)
(import "stogir.bytes" :as bytes)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn check [(target u64) (ty u8) (bits u64) (expected i64)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        callee (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        constant (require (b/scalar-constant! (mut graph) (cast i32 ty) bits 8))
        (mut failures) 0]
    (match (calls/create 0 11 [ty] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned-prototype) prototype
                call
                  (require (calls/emit! (mut graph)
                                        owned-prototype
                                        start
                                        callee
                                        [constant]
                                        allocator))
                ret (require (b/emit! (mut graph) 120 11 [call call (: 0 i32)]))]
            (match (compile/text graph start [ret] allocator)
              (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
              (Ok [compiled]
                  (let [(mut code) compiled]
                    (match (jit/map-text (slice code))
                      (Err [_] (set! failures (+ failures 1)))
                      (Ok [image]
                          (let [(mut owned) image
                                f
                                  (primitive/cast (fnptr (cc/C) [u64] i64)
                                                  (.base owned))
                                actual (call-ptr f target)]
                            (when (!= actual expected)
                              (println "type={} bits={} expected={} actual={}"
                                       ty
                                       bits
                                       expected
                                       actual)
                              (set! failures (+ failures 1)))
                            (jit/release! (mut owned)))))
                    (free! (mut code)))))
            (calls/release! (mut owned-prototype)))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut probe) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0]
    ; Darwin permits a callee to consume the already-extended 32-bit argument.
    ; Read W0 as signed i32: this detects omitted sign extension of constants,
    ; unlike a callee that explicitly truncates and re-extends its own input.
    (match (e/extend true true 32 0 0)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [word] (bytes/append32! (mut probe) word)))
    (match (e/ret 30)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [word] (bytes/append32! (mut probe) word)))
    (match (jit/map-text (slice probe))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [image]
          (let [(mut owned) image
                target (primitive/cast u64 (.base owned))]
            (set! failures
                  (+ failures
                     (check target 8 255 -1)
                     (check target 8 128 -128)
                     (check target 9 65535 -1)
                     (check target 9 32768 -32768)
                     (check target 7 255 -1)
                     (check target 2 255 255)
                     (check target 3 65535 65535)
                     (check target 1 1 1)
                     (check target 1 0 0)))
            (jit/release! (mut owned)))))
    (free! (mut probe))
    (println "narrow argument extension checks: {} failures" failures)
    (if (= failures 0) 0 1)))
