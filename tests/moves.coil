(module stogir.tests.moves)
(import "stogir.moves" :as m)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.result" :use [Ok Err])

(defn check [(copies (slice m/Move))] (-> i64)
  (let [(mut values) [(: 10 i32) 20 30 40 0]
        (mut failures) 0]
    (match (m/resolve copies 4 (malloc-allocator))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [moves]
          (let [(mut owned) moves]
            (for move owned
              (set! (mut values)
                    (cast i64 (.destination move))
                    (get values (cast i64 (.source move)))))
            (for copy copies
              (when (!= (get values (cast i64 (.destination copy)))
                        (* (+ (.source copy) 1) 10))
                (set! failures (+ failures 1))))
            (free! (mut owned)))))
    failures))

(defn exhaustive [] (-> i64)
  (let [(mut failures) 0
        (mut code) (: 0 i32)]
    (while (< code 256)
      (let [a (& code 3)
            b (& (>> code 2) 3)
            c (& (>> code 4) 3)
            d (& (>> code 6) 3)]
        (set! failures
              (+ failures
                 (check [(m/Move :source a :destination 0)
                         (m/Move :source b :destination 1)
                         (m/Move :source c :destination 2)
                         (m/Move :source d :destination 3)]))))
      (set! code (+ code 1)))
    (match (m/resolve [(m/Move :source 4 :destination 0)] 4 (malloc-allocator))
      (Err [_] 0)
      (Ok [moves]
          (let [(mut owned) moves]
            (set! failures (+ failures 1))
            (free! (mut owned)))))
    (match (m/resolve [(m/Move :source 0 :destination 4)] 4 (malloc-allocator))
      (Err [_] 0)
      (Ok [moves]
          (let [(mut owned) moves]
            (set! failures (+ failures 1))
            (free! (mut owned)))))
    (match (m/resolve [(m/Move :source 0 :destination 1)
                       (m/Move :source 2 :destination 1)]
                      4
                      (malloc-allocator))
      (Err [_] 0)
      (Ok [moves]
          (let [(mut owned) moves]
            (set! failures (+ failures 1))
            (free! (mut owned)))))
    failures))

(defn byte-pattern [(index i64)] (-> u8)
  (cast u8 (+ (* index 37) (/ index 7) 19)))

(defn sized-check [(copies (slice m/SizedMove))] (-> i64)
  (let [allocator (malloc-allocator)
        (mut values) (ArrayList::new [u8] allocator)
        (mut expected) (ArrayList::new [u8] allocator)
        (mut i) (: 0 i64)
        (mut failures) 0]
    (while (< i 64)
      (push! (mut values) (byte-pattern i))
      (push! (mut expected) (byte-pattern i))
      (set! i (+ i 1)))
    (for copy copies
      (set! i 0)
      (while (< i (cast i64 (.size copy)))
        (p/store! (p/index (.data expected)
                           (+ (* (cast i64 (.destination copy)) 16) i))
                  (byte-pattern (+ (* (cast i64 (.source copy)) 16) i)))
        (set! i (+ i 1))))
    (match (m/resolve-sized copies 3 allocator)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [plan]
          (let [(mut plan) plan]
            (for move plan
              (set! i 0)
              (while (< i (cast i64 (.size move)))
                (p/store! (p/index (.data values)
                                   (+ (* (cast i64 (.destination move)) 16) i))
                          (get values (+ (* (cast i64 (.source move)) 16) i)))
                (set! i (+ i 1))))
            (set! i 0)
            (while (< i 48)
              (when (!= (get values i) (get expected i))
                (set! failures (+ failures 1)))
              (set! i (+ i 1)))
            (free! (mut plan)))))
    (free! (mut values))
    (free! (mut expected))
    failures))

(defn sized-exhaustive [] (-> i64)
  (let [(mut failures) 0
        (mut sources) (: 0 i32)]
    (while (< sources 27)
      (let [(mut widths) (: 0 i32)]
        (while (< widths 27)
          (set! failures
                (+ failures
                   (sized-check [(m/SizedMove
                                   :source (% sources 3)
                                   :destination 0
                                   :size (<< (: 4 i32) (% widths 3)))
                                 (m/SizedMove
                                   :source (% (/ sources 3) 3)
                                   :destination 1
                                   :size (<< (: 4 i32) (% (/ widths 3) 3)))
                                 (m/SizedMove
                                   :source (/ sources 9)
                                   :destination 2
                                   :size (<< (: 4 i32) (/ widths 9)))])))
          (set! widths (+ widths 1))))
      (set! sources (+ sources 1)))
    (for copies [[(m/SizedMove
                    :source 0
                    :destination 1
                    :size 0)]
                 [(m/SizedMove
                    :source 0
                    :destination 1
                    :size -1)]
                 [(m/SizedMove
                    :source 3
                    :destination 0
                    :size 16)]
                 [(m/SizedMove
                    :source 0
                    :destination 3
                    :size 4)]]
      (match (m/resolve-sized copies 3 (malloc-allocator))
        (Err [_] 0)
        (Ok [plan]
            (let [(mut plan) plan]
              (free! (mut plan))
              (set! failures (+ failures 1))))))
    (match (m/resolve-sized [(m/SizedMove
                               :source 0
                               :destination 1
                               :size 4)
                             (m/SizedMove
                               :source 2
                               :destination 1
                               :size 16)]
                            3
                            (malloc-allocator))
      (Err [_] 0)
      (Ok [plan]
          (let [(mut plan) plan]
            (free! (mut plan))
            (set! failures (+ failures 1)))))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (exhaustive)
             (sized-exhaustive)
             (check [(m/Move :source 0 :destination 1)
                     (m/Move :source 1 :destination 0)])
             (check [(m/Move :source 0 :destination 1)
                     (m/Move :source 1 :destination 2)
                     (m/Move :source 2 :destination 0)])
             (check [(m/Move :source 0 :destination 1)
                     (m/Move :source 0 :destination 2)
                     (m/Move :source 2 :destination 3)])
             (check [(m/Move :source 0 :destination 0)
                     (m/Move :source 1 :destination 2)]))]
    (println "parallel move checks: {} failures" failures)
    (if (= failures 0) 0 1)))
