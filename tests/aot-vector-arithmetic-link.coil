(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row EXERCISE-CASES
      (set! failures
            (+ failures
               (exercise (.ty row)
                         (.opcode row)
                         (.mode row)
                         (p/cast (ptr u8) (.address row))))))
    (for row PRESSURE-EXERCISE-CASES
      (set! failures
            (+ failures
               (pressure-exercise (.ty row)
                                  (.opcode row)
                                  (p/cast (ptr u8) (.address row))))))
    (for row EXERCISE-CASES-2
      (set! failures
            (+ failures
               (exercise (.ty row)
                         (.opcode row)
                         (.mode row)
                         (p/cast (ptr u8) (.address row))))))
    (for row PRESSURE-EXERCISE-CASES-2
      (set! failures
            (+ failures
               (pressure-exercise (.ty row)
                                  (.opcode row)
                                  (p/cast (ptr u8) (.address row))))))
    (println "linked vector binary arithmetic and logical matrix: {} failures"
             failures)
    (if (= failures 0) 0 1)))
