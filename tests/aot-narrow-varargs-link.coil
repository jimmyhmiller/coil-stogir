(module stogir.tests.aot-narrow-varargs-link)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern snprintf :cc (cc/C) [(ptr u8) u64 (ptr i8) ...] (-> i32))

(extern stogir.narrow-varargs-test
        :as
        "stogir_narrow_varargs_test"
        :cc
        (cc/C)
        [u64 (ptr u8) (ptr i8) i32 i32]
        (-> i32))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        address
          (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of snprintf)))
        (mut actual) (ArrayList::new [u8] allocator)
        (mut expected) (ArrayList::new [u8] allocator)
        (mut i) 0
        (mut failures) 0]
    (while (< i 128)
      (push! (mut actual) 0)
      (push! (mut expected) 0)
      (set! i (+ i 1)))
    (for x [(: -2147483648 i32) -100 -1 0 1 100 2147483647]
      (for y [(: -2147483648 i32) -100 -1 0 1 100 2147483647]
        (let [reference
                (snprintf (elem (mut expected) 0)
                          128
                          c"%d|%d|%d|%d|%d|%d"
                          (cast i32 (cast i8 x))
                          (cast i32 (cast u8 x))
                          (cast i32 (cast i16 y))
                          (cast i32 (cast u16 y))
                          (cast i32 (cast i8 x))
                          (if (= x y) (: 1 i32) 0))
              result
                (stogir.narrow-varargs-test address
                                            (elem (mut actual) 0)
                                            c"%d|%d|%d|%d|%d|%d"
                                            x
                                            y)]
          (when (!= reference result) (set! failures (+ failures 1)))
          (set! i 0)
          (while (< i 128)
            (when (!= (get actual i) (get expected i))
              (set! failures (+ failures 1)))
            (set! i (+ i 1))))))
    (free! (mut actual))
    (free! (mut expected))
    (println "linked AOT narrow variadic call checks: {} failures" failures)
    (if (= failures 0) 0 1)))
