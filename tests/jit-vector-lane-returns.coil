(module stogir.tests.jit-vector-lane-returns)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.simd" :as v)
(import "stogir.types" :as types)
(import "stogir.target" :as target)

(defstruct Lane8 [(bits (vec u64 1))])

(defstruct Lane16 [(bits (vec u64 2))])

(defn pattern [(base i32) (lane i64) (seed i64) (right? bool)] (-> u64)
  (let [i (% (+ lane (if right? (/ seed 11) (% seed 11))) 11)
        fp? (types/floating? base)
        wide? (= base 12)]
    (if fp?
        (if wide?
            (match i
              (0 (: 0 u64))
              (1 0x8000000000000000)
              (2 0x3FF0000000000000)
              (3 0xBFF0000000000000)
              (4 1)
              (5 0x000FFFFFFFFFFFFF)
              (6 0x7FEFFFFFFFFFFFFF)
              (7 0x7FF0000000000000)
              (8 0xFFF0000000000000)
              (9 0x7FF8123456789ABC)
              (_ 0x7FF0123456789ABC))
            (match i
              (0 (: 0 u64))
              (1 0x80000000)
              (2 0x3F800000)
              (3 0xBF800000)
              (4 1)
              (5 0x007FFFFF)
              (6 0x7F7FFFFF)
              (7 0x7F800000)
              (8 0xFF800000)
              (9 0x7FC12345)
              (_ 0x7F812345)))
        (match i
          (0 (: 0 u64))
          (1 1)
          (2 0xFFFFFFFFFFFFFFFF)
          (3 (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1))))
          (4 (- (<< (: 1 u64) (cast u64 (- (* 8 (types/scalar-size base 8)) 1)))
                1))
          (5 0x8080808080808080)
          (6 0x7F7F7F7F7F7F7F7F)
          (7 0xFFFF0000FFFF0000)
          (8 0x123456789ABCDEF0)
          (9 0xFFFFFFFFFFFFFFFE)
          (_ 0x0102030405060708)))))

(defn input-byte [(base i32) (index i64) (seed i64) (right? bool)] (-> u8)
  (let [width (cast i64 (types/scalar-size base 8))]
    (cast u8
          (>> (pattern base (/ index width) seed right?)
              (cast u64 (* (% index width) 8))))))

(defn read-word [(buffer (slice u8)) (offset i64) (width i32)] (-> u64)
  (let [(mut result) (: 0 u64)
        (mut i) (: 0 i32)]
    (while (< i width)
      (set! result
            (| result
               (<< (cast u64 (get buffer (+ offset (cast i64 i))))
                   (cast u64 (* i 8)))))
      (set! i (+ i 1)))
    result))

(defn mask-width [(ty i32)] (-> u64)
  (cast u64 (- (<< (: 1 u128) (cast u128 (* 8 (types/scalar-size ty 8)))) 1)))

(defn count-value [(ty i32) (test i32)] (-> u64)
  (let [raw
          (match test
            (0 (: 0 u64))
            (1 1)
            (2 2)
            (3 3)
            (4 4)
            (5 7)
            (6 8)
            (7 15)
            (8 16)
            (9 31)
            (10 32)
            (11 63)
            (12 64)
            (13 127)
            (14 128)
            (15 255)
            (16 256)
            (17 0x100000001)
            (18 0x8000000000000000)
            (19 0xFFFFFFFFFFFFFFFF)
            (20 0xFFFFFFFFFFFFFFFE)
            (_ 0x123456789ABCDEF0))]
    (& raw (mask-width ty))))

(defn returned-call [(ty i32)
                     (op i32)
                     (address (ptr u8))
                     (input (slice u8))
                     (fresh u64)
                     (index u64)
                     (output (ptr u64))] (-> void)
  (let [(mut scalar32) (: 0.0 f32)
        (mut scalar64) (: 0.0 f64)
        d (Lane8 :bits (v/vsplat [u64 1] (read-word input 0 8)))
        q
          (Lane16
            :bits
              (v/vinsert (v/vsplat [u64 2] (read-word input 0 8))
                         1
                         (read-word input 8 8)))]
    (p/store! (p/cast (ptr u32) (mut scalar32)) (cast u32 fresh))
    (p/store! (p/cast (ptr u64) (mut scalar64)) fresh)
    (when (= ty 45)
      (when (= op 61)
        (let [f (p/cast (fnptr (cc/C) [Lane8 u64] f32) address)
              result (call-ptr f d index)]
          (p/store! (p/cast (ptr f32) output) result)))
      (when (= op 62)
        (let [f (p/cast (fnptr (cc/C) [f32 Lane8 u64] Lane8) address)
              result (call-ptr f scalar32 d index)]
          (p/store! output (v/vextract (.bits result) 0))))
      (when (= op 63)
        (let [f (p/cast (fnptr (cc/C) [f32] Lane8) address)
              result (call-ptr f scalar32)]
          (p/store! output (v/vextract (.bits result) 0)))))
    (when (= ty 61)
      (when (= op 61)
        (let [f (p/cast (fnptr (cc/C) [Lane16 u64] f32) address)
              result (call-ptr f q index)]
          (p/store! (p/cast (ptr f32) output) result)))
      (when (= op 62)
        (let [f (p/cast (fnptr (cc/C) [f32 Lane16 u64] Lane16) address)
              result (call-ptr f scalar32 q index)]
          (p/store! output (v/vextract (.bits result) 0))
          (p/store! (p/index output 1) (v/vextract (.bits result) 1))))
      (when (= op 63)
        (let [f (p/cast (fnptr (cc/C) [f32] Lane16) address)
              result (call-ptr f scalar32)]
          (p/store! output (v/vextract (.bits result) 0))
          (p/store! (p/index output 1) (v/vextract (.bits result) 1)))))
    (when (= ty 28)
      (when (= op 61)
        (let [f (p/cast (fnptr (cc/C) [Lane8 u64] f64) address)
              result (call-ptr f d index)]
          (p/store! (p/cast (ptr f64) output) result)))
      (when (= op 62)
        (let [f (p/cast (fnptr (cc/C) [f64 Lane8 u64] Lane8) address)
              result (call-ptr f scalar64 d index)]
          (p/store! output (v/vextract (.bits result) 0))))
      (when (= op 63)
        (let [f (p/cast (fnptr (cc/C) [f64] Lane8) address)
              result (call-ptr f scalar64)]
          (p/store! output (v/vextract (.bits result) 0)))))
    (when (= ty 44)
      (when (= op 61)
        (let [f (p/cast (fnptr (cc/C) [Lane16 u64] f64) address)
              result (call-ptr f q index)]
          (p/store! (p/cast (ptr f64) output) result)))
      (when (= op 62)
        (let [f (p/cast (fnptr (cc/C) [f64 Lane16 u64] Lane16) address)
              result (call-ptr f scalar64 q index)]
          (p/store! output (v/vextract (.bits result) 0))
          (p/store! (p/index output 1) (v/vextract (.bits result) 1))))
      (when (= op 63)
        (let [f (p/cast (fnptr (cc/C) [f64] Lane16) address)
              result (call-ptr f scalar64)]
          (p/store! output (v/vextract (.bits result) 0))
          (p/store! (p/index output 1) (v/vextract (.bits result) 1)))))))

(defn exercise [(ty i32) (op i32) (lane i32) (address (ptr u8))] (-> i64)
  (let [width (types/size ty 8)
        base (types/base-type ty)
        element (types/scalar-size base 8)
        (mut input) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0
        (mut seed) (: 0 i64)]
    (while (< seed 11)
      (clear! (mut input))
      (let [(mut byte) (: 0 i64)]
        (while (< byte 16)
          (push! (mut input) (input-byte base byte seed false))
          (set! byte (+ byte 1))))
      (let [(mut test) (: 0 i32)]
        (while (< test (if (< lane 0) 22 1))
          (let [index (count-value 5 test)
                selected (if (< lane 0) index (cast u64 lane))
                valid? (< selected (cast u64 (types/lanes ty)))
                fresh (& (pattern base 0 (+ seed 5) false) (mask-width base))
                (mut got) [(: 0 u64) 0]
                (mut byte) (: 0 i64)]
            (returned-call ty op address (slice input) fresh index (data got))
            (while (< byte 16)
              (let [wanted
                      (if (>= byte (cast i64 (if (= op 61) element width)))
                          (: 0 u8)
                          (if (= op 61)
                              (if valid?
                                  (get input
                                       (+ (* (cast i64 selected)
                                             (cast i64 element))
                                          byte))
                                  (: 0 u8))
                              (if (or (= op 63)
                                      (and valid?
                                           (= (/ byte (cast i64 element))
                                              (cast i64 selected))))
                                  (cast u8
                                        (>> fresh
                                            (cast u64
                                                  (* (% byte (cast i64 element))
                                                     8))))
                                  (get input byte))))
                    actual (p/load (p/index (p/cast (ptr u8) (data got)) byte))]
                (when (!= actual wanted)
                  (when (< failures 6)
                    (println "lane return ty{} op{} lane{} seed{} test{} byte{} got{} expected{}"
                             ty
                             op
                             lane
                             seed
                             test
                             byte
                             actual
                             wanted))
                  (set! failures (+ failures 1))))
              (set! byte (+ byte 1))))
          (set! test (+ test 1))))
      (set! seed (+ seed 1)))
    (free! (mut input))
    failures))

(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.native.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn fixture-name [(id i32)] (-> (slice u8))
  (match id
    (0 (target/os-pick "_stogir_vector_lane_return_0" "stogir_vector_lane_return_0"))
    (1 (target/os-pick "_stogir_vector_lane_return_1" "stogir_vector_lane_return_1"))
    (2 (target/os-pick "_stogir_vector_lane_return_2" "stogir_vector_lane_return_2"))
    (3 (target/os-pick "_stogir_vector_lane_return_3" "stogir_vector_lane_return_3"))
    (4 (target/os-pick "_stogir_vector_lane_return_4" "stogir_vector_lane_return_4"))
    (5 (target/os-pick "_stogir_vector_lane_return_5" "stogir_vector_lane_return_5"))
    (6 (target/os-pick "_stogir_vector_lane_return_6" "stogir_vector_lane_return_6"))
    (7 (target/os-pick "_stogir_vector_lane_return_7" "stogir_vector_lane_return_7"))
    (8 (target/os-pick "_stogir_vector_lane_return_8" "stogir_vector_lane_return_8"))
    (9 (target/os-pick "_stogir_vector_lane_return_9" "stogir_vector_lane_return_9"))
    (10 (target/os-pick "_stogir_vector_lane_return_10" "stogir_vector_lane_return_10"))
    (11 (target/os-pick "_stogir_vector_lane_return_11" "stogir_vector_lane_return_11"))
    (12 (target/os-pick "_stogir_vector_lane_return_12" "stogir_vector_lane_return_12"))
    (13 (target/os-pick "_stogir_vector_lane_return_13" "stogir_vector_lane_return_13"))
    (14 (target/os-pick "_stogir_vector_lane_return_14" "stogir_vector_lane_return_14"))
    (15 (target/os-pick "_stogir_vector_lane_return_15" "stogir_vector_lane_return_15"))
    (16 (target/os-pick "_stogir_vector_lane_return_16" "stogir_vector_lane_return_16"))
    (17 (target/os-pick "_stogir_vector_lane_return_17" "stogir_vector_lane_return_17"))
    (18 (target/os-pick "_stogir_vector_lane_return_18" "stogir_vector_lane_return_18"))
    (19 (target/os-pick "_stogir_vector_lane_return_19" "stogir_vector_lane_return_19"))
    (_ "invalid")))

(defn fixture-path [(id i32)] (-> (slice u8))
  (match id
    (0 "/tmp/coil-stogir-vector-lane-return-0.o")
    (1 "/tmp/coil-stogir-vector-lane-return-1.o")
    (2 "/tmp/coil-stogir-vector-lane-return-2.o")
    (3 "/tmp/coil-stogir-vector-lane-return-3.o")
    (4 "/tmp/coil-stogir-vector-lane-return-4.o")
    (5 "/tmp/coil-stogir-vector-lane-return-5.o")
    (6 "/tmp/coil-stogir-vector-lane-return-6.o")
    (7 "/tmp/coil-stogir-vector-lane-return-7.o")
    (8 "/tmp/coil-stogir-vector-lane-return-8.o")
    (9 "/tmp/coil-stogir-vector-lane-return-9.o")
    (10 "/tmp/coil-stogir-vector-lane-return-10.o")
    (11 "/tmp/coil-stogir-vector-lane-return-11.o")
    (12 "/tmp/coil-stogir-vector-lane-return-12.o")
    (13 "/tmp/coil-stogir-vector-lane-return-13.o")
    (14 "/tmp/coil-stogir-vector-lane-return-14.o")
    (15 "/tmp/coil-stogir-vector-lane-return-15.o")
    (16 "/tmp/coil-stogir-vector-lane-return-16.o")
    (17 "/tmp/coil-stogir-vector-lane-return-17.o")
    (18 "/tmp/coil-stogir-vector-lane-return-18.o")
    (19 "/tmp/coil-stogir-vector-lane-return-19.o")
    (_ "invalid")))

(defn generate [(ty i32) (op i32) (lane i32) (id i32)] (-> i64)
  (let [alc (malloc-allocator)
        (mut graph) (g/create alc)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        base (types/base-type ty)
        result-type (if (= op 61) base ty)
        (mut parameters) (ArrayList::new [u8] alc)
        (mut scalar) (: 0 i32)
        (mut vector) (: 0 i32)
        (mut index) (: 0 i32)
        (mut ordinal) (: 0 i32)
        (mut failures) 0]
    (when (!= op 61)
      (set! scalar
            (require (b/emit! (mut graph) 71 base [start (: 0 i32) ordinal])))
      (push! (mut parameters) (cast u8 base))
      (set! ordinal (+ ordinal 1)))
    (when (!= op 63)
      (set! vector
            (require (b/emit! (mut graph) 71 ty [start (: 0 i32) ordinal])))
      (push! (mut parameters) (cast u8 ty))
      (set! ordinal (+ ordinal 1))
      (set! index
            (require (b/emit! (mut graph) 71 5 [start (: 0 i32) ordinal])))
      (push! (mut parameters) 5)
      (when (>= lane 0)
        (set! index
              (require (b/scalar-constant! (mut graph) 5 (cast u64 lane) 8)))))
    (match (calls/create (target/arch-pick 9 8) (cast u8 result-type) (slice parameters) alc)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (require (calls/function! (mut graph) prototype alc))
            (calls/release! (mut prototype)))))
    (let [result
            (require (if (= op 61)
                         (b/vector-extract! (mut graph) base 8 vector index)
                         (if (= op 62)
                             (b/vector-replace! (mut graph)
                                                ty
                                                8
                                                vector
                                                index
                                                scalar)
                             (b/vector-splat! (mut graph) ty 8 scalar))))
          ret
            (require (b/emit! (mut graph)
                              120
                              result-type
                              [start result (: 0 i32)]))]
      (match (compile/object graph start [ret] (fixture-name id) alc)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [object]
            (let [(mut object) object]
              (match (fs/write-file alc (fixture-path id) (slice object))
                (Err [_] (set! failures (+ failures 1)))
                (Ok [_] 0))
              (free! (mut object)))))
      (match (compile/image graph start [ret] (target/os-pick "_lane_return_jit" "lane_return_jit") alc)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [source]
            (let [(mut source) source]
              (match (jit/map-image source alc)
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [loaded]
                    (let [(mut loaded) loaded]
                      (set! failures
                            (+ failures
                               (exercise ty op lane (.base (.memory loaded)))))
                      (jit/release-image! (mut loaded)))))
              (image/release! (mut source))))))
    (free! (mut parameters))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (set! failures (+ failures (generate 45 61 -1 0)))
    (set! failures (+ failures (generate 45 61 1 1)))
    (set! failures (+ failures (generate 45 62 -1 2)))
    (set! failures (+ failures (generate 45 62 1 3)))
    (set! failures (+ failures (generate 45 63 0 4)))
    (set! failures (+ failures (generate 61 61 -1 5)))
    (set! failures (+ failures (generate 61 61 3 6)))
    (set! failures (+ failures (generate 61 62 -1 7)))
    (set! failures (+ failures (generate 61 62 3 8)))
    (set! failures (+ failures (generate 61 63 0 9)))
    (set! failures (+ failures (generate 28 61 -1 10)))
    (set! failures (+ failures (generate 28 61 0 11)))
    (set! failures (+ failures (generate 28 62 -1 12)))
    (set! failures (+ failures (generate 28 62 0 13)))
    (set! failures (+ failures (generate 28 63 0 14)))
    (set! failures (+ failures (generate 44 61 -1 15)))
    (set! failures (+ failures (generate 44 61 1 16)))
    (set! failures (+ failures (generate 44 62 -1 17)))
    (set! failures (+ failures (generate 44 62 1 18)))
    (set! failures (+ failures (generate 44 63 0 19)))
    (println "typed floating lane returns: 20 graphs; failures {}" failures)
    failures))
