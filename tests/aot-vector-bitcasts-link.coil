(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for row EXERCISE-CASES
      (set! failures
            (+ failures
               (exercise (.src row) (.dst row) (p/cast (ptr u8) (.address row))))))
    (println "linked native vector bitcasts: 442 graphs, {} failures" failures)
    (if (= failures 0) 0 1)))
