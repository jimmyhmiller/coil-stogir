(module stogir.tests.aot-vector-bitcasts-link)
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "stogir.types" :as types)
(import "stogir.test-data" :use [table link-entries])

(defn sample [(seed i32)] (-> u64)
  (match (% seed 12)
    (0 (: 0 u64))
    (1 0xFFFFFFFFFFFFFFFF)
    (2 0x8000000000000000)
    (3 0x7FF0000000000042)
    (4 0xFFF8123456789ABC)
    (5 0x7F800042FFC12345)
    (6 0x0000000000000001)
    (7 0x7FF0000000000000)
    (8 0xFFF0000000000000)
    (9 0x0123456789ABCDEF)
    (10 0x808180FF01000203)
    (_ 0xFFFFFFFF00000000)))

(defn byte-at [(seed i32) (index i64)] (-> u8)
  (cast u8 (>> (sample seed) (* (cast u64 (% index 8)) 8))))

(defn exercise [(src i32) (dst i32) (address (ptr u8))] (-> i64)
  (let [f (p/cast (fnptr (cc/C) [(ptr u8) (ptr u8)] u64) address)
        (mut input) (ArrayList::new [u8] (malloc-allocator))
        (mut output) (ArrayList::new [u8] (malloc-allocator))
        (mut failures) 0
        (mut i) (: 0 i64)
        (mut seed) (: 0 i32)
        width (cast i64 (types/size src 8))]
    (while (< i 64)
      (push! (mut input) (: 90 u8))
      (push! (mut output) (: 165 u8))
      (set! i (+ i 1)))
    (while (< seed 12)
      (set! i 0)
      (while (< i 64)
        (set! (mut input) i (byte-at seed i))
        (set! (mut output) i (: 165 u8))
        (set! i (+ i 1)))
      (when (!= (call-ptr f (.data output) (p/index (.data input) 1)) 0)
        (set! failures (+ failures 1)))
      (set! i 0)
      (while (< i 64)
        (let [wanted
                (cond (and (>= i 1) (< i (+ 1 width))) (byte-at seed i)
                      (and (>= i 17) (< i (+ 17 width))) (byte-at src (- i 17))
                      (and (>= i 33) (< i (+ 33 width))) (byte-at seed (- i 32))
                      :else (: 165 u8))]
          (when (or (!= (get output i) wanted)
                    (!= (get input i) (byte-at seed i)))
            (println "bitcast {} -> {} seed{} byte{} expected{} actual{}"
                     src
                     dst
                     seed
                     i
                     wanted
                     (get output i))
            (set! failures (+ failures 1))))
        (set! i (+ i 1)))
      (set! seed (+ seed 1)))
    (free! (mut input))
    (free! (mut output))
    failures))

(meta (link-entries `entry
                    "stogir_vector_bitcast_"
                    0
                    442
                    `[(ptr u8) (ptr u8)]
                    `u64))

(defstruct ExerciseCase
  [(src i32) (dst i32) (address (fnptr (cc/C) [(ptr u8) (ptr u8)] u64))])

