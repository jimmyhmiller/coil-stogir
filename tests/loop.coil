(module stogir.tests.loop)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.verify" :as v)
(import "stogir.liveness" :as l)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [value] value) (Err [msg] (do (println "{}" msg) 0))))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        entry (require (b/emit! (mut graph) 114 0 [start]))
        loop (require (b/loop-begin! (mut graph) entry))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        phi (require (b/loop-phi! (mut graph) loop zero))
        next (require (b/integer-binary! (mut graph) 26 11 8 phi one))
        backedge (require (b/emit! (mut graph) 115 0 [loop]))
        (mut failures) 0]
    (match (v/structure graph)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (when (= (require (b/patch! (mut graph) loop 2 backedge)) 0)
      (set! failures (+ failures 1)))
    (when (= (require (b/patch! (mut graph) phi 3 next)) 0)
      (set! failures (+ failures 1)))
    (match (v/structure graph)
      (Ok [_] 0)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1)))))
    (match (v/phis graph)
      (Ok [count] (when (!= count 1) (set! failures (+ failures 1))))
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1)))))
    (let [(mut live) (l/mark graph [phi] (malloc-allocator))]
      (when (not (get live (cast i64 next))) (set! failures (+ failures 1)))
      (when (not (get live (cast i64 backedge))) (set! failures (+ failures 1)))
      (free! (mut live)))
    (let [wrong (require (b/scalar-constant! (mut graph) 2 0 8))]
      (b/patch! (mut graph) phi 3 wrong)
      (match (v/phis graph)
        (Ok [_] (set! failures (+ failures 1)))
        (Err [_] 0)))
    (b/patch! (mut graph) phi 3 next)
    (b/patch! (mut graph) phi 1 start)
    (match (v/phis graph)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (b/patch! (mut graph) phi 1 loop)
    (match (g/append-inputs! (mut graph) 67 11 [loop zero next one])
      (Some [_]
            (match (v/phis graph)
              (Ok [_] (set! failures (+ failures 1)))
              (Err [_] 0)))
      (None [] (set! failures (+ failures 1))))
    (g/release! (mut graph))
    (println "loop checks: {} failures" failures)
    (if (= failures 0) 0 1)))
