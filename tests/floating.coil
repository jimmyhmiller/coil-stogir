(module stogir.tests.floating)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.floating" :as floating)
(import "stogir.node" :as n)
(import "stogir.verify" :as verify)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err Some None])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn rejected [(result (Result i32 (slice u8)))] (-> i64)
  (match result (Ok [_] 1) (Err [_] 0)))

(defn folded [(opcode i32) (ty i32) (a u64) (b u64) (wanted u64)] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))
        left (require (b/scalar-constant! (mut graph) ty a 8))
        right (require (b/scalar-constant! (mut graph) ty b 8))
        result (require (b/floating! (mut graph) opcode ty left right 0))
        (mut failures) 0]
    (match (g/lookup graph result)
      (None [] (set! failures (+ failures 1)))
      (Some [node]
            (when (or (>= result 0) (!= (n/constant-bits node) wanted))
              (set! failures (+ failures 1)))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures)
          (+ (folded 26
                     12
                     0x4018000000000000
                     0x4000000000000000
                     0x4020000000000000)
             (folded 27
                     12
                     0x4018000000000000
                     0x4000000000000000
                     0x4010000000000000)
             (folded 28
                     12
                     0x4018000000000000
                     0x4000000000000000
                     0x4028000000000000)
             (folded 29
                     12
                     0x4018000000000000
                     0x4000000000000000
                     0x4008000000000000)
             (folded 26 13 0x40C00000 0x40000000 0x41000000)
             (folded 27 13 0x40C00000 0x40000000 0x40800000)
             (folded 28 13 0x40C00000 0x40000000 0x41400000)
             (folded 29 13 0x40C00000 0x40000000 0x40400000)
             (folded 29 12 0x3FF0000000000000 0 0x7FF0000000000000)
             (folded 29 13 0x3F800000 0x80000000 0xFF800000)
             (folded 31 12 0x7FF0123456789ABC 0 0xFFF0123456789ABC)
             (folded 32 13 0xFF812345 0 0x7F812345)
             (folded 58 12 0 0x8000000000000000 0)
             (folded 58 12 0x8000000000000000 0 0x8000000000000000)
             (folded 59 13 0x3F800000 0x7FC12345 0x7FC12345))
        (mut graph) (g/create (malloc-allocator))
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 12 [start (: 0 i32) 1]))
        first (require (b/floating! (mut graph) 58 12 p q 0))
        same (require (b/floating! (mut graph) 58 12 p q 0))
        reversed (require (b/floating! (mut graph) 58 12 q p 0))
        guarded (require (b/floating! (mut graph) 29 12 p q start))
        unguarded (require (b/floating! (mut graph) 29 12 p q 0))]
    (when (or (<= first 0)
              (!= first same)
              (= first reversed)
              (= guarded unguarded))
      (set! failures (+ failures 1)))
    (set! failures
          (+ failures
             (rejected (b/floating! (mut graph) 26 11 p q 0))
             (rejected (b/floating! (mut graph) 30 12 p q 0))
             (rejected (b/floating! (mut graph) 26 12 p q start))
             (rejected (b/floating! (mut graph) 29 12 p q p))))
    (require (b/patch! (mut graph) first 1 q))
    (when (= first (require (b/floating! (mut graph) 58 12 p q 0)))
      (set! failures (+ failures 1)))
    (match (verify/integer-operations graph)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [_] 0))
    (g/release! (mut graph))
    (println "floating construction/folding/CSE/guard validation: {} failures"
             failures)
    (if (= failures 0) 0 1)))
