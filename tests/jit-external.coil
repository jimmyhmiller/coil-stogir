(module stogir.tests.jit-external)
(import "stogir.image" :as image)
(import "stogir.jit.darwin" :as jit)
(import "stogir.bytes" :as bytes)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Ok Err])

(defn plus100 :cc (cc/C) [(x i64)] (-> i64)
  (+ x 100))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut code) (image/create allocator)
        (mut failures) 0]
    (image/symbol! (mut code) "plus100" 0 0)
    (bytes/append32! (mut (.text code)) 0x14000000)
    (image/relocate! (mut code)
                     (image/Relocation
                       :section 1
                       :offset 0
                       :kind 2
                       :symbol 0
                       :addend 0))
    (match (jit/map-image-resolved code
                                   [(primitive/cast u64
                                                    (primitive/cast (ptr u8)
                                                                    (fnptr-of plus100)))]
                                   [true]
                                   allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [loaded]
          (let [(mut owned) loaded
                f
                  (primitive/cast (fnptr (cc/C) [i64] i64)
                                  (.base (.memory owned)))
                (mut x) -100]
            (while (<= x 100)
              (when (!= (call-ptr f x) (+ x 100))
                (set! failures (+ failures 1)))
              (set! x (+ x 1)))
            (jit/release-image! (mut owned)))))
    (image/release! (mut code))
    (println "external branch stub checks: {} failures" failures)
    (if (= failures 0) 0 1)))
