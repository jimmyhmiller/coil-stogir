;;; Control and register behaviour of x86-64 calls: a callback from libc into
;;; generated code, deep recursion, values live across calls under register
;;; pressure, indirect calls through a register, a spill slot and a constant,
;;; tail calls (jumps with stack arguments, self recursion, the call + return
;;; fallback) and private leaf calls with narrowed clobbers.
;;;
;;; The C side is tests/x64-call-helpers.c; run with tools/x86/call-tests.sh.
(module stogir.tests.x64-call-flow)
(import "stogir.graph" :as g)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.image" :as image)
(import "stogir.options" :as options)
(import "stogir.jit.native" :as jit)
(import "stogir.native.private-types" :as private-types)
(import "stogir.x64.compile" :as compile)
(import "stogir.x64.private-leaf" :as private)
(import "stogir.x64.testing" :as t)
(import "stogir.x64.call-testing" :as ct)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err Option Some None])

(extern c_load64 :cc (cc/C) [] (-> void))
(extern c_ints10 :cc (cc/C) [i64 i64 i64 i64 i64 i64 i64 i64 i64 i64] (-> i64))
(extern qsort :cc (cc/C) [(ptr i64) u64 u64 (ptr u8)] (-> void))
(extern c_ret_ii :cc (cc/C) [] (-> void))
(extern c_ret_big :cc (cc/C) [] (-> void))
(extern c_drive_ret_ii :cc (cc/C) [(ptr u8) i64 i64] (-> i64))
(extern c_drive_ret_big_rax :cc (cc/C) [(ptr u8) i64 i64] (-> i64))

(defn address-of [(f Code)] (-> Code)
  `(primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of ~f))))

(def NAMES ["c_load64" "c_ints10" "c_ret_ii" "c_ret_big"])

(defn finish [(label (slice u8)) (graph g/Graph) (start i32) (roots (slice i32))
              (a (dyn Allocator))] (-> jit/Loaded)
  (let [table [(address-of c_load64) (address-of c_ints10) (address-of c_ret_ii)
               (address-of c_ret_big)]]
    (ct/build label graph start roots NAMES table a)))

(defn check! [(tally (mut t/Tally)) (label (slice u8)) (good bool)] (-> void)
  (set! (.checks tally) (+ (.checks tally) 1))
  (unless good
    (when (< (.failures tally) 40) (println "{}: wrong result" label))
    (t/fail! (mut tally))))

(defn add! [(graph (mut g/Graph)) (left i32) (right i32)] (-> i32)
  (t/binary! (mut graph) 26 11 left right))

(defn times! [(graph (mut g/Graph)) (value i32) (factor u64)] (-> i32)
  (t/binary! (mut graph) 28 11 value (t/constant! (mut graph) 11 factor)))

;;; libc's qsort calls a generated comparator, which itself calls C twice.
(defn callback! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 10 [(: 6 u8) 6] [] a)
        (mut fetch) (ct/prototype false 11 [(: 6 u8) 11] [] a)]
    (ct/declare! (mut graph) own a)
    (let [left (t/param! (mut graph) start 6 0)
          right (t/param! (mut graph) start 6 1)
          zero (t/constant! (mut graph) 11 0)
          x (ct/call! (mut graph) fetch start (ct/named! (mut graph) "c_load64") [left zero] a)
          y (ct/call! (mut graph) fetch x (ct/named! (mut graph) "c_load64") [right zero] a)
          less (t/compare! (mut graph) 16 x y)
          more (t/compare! (mut graph) 19 x y)
          order (t/select! (mut graph) 10 less (t/constant! (mut graph) 10 0xFFFFFFFF)
                           (t/select! (mut graph) 10 more (t/constant! (mut graph) 10 1)
                                      (t/constant! (mut graph) 10 0)))
          ret (t/return! (mut graph) y 10 order)
          (mut loaded) (finish "callback" graph start [ret] a)
          (mut values) (primitive/zeroed (array i64 257))
          (mut state) (: 0x243F6A8885A308D3 u64)
          (mut sum) (: 0 i64)]
      (for [i 0 257]
        (set! (mut values) i (cast i64 (>> (t/random! (mut state)) 20)))
        (when (= (% i 3) 0) (set! (mut values) i (- 0 (get values i))))
        (set! sum (primitive/iadd sum (get values i))))
      (qsort (primitive/cast (ptr i64) (mut values)) 257 8 (ct/entry loaded))
      (let [(mut sorted) true
            (mut after) (: 0 i64)]
        (for [i 0 257]
          (set! after (primitive/iadd after (get values i)))
          (when (and (> i 0) (> (get values (- i 1)) (get values i))) (set! sorted false)))
        (check! (mut tally) "qsort order" sorted)
        (check! (mut tally) "qsort contents" (= after sum)))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut fetch))
    (g/release! (mut graph))))

;;; f(n, acc) = n == 0 ? acc : f(n - 1, acc + n) + 1, a direct call to its own
;;; name that is not in tail position.
(defn recursion! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 11 [(: 11 u8) 11] [] a)]
    (ct/declare! (mut graph) own a)
    (let [n (t/param! (mut graph) start 11 0)
          acc (t/param! (mut graph) start 11 1)
          done (t/compare! (mut graph) 14 n (t/constant! (mut graph) 11 0))
          branch (t/if! (mut graph) start done)
          yes (t/if-true! (mut graph) branch)
          no (t/if-false! (mut graph) branch)
          base (t/return! (mut graph) yes 11 acc)
          call (ct/call! (mut graph) own no (ct/named! (mut graph) "x64_call_test_entry")
                         [(t/binary! (mut graph) 27 11 n (t/constant! (mut graph) 11 1))
                          (add! (mut graph) acc n)] a)
          step (t/return! (mut graph) call 11 (add! (mut graph) call (t/constant! (mut graph) 11 1)))
          (mut loaded) (finish "recursion" graph start [base step] a)
          f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (ct/entry loaded))]
      (for n [(: 0 i64) 1 2 17 1000 60000]
        (check! (mut tally) "recursion" (= (call-ptr f n 5) (+ 5 (/ (* n (+ n 1)) 2) n))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (g/release! (mut graph))))

;;; Fourteen values stay live across two calls: more than the five preserved
;;; registers, so some cross in spill slots and some are moved to preserved
;;; registers by the call's own parallel group.
(defn pressure! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 11 [(: 11 u8) 11 11 11 11 11] [] a)
        (mut ten) (ct/prototype false 11 [(: 11 u8) 11 11 11 11 11 11 11 11 11] [] a)
        (mut p) (primitive/zeroed (array i32 6))
        (mut v) (primitive/zeroed (array i32 8))]
    (ct/declare! (mut graph) own a)
    (for [i 0 6] (set! (mut p) i (t/param! (mut graph) start 11 (cast i32 i))))
    (for [i 0 8]
      (set! (mut v) i (add! (mut graph) (get p (% i 6))
                            (times! (mut graph) (get p (% (+ i 1) 6)) (cast u64 (+ i 2))))))
    (let [target (ct/named! (mut graph) "c_ints10")
          c1 (ct/call! (mut graph) ten start target
                       [(get v 0) (get v 1) (get v 2) (get v 3) (get v 4) (get v 5) (get v 6)
                        (get v 7) (get p 0) (get p 1)] a)
          c2 (ct/call! (mut graph) ten c1 target
                       [c1 (get v 7) (get v 6) (get v 5) (get v 4) (get v 3) (get v 2)
                        (get v 1) (get v 0) (get p 2)] a)
          (mut total) (add! (mut graph) c1 c2)]
      (for [i 0 8] (set! total (add! (mut graph) total (times! (mut graph) (get v i) (cast u64 (+ i 1))))))
      (for [i 0 6] (set! total (add! (mut graph) total (get p i))))
      (let [ret (t/return! (mut graph) c2 11 total)
            (mut loaded) (finish "pressure" graph start [ret] a)
            f (primitive/cast (fnptr (cc/C) [i64 i64 i64 i64 i64 i64] i64) (ct/entry loaded))]
        (for s [(: -11 i64) 0 3 77777]
          (let [(mut hp) (primitive/zeroed (array i64 6))
                (mut hv) (primitive/zeroed (array i64 8))]
            (for [i 0 6] (set! (mut hp) i (+ s (* (cast i64 i) 13))))
            (for [i 0 8]
              (set! (mut hv) i (+ (get hp (% i 6)) (* (get hp (% (+ i 1) 6)) (+ (cast i64 i) 2)))))
            (let [r1 (c_ints10 (get hv 0) (get hv 1) (get hv 2) (get hv 3) (get hv 4) (get hv 5)
                               (get hv 6) (get hv 7) (get hp 0) (get hp 1))
                  r2 (c_ints10 r1 (get hv 7) (get hv 6) (get hv 5) (get hv 4) (get hv 3) (get hv 2)
                               (get hv 1) (get hv 0) (get hp 2))
                  (mut expected) (+ r1 r2)]
              (for [i 0 8] (set! expected (+ expected (* (get hv i) (+ (cast i64 i) 1)))))
              (for [i 0 6] (set! expected (+ expected (get hp i))))
              (check! (mut tally) "pressure"
                      (= (call-ptr f (get hp 0) (get hp 1) (get hp 2) (get hp 3) (get hp 4)
                                   (get hp 5))
                         expected)))))
        (jit/release-image! (mut loaded))))
    (calls/release! (mut own))
    (calls/release! (mut ten))
    (g/release! (mut graph))))

;;; Indirect calls: the target is a parameter (a register), the same value
;;; again after two calls and ten other live values (a spill slot or a
;;; preserved register), and a numeric address constant.
(defn indirect! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 11 [(: 6 u8) 11 11 11 11 11] [] a)
        (mut ten) (ct/prototype false 11 [(: 11 u8) 11 11 11 11 11 11 11 11 11] [] a)
        (mut p) (primitive/zeroed (array i32 5))
        (mut v) (primitive/zeroed (array i32 10))]
    (ct/declare! (mut graph) own a)
    (let [target (t/param! (mut graph) start 6 0)
          constant (ct/address! (mut graph) (address-of c_ints10))]
      (for [i 0 5] (set! (mut p) i (t/param! (mut graph) start 11 (cast i32 (+ i 1)))))
      (for [i 0 10]
        (set! (mut v) i (add! (mut graph) (get p (% i 5))
                              (times! (mut graph) (get p (% (+ i 2) 5)) (cast u64 (+ i 3))))))
      (let [c1 (ct/call! (mut graph) ten start target v a)
            c2 (ct/call! (mut graph) ten c1 constant
                         [c1 (get v 1) (get v 2) (get v 3) (get v 4) (get v 5) (get v 6) (get v 7)
                          (get v 8) (get v 9)] a)
            c3 (ct/call! (mut graph) ten c2 target
                         [(get v 9) (get v 8) (get v 7) (get v 6) (get v 5) (get v 4) (get v 3)
                          (get v 2) c2 c1] a)
            ret (t/return! (mut graph) c3 11 c3)
            (mut loaded) (finish "indirect" graph start [ret] a)
            f (primitive/cast (fnptr (cc/C) [(ptr u8) i64 i64 i64 i64 i64] i64) (ct/entry loaded))]
        (for s [(: -11 i64) 0 3 77777]
          (let [(mut hp) (primitive/zeroed (array i64 5))
                (mut hv) (primitive/zeroed (array i64 10))]
            (for [i 0 5] (set! (mut hp) i (+ s (* (cast i64 i) 7))))
            (for [i 0 10]
              (set! (mut hv) i (+ (get hp (% i 5)) (* (get hp (% (+ i 2) 5)) (+ (cast i64 i) 3)))))
            (let [r1 (c_ints10 (get hv 0) (get hv 1) (get hv 2) (get hv 3) (get hv 4) (get hv 5)
                               (get hv 6) (get hv 7) (get hv 8) (get hv 9))
                  r2 (c_ints10 r1 (get hv 1) (get hv 2) (get hv 3) (get hv 4) (get hv 5) (get hv 6)
                               (get hv 7) (get hv 8) (get hv 9))
                  r3 (c_ints10 (get hv 9) (get hv 8) (get hv 7) (get hv 6) (get hv 5) (get hv 4)
                               (get hv 3) (get hv 2) r2 r1)]
              (check! (mut tally) "indirect"
                      (= (call-ptr f (primitive/cast (ptr u8) (fnptr-of c_ints10)) (get hp 0)
                                   (get hp 1) (get hp 2) (get hp 3) (get hp 4))
                         r3)))))
        (jit/release-image! (mut loaded))))
    (calls/release! (mut own))
    (calls/release! (mut ten))
    (g/release! (mut graph))))

;;; The value the rotating tail recursion below computes.
(defn rotated [(n i64) (values (array i64 9))] (-> i64)
  (let [(mut v) values
        (mut left) n]
    (while (> left 0)
      (let [first (get v 0)]
        (for [i 0 8] (set! (mut v) i (get v (+ i 1))))
        (set! (mut v) 8 (+ first 1)))
      (set! left (- left 1)))
    (+ (get v 0) (* 2 (get v 4)) (* 3 (get v 8)))))

;;; f(n, a1..a9) = n == 0 ? a1 + 2*a5 + 3*a9 : f(n - 1, a2, ..., a9, a1 + 1):
;;; four of the ten arguments are on the stack. `explicit` uses TAILCALL;
;;; otherwise an ordinary CALL directly followed by the RETURN of its result.
;;; Either way three million levels only fit when the call is a jump that
;;; reuses the incoming stack arguments.
(defn tail-recursion! [(tally (mut t/Tally)) (explicit bool) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 11 [(: 11 u8) 11 11 11 11 11 11 11 11 11] [] a)
        (mut p) (primitive/zeroed (array i32 10))]
    (ct/declare! (mut graph) own a)
    (for [i 0 10] (set! (mut p) i (t/param! (mut graph) start 11 (cast i32 i))))
    (let [done (t/compare! (mut graph) 14 (get p 0) (t/constant! (mut graph) 11 0))
          branch (t/if! (mut graph) start done)
          yes (t/if-true! (mut graph) branch)
          no (t/if-false! (mut graph) branch)
          base (t/return! (mut graph) yes 11
                          (add! (mut graph) (get p 1)
                                (add! (mut graph) (times! (mut graph) (get p 5) 2)
                                      (times! (mut graph) (get p 9) 3))))
          self (ct/named! (mut graph) "x64_call_test_entry")
          arguments [(t/binary! (mut graph) 27 11 (get p 0) (t/constant! (mut graph) 11 1))
                     (get p 2) (get p 3) (get p 4) (get p 5) (get p 6) (get p 7) (get p 8)
                     (get p 9) (add! (mut graph) (get p 1) (t/constant! (mut graph) 11 1))]
          step (if explicit
                   (ct/tail! (mut graph) own no self arguments a)
                   (let [call (ct/call! (mut graph) own no self arguments a)]
                     (t/return! (mut graph) call 11 call)))
          (mut loaded) (finish "tail recursion" graph start [base step] a)
          f (primitive/cast (fnptr (cc/C) [i64 i64 i64 i64 i64 i64 i64 i64 i64 i64] i64)
                            (ct/entry loaded))]
      (for n [(: 0 i64) 1 9 10 3000000]
        (check! (mut tally) "tail recursion"
                (= (call-ptr f n 1 20 300 4000 50000 600000 7000000 80000000 900000000)
                   (rotated n [(: 1 i64) 20 300 4000 50000 600000 7000000 80000000 900000000]))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (g/release! (mut graph))))

;;; Tail calls to C. With eleven integer parameters the function received
;;; five stack slots, enough for c_ints10's four: a jump, to the name or
;;; through the target parameter. With two parameters it received none: the
;;; TAILCALL is a call followed by the return.
(defn tail-to-c! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (for indirect [false true]
    (let [(mut graph) (g/create a)
          start (t/start! (mut graph))
          (mut own) (ct/prototype false 11 [(: 6 u8) 11 11 11 11 11 11 11 11 11 11] [] a)
          (mut ten) (ct/prototype false 11 [(: 11 u8) 11 11 11 11 11 11 11 11 11] [] a)
          (mut p) (primitive/zeroed (array i32 11))]
      (ct/declare! (mut graph) own a)
      (set! (mut p) 0 (t/param! (mut graph) start 6 0))
      (for [i 1 11] (set! (mut p) i (t/param! (mut graph) start 11 (cast i32 i))))
      (let [tail (ct/tail! (mut graph) ten start
                           (if indirect (get p 0) (ct/named! (mut graph) "c_ints10"))
                           [(get p 10) (get p 9) (get p 8) (get p 7) (get p 6) (get p 5)
                            (get p 4) (get p 3) (get p 2) (get p 1)] a)
            (mut loaded) (finish "tail to c" graph start [tail] a)
            f (primitive/cast (fnptr (cc/C) [(ptr u8) i64 i64 i64 i64 i64 i64 i64 i64 i64 i64] i64)
                              (ct/entry loaded))]
        (for s [(: -11 i64) 0 3 77777]
          (check! (mut tally) "tail to c"
                  (= (call-ptr f (primitive/cast (ptr u8) (fnptr-of c_ints10)) s (+ s 1) (+ s 2)
                               (+ s 3) (+ s 4) (+ s 5) (+ s 6) (+ s 7) (+ s 8) (+ s 9))
                     (c_ints10 (+ s 9) (+ s 8) (+ s 7) (+ s 6) (+ s 5) (+ s 4) (+ s 3) (+ s 2)
                               (+ s 1) s))))
        (jit/release-image! (mut loaded)))
      (calls/release! (mut own))
      (calls/release! (mut ten))
      (g/release! (mut graph))))
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 11 [(: 11 u8) 11] [] a)
        (mut ten) (ct/prototype false 11 [(: 11 u8) 11 11 11 11 11 11 11 11 11] [] a)]
    (ct/declare! (mut graph) own a)
    (let [x (t/param! (mut graph) start 11 0)
          y (t/param! (mut graph) start 11 1)
          tail (ct/tail! (mut graph) ten start (ct/named! (mut graph) "c_ints10")
                         [x y y x x y y x x y] a)
          (mut loaded) (finish "tail fallback" graph start [tail] a)
          f (primitive/cast (fnptr (cc/C) [i64 i64] i64) (ct/entry loaded))]
      (for s [(: -11 i64) 0 3 77777]
        (let [y (+ (* s 3) 1)]
          (check! (mut tally) "tail fallback"
                  (= (call-ptr f s y) (c_ints10 s y y s s y y s s y)))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut ten))
    (g/release! (mut graph))))

;;; Tail calls keep the function's result role. Register pieces: the callee's
;;; rax/rdx are the function's own, so its private buffer is never read.
;;; Indirect: the hidden pointer is forwarded in rdi and the callee returns it
;;; in rax. Both as an explicit TAILCALL and as CALL + RETURN.
(defn tail-roles! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (for indirect [false true]
    (for explicit [false true]
      (let [(mut graph) (g/create a)
            start (t/start! (mut graph))
            (mut own) (ct/result-prototype [(: 6 u8) 11 11] []
                                           (if indirect (results/indirect) (results/pieces 11 2))
                                           a)]
        (ct/declare! (mut graph) own a)
        (let [place (t/param! (mut graph) start 6 0)
              x (t/param! (mut graph) start 11 1)
              y (t/param! (mut graph) start 11 2)
              target (ct/named! (mut graph) (if indirect "c_ret_big" "c_ret_ii"))
              root (if explicit
                       (ct/tail! (mut graph) own start target [place y x] a)
                       (let [call (ct/call! (mut graph) own start target [place y x] a)]
                         (t/return! (mut graph) call 0 0)))
              (mut loaded) (finish "tail roles" graph start [root] a)]
          (for s [(: -11 i64) 0 3 77777]
            (if indirect
                ; c_ret_big(y, x) = {y, x, y * x}, read through the returned rax.
                (check! (mut tally) "tail indirect result"
                        (= (c_drive_ret_big_rax (ct/entry loaded) s (+ s 5))
                           (+ (+ s 5) (* 2 s) (* 3 (* s (+ s 5))))))
                ; c_ret_ii(y, x) = {y + x, y - x}
                (check! (mut tally) "tail register pieces"
                        (= (c_drive_ret_ii (ct/entry loaded) s (+ s 5))
                           (+ (* (+ s s 5) 7) (* 5 13))))))
          (jit/release-image! (mut loaded)))
        (calls/release! (mut own))
        (g/release! (mut graph))))))

;;; leaf(x, y) = x * 3 + y, compiled on its own and registered as a private
;;; leaf. A caller keeps eight values live across four direct calls to it.
;;; With the frozen context those calls clobber only what the leaf writes, so
;;; the caller's code is shorter than without it, and the result is the same.
(defn private-leaf! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut leaf-graph) (g/create a)
        leaf-start (t/start! (mut leaf-graph))
        (mut signature) (ct/prototype false 11 [(: 11 u8) 11] [] a)
        (mut context) (private/context-create a)]
    (ct/declare! (mut leaf-graph) signature a)
    (let [x (t/param! (mut leaf-graph) leaf-start 11 0)
          y (t/param! (mut leaf-graph) leaf-start 11 1)
          ret (t/return! (mut leaf-graph) leaf-start 11
                         (add! (mut leaf-graph) (times! (mut leaf-graph) x 3) y))
          (mut leaf) (ct/image-of "leaf" leaf-graph leaf-start [ret] a)
          (mut bytes) (calls/encode signature a)
          local (ct/need (image/local-symbol! (mut leaf) "leaf_body" 1 0))]
      (check! (mut tally) "leaf record"
              (!= (& (.leaf-effects leaf) image/LEAF-RECORDED) 0))
      (match (private/register-as! (mut context) "private_leaf" leaf local (len (.text leaf))
                                   (slice bytes))
        (Ok [registered] (check! (mut tally) "leaf registered" registered))
        (Err [message] (panic "private leaf registration: {}" message)))
      (private/freeze! (mut context))
      (let [(mut graph) (g/create a)
            start (t/start! (mut graph))
            (mut own) (ct/prototype false 11 [(: 11 u8) 11 11 11] [] a)
            (mut p) (primitive/zeroed (array i32 4))
            (mut v) (primitive/zeroed (array i32 8))]
        (ct/declare! (mut graph) own a)
        (for [i 0 4] (set! (mut p) i (t/param! (mut graph) start 11 (cast i32 i))))
        (for [i 0 8]
          (set! (mut v) i (add! (mut graph) (get p (% i 4))
                                (times! (mut graph) (get p (% (+ i 1) 4)) (cast u64 (+ i 2))))))
        (let [target (ct/named! (mut graph) "private_leaf")
              c1 (ct/call! (mut graph) signature start target [(get v 0) (get v 1)] a)
              c2 (ct/call! (mut graph) signature c1 target [(get v 2) c1] a)
              c3 (ct/call! (mut graph) signature c2 target [c2 (get v 3)] a)
              c4 (ct/call! (mut graph) signature c3 target [(get v 4) (get v 5)] a)
              (mut total) (add! (mut graph) (add! (mut graph) c1 c2) (add! (mut graph) c3 c4))]
          (for [i 0 8]
            (set! total (add! (mut graph) total (times! (mut graph) (get v i) (cast u64 (+ i 1))))))
          (let [ret (t/return! (mut graph) c4 11 total)
                level (options/Options :level 1)
                (mut narrowed)
                  (match (compile/image-with-private graph start [ret] "x64_call_test_entry"
                                                     level a context)
                    (Ok [code] code)
                    (Err [message] (panic "private caller: {}" message)))
                ; Without the context the leaf's name stays undefined and is
                ; resolved to the leaf loaded on its own.
                (mut plain) (ct/image-of "plain caller" graph start [ret] a)
                (mut leaf-loaded) (ct/map-resolved "leaf" leaf [] [] a)
                (mut narrow-loaded) (ct/map-resolved "narrowed" narrowed [] [] a)
                (mut plain-loaded)
                  (ct/map-resolved "plain" plain ["private_leaf"]
                                   [(primitive/cast u64 (ct/entry leaf-loaded))] a)
                f (primitive/cast (fnptr (cc/C) [i64 i64 i64 i64] i64) (ct/entry narrow-loaded))
                h (primitive/cast (fnptr (cc/C) [i64 i64 i64 i64] i64) (ct/entry plain-loaded))]
            ; The embedded leaf follows the caller at a 16-byte boundary.
            (check! (mut tally) "leaf embedded"
                    (match (image/find-symbol narrowed "private_leaf")
                      (None [] false)
                      (Some [id]
                            (let [symbol (get (.symbols narrowed) (cast i64 id))]
                              (and (= (.section symbol) 1) (not (.global? symbol))
                                   (= (% (.offset symbol) 16) 0))))))
            (check! (mut tally) "leaf narrows clobbers"
                    (< (- (len (.text narrowed)) (len (.text leaf))) (len (.text plain))))
            (for s [(: -11 i64) 0 3 77777]
              (let [(mut hp) (primitive/zeroed (array i64 4))
                    (mut hv) (primitive/zeroed (array i64 8))]
                (for [i 0 4] (set! (mut hp) i (+ s (* (cast i64 i) 5))))
                (for [i 0 8]
                  (set! (mut hv) i (+ (get hp (% i 4))
                                      (* (get hp (% (+ i 1) 4)) (+ (cast i64 i) 2)))))
                (let [r1 (+ (* (get hv 0) 3) (get hv 1))
                      r2 (+ (* (get hv 2) 3) r1)
                      r3 (+ (* r2 3) (get hv 3))
                      r4 (+ (* (get hv 4) 3) (get hv 5))
                      (mut expected) (+ r1 r2 r3 r4)]
                  (for [i 0 8] (set! expected (+ expected (* (get hv i) (+ (cast i64 i) 1)))))
                  (check! (mut tally) "private leaf"
                          (= (call-ptr f (get hp 0) (get hp 1) (get hp 2) (get hp 3)) expected))
                  (check! (mut tally) "plain leaf call"
                          (= (call-ptr h (get hp 0) (get hp 1) (get hp 2) (get hp 3)) expected)))))
            (jit/release-image! (mut narrow-loaded))
            (jit/release-image! (mut plain-loaded))
            (jit/release-image! (mut leaf-loaded))
            (image/release! (mut narrowed))
            (image/release! (mut plain))))
        (calls/release! (mut own))
        (g/release! (mut graph)))
      (free! (mut bytes))
      (image/release! (mut leaf)))
    (private/context-release! (mut context))
    (calls/release! (mut signature))
    (g/release! (mut leaf-graph))))

;;; The module path: the leaf is published once by its owner, the context is
;;; sealed, and a caller compiled for that publication keeps the leaf's name
;;; undefined (the transport binds it) while still using the narrowed clobbers.
(defn private-module! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut leaf-graph) (g/create a)
        leaf-start (t/start! (mut leaf-graph))
        (mut signature) (ct/prototype false 11 [(: 11 u8) 11] [] a)
        (mut context) (private/context-create a)
        scope (: 77 usize)]
    (ct/declare! (mut leaf-graph) signature a)
    (let [x (t/param! (mut leaf-graph) leaf-start 11 0)
          y (t/param! (mut leaf-graph) leaf-start 11 1)
          ret (t/return! (mut leaf-graph) leaf-start 11
                         (add! (mut leaf-graph) (times! (mut leaf-graph) x 5) y))
          (mut leaf) (ct/image-of "module leaf" leaf-graph leaf-start [ret] a)
          (mut bytes) (calls/encode signature a)
          local (ct/need (image/local-symbol! (mut leaf) "module_leaf_body" 1 0))]
      (match (private/register-as! (mut context) "module_leaf" leaf local (len (.text leaf))
                                   (slice bytes))
        (Ok [registered] (check! (mut tally) "module leaf registered" registered))
        (Err [message] (panic "module leaf registration: {}" message)))
      (check! (mut tally) "unpublished context does not seal"
              (match (private/seal-module! (mut context) scope) (None [] true) (Some [_] false)))
      (match (private/confirm-publication! (mut context) scope "module_leaf" 9 0
                                           (slice (.text leaf)))
        (Ok [confirmed] (check! (mut tally) "publication confirmed" confirmed))
        (Err [message] (panic "module publication: {}" message)))
      (match (private/seal-module! (mut context) scope)
        (None [] (check! (mut tally) "module sealed" false))
        (Some [publication]
              (let [(mut graph) (g/create a)
                    start (t/start! (mut graph))
                    (mut own) (ct/prototype false 11 [(: 11 u8) 11 11] [] a)]
                (ct/declare! (mut graph) own a)
                (check! (mut tally) "module binding"
                        (match (private/binding context publication scope "module_leaf")
                          (Some [symbol] (= symbol 9))
                          (None [] false)))
                (let [p0 (t/param! (mut graph) start 11 0)
                      p1 (t/param! (mut graph) start 11 1)
                      p2 (t/param! (mut graph) start 11 2)
                      kept (add! (mut graph) p0 (times! (mut graph) p2 9))
                      call (ct/call! (mut graph) signature start
                                     (ct/named! (mut graph) "module_leaf") [p1 p2] a)
                      ret (t/return! (mut graph) call 11 (add! (mut graph) call kept))
                      (mut code)
                        (match (compile/image-for-private-module
                                 graph start [ret] "x64_call_test_entry" (options/Options :level 1)
                                 a context publication scope)
                          (Ok [built] built)
                          (Err [message] (panic "module caller: {}" message)))
                      (mut leaf-loaded) (ct/map-resolved "module leaf" leaf [] [] a)
                      (mut loaded)
                        (ct/map-resolved "module caller" code ["module_leaf"]
                                         [(primitive/cast u64 (ct/entry leaf-loaded))] a)
                      f (primitive/cast (fnptr (cc/C) [i64 i64 i64] i64) (ct/entry loaded))]
                  ; The leaf's name stays an undefined declaration for the transport.
                  (check! (mut tally) "module leaf stays undefined"
                          (match (image/find-symbol code "module_leaf")
                            (None [] false)
                            (Some [id] (= (.section (get (.symbols code) (cast i64 id))) 0))))
                  (for s [(: -11 i64) 0 3 77777]
                    (check! (mut tally) "module call"
                            (= (call-ptr f s (+ s 1) (+ s 2))
                               (+ (* (+ s 1) 5) (+ s 2) s (* (+ s 2) 9)))))
                  (jit/release-image! (mut loaded))
                  (jit/release-image! (mut leaf-loaded))
                  (image/release! (mut code)))
                ; A publication of another scope is not valid for this module.
                (check! (mut tally) "foreign scope rejected"
                        (match (compile/image-for-private-module
                                 graph start [] "x64_call_test_entry" (options/Options :level 1)
                                 a context publication (+ scope 1))
                          (Ok [built]
                              (let [(mut built) built] (image/release! (mut built)) false))
                          (Err [_] true)))
                (calls/release! (mut own))
                (g/release! (mut graph)))))
      (free! (mut bytes))
      (image/release! (mut leaf)))
    (private/context-release! (mut context))
    (calls/release! (mut signature))
    (g/release! (mut leaf-graph))))

(defn main [] (-> i64)
  (if (not (t/host?))
      (do (println "x64 call flow: skipped (not an x86-64 host)") 0)
      (let [a (malloc-allocator)
            (mut tally) (t/tally)]
        (callback! (mut tally) a)
        (recursion! (mut tally) a)
        (pressure! (mut tally) a)
        (indirect! (mut tally) a)
        (tail-recursion! (mut tally) true a)
        (tail-recursion! (mut tally) false a)
        (tail-to-c! (mut tally) a)
        (tail-roles! (mut tally) a)
        (private-leaf! (mut tally) a)
        (private-module! (mut tally) a)
        (println "x64 call flow: {} checks, {} failures" (.checks tally) (.failures tally))
        (if (= (.failures tally) 0) 0 1))))
