(module stogir.tests.edge-moves)
(import "stogir.edge-moves" :as edge)
(import "stogir.locations" :as locations)
(import "stogir.a64.coalesce" :as coalesce)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as r)
(import "stogir.bitset" :as bits)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn coalesced-edge [] (-> void)
  (let [a (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] a)
        (mut prefix) (a/create 1 a)
        (mut suffix) (a/create 1 a)
        (mut input) (bits/create 4 a)
        (mut parents) (ArrayList::new [i32] a)]
    (r/add! (mut (.ranges prefix)) 0 5)
    (set! (.register prefix) 0)
    (r/add! (mut (.ranges suffix)) 10 20)
    (set! (.register suffix) 1)
    (push! (mut parts) prefix)
    (push! (mut parts) suffix)
    (for parent [(: 2 i32) 3] (push! (mut parts) (a/create parent a)))
    (for parent [(: 0 i32) 1 1 1] (push! (mut parents) parent))
    (bits/add! (mut input) 2)
    (bits/add! (mut input) 3)
    (match (locations/build-index parts 4 a)
      (Err [e] (panic "{}" e))
      (Ok [index]
          (let [(mut index) index]
            (coalesce/index! (mut index) parents)
            (for root [false true]
              (when root (bits/add! (mut input) 1))
              (match (edge/ordinary-indexed parts index input 3 10 a)
                (Err [e] (panic "{}" e))
                (Ok [moves]
                    (let [(mut moves) moves]
                      (assert (= (len moves) 1))
                      (let [move (get moves 0)]
                        (assert (= (.parent move) 1))
                        (assert (= (.value (.source move)) 0))
                        (assert (= (.value (.destination move)) 1)))
                      (free! (mut moves))))))
            (locations/release-index! (mut index)))))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (free! (mut parents))
    (bits/release! (mut input))))

(defn main [] (-> i64)
  (coalesced-edge)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut prefix) (a/create 1 allocator)
        (mut suffix) (a/create 1 allocator)
        (mut other-prefix) (a/create 2 allocator)
        (mut other-suffix) (a/create 2 allocator)
        (mut input) (bits/create 3 allocator)
        (mut failures) 0]
    (r/add! (mut (.ranges prefix)) 0 5)
    (set! (.register prefix) 0)
    (r/add! (mut (.ranges suffix)) 10 20)
    (set! (.register suffix) 1)
    (push! (mut parts) prefix)
    (push! (mut parts) suffix)
    (r/add! (mut (.ranges other-prefix)) 0 5)
    (set! (.register other-prefix) 1)
    (r/add! (mut (.ranges other-suffix)) 10 20)
    (set! (.register other-suffix) 0)
    (push! (mut parts) other-prefix)
    (push! (mut parts) other-suffix)
    (bits/add! (mut input) 2)
    (bits/add! (mut input) 1)
    (match (edge/ordinary parts input 3 10 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [moves]
          (let [(mut owned) moves]
            (when (!= (len owned) 2) (set! failures (+ failures 1)))
            (when (= (len owned) 2)
              (let [move (get owned 0)]
                (when (!= (.value (.source move)) 0)
                  (set! failures (+ failures 1)))
                (when (!= (.value (.destination move)) 1)
                  (set! failures (+ failures 1)))))
            (free! (mut owned)))))
    (match (edge/ordinary parts input 7 10 allocator)
      (Ok [moves]
          (let [(mut owned) moves]
            (set! failures (+ failures 1))
            (free! (mut owned))))
      (Err [_] 0))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    (bits/release! (mut input))
    (println "CFG edge move checks: {} failures" failures)
    (if (= failures 0) 0 1)))
