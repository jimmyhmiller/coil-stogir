(module stogir.tests.edge-moves)
(import "stogir.edge-moves" :as edge)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as r)
(import "stogir.bitset" :as bits)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut prefix) (a/create 1 allocator)
        (mut suffix) (a/create 1 allocator)
        (mut other-prefix) (a/create 2 allocator)
        (mut other-suffix) (a/create 2 allocator)
        (mut input) (bits/create 3 allocator)
        (mut failures) 0]
    (r/add! (mut (.ranges prefix)) 0 5)
    (set! (.register prefix) 0)
    (r/add! (mut (.ranges suffix)) 10 20)
    (set! (.register suffix) 1)
    (push! (mut parts) prefix)
    (push! (mut parts) suffix)
    (r/add! (mut (.ranges other-prefix)) 0 5)
    (set! (.register other-prefix) 1)
    (r/add! (mut (.ranges other-suffix)) 10 20)
    (set! (.register other-suffix) 0)
    (push! (mut parts) other-prefix)
    (push! (mut parts) other-suffix)
    (bits/add! (mut input) 2)
    (bits/add! (mut input) 1)
    (match (edge/ordinary parts input 3 10 allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [moves]
          (let [(mut owned) moves]
            (when (!= (len owned) 2) (set! failures (+ failures 1)))
            (when (= (len owned) 2)
              (let [move (get owned 0)]
                (when (!= (.value (.source move)) 0)
                  (set! failures (+ failures 1)))
                (when (!= (.value (.destination move)) 1)
                  (set! failures (+ failures 1)))))
            (free! (mut owned)))))
    (match (edge/ordinary parts input 7 10 allocator)
      (Ok [moves]
          (let [(mut owned) moves]
            (set! failures (+ failures 1))
            (free! (mut owned))))
      (Err [_] 0))
    (let [(mut i) 0]
      (while (< i (len parts))
        (a/release! (elem (mut parts) i))
        (set! i (+ i 1))))
    (free! (mut parts))
    (bits/release! (mut input))
    (println "CFG edge move checks: {} failures" failures)
    (if (= failures 0) 0 1)))
