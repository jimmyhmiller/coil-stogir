(module stogir.tests.aot-conversion-image-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern entry :as "stogir_bitcast_image" :cc (cc/C) [] (-> u64))

(extern labs :cc (cc/C) [i64] (-> i64))

(defn main [] (-> i64)
  (let [wanted (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of labs)))
        failures (if (= (entry) wanted) 0 1)]
    (println "linked symbolic integer bitcast: {} failures" failures)
    failures))
