(module stogir.tests.frame)
(import "stogir.frame" :as f)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn check [(result (Result i64 (slice u8))) (expected i64)] (-> i64)
  (match result (Ok [got] (if (= got expected) 0 1)) (Err [_] 1)))

(defn main [] (-> i64)
  (let [(mut frame) (f/create (malloc-allocator))
        (mut failures) 0]
    (set! failures (+ failures (check (f/spill-slot! (mut frame) 1 8 8) 0)))
    (set! failures (+ failures (check (f/spill-slot! (mut frame) 2 16 16) 16)))
    (set! failures (+ failures (check (f/spill-slot! (mut frame) 1 8 8) 0)))
    (set! failures (+ failures (check (f/aligned-size frame 16) 32)))
    (when (!= (len (.slots frame)) 2) (set! failures (+ failures 1)))
    (match (f/spill-slot! (mut frame) 1 4 4)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (f/spill-slot! (mut frame) 3 8 3)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (when (!= (.size frame) 32) (set! failures (+ failures 1)))
    ; The same owner number denotes independent spill and object storage.
    (set! failures (+ failures (check (f/local-slot! (mut frame) 1 16 16) 32)))
    (set! failures (+ failures (check (f/spill-slot! (mut frame) 1 8 8) 0)))
    (set! failures (+ failures (check (f/local-slot! (mut frame) 1 16 16) 32)))
    (set! failures (+ failures (check (f/local-slot! (mut frame) 2 1 1) 48)))
    (set! failures (+ failures (check (f/aligned-size frame 16) 64)))
    (when (!= (len (.slots frame)) 4) (set! failures (+ failures 1)))
    (match (f/local-slot! (mut frame) 1 8 8)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (f/local-slot! (mut frame) 0 8 8)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (match (f/local-slot! (mut frame) 3 8 3)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (when (!= (.size frame) 49) (set! failures (+ failures 1)))
    ; Overflow must leave both the slot list and ownership maps unchanged.
    (set! (.size frame) 0x7FFFFFFFFFFFFFFF)
    (match (f/local-slot! (mut frame) 3 8 8)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [_] 0))
    (set! (.size frame) 49)
    (set! failures (+ failures (check (f/local-slot! (mut frame) 3 8 8) 56)))
    (f/release! (mut frame))
    (println "spill frame checks: {} failures" failures)
    (if (= failures 0) 0 1)))
