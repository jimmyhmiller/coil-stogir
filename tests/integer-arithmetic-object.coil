(module stogir.tests.integer-arithmetic-object)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.a64.compile" :as compile)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [msg] (do (println "{}" msg) 0))))

(defn write-function [(ty u8) (symbol (slice u8)) (path (slice u8))] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 0]))
        q (require (b/emit! (mut graph) 71 (cast i32 ty) [start (: 0 i32) 1]))
        quotient
          (require (b/integer-division! (mut graph)
                                        29
                                        (cast i32 ty)
                                        8
                                        p
                                        q
                                        start))
        remainder
          (require (b/integer-division! (mut graph)
                                        30
                                        (cast i32 ty)
                                        8
                                        p
                                        q
                                        start))
        rotated (require (b/integer-binary! (mut graph) 52 (cast i32 ty) 8 p q))
        sum
          (require (b/emit! (mut graph) 26 (cast i32 ty) [quotient remainder]))
        total (require (b/emit! (mut graph) 26 (cast i32 ty) [sum rotated]))
        ret
          (require (b/emit! (mut graph)
                            120
                            (cast i32 ty)
                            [start total (: 0 i32)]))
        (mut failures) 0]
    (match (calls/create 0 ty [ty ty] allocator)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut owned) prototype]
            (require (calls/function! (mut graph) owned allocator))
            (calls/release! (mut owned)))))
    (match (compile/object graph start [ret] symbol allocator)
      (Err [msg] (do (println "{}" msg) (set! failures (+ failures 1))))
      (Ok [object]
          (let [(mut owned) object]
            (match (fs/write-file allocator path (slice owned))
              (Err [_] (set! failures (+ failures 1)))
              (Ok [_] 0))
            (free! (mut owned)))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [failures
          (+ (write-function 4
                             "_stogir_arithmetic_u32"
                             "/tmp/coil-stogir-arithmetic-u32.o")
             (write-function 5
                             "_stogir_arithmetic_u64"
                             "/tmp/coil-stogir-arithmetic-u64.o")
             (write-function 10
                             "_stogir_arithmetic_i32"
                             "/tmp/coil-stogir-arithmetic-i32.o")
             (write-function 11
                             "_stogir_arithmetic_i64"
                             "/tmp/coil-stogir-arithmetic-i64.o"))]
    (println "integer arithmetic object generation checks: {} failures"
             failures)
    (if (= failures 0) 0 1)))
