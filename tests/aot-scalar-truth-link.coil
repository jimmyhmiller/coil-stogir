(module stogir.tests.aot-scalar-truth-link)
(import "coil.cc" :as cc)

(extern branch64 :as "stogir_truth_branch_f64" :cc (cc/C) [u64] (-> u64))

(extern branch32 :as "stogir_truth_branch_f32" :cc (cc/C) [u64] (-> u64))

(extern branch-integer :as "stogir_truth_branch_u64" :cc (cc/C) [u64] (-> u64))

(extern select64
        :as
        "stogir_truth_select_f64"
        :cc
        (cc/C)
        [u64 u64 u64]
        (-> u64))

(extern select32
        :as
        "stogir_truth_select_f32"
        :cc
        (cc/C)
        [u64 u64 u64]
        (-> u64))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for bits [(: 0 u64)
               1
               0x80000000
               0x100000000
               0x8000000000000000
               0x7F812345
               0x7FF0123456789ABC
               0xFFFFFFFFFFFFFFFF]
      (let [truth64 (!= (& bits 0x7FFFFFFFFFFFFFFF) 0)
            truth32 (!= (& bits 0x7FFFFFFF) 0)]
        (when (or (!= (branch64 bits) (if truth64 (: 1 u64) 0))
                  (!= (branch32 bits) (if truth32 (: 1 u64) 0))
                  (!= (branch-integer bits) (if (!= bits 0) (: 1 u64) 0))
                  (!= (select64 bits 0 0)
                      (if truth64 (: 0x7FF0123456789ABC u64) 0x8000000000000000))
                  (!= (select32 bits 0 0)
                      (if truth32 (: 0x7F812345 u64) 0x80000000)))
          (set! failures (+ failures 1)))))
    (println "linked scalar truth/selection: {} failures" failures)
    (if (= failures 0) 0 1)))
