(module stogir.tests.aot-stack-call-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(extern stogir.stack-call-test
        :as
        "stogir_stack_call_test"
        :cc
        (cc/C)
        [u64 i32 i64]
        (-> i64))

(defn combine :cc (cc/C) [(a i64)
                          (b i64)
                          (c i64)
                          (d i64)
                          (e i64)
                          (f i64)
                          (g i64)
                          (h i64)
                          (i i32)
                          (j i32)
                          (k i64)
                          (l i32)
                          (m i64)] (-> i64)
  (+ a
     (* b 2)
     (* c 3)
     (* d 4)
     (* e 5)
     (* f 6)
     (* g 7)
     (* h 8)
     (* (cast i64 i) 11)
     (* (cast i64 j) 13)
     (* k 17)
     (* (cast i64 l) 19)
     (* m 23)))

(defn main [] (-> i64)
  (let [target (primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of combine)))
        (mut x) (: -30 i32)
        (mut failures) 0]
    (while (<= x 30)
      (let [(mut y) (: -5 i64)]
        (while (<= y 5)
          (when (!= (stogir.stack-call-test target x y)
                    (+ (* (cast i64 x) 43) (* y 77)))
            (set! failures (+ failures 1)))
          (set! y (+ y 1))))
      (set! x (+ x 1)))
    (println "linked AOT stack call checks: {} failures" failures)
    (if (= failures 0) 0 1)))
