(module stogir.tests.vector-transport)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.types" :as types)
(import "stogir.vector" :as vector)
(import "stogir.verify" :as verify)
(import "stogir.a64.compile" :as compile)
(import "stogir.a64.memory" :as memory)
(import "stogir.a64.registers" :as registers)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn inputs [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        address (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        scalar (require (b/scalar-constant! (mut graph) 5 0 8))
        pointer (require (b/scalar-constant! (mut graph) 6 0 8))
        storage (require (b/variable! (mut graph) 6 start "bad-address" 8))
        wrapper (require (b/argument-value! (mut graph) address 16 16))
        loaded (require (b/vector-load! (mut graph) 37 8 start address false))
        stored
          (require (b/vector-store! (mut graph) 8 loaded address loaded true))
        ret (require (b/emit! (mut graph) 120 0 [stored (: 0 i32) 0]))
        before (len (.instructions graph))
        rejected
          [(b/vector-load! (mut graph) 5 8 start address false)
           (b/vector-load! (mut graph) 128 8 start address false)
           (b/vector-load! (mut graph) 37 3 start address false)
           (b/vector-load! (mut graph) 37 8 0 address false)
           (b/vector-load! (mut graph) 37 8 pointer address false)
           (b/vector-load! (mut graph) 37 8 ret address false)
           (b/vector-load! (mut graph) 37 8 start scalar false)
           (b/vector-load! (mut graph) 37 8 start storage false)
           (b/vector-load! (mut graph) 37 8 start wrapper false)
           (b/vector-store! (mut graph) 8 start address scalar false)]
        (mut failures) 0]
    (for result rejected
      (match result (Err [_] 0) (Ok [_] (set! failures (+ failures 1)))))
    (when (!= (len (.instructions graph)) before)
      (set! failures (+ failures 1)))
    (match (verify/integer-operations graph)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [_] 0))
    (when (or (not (vector/involves? graph loaded))
              (not (vector/involves? graph stored))
              (vector/involves? graph ret))
      (set! failures (+ failures 1)))
    (for reference [loaded stored]
      (match (vector/validate graph reference 8)
        (Err [_] (set! failures (+ failures 1)))
        (Ok [size] (when (!= size 16) (set! failures (+ failures 1))))))
    (g/release! (mut graph))
    failures))

(defn rejects [(kind i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        pointer (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        a (require (b/vector-load! (mut graph) 37 8 start pointer false))
        wide (require (b/vector-load! (mut graph) 53 8 a pointer false))
        bad
          (if (= kind 0)
              (require (b/emit! (mut graph) 26 37 [a a]))
              (if (= kind 1)
                  (require (b/emit! (mut graph) 116 0 [wide a]))
                  (require (b/emit! (mut graph) 120 37 [wide a (: 0 i32)]))))
        (mut failures) 0]
    ; Unsupported vector uses must reject even when their result is dead.
    (match (verify/integer-operations graph)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (match (memory/size graph wide)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (g/release! (mut graph))
    failures))

(defn phi [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        pointer (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        a (require (b/vector-load! (mut graph) 37 8 start pointer false))
        b (require (b/vector-load! (mut graph) 21 8 a pointer false))
        entry (require (b/emit! (mut graph) 114 0 [b]))
        loop (require (b/loop-begin! (mut graph) entry))
        value (require (b/loop-phi! (mut graph) loop a))
        back (require (b/emit! (mut graph) 115 0 [loop]))
        (mut failures) 0]
    (require (b/patch! (mut graph) loop 2 back))
    (require (b/patch! (mut graph) value 3 b))
    (match (vector/validate graph value 8)
      (Err [_] 0)
      (Ok [_] (set! failures (+ failures 1))))
    (require (b/patch! (mut graph) value 3 a))
    (match (verify/phis graph)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [_] 0))
    (match (vector/validate graph value 8)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [size] (when (!= size 16) (set! failures (+ failures 1)))))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) (+ (inputs) (phi) (rejects 0) (rejects 1) (rejects 2))]
    (for ty [(: 21 i32) 37 45 61]
      (when (or (!= (registers/class-mask ty) (registers/simd-mask))
                (not (registers/allocatable? ty 32))
                (registers/allocatable? ty 0))
        (set! failures (+ failures 1))))
    (when (!= (registers/class-mask 53) 0) (set! failures (+ failures 1)))
    (println "vector transport construction, typing, unsupported uses and SIMD class checks: {} failures"
             failures)
    (if (= failures 0) 0 1)))
