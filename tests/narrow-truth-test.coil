(module stogir.tests.narrow-truth-test)
(import "stogir.graph" :as g)
(import "stogir.target" :as target)
(import "stogir.builder" :as b)
(import "stogir.options" :as options)
(import "stogir.native.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.jit.native" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))

(defn word [(text (slice u8)) (i i64)] (-> u32)
  (| (cast u32 (get text i))
     (<< (cast u32 (get text (+ i 1))) 8)
     (<< (cast u32 (get text (+ i 2))) 16)
     (<< (cast u32 (get text (+ i 3))) 24)))

;;; UXTB Wd, Wn (UBFM Wd, Wn, #0, #7).
(defn uxtb? [(w u32)] (-> bool)
  (= (& w (: 0xFFFFFC00 u32)) (: 0x53001C00 u32)))

;;; TST Wn, #0xFF.
(defn tst-byte? [(w u32)] (-> bool)
  (= (& w (: 0xFFFFFC1F u32)) (: 0x72001C1F u32)))

;;; A Boolean branched on twice is materialized. When it comes from a comparison
;;; its W register is 0/1, so the test needs no UXTB; a Boolean parameter has
;;; unspecified upper bits and is tested with one TST.
(defn fixture [(from-parameter bool)] (-> void)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        flag (require (b/emit! (mut graph) 71 1 [start (: 0 i32) 1]))
        ten (require (b/scalar-constant! (mut graph) 11 10 8))
        one (require (b/scalar-constant! (mut graph) 11 1 8))
        condition (if from-parameter flag (require (b/emit! (mut graph) 16 1 [x ten])))
        widened (require (b/emit! (mut graph) 34 11 [condition]))
        split (require (b/emit! (mut graph) 116 0 [start condition]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        bumped (require (b/emit! (mut graph) 26 11 [widened one]))
        left (require (b/emit! (mut graph) 120 11 [yes bumped (: 0 i32)]))
        right (require (b/emit! (mut graph) 120 11 [no widened (: 0 i32)]))]
    (for level [(: 1 i32) 3]
      (match (compile/image-with-options graph start [left right] "_narrow_truth"
                                         (options/Options :level level) a)
        (Err [e] (panic "{}" e))
        (Ok [code]
            (let [(mut code) code
                  text (slice (.text code))
                  (mut extends) 0
                  (mut tests) 0]
              (for [i 0 (/ (len text) 4)]
                (let [w (word text (* i 4))]
                  (when (uxtb? w) (set! extends (+ extends 1)))
                  (when (tst-byte? w) (set! tests (+ tests 1)))))
              (target/arch-pick (if from-parameter
                  (assert (> tests 0))
                  (do (assert (= extends 0)) (assert (= tests 0)))) (do))
              (match (jit/map-image code a)
                (Err [e] (panic "{}" e))
                (Ok [mapped]
                    (let [(mut mapped) mapped
                          f (p/cast (fnptr (cc/C) [i64 u64] i64) (.base (.memory mapped)))]
                      (for v [(: -5 i64) 3 9 10 11 400]
                        (if from-parameter
                            (do
                              (assert (= (f v 0x100) 0))
                              (assert (= (f v 1) 2))
                              (assert (= (f v 0x201) 2)))
                            (assert (= (f v 0) (if (< v 10) 2 0)))))
                      (jit/release-image! (mut mapped)))))
              (image/release! (mut code))))))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (fixture false)
  (fixture true)
  (println "narrow truth tests use the producer's extension or one TST")
  0)
