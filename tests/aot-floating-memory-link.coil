(module stogir.tests.aot-floating-memory-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(extern wide :as "stogir_fp_memory_f64" :cc (cc/C) [(ptr u8) u64] (-> f64))

(extern narrow :as "stogir_fp_memory_f32" :cc (cc/C) [(ptr u8) u64] (-> f32))

(defn main [] (-> i64)
  (let [(mut cells) (ArrayList::new [u8] (malloc-allocator))
        (mut i) (: 0 i64)
        (mut failures) 0]
    (while (< i 16) (push! (mut cells) 0xA5) (set! i (+ i 1)))
    (for bits [(: 0 u64)
               1
               0x80000000
               0x7F812345
               0x7FC12345
               0x8000000000000000
               0x7FF0123456789ABC
               0xFFF8123456789ABC]
      (for width [(: 4 i64) 8]
        (set! i 0)
        (while (< i 16) (set! (mut cells) i 0xA5) (set! i (+ i 1)))
        (let [(mut actual) (: 0 u64)
              wanted (if (= width 8) bits (cast u64 (cast u32 bits)))]
          (if (= width 8)
              (let [(mut result) (wide (.data cells) bits)]
                (set! actual (load (primitive/cast (ptr u64) (mut result)))))
              (let [(mut result) (narrow (.data cells) bits)]
                (set! actual
                      (cast u64 (load (primitive/cast (ptr u32) (mut result)))))))
          (when (!= actual wanted) (set! failures (+ failures 1)))
          (set! i 0)
          (while (< i 16)
            (let [expected
                    (if (and (>= i 3) (< i (+ 3 width)))
                        (cast u8 (>> wanted (cast u64 (* (- i 3) 8))))
                        (: 0xA5 u8))]
              (when (!= (get cells i) expected) (set! failures (+ failures 1))))
            (set! i (+ i 1))))))
    (free! (mut cells))
    (println "linked floating memory/bitcast exact bits: {} failures" failures)
    (if (= failures 0) 0 1)))
