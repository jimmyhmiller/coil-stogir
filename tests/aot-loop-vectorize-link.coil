(module stogir.tests.aot-loop-vectorize-link)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)

(extern transform
        :as
        "vector_prefix"
        :cc
        (cc/C)
        [(ptr u8) (ptr u8) u64 u64]
        (-> u64))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut failures) 0]
    (for initial [(: 0 u64) 1 3]
      (for bound [(: 0 u64) 1 2 3 7 8 9 10 17 19 20]
        (for destination [(: 12 i64) 16 20 288]
          (let [(mut actual) (ArrayList::new [u8] a)
                (mut expected) (ArrayList::new [u8] a)]
            (for [i 0 512]
              (let [value (cast u8 (+ (* i 157) 241))]
                (push! (mut actual) value)
                (push! (mut expected) value)))
            (let [(mut i) initial]
              (while (< i bound)
                (let [(mut input) (: 0 u64)]
                  (for [j 0 4]
                    (set! input
                          (| input
                             (<< (cast u64
                                       (get expected
                                            (+ 16 (+ (* (cast i64 i) 4) j))))
                                 (cast u64 (* j 8))))))
                  (let [result (p/iadd (p/imul input (: 2 u64)) i)]
                    (for [j 0 4]
                      (set! (mut expected)
                            (+ destination (+ (* (cast i64 i) 4) j))
                            (cast u8 (>> result (cast u64 (* j 8))))))))
                (set! i (+ i 1))))
            (when (!= (transform (p/index (.data actual) 16)
                                 (p/index (.data actual) destination)
                                 initial
                                 bound)
                      (if (> bound initial) bound initial))
              (set! failures (+ failures 1)))
            (for [i 0 512]
              (when (!= (get actual i) (get expected i))
                (set! failures (+ failures 1))))
            (free! (mut actual))
            (free! (mut expected))))))
    (println "linked guarded vector-prefix checks: {} failures" failures)
    (if (= failures 0) 0 1)))
