(module stogir.tests.compact)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "stogir.verify" :as verify)
(import "stogir.compact" :as compact)
(import "stogir.a64.compile" :as compile)
(import "stogir.image" :as image)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])
(import "coil.arraylist" :use [ArrayList])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))

(defn text-of [(graph g/Graph) (roots (slice i32))] (-> (slice u8))
  (match (compile/image graph 1 roots "_compact" (malloc-allocator))
    (Err [e] (panic "{}" e))
    (Ok [code]
        (let [(mut code) code
              (mut copy) (ArrayList::new [u8] (malloc-allocator))]
          (for byte (.text code) (push! (mut copy) byte))
          (image/release! (mut code))
          (slice copy)))))

;;; Dead NOPs between live nodes disappear; live references, a branch's
;;; projections and the roots are renumbered; the code is byte-identical.
(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        three (require (b/scalar-constant! (mut graph) 11 3 8))
        dead1 (require (b/emit! (mut graph) 28 11 [x three]))
        sum (require (b/emit! (mut graph) 26 11 [x three]))
        dead2 (require (b/emit! (mut graph) 27 11 [sum three]))
        zero (require (b/scalar-constant! (mut graph) 11 0 8))
        test (require (b/emit! (mut graph) 16 1 [sum zero]))
        split (require (b/emit! (mut graph) 116 0 [start test]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        doubled (require (b/emit! (mut graph) 26 11 [sum sum]))
        left (require (b/emit! (mut graph) 120 11 [yes doubled (: 0 i32)]))
        right (require (b/emit! (mut graph) 120 11 [no sum (: 0 i32)]))]
    (assert (g/make-nop! (mut graph) dead1))
    (assert (g/make-nop! (mut graph) dead2))
    (assert (= (compact/nop-cells graph) 2))
    (let [before (text-of graph [left right])
          (mut packed) (compact/compact graph [left right] a)
          dense (.graph packed)]
      (assert (= (compact/nop-cells dense) 0))
      (assert (= (len (.instructions dense)) (- (len (.instructions graph)) 2)))
      (match (verify/structure dense) (Err [e] (panic "{}" e)) (Ok [_] 0))
      (assert (= (len (.roots packed)) 2))
      (for root (.roots packed)
        (let [node (get (.instructions dense) (cast i64 root))]
          (assert (= (n/opcode node) 120))))
      (let [after (text-of dense (slice (.roots packed)))]
        (assert (= before after)))
      (compact/release! (mut packed)))
    (g/release! (mut graph))
    (println "compaction removes dead cells and keeps code identical")
    0))
