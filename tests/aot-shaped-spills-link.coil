(module stogir.tests.aot-shaped-spills-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(extern spills :as "stogir_shaped_spills" :cc (cc/C) [(ptr u8)] (-> u64))

(defn pattern [(i i64) (seed i64)] (-> u8)
  (cast u8 (% (+ (* i 37) (/ i 7) seed 19) 251)))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut cells) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) (: 0 i64)]
    (for seed [(: 0 i64) 1 17 255]
      (clear! (mut cells))
      (set! i 0)
      (while (< i 4192) (push! (mut cells) (pattern i seed)) (set! i (+ i 1)))
      (when (!= (spills (.data cells)) 1) (set! failures (+ failures 1)))
      (set! i 0)
      (while (< i (len cells))
        ; Observations record each definition and required reload. Frame slots
        ; belong to the original16/4/8-byte owners, after a24-byte prefix.
        (let [source
                (cond (and (>= i 64) (< i 80)) (- i 64)
                      (and (>= i 80) (< i 84)) (+ 16 (- i 80))
                      (and (>= i 96) (< i 104)) (+ 32 (- i 96))
                      (and (>= i 112) (< i 116)) (+ 16 (- i 112))
                      (and (>= i 128) (< i 136)) (+ 32 (- i 128))
                      (and (>= i 144) (< i 160)) (- i 144)
                      (and (>= i 4128) (< i 4144)) (- i 4128)
                      (and (>= i 4144) (< i 4148)) (+ 16 (- i 4144))
                      (and (>= i 4152) (< i 4160)) (+ 32 (- i 4152))
                      :else i)]
          (when (!= (get cells i) (pattern source seed))
            (set! failures (+ failures 1))))
        (set! i (+ i 1))))
    (free! (mut cells))
    (println "linked per-owner spill sizes, repeated evictions and full vector reloads: {} failures"
             failures)
    (if (= failures 0) 0 1)))
