                         address)
               result
                 (call-ptr f
                           (p/cast (ptr u8) (data output))
                           0xFE123456789ABCDE
                           (H16_1 :m0 (lane16 20))
                           (H16_1 :m0 (lane16 99)))]
           (when (!= (v/vextract (.m0 result) 0) (word 20))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m0 result) 1) (word 91))
             (set! failures (+ failures 1)))))
      (9 (let [f
                 (p/cast (fnptr (cc/C)
                                [(ptr u8)
                                 u64
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1
                                 H16_1]
                                H16_1)
                         address)
               result
                 (call-ptr f
                           (p/cast (ptr u8) (data output))
                           0xFE123456789ABCDE
                           (H16_1 :m0 (lane16 0))
                           (H16_1 :m0 (lane16 1))
                           (H16_1 :m0 (lane16 2))
                           (H16_1 :m0 (lane16 3))
                           (H16_1 :m0 (lane16 4))
                           (H16_1 :m0 (lane16 5))
                           (H16_1 :m0 (lane16 6))
                           (H16_1 :m0 (lane16 20))
                           (H16_1 :m0 (lane16 99)))]
           (when (!= (v/vextract (.m0 result) 0) (word 20))
             (set! failures (+ failures 1)))
           (when (!= (v/vextract (.m0 result) 1) (word 91))
             (set! failures (+ failures 1)))))
      (10 (let [f
                  (p/cast (fnptr (cc/C) [(ptr u8) u64 H16_2 H16_1] H16_2)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_2 :m0 (lane16 20) :m1 (lane16 21))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (11 (let [f
                  (p/cast (fnptr (cc/C)
                                 [(ptr u8)
                                  u64
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_2
                                  H16_1]
                                 H16_2)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_1 :m0 (lane16 0))
                            (H16_1 :m0 (lane16 1))
                            (H16_1 :m0 (lane16 2))
                            (H16_1 :m0 (lane16 3))
                            (H16_1 :m0 (lane16 4))
                            (H16_1 :m0 (lane16 5))
                            (H16_1 :m0 (lane16 6))
                            (H16_2 :m0 (lane16 20) :m1 (lane16 21))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (12 (let [f
                  (p/cast (fnptr (cc/C) [(ptr u8) u64 H16_3 H16_1] H16_3)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_3
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (13 (let [f
                  (p/cast (fnptr (cc/C)
                                 [(ptr u8)
                                  u64
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_3
                                  H16_1]
                                 H16_3)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_1 :m0 (lane16 0))
                            (H16_1 :m0 (lane16 1))
                            (H16_1 :m0 (lane16 2))
                            (H16_1 :m0 (lane16 3))
                            (H16_1 :m0 (lane16 4))
                            (H16_1 :m0 (lane16 5))
                            (H16_1 :m0 (lane16 6))
                            (H16_3
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (14 (let [f
                  (p/cast (fnptr (cc/C) [(ptr u8) u64 H16_4 H16_1] H16_4)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_4
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22)
                              :m3 (lane16 23))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 23))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 94))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (15 (let [f
                  (p/cast (fnptr (cc/C)
                                 [(ptr u8)
                                  u64
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_1
                                  H16_4
                                  H16_1]
                                 H16_4)
                          address)
                result
                  (call-ptr f
                            (p/cast (ptr u8) (data output))
                            0xFE123456789ABCDE
                            (H16_1 :m0 (lane16 0))
                            (H16_1 :m0 (lane16 1))
                            (H16_1 :m0 (lane16 2))
                            (H16_1 :m0 (lane16 3))
                            (H16_1 :m0 (lane16 4))
                            (H16_1 :m0 (lane16 5))
                            (H16_1 :m0 (lane16 6))
                            (H16_4
                              :m0 (lane16 20)
                              :m1 (lane16 21)
                              :m2 (lane16 22)
                              :m3 (lane16 23))
                            (H16_1 :m0 (lane16 99)))]
            (when (!= (v/vextract (.m0 result) 0) (word 21))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m0 result) 1) (word 92))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 0) (word 22))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m1 result) 1) (word 93))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 0) (word 23))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m2 result) 1) (word 94))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 0) (word 20))
              (set! failures (+ failures 1)))
            (when (!= (v/vextract (.m3 result) 1) (word 91))
              (set! failures (+ failures 1)))))
      (_ (set! failures (+ failures 1))))
    (let [wide? (>= id 8)
          prefix (if (= (% id 2) 1) 7 0)
          lanes (if wide? 2 1)
          (mut i) (: 0 i64)]
      (while (< i 17)
        (let [element (/ i lanes)
              lane (% i lanes)
              wanted
                (if (< element prefix)
                    (word (cast u64 (+ element (* lane 71))))
                    (if (= element prefix)
                        (word (cast u64 (+ 99 (* lane 71))))
                        (if (= i (* (+ prefix 1) lanes))
                            (: 0xFE123456789ABCDE u64)
                            (: 0 u64))))]
          (when (!= (get output i) wanted)
            (println "HVA incoming case{} word{} got{} expected{}"
                     id
                     i
                     (get output i)
                     wanted)
            (set! failures (+ failures 1))))
        (set! i (+ i 1))))
    failures))

(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.call-groups" :as groups)
(import "stogir.call-results" :as results)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.fs" :as fs)
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn address! [(graph (mut g/Graph)) (base i32) (offset i32)] (-> i32)
  (require (b/emit! (mut graph)
                    26
                    6
                    [base
                     (require (b/scalar-constant! (mut graph)
                                                  5
                                                  (cast u64 offset)
                                                  8))])))

(defn generate [(id i32)
                (ty u8)
                (count i32)
                (prefix i32)
                (name (slice u8))
                (path (slice u8))] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        place (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 0]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 1]))
        seed (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 2]))
        width (if (= ty 21) (: 8 i32) 16)
        (mut parameters) (ArrayList::new [u8] allocator)
        (mut values) (ArrayList::new [i32] allocator)
        (mut control) start
        (mut i) (: 0 i32)
        (mut failures) 0]
    (for t [(: 6 u8) 6 5] (push! (mut parameters) t))
    (while (< i (+ prefix count 1))
      (push! (mut parameters) ty)
      (push! (mut values)
             (require (b/emit! (mut graph)
                               71
                               (cast i32 ty)
                               [start (: 0 i32) (+ i 3)])))
      (set! i (+ i 1)))
    (match (calls/create-result 9
                                (slice parameters)
                                [(groups/Group
                                   :first (+ prefix 3)
                                   :count count
                                   :alignment width)]
                                (results/pieces ty count)
                                allocator)
      (Err [message] (println "{}" message) (set! failures (+ failures 1)))
      (Ok [prototype]
          (let [(mut prototype) prototype]
            (require (calls/function! (mut graph) prototype allocator))
            (calls/release! (mut prototype)))))
    (set! i 0)
    (while (< i prefix)
      (set! control
            (require (b/vector-store! (mut graph)
                                      8
                                      control
                                      (address! (mut graph) output (* i width))
                                      (get values (cast i64 i))
                                      true)))
      (set! i (+ i 1)))
    (set! control
          (require (b/vector-store! (mut graph)
                                    8
                                    control
                                    (address! (mut graph)
                                              output
                                              (* prefix width))
                                    (get values (cast i64 (+ prefix count)))
                                    true)))
    (set! control
          (require (b/emit! (mut graph)
                            93
                            0
                            [control
                             (address! (mut graph)
                                       output
                                       (* (+ prefix 1) width))
                             seed])))
    (set! i 0)
    (while (< i count)
      (set! control
            (require (b/vector-store! (mut graph)
                                      8
                                      control
                                      (address! (mut graph) place (* i width))
                                      (get values
                                           (cast i64
                                                 (+ prefix (% (+ i 1) count))))
                                      true)))
      (set! i (+ i 1)))
    (let [ret (require (b/emit! (mut graph) 120 0 [control (: 0 i32) 0]))]
      (match (compile/object graph start [ret] name allocator)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [object]
            (let [(mut object) object]
              (match (fs/write-file allocator path (slice object))
                (Err [_] (set! failures (+ failures 1)))
                (Ok [_] 0))
              (free! (mut object)))))
      (match (compile/text graph start [ret] allocator)
        (Err [message] (println "{}" message) (set! failures (+ failures 1)))
        (Ok [text]
            (let [(mut text) text]
              (match (jit/map-text (slice text))
                (Err [message]
                     (println "{}" message)
                     (set! failures (+ failures 1)))
                (Ok [loaded]
                    (let [(mut loaded) loaded]
                      (set! failures (+ failures (exercise id (.base loaded))))
                      (jit/release! (mut loaded)))))
              (free! (mut text))))))
    (free! (mut parameters))
    (free! (mut values))
    (g/release! (mut graph))
    failures))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (set! failures
