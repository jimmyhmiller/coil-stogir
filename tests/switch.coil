(module stogir.tests.switch)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.switch" :as switch)
(import "stogir.a64.switch" :as target)
(import "coil.arraylist" :use [ArrayList])
(import "stogir.verify" :as verify)
(import "stogir.a64.compile" :as compile)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (println "{}" message) 0)))

(defn rejected [(result (Result i32 (slice u8)))] (-> i64)
  (match result (Err [_] 0) (Ok [_] 1)))

(defn invalid-dispatch [(mode i32)] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        selector (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        split (require (b/switch! (mut graph) start selector))
        a (require (b/scalar-constant! (mut graph) 11 1 8))
        z (require (b/scalar-constant! (mut graph) 11 4 8))
        value (require (b/case-range! (mut graph) split a z))]
    (when (!= mode 0) (b/case-default! (mut graph) split))
    (when (= mode 1) (b/case-value! (mut graph) split a))
    (when (= mode 2) (b/case-range! (mut graph) split z z))
    (when (= mode 3) (b/case-default! (mut graph) split))
    (when (= mode 4) (b/emit! (mut graph) 106 0 [split (: 0 i32)]))
    (let [failure (rejected (compile/validate graph))]
      (g/release! (mut graph))
      failure)))

(defn incomplete-roots [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        a (require (b/scalar-constant! (mut graph) 5 1 8))
        split (require (b/switch! (mut graph) start p))
        arm (require (b/case-value! (mut graph) split a))
        fallback (require (b/case-default! (mut graph) split))
        ret (require (b/emit! (mut graph) 120 5 [arm a (: 0 i32)]))
        unused (require (b/emit! (mut graph) 120 5 [fallback a (: 0 i32)]))
        result
          (match (compile/text graph start [ret] allocator)
            (Err [_] (: 0 i64))
            (Ok [text] (let [(mut bytes) text] (free! (mut bytes)) (: 1 i64))))]
    (g/release! (mut graph))
    result))

(defn strategy-check [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut dispatch)
          (switch/Dispatch
            :selector 1
            :ty 5
            :cases (ArrayList::new [switch/Case] allocator)
            :fallback 2)
        (mut failures) 0]
    (push! (mut (.cases dispatch))
           (switch/Case
             :low 0
             :high 0
             :target 3))
    (push! (mut (.cases dispatch))
           (switch/Case
             :low 1
             :high 1
             :target 4))
    (when (!= (target/table-length dispatch) 0) (set! failures (+ failures 1)))
    (push! (mut (.cases dispatch))
           (switch/Case
             :low 23
             :high 23
             :target 5))
    (when (!= (target/table-length dispatch) 24) (set! failures (+ failures 1)))
    (set! (mut (.cases dispatch))
          2
          (switch/Case
            :low 24
            :high 24
            :target 5))
    (when (!= (target/table-length dispatch) 0) (set! failures (+ failures 1)))
    (set! (mut (.cases dispatch))
          2
          (switch/Case
            :low 2
            :high 3
            :target 5))
    (when (!= (target/table-length dispatch) 0) (set! failures (+ failures 1)))
    (set! (mut (.cases dispatch))
          2
          (switch/Case
            :low 0xFFFFFFFFFFFFFFFF
            :high 0xFFFFFFFFFFFFFFFF
            :target 5))
    (when (!= (target/table-length dispatch) 0) (set! failures (+ failures 1)))
    (set! (mut (.cases dispatch))
          0
          (switch/Case
            :low 0xFFFFFFFFFFFFFFFD
            :high 0xFFFFFFFFFFFFFFFD
            :target 3))
    (set! (mut (.cases dispatch))
          1
          (switch/Case
            :low 0xFFFFFFFFFFFFFFFE
            :high 0xFFFFFFFFFFFFFFFE
            :target 4))
    (when (!= (target/table-length dispatch) 3) (set! failures (+ failures 1)))
    (free! (mut (.cases dispatch)))
    failures))

(defn main [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut graph) (g/create allocator)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        p (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        fp (require (b/scalar-constant! (mut graph) 12 0 8))
        a (require (b/scalar-constant! (mut graph) 11 1 8))
        z (require (b/scalar-constant! (mut graph) 11 2 8))
        u (require (b/scalar-constant! (mut graph) 5 1 8))
        variable (require (b/variable! (mut graph) 6 start "not-selector" 8))
        split (require (b/switch! (mut graph) start p))
        (mut failures) (+ (incomplete-roots) (strategy-check))]
    (let [before (len (.instructions graph))]
      (set! failures
            (+ failures
               (rejected (b/switch! (mut graph) p p))
               (rejected (b/switch! (mut graph) split p))
               (rejected (b/switch! (mut graph) start fp))
               (rejected (b/switch! (mut graph) start variable))
               (rejected (b/case-value! (mut graph) start a))
               (rejected (b/case-value! (mut graph) split p))
               (rejected (b/case-value! (mut graph) split u))
               (rejected (b/case-value! (mut graph) split fp))
               (rejected (b/case-range! (mut graph) split z a))
               (rejected (b/case-default! (mut graph) p))))
      (when (!= before (len (.instructions graph)))
        (set! failures (+ failures 1))))
    (for bad [(require (b/emit! (mut graph) 117 5 [start p]))
              (require (b/emit! (mut graph) 109 5 [split a (: 0 i32)]))
              (require (b/emit! (mut graph) 110 0 [split z a]))
              (require (b/emit! (mut graph) 111 0 [start (: 0 i32)]))]
      (set! failures (+ failures (rejected (switch/validate graph bad)))))
    (g/release! (mut graph))
    (for mode [(: 0 i32) 1 2 3 4]
      (set! failures (+ failures (invalid-dispatch mode))))
    (println "switch construction, types, defaults and overlap checks: {} failures"
             failures)
    (if (= failures 0) 0 1)))
