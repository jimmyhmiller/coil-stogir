(defn input-byte [(index i64) (seed u64)] (-> u8)
  (let [word
          (match (% (/ index 8) 7)
            (0 (: 0 u64))
            (1 0x8000000000000000)
            (2 0x7FF0000000000000)
            (3 0x7FF8123456789ABC)
            (4 0xFFFFFFFFFFFFFFFF)
            (5 0x7FC123457F800000)
            (_ 0x0123456789ABCDEF))]
    (cast u8 (>> (^ word seed) (cast u64 (* (% index 8) 8))))))

(defn exercise [(width i32) (pressure? bool) (address (ptr u8))] (-> i64)
  (let [allocator (malloc-allocator)
        f (p/cast (fnptr (cc/C) [u64 u64 u64 u64] u64) address)
        target
          (p/cast u64
                  (p/cast (ptr u8)
                          (: (fnptr-of probe) (fnptr (cc/C) [(ptr u8)] u64))))
        (mut input) (ArrayList::new [u8] allocator)
        (mut output) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) (: 0 i64)
        (mut source-offset) (: 0 i64)]
    (for seed [(: 0 u64) 17 255]
      (set! source-offset (if (= seed 0) 0 5))
      (clear! (mut input))
      (set! i 0)
      (while (< i 2048)
        (push! (mut input) (input-byte i seed))
        (set! i (+ i 1)))
      (for count [(: 0 u64) 1 2 3 7]
        (when (or pressure? (< count 2))
          (clear! (mut output))
          (set! i 0)
          (while (< i 2064) (push! (mut output) 165) (set! i (+ i 1)))
          (let [got
                  (call-ptr f
                            (p/cast u64 (p/index (.data output) 3))
                            (p/cast u64 (p/index (.data input) source-offset))
                            count
                            target)
                expected (if pressure? (: 811 u64) 0)]
            (when (!= got expected)
              (println "vector width{} pressure{} count{} return{} expected{}"
                       width
                       pressure?
                       count
                       got
                       expected)
              (set! failures (+ failures 1))))
          (set! i 0)
          (while (< i (len input))
            (when (!= (get input i) (input-byte i seed))
              (set! failures (+ failures 1)))
            (set! i (+ i 1)))
          (set! i 0)
          (while (< i (len output))
            (let [position (- i 3)
                  wanted
                    (if pressure?
                        (if (and (>= position 0)
                                 (< position (* 40 (cast i64 width))))
                            (input-byte (+ source-offset
                                           (* (if (= (% count 2) 0)
                                                  (/ position (cast i64 width))
                                                  (^ (/ position
                                                        (cast i64 width))
                                                     1))
                                              (cast i64 width))
                                           (% position (cast i64 width)))
                                        seed)
                            (if (and (>= position 1024) (< position 1344))
                                (input-byte (+ source-offset position) seed)
                                (: 165 u8)))
                        (if (and (>= position 0) (< position (cast i64 width)))
                            (input-byte (+ source-offset
                                           position
                                           (if (= count 0) (cast i64 width) 0))
                                        seed)
                            (: 165 u8)))]
              (when (!= (get output i) wanted)
                (println "vector width{} pressure{} count{} seed{} byte{} got{} expected{}"
                         width
                         pressure?
                         count
                         seed
                         i
                         (get output i)
                         wanted)
                (set! failures (+ failures 1))))
            (set! i (+ i 1))))))
    (free! (mut input))
    (free! (mut output))
    failures))

(extern branch21
        :as
        "stogir_vector_branch_21"
        :cc
        (cc/C)
        [u64 u64 u64 u64]
        (-> u64))

(extern pressure21
        :as
        "stogir_vector_pressure_21"
        :cc
        (cc/C)
        [u64 u64 u64 u64]
        (-> u64))

(extern branch37
        :as
        "stogir_vector_branch_37"
        :cc
        (cc/C)
        [u64 u64 u64 u64]
        (-> u64))

(extern pressure37
