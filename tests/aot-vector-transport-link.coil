(extern branch61
        :as
        "stogir_vector_branch_61"
        :cc
        (cc/C)
        [u64 u64 u64 u64]
        (-> u64))

(extern pressure61
        :as
        "stogir_vector_pressure_61"
        :cc
        (cc/C)
        [u64 u64 u64 u64]
        (-> u64))

(defn address [(ty i32) (pressure? bool)] (-> (ptr u8))
  (match ty
    (21 (p/cast (ptr u8)
                (if pressure?
                    (: (fnptr-of pressure21)
                       (fnptr (cc/C) [u64 u64 u64 u64] u64))
                    (: (fnptr-of branch21) (fnptr (cc/C) [u64 u64 u64 u64] u64)))))
    (37 (p/cast (ptr u8)
                (if pressure?
                    (: (fnptr-of pressure37)
                       (fnptr (cc/C) [u64 u64 u64 u64] u64))
                    (: (fnptr-of branch37) (fnptr (cc/C) [u64 u64 u64 u64] u64)))))
    (45 (p/cast (ptr u8)
                (if pressure?
                    (: (fnptr-of pressure45)
                       (fnptr (cc/C) [u64 u64 u64 u64] u64))
                    (: (fnptr-of branch45) (fnptr (cc/C) [u64 u64 u64 u64] u64)))))
    (61 (p/cast (ptr u8)
                (if pressure?
                    (: (fnptr-of pressure61)
                       (fnptr (cc/C) [u64 u64 u64 u64] u64))
                    (: (fnptr-of branch61) (fnptr (cc/C) [u64 u64 u64 u64] u64)))))
    (_ (p/cast (ptr u8) (: 0 u64)))))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for ty [(: 21 i32) 37 45 61]
      (let [width (if (or (= ty 21) (= ty 45)) (: 8 i32) 16)]
        (for pressure? [false true]
          (set! failures
                (+ failures (exercise width pressure? (address ty pressure?)))))))
    (println "linked vector memory/Phi/loops, spills, clobbering calls and aligned dynamic frames: {} failures"
             failures)
    (if (= failures 0) 0 1)))
