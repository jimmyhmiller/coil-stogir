(module stogir.tests.inline-stack-results)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.builder" :as b)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.call-inline" :as inline)
(import "stogir.sccp-rewrite" :as rewrite)
(import "stogir.symbols" :as symbols)
(import "stogir.image" :as image)
(import "stogir.link" :as link)
(import "stogir.a64.compile" :as compile)
(import "stogir.jit.darwin" :as jit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))

(defn execute [(caller image/Image) (leaf image/Image)] (-> void)
  (let [a (malloc-allocator)]
    (match (link/compose [caller leaf] a)
      (Err [message] (panic "{}" message))
      (Ok [module]
          (let [(mut module) module
                (mut ordinal) (: -1 i64)]
            (for [i 0 (len (.symbols (.image module)))]
              (when (image/same-name? (.image module)
                                      (get (.symbols (.image module)) i)
                                      "_stack_inline_caller")
                (set! ordinal i)))
            (assert (>= ordinal 0))
            (match (jit/map-image (.image module) a)
              (Err [message] (panic "{}" message))
              (Ok [loaded]
                  (let [(mut loaded) loaded
                        function
                          (p/cast (fnptr (cc/C) [u64] u64)
                                  (p/cast (ptr u8)
                                          (get (.addresses loaded) ordinal)))]
                    (for count [(: 0 u64) 1 4 1000000]
                      (let [(mut want) (: 0 u64)]
                        (for [i 0 (cast i64 count)]
                          (let [seed (- i 500000)]
                            (set! want
                                  (+ want
                                     (cast u64 seed)
                                     (if (< seed 0) (: 11 u64) 22)))))
                        (assert (= (function count) want))))
                    (jit/release-image! (mut loaded)))))
            (link/release! (mut module)))))))

(defn check [(read-result bool) (padding i32) (scope-mode i32)] (-> i64)
  (let [a (malloc-allocator)
        (mut leaf) (g/create a)
        entry (require (b/emit! (mut leaf) 104 0 [(: 0 i32)]))
        destination (require (b/emit! (mut leaf) 71 6 [entry (: 0 i32) 0]))
        seed (require (b/emit! (mut leaf) 71 11 [entry (: 0 i32) 1]))
        sixteen (require (b/scalar-constant! (mut leaf) 5 16 8))
        eight (require (b/scalar-constant! (mut leaf) 5 8 8))
        zero (require (b/scalar-constant! (mut leaf) 11 0 8))
        eleven (require (b/scalar-constant! (mut leaf) 5 11 8))
        twenty-two (require (b/scalar-constant! (mut leaf) 5 22 8))
        saved (if (= scope-mode 0) entry (require (b/emit! (mut leaf) 83 6 [entry])))
        local (require (if (and (= scope-mode 0) (= padding 0))
                           (b/frame-object! (mut leaf) saved sixteen 16)
                           (b/stack-allocate! (mut leaf) saved sixteen 16)))
        inner (if (= scope-mode 4) (require (b/emit! (mut leaf) 83 6 [local])) local)
        high (require (b/emit! (mut leaf) 26 6 [local eight]))
        condition (require (b/emit! (mut leaf) 16 1 [seed zero]))
        branch (require (b/emit! (mut leaf) 116 0 [inner condition]))
        yes (require (b/emit! (mut leaf) 107 0 [branch (: 0 i32)]))
        no (require (b/emit! (mut leaf) 108 0 [branch (: 0 i32)]))
        yes-control
          (if read-result
              (require (b/emit! (mut leaf) 91 5 [yes destination]))
              yes)
        left (require (b/emit! (mut leaf) 93 0 [yes-control local seed]))
        left (require (b/emit! (mut leaf) 93 0 [left high eleven]))
        left (require (b/emit! (mut leaf) 114 0 [left]))
        right (require (b/emit! (mut leaf) 93 0 [no local seed]))
        right (require (b/emit! (mut leaf) 93 0 [right high twenty-two]))
        right (require (b/emit! (mut leaf) 114 0 [right]))
        merged (require (b/emit! (mut leaf) 112 0 [left right]))
        first (require (b/emit! (mut leaf) 91 5 [merged local]))
        second (require (b/emit! (mut leaf) 91 5 [first high]))
        written (require (b/emit! (mut leaf) 93 0 [second destination first]))
        out-high (require (b/emit! (mut leaf) 26 6 [destination eight]))
        written (require (b/emit! (mut leaf) 93 0 [written out-high second]))
        freed (if (= scope-mode 5) (require (b/stack-free! (mut leaf) written sixteen)) written)
        restored-inner (if (= scope-mode 4) (require (b/emit! (mut leaf) 84 0 [freed inner])) freed)
        source (if (= scope-mode 2) (require (b/emit! (mut leaf) 68 6 [saved (: 0 i32)])) saved)
        restored (if (= scope-mode 0) restored-inner
                     (require (b/emit! (mut leaf) 84 0 [restored-inner source])))
        returned (require (b/emit! (mut leaf) 120 0 [restored (: 0 i32) 0]))
        (mut observed) (ArrayList::new [i32] a)
        rejected? (or read-result (= scope-mode 2) (= scope-mode 3) (= scope-mode 5))
        (mut caller) (g/create a)
        start (require (b/emit! (mut caller) 104 0 [(: 0 i32)]))
        limit (require (b/emit! (mut caller) 71 5 [start (: 0 i32) 0]))
        size (require (b/scalar-constant! (mut caller) 5 16 8))
        zero (require (b/scalar-constant! (mut caller) 5 0 8))
        one (require (b/scalar-constant! (mut caller) 5 1 8))
        eight (require (b/scalar-constant! (mut caller) 5 8 8))
        bias (require (b/scalar-constant! (mut caller) 11 500000 8))
        capture (require (b/stack-allocate! (mut caller) start size 16))
        enter (require (b/emit! (mut caller) 114 0 [capture]))
        loop (require (b/loop-begin! (mut caller) enter))
        index (require (b/loop-phi! (mut caller) loop zero))
        sum (require (b/loop-phi! (mut caller) loop zero))
        compare (require (b/emit! (mut caller) 20 1 [index limit]))
        branch (require (b/emit! (mut caller) 116 0 [loop compare]))
        body (require (b/emit! (mut caller) 107 0 [branch (: 0 i32)]))
        exit (require (b/emit! (mut caller) 108 0 [branch (: 0 i32)]))
        signed (require (b/emit! (mut caller) 36 11 [index]))
        input (require (b/emit! (mut caller) 27 11 [signed bias]))
        target (require (symbols/function! (mut caller) "_stack_inline_leaf" 0))]
    (push! (mut observed) returned)
    (when (= scope-mode 3) (push! (mut observed) saved))
    (match (calls/create-result 0 [(: 6 u8) 11] [] (results/pieces 5 2) a)
      (Err [message] (panic "{}" message))
      (Ok [prototype]
          (let [(mut prototype) prototype
                _ (require (calls/function! (mut leaf) prototype a))
                called
                  (require (calls/emit! (mut caller)
                                        prototype
                                        body
                                        target
                                        [capture input]
                                        a))
                lo (require (b/emit! (mut caller) 91 5 [called capture]))
                address (require (b/emit! (mut caller) 26 6 [capture eight]))
                hi (require (b/emit! (mut caller) 91 5 [lo address]))
                pair (require (b/emit! (mut caller) 26 5 [lo hi]))
                added (require (b/emit! (mut caller) 26 5 [sum pair]))
                next (require (b/emit! (mut caller) 26 5 [index one]))
                back (require (b/emit! (mut caller) 115 0 [hi]))
                done (require (b/emit! (mut caller) 120 5 [exit sum (: 0 i32)]))
                (mut growth) (: 0 i32)]
            (require (b/patch! (mut caller) loop 2 back))
            (require (b/patch! (mut caller) index 3 next))
            (require (b/patch! (mut caller) sum 3 added))
            ; Reserve NOPs only in the source: they have stable reference cells
            ; but apply! does not clone them into the caller.
            (for [i 0 (cast i64 padding)]
              (require (b/emit! (mut leaf) 0 0 [])))
            (match (inline/optimize caller [done] called
                                    (inline/Callee :name "_stack_inline_leaf" :graph leaf
                                      :entry entry :roots [returned] :observed (slice observed) :never false)
                                    8 16384 a)
              (Err [message] (panic "{}" message))
              (Ok [probe]
                  (let [(mut probe) probe]
                    (assert (= (.changes probe) (if rejected? 0 1)))
                    (set! growth (cast i32 (- (len (.instructions (.graph probe)))
                                              (len (.instructions caller)))))
                    (rewrite/release! (mut probe)))))
            (match (inline/optimize caller
                                    [done]
                                    called
                                    (inline/Callee
                                      :name "_stack_inline_leaf"
                                      :graph leaf
                                      :entry entry
                                      :roots [returned]
                                      :observed (slice observed)
                                      :never false)
                                    8
                                    (if rejected? 0 (- growth 1))
                                    a)
              (Err [message] (panic "{}" message))
              (Ok [rejected]
                  (let [(mut rejected) rejected]
                    (assert (= (.changes rejected) 0))
                    (rewrite/release! (mut rejected)))))
            (match (inline/optimize caller
                                    [done]
                                    called
                                    (inline/Callee
                                      :name "_stack_inline_leaf"
                                      :graph leaf
                                      :entry entry
                                      :roots [returned]
                                      :observed (slice observed)
                                      :never false)
                                    8
                                    (if rejected? 16384 growth)
                                    a)
              (Err [message] (panic "{}" message))
              (Ok [expanded]
                  (let [(mut expanded) expanded]
                    (assert (= (.changes expanded) (if rejected? 0 1)))
                    (match (compile/image leaf
                                          entry
                                          [returned]
                                          "_stack_inline_leaf"
                                          a)
                      (Err [message] (panic "{}" message))
                      (Ok [leaf-image]
                          (let [(mut leaf-image) leaf-image]
                            (match (compile/image caller
                                                  start
                                                  [done]
                                                  "_stack_inline_caller"
                                                  a)
                              (Err [message] (panic "{}" message))
                              (Ok [before]
                                  (let [(mut before) before]
                                    (execute before leaf-image)
                                    (image/release! (mut before)))))
                            (match (compile/image (.graph expanded)
                                                  start
                                                  (slice (.roots expanded))
                                                  "_stack_inline_caller"
                                                  a)
                              (Err [message] (panic "{}" message))
                              (Ok [after]
                                  (let [(mut after) after]
                                    (execute after leaf-image)
                                    (image/release! (mut after)))))
                            (image/release! (mut leaf-image)))))
                    (rewrite/release! (mut expanded)))))
            (calls/release! (mut prototype)))))
    (free! (mut observed))
    (g/release! (mut caller))
    (g/release! (mut leaf))
    (println "scoped inline result loop (result-read={}): pass" read-result)
    0))

;;; Effect declarations do not change ABI compatibility or consume inline
;;; eligibility. Other convention/control flags retain their exact boundary.
(defn effect-prototype [(declared u8) (called-flags u8) (accepted bool)] (-> void)
  (let [a (malloc-allocator) (mut leaf) (g/create a)
        entry (require (b/emit! (mut leaf) 104 0 [(: 0 i32)]))
        input (require (b/emit! (mut leaf) 71 5 [entry (: 0 i32) 0]))
        seven (require (b/scalar-constant! (mut leaf) 5 7 8))
        added (require (b/emit! (mut leaf) 26 5 [input seven]))
        returned (require (b/emit! (mut leaf) 120 5 [entry added (: 0 i32)]))
        (mut caller) (g/create a)
        start (require (b/emit! (mut caller) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut caller) 71 5 [start (: 0 i32) 0]))
        target (require (symbols/function! (mut caller) "_effect_leaf" 0))]
    (match (calls/create declared 5 [(: 5 u8)] a)
      (Err [e] (panic "{}" e))
      (Ok [prototype]
        (let [(mut prototype) prototype]
          (require (calls/function! (mut leaf) prototype a))
          (calls/release! (mut prototype)))))
    (match (calls/create called-flags 5 [(: 5 u8)] a)
      (Err [e] (panic "{}" e))
      (Ok [prototype]
        (let [(mut prototype) prototype
              call (require (calls/emit! (mut caller) prototype start target [x] a))
              ret (require (b/emit! (mut caller) 120 5 [call call (: 0 i32)]))]
          (match (inline/optimize caller [ret] call
                   (inline/Callee :name "_effect_leaf" :graph leaf :entry entry
                                  :roots [returned] :observed [returned] :never false) 8 128 a)
            (Err [e] (panic "{}" e))
            (Ok [out]
              (let [(mut out) out]
                (assert (= (> (.changes out) 0) accepted))
                (when accepted
                  (match (compile/image (.graph out) start (slice (.roots out)) "_effect_caller" a)
                    (Err [e] (panic "{}" e))
                    (Ok [code]
                      (let [(mut code) code]
                        (match (jit/map-image code a)
                          (Err [e] (panic "{}" e))
                          (Ok [loaded]
                            (let [(mut loaded) loaded
                                  f (p/cast (fnptr (cc/C) [u64] u64) (.base (.memory loaded)))]
                              (for value [(: 0 u64) 1 0x7FFFFFFFFFFFFFFF 0xFFFFFFFFFFFFFFFF]
                                (assert (= (call-ptr f value) (+ value 7))))
                              (jit/release-image! (mut loaded)))))
                        (image/release! (mut code))))))
                (rewrite/release! (mut out)))))
          (calls/release! (mut prototype)))))
    (g/release! (mut caller)) (g/release! (mut leaf))))

(defn main [] (-> i64)
  (for declared [(: 0 u8) 32 64 96]
    (for called [(: 0 u8) 32 64 96] (effect-prototype declared called true)))
  (effect-prototype 0 9 false)
  (effect-prototype 9 0 false)
  (effect-prototype 0 16 false)
  (+ (check false 0 0) (check true 0 0) (check false 1024 0)
     (check false 0 1) (check false 0 2) (check false 0 3)
     (check false 0 4) (check false 0 5) (check true 0 1)))
