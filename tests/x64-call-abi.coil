;;; System V x86-64 ABI compatibility of generated code with C, in both
;;; directions: scalars beyond the register banks, narrow integers, argument
;;; groups in registers and on the stack, mixed pairs, register-pair results,
;;; indirect results, MEMORY aggregates and variadic calls.
;;;
;;; The C side is tests/x64-call-helpers.c; run with tools/x86/call-tests.sh.
;;; Generated code reads and writes memory by calling the C accessors
;;; (c_load64, c_store64, ...), so the test needs no other operation family.
(module stogir.tests.x64-call-abi)
(import "stogir.graph" :as g)
(import "stogir.calls" :as calls)
(import "stogir.call-results" :as results)
(import "stogir.jit.native" :as jit)
(import "stogir.x64.testing" :as t)
(import "stogir.x64.call-testing" :as ct)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(extern c_load64 :cc (cc/C) [] (-> void))
(extern c_store64 :cc (cc/C) [] (-> void))
(extern c_loadf64 :cc (cc/C) [] (-> void))
(extern c_storef64 :cc (cc/C) [] (-> void))
(extern c_ints10 :cc (cc/C) [i64 i64 i64 i64 i64 i64 i64 i64 i64 i64] (-> i64))
(extern c_doubles12 :cc (cc/C) [f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64] (-> f64))
(extern c_mixed :cc (cc/C) [i64 f64 i64 f64 f32 i64 f64 i64 f64 i64 f64 i64 f64 i64 f64 f32 f64 i64] (-> f64))
(extern c_wide_view :cc (cc/C) [] (-> void))
(extern c_ret_i8 :cc (cc/C) [] (-> void))
(extern c_ret_u16 :cc (cc/C) [] (-> void))
(extern c_take_ii :cc (cc/C) [] (-> void))
(extern c_take_dd :cc (cc/C) [] (-> void))
(extern c_take_id :cc (cc/C) [] (-> void))
(extern c_take_di :cc (cc/C) [] (-> void))
(extern c_take_fi :cc (cc/C) [] (-> void))
(extern c_group_stack :cc (cc/C) [] (-> void))
(extern c_group_banks :cc (cc/C) [] (-> void))
(extern c_ret_ii :cc (cc/C) [] (-> void))
(extern c_ret_dd :cc (cc/C) [] (-> void))
(extern c_ret_id :cc (cc/C) [] (-> void))
(extern c_ret_di :cc (cc/C) [] (-> void))
(extern c_ret_big :cc (cc/C) [] (-> void))
(extern c_take_big :cc (cc/C) [] (-> void))
(extern c_take_big16 :cc (cc/C) [] (-> void))
(extern c_take_two_big :cc (cc/C) [] (-> void))
(extern c_take_wide :cc (cc/C) [] (-> void))
(extern c_sum_va :cc (cc/C) [i64 ...] (-> f64))
(extern snprintf :cc (cc/C) [(ptr u8) u64 (ptr i8) ...] (-> i32))
(extern memmove :cc (cc/C) [(ptr u8) (ptr u8) u64] (-> (ptr u8)))
(extern memcmp :cc (cc/C) [(ptr u8) (ptr u8) u64] (-> i32))
(extern c_capture :cc (cc/C) [] (-> i64))
(extern c_captured_rax :cc (cc/C) [] (-> u64))
(extern c_drive_take_ii :cc (cc/C) [(ptr u8) i64 i64 i64] (-> i64))
(extern c_drive_take_id :cc (cc/C) [(ptr u8) i64 f64 i64 f64] (-> f64))
(extern c_drive_group_stack :cc (cc/C) [(ptr u8) i64] (-> i64))
(extern c_drive_ret_ii :cc (cc/C) [(ptr u8) i64 i64] (-> i64))
(extern c_drive_ret_dd :cc (cc/C) [(ptr u8) f64 f64] (-> f64))
(extern c_drive_ret_id :cc (cc/C) [(ptr u8) i64 f64] (-> f64))
(extern c_drive_ret_di :cc (cc/C) [(ptr u8) i64 f64] (-> f64))
(extern c_drive_ret_big :cc (cc/C) [(ptr u8) i64 i64] (-> i64))
(extern c_drive_ret_big_rax :cc (cc/C) [(ptr u8) i64 i64] (-> i64))
(extern c_drive_take_big :cc (cc/C) [(ptr u8) i64 i64 i64 i64 i64] (-> i64))

;;; The address of a host function as a u64.
(defn address-of [(f Code)] (-> Code)
  `(primitive/cast u64 (primitive/cast (ptr u8) (fnptr-of ~f))))

(def NAMES
  ["c_load64" "c_store64" "c_loadf64" "c_storef64" "c_ints10" "c_doubles12" "c_mixed"
   "c_wide_view" "c_ret_i8" "c_ret_u16" "c_take_ii" "c_take_dd" "c_take_id" "c_take_di"
   "c_take_fi" "c_group_stack" "c_group_banks" "c_ret_ii" "c_ret_dd" "c_ret_id" "c_ret_di"
   "c_ret_big" "c_take_big" "c_take_big16" "c_take_two_big" "c_take_wide" "c_sum_va"
   "snprintf" "memmove" "memcmp" "c_capture"])

(defn addresses [] (-> (array u64 31))
  (let [table [(address-of c_load64) (address-of c_store64) (address-of c_loadf64) (address-of c_storef64)
   (address-of c_ints10) (address-of c_doubles12) (address-of c_mixed) (address-of c_wide_view)
   (address-of c_ret_i8) (address-of c_ret_u16) (address-of c_take_ii) (address-of c_take_dd)
   (address-of c_take_id) (address-of c_take_di) (address-of c_take_fi)
   (address-of c_group_stack) (address-of c_group_banks) (address-of c_ret_ii)
   (address-of c_ret_dd) (address-of c_ret_id) (address-of c_ret_di) (address-of c_ret_big)
   (address-of c_take_big) (address-of c_take_big16) (address-of c_take_two_big)
   (address-of c_take_wide) (address-of c_sum_va) (address-of snprintf)
               (address-of memmove) (address-of memcmp) (address-of c_capture)]]
    table))

(defn finish [(label (slice u8)) (graph g/Graph) (start i32) (roots (slice i32))
              (a (dyn Allocator))] (-> jit/Loaded)
  (let [table (addresses)]
    (ct/build label graph start roots NAMES table a)))

;;; The bit pattern of a double.
(defn bits-of [(x f64)] (-> u64)
  (let [(mut cell) x] (load (primitive/cast (ptr u64) (mut cell)))))

;;; value * factor as an I64 node.
(defn times! [(graph (mut g/Graph)) (value i32) (factor u64)] (-> i32)
  (t/binary! (mut graph) 28 11 value (t/constant! (mut graph) 11 factor)))

(defn check! [(tally (mut t/Tally)) (label (slice u8)) (good bool)] (-> void)
  (set! (.checks tally) (+ (.checks tally) 1))
  (unless good
    (when (< (.failures tally) 40) (println "{}: wrong result" label))
    (t/fail! (mut tally))))

;;; Ten integer parameters (four on the stack) forwarded in reverse order as
;;; ten integer arguments (four on the stack).
(defn ints! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut params) (primitive/zeroed (array i32 10))
        tys [(: 11 u8) 11 11 11 11 11 11 11 11 11]
        (mut proto) (ct/prototype false 11 tys [] a)]
    (ct/declare! (mut graph) proto a)
    (for [i 0 10] (set! (mut params) i (t/param! (mut graph) start 11 (cast i32 i))))
    (let [call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_ints10")
                         [(get params 9) (get params 8) (get params 7) (get params 6)
                          (get params 5) (get params 4) (get params 3) (get params 2)
                          (get params 1) (get params 0)] a)
          ret (t/return! (mut graph) call 11 call)
          (mut loaded) (finish "ints" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [i64 i64 i64 i64 i64 i64 i64 i64 i64 i64] i64)
                            (ct/entry loaded))]
      (for s [(: -7 i64) 0 3 1000000007]
        (check! (mut tally) "ints"
                (= (call-ptr f s (+ s 1) (+ s 2) (+ s 3) (+ s 4) (+ s 5) (+ s 6) (+ s 7)
                             (+ s 8) (+ s 9))
                   (c_ints10 (+ s 9) (+ s 8) (+ s 7) (+ s 6) (+ s 5) (+ s 4) (+ s 3) (+ s 2)
                             (+ s 1) s))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (g/release! (mut graph))))

;;; Twelve double parameters (four on the stack) forwarded in reverse order.
(defn doubles! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut params) (primitive/zeroed (array i32 12))
        tys [(: 12 u8) 12 12 12 12 12 12 12 12 12 12 12]
        (mut proto) (ct/prototype false 12 tys [] a)]
    (ct/declare! (mut graph) proto a)
    (for [i 0 12] (set! (mut params) i (t/param! (mut graph) start 12 (cast i32 i))))
    (let [call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_doubles12")
                         [(get params 11) (get params 10) (get params 9) (get params 8)
                          (get params 7) (get params 6) (get params 5) (get params 4)
                          (get params 3) (get params 2) (get params 1) (get params 0)] a)
          ret (t/return! (mut graph) call 12 call)
          (mut loaded) (finish "doubles" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64 f64] f64)
                            (ct/entry loaded))]
      (for s [(: -2.5 f64) 0.0 1.25 1.0e9]
        (check! (mut tally) "doubles"
                (= (call-ptr f s (+ s 1.0) (+ s 2.0) (+ s 3.0) (+ s 4.0) (+ s 5.0) (+ s 6.0)
                             (+ s 7.0) (+ s 8.0) (+ s 9.0) (+ s 10.0) (+ s 11.0))
                   (c_doubles12 (+ s 11.0) (+ s 10.0) (+ s 9.0) (+ s 8.0) (+ s 7.0) (+ s 6.0)
                                (+ s 5.0) (+ s 4.0) (+ s 3.0) (+ s 2.0) (+ s 1.0) s))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (g/release! (mut graph))))

;;; Eighteen parameters of both banks and FLOAT, forwarded unchanged: every
;;; bank overflows to the stack independently.
(defn mixed! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut params) (primitive/zeroed (array i32 18))
        tys [(: 11 u8) 12 11 12 13 11 12 11 12 11 12 11 12 11 12 13 12 11]
        (mut proto) (ct/prototype false 12 tys [] a)]
    (ct/declare! (mut graph) proto a)
    (for [i 0 18]
      (set! (mut params) i (t/param! (mut graph) start (cast i32 (get tys i)) (cast i32 i))))
    (let [call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_mixed")
                         params a)
          ret (t/return! (mut graph) call 12 call)
          (mut loaded) (finish "mixed" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [i64 f64 i64 f64 f32 i64 f64 i64 f64 i64 f64 i64 f64
                                           i64 f64 f32 f64 i64] f64)
                            (ct/entry loaded))]
      (for s [(: -3 i64) 0 5 123456]
        (let [d (cast f64 s)]
          (check! (mut tally) "mixed"
                  (= (call-ptr f s (+ d 0.5) (+ s 1) (+ d 1.5) (: 2.5 f32) (+ s 2) (+ d 3.5)
                               (+ s 3) (+ d 4.5) (+ s 4) (+ d 5.5) (+ s 5) (+ d 6.5) (+ s 6)
                               (+ d 7.5) (: -8.5 f32) (+ d 9.5) (+ s 7))
                     (c_mixed s (+ d 0.5) (+ s 1) (+ d 1.5) (: 2.5 f32) (+ s 2) (+ d 3.5)
                              (+ s 3) (+ d 4.5) (+ s 4) (+ d 5.5) (+ s 5) (+ d 6.5) (+ s 6)
                              (+ d 7.5) (: -8.5 f32) (+ d 9.5) (+ s 7))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (g/release! (mut graph))))

;;; Narrow integers: the generated callee receives garbage above each
;;; parameter's width (it never trusts it), and extends each argument to 32
;;; bits for a C callee that reads all 32.
(defn narrow! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        tys [(: 8 u8) 2 9 3 10 4]
        (mut params) (primitive/zeroed (array i32 6))
        (mut proto) (ct/prototype false 11 tys [] a)]
    (ct/declare! (mut graph) proto a)
    (for [i 0 6]
      (set! (mut params) i (t/param! (mut graph) start (cast i32 (get tys i)) (cast i32 i))))
    (let [call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_wide_view") params a)
          ret (t/return! (mut graph) call 11 call)
          (mut loaded) (finish "narrow" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [u64 u64 u64 u64 u64 u64] i64) (ct/entry loaded))]
      (for v [(: 0 u64) 1 0x7F 0x80 0xFF 0x7FFF 0x8000 0xFFFF 0x7FFFFFFF 0x80000000 0xFFFFFFFF
              0x123456789ABCDEF0]
        (let [expected (+ (cast i64 (cast i8 (& v 0xFF)))
                          (* 3 (cast i64 (& v 0xFF)))
                          (* 5 (cast i64 (cast i16 (& v 0xFFFF))))
                          (* 7 (cast i64 (& v 0xFFFF)))
                          (* 11 (cast i64 (cast i32 (& v 0xFFFFFFFF))))
                          (* 13 (cast i64 (& v 0xFFFFFFFF))))]
          (check! (mut tally) "narrow"
                  (= (call-ptr f (t/dirty 8 v) (t/dirty 2 v) (t/dirty 9 v) (t/dirty 3 v)
                               (t/dirty 10 v) (t/dirty 4 v))
                     expected))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (g/release! (mut graph))))

;;; A narrow C result is extended by its own type before it is used.
(defn narrow-result! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (for signed [true false]
    (let [(mut graph) (g/create a)
          start (t/start! (mut graph))
          ty (if signed (: 8 u8) 3)
          (mut own) (ct/prototype false 11 [(: 11 u8)] [] a)
          (mut proto) (ct/prototype false ty [(: 11 u8)] [] a)]
      (ct/declare! (mut graph) own a)
      (let [v (t/param! (mut graph) start 11 0)
            call (ct/call! (mut graph) proto start
                           (ct/named! (mut graph) (if signed "c_ret_i8" "c_ret_u16")) [v] a)
            wide (t/unary! (mut graph) (if signed 33 34) 11 call)
            ret (t/return! (mut graph) call 11 wide)
            (mut loaded) (finish "narrow result" graph start [ret] a)
            f (primitive/cast (fnptr (cc/C) [i64] i64) (ct/entry loaded))]
        (for v [(: 0 i64) 1 127 128 255 256 65535 65536 -1 0x12345]
          (check! (mut tally) "narrow result"
                  (= (call-ptr f v)
                     (if signed (cast i64 (cast i8 (& v 0xFF))) (& v 0xFFFF)))))
        (jit/release-image! (mut loaded)))
      (calls/release! (mut own))
      (calls/release! (mut proto))
      (g/release! (mut graph)))))

;;; An integer pair in rdi/rsi, both as received from C and as passed to C.
(defn pair-ii! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut proto) (ct/prototype false 11 [(: 11 u8) 11 11] [(ct/group 0 2 8)] a)]
    (ct/declare! (mut graph) proto a)
    (let [pa (t/param! (mut graph) start 11 0)
          pb (t/param! (mut graph) start 11 1)
          k (t/param! (mut graph) start 11 2)
          ; Swap the halves on the way out so a wrong order shows.
          call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_take_ii") [pb pa k] a)
          ret (t/return! (mut graph) call 11 call)
          (mut loaded) (finish "pair ii" graph start [ret] a)]
      (for s [(: -5 i64) 0 9 1000003]
        (check! (mut tally) "pair ii"
                (= (c_drive_take_ii (ct/entry loaded) s (+ s 100) (- s 7))
                   (+ (* (+ s 100) 3) (* s 5) (- s 7)))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (g/release! (mut graph))))

;;; A mixed INTEGER/SSE pair, received from C in rdi + xmm0 and passed on.
(defn pair-id! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut proto) (ct/prototype false 12 [(: 11 u8) 12 11 12] [(ct/group 0 2 8)] a)]
    (ct/declare! (mut graph) proto a)
    (let [pa (t/param! (mut graph) start 11 0)
          pb (t/param! (mut graph) start 12 1)
          k (t/param! (mut graph) start 11 2)
          m (t/param! (mut graph) start 12 3)
          ; k and the pair's integer swap, m and the pair's double swap.
          call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_take_id") [k m pa pb] a)
          ret (t/return! (mut graph) call 12 call)
          (mut loaded) (finish "pair id" graph start [ret] a)]
      (for s [(: -5 i64) 0 9 1000003]
        (let [d (+ (cast f64 s) 0.25)
              m (- (cast f64 s) 1.5)]
          ; c_take_id({k, m}, a, d) = (k * 3 + a) + m * 5 + d * 7
          (check! (mut tally) "pair id"
                  (= (c_drive_take_id (ct/entry loaded) s d (+ s 11) m)
                     (+ (cast f64 (+ (* (+ s 11) 3) s)) (* m 5.0) (* d 7.0))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (g/release! (mut graph))))

;;; Pairs of every class mix as arguments to C: SSE/SSE, SSE/INTEGER after a
;;; scalar double, and a FLOAT eightbyte with an INTEGER one.
(defn pair-classes! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 12 [(: 12 u8) 12 11 13 6] [] a)
        (mut dd) (ct/prototype false 12 [(: 12 u8) 12 12] [(ct/group 0 2 8)] a)
        (mut di) (ct/prototype false 12 [(: 12 u8) 12 11 11] [(ct/group 1 2 8)] a)
        (mut fi) (ct/prototype false 12 [(: 13 u8) 11] [(ct/group 0 2 8)] a)
        (mut store) (ct/prototype false 0 [(: 6 u8) 11 12] [] a)]
    (ct/declare! (mut graph) own a)
    (let [x (t/param! (mut graph) start 12 0)
          y (t/param! (mut graph) start 12 1)
          n (t/param! (mut graph) start 11 2)
          f (t/param! (mut graph) start 13 3)
          out (t/param! (mut graph) start 6 4)
          one (t/constant! (mut graph) 11 1)
          two (t/constant! (mut graph) 11 2)
          zero (t/constant! (mut graph) 11 0)
          c1 (ct/call! (mut graph) dd start (ct/named! (mut graph) "c_take_dd") [y x x] a)
          s1 (ct/call! (mut graph) store c1 (ct/named! (mut graph) "c_storef64") [out zero c1] a)
          c2 (ct/call! (mut graph) di s1 (ct/named! (mut graph) "c_take_di") [x y n n] a)
          s2 (ct/call! (mut graph) store c2 (ct/named! (mut graph) "c_storef64") [out one c2] a)
          c3 (ct/call! (mut graph) fi s2 (ct/named! (mut graph) "c_take_fi") [f n] a)
          s3 (ct/call! (mut graph) store c3 (ct/named! (mut graph) "c_storef64") [out two c3] a)
          ret (t/return! (mut graph) s3 12 c3)]
      (let [(mut loaded) (finish "pair classes" graph start [ret] a)
            run (primitive/cast (fnptr (cc/C) [f64 f64 i64 f32 (ptr f64)] f64) (ct/entry loaded))
            (mut out) [(: 0.0 f64) 0.0 0.0]]
        (for s [(: -5 i64) 0 9 1000003]
          (let [x (+ (cast f64 s) 0.5)
                y (- (cast f64 s) 2.25)
                f (: 1.75 f32)
                last (call-ptr run x y s f (primitive/cast (ptr f64) (mut out)))]
            (check! (mut tally) "pair dd" (= (get out 0) (+ (* y 3.0) (* x 5.0) x)))
            ; c_take_di(m = x, {y, n}, n) = (n * 3 + n) + y * 5 + x * 7
            (check! (mut tally) "pair di"
                    (= (get out 1) (+ (cast f64 (* s 4)) (* y 5.0) (* x 7.0))))
            (check! (mut tally) "pair fi" (= (get out 2) (+ 3.5 (cast f64 s))))
            (check! (mut tally) "pair fi result" (= last (get out 2)))))
        (jit/release-image! (mut loaded))))
    (calls/release! (mut own))
    (calls/release! (mut dd))
    (calls/release! (mut di))
    (calls/release! (mut fi))
    (calls/release! (mut store))
    (g/release! (mut graph))))

;;; Five integers leave one register: the pair goes to the stack whole and
;;; the integer after it still takes r9. Received from C and passed to C.
(defn group-stack! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        tys [(: 11 u8) 11 11 11 11 11 11 11]
        (mut params) (primitive/zeroed (array i32 8))
        (mut proto) (ct/prototype false 11 tys [(ct/group 5 2 8)] a)]
    (ct/declare! (mut graph) proto a)
    (for [i 0 8] (set! (mut params) i (t/param! (mut graph) start 11 (cast i32 i))))
    (let [call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_group_stack")
                         [(get params 4) (get params 3) (get params 2) (get params 1)
                          (get params 0) (get params 6) (get params 5) (get params 7)] a)
          ret (t/return! (mut graph) call 11 call)
          (mut loaded) (finish "group stack" graph start [ret] a)]
      (for s [(: -9 i64) 0 4 999983]
        ; c_group_stack(s+5, s+4, s+3, s+2, s+1, {s+7, s+6}, s+8)
        (check! (mut tally) "group stack"
                (= (c_drive_group_stack (ct/entry loaded) s)
                   (+ (+ s 5) (* 2 (+ s 4)) (* 3 (+ s 3)) (* 4 (+ s 2)) (* 5 (+ s 1))
                      (* 6 (+ s 7)) (* 7 (+ s 6)) (* 8 (+ s 8))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (g/release! (mut graph))))

;;; Seven doubles leave xmm7: a double pair goes to the stack whole without
;;; using it up, a mixed pair then takes rdi and xmm7, a last double goes to
;;; the stack.
(defn group-banks! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        tys [(: 12 u8) 12 12 12 12 12 12 12 12 11 12 12]
        (mut params) (primitive/zeroed (array i32 12))
        (mut proto) (ct/prototype false 12 tys [(ct/group 7 2 8) (ct/group 9 2 8)] a)
        (mut own) (ct/prototype false 12 tys [] a)]
    (ct/declare! (mut graph) own a)
    (for [i 0 12]
      (set! (mut params) i (t/param! (mut graph) start (cast i32 (get tys i)) (cast i32 i))))
    (let [call (ct/call! (mut graph) proto start (ct/named! (mut graph) "c_group_banks") params a)
          ret (t/return! (mut graph) call 12 call)
          (mut loaded) (finish "group banks" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [f64 f64 f64 f64 f64 f64 f64 f64 f64 i64 f64 f64] f64)
                            (ct/entry loaded))]
      (for s [(: -3 i64) 0 6 4099]
        (let [d (cast f64 s)]
          (check! (mut tally) "group banks"
                  (= (call-ptr f d (+ d 1.0) (+ d 2.0) (+ d 3.0) (+ d 4.0) (+ d 5.0) (+ d 6.0)
                               (+ d 0.5) (+ d 1.5) (+ s 3) (+ d 2.5) (+ d 3.5))
                     (+ d (+ d 1.0) (+ d 2.0) (+ d 3.0) (+ d 4.0) (+ d 5.0) (+ d 6.0)
                        (* 3.0 (+ d 0.5)) (* 5.0 (+ d 1.5)) (* 7.0 (cast f64 (+ s 3)))
                        (* 11.0 (+ d 2.5)) (* 13.0 (+ d 3.5)))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut proto))
    (calls/release! (mut own))
    (g/release! (mut graph))))

;;; Register-pair results from C, captured into a result place: rax/rdx,
;;; xmm0/xmm1, rax + xmm0 and xmm0 + rax.
(defn results-from-c! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 0 [(: 6 u8) 11 12] [] a)
        (mut ii) (ct/result-prototype [(: 6 u8) 11 11] [] (results/pieces 11 2) a)
        (mut dd) (ct/result-prototype [(: 6 u8) 12 12] [] (results/pieces 12 2) a)
        (mut id) (ct/result-prototype [(: 6 u8) 11 12] [] (results/pair 11 12) a)
        (mut di) (ct/result-prototype [(: 6 u8) 11 12] [] (results/pair 12 11) a)
        (mut add) (ct/prototype false 6 [(: 6 u8)] [] a)]
    (ct/declare! (mut graph) own a)
    (let [out (t/param! (mut graph) start 6 0)
          n (t/param! (mut graph) start 11 1)
          d (t/param! (mut graph) start 12 2)
          sixteen (t/constant! (mut graph) 6 16)
          out1 (t/binary! (mut graph) 26 6 out sixteen)
          out2 (t/binary! (mut graph) 26 6 out1 sixteen)
          out3 (t/binary! (mut graph) 26 6 out2 sixteen)
          c1 (ct/call! (mut graph) ii start (ct/named! (mut graph) "c_ret_ii") [out n n] a)
          c2 (ct/call! (mut graph) dd c1 (ct/named! (mut graph) "c_ret_dd") [out1 d d] a)
          c3 (ct/call! (mut graph) id c2 (ct/named! (mut graph) "c_ret_id") [out2 n d] a)
          c4 (ct/call! (mut graph) di c3 (ct/named! (mut graph) "c_ret_di") [out3 n d] a)
          ret (t/return! (mut graph) c4 0 0)
          (mut loaded) (finish "results from c" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [(ptr u64) i64 f64] void) (ct/entry loaded))
          (mut out) (primitive/zeroed (array u64 8))]
      (for s [(: -5 i64) 0 9 1000003]
        (let [x (+ (cast f64 s) 0.75)]
          (call-ptr f (primitive/cast (ptr u64) (mut out)) s x)
          (check! (mut tally) "ret ii"
                  (and (= (get out 0) (cast u64 (+ s s))) (= (get out 1) 0)))
          (check! (mut tally) "ret dd"
                  (and (= (get out 2) (bits-of (+ x x))) (= (get out 3) (bits-of 0.0))))
          (check! (mut tally) "ret id"
                  (and (= (get out 4) (cast u64 (* s 2))) (= (get out 5) (bits-of (* x 0.5)))))
          (check! (mut tally) "ret di"
                  (and (= (get out 6) (bits-of (* x 0.25))) (= (get out 7) (cast u64 (* s 3)))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut ii))
    (calls/release! (mut dd))
    (calls/release! (mut id))
    (calls/release! (mut di))
    (calls/release! (mut add))
    (g/release! (mut graph))))

;;; One generated function returning register pieces to a C caller. `kind`
;;; 0: {a + b, a - b} in rax/rdx; 1: {x, y} in xmm0/xmm1; 2: {n, x} in
;;; rax + xmm0; 3: {x, n} in xmm0 + rax.
(defn result-to-c [(kind i32) (a (dyn Allocator))] (-> jit/Loaded)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        first (if (or (= kind 1)) (: 12 u8) 11)
        second (: 12 u8)
        spec (cond (= kind 0) (results/pieces 11 2)
                   (= kind 1) (results/pieces 12 2)
                   (= kind 2) (results/pair 11 12)
                   :else (results/pair 12 11))
        (mut own) (ct/result-prototype
                    (if (= kind 0) [(: 6 u8) 11 11] (if (= kind 1) [(: 6 u8) 12 12] [(: 6 u8) 11 12]))
                    [] spec a)
        (mut store) (ct/prototype false 0 [(: 6 u8) 11 11] [] a)
        (mut storef) (ct/prototype false 0 [(: 6 u8) 11 12] [] a)]
    (ct/declare! (mut graph) own a)
    (let [place (t/param! (mut graph) start 6 0)
          p (t/param! (mut graph) start (if (= kind 1) 12 11) 1)
          q (t/param! (mut graph) start (if (= kind 0) 11 12) 2)
          zero (t/constant! (mut graph) 11 0)
          one (t/constant! (mut graph) 11 1)
          put (ct/named! (mut graph) "c_store64")
          putf (ct/named! (mut graph) "c_storef64")
          c1 (cond (= kind 0)
                     (ct/call! (mut graph) store start put
                               [place zero (t/binary! (mut graph) 26 11 p q)] a)
                   (= kind 1) (ct/call! (mut graph) storef start putf [place zero p] a)
                   (= kind 2) (ct/call! (mut graph) store start put [place zero p] a)
                   :else (ct/call! (mut graph) storef start putf [place zero q] a))
          c2 (cond (= kind 0)
                     (ct/call! (mut graph) store c1 put
                               [place one (t/binary! (mut graph) 27 11 p q)] a)
                   (= kind 1) (ct/call! (mut graph) storef c1 putf [place one q] a)
                   (= kind 2) (ct/call! (mut graph) storef c1 putf [place one q] a)
                   :else (ct/call! (mut graph) store c1 put [place one p] a))
          ret (t/return! (mut graph) c2 0 0)
          loaded (finish "result to c" graph start [ret] a)]
      (calls/release! (mut own))
      (calls/release! (mut store))
      (calls/release! (mut storef))
      (g/release! (mut graph))
      loaded)))

(defn results-to-c! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut ii) (result-to-c 0 a)
        (mut dd) (result-to-c 1 a)
        (mut id) (result-to-c 2 a)
        (mut di) (result-to-c 3 a)]
    (for s [(: -5 i64) 0 9 1000003]
      (let [x (+ (cast f64 s) 0.75)
            y (- (cast f64 s) 3.5)]
        (check! (mut tally) "to c ii"
                (= (c_drive_ret_ii (ct/entry ii) s 17) (+ (* (+ s 17) 7) (* (- s 17) 13))))
        (check! (mut tally) "to c dd"
                (= (c_drive_ret_dd (ct/entry dd) x y) (+ (* x 7.0) (* y 13.0))))
        (check! (mut tally) "to c id"
                (= (c_drive_ret_id (ct/entry id) s x) (+ (* (cast f64 s) 7.0) (* x 13.0))))
        (check! (mut tally) "to c di"
                (= (c_drive_ret_di (ct/entry di) s x) (+ (* x 7.0) (* (cast f64 s) 13.0))))))
    (jit/release-image! (mut ii))
    (jit/release-image! (mut dd))
    (jit/release-image! (mut id))
    (jit/release-image! (mut di))))

;;; Indirect results. To C: the hidden pointer is the first integer argument.
;;; From C: the generated callee writes through rdi and returns it in rax.
(defn indirect! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 0 [(: 6 u8) 11 11] [] a)
        (mut big) (ct/result-prototype [(: 6 u8) 11 11] [] (results/indirect) a)]
    (ct/declare! (mut graph) own a)
    (let [out (t/param! (mut graph) start 6 0)
          x (t/param! (mut graph) start 11 1)
          y (t/param! (mut graph) start 11 2)
          call (ct/call! (mut graph) big start (ct/named! (mut graph) "c_ret_big") [out y x] a)
          ret (t/return! (mut graph) call 0 0)
          (mut loaded) (finish "sret to c" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [(ptr i64) i64 i64] void) (ct/entry loaded))
          (mut out) (primitive/zeroed (array i64 3))]
      (for s [(: -5 i64) 0 9 1000003]
        (call-ptr f (primitive/cast (ptr i64) (mut out)) s (+ s 2))
        (check! (mut tally) "sret to c"
                (and (= (get out 0) (+ s 2)) (= (get out 1) s) (= (get out 2) (* s (+ s 2))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut big))
    (g/release! (mut graph)))
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/result-prototype [(: 6 u8) 11 11] [] (results/indirect) a)
        (mut store) (ct/prototype false 0 [(: 6 u8) 11 11] [] a)]
    (ct/declare! (mut graph) own a)
    (let [place (t/param! (mut graph) start 6 0)
          x (t/param! (mut graph) start 11 1)
          y (t/param! (mut graph) start 11 2)
          put (ct/named! (mut graph) "c_store64")
          c1 (ct/call! (mut graph) store start put [place (t/constant! (mut graph) 11 0) x] a)
          c2 (ct/call! (mut graph) store c1 put [place (t/constant! (mut graph) 11 1) y] a)
          c3 (ct/call! (mut graph) store c2 put
                       [place (t/constant! (mut graph) 11 2) (t/binary! (mut graph) 28 11 x y)] a)
          ret (t/return! (mut graph) c3 0 0)
          (mut loaded) (finish "sret from c" graph start [ret] a)]
      (for s [(: -5 i64) 0 9 1000003]
        (let [expected (+ s (* 2 (+ s 3)) (* 3 (* s (+ s 3))))]
          (check! (mut tally) "sret from c"
                  (= (c_drive_ret_big (ct/entry loaded) s (+ s 3)) expected))
          (check! (mut tally) "sret pointer in rax"
                  (= (c_drive_ret_big_rax (ct/entry loaded) s (+ s 3)) expected))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut store))
    (g/release! (mut graph))))

;;; MEMORY aggregates passed to C with ARGVAL: 24 bytes between two integers;
;;; a 16-aligned one; two after the integer registers are full; and 200 bytes
;;; through the copy loop.
(defn memory-to-c! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 11 [(: 6 u8) 11 11] [] a)
        (mut big) (ct/prototype false 11 [(: 11 u8) 6 11] [] a)
        (mut big16) (ct/prototype false 11 [(: 11 u8) 6 11] [] a)
        (mut two) (ct/prototype false 11 [(: 11 u8) 11 11 11 11 11 11 6 11 6] [] a)
        ; An ARGVAL needs no record: the call's own node says what is copied.
        (mut wide) (ct/prototype false 11 [(: 6 u8) 11] [] a)
        (mut store) (ct/prototype false 0 [(: 6 u8) 11 11] [] a)]
    (ct/declare! (mut graph) own a)
    (ct/memory! (mut big) 1 24 8)
    (ct/memory! (mut big16) 1 32 16)
    (ct/memory! (mut two) 7 24 8)
    (ct/memory! (mut two) 9 24 8)
    (let [source (t/param! (mut graph) start 6 0)
          k (t/param! (mut graph) start 11 1)
          l (t/param! (mut graph) start 11 2)
          put (ct/named! (mut graph) "c_store64")
          thirty-two (t/constant! (mut graph) 6 32)
          second (t/binary! (mut graph) 26 6 source thirty-two)
          c1 (ct/call! (mut graph) big start (ct/named! (mut graph) "c_take_big")
                       [k (ct/by-value! (mut graph) source 24 8) l] a)
          s1 (ct/call! (mut graph) store c1 put [source (t/constant! (mut graph) 11 30) c1] a)
          c2 (ct/call! (mut graph) big16 s1 (ct/named! (mut graph) "c_take_big16")
                       [l (ct/by-value! (mut graph) second 32 16) k] a)
          s2 (ct/call! (mut graph) store c2 put [source (t/constant! (mut graph) 11 31) c2] a)
          c3 (ct/call! (mut graph) two s2 (ct/named! (mut graph) "c_take_two_big")
                       [k l k l k l k (ct/by-value! (mut graph) source 24 8) l
                        (ct/by-value! (mut graph) second 24 8)] a)
          s3 (ct/call! (mut graph) store c3 put [source (t/constant! (mut graph) 11 32) c3] a)
          c4 (ct/call! (mut graph) wide s3 (ct/named! (mut graph) "c_take_wide")
                       [(ct/by-value! (mut graph) source 200 8) k] a)
          ret (t/return! (mut graph) c4 11 c4)
          (mut loaded) (finish "memory to c" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [(ptr i64) i64 i64] i64) (ct/entry loaded))
          (mut cells) (primitive/zeroed (array i64 40))]
      (for s [(: -5 i64) 0 9 1000003]
        (for [i 0 25] (set! (mut cells) i (+ (* s 3) (cast i64 i))))
        ; cells 4 and 5 hold a long double (as its 80-bit pattern) and 6 an integer.
        (set! (mut cells) 4 (cast i64 0xA000000000000000))
        (set! (mut cells) 5 0x4001)
        (let [(mut expected) (+ s 1)
              v0 (* s 3)
              w0 (get cells 4)]
          (for [i 0 25] (set! expected (+ expected (* (get cells i) (+ (cast i64 i) 1)))))
          (let [last (call-ptr f (primitive/cast (ptr i64) (mut cells)) (+ s 1) (+ s 2))]
            (check! (mut tally) "memory wide" (= last expected))
            (check! (mut tally) "memory big"
                    (= (get cells 30)
                       (+ (+ s 1) (* 2 v0) (* 3 (+ v0 1)) (* 5 (+ v0 2)) (* 7 (+ s 2)))))
            ; The long double 5.0 and the integer after it.
            (check! (mut tally) "memory big16"
                    (= (get cells 31) (+ (+ s 2) 15 (* (+ v0 6) 5) (* 7 (+ s 1)))))
            (check! (mut tally) "memory two"
                    (= (get cells 32)
                       (+ (* 3 (+ s 1)) (* 3 (+ s 2)) (* 2 (+ s 1)) (* 3 (+ s 2))
                          v0 (* 2 (+ v0 1)) (* 3 (+ v0 2))
                          (* 5 w0) (* 7 (get cells 5)) (* 11 (+ v0 6))))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut big))
    (calls/release! (mut big16))
    (calls/release! (mut two))
    (calls/release! (mut wide))
    (calls/release! (mut store))
    (g/release! (mut graph))))

;;; A MEMORY parameter received from C: PARAM is the address of the caller's
;;; stack copy and takes no register, so `l` is still the second integer.
(defn memory-from-c! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 11 [(: 11 u8) 6 11] [] a)
        (mut fetch) (ct/prototype false 11 [(: 6 u8) 11] [] a)]
    (ct/memory! (mut own) 1 24 8)
    (ct/declare! (mut graph) own a)
    (let [k (t/param! (mut graph) start 11 0)
          v (t/param! (mut graph) start 6 1)
          l (t/param! (mut graph) start 11 2)
          get64 (ct/named! (mut graph) "c_load64")
          c1 (ct/call! (mut graph) fetch start get64 [v (t/constant! (mut graph) 11 0)] a)
          c2 (ct/call! (mut graph) fetch c1 get64 [v (t/constant! (mut graph) 11 1)] a)
          c3 (ct/call! (mut graph) fetch c2 get64 [v (t/constant! (mut graph) 11 2)] a)
          sum (t/binary! (mut graph) 26 11
                         (t/binary! (mut graph) 26 11 k (times! (mut graph) c1 2))
                         (t/binary! (mut graph) 26 11
                                    (times! (mut graph) c2 3)
                                    (t/binary! (mut graph) 26 11 (times! (mut graph) c3 5)
                                               (times! (mut graph) l 7))))
          ret (t/return! (mut graph) c3 11 sum)
          (mut loaded) (finish "memory from c" graph start [ret] a)]
      (for s [(: -5 i64) 0 9 1000003]
        (check! (mut tally) "memory from c"
                (= (c_drive_take_big (ct/entry loaded) s (+ s 1) (+ s 2) (+ s 3) (+ s 4))
                   (+ s (* 2 (+ s 1)) (* 3 (+ s 2)) (* 5 (+ s 3)) (* 7 (+ s 4))))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut fetch))
    (g/release! (mut graph))))

;;; Variadic calls: unnamed integers and doubles take registers like named
;;; ones and overflow to the stack per bank, al carries the vector register
;;; count, and an unnamed FLOAT is promoted to DOUBLE.
(defn variadic! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 12 [(: 11 u8) 12 13 6 6] [] a)
        (mut sum) (ct/prototype true 12 [(: 11 u8)] [] a)
        (mut print) (ct/prototype true 10 [(: 6 u8) 5 6] [] a)
        (mut store) (ct/prototype false 0 [(: 6 u8) 11 12] [] a)]
    (ct/declare! (mut graph) own a)
    (let [n (t/param! (mut graph) start 11 0)
          d (t/param! (mut graph) start 12 1)
          f (t/param! (mut graph) start 13 2)
          buffer (t/param! (mut graph) start 6 3)
          format (t/param! (mut graph) start 6 4)
          twenty (t/constant! (mut graph) 11 20)
          ; Ten integers (even positions) and ten floating values (odd
          ; positions, FLOAT and DOUBLE alternating): with the count that is
          ; eleven integers and ten vector values.
          c1 (ct/call! (mut graph) sum start (ct/named! (mut graph) "c_sum_va")
                       [twenty n d n f n d n f n d n f n d n f n d n f] a)
          c2 (ct/call! (mut graph) print c1 (ct/named! (mut graph) "snprintf")
                       [buffer (t/constant! (mut graph) 5 96) format n d f c1] a)
          ret (t/return! (mut graph) c2 12 c1)
          (mut loaded) (finish "variadic" graph start [ret] a)
          run (primitive/cast (fnptr (cc/C) [i64 f64 f32 (ptr u8) (ptr i8)] f64)
                              (ct/entry loaded))
          (mut actual) (primitive/zeroed (array u8 96))
          (mut expected) (primitive/zeroed (array u8 96))]
      (for s [(: -5 i64) 0 9 1000003]
        (let [d (+ (cast f64 s) 0.125)
              f (: 2.5 f32)
              (mut total) (: 0.0 f64)]
          (for [i 0 20]
            (set! total
                  (+ total
                     (* (cast f64 (+ i 1))
                        (cond (= (& i 1) 0) (cast f64 s)
                              (= (& i 3) 1) d
                              :else 2.5)))))
          (let [result (call-ptr run s d f (primitive/cast (ptr u8) (mut actual))
                                 c"%lld|%.3f|%.2f|%.1f")
                (mut same) true]
            (snprintf (primitive/cast (ptr u8) (mut expected)) 96 c"%lld|%.3f|%.2f|%.1f"
                      s d (: 2.5 f64) (load total))
            (for [i 0 96] (when (!= (get actual i) (get expected i)) (set! same false)))
            (check! (mut tally) "variadic sum" (= result total))
            (check! (mut tally) "variadic snprintf" same))))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut sum))
    (calls/release! (mut print))
    (calls/release! (mut store))
    (g/release! (mut graph))))

;;; al of a variadic call is exactly the number of vector registers used:
;;; none, three, and all eight when ten floating values are passed.
(defn vector-count! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (for floats [(: 0 i64) 3 10]
    (let [(mut graph) (g/create a)
          start (t/start! (mut graph))
          (mut own) (ct/prototype false 11 [(: 11 u8) 12] [] a)
          (mut variadic) (ct/prototype true 11 [(: 11 u8)] [] a)
          (mut passed) (ArrayList::new [i32] a)]
      (ct/declare! (mut graph) own a)
      (let [n (t/param! (mut graph) start 11 0)
            d (t/param! (mut graph) start 12 1)]
        (push! (mut passed) n)
        (for [i 0 floats] (push! (mut passed) d))
        (push! (mut passed) n)
        (let [call (ct/call! (mut graph) variadic start (ct/named! (mut graph) "c_capture")
                             (slice passed) a)
              ret (t/return! (mut graph) call 11 call)
              (mut loaded) (finish "vector count" graph start [ret] a)
              f (primitive/cast (fnptr (cc/C) [i64 f64] i64) (ct/entry loaded))]
          (check! (mut tally) "vector count call" (= (call-ptr f 7 1.5) 12345))
          (check! (mut tally) "vector count in al"
                  (= (& (c_captured_rax) 0xFF) (cast u64 (if (> floats 8) 8 floats))))
          (jit/release-image! (mut loaded))))
      (free! (mut passed))
      (calls/release! (mut own))
      (calls/release! (mut variadic))
      (g/release! (mut graph)))))

;;; Calls declared BUILTIN-MOVE and BUILTIN-COMPARE reach their runtime
;;; routines (no inline expansion is plugged in yet).
(defn builtins! [(tally (mut t/Tally)) (a (dyn Allocator))] (-> void)
  (let [(mut graph) (g/create a)
        start (t/start! (mut graph))
        (mut own) (ct/prototype false 10 [(: 6 u8) 6 6] [] a)
        (mut move) (match (calls/create-builtin-move 8 a)
                     (Ok [built] built)
                     (Err [message] (panic "{}" message)))
        (mut compare) (match (calls/create-builtin-compare 8 10 5 a)
                        (Ok [built] built)
                        (Err [message] (panic "{}" message)))]
    (ct/declare! (mut graph) own a)
    (let [destination (t/param! (mut graph) start 6 0)
          source (t/param! (mut graph) start 6 1)
          other (t/param! (mut graph) start 6 2)
          size (t/constant! (mut graph) 5 24)
          c1 (ct/call! (mut graph) move start (ct/named! (mut graph) "memmove")
                       [destination source size] a)
          c2 (ct/call! (mut graph) compare c1 (ct/named! (mut graph) "memcmp") [c1 other size] a)
          ret (t/return! (mut graph) c2 10 c2)
          (mut loaded) (finish "builtins" graph start [ret] a)
          f (primitive/cast (fnptr (cc/C) [(ptr u8) (ptr u8) (ptr u8)] i32) (ct/entry loaded))
          (mut from) (primitive/zeroed (array u8 24))
          (mut to) (primitive/zeroed (array u8 24))
          (mut same) (primitive/zeroed (array u8 24))
          (mut larger) (primitive/zeroed (array u8 24))]
      (for [i 0 24]
        (set! (mut from) i (cast u8 (+ 3 (* i 7))))
        (set! (mut same) i (cast u8 (+ 3 (* i 7))))
        (set! (mut larger) i (cast u8 (+ 3 (* i 7)))))
      (set! (mut larger) 20 255)
      (check! (mut tally) "builtin equal"
              (= (call-ptr f (primitive/cast (ptr u8) (mut to)) (primitive/cast (ptr u8) (mut from))
                           (primitive/cast (ptr u8) (mut same)))
                 0))
      (check! (mut tally) "builtin moved" (= (get to 23) (get from 23)))
      (check! (mut tally) "builtin less"
              (< (call-ptr f (primitive/cast (ptr u8) (mut to)) (primitive/cast (ptr u8) (mut from))
                           (primitive/cast (ptr u8) (mut larger)))
                 0))
      (jit/release-image! (mut loaded)))
    (calls/release! (mut own))
    (calls/release! (mut move))
    (calls/release! (mut compare))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (if (not (t/host?))
      (do (println "x64 call abi: skipped (not an x86-64 host)") 0)
      (let [a (malloc-allocator)
            (mut tally) (t/tally)]
        (ints! (mut tally) a)
        (doubles! (mut tally) a)
        (mixed! (mut tally) a)
        (narrow! (mut tally) a)
        (narrow-result! (mut tally) a)
        (pair-ii! (mut tally) a)
        (pair-id! (mut tally) a)
        (pair-classes! (mut tally) a)
        (group-stack! (mut tally) a)
        (group-banks! (mut tally) a)
        (results-from-c! (mut tally) a)
        (results-to-c! (mut tally) a)
        (indirect! (mut tally) a)
        (memory-to-c! (mut tally) a)
        (memory-from-c! (mut tally) a)
        (variadic! (mut tally) a)
        (vector-count! (mut tally) a)
        (builtins! (mut tally) a)
        (println "x64 call abi: {} checks, {} failures" (.checks tally) (.failures tally))
        (if (= (.failures tally) 0) 0 1))))
