(module stogir.tests.aot-sccp-rewrite-link)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)

(extern dynamic :as "sccp_rewrite_dynamic" :cc (cc/C) [i64 i64 i64] (-> i64))

(extern always-false :as "sccp_rewrite_false" :cc (cc/C) [i64 i64 i64] (-> i64))

(extern always-true :as "sccp_rewrite_true" :cc (cc/C) [i64 i64 i64] (-> i64))

(extern payload :as "sccp_copy_payload" :cc (cc/C) [(ptr u8)] (-> void))

(defn main [] (-> i64)
  (let [(mut failures) 0]
    (for condition [-9 0 1 17]
      (for left [-100 -1 0 42 100]
        (for right [-100 -1 0 42 100]
          (when (or (!= (dynamic condition left right)
                        (+ (if (!= condition 0) left right) 7))
                    (!= (always-false condition left right) (+ right 7))
                    (!= (always-true condition left right) (+ left 7)))
            (set! failures (+ failures 1))))))
    (let [(mut buffer)
            [(: 0xA5 u8)
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5
             0xA5]]
      (for [i 0 16] (set! (mut buffer) (+ i 8) (cast u8 (+ 3 (* i 17)))))
      (payload (p/index (p/cast (ptr u8) (mut buffer)) 8))
      (for [i 0 80]
        (let [expected
                (cond (and (>= i 8) (< i 24)) (cast u8 (+ 3 (* (- i 8) 17)))
                      (and (>= i 24) (< i 40)) (cast u8 (+ 3 (* (- i 24) 17)))
                      (and (>= i 40) (< i 56)) (cast u8 (+ 3 (* (- i 40) 17)))
                      (and (>= i 56) (< i 72)) (cast u8 (- 240 (* (- i 56) 15)))
                      :else (: 0xA5 u8))]
          (when (!= (get buffer i) expected) (set! failures (+ failures 1))))))
    (println "linked SCCP rewrite checks: {} failures" failures)
    (if (= failures 0) 0 1)))
