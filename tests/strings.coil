(module stogir.tests.strings)
(import "stogir.strings" :as strings)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.slice" :use [subslice])
(import "coil.result" :use [Some None])

(defn alias-growth [] (-> i64)
  (let [allocator (malloc-allocator)
        (mut pool) (strings/create allocator)
        (mut source) (ArrayList::new [u8] allocator)
        (mut failures) 0
        (mut i) 0]
    (while (< i 1024)
      (push! (mut source) (cast u8 i))
      (set! i (+ i 1)))
    (match (strings/intern! (mut pool) (slice source))
      (None [] (set! failures (+ failures 1)))
      (Some [id]
            (match (strings/lookup pool id)
              (None [] (set! failures (+ failures 1)))
              (Some [value]
                    (match (strings/intern! (mut pool) (subslice value 1 1024))
                      (None [] (set! failures (+ failures 1)))
                      (Some [substring]
                            (match (strings/lookup pool substring)
                              (None [] (set! failures (+ failures 1)))
                              (Some [copy]
                                    (when (!= (len copy) 1023)
                                      (set! failures (+ failures 1)))
                                    (set! i 0)
                                    (while (< i (len copy))
                                      (when (!= (get copy i) (cast u8 (+ i 1)))
                                        (set! failures (+ failures 1)))
                                      (set! i (+ i 1)))))))))))
    (free! (mut source))
    (strings/release! (mut pool))
    failures))

(defn main [] (-> i64)
  (let [(mut pool) (strings/create (malloc-allocator))
        (mut failures) (alias-growth)]
    (match (strings/intern! (mut pool) [(: 0 u8) 11 2 11 6])
      (None [] (set! failures (+ failures 1)))
      (Some [id]
            (match (strings/intern! (mut pool) [(: 0 u8) 11 2 11 6])
              (Some [other] (when (!= id other) (set! failures (+ failures 1))))
              (None [] (set! failures (+ failures 1))))
            (match (strings/intern! (mut pool) [(: 0 u8) 11 2 11 5])
              (Some [other] (when (= id other) (set! failures (+ failures 1))))
              (None [] (set! failures (+ failures 1))))
            (match (strings/lookup pool id)
              (None [] (set! failures (+ failures 1)))
              (Some [bytes]
                    ; Append a non-interned substring of the arena itself.
                    (match (strings/intern! (mut pool) (subslice bytes 1 5))
                      (None [] (set! failures (+ failures 1)))
                      (Some [substring]
                            (match (strings/lookup pool substring)
                              (None [] (set! failures (+ failures 1)))
                              (Some [value]
                                    (when (or (!= (len value) 4)
                                              (!= (get value 0) 11)
                                              (!= (get value 3) 6))
                                      (set! failures (+ failures 1)))))))))
            (let [(mut i) (: 0 u32)]
              (while (< i 1000)
                (strings/intern! (mut pool)
                                 [(: 200 u8) (cast u8 i) (cast u8 (>> i 8))])
                (set! i (+ i 1))))
            (match (strings/lookup pool id)
              (None [] (set! failures (+ failures 1)))
              (Some [bytes]
                    (when (or (!= (len bytes) 5)
                              (!= (get bytes 0) 0)
                              (!= (get bytes 4) 6))
                      (set! failures (+ failures 1)))))))
    (match (strings/intern! (mut pool) [])
      (None [] (set! failures (+ failures 1)))
      (Some [id]
            (match (strings/lookup pool id)
              (Some [bytes]
                    (when (!= (len bytes) 0) (set! failures (+ failures 1))))
              (None [] (set! failures (+ failures 1))))))
    (match (strings/lookup pool 0)
      (None [] 0)
      (Some [_] (set! failures (+ failures 1))))
    (match (strings/lookup pool 99999)
      (None [] 0)
      (Some [_] (set! failures (+ failures 1))))
    (strings/release! (mut pool))
    (println "binary string pool checks: {} failures" failures)
    (if (= failures 0) 0 1)))
