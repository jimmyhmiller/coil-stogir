(module stogir.tests.integer-type-promotion)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.node" :as n)
(import "stogir.iter-fold" :as iter)
(import "stogir.uses" :as uses)
(import "stogir.bitqueue" :as q)
(import "stogir.bitset" :as bits)
(import "stogir.verify" :as verify)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Result Ok Err])
(defn require [(value (Result i32 (slice u8)))] (-> i32)
  (match value (Ok [r] r) (Err [message] (panic "{}" message))))
;;; Rebuilt exact-position edge multisets must match the maintained lists.
(defn check-uses [(graph g/Graph) (actual uses/Uses)] (-> i64)
  (let [(mut expected) (uses/build graph (malloc-allocator))
        (mut failures) 0]
    (for [r 1 (len (.instructions graph))]
      (let [want (get (.ranges expected) r)
            got (get (.ranges actual) r)]
        (when (!= (.count want) (.count got)) (set! failures (+ failures 1)))
        (for [i (.offset want) (+ (.offset want) (.count want))]
          (let [edge (get (.edges expected) i)
                (mut count) 0]
            (for [j (.offset got) (+ (.offset got) (.count got))]
              (let [other (get (.edges actual) j)]
                (when (and (= (.user edge) (.user other))
                           (= (.operand edge) (.operand other)))
                  (set! count (+ count 1)))))
            (when (!= count 1) (set! failures (+ failures 1)))))))
    (uses/release! (mut expected))
    failures))


;;; Modes: normal, shared wide result, protected wide result, protected truncation.
(defn exercise [(target i32) (opcode i32) (mode i32)] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 target [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 target [start (: 0 i32) 1]))
        left (require (b/emit! (mut graph) 33 11 [x]))
        right (require (b/emit! (mut graph) 33 11 [y]))
        wide (if (or (= opcode 31) (= opcode 32) (= opcode 45))
                 (require (b/emit! (mut graph) opcode 11 [left]))
                 (require (b/emit! (mut graph) opcode 11 [left right])))
        trunc (require (b/emit! (mut graph) 35 target [wide]))
        extra (if (= mode 1) (require (b/emit! (mut graph) 31 11 [wide])) 0)
        (mut lists) (uses/build graph a)
        (mut queue) (q/create (len (.instructions graph)) a)
        (mut protected) (bits/create (len (.instructions graph)) a)
        (mut context) (iter/promotion-context a)
        accepted (and (not (or (= opcode 32) (= opcode 58) (= opcode 59)))
                      (or (= mode 0) (= mode 3)))]
    (when (= mode 2) (bits/add! (mut protected) (cast i64 wide)))
    (when (= mode 3) (bits/add! (mut protected) (cast i64 trunc)))
    (assert (= (iter/narrow-arithmetic! (mut graph) (mut lists) (mut queue)
                       protected (mut context) trunc 8) accepted))
    (assert (= (n/type-id (get (.instructions graph) (cast i64 wide)))
               (cast u8 (if accepted target 11))))
    (assert (= (n/opcode (get (.instructions graph) (cast i64 trunc)))
               (cast u8 (if accepted (if (= mode 3) 68 0) 35))))
    (assert (= (check-uses graph lists) 0))
    (require (verify/operations-constants-and-phis-target graph 8))
    (iter/release-promotion! (mut context))
    (bits/release! (mut protected)) (q/release! (mut queue))
    (uses/release! (mut lists)) (g/release! (mut graph))))

;;; Deep arithmetic with constants exercises iterative traversal and literal retyping.
(defn chain [(depth i64) (opcode i32) (amount u64) (accepted bool)] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 2 [start (: 0 i32) 0]))
        extended (require (b/emit! (mut graph) 34 5 [x]))
        literal (require (b/scalar-constant! (mut graph) 5 amount 8))
        (mut value) extended]
    (for [i 0 depth]
      (set! value (require (b/emit! (mut graph) opcode 5 [value literal]))))
    (let [outer (require (b/emit! (mut graph) 35 2 [value]))
          (mut lists) (uses/build graph a)
          (mut queue) (q/create (len (.instructions graph)) a)
          (mut protected) (bits/create (len (.instructions graph)) a)
          (mut context) (iter/promotion-context a)]
      (bits/add! (mut protected) (cast i64 outer))
      (assert (= (iter/narrow-arithmetic! (mut graph) (mut lists) (mut queue)
                         protected (mut context) outer 8) accepted))
      (assert (= (n/type-id (get (.instructions graph) (cast i64 value)))
                 (if accepted 2 5)))
      (assert (= (check-uses graph lists) 0))
      (require (verify/operations-constants-and-phis-target graph 8))
      (iter/release-promotion! (mut context))
      (bits/release! (mut protected)) (q/release! (mut queue))
      (uses/release! (mut lists)))
    (g/release! (mut graph))))

;;; Conditions/regions retain their original types; direct self-Phi edges narrow.
(defn selection [(mode i32)] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 10 [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 10 [start (: 0 i32) 1]))
        condition (require (b/emit! (mut graph) 16 1 [x y]))
        left (require (b/emit! (mut graph) 33 11 [x]))
        right (require (b/emit! (mut graph) 33 11 [y]))
        split (require (b/emit! (mut graph) 116 0 [start condition]))
        yes (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
        no (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
        yes-end (require (b/emit! (mut graph) 114 0 [yes]))
        no-end (require (b/emit! (mut graph) 114 0 [no]))
        merge (require (b/emit! (mut graph) 112 0 [yes-end no-end]))
        value (if (= mode 0)
                  (require (b/emit! (mut graph) 60 11 [condition left right]))
                  (require (b/emit! (mut graph) 67 11 [merge left right])))
        outer (require (b/emit! (mut graph) 35 10 [value]))]
    (when (= mode 2) (assert (g/set-operand! (mut graph) value 3 value)))
    (let [(mut lists) (uses/build graph a)
          (mut queue) (q/create (len (.instructions graph)) a)
          (mut protected) (bits/create (len (.instructions graph)) a)
          (mut context) (iter/promotion-context a)]
      (assert (iter/narrow-arithmetic! (mut graph) (mut lists) (mut queue)
                         protected (mut context) outer 8))
      (assert (= (n/type-id (get (.instructions graph) (cast i64 value))) 10))
      (assert (= (n/type-id (get (.instructions graph) (cast i64 condition))) 1))
      (assert (= (n/type-id (get (.instructions graph) (cast i64 merge))) 0))
      (assert (= (check-uses graph lists) 0))
      (require (verify/operations-constants-and-phis-target graph 8))
      (iter/release-promotion! (mut context))
      (bits/release! (mut protected)) (q/release! (mut queue))
      (uses/release! (mut lists)))
    (g/release! (mut graph))))

(defn main [] (-> i64)
  (for target [(: 2 i32) 3 4 7 8 9 10]
    (for opcode [(: 26 i32) 27 28 31 45 46 47 48 32 58 59]
      (for [mode 0 4] (exercise target opcode (cast i32 mode)))))
  (for [mode 0 3] (selection (cast i32 mode)))
  (chain 4096 26 0xFFFFFFFFFFFFFFFF true)
  (chain 1 49 7 true)
  (chain 1 49 8 false)
  (chain 1 49 63 false)
  (chain 1 50 1 false)
  (chain 1 51 1 false)
  (println "integer type promotion: 308 acceptance/shared/protected/unsafe-range cases; exact-use and semantic validation passed")
  0)
