;;; Diagnostic-only module copied by prepare.py into a separate source tree.
(module stogir.a64.block-count)
(import "coil.var" :use [var-static])
(import "coil.primitive" :as p)
(import "coil.arraylist" :use [ArrayList])
(import "stogir.bytes" :as bytes)

(def enabled (var-static bool false))
(def next-index (var-static i64 0))
(def name-address (var-static i64 0))
(def name-length (var-static i64 0))

(defn enable! [] (-> void) (set enabled true))
(defn set-function! [(name (slice u8))] (-> void)
  (set name-address (p/cast i64 (data name)))
  (set name-length (cast i64 (len name))))

(defn emit! [(text (mut (ArrayList u8))) (reference i32)] (-> void)
  (when (get enabled)
    (let [index (get next-index)
          offset (* index 8)
          lo (cast u32 (& offset 0xFFFF))
          mid (cast u32 (& (>> offset 16) 0xFFFF))
          name (slice::new [u8] (p/cast (ptr u8) (get name-address)) (get name-length))]
      (assert (< index 8388608))
      (set next-index (+ index 1))
      (println "bbmap {} {} {}" name reference index)
      (bytes/append32! (mut text) (| (: 0xD2800010 u32) (<< lo 5)))
      (bytes/append32! (mut text) (| (: 0xF2A00010 u32) (<< mid 5)))
      (bytes/append32! (mut text) 0xF2CA0010)
      (bytes/append32! (mut text) 0xF9400211)
      (bytes/append32! (mut text) 0x91000631)
      (bytes/append32! (mut text) 0xF9000211))))
