(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
  (let [a (malloc-allocator) (mut edges) (uses/build graph a) (mut ref) (: 1 i64)]
    (while (< ref (len (.instructions graph)))
      (let [node (get (.instructions graph) ref) arity (get (.arities graph) ref)
            (mut root?) false]
        (for root roots (when (= root (cast i32 ref)) (set! root? true)))
        (println "audit-node {} {} {} {} {} {} {} {} {} {}" ref arity
                 (n/opcode node) (n/type-id node) (n/auxiliary node)
                 (.op1 node) (.op2 node) (.op3 node) (.count (get (.ranges edges) ref)) root?)
        (set! ref (+ ref (/ (+ (cast i64 arity) 4) 4)))))
    (let [(mut working) (g/duplicate graph a)
          (mut queue) (q/create (len (.instructions graph)) a)
          (mut protected) (bits/create (len (.instructions graph)) a)]
      (for root roots (bits/add! (mut protected) (cast i64 root)))
      (println "direct-existing-split {}" (control/split-if! (mut working) (mut edges)
                                            (mut queue) protected 15 8))
      (q/release! (mut queue)) (bits/release! (mut protected)) (g/release! (mut working)))
    (uses/release! (mut edges))))
