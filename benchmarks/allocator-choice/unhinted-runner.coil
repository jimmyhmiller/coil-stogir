(module gaps.allocator-choice-runner)
(extern gap_create [] (-> (ptr u8)))
(extern gap_release [(ptr u8)] (-> void))
(extern gap_choice [(ptr u8) i64 u64 i32] (-> i64))
(defn main [] (-> i64)
 (let [state (gap_create) (mut sum) (: 0 i64)]
  (for [iteration 0 300000]
   (set! sum (+ sum (gap_choice state (% iteration 101)
      (if (= (% iteration 2) 0) 0x7FFFFFFF 0xFFFFFF0000000000)
      -1))))
  (println "{}" sum) (gap_release state))
 0)
