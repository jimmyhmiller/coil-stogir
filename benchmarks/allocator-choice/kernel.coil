(module gaps.allocator-choice)
(import "stogir.allocation" :as a)
(import "stogir.interval" :as r)
(import "stogir.constraints" :as c)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :as alloc :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(defstruct State [(part a/Part) (availability (ArrayList i64)) (limits (ArrayList i64))])
(defn create :cc (cc/C) [] (-> (ptr u8))
 (let [alc (malloc-allocator)
       state (alloc/box! alc State (State :part (a/create 1 alc)
          :availability (ArrayList::new [i64] alc) :limits (ArrayList::new [i64] alc)))]
  (r/add! (mut (.ranges (.part state))) 0 100)
  (c/add! (mut (.uses (.part state))) 12 2 2)
  (c/add! (mut (.uses (.part state))) 52 2 5)
  (for [i 0 64] (push! (mut (.availability state)) (+ 3 (* i 7))))
  (p/cast (ptr u8) state)))
(defn release :cc (cc/C) [(opaque (ptr u8))] (-> void)
 (let [state (p/cast (ptr State) opaque)]
  (a/release! (mut (.part state)))
  (free! (mut (.availability state))) (free! (mut (.limits state)))
  (alloc/destroy (malloc-allocator) state)))
(defn kernel :cc (cc/C) :inline (Never)
 [(opaque (ptr u8)) (position i64) (allowed u64) (source i32)] (-> i64)
 (let [state (p/cast (ptr State) opaque)
       choice (a/free-decision-with-limits! (.part state) (.availability state)
                   position allowed source 2 [(: 3 i64) 12 51] (mut (.limits state)))]
  (+ (.until choice) (cast i64 (.register choice)))))
(export-c [create :as "gap_create"] [release :as "gap_release"] [kernel :as "gap_choice"])
