(module stogir.benchmarks.opcode-arities)
(import "stogir.opcode" :as op)

;;; Feed queried facts back into the next index to prevent loop-invariant
;;; hoisting or replacing repeated metadata queries with a constant total.
(defn kernel :inline (Never) [(rounds i64)] (-> u64)
  (let [(mut state) (: 81985529216486895 u64)]
    (for [i 0 rounds]
      (set! state (+ (* state 6364136223846793005) 1442695040888963407))
      (let [opcode (cast i32 (& (>> state 32) 127))
            inputs (op/input-count opcode)
            slots (op/operand-slots opcode)]
        (set! state (^ state (cast u64 (+ (cast i64 inputs) (cast i64 slots)))))))
    state))

(defn main [] (-> i64)
  (println "{}" (kernel 10000000))
  0)
