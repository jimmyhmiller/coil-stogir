(module stogir.benchmarks.compiler-gaps.template-dag)

; Caller-first shared direct-call DAG; measures bounded template finalization.
; All work remains in the ordinary module preparation/expansion/codegen path.

(defn layer-0-0 [(value u64)] (-> u64)
  (+ (layer-1-0 value)
     (layer-1-1 (^ value 17))))

(defn layer-0-1 [(value u64)] (-> u64)
  (+ (layer-1-1 value)
     (layer-1-2 (^ value 18))))

(defn layer-0-2 [(value u64)] (-> u64)
  (+ (layer-1-2 value)
     (layer-1-3 (^ value 19))))

(defn layer-0-3 [(value u64)] (-> u64)
  (+ (layer-1-3 value)
     (layer-1-0 (^ value 20))))

(defn layer-1-0 [(value u64)] (-> u64)
  (+ (layer-2-0 value)
     (layer-2-1 (^ value 21))))

(defn layer-1-1 [(value u64)] (-> u64)
  (+ (layer-2-1 value)
     (layer-2-2 (^ value 22))))

(defn layer-1-2 [(value u64)] (-> u64)
  (+ (layer-2-2 value)
     (layer-2-3 (^ value 23))))

(defn layer-1-3 [(value u64)] (-> u64)
  (+ (layer-2-3 value)
     (layer-2-0 (^ value 24))))

(defn layer-2-0 [(value u64)] (-> u64)
  (+ (layer-3-0 value)
     (layer-3-1 (^ value 25))))

(defn layer-2-1 [(value u64)] (-> u64)
  (+ (layer-3-1 value)
     (layer-3-2 (^ value 26))))

(defn layer-2-2 [(value u64)] (-> u64)
  (+ (layer-3-2 value)
     (layer-3-3 (^ value 27))))

(defn layer-2-3 [(value u64)] (-> u64)
  (+ (layer-3-3 value)
     (layer-3-0 (^ value 28))))

(defn layer-3-0 [(value u64)] (-> u64)
  (+ (layer-4-0 value)
     (layer-4-1 (^ value 29))))

(defn layer-3-1 [(value u64)] (-> u64)
  (+ (layer-4-1 value)
     (layer-4-2 (^ value 30))))

(defn layer-3-2 [(value u64)] (-> u64)
  (+ (layer-4-2 value)
     (layer-4-3 (^ value 31))))

(defn layer-3-3 [(value u64)] (-> u64)
  (+ (layer-4-3 value)
     (layer-4-0 (^ value 32))))

(defn layer-4-0 [(value u64)] (-> u64)
  (+ (layer-5-0 value)
     (layer-5-1 (^ value 33))))

(defn layer-4-1 [(value u64)] (-> u64)
  (+ (layer-5-1 value)
     (layer-5-2 (^ value 34))))

(defn layer-4-2 [(value u64)] (-> u64)
  (+ (layer-5-2 value)
     (layer-5-3 (^ value 35))))

(defn layer-4-3 [(value u64)] (-> u64)
  (+ (layer-5-3 value)
     (layer-5-0 (^ value 36))))

(defn layer-5-0 [(value u64)] (-> u64)
  (+ (layer-6-0 value)
     (layer-6-1 (^ value 37))))

(defn layer-5-1 [(value u64)] (-> u64)
  (+ (layer-6-1 value)
     (layer-6-2 (^ value 38))))

(defn layer-5-2 [(value u64)] (-> u64)
  (+ (layer-6-2 value)
     (layer-6-3 (^ value 39))))

(defn layer-5-3 [(value u64)] (-> u64)
  (+ (layer-6-3 value)
     (layer-6-0 (^ value 40))))

(defn layer-6-0 [(value u64)] (-> u64)
  (+ (layer-7-0 value)
     (layer-7-1 (^ value 41))))

(defn layer-6-1 [(value u64)] (-> u64)
  (+ (layer-7-1 value)
     (layer-7-2 (^ value 42))))

(defn layer-6-2 [(value u64)] (-> u64)
  (+ (layer-7-2 value)
     (layer-7-3 (^ value 43))))

(defn layer-6-3 [(value u64)] (-> u64)
