     (layer-7-0 (^ value 44))))

(defn layer-7-0 [(value u64)] (-> u64)
  (^ (* value 6364136223846793005) 1442695040888963407))

(defn layer-7-1 [(value u64)] (-> u64)
  (^ (* value 6364136223846793003) 1442695040888963409))

(defn layer-7-2 [(value u64)] (-> u64)
  (^ (* value 6364136223846793001) 1442695040888963411))

(defn layer-7-3 [(value u64)] (-> u64)
  (^ (* value 6364136223846792999) 1442695040888963413))

(defn kernel :inline (Never) [(seed u64)] (-> u64)
  (let [(mut value) seed]
    (for [i 0 10000]
      (set! value (layer-0-0 value)))
    value))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (println "{}" (kernel (cast u64 argc)))
  0)
