(module gaps.bulk-stream-llvm)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(defstruct Payload [(bytes (array u8 416))])
(defn kernel :cc (cc/C) :inline (Never)
  [(destination (ptr Payload)) (source (ptr Payload)) (count u64)] (-> void)
  (p/store! destination (p/load source)))
(export-c [kernel :as "bulk_stream_kernel"])
