(module gaps.template-control-roots)
(import "coil.compiler.driver" :as driver)
(import "coil.cc" :as cc)
(import "coil.alloc" :use [Allocator])
(import "coil.str" :use [StrBuf])

; Emit-only reduction: retain the wrapper without invoking a C build.
(defstruct Inputs [(allocator (dyn Allocator)) (buffer StrBuf)])
(defn trigger :cc (cc/C) [(inputs (ptr Inputs))
                         (manifest (ptr driver/Manifest))] (-> i64)
  (driver/m-cc-sources (.allocator inputs) (mut (.buffer inputs)) manifest))
(export-c [trigger :as "gap_template_control_roots"])
