(module gaps.verify-transaction)
(import "stogir.graph" :as g)
(import "stogir.verify" :as verify)
(import "coil.cc" :as cc)
(import "coil.result" :use [Ok Err])

; Both modes run every structural, operation and Phi check. The transaction
; shares the structural scan only within this one immutable invocation.
(defn kernel :cc (cc/C) :inline (Never) [(graph (ptr g/Graph)) (legacy bool)]
  (-> i64)
  (match (if legacy
             (match (verify/integer-operations-target (load graph) 8)
               (Err [message] (Err [i32 (slice u8)] message))
               (Ok [_] (verify/phis (load graph))))
             (verify/operations-and-phis-target (load graph) 8))
    (Err [_] -1)
    (Ok [_] (len (.instructions (load graph))))))

(export-c [kernel :as "gap_verify_graph"])
