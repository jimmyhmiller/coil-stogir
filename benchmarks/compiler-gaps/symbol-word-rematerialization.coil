(module gaps.symbol-word-rematerialization)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.symbols" :as symbols)
(import "stogir.pipeline" :as pipeline)
(import "stogir.a64.match" :as matching)
(import "stogir.matched-uses" :as machine)
(import "stogir.a64.compile" :as compile)
(import "stogir.image" :as image)
(import "stogir.options" :as options)
(import "stogir.aot.macho" :as macho)
(import "coil.fs" :as fs)
(import "stogir.jit.darwin" :as jit)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.cc" :as cc)
(import "coil.result" :use [Result Ok Err])

(defn require [(result (Result i32 (slice u8)))] (-> i32)
  (match result (Ok [r] r) (Err [message] (panic "{}" message))))

(defn main [] (-> i64)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        limit (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 0]))
        selector (require (b/emit! (mut graph) 71 5 [start (: 0 i32) 1]))
        output (require (b/emit! (mut graph) 71 6 [start (: 0 i32) 2]))
        entry (require (b/emit! (mut graph) 114 0 [start]))
        loop (require (b/loop-begin! (mut graph) entry))
        zero (require (b/scalar-constant! (mut graph) 5 0 8))
        one (require (b/scalar-constant! (mut graph) 5 1 8))
        index (require (b/loop-phi! (mut graph) loop zero))
        condition (require (b/emit! (mut graph) 20 1 [index limit]))
        branch (require (b/emit! (mut graph) 116 0 [loop condition]))
        body (require (b/emit! (mut graph) 107 0 [branch (: 0 i32)]))
        exit (require (b/emit! (mut graph) 108 0 [branch (: 0 i32)]))
        (mut control) body (mut casts) (ArrayList::new [i32] a)
        (mut blocks) (ArrayList::new [i32] a)]
    (for [choice 0 16]
      (let [literal (require (symbols/string! (mut graph) [(cast u8 (+ 65 choice)) (: 0 u8)]))
            casted (require (b/conversion! (mut graph) 36 5 8 literal))
            offset (require (b/scalar-constant! (mut graph) 5 (cast u64 choice) 8))
            selected (require (b/integer-binary! (mut graph) 26 5 8 selector offset))
            equal (require (b/emit! (mut graph) 14 1 [index selected]))
            split (require (b/emit! (mut graph) 116 0 [control equal]))
            hit (require (b/emit! (mut graph) 107 0 [split (: 0 i32)]))
            miss (require (b/emit! (mut graph) 108 0 [split (: 0 i32)]))
            stored (require (b/emit! (mut graph) 93 0 [hit output casted]))
            yes (require (b/emit! (mut graph) 114 0 [stored]))
            no (require (b/emit! (mut graph) 114 0 [miss]))]
        (push! (mut casts) casted)
        (push! (mut blocks) hit)
        (set! control (require (b/emit! (mut graph) 112 0 [yes no])))))
    (let [next (require (b/integer-binary! (mut graph) 26 5 8 index one))
          back (require (b/emit! (mut graph) 115 0 [control]))
          ret (require (b/emit! (mut graph) 120 5 [exit index (: 0 i32)]))]
      (require (b/patch! (mut graph) loop 2 back))
      (require (b/patch! (mut graph) index 3 next))
      ; Inspect actual persistent matching metadata, not only final assembly.
      (match (pipeline/prepare-native graph start [ret] a)
        (Err [message] (panic "{}" message))
        (Ok [prepared]
          (let [(mut prepared) prepared]
            (match (matching/build graph (.schedule prepared) [ret] true a)
              (Err [message] (panic "{}" message))
              (Ok [matched]
                (let [(mut matched) matched (mut allocated) 0 (mut rematerialized) 0]
                  (for reference casts
                    (when (get (.definitions (.operands matched)) (cast i64 reference))
                      (set! allocated (+ allocated 1)))
                    (when (machine/rematerialized? (.operands matched) reference)
                      (set! rematerialized (+ rematerialized 1))))
                  (println "symbol-word matching: {} views,{} virtual definitions,{} rematerialized"
                           (len casts) allocated rematerialized)
                  (matching/release! (mut matched)))))
            (pipeline/release! (mut prepared)))))
      (match (compile/image-with-options graph start [ret] "_symbol_words" (options/Options :level 3) a)
        (Err [message] (panic "{}" message))
        (Ok [compiled]
          (let [(mut compiled) compiled]
            (match (jit/map-image compiled a)
              (Err [message] (panic "{}" message))
              (Ok [loaded]
                (let [(mut loaded) loaded
                      f (p/cast (fnptr (cc/C) [u64 u64 (ptr u64)] u64) (.base (.memory loaded)))]
                  (for count [(: 0 u64) 1 2 15 16 17 32]
                    (for selected [(: 0 u64) 1 3 15 31 1000 0xFFFFFFFFFFFFFFFF]
                      (let [(mut out) [(: 0x1122334455667788 u64) 0x8877665544332211]
                            (mut expected) (: 0 i64)]
                        (for [i 0 (cast i64 count)]
                          (for [j 0 16]
                            (when (= (cast u64 i) (+ selected (cast u64 j))) (set! expected (+ 65 j)))))
                        (assert (= (f count selected (if (= count 0) (p/cast (ptr u64) 0) (p/cast (ptr u64) (mut out)))) count))
                        (assert (= (get out 1) 0x8877665544332211))
                        (if (= expected 0) (assert (= (get out 0) 0x1122334455667788))
                            (assert (= (p/load (p/cast (ptr u8) (get out 0))) (cast u8 expected)))))))
                  (assert (jit/release-image! (mut loaded))))))
            (match (macho/image-object compiled a)
              (Err [message] (panic "{}" message))
              (Ok [bytes]
                (let [(mut bytes) bytes]
                  (match (fs/write-file a "/tmp/coil-stogir-symbol-words.o" (slice bytes))
                    (Err [_] (panic "write failed")) (Ok [_] 0))
                  (free! (mut bytes)))))
            (println "symbol-word native text: {} bytes" (len (.text compiled)))
            (image/release! (mut compiled))))))
    (free! (mut casts)) (free! (mut blocks)) (g/release! (mut graph))
    (println "symbol-word JIT:49 checked inputs,including wrap,canaries and zero-trip null output; passed")
    0))
