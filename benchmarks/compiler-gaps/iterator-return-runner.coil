(module gaps.iterator-return-runner)
(import "coil.primitive" :as p)
(import "coil.args" :as args)

(extern kernel :as "gap_iterator_return" [(ptr u8) i64 bool] (-> u64))

; One opaque LLVM caller for every kernel. Check empty, prefix and full inputs
; against independent indexed host iteration before timing many full walks.
(defn reference [(data (ptr u8)) (length i64)] (-> u64)
  (let [(mut hash) (: 0x9E3779B97F4A7C15 u64)]
    (for [i 0 length]
      (set! hash
            (^ (| (<< hash 5) (>> hash 59))
               (cast u64 (load (p/index data i))))))
    hash))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [text "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ!?"
        never (args/has? "--never")
        count (len text)
        expected (reference (data text) count)
        (mut sum) (: 0 u64)]
    (for [i 0 (+ count 1)]
      (when (!= (kernel (data text) i never) (reference (data text) i))
        (panic "iterator mismatch at length {}" i)))
    (for [i 0 312500]
      (set! sum (+ sum (kernel (data text) count never))))
    (if (= sum (* expected 312500)) 0 1)))
