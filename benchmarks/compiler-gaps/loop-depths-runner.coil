(module gaps.loop-depths-runner)
(import "coil.args" :as args)
(extern create-scenario :as "gap_loop_depth_create" [i64 i64] (-> (ptr u8)))
(extern release-scenario :as "gap_loop_depth_release" [(ptr u8)] (-> void))
(extern kernel :as "gap_loop_depth" [(ptr u8) bool] (-> i64))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [scenario (create-scenario 64 16)
        legacy (args/has? "--legacy")
        expected (: 124 i64)
        (mut sum) (: 0 i64)]
    (assert (= (kernel scenario false) expected))
    (assert (= (kernel scenario true) expected))
    (for [i 0 1024] (set! sum (+ sum (kernel scenario legacy))))
    (assert (= sum (* expected 1024)))
    (release-scenario scenario)
    0))
