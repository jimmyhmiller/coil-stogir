(module gaps.tag-extract)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)

; Same expression as stogir.node.type-id, repeated over compact headers.
(defn kernel :cc (cc/C) :inline (Never) [(headers (ptr u32)) (count i64)] (-> u64)
  (let [(mut sum) (: 0 u64)]
    (for [i 0 count]
      (let [tag (cast u8 (& (>> (load (p/index headers i)) 8) 255))]
        (set! sum (+ sum (cast u64 tag)))))
    sum))

(export-c [kernel :as "gap_tag_extract"])
