(module gaps.tag-extract-runner)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])

(extern kernel :as "gap_tag_extract" [(ptr u32) i64] (-> u64))

; One opaque LLVM caller for every backend. Header fields exercise every tag
; byte with independently varying bits above and below it. Division/remainder
; form the reference instead of reproducing the shifted-mask expression.
(defn main [] (-> i64)
  (let [(mut headers) (ArrayList::new [u32] (malloc-allocator))
        (mut expected) (: 0 u64)
        (mut checksum) (: 0 u64)]
    (for [i 0 256]
      (let [word (cast u32 (+ (* i 16777472) (^ i 165)))]
        (push! (mut headers) word)
        (assert (= (kernel (.data headers) 0) 0))
        (set! expected (+ expected (% (/ (cast u64 word) 256) 256)))
        (assert (= (kernel (.data headers) (len headers)) expected))))
    (for [i 0 250000]
      (set! checksum (+ checksum (kernel (.data headers) (len headers)))))
    (free! (mut headers))
    (if (= checksum (* expected 250000)) 0 1)))
