(module gaps.register-result-view)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.arraylist" :use [ArrayList])
(import "coil.slice")

(defstruct Node [(header u32) (op1 i32) (op2 i32) (op3 i32)])

; Observe both words of the default-policy slice result: its data for the
; compact node load and its length for the explicit checked lookup.
(defn kernel :cc (cc/C) :inline (Never) [(rows (ptr (ArrayList Node)))
                                         (index i64)] (-> i64)
  (let [view (.slice (p/load rows))]
    (if (and (>= index 0) (< index (len view)))
        (let [node (get view index)]
          (+ (cast i64 (.op1 node))
             (cast i64 (.op2 node))
             (cast i64 (.op3 node))))
        -1)))

(export-c [kernel :as "gap_aggregate_get"])
