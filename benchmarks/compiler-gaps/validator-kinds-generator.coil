;;; Regenerate src/stogir/validation-kind.coil KINDS from canonical family predicates.
(module gaps.validator-kinds-generator)
(import "stogir.opcode" :as op)
(import "stogir.integer-binary" :as binary)
(import "stogir.integer-unary" :as unary)
(import "stogir.vector-lanes" :as lanes)
(import "stogir.checked" :as checked)
(import "stogir.atomic" :as atomic)
(import "stogir.terminal" :as terminal)
(import "stogir.switch" :as switch)
(import "stogir.stack" :as stack)
(import "stogir.locals" :as locals)
(import "stogir.conversion" :as conversion)
(import "stogir.floating" :as floating)

(defn main [] (-> i64)
  (for [opcode 0 (cast i64 (op/count))]
    (println "{}"
             (+ (if (binary/operation? (cast i32 opcode)) 1 0)
                (if (unary/operation? (cast i32 opcode)) 2 0)
                (if (lanes/operation? (cast i32 opcode)) 4 0)
                (if (checked/operation? (cast i32 opcode)) 8 0)
                (if (atomic/operation? (cast i32 opcode)) 16 0)
                (if (terminal/operation? (cast i32 opcode)) 32 0)
                (if (switch/operation? (cast i32 opcode)) 64 0)
                (if (stack/operation? (cast i32 opcode)) 128 0)
                (if (locals/operation? (cast i32 opcode)) 256 0)
                (if (conversion/operation? (cast i32 opcode)) 512 0)
                (if (floating/operation? (cast i32 opcode)) 1024 0))))
  0)
