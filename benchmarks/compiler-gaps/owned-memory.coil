(module gaps.owned-memory)
(import "stogir.graph" :as g)
(import "stogir.builder" :as b)
(import "stogir.sccp" :as sccp)
(import "stogir.sccp-rewrite" :as rewrite)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.time" :use [monotonic-now])
(import "coil.result" :use [Result Ok Err])

(defn require [(r (Result i32 (slice u8)))] (-> i32)
  (match r (Ok [x] x) (Err [e] (panic "{}" e))))
(defn ticks [] (-> i64)
  (match (monotonic-now)
    (Ok [t] (+ (* (.sec t) 1000000000) (.nsec t)))
    (Err [_] (panic "clock failed"))))

(defn exercise [(count i64)] (-> void)
  (let [a (malloc-allocator) (mut graph) (g/create a)
        start (require (b/emit! (mut graph) 104 0 [(: 0 i32)]))
        x (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 0]))
        y (require (b/emit! (mut graph) 71 11 [start (: 0 i32) 1]))
        size (require (b/scalar-constant! (mut graph) 5 8 8))
        slot (require (b/stack-allocate! (mut graph) start size 8))
        stored (require (b/emit! (mut graph) 93 0 [slot slot x]))
        loaded (require (b/emit! (mut graph) 91 11 [stored slot]))
        (mut value) loaded]
    (for [i 0 count]
      (set! value (require (b/emit! (mut graph) (if (= (% i 2) 0) 26 48) 11 [value y]))))
    (let [ret (require (b/emit! (mut graph) 120 11 [loaded value (: 0 i32)]))]
      (for [turn 0 17]
        (for [order 0 2]
          (let [owned (= (% (+ turn order) 2) 1)
                (mut input) (g/duplicate graph a)
                before (ticks)
                result (if owned (sccp/optimize-memory! (mut input) 8 [ret] true a)
                                 (sccp/optimize-memory input 8 [ret] true a))
                elapsed (- (ticks) before)]
            (match result
              (Err [e] (panic "{}" e))
              (Ok [out]
                (let [(mut out) out]
                  (when (> turn 0)
                    (println "{} {} {} {}" count owned elapsed (len (.instructions (.graph out)))))
                  (rewrite/release! (mut out)))))
            (g/release! (mut input))))))
    (g/release! (mut graph))))
(defn main [] (-> i64)
  (exercise 512) (exercise 2048)
  0)
