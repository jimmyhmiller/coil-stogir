(module gaps.operand-control-runner)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.result" :use [Some None])
(extern gap_operand_control [(ptr g/Graph) i32 i32] (-> i64))

(defn main [] (-> i64)
  (let [(mut graph) (g/create (malloc-allocator))]
    (for [i 1 33]
      (match (g/append-inputs! (mut graph) 26 5 [(cast i32 i) (cast i32 (- 0 i))])
        (Some [_] 0) (None [] (panic "allocation failed"))))
    (let [pointer (p/cast (ptr g/Graph) (mut graph))]
      ; Independent expected values, including constants, zero, bounds, holes,
      ; and invalid arity metadata. Both successful and absent results matter.
      (for [r -3 36]
        (for [index -1 5]
          (let [expected (if (and (> r 0) (< r 33) (= index 1)) r
                          (if (and (> r 0) (< r 33) (= index 2)) (- 0 r)
                            -9223372036854775808))]
            (assert (= (gap_operand_control pointer (cast i32 r) (cast i32 index)) expected)))))
      (set! (mut (.arities graph)) 3 -1)
      (assert (= (gap_operand_control pointer 3 1) -9223372036854775808))
      (set! (mut (.arities graph)) 3 2)
      (let [(mut total) 0]
        (for [i 0 20000000]
          (let [r (+ (& i 31) 1)]
            (set! total (+ total (gap_operand_control pointer (cast i32 r) 1)))))
        (assert (= total 330000000))))
    (g/release! (mut graph))
    0))
