(module gaps.uses-graph-runner)
(import "stogir.graph" :as g)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Option Some None])
(import "coil.primitive" :as p)

(extern gap_uses_graph [(ptr g/Graph)] (-> u64))

(defn require [(value (Option i32))] (-> i32)
  (match value (Some [r] r) (None [] (panic "graph storage exhausted"))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut graph) (g/create a)
        start (require (g/append-inputs! (mut graph) 104 0 [(: 0 i32)]))
        input (require (g/append-inputs! (mut graph) 71 5 [start (: 0 i32) 0]))
        literal (require (g/intern-scalar! (mut graph) 5 7))
        (mut previous) input
        (mut expected) (+ (* (cast u64 start) 65537) (* (cast u64 input) 17) 1)]
    (for [i 0 2048]
      (let [next (require (g/append-inputs! (mut graph) (case (% i 4) 0 26 1 48 2 49 47)
                                          5 [previous literal]))]
        (set! expected (+ expected (* (cast u64 previous) 65537) (* (cast u64 next) 17) 1))
        (set! previous next))
      (when (= (% i 16) 0)
        (let [condition (require (g/append-inputs! (mut graph) 14 1 [previous literal]))
              selected (require (g/append-inputs! (mut graph) 60 5 [condition previous literal]))]
          ; Accumulate each actual positive input edge independently at construction.
          (set! expected (+ expected (* (cast u64 previous) 65537) (* (cast u64 condition) 17) 1
                                    (* (cast u64 condition) 65537) (* (cast u64 selected) 17) 1
                                    (* (cast u64 previous) 65537) (* (cast u64 selected) 17) 2))
          (set! previous selected))))
    (let [ret (require (g/append-inputs! (mut graph) 120 5 [start previous (: 0 i32)]))]
      (set! expected (+ expected (* (cast u64 start) 65537) (* (cast u64 ret) 17) 1
                                (* (cast u64 previous) 65537) (* (cast u64 ret) 17) 2)))
    (let [pointer (p/cast (ptr g/Graph) (mut graph))]
      (assert (> expected 0))
      (assert (= (gap_uses_graph pointer) expected))
      (let [(mut sum) (: 0 u64)]
        (for [i 0 128] (set! sum (+ sum (gap_uses_graph pointer))))
        (assert (= sum (* expected 128)))))
    (g/release! (mut graph))
    0))
