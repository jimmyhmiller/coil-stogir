(module gaps.uses-graph)
(import "stogir.graph" :as g)
(import "stogir.uses" :as uses)
(import "coil.cc" :as cc)
(import "coil.alloc" :use [malloc-allocator])

;;; Opaque input and a checksum of every definition/user/operand triple keep
;;; both adjacency construction passes and their materialized edges observable.
(defn kernel :cc (cc/C) :inline (Never) [(graph (ptr g/Graph))] (-> u64)
  (let [(mut lists) (uses/build (load graph) (malloc-allocator))
        (mut checksum) (: 0 u64)]
    (for [r 1 (len (.ranges lists))]
      (let [range (get (.ranges lists) r)]
        (for [i (.offset range) (+ (.offset range) (.count range))]
          (let [edge (get (.edges lists) i)]
            (set! checksum (+ checksum (* (cast u64 r) 65537)
                              (* (cast u64 (.user edge)) 17)
                              (cast u64 (.operand edge))))))))
    (uses/release! (mut lists))
    checksum))
(export-c [kernel :as "gap_uses_graph"])
