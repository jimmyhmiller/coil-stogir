(module gaps.slice-helpers)
(import "coil.cc" :as cc)
(import "coil.slice")

; Real compiler hot-path helpers: slice equality and length, default policy.
(defn kernel :cc (cc/C) :inline (Never) [(left (ptr u8))
                                         (right (ptr u8))
                                         (count i64)] (-> i64)
  (let [a (slice::new [u8] left count)
        b (slice::new [u8] right count)]
    (if (= a b) (len a) 0)))

(export-c [kernel :as "gap_slice_helpers"])
