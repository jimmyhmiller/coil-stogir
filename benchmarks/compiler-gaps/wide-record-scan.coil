(module gaps.wide-record-scan)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.arraylist" :use [ArrayList])

; A 32-byte record exceeds the two-register aggregate return path. Only three
; mixed-width fields are consumed. The checksum dependence prevents loop SIMD.
(defstruct Record [(header u32) (left i32) (right i32) (tag u32)
                   (payload u64) (unused u64)])
(defn kernel :cc (cc/C) :inline (Never)
  [(rows (ptr (ArrayList Record))) (count i64) (seed u64)] (-> u64)
  (let [(mut sum) seed]
    (for [i 0 count]
      (let [row (get (p/load rows) i)
            value (+ (cast u64 (cast i64 (.left row)))
                     (cast u64 (cast i64 (.right row))) (.payload row))]
        (set! sum (^ (+ (* sum 33) value) (>> sum 7)))))
    sum))
(export-c [kernel :as "gap_wide_record_scan"])
