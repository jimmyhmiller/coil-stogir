(module gaps.prepare-graph)
(import "stogir.graph" :as g)
(import "stogir.pipeline" :as pipeline)
(import "coil.cc" :as cc)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.result" :use [Ok Err])

;;; Opaque input; consume every materialized scheduled reference. The caller's
;;; independently constructed linear SSA graph makes all its nodes observable.
(defn kernel :cc (cc/C) :inline (Never) [(graph (ptr g/Graph)) (entry i32) (root i32)] (-> u64)
  (match (pipeline/prepare (load graph) entry [root] (malloc-allocator))
    (Err [_] 0)
    (Ok [owned]
        (let [(mut prepared) owned (mut checksum) (: 0 u64)]
          (for node (.nodes (.schedule prepared))
            (set! checksum (+ checksum (cast u64 node))))
          (pipeline/release! (mut prepared))
          checksum))))
(export-c [kernel :as "gap_prepare_graph"])
