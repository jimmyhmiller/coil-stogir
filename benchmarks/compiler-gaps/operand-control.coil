(module gaps.operand-control)
(import "stogir.graph" :as g)
(import "coil.cc" :as cc)
(import "coil.result" :use [Some None])

(defn kernel :cc (cc/C) :inline (Never)
  [(graph (ptr g/Graph)) (reference i32) (index i32)] (-> i64)
  (match (g/operand (load graph) reference index)
    (Some [value] (cast i64 value))
    (None [] -9223372036854775808)))
(export-c [kernel :as "gap_operand_control"])
