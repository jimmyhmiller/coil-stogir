(module gaps.wide-record-scan-runner)
(import "coil.primitive" :as p)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(defstruct Record [(header u32) (left i32) (right i32) (tag u32)
                   (payload u64) (unused u64)])
(extern benchmark_wide [(ptr u8) (ptr Record) i64 i64 u64] (-> i64))
(defn main [] (-> i64)
  (let [(mut rows) (ArrayList::new [Record] (malloc-allocator))]
    (for [i 0 4096]
      (push! (mut rows) (Record :header (cast u32 i)
        :left (cast i32 (- (* i 333) 999999))
        :right (cast i32 (- 1234 (* i 17))) :tag 99
        :payload (* (cast u64 i) 123456789) :unused 0xFEDCBA9876543210)))
    (let [result (benchmark_wide (p/cast (ptr u8) (mut rows)) (.data rows) 4096 1024 0x123456789ABCDEF0)]
      (free! (mut rows)) result)))
