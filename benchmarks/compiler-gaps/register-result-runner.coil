(module gaps.register-result-runner)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])

(defstruct Node [(header u32) (op1 i32) (op2 i32) (op3 i32)])

(extern kernel :as "gap_aggregate_get" [(ptr u8) i64] (-> i64))

; Use one identical LLVM-built caller with each backend's opaque kernel object.
(defn main [] (-> i64)
  (let [(mut rows) (ArrayList::new [Node] (malloc-allocator))
        (mut total) 0]
    (for [i 0 32]
      (push! (mut rows)
             (Node
               :header (cast u32 i)
               :op1 (cast i32 (* i 3))
               :op2 (cast i32 (+ (* i 7) 1))
               :op3 (cast i32 (- (* i 11) 9)))))
    (for [i 0 20000000]
      (set! total (+ total (kernel (p/cast (ptr u8) (mut rows)) (& i 31)))))
    (free! (mut rows))
    (if (= total 6350000000) 0 1)))
