(module gaps.slice-helpers-runner)
(import "coil.slice")

(extern kernel :as "gap_slice_helpers" [(ptr u8) (ptr u8) i64] (-> i64))

; Compile this runner once with LLVM and link that identical object against each
; backend's kernel. The opaque external call prevents caller specialization.
(defn main [] (-> i64)
  (let [left "abcdefghijklmnopqrstuvwxyz012345"
        right "abcdefghijklmnopqrstuvwxyz012346"
        (mut sum) 0]
    (for [i 0 20000000]
      (let [count (+ (& i 31) 1)]
        (set! sum (+ sum (kernel (data left) (data right) count)))))
    (if (= sum 310000000) 0 1)))
