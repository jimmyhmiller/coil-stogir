(module gaps.aggregate-get)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.arraylist" :use [ArrayList])

; Match the compiler's 16-byte compact node and its mixed-width field reads.
(defstruct Node [(header u32) (op1 i32) (op2 i32) (op3 i32)])

(defn kernel :cc (cc/C) :inline (Never) [(rows (ptr (ArrayList Node)))
                                         (index i64)] (-> i64)
  (let [node (get (p/load rows) index)]
    (+ (cast i64 (.op1 node)) (cast i64 (.op2 node)) (cast i64 (.op3 node)))))

(export-c [kernel :as "gap_aggregate_get"])
