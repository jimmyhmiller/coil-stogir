(defn need [T] [(x (Result T (slice u8)))] (-> T)
 (match x (Ok [v] v) (Err [e] (panic "{}" e))))
(defn inspect [(graph g/Graph) (entry i32) (roots (slice i32))] (-> void)
 (let [alc (malloc-allocator)
       (mut prepared) (need (pipeline/prepare-native graph entry roots alc))
       (mut plan) (need (matching/build graph (.schedule prepared) roots true alc))
       (mut phis) 0 (mut choices) 0 (mut selected) 0 (mut branches) 0]
  (for reference (.nodes (.schedule prepared))
   (let [node (get (.instructions graph) (cast i64 reference)) opcode (n/opcode node)
         tile (get (.tiles plan) (cast i64 reference))]
    (when (= opcode 67) (set! phis (+ phis 1)))
    (when (= opcode 116) (set! branches (+ branches 1)))
    (when (= opcode 60)
     (set! choices (+ choices 1))
     (when (and (>= (.rule tile) 34) (<= (.rule tile) 37))
      (set! selected (+ selected 1))
      (println "selected {} rule {} wide {} values {} {} type {} comparison {}" reference (.rule tile)
       (.wide tile) (.left tile) (.right tile) (n/type-id node)
       (n/opcode (get (.instructions graph) (cast i64 (.op1 node)))))))))
  (println "scheduled phis {} COND {} minmax {} IF {}" phis choices selected branches)
  (matching/release! (mut plan)) (pipeline/release! (mut prepared))))
