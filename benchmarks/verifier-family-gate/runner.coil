(module gaps.family-gate-runner)
(import "stogir.graph" :as g)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as p)
(import "coil.result" :use [Option Some None])
(extern gap_verify_integer [(ptr g/Graph) (ptr u8) i64] (-> i64))
(defn need [(x (Option i32))] (-> i32)
 (match x (Some [r] r) (None [] (panic "capacity"))))
(defn check [(opcode i32) (ty i32) (count i64) (mode i32)] (-> void)
 (let [a (malloc-allocator) (mut graph) (g/create a)
       start (need (g/append-inputs! (mut graph) 104 0 [(: 0 i32)]))
       value (need (g/append-inputs! (mut graph) 71 (cast u8 ty) [start (: 0 i32) 0]))
       (mut inputs) (ArrayList::new [i32] a)
       (mut error) (ArrayList::new [u8] a)]
  (for [i 0 count]
   (push! (mut inputs) (case mode 0 value 1 start 2 0 3 2147483647 -2147483648)))
  (need (g/append-inputs! (mut graph) (cast u8 opcode) (cast u8 ty) (slice inputs)))
  (extend-zeroed! (mut error) 256)
  (let [result (gap_verify_integer (p/cast (ptr g/Graph) (mut graph)) (.data error) 256)]
   (print "{} {} {} {} {}" opcode ty count mode result)
   (when (< result 0) (for [i 0 (- -1 result)] (print " {}" (get error i))))
   (println ""))
  (free! (mut error)) (free! (mut inputs)) (g/release! (mut graph))))
(defn main [] (-> i64)
 (for [opcode 0 145] (for [ty 0 14] (for [count 0 7] (for [mode 0 5]
  (check (cast i32 opcode) (cast i32 ty) count (cast i32 mode))))))
 0)
