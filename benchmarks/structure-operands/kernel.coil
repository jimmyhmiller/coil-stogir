(module gaps.structure-operands)
(import "stogir.graph" :as g)
(import "stogir.verify" :as verify)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)
(import "coil.result" :use [Ok Err])
(defn kernel :cc (cc/C) :inline (Never)
 [(graph (ptr g/Graph)) (error (ptr u8)) (capacity i64)] (-> i64)
 (match (verify/structure (load graph))
  (Ok [count] (cast i64 count))
  (Err [message]
   (assert (<= (len message) capacity))
   (for [i 0 (len message)] (set! (p/index error i) (get message i)))
   (- -1 (len message)))))
(export-c [kernel :as "gap_verify_structure"])
