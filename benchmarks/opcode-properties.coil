(module stogir.benchmarks.opcode-properties)
(import "stogir.opcode" :as op)

;;; Feed all class observations into the next index; repeated lookups cannot be
;;; hoisted or replaced with a constant aggregate count.
(defn kernel :inline (Never) [(rounds i64)] (-> u64)
  (let [(mut state) (: 81985529216486895 u64)]
    (for [i 0 rounds]
      (set! state (+ (* state 6364136223846793005) 1442695040888963407))
      (let [opcode (cast i32 (& (>> state 32) 127))
            flags
              (+ (if (op/control? opcode) (: 1 u64) 0)
                 (if (op/block-start? opcode) (: 2 u64) 0)
                 (if (op/block-end? opcode) (: 4 u64) 0)
                 (if (op/terminator? opcode) (: 8 u64) 0))]
        (set! state (^ state flags))))
    state))

(defn main [] (-> i64)
  (println "{}" (kernel 10000000))
  0)
