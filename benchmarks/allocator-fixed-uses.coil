(module stogir.benchmarks.allocator-fixed-uses)
(import "stogir.allocation" :as a)
(import "stogir.constraints" :as c)
(import "stogir.interval" :as range)
(import "stogir.fixed-uses" :as fixed)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.args" :as args)
(import "coil.result" :use [Result Ok Err])

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args/init! argc argv)
  (let [allocator (malloc-allocator)
        count
          (if (args/has? "--small") 256 (if (args/has? "--large") 4096 1024))
        indexed (args/has? "--events")
        stateful (args/has? "--state")
        (mut parts) (ArrayList::new [a/Part] allocator)
        (mut old)
          (a/PressureIndex :known 0 :parts (ArrayList::new [i32] allocator))
        (mut events) (fixed/empty allocator)
        (mut assigned) (a/empty-assigned allocator)
        (mut pressure) (a/pressure-buffer 8 allocator)
        (mut checksum) 0]
    (for [i 0 count]
      (let [(mut part) (a/create (cast i32 i) allocator)]
        (range/add! (mut (.ranges part)) (* i 3) (+ (* i 3) 3))
        (push! (mut parts) part)))
    (for [i 0 count]
      (for [reg 0 8]
        (assert (a/reserve! (mut parts)
                            (cast i32 reg)
                            (+ (* i 3) 1)
                            (+ (* i 3) 2)
                            allocator))))
    (if (or indexed stateful)
        (match (a/event-index parts 8 allocator)
          (Err [message] (panic "{}" message))
          (Ok [built] (fixed/release! (mut events)) (set! events built)))
        (a/refresh-pressure! (mut old) parts))
    (when stateful
      (match (a/assigned-index parts 8 allocator)
        (Err [message] (panic "{}" message))
        (Ok [built] (a/release-assigned! (mut assigned)) (set! assigned built))))
    (for [i 0 count]
      (if stateful
          (assert (a/pressure-state-into! parts
                                          (cast i32 i)
                                          (mut events)
                                          (mut assigned)
                                          (mut pressure)))
          (if indexed
              (a/pressure-events-into! parts
                                       (cast i32 i)
                                       (mut events)
                                       (mut pressure))
              (a/pressure-into! parts (cast i32 i) old (mut pressure))))
      (for [reg 0 8]
        (set! checksum
              (+ checksum
                 (get (.fixed-at pressure) reg)
                 (get (.free pressure) reg)
                 (get (.next-use pressure) reg)))))
    (let [expected (* 24 (+ (/ (* 3 count (- count 1)) 2) count))]
      (assert (= checksum expected)))
    (for [i 0 (len parts)] (a/release! (elem (mut parts) i)))
    (free! (mut parts))
    (free! (mut (.parts old)))
    (fixed/release! (mut events))
    (a/release-assigned! (mut assigned))
    (a/release-pressure! (mut pressure))
    0))
