;;; Entry-block fixed stack objects follow IR_STATIC_ALLOCA in pinned
;;; ir_aarch64.dasc. Raw-SP operations remain distinct. See NOTICE.
(module stogir.a64.static-stack)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.stack" :as stack)
(import "stogir.schedule" :as schedule)
(import "stogir.frame" :as frame)
(import "stogir.locations" :as locations)
(import "stogir.a64.frame-address" :as address)
(import "stogir.a64.code" :as code)
(import "stogir.a64.registers" :as registers)
(import "coil.arraylist" :use [ArrayList])
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Some None Ok Err])

;;; Requires validated graph and schedule. Select only explicitly declared
;;; function-lifetime objects. Ordinary raw ALLOCA retains its SP semantics.
;;; A nonempty result is indexed by graph ref; zero means dynamic.
(defn select [(graph g/Graph) (scheduled schedule/Schedule) (a (dyn Allocator))]
  (-> (ArrayList i64))
  (let [(mut sizes) (ArrayList::new [i64] a)]
    (for reference (.nodes scheduled)
      (let [node (get (.instructions graph) (cast i64 reference))]
        (when (stack/frame-object? node)
          (match (stack/constant-size graph (.op2 node))
            (Err [_] 0)
            (Ok [size]
                (when (> size 0)
                  (when (= (len sizes) 0)
                    (reserve! (mut sizes) (len (.instructions graph)))
                    (for [i 0 (len (.instructions graph))] (push! (mut sizes) 0)))
                  (set! (mut sizes) (cast i64 reference) size)))))))
    sizes))

(defn size [(sizes (ArrayList i64)) (reference i32)] (-> i64)
  (if (and (> reference 0) (< (cast i64 reference) (len sizes)))
      (get sizes (cast i64 reference))
      0))

;;; First-stage static definition retains its ordinary allocated GPR. All fixed
;;; addresses share checked frame geometry; no dynamic SP adjustment occurs.
(defn emit! [(output (mut code/Buffer))
              (parts locations/View)
              (frame frame/Frame)
              (reference i32)
              (position i64)
              (base address/Base)] (-> (Result i32 (slice u8)))
  (match (get (.locals frame) reference)
    (None [] (Err "static allocation has no frame object"))
    (Some [index]
          (let [slot (get (.slots frame) index)]
            (match (address/offset base (.offset slot))
              (Err [message] (Err message))
              (Ok [offset]
                  (match (locations/resolve parts reference (+ position 1))
                    (Err [message] (Err message))
                    (Ok [destination]
                        (if (or (!= (.kind destination) 0)
                                (not (registers/allocatable? 6 (cast i32 (.value destination)))))
                            (Err "static allocation definition requires an allocatable GPR")
                            (address/address! (mut (.text output))
                                              (cast i32 (.value destination))
                                              (.reg base) offset))))))))))
