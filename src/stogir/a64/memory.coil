;;; Control-pinned scalar GPR/SIMD memory emission.
(module stogir.a64.memory)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.allocation" :as a)
(import "stogir.locations" :as loc)
(import "stogir.a64.value" :as value)
(import "stogir.a64.registers" :as registers)
(import "stogir.a64.encode" :as encode)
(import "stogir.a64.address" :as address-match)
(import "stogir.a64.frame-address" :as frame)
(import "stogir.bytes" :as bytes)
(import "stogir.a64.code" :as code)
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(defn size [(graph g/Graph) (reference i32)] (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "memory node missing"))
    (Some [node]
          (let [opcode (n/opcode node)
                load? (<= opcode 92)]
            (if (or (<= reference 0)
                    (< opcode 91)
                    (> opcode 94)
                    (!= (get (.arities graph) (cast i64 reference))
                        (if load? 2 3)))
                (Err "invalid memory instruction")
                (match (g/lookup graph (.op2 node))
                  (None [] (Err "memory address missing"))
                  (Some [address]
                        (if (!= (n/type-id address) 6)
                            (Err "memory address must be ADDR")
                            (match (if load?
                                       (Some node)
                                       (g/lookup graph (.op3 node)))
                              (None [] (Err "store value missing"))
                              (Some [input]
                                    (let [ty (cast i32 (n/type-id input))]
                                      (if (and (not load?)
                                               (!= (n/type-id node) 0))
                                          (Err "store must be void")
                                          (if (or (types/integer? ty)
                                                  (types/floating? ty)
                                                  (types/short-vector? ty 8))
                                              (Ok (types/size ty 8))
                                              (Err "unsupported memory value type"))))))))))))))

(defn emit-address-with-locations! [(output (mut code/Buffer))
                                    (graph g/Graph)
                                    (parts loc/View)
                                    (reference i32)
                                    (position i64)
                                    (address i32)
                                    (offset i64)]
  (-> (Result i32 (slice u8)))
  (match (size graph reference)
    (Err [message] (Err message))
    (Ok [width]
        (let [node (get (.instructions graph) (cast i64 reference))
              load? (<= (n/opcode node) 92)
              (mut temporary) (code/create (.alc (.text output)))
              (mut error) ""
              (mut base) (: -1 i32)
              (mut displacement) offset
              (mut address-type) (: 0 i32)
              (mut reg) (: -1 i32)]
          ; Resolve positive operands once. Fixed addresses can become physical
          ; frame operands after layout; overflowing or unencodable combinations
          ; retain materialization and the original selected displacement.
          (when (> address 0)
            (match (g/lookup graph address)
              (None [] (set! error "scalar operand missing"))
              (Some [source] (set! address-type (cast i32 (n/type-id source))))))
          (when (= error "")
          (if (> address 0)
              (match (loc/resolve parts address position)
                (Err [message] (set! error message))
                (Ok [location]
                    (if (loc/rematerialized? location)
                        (let [(mut direct) false]
                          (when (!= address-type 6)
                            (set! error "invalid frame-address materialization type"))
                          (when (and (= error "") (>= (.value location) 0)
                                     (or (<= offset 0)
                                         (<= (.value location) (- 0x7FFFFFFFFFFFFFFF offset))))
                            (let [combined (+ (.value location) offset)]
                              (when (address-match/encodable? width combined)
                                (set! direct true)
                                (set! base (loc/address-base location))
                                (set! displacement combined))))
                          (when (and (= error "") (not direct))
                            (match (frame/address! (mut (.text temporary)) 16
                                                   (loc/address-base location) (.value location))
                              (Err [message] (set! error message))
                              (Ok [_] (set! base 16)))))
                        (if (and (= (.kind location) 0)
                                 (registers/allocatable? address-type (cast i32 (.value location))))
                            (set! base (cast i32 (.value location)))
                            (set! error "memory address requires a GPR or fixed frame source")))))
              (match (value/register-with-locations! (mut temporary) graph parts
                                                     address position 16 62)
                (Err [message] (set! error message))
                (Ok [r] (set! base r)))))
          (if load?
              (match (loc/resolve parts reference (+ position 1))
                (Err [message] (set! error message))
                (Ok [destination]
                    (if (and (= (.kind destination) 0)
                             (registers/allocatable? (cast i32 (n/type-id node))
                                                     (cast i32
                                                           (.value destination))))
                        (set! reg (cast i32 (.value destination)))
                        (set! error
                              "load result requires register of its class"))))
              (match (value/register-with-locations! (mut temporary)
                                                     graph
                                                     parts
                                                     (.op3 node)
                                                     position
                                                     17
                                                     63)
                (Err [message] (set! error message))
                (Ok [r] (set! reg r))))
          (when (= error "")
            (match (if (and (>= displacement 0)
                            (= (% displacement (cast i64 width)) 0)
                            (<= (/ displacement (cast i64 width)) 4095))
                       (if (registers/simd? reg)
                           (encode/floating-load-store load?
                                                       width
                                                       (registers/physical reg)
                                                       base
                                                       displacement)
                           (if (and load?
                                    (types/signed? (cast i32 (n/type-id node)))
                                    (< width 4))
                               (encode/signed-load false width reg base displacement)
                               (encode/load-store load? width reg base displacement)))
                       (encode/unscaled-load-store load?
                                                   (registers/simd? reg)
                                                   (and load?
                                                        (not (registers/simd? reg))
                                                        (types/signed? (cast i32
                                                                             (n/type-id node)))
                                                        (< width 4))
                                                   false
                                                   width
                                                   (registers/physical reg)
                                                   base
                                                   displacement))
              (Err [message] (set! error message))
              (Ok [word] (bytes/append32! (mut (.text temporary)) word))))
          (let [count (cast i32 (len (.text temporary)))]
            (when (and (= error "") (not (code/append! (mut output) temporary)))
              (set! error "invalid memory code references"))
            (code/release! (mut temporary))
            (if (= error "") (Ok count) (Err error)))))))

(defn emit-with-locations! [(output (mut code/Buffer))
                            (graph g/Graph)
                            (parts loc/View)
                            (reference i32)
                            (position i64)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "memory node missing"))
    (Some [node]
          (emit-address-with-locations! (mut output)
                                        graph
                                        parts
                                        reference
                                        position
                                        (.op2 node)
                                        0))))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit-address! [(output (mut code/Buffer))
                     (graph g/Graph)
                     (parts (ArrayList a/Part))
                     (reference i32)
                     (position i64)
                     (address i32)
                     (offset i64)] (-> (Result i32 (slice u8)))
  (emit-address-with-locations! (mut output)
                                graph
                                (loc/linear-view parts)
                                reference
                                position
                                address
                                offset))

;;; Compatibility entry retains the original full-scan lookup policy.
(defn emit! [(output (mut code/Buffer))
             (graph g/Graph)
             (parts (ArrayList a/Part))
             (reference i32)
             (position i64)] (-> (Result i32 (slice u8)))
  (emit-with-locations! (mut output)
                        graph
                        (loc/linear-view parts)
                        reference
                        position))
