;;; Worklist orchestration adapted from pinned ir_sccp.c:ir_sccp_analyze.
;;; Development: remaining fold families and mem2ssa policy are not yet implemented.
(module stogir.sccp-analysis)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.verify" :as verify)
(import "stogir.switch" :as switch)
(import "stogir.sccp-values" :as v)
(import "stogir.sccp-phi" :as phi)
(import "stogir.sccp-control" :as control)
(import "stogir.sccp-fold" :as folding)
(import "stogir.bitqueue" :as q)
(import "stogir.uses" :as uses)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defstruct Analysis [(domain v/Domain) (iteration q/Queue) (pointer-bytes i32)])

(defn release! [(analysis (mut Analysis))] (-> void)
  (v/release! (mut (.domain analysis)))
  (q/release! (mut (.iteration analysis))))

(defn data? [(opcode i32)] (-> bool)
  (let [shape (op/shape opcode)
        kind (get shape 0)]
    (or (= kind #\d) (= kind #\p) (= kind #\r))))

;;; Preconditions: fresh analysis, verified graph and Phi shapes; entry START
;;; is reference one. MEM2SSA immediate-Phi policy is not yet supported.
;;; Edges must describe this exact graph. The caller owns analysis and may inspect
;;; iteration candidates, but no graph rewrite has been applied by this function.
(defn run! [(graph g/Graph) (edges uses/Uses) (analysis (mut Analysis))]
  (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        (mut reference) (: 0 i64)]
    (q/add! (mut (.pending (.domain analysis))) 1)
    (set! reference (q/pop! (mut (.pending (.domain analysis)))))
    (while (and (>= reference 0) (= error ""))
      (let [r (cast i32 reference)
            node (get (.instructions graph) reference)
            opcode (cast i32 (n/opcode node))
            (mut changed) false]
        (when (v/bottom? (.domain analysis) r)
          (panic "bottom SCCP worklist entry {}" r))
        (if (data? opcode)
            (when (> (.count (get (.ranges edges) reference)) 0)
              (cond (= opcode 67)
                      (set! changed
                            (phi/transfer! graph
                                           (mut (.domain analysis))
                                           edges
                                           r))
                    (and (>= opcode 14) (<= opcode 68))
                      (match (folding/transfer! graph
                                                (mut (.domain analysis))
                                                edges
                                                (mut (.iteration analysis))
                                                r
                                                (.pointer-bytes analysis))
                        (Err [message] (set! error message))
                        (Ok [result] (set! changed result)))
                    :else
                      (do
                        (v/make-bottom! (mut (.domain analysis)) edges r)
                        (let [count (op/input-count opcode)]
                          (for [index 1 (+ (cast i64 count) 1)]
                            (let [source (phi/input graph r (cast i32 index))]
                              (when (and (> source 0)
                                         (v/top? (.domain analysis) source))
                                (v/add-input! (mut (.domain analysis)) source)))))
                        (set! changed true))))
            (set! changed
                  (control/transfer! graph
                                     (mut (.domain analysis))
                                     edges
                                     (mut (.iteration analysis))
                                     r)))
        (when changed (v/add-uses! (mut (.domain analysis)) edges r)))
      (when (= error "")
        (set! reference (q/pop! (mut (.pending (.domain analysis)))))))
    (if (= error "") (Ok 0) (Err error))))

(defn create [(size i64) (pointer-bytes i32) (a (dyn Allocator))] (-> Analysis)
  (Analysis
    :domain (v/create size a)
    :iteration (q/create size a)
    :pointer-bytes pointer-bytes))

(defn analyze [(graph g/Graph) (pointer-bytes i32) (a (dyn Allocator))]
  (-> (Result Analysis (slice u8)))
  (if (not (or (= pointer-bytes 4) (= pointer-bytes 8)))
      (Err "invalid SCCP target pointer width")
      (match (verify/constants graph pointer-bytes)
        (Err [message] (Err message))
        (Ok [_]
            (match (verify/structure graph)
              (Err [message] (Err message))
              (Ok [_]
                  (match (verify/phis graph)
                    (Err [message] (Err message))
                    (Ok [_]
                        (match (switch/verify graph a)
                          (Err [message] (Err message))
                          (Ok [_]
                              (if (or (<= (len (.instructions graph)) 1)
                                      (!= (n/opcode (get (.instructions graph)
                                                         1))
                                          104))
                                  (Err "SCCP requires START at reference one")
                                  (let [(mut edges) (uses/build graph a)
                                        (mut result)
                                          (create (len (.instructions graph))
                                                  pointer-bytes
                                                  a)
                                        status (run! graph edges (mut result))]
                                    (uses/release! (mut edges))
                                    (match status
                                      (Err [message]
                                           (release! (mut result))
                                           (Err message))
                                      (Ok [_] (Ok result)))))))))))))))
