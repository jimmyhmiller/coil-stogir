; Frame-address shape follows dstogov/ir ir.h, 92171d0. See NOTICE.
(module stogir.stack)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.symbols" :as symbols)
(import "stogir.frame" :as frame)
(import "coil.result" :use [Result Ok Err Some None])

(defn validate-frame-address [(graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "frame address instruction missing"))
    (Some [node]
          (if (or (<= reference 0)
                  (!= (n/opcode node) 66)
                  (!= (n/type-id node) 6)
                  (!= (get (.arities graph) (cast i64 reference)) 0))
              (Err "invalid FRAME_ADDR instruction")
              (Ok 8)))))

(defn operation? [(opcode i32)] (-> bool)
  (or (= opcode 66) (= opcode 81) (= opcode 82)))

;;; Allocation and free use the same sixteen-byte rounded byte count. Counts
;;; must be nonnegative and leave room for rounding without signed overflow.
(defn constant-size [(graph g/Graph) (reference i32)]
  (-> (Result i64 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "stack byte count missing"))
    (Some [node]
          (let [ty (cast i32 (n/type-id node))
                width (types/scalar-size ty 8)
                bits (n/constant-bits node)]
            (if (or (>= reference 0)
                    (not (types/integer? ty))
                    (not (symbols/numeric? node))
                    (<= width 0)
                    (and (< width 8) (!= (>> bits (cast u64 (* width 8))) 0))
                    (and (types/signed? ty)
                         (!= (& bits
                                (<< (: 1 u64) (cast u64 (- (* width 8) 1))))
                             0))
                    (> bits (: 0x7FFFFFFFFFFFFFF0 u64)))
                (Err "invalid or overflowing constant stack byte count")
                (Ok (cast i64 (& (+ bits 15) (: 0xFFFFFFFFFFFFFFF0 u64)))))))))

(defn validate-inputs [(graph g/Graph)
                       (opcode i32)
                       (ty i32)
                       (control i32)
                       (size i32)
                       (alignment i32)]
  (-> (Result i32 (slice u8)))
  (if (or (not (or (= opcode 81) (= opcode 82)))
          (!= ty (if (= opcode 81) 6 0))
          (and (= opcode 81)
               (!= alignment 0)
               (not (frame/valid-alignment? (cast i64 alignment)))))
      (Err "invalid stack operation type or alignment")
      (match (g/lookup graph control)
        (None [] (Err "stack operation control missing"))
        (Some [node]
              (if (or (<= control 0)
                      (not (op/control? (cast i32 (n/opcode node))))
                      (op/block-end? (cast i32 (n/opcode node))))
                  (Err "invalid stack operation control")
                  (match (g/lookup graph size)
                    (None [] (Err "stack byte count missing"))
                    (Some [input]
                          (if (or (not (types/integer? (cast i32
                                                             (n/type-id input))))
                                  (= (n/opcode input) 72))
                              (Err "stack byte count must be an integer value")
                              (if (< size 0)
                                  (match (constant-size graph size)
                                    (Err [message] (Err message))
                                    (Ok [_]
                                        (Ok (types/scalar-size (cast i32
                                                                     (n/type-id input))
                                                               8))))
                                  (Ok (types/scalar-size (cast i32
                                                               (n/type-id input))
                                                         8)))))))))))

(defn validate [(graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (match (g/lookup graph reference)
    (None [] (Err "stack instruction missing"))
    (Some [node]
          (let [opcode (cast i32 (n/opcode node))]
            (if (= opcode 66)
                (validate-frame-address graph reference)
                (if (or (<= reference 0)
                        (not (operation? opcode))
                        (!= (get (.arities graph) (cast i64 reference))
                            (if (= opcode 81) 3 2)))
                    (Err "invalid stack instruction")
                    (validate-inputs graph
                                     opcode
                                     (cast i32 (n/type-id node))
                                     (.op1 node)
                                     (.op2 node)
                                     (.op3 node))))))))
