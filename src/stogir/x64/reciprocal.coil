;;; x86-64 division and remainder by a constant without `div`.
;;;
;;; PLACEHOLDER: no rule is selected yet, so DIV and MOD by a constant are
;;; emitted as a plain `div`/`idiv` with the divisor built in r11
;;; (stogir.x64.emit/divide!). That is correct, only slow.
;;;
;;; Interface (see docs/X86_FAMILIES.md)
;;;
;;;   (select graph reference tile) -> select/Tile
;;;       Called by stogir.x64.match for every DIV/MOD tile. Return `tile`
;;;       unchanged to keep the hardware division, or a tile whose rule is in
;;;       [select/RULE-RECIPROCAL-FIRST, select/RULE-RECIPROCAL-LAST]:
;;;       power-of-two shifts and masks, or multiply-high by a magic number
;;;       (the neutral magic-number arithmetic is in stogir.a64.reciprocal
;;;       and stogir.a64.select/division-reciprocal; move it to
;;;       src/stogir/ when sharing it).
;;;   (constrain! set graph matched reference position tile)
;;;       Requirements of a reciprocal tile. One-operand `mul`/`imul` for the
;;;       64-bit high half clobbers rax and rdx (uses/clobber!), exactly as
;;;       RULE-DIVIDE does in stogir.x64.constraints.
;;;   (emit! out cx reference position tile)
;;;       Emission of a reciprocal tile. r10/r11 are free; flags are dead on
;;;       entry and exit.
(module stogir.x64.reciprocal)
(import "stogir.graph" :as g)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.select" :as select)
(import "stogir.x64.uses" :as uses)
(import "coil.result" :use [Result Ok Err])

(const PENDING "x86-64 backend: reciprocal division rules are not implemented yet; see docs/X86_FAMILIES.md")

;;; No reciprocal rule exists yet: every division keeps its hardware tile.
(defn select [(graph g/Graph) (reference i32) (tile select/Tile)] (-> select/Tile)
  tile)

(defn constrain! [(set (mut uses/Set)) (graph g/Graph) (matched plan/Plan)
                  (reference i32) (position i64) (tile select/Tile)]
  (-> (Result i32 (slice u8)))
  (Err PENDING))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32)
             (position i64) (tile select/Tile)] (-> (Result i32 (slice u8)))
  (Err PENDING))
