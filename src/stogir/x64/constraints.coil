;;; x86-64 register constraints over a matched schedule: what each scheduled
;;; node needs from the allocator.
;;;
;;; Positions follow stogir.live-ranges: scheduled node i reads its operands
;;; at 2i and defines its result at 2i + 1. The vocabulary and the x86-64
;;; additions (clobbers, hints) are described in stogir.x64.uses.
;;;
;;; Core rules
;;;   * Operands and results of integer instructions are in registers.
;;;   * Two-address results hint the register of their first operand.
;;;   * A 32- or 64-bit variable shift count is a fixed use of rcx. The result
;;;     may land in rcx when the count dies there; the emitter handles it.
;;;   * An 8- or 16-bit variable shift masks its count in rcx, which is
;;;     therefore clobbered across the whole instruction.
;;;   * DIV and MOD clobber rax and rdx while the operands are read (so no
;;;     operand and no live value is in either); the register that does not
;;;     hold the result stays clobbered over the definition, and the result
;;;     prefers the other.
;;;   * Register parameters are fixed definitions; RETURN's value may be
;;;     anywhere and prefers rax.
;;;
;;; Every other node is constrained by its operation family
;;; (stogir.x64.families/constrain!).
(module stogir.x64.constraints)
(import "stogir.graph" :as g)
(import "stogir.matched-uses" :as machine)
(import "stogir.constraints" :as c)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "stogir.types" :as types)
(import "stogir.copy" :as copy)
(import "stogir.conditional" :as conditional)
(import "stogir.conversion" :as conversion)
(import "stogir.terminal" :as terminal)
(import "stogir.schedule" :as schedule)
(import "stogir.x64.families" :as families)
(import "stogir.x64.incoming" :as incoming)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.reciprocal" :as reciprocal)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.select" :as select)
(import "stogir.x64.switch" :as switch)
(import "stogir.x64.uses" :as uses)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [Result Ok Err Some None])

(const CONFLICT "conflicting x86-64 register constraints")

(defn require! [(error (mut (slice u8))) (accepted bool)] (-> void)
  (when (and (not accepted) (= error "")) (set! error CONFLICT)))

;;; Requirements of a node selected as `tile` whose result is `reference`.
(defn tile! [(set (mut uses/Set)) (error (mut (slice u8))) (graph g/Graph)
             (matched plan/Plan) (reference i32) (position i64) (tile select/Tile)]
  (-> void)
  (let [rule (.rule tile)]
    (cond (select/reciprocal-rule? rule)
            (match (reciprocal/constrain! (mut set) graph matched reference position tile)
              (Err [message] (when (= error "") (set! error message)))
              (Ok [_] 0))
          (= rule select/RULE-NONE)
            (when (= error "") (set! error "instruction has no selected x86-64 rule"))
          :else
            (do
              (require! (mut error) (uses/use! (mut set) (.left tile) position))
              (require! (mut error) (uses/define! (mut set) reference position))
              (cond (= rule select/RULE-SHIFT-RC)
                      (require! (mut error)
                                (uses/use-fixed! (mut set) (.right tile) position registers/RCX))
                    (= rule select/RULE-SHIFT-MASKED)
                      (do
                        (require! (mut error) (uses/use! (mut set) (.right tile) position))
                        (uses/clobber! (mut set) registers/RCX position (+ position 2)))
                    (= rule select/RULE-DIVIDE)
                      (let [quotient (= (.operation tile) select/DIVIDE-QUOTIENT)]
                        (require! (mut error) (uses/use! (mut set) (.right tile) position))
                        (uses/clobber! (mut set) registers/RAX position (+ position 1))
                        (uses/clobber! (mut set) registers/RDX position (+ position 1))
                        (uses/clobber! (mut set)
                                       (if quotient (: registers/RDX i32) registers/RAX)
                                       (+ position 1) (+ position 2))
                        (uses/prefer! (mut set) reference
                                      (if quotient (: registers/RAX i32) registers/RDX)))
                    :else
                      (require! (mut error) (uses/use! (mut set) (.right tile) position)))
              (unless (or (select/comparison-rule? rule) (= rule select/RULE-DIVIDE))
                (uses/hint! (mut set) reference (.left tile)))))))

(defn build-matched [(graph g/Graph)
                     (scheduled schedule/Schedule)
                     (matched plan/Plan)
                     (allocator (dyn Allocator))]
  (-> (Result uses/Set (slice u8)))
  (let [(mut set) (uses/create allocator)
        (mut error) ""]
    (for [i 0 (len (.instructions graph))]
      (push! (mut (.values set))
             (uses/Value
               :uses (ArrayList::new [c/Use] allocator)
               :parameter (incoming/absent)
               :rematerialized (machine/rematerialized? (.operands matched) (cast i32 i)))))
    (if (= (len (.nodes scheduled)) 0)
        (set! error "empty function schedule")
        (match (incoming/build graph (get (.nodes scheduled) 0) allocator)
          (Err [message] (set! error message))
          (Ok [parameters]
              (let [(mut owned) parameters]
                (for parameter owned
                  (set! (.parameter (elem (mut (.values set)) (cast i64 (.reference parameter))))
                        parameter))
                (free! (mut owned))))))
    (for [i 0 (len (.nodes scheduled))]
      (when (= error "")
        (let [reference (get (.nodes scheduled) i)
              node (get (.instructions graph) (cast i64 reference))
              opcode (cast i32 (n/opcode node))
              ty (cast i32 (n/type-id node))
              position (* i 2)
              family (plan/family matched reference)]
          (cond (machine/rematerialized? (.operands matched) reference) 0
                (plan/omitted? matched reference) 0
                (= family families/SWITCH)
                  (match (switch/constrain! (mut set) graph matched reference position)
                    (Err [message] (set! error message))
                    (Ok [_] 0))
                (!= family families/CORE)
                  (match (families/constrain! (mut set) graph matched reference position family)
                    (Err [message] (set! error message))
                    (Ok [_] 0))
                (or (op/block-start? opcode) (= opcode 114) (= opcode 115) (= opcode 67)) 0
                (or (= opcode 96) (= opcode 121))
                  (match (terminal/validate graph reference)
                    (Err [message] (set! error message))
                    (Ok [_] 0))
                (= opcode 71)
                  (let [parameter (.parameter (at (.values set) (cast i64 reference)))]
                    (cond (= (.kind parameter) 0)
                            (require! (mut error)
                                      (uses/define-fixed! (mut set) reference position
                                                          (.register parameter)))
                          (= (.kind parameter) 1)
                            (require! (mut error) (uses/define! (mut set) reference position))
                          :else (set! error "unsupported x86-64 scalar parameter")))
                (= opcode 120)
                  (when (!= ty 0)
                    (require! (mut error) (uses/use-anywhere! (mut set) (.op2 node) position))
                    (uses/prefer! (mut set) (.op2 node) registers/RAX))
                (= opcode 116)
                  (if (plan/fused? matched reference)
                      (let [tile (plan/condition-tile matched reference)]
                        (require! (mut error) (uses/use! (mut set) (.left tile) position))
                        (require! (mut error) (uses/use! (mut set) (.right tile) position)))
                      (require! (mut error) (uses/use! (mut set) (.op2 node) position)))
                (= opcode 60)
                  (match (conditional/validate graph reference)
                    (Err [message] (set! error message))
                    (Ok [_]
                        (if (plan/fused? matched reference)
                            (let [tile (plan/condition-tile matched reference)]
                              (require! (mut error) (uses/use! (mut set) (.left tile) position))
                              (require! (mut error) (uses/use! (mut set) (.right tile) position)))
                            (require! (mut error) (uses/use! (mut set) (.op1 node) position)))
                        (require! (mut error) (uses/use! (mut set) (.op2 node) position))
                        (require! (mut error) (uses/use! (mut set) (.op3 node) position))
                        (require! (mut error) (uses/define! (mut set) reference position))
                        ; The emitter moves the false arm into rd first.
                        (uses/hint! (mut set) reference (.op3 node))))
                (= opcode 68)
                  (match (copy/validate graph reference)
                    (Err [message] (set! error message))
                    (Ok [_]
                        (require! (mut error) (uses/use-anywhere! (mut set) (.op1 node) position))
                        (require! (mut error) (uses/define! (mut set) reference position))
                        (uses/hint! (mut set) reference (.op1 node))))
                (and (>= opcode 33) (<= opcode 36))
                  (match (conversion/validate graph reference 8)
                    (Err [message] (set! error message))
                    (Ok [_]
                        (require! (mut error) (uses/use! (mut set) (.op1 node) position))
                        (require! (mut error) (uses/define! (mut set) reference position))
                        (uses/hint! (mut set) reference (.op1 node))))
                (or (= opcode 31) (= opcode 45))
                  (do
                    (require! (mut error) (uses/use! (mut set) (.op1 node) position))
                    (require! (mut error) (uses/define! (mut set) reference position))
                    (uses/hint! (mut set) reference (.op1 node)))
                :else
                  (tile! (mut set) (mut error) graph matched reference position
                         (get (.tiles matched) (cast i64 reference)))))))
    (if (= error "") (Ok set) (do (uses/release! (mut set)) (Err error)))))
