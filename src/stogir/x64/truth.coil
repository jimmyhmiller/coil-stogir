;;; Flags for "this scalar value is nonzero", shared by IF and COND when their
;;; condition is a value rather than a fused comparison. CC-NE means true.
;;;
;;; The test runs at the value's own width (`test r8, r8` for a BOOL), since
;;; bits above it are unspecified (stogir.x64.value). The operand is loaded
;;; before the test, so the caller's consumer follows with only `mov` between.
;;; A floating condition is true unless it is a zero: its flags are an
;;; extended condition (NE or parity, stogir.x64.fcompare/truth-flags!), so
;;; consumers must accept one.
(module stogir.x64.truth)
(import "stogir.types" :as types)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.fcompare" :as fcompare)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.value" :as value)
(import "coil.result" :use [Result Ok Err])

(defn flags! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (let [ty (value/type-of (.graph cx) reference)]
    (cond (types/floating? ty) (fcompare/truth-flags! (mut out) cx reference position)
          (not (types/integer? ty))
            (Err "x86-64 backend: vector conditions are not implemented (vector family)")
          :else
        (match (value/register-with-locations! (mut out) (.graph cx) (.parts cx) (.base cx)
                                               reference position registers/SCRATCH-GPR)
          (Err [message] (Err message))
          (Ok [register]
              (match (encode/test-rr (mut (.text out)) (value/type-bits ty) register register)
                (Err [message] (Err message))
                (Ok [_] (Ok encode/CC-NE))))))))
