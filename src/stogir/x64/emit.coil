;;; x86-64 emission of selected integer tiles (stogir.x64.select).
;;;
;;; Two-address lowering (docs/X86_PORT.md): `rd = ra OP rb` is emitted as
;;; `mov rd, ra; op rd, rb`. The move disappears when the allocator followed
;;; the hint and gave rd the register of ra. When rd is the register of rb the
;;; operation is commuted if it can be, and otherwise computed in a scratch
;;; register and moved to rd. Constants that do not fit an immediate are
;;; built in r10 (first operand) or r11 (second operand) with `mov`.
;;;
;;; Flags: every instruction emitted for one node is a unit. Nothing here
;;; leaves a flag value for another node, and `flags!` emits every operand
;;; load before the compare, so its caller places the consumer (jcc, setcc,
;;; cmovcc) directly after it with only `mov` in between.
(module stogir.x64.emit)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.types" :as types)
(import "stogir.locations" :as loc)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.encode" :as encode)
(import "stogir.x64.fcompare" :as fcompare)
(import "stogir.x64.registers" :as registers)
(import "stogir.x64.select" :as select)
(import "stogir.x64.value" :as value)
(import "coil.result" :use [Result Ok Err Some None])

;;; The register of operand `reference` at `position`; a constant or spilled
;;; value is first moved into `scratch`.
(defn operand! [(out (mut code/Buffer)) (cx context/Context) (reference i32)
                (position i64) (scratch i32)] (-> (Result i32 (slice u8)))
  (value/register-with-locations! (mut out) (.graph cx) (.parts cx) (.base cx)
                                  reference position scratch))

;;; mov destination, value-of(reference).
(defn into! [(out (mut code/Buffer)) (cx context/Context) (reference i32)
             (position i64) (destination i32)] (-> (Result i32 (slice u8)))
  (value/into! (mut out) (.graph cx) (.parts cx) (.base cx) reference position destination))

(defn destination [(cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (value/destination (.graph cx) (.parts cx) reference position))

;;; `mov destination, source` at `bits`, nothing when they are one register.
(defn move! [(out (mut code/Buffer)) (error (mut (slice u8))) (bits i32)
             (destination i32) (source i32)] (-> void)
  (when (!= destination source)
    (code/accept! (mut error) (encode/mov-rr (mut (.text out)) bits destination source))))

;;; One two-operand instruction `op rd, rb` of the ALU or imul family.
(defn apply! [(out (mut code/Buffer)) (error (mut (slice u8))) (tile select/Tile)
              (rd i32) (rb i32)] (-> void)
  (code/accept! (mut error)
                (if (= (.rule tile) select/RULE-MUL-RR)
                    (encode/imul-rr (mut (.text out)) (.bits tile) rd rb)
                    (encode/alu-rr (mut (.text out)) (.operation tile) (.bits tile) rd rb))))

;;; rd = left OP right for RULE-ALU-RR and RULE-MUL-RR, every aliasing case.
(defn register-binary! [(out (mut code/Buffer)) (cx context/Context) (position i64)
                        (tile select/Tile) (rd i32)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        commutative (or (= (.rule tile) select/RULE-MUL-RR)
                        (!= (.operation tile) encode/SUB))]
    (match (operand! (mut out) cx (.left tile) position registers/SCRATCH-GPR)
      (Err [message] (set! error message))
      (Ok [ra]
          (match (operand! (mut out) cx (.right tile) position registers/SCRATCH-GPR-2)
            (Err [message] (set! error message))
            (Ok [rb]
                (cond (= rd ra) (apply! (mut out) (mut error) tile rd rb)
                      (and (= rd rb) commutative) (apply! (mut out) (mut error) tile rd ra)
                      (= rd rb)
                        ; rd holds the second operand of a non-commutative
                        ; operation: compute beside it. rb is an allocated
                        ; register here, so both scratches are free unless
                        ; ra is one of them, which may be overwritten.
                        (let [temporary (if (= ra registers/SCRATCH-GPR)
                                            (: registers/SCRATCH-GPR i32)
                                            registers/SCRATCH-GPR-2)]
                          (move! (mut out) (mut error) (.bits tile) temporary ra)
                          (apply! (mut out) (mut error) tile temporary rb)
                          (move! (mut out) (mut error) (.bits tile) rd temporary))
                      :else
                        (do
                          (move! (mut out) (mut error) (.bits tile) rd ra)
                          (apply! (mut out) (mut error) tile rd rb)))))))
    (if (= error "") (Ok 0) (Err error))))

;;; rd = left SHIFT right for a variable count (RULE-SHIFT-RC and
;;; RULE-SHIFT-MASKED). rcx is clobbered while the operands are read, so no
;;; operand and no live value is in it: the count is copied into ecx (and
;;; reduced modulo the width for 8- and 16-bit values, where the hardware
;;; would reduce it modulo 32). The result may be rcx itself; it is then
;;; computed in a scratch register and moved in afterwards.
(defn variable-shift! [(out (mut code/Buffer)) (cx context/Context) (position i64)
                       (tile select/Tile) (rd i32)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        wide (value/operation-bits (value/type-of (.graph cx) (.left tile)))]
    (match (operand! (mut out) cx (.right tile) position registers/SCRATCH-GPR-2)
      (Err [message] (set! error message))
      (Ok [rc]
          (match (operand! (mut out) cx (.left tile) position registers/SCRATCH-GPR)
            (Err [message] (set! error message))
            (Ok [ra]
                (if (or (= ra registers/RCX) (= rc registers/RCX))
                    (set! error "x86-64 variable shift found an operand in clobbered rcx")
                    ; Once the count is in ecx, r11 is free even if it held
                    ; the count; r10 may hold a constant first operand.
                    (let [target (cond (!= rd registers/RCX) rd
                                       (= ra registers/SCRATCH-GPR) (: registers/SCRATCH-GPR i32)
                                       :else registers/SCRATCH-GPR-2)]
                      (move! (mut out) (mut error) 32 registers/RCX rc)
                      (when (= (.rule tile) select/RULE-SHIFT-MASKED)
                        (code/accept! (mut error)
                                      (encode/alu-ri (mut (.text out)) encode/AND 32
                                                     registers/RCX (.immediate tile))))
                      (move! (mut out) (mut error) wide target ra)
                      (code/accept! (mut error)
                                    (encode/shift-rc (mut (.text out)) (.operation tile)
                                                     (.bits tile) target))
                      (move! (mut out) (mut error) wide rd target)))))))
    (if (= error "") (Ok 0) (Err error))))

;;; One division operand in `target` at the 32- or 64-bit operation width:
;;; a narrow value is extended to 32 bits by the division's signedness.
;;; Returns the register to use (the operand's own register when a wide value
;;; needs no copy and `copy` is false).
(defn division-operand! [(out (mut code/Buffer)) (cx context/Context) (position i64)
                         (reference i32) (signed bool) (target i32) (copy bool)]
  (-> (Result i32 (slice u8)))
  (let [ty (value/type-of (.graph cx) reference)
        own (value/type-bits ty)
        wide (value/operation-bits ty)
        (mut error) ""
        (mut result) target]
    (match (value/constant-bits (.graph cx) reference)
      (Some [raw]
            (let [extended (if (and signed (< own 32))
                               (& (cast u64 (encode/sign-extend own (cast i64 raw)))
                                  (value/mask 32))
                               raw)]
              (code/accept-count! (mut error) (value/bits! (mut out) target extended wide))))
      (None []
            (match (operand! (mut out) cx reference position target)
              (Err [message] (set! error message))
              (Ok [source]
                  (cond (< own 32)
                          (code/accept! (mut error)
                                        (if signed
                                            (encode/movsx-rr (mut (.text out)) 32 own target source)
                                            (encode/movzx-rr (mut (.text out)) 32 own target source)))
                        copy (move! (mut out) (mut error) wide target source)
                        :else (set! result source))))))
    (if (= error "") (Ok result) (Err error))))

;;; rd = left / right or left % right (RULE-DIVIDE). rax and rdx are reserved
;;; while the operands are read, so neither holds an operand or a live value.
;;; Division by zero and the overflowing signed quotient trap (#DE), as the
;;; IR leaves both undefined.
(defn divide! [(out (mut code/Buffer)) (cx context/Context) (position i64)
               (tile select/Tile) (rd i32)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""
        signed (= (.immediate tile) 1)
        bits (.bits tile)]
    (match (division-operand! (mut out) cx position (.right tile) signed
                              registers/SCRATCH-GPR-2 false)
      (Err [message] (set! error message))
      (Ok [divisor]
          (match (division-operand! (mut out) cx position (.left tile) signed
                                    registers/RAX true)
            (Err [message] (set! error message))
            (Ok [_]
                (if (or (= divisor registers/RAX) (= divisor registers/RDX))
                    (set! error "x86-64 division found its divisor in reserved rax/rdx")
                    (do
                      (if signed
                          (code/accept! (mut error)
                                        (encode/sign-extend-rax-rdx (mut (.text out)) bits))
                          ; Flags are dead here: the division overwrites them.
                          (code/accept! (mut error)
                                        (encode/zero-r (mut (.text out)) registers/RDX)))
                      (code/accept! (mut error)
                                    (encode/unary-r (mut (.text out))
                                                    (if signed encode/IDIV encode/DIV)
                                                    bits divisor))
                      (move! (mut out) (mut error) bits rd
                             (if (= (.operation tile) select/DIVIDE-QUOTIENT)
                                 (: registers/RAX i32)
                                 registers/RDX))))))))
    (if (= error "") (Ok 0) (Err error))))

;;; Emit the flags of comparison `tile`, reading its operands at `position`,
;;; and return the condition that holds when the comparison is true: a
;;; condition code for an integer comparison, an extended condition
;;; (stogir.x64.fcompare: a code possibly combined with the parity flag) for
;;; a floating one. Every operand load precedes the compare; the caller's
;;; consumer follows it.
(defn integer-flags! [(out (mut code/Buffer)) (cx context/Context) (position i64)
                      (tile select/Tile)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (if (or (not (select/comparison-rule? (.rule tile)))
            (= (.rule tile) select/RULE-FCOMPARE))
        (set! error "x86-64 flags requested from a tile that is not an integer comparison")
        (match (operand! (mut out) cx (.left tile) position registers/SCRATCH-GPR)
          (Err [message] (set! error message))
          (Ok [ra]
              (cond (= (.rule tile) select/RULE-COMPARE-ZERO)
                      (code/accept! (mut error)
                                    (encode/test-rr (mut (.text out)) (.bits tile) ra ra))
                    (= (.rule tile) select/RULE-COMPARE-RI)
                      (code/accept! (mut error)
                                    (encode/alu-ri (mut (.text out)) encode/CMP (.bits tile)
                                                   ra (.immediate tile)))
                    :else
                      (match (operand! (mut out) cx (.right tile) position
                                       registers/SCRATCH-GPR-2)
                        (Err [message] (set! error message))
                        (Ok [rb]
                            (code/accept! (mut error)
                                          (encode/alu-rr (mut (.text out)) encode/CMP
                                                         (.bits tile) ra rb))))))))
    (if (= error "") (Ok (.operation tile)) (Err error))))

(defn flags! [(out (mut code/Buffer)) (cx context/Context) (position i64)
              (tile select/Tile)] (-> (Result i32 (slice u8)))
  (if (= (.rule tile) select/RULE-FCOMPARE)
      (fcompare/flags! (mut out) cx position tile)
      (integer-flags! (mut out) cx position tile)))

;;; rd = 1 when condition `cc` holds, else 0: `setcc` writes the low byte and
;;; `movzx` (which preserves flags) defines the rest, keeping BOOL canonical.
(defn set-condition! [(out (mut code/Buffer)) (cc i32) (rd i32)] (-> (Result i32 (slice u8)))
  (let [(mut error) ""]
    (code/accept! (mut error) (encode/setcc-r (mut (.text out)) cc rd))
    (code/accept! (mut error) (encode/movzx-rr (mut (.text out)) 32 8 rd rd))
    (if (= error "") (Ok 0) (Err error))))

;;; Emit the node `reference` selected as `tile`; its result is defined at
;;; `position + 1`.
(defn tile! [(out (mut code/Buffer)) (cx context/Context) (reference i32)
             (position i64) (tile select/Tile)] (-> (Result i32 (slice u8)))
  (match (destination cx reference position)
    (Err [message] (Err message))
    (Ok [rd]
        (let [rule (.rule tile)
              (mut error) ""]
          (cond (or (= rule select/RULE-ALU-RR) (= rule select/RULE-MUL-RR))
                  (code/accept-count! (mut error) (register-binary! (mut out) cx position tile rd))
                (= rule select/RULE-ALU-RI)
                  (do
                    (code/accept-count! (mut error) (into! (mut out) cx (.left tile) position rd))
                    (code/accept! (mut error)
                                  (encode/alu-ri (mut (.text out)) (.operation tile)
                                                 (.bits tile) rd (.immediate tile))))
                (= rule select/RULE-MUL-RI)
                  (match (operand! (mut out) cx (.left tile) position registers/SCRATCH-GPR)
                    (Err [message] (set! error message))
                    (Ok [ra]
                        (code/accept! (mut error)
                                      (encode/imul-rri (mut (.text out)) (.bits tile) rd ra
                                                       (.immediate tile)))))
                (= rule select/RULE-SHIFT-RI)
                  (do
                    (code/accept-count! (mut error) (into! (mut out) cx (.left tile) position rd))
                    (when (!= (.immediate tile) 0)
                      (code/accept! (mut error)
                                    (encode/shift-ri (mut (.text out)) (.operation tile)
                                                     (.bits tile) rd
                                                     (cast i32 (.immediate tile))))))
                (or (= rule select/RULE-SHIFT-RC) (= rule select/RULE-SHIFT-MASKED))
                  (code/accept-count! (mut error) (variable-shift! (mut out) cx position tile rd))
                (= rule select/RULE-DIVIDE)
                  (code/accept-count! (mut error) (divide! (mut out) cx position tile rd))
                (select/comparison-rule? rule)
                  (match (flags! (mut out) cx position tile)
                    (Err [message] (set! error message))
                    (Ok [cc] (code/accept-count! (mut error) (set-condition! (mut out) cc rd))))
                :else (set! error "x86-64 backend: tile rule has no emitter"))
          (if (= error "") (Ok 0) (Err error))))))

;;; COPY: rd = value, read from a register, a spill slot or a constant.
(defn copy! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (let [node (get (.instructions (.graph cx)) (cast i64 reference))]
    (match (destination cx reference position)
      (Err [message] (Err message))
      (Ok [rd] (into! (mut out) cx (.op1 node) position rd)))))
