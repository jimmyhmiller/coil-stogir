;;; Finish x86-64 code as a shared, address-independent image
;;; (stogir.image, machine x86-64): the text, its data ranges and the entry
;;; symbol at text offset 0.
;;;
;;; Pending references (named functions, data, strings, long constants) are
;;; produced only by operation families that do not exist yet. When the
;;; memory and call families add them, this is where each
;;; stogir.x64.code/Reference becomes an image relocation of its own kind and
;;; explicit addend (PC32 to a private address slot or to string/constant
;;; data, PLT32 to a named function), as stogir.a64.image/finish! does for
;;; AArch64. Until then a buffer with references is rejected.
(module stogir.x64.image)
(import "stogir.graph" :as g)
(import "stogir.image" :as image)
(import "stogir.text-data" :as text-data)
(import "stogir.x64.code" :as code)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(defn finish! [(source (mut code/Buffer))
               (graph g/Graph)
               (entry (slice u8))
               (allocator (dyn Allocator))] (-> (Result image/Image (slice u8)))
  (if (> (len (.references source)) 0)
      (Err "x86-64 backend: relocations against named constants are not implemented yet (memory/call families); see docs/X86_FAMILIES.md")
      (let [(mut output) (image/create-x64 allocator)
            (mut error) ""]
        (match (image/require-alignments! (mut output) (.alignment source) 8)
          (Err [message] (set! error message))
          (Ok [_] 0))
        (match (text-data/validate (.text-data source) (len (.text source)))
          (Err [message] (set! error message))
          (Ok [_] 0))
        (free! (mut (.text output)))
        (set! (.text output) (code/take-text! (mut source) allocator))
        (for range (.text-data source) (push! (mut (.text-data output)) range))
        (match (image/symbol! (mut output) entry 1 0)
          (Err [message] (set! error message))
          (Ok [_] 0))
        (if (= error "") (Ok output) (do (image/release! (mut output)) (Err error))))))
