;;; x86-64 remaining integer operations.
;;;
;;; PLACEHOLDER: this operation family is not implemented yet. Every entry
;;; point fails with a clear error, so a graph that needs it is rejected
;;; before any code is produced.
;;;
;;; Operations: integer ABS (32), BSWAP (54), CTPOP (55), CTLZ (56), CTTZ (57), MIN
;;; (58) and MAX (59).
;;;
;;; Interface (called through stogir.x64.families; see docs/X86_FAMILIES.md)
;;;
;;;   (select! state graph reference)
;;;       Matching, before liveness. Record a tile or side-table entry for the
;;;       node, mark producers this node absorbs `omitted` (and lower their
;;;       `counts`). Ok for a node that needs no selection.
;;;   (constrain! set graph matched reference position)
;;;       One call per scheduled node. Add register requirements with
;;;       uses/use!, uses/define!, uses/use-fixed!, uses/define-fixed!;
;;;       clobbers with uses/clobber!; hints with uses/hint! / uses/prefer!.
;;;   (emit! out cx reference position)
;;;       Append the node's machine code. Operands are read at `position`,
;;;       the result is defined at `position + 1` (stogir.x64.emit/operand!,
;;;       /destination, /into!).
;;;
;;; Scratch registers: r10, r11, xmm14 and xmm15 are free inside one node's
;;; emission and hold nothing across nodes.
;;; Flags: no flag value is live on entry to or exit from a node's emission.
;;; Inside it, only `mov`/`lea`/SSE moves may sit between a flag producer and
;;; its consumer; `xor r, r` zeroing and ALU instructions may not.
;;;
;;; Family notes
;;;   * Baseline x86-64 has no POPCNT/LZCNT/TZCNT (docs/X86_PORT.md): use
;;;     bsf/bsr with the zero case handled, and the SWAR population count.
;;;   * MIN/MAX are cmp + cmovcc; ABS is neg + cmovs or the sar/xor/sub form.
(module stogir.x64.bits)
(import "stogir.graph" :as g)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.uses" :as uses)
(import "coil.result" :use [Result Ok Err])

(const PENDING "x86-64 backend: integer ABS, BSWAP, CTPOP, CTLZ, CTTZ, MIN and MAX are not implemented yet; see docs/X86_FAMILIES.md")

(defn select! [(state (mut plan/Matching)) (graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (Err PENDING))

(defn constrain! [(set (mut uses/Set)) (graph g/Graph) (matched plan/Plan)
                  (reference i32) (position i64)] (-> (Result i32 (slice u8)))
  (Err PENDING))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (reference i32) (position i64)]
  (-> (Result i32 (slice u8)))
  (Err PENDING))
