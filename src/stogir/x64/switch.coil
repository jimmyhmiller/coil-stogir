;;; x86-64 SWITCH dispatch.
;;;
;;; PLACEHOLDER: this operation family is not implemented yet. Every entry
;;; point fails with a clear error, so a graph that needs it is rejected
;;; before any code is produced.
;;;
;;; Operations: SWITCH (117) and its CASE_VAL, CASE_RANGE and CASE_DEFAULT
;;; projections (109..111). The projections are block starts and need no code
;;; of their own; the neutral dispatch planning is stogir.switch.
;;;
;;; Interface (called through stogir.x64.families; see docs/X86_FAMILIES.md)
;;;
;;;   (select! state graph reference)
;;;       Matching, before liveness: e.g. dispatch on the 32-bit source of an
;;;       extension of the selector.
;;;   (constrain! set graph matched reference position)
;;;       The selector must be in a register (uses/use!).
;;;   (emit! out cx flow control reference position next allocator)
;;;       Emit the dispatch. `next` is the successor laid out directly after
;;;       this block (0 when none), which needs no jump. Branch to a case
;;;       block with edges/branch-edge! (it creates an edge stub when the
;;;       edge has moves) using source position `position + 1`; a jump table
;;;       is 32-bit `fixups/Relative` words (`target - table base`) in a
;;;       text-data range, reached with `lea r11, [rip+table]`,
;;;       `movsxd r10, [r11+index*4]`, `add r10, r11`, `jmp r10`. The lea
;;;       displacement is internal: patch it when the table is placed.
;;;
;;; Scratch registers: r10, r11. Flags: nothing is live on entry; between a
;;; compare and its jcc only moves may be emitted, and edge moves are moves.
(module stogir.x64.switch)
(import "stogir.graph" :as g)
(import "stogir.x64.code" :as code)
(import "stogir.x64.context" :as context)
(import "stogir.x64.edges" :as edges)
(import "stogir.x64.plan" :as plan)
(import "stogir.x64.uses" :as uses)
(import "coil.alloc" :use [Allocator])
(import "coil.result" :use [Result Ok Err])

(const PENDING "x86-64 backend: the switch family (SWITCH) is not implemented yet; see docs/X86_FAMILIES.md")

(defn select! [(state (mut plan/Matching)) (graph g/Graph) (reference i32)]
  (-> (Result i32 (slice u8)))
  (Err PENDING))

(defn constrain! [(set (mut uses/Set)) (graph g/Graph) (matched plan/Plan)
                  (reference i32) (position i64)] (-> (Result i32 (slice u8)))
  (Err PENDING))

(defn emit! [(out (mut code/Buffer)) (cx context/Context) (flow edges/Flow)
             (control (mut edges/Control)) (reference i32) (position i64)
             (next i32) (allocator (dyn Allocator))] (-> (Result i32 (slice u8)))
  (Err PENDING))
