;;; System V x86-64 argument and result placement for calls.
;;;
;;; PLACEHOLDER: not implemented yet. Scalar incoming parameters are already
;;; placed by stogir.x64.incoming; this module is for everything a call
;;; needs: outgoing arguments, grouped (aggregate) arguments, register-piece
;;; and indirect results, variadic calls.
;;;
;;; Rules to implement (docs/X86_PORT.md, "Calls (System V)")
;;;   * Integer eightbytes take rdi rsi rdx rcx r8 r9, SSE eightbytes
;;;     xmm0..xmm7. A group that does not fit goes to the stack whole and
;;;     does not exhaust its bank. Stack slots are 8 bytes.
;;;   * Indirect result: hidden pointer in rdi, returned in rax.
;;;   * Register results: rax/rdx and xmm0/xmm1, including mixed pairs.
;;;   * Variadic calls: al = number of vector registers used.
;;;   * Narrow integer arguments are extended to 32 bits by the caller
;;;     (stogir.x64.value/extend!).
;;;   * Convention numbers 0 and 8 (stogir.x64.incoming/convention?).
;;;
;;; Interface the call family (stogir.x64.call) is expected to build on
;;;
;;;   (outgoing-size graph scheduled) -> (Result i64 (slice u8))
;;;       Largest stack-argument area of any call, for `(.outgoing-size set)`.
;;;   (normalize! out ty register) -> (Result i32 (slice u8))
;;;       Extend a narrow result or argument in place.
(module stogir.x64.call-abi)
(import "stogir.graph" :as g)
(import "stogir.schedule" :as schedule)
(import "stogir.types" :as types)
(import "stogir.x64.code" :as code)
(import "stogir.x64.value" :as value)
(import "coil.result" :use [Result Ok Err])

(const PENDING "x86-64 backend: System V call placement is not implemented yet (call family); see docs/X86_FAMILIES.md")

(defn outgoing-size [(graph g/Graph) (scheduled schedule/Schedule)]
  (-> (Result i64 (slice u8)))
  (Err PENDING))

;;; Extend the narrow integer in general register `register` to 32 bits by
;;; its type's signedness; wider and void types need nothing. This is the
;;; normalization of a function result handed to a caller.
(defn normalize! [(out (mut code/Buffer)) (ty i32) (register i32)]
  (-> (Result i32 (slice u8)))
  (cond (= ty 0) (Ok 0)
        (not (types/integer? ty))
          (Err "x86-64 backend: floating and vector results are not implemented yet (floating/vector families)")
        (>= (value/type-bits ty) 32) (Ok 0)
        :else (value/extend! (mut out) ty register register)))
