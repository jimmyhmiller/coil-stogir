;;; Deterministic diagnostic dump in signed-reference order.
(module stogir.dump)
(import "stogir.graph" :as g)
(import "stogir.node" :as n)
(import "stogir.opcode" :as op)
(import "coil.result" :use [Some None])

;;; No addresses or hash iteration order enter the output. Constants precede nodes.
;;; This is a diagnostic format; an upstream-compatible parser is still separate.
(defn graph [(graph g/Graph)] (-> void)
  (let [(mut i) 0]
    (while (< i (len (.constants graph)))
      (let [node (get (.constants graph) i)]
        (println "{} = {} type={} bits=0x{:x}"
                 (- -1 i)
                 (op/name (cast i32 (n/opcode node)))
                 (n/type-id node)
                 (n/constant-bits node)))
      (set! i (+ i 1))))
  (let [(mut r) 1]
    (while (< r (len (.instructions graph)))
      (let [node (get (.instructions graph) r)
            count (get (.arities graph) r)]
        (if (< count 0)
            (do (println "{} = INVALID-CONTINUATION" r) (set! r (+ r 1)))
            (do
              (print "{} = {} type={} aux={} ("
                     r
                     (op/name (cast i32 (n/opcode node)))
                     (n/type-id node)
                     (n/auxiliary node))
              (let [(mut i) (: 1 i32)]
                (while (<= i count)
                  (when (> i 1) (print ", "))
                  (match (g/operand graph (cast i32 r) i)
                    (Some [v] (print "{}" v))
                    (None [] (print "<missing>")))
                  (set! i (+ i 1))))
              (println ")")
              (set! r (+ r (/ (+ (cast i64 count) 4) 4)))))))))
